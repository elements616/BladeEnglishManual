<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002R_S000G" variety="S000G">
<name>G-BOOK</name>
<ttl id="1002R_S000G_742BR_T003W" variety="T003W">
<name>G-BOOK System</name>
<para id="RM0000036G1015X" category="J" type-id="803O7" name-id="661A5-01" from="200912">
<dtccode/>
<dtcname>G-SOUND License Recovery Does Not End</dtcname>
<subpara id="RM0000036G1015X_01" type-id="51" category="05" proc-id="RM0550J___0000I5B00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM000001C3S022X"/>)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000036G1015X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000036G1015X_03_0017" proc-id="RM0550J___0000I5C00000">
<testtitle>Check Contents Subject to Recovery</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Contents Subject to Recovery</ptxt>
<test2>
<ptxt>Contact the G-BOOK Support Center and provide the following items.</ptxt>
<list1 type="unordered">
<item>
<ptxt>Content name of the content to be recovered</ptxt>
</item>
<item>
<ptxt>Whether the content to be recovered is preinstalled data or data added from a G Library disc</ptxt>
</item>
</list1>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.71in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Content to be recovered is data added from a G Library disc</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Content to be recovered is preinstalled data and has been deleted</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Content to be recovered is preinstalled data and has not been deleted</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036G1015X_03_0018" fin="false">A</down>
<right ref="RM0000036G1015X_03_0020" fin="false">B</right>
<right ref="RM0000036G1015X_03_0026" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM0000036G1015X_03_0018" proc-id="RM0550J___0000I5D00000">
<testtitle>Check Contents Subject to Recovery</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Existence of Content to Be Recovered</ptxt>
<test2>
<ptxt>Check the content in the on-board unit and check whether the content in recovery status exists in the on-board unit.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.71in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Content to be recovered does not exist in the on-board unit</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Content to be recovered exists in the on-board unit</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036G1015X_03_0019" fin="false">A</down>
<right ref="RM0000036G1015X_03_0026" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000036G1015X_03_0019" proc-id="RM0550J___0000I5E00000">
<testtitle>Check G Library Disc</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check G Library Disc</ptxt>
<test2>
<ptxt>Check whether the customer or dealer has a G Library disc containing the relevant content.</ptxt>
<atten4>
<ptxt>If neither the customer nor the dealer has a G Library disc containing the relevant content, contact the G-BOOK Support Center and obtain a G Library disc containing the relevant content.</ptxt>
</atten4>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.71in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>G Library disc containing the relevant content cannot be obtained</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>G Library disc containing the relevant content is available</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036G1015X_03_0020" fin="false">A</down>
<right ref="RM0000036G1015X_03_0025" fin="false">B</right>
</res>
</testgrp>
<testgrp id="RM0000036G1015X_03_0020" proc-id="RM0550J___0000I5F00000">
<testtitle>Contact G-BOOK Support Center (Request Cancellation of License Recovery Status)</testtitle>
<content6 releasenbr="3">
<test1>
<ptxt>Request Cancellation of License Recovery Status</ptxt>
<test2>
<ptxt>Contact the G-BOOK Support Center and have the G-SOUND license recovery status cancelled.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.71in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Return to Normal</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Does not return to normal</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036G1015X_03_0021" fin="true">A</down>
<right ref="RM0000036G1015X_03_0026" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000036G1015X_03_0025" proc-id="RM0550J___0000I5K00000">
<testtitle>License Recovery</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>License Recovery</ptxt>
<test2>
<ptxt>Copy the content to be recovered from the G Library disc and perform G-SOUND license recovery.</ptxt>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036G1015X_03_0021" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000036G1015X_03_0026">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000036G1015X_03_0021">
<testtitle>END</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>