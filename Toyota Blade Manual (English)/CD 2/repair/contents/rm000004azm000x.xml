<para id="RM000004AZM000X" category="A" type-id="80001" name-id="64218-01" from="200912">
<name>Removal</name>
<subpara id="RM000004AZM000X_01" type-id="01" category="01">
<s-1 id="RM000004AZM000X_01_0001" proc-id="RM0550J___0000IP300000">
<ptxt>Remove Instrument Panel Finish Plate</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 clips and 2 claws.</ptxt>
<figure>
<graphic graphicname="E208421" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the clamp.</ptxt>
<figure>
<graphic graphicname="E206689J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connector and remove the instrument panel finish plate.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000004AZM000X_01_0002" proc-id="RM0550J___0000IP400000">
<ptxt>Remove Stereo Jack Adapter Assembly NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 2 claws and remove stereo jack adapter assembly No.1.</ptxt>
<figure>
<graphic graphicname="E206690" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
