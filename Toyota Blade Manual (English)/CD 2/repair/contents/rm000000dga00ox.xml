<title>Resistance</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.35in"/>
<colspec colname="COL2" colwidth="1.91in"/>
<colspec colname="COL3" colwidth="0.87in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>F2 - G1</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG OFF, rear defogger switch OFF</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
