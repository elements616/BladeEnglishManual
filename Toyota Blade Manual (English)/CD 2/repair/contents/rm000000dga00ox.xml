<ttl id="1002U_S0003_744CH_T004D" variety="T004D">
<name>Rear Window Defogger System</name>
<para id="RM000000DGA00OX" category="J" type-id="300O6" name-id="752AT-00" from="200612">
<dtccode/>
<dtcname>Rear Window Defogger Does Not Operate</dtcname>
<subpara id="RM000000DGA00OX_02" type-id="33" category="03" proc-id="RM0550J___000027300000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>When the rear defogger switch built into the air conditioner control assembly is operated, a signal is sent to the air conditioner amplifier assembly via LIN communication. When the air conditioner amplifier assembly receives the signal, it turns the DEF relay ON and operates the rear defogger.</ptxt>
</content5>
</subpara>
<subpara id="RM000000DGA00OX_03" type-id="32" category="03" proc-id="RM0550J___000027400000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="B163249J03" width="7.106578999in" height="4.7836529in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000DGA00OX_04" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000000DGA00OX_05" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DGA00OX_05_0001" proc-id="RM0550J___000027500000">
<scantool type="8"/>
<testtitle>Perform TaSCAN Active Test (Defogger Relay)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "Active Test" screen, and turn the "Rear Defogger Relay" ON.</ptxt>
<table pgwide="1">
<title>[System Selection Screen: Body → A/C → Active Test]</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COLSPEC0" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Test Details</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Rear Defogger Relay</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Rear defogger relay ON ←→ OFF</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test1>
<test1>
<ptxt>Check the operation of the rear window defogger.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Rear window defogger does not warm up</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Rear window defogger warms up</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DGA00OX_05_0004" fin="false">A</down>
<right ref="RM000000DGA00OX_05_0031" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DGA00OX_05_0004" proc-id="RM0550J___000027600000">
