</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DGA00OX_05_0010" fin="false">OK</down>
<right ref="RM000000DGA00OX_05_0003" fin="true">NG</right>
</res>
</testgrp>
