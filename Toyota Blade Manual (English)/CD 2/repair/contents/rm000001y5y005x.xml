<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_74X9U_T00G8" variety="T00G8">
<name>Engine Mounting Insulator Front (2GR-FE)</name>
<para id="RM000001Y5Y005X" category="A" type-id="80001" name-id="07254-00" from="200708">
<name>Removal</name>
<subpara id="RM000001Y5Y005X_01" type-id="01" category="01">
<s-1 id="RM000001Y5Y005X_01_0013">
<ptxt>Check Front Wheels Straight-ahead Position</ptxt>
</s-1>
<s-1 id="RM000001Y5Y005X_01_0014" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0015" proc-id="RM0550J___0000DHU00000">
<ptxt>Remove V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place both hands on the front of the cover and lift it upward to disengage the 2 front clips, then continue lifting upward to disengage the 1 rear clips, and remove the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Pulling up the front and rear at the same time may cause damage.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0016" proc-id="RM0550J___0000DHQ00000">
<ptxt>Disconnect Battery Negative Terminal
</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000000D9902LX"/>)</ptxt>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0017" proc-id="RM0550J___0000EUD00000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0018" proc-id="RM0550J___0000EUE00000">
<ptxt>Remove Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the battery tray.</ptxt>
<figure>
<graphic graphicname="A176883" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 clamps and disconnect the wire harness from the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Remove the 4 bolts and the battery carrier.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0019" proc-id="RM0550J___0000EUF00000">
<ptxt>Remove Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and battery carrier NO.2.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0011" proc-id="RM0550J___0000EUI00000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0020" proc-id="RM0550J___0000EUJ00000">
<ptxt>Remove Engine Under Cover
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 4 screws, and remove the engine under cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0021" proc-id="RM0550J___0000DIT00000">
<ptxt>Remove Front Suspension Member Reinforcement LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and front suspension member reinforcement LH.</ptxt>
<figure>
<graphic graphicname="A136937" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0022" proc-id="RM0550J___0000DIU00000">
<ptxt>Remove Front Suspension Member Reinforcement RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and front suspension member reinforcement RH.</ptxt>
<figure>
<graphic graphicname="A136938" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Y005X_01_0024" proc-id="RM0550J___0000FQ500000">
<ptxt>Support Engine Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Support the oil pan with a transmission jack using a wooden block or similar.</ptxt>
<figure>
<graphic graphicname="A162930J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y5Y005X_01_0023" proc-id="RM0550J___0000FQ800000">
<ptxt>Disconnect Engine Mounting Insulator Front</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and nut, and disconnect the engine mounting insulator front from the engine mounting bracket front.</ptxt>
<figure>
<graphic graphicname="A178718" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y5Y005X_01_0026" proc-id="RM0550J___0000FQ700000">
<ptxt>Remove Front Crossmember Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and front cross member.</ptxt>
<figure>
<graphic graphicname="A128870" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y5Y005X_01_0002" proc-id="RM0550J___0000EN900000">
<ptxt>Remove Engine Mounting Insulator Front</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 bolts and remove the engine mounting insulator front from the front crossmember.</ptxt>
<figure>
<graphic graphicname="A136945" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>