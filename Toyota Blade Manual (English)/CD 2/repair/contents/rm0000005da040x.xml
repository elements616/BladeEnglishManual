<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Engine Type</ptxt>
</entry>
<entry valign="middle">
<ptxt>Oil Only Replacement</ptxt>
<ptxt>Capacity [L]</ptxt>
</entry>
<entry valign="middle">
<ptxt>Oil and Oil Filter</ptxt>
<ptxt>Capacity When Replacing [L]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
