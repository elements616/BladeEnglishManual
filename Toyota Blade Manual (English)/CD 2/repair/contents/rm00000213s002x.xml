<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="08">
<name>Heater &amp; Air Conditioner/Ventilation</name>
<section id="1002K_S000B" variety="S000B">
<name>Air Conditioner</name>
<ttl id="1002K_S000B_74221_T002B" variety="T002B">
<name>Cooler Condenser Assembly (Engine Model 2AZ-FE)</name>
<para id="RM00000213S002X" category="A" type-id="80001" name-id="5227U-00" from="200612">
<name>Removal</name>
<subpara id="RM00000213S002X_01" type-id="01" category="01">
<s-1 id="RM00000213S002X_01_0013" proc-id="RM0550J___00000ZB00000">
<ptxt>Discharge Refrigerant HFC-134a (R134a)
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Operate the A/C under the following conditions.</ptxt>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Engine Speed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Idling</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Operating time</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>3 minutes or more</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>A/C Switch</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ON</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Blower level</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>HI</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Set Temperature</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>MAX COOL</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten3>
<ptxt>If the A/C cannot be operated due to compressor lock etc., operation is not necessary.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Stop the engine.</ptxt>
</s2>
<s2>
<ptxt>Connect a refrigerant recovery/recycling machine and recover the refrigerant gas.</ptxt>
<atten3>
<ptxt>When using a refrigerant recovery/recycling machine, use it correctly according to its instruction manual.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM00000213S002X_01_0018" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000213S002X_01_0019" proc-id="RM0550J___00008DP00000">
<ptxt>Remove Radiator Grille Protector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 radiator grille protectors.</ptxt>
<figure>
<graphic graphicname="B167060" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000213S002X_01_0020" proc-id="RM0550J___00008DQ00000">
<ptxt>Remove Front Bumper Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a flat-tip screwdriver, turn the pin hold clip 90° and remove the pin hold clip.</ptxt>
<figure>
<graphic graphicname="B167061J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Perform the same procedure on the RH side.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Apply protective tape around the front bumper assembly.</ptxt>
<figure>
<graphic graphicname="B167062J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Using a clip remover, remove the 3 upper clips.</ptxt>
</s2>
<s2>
<ptxt>Remove the 6 screws, 2 clips and 2 bolts.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly outward from the vehicle to disengage the 8 claws (4 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167063" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly toward the front of the vehicle and remove the front bumper assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000213S002X_01_0039" proc-id="RM0550J___00004JG00000">
<ptxt>Disconnect Water Bypass Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and 2 clamps, and disconnect the water bypass hose from the radiator support assembly.</ptxt>
<figure>
<graphic graphicname="A159941" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000213S002X_01_0015" proc-id="RM0550J___00003VG00000">
<ptxt>Disconnect Hood Lock Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the hood lock control assembly from the 2 clamps.</ptxt>
<figure>
<graphic graphicname="A155392" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 bolts and disconnect the hood lock assembly.</ptxt>
<figure>
<graphic graphicname="A162973" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000213S002X_01_0016" proc-id="RM0550J___00003VE00000">
<ptxt>Remove Radiator Support Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the 2 horn assembly connectors.</ptxt>
<figure>
<graphic graphicname="A162974" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 4 bolts and radiator support assembly.</ptxt>
<figure>
<graphic graphicname="A159942" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000213S002X_01_0017" proc-id="RM0550J___00003VC00000">
<ptxt>Remove Fan Shroud NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the clamp and disconnect the water bypass hose No.3 from the fan shroud No.2.</ptxt>
<figure>
<graphic graphicname="A159943" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and disconnect the fan shroud No.2 from the radiator assembly.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 radiator support cushions from fan shroud No. 2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000213S002X_01_0003" proc-id="RM0550J___000015800000">
<ptxt>Disconnect Air Conditioner Tube &amp; Accessory Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E145407" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Remove the bolt and disconnect the air conditioner tube &amp; accessory assembly.</ptxt>
</s2>
<s2>
<ptxt>Remove the O-ring from the air conditioner tube &amp; accessory assembly.</ptxt>
<atten3>
<ptxt>Wrap vinyl tape around the fitting portions of the disconnected pipe and cooler condenser assembly to prevent dirt, moisture, etc. from entering.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213S002X_01_0004" proc-id="RM0550J___000015900000">
<ptxt>Disconnect Discharge Hose Sub-assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E145408" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Remove the bolt and disconnect the discharge hose.</ptxt>
</s2>
<s2>
<ptxt>Remove the O-ring from the discharge hose.</ptxt>
<atten3>
<ptxt>Wrap vinyl tape around the fitting portions of the disconnected pipe and cooler condenser assembly to prevent dirt, moisture, etc. from entering.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213S002X_01_0011" proc-id="RM0550J___00007DG00000">
<ptxt>Remove Condenser Assembly (with Receiver)</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E147273" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Pull out the condenser assembly (with receiver) upward.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
