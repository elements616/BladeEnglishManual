<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002T_S000D" variety="S000D">
<name>Other Electrical</name>
<ttl id="1002T_S000D_742B1_T003C" variety="T003C">
<name>ETC System</name>
<para id="RM00000365D014X" category="C" type-id="803NO" name-id="CM0CF-16" from="200912">
<dtccode>B15F1</dtccode>
<dtcname>ETC communication information malfunction</dtcname>
<subpara id="RM00000365D014X_01" type-id="33" category="03" proc-id="RM0550J___0000IAG00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when a malfunction occurs in road-to-vehicle communication at a toll gate.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.29in"/>
<colspec colname="COL2" colwidth="3.56in"/>
<colspec colname="COL3" colwidth="2.24in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B15F1</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Authentication error (SAM response malfunction) detected in DSRC communication</ptxt>
</item>
<item>
<ptxt>Charging information (amount/unit) in the communication data is abnormal</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>-</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000365D014X_02" type-id="51" category="05" proc-id="RM0550J___0000IAH00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>When making an inquiry to the road operator, ask the customer for the toll gate, date and time of the occurrence, etc., obtain the customer's consent to inquire about the travel record with the road operator, and then make the inquiry, explaining that there was an error in the communicated data.</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM00000365D014X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000365D014X_03_0001" proc-id="RM0550J___0000IAI00000">
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Error Code</ptxt>
<test2>
<ptxt>Start diagnosis mode 1. (see <xref label="Seep01" href="RM000000BY201ZX"/>)</ptxt>
</test2>
<test2>
<ptxt>Take the following action based on the error code.</ptxt>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.25in"/>
<colspec colname="COL2" align="left" colwidth="5.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Error Code</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Action</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>42</ptxt>
</entry>
<entry valign="middle">
<ptxt>Notify the road operator responsible for the toll gate where the problem occurred that there was a malfunction in the ETC security communication</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>51</ptxt>
</entry>
<entry valign="middle">
<ptxt>Notify the road operator responsible for the toll gate where the problem occurred that the charged amount during toll payment was incorrect</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>52</ptxt>
</entry>
<entry valign="middle">
<ptxt>Notify the road operator responsible for the toll gate where the problem occurred that the charging unit during toll payment was incorrect</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000365D014X_03_0002" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000365D014X_03_0002">
<testtitle>END</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>