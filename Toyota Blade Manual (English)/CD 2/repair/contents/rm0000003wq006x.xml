<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1001Y_S000S" variety="S000S">
<name>CVT</name>
<ttl id="1001Y_S000S_747I6_T00DR" variety="T00DR">
<name>Transmission Oil Cooler Assembly</name>
<para id="RM0000003WQ006X" category="A" type-id="80001" name-id="32258-00" from="200612">
<name>Removal</name>
<subpara id="RM0000003WQ006X_01" type-id="01" category="01">
<s-1 id="RM0000003WQ006X_01_0016" proc-id="RM0550J___0000AJ700000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove the engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000003WQ006X_01_0014" proc-id="RM0550J___000030H00000">
<ptxt>Drain Coolant (Toyota Genuine Super Long Life Coolant)
</ptxt>
<content1 releasenbr="1">
<atten2>
<ptxt>To avoid the danger of being burned, do not remove the reservoir tank cap while the engine and radiator are still hot. Liquid and steam will spray out under pressure.</ptxt>
</atten2>
<s2>
<ptxt>Loosen the radiator drain cock plug.</ptxt>
</s2>
<s2>
<ptxt>Remove the radiator cap and drain the coolant.</ptxt>
</s2>
<s2>
<ptxt>Loosen the cylinder block drain cock plug and drain the coolant from the engine.</ptxt>
<figure>
<graphic graphicname="A160380J01" width="7.106578999in" height="4.7836529in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000003WQ006X_01_0013" proc-id="RM0550J___000035500000">
<ptxt>Drain CVT Fluid
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a socket hexagon wrench 10, remove the drain plug and gasket, and drain the fluid.</ptxt>
</s2>
<s2>
<ptxt>Using a socket hexagon wrench 10, tighten the drain plug with a new gasket.</ptxt>
<torque>
<torqueitem>
<t-value1>47</t-value1>
<t-value2>479</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000003WQ006X_01_0015" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000003WQ006X_01_0017" proc-id="RM0550J___000035700000">
<ptxt>Disconnect Radiator Inlet Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the clamp and disconnect the radiator inlet hose.</ptxt>
<figure>
<graphic graphicname="A165574" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000003WQ006X_01_0003" proc-id="RM0550J___0000BT100000">
<ptxt>Disconnect Water Bypass Hose</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 clamps and disconnect the 2 water bypass hoses from the oil cooler.</ptxt>
<figure>
<graphic graphicname="C161668" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000003WQ006X_01_0005" proc-id="RM0550J___0000BT300000">
<ptxt>Remove Oil Cooler Hose</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 clamps and remove the 2 oil cooler hoses from the oil cooler.</ptxt>
<figure>
<graphic graphicname="C161669" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000003WQ006X_01_0007" proc-id="RM0550J___0000BT500000">
<ptxt>Remove Oil Cooler</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 bolts and remove the oil cooler.</ptxt>
<figure>
<graphic graphicname="C160374" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>