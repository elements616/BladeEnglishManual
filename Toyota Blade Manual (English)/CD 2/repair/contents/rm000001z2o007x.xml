<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000U_S0017" variety="S0017">
<name>Steering Column</name>
<ttl id="1000U_S0017_745FR_T00AZ" variety="T00AZ">
<name>Electric Power Steering System</name>
<para id="RM000001Z2O007X" category="C" type-id="801QB" name-id="480Y2-00" from="200612">
<dtccode>C1521/25</dtccode>
<dtcname>Motor Overcurrent Malfunction</dtcname>
<dtccode>C1531/25</dtccode>
<dtcname>ECU Malfunction 1</dtcname>
<dtccode>C1532/25</dtccode>
<dtcname>ECU Malfunction 2</dtcname>
<dtccode>C1533/25</dtccode>
<dtcname>ECU Internal Temperature Sensor Malfunction</dtcname>
<dtccode>C1534/25</dtccode>
<dtcname>EEPROM Malfunction</dtcname>
<dtccode>C1554/23</dtccode>
<dtcname>Power Relay Malfunction</dtcname>
<subpara id="RM000001Z2O007X_01" type-id="33" category="03" proc-id="RM0550J___00005YU00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>While an ECU system malfunction DTC is being output, power assist is stopped as a fail-safe function. However, if only C1533/25 or C1534/25 is output, control continues with a limited assist amount without stopping power assist.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.83in"/>
<colspec colname="COL3" colwidth="2.18in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Detection Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1521/25</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Motor overcurrent malfunction</ptxt>
</entry>
<entry morerows="5" valign="middle">
<ptxt>Power Steering Computer Assembly</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C1531/25</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ECU internal (microcomputer) malfunction</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C1532/25</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ECU internal (circuit) malfunction</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C1533/25</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ECU internal (temperature sensor) malfunction</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C1534/25</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ECU internal (EEPROM) malfunction</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C1554/23</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Power source relay (built into ECU) malfunction</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000001Z2O007X_02" type-id="51" category="05" proc-id="RM0550J___00005YV00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>If the power steering computer assembly is replaced, perform the torque sensor 0 point calibration and rotation angle sensor output calibration. (see <xref label="Seep01" href="RM0000024YB004X"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000001Z2O007X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000001Z2O007X_03_0001" proc-id="RM0550J___00005YW00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Recheck the DTC. (see <xref label="Seep01" href="RM000000URU00GX"/>) </ptxt>
<spec>
<title>Result</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="4.96in"/>
<colspec colname="COL2" align="center" colwidth="2.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>No DTCs other than C1521/25, C1531/25, C1532/25, C1533/25, C1534/25 and C1554/23 are output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>DTCs other than C1521/25, C1531/25, C1532/25, C1533/25, C1534/25 and C1554/23 are output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000001Z2O007X_03_0002" fin="true">A</down>
<right ref="RM000001Z2O007X_03_0003" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000001Z2O007X_03_0002">
<testtitle>Replace Power Steering Computer Assembly<xref label="Seep01" href="RM000000UNH00TX"/>
</testtitle>
</testgrp>
<testgrp id="RM000001Z2O007X_03_0003">
<testtitle>Go to the flowchart for the output code</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>