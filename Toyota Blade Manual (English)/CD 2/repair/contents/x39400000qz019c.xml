<subpara id="X39400000QZ019C_12" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="X39400000QZ019C_13" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X39400000QZ019C_13_0001" proc-id="RM0550J___00002TL00000">
<testtitle>Inspect Valve Timing</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Timing Inspection</ptxt>
<test2>
<ptxt>Remove the cylinder head cover.</ptxt>
</test2>
<test2>
<ptxt>Turn the crankshaft clockwise and align the notch of the crankshaft pulley with the 0° position.</ptxt>
</test2>
<test2>
<ptxt>Check that the timing marks of the camshaft timing gear are aligned as shown in the illustration. If the marks are not aligned, turn the crankshaft clockwise 1 more revolution.</ptxt>
<figure>
<graphic graphicname="A160964J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Timing marks are aligned</ptxt>
</specitem>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="X39400000QZ019C_13_0002" fin="true">OK</down>
<right ref="X39400000QZ019C_13_0003" fin="true">NG</right>
</res>
</testgrp>
