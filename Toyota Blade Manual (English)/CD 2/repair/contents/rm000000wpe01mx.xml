<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74WIJ_T00FO" variety="T00FO">
<name>EFI System (2GR-FE)</name>
<para id="RM000000WPE01MX" category="C" type-id="305RH" name-id="066OA-00" from="200708">
<dtccode>P0724/95</dtccode>
<dtcname>STP Light SW ON Malfunction</dtcname>
<subpara id="RM000000WPE01MX_01" type-id="31" category="03" proc-id="RM0550J___0000DA400000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The stop light switch detects the operating condition of the brake pedal and outputs it to the engine control computer. The stop light switch is installed on the brake pedal bracket, and is connected to the engine control computer via the wire harness.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.85in"/>
<colspec colname="COL2" colwidth="3.71in"/>
<colspec colname="COL3" colwidth="2.52in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
<item>
<ptxt>Others</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0724/95</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>With the stop light switch remaining ON, driving condition (30km/h or more) and stopped condition (3km/h or less) were repeated 5 times</ptxt>
</item>
<item>
<ptxt>STP signal stuck ON</ptxt>
</item>
<item>
<ptxt>-</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Stop Light Switch Assembly</ptxt>
</item>
<item>
<ptxt>Wire Harness or Connector</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000WPE01MX_02" type-id="32" category="03" proc-id="RM0550J___0000DA500000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="A160628J11" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000WPE01MX_03" type-id="51" category="05" proc-id="RM0550J___0000DA600000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Using SST (TaSCAN), read the Freeze Frame Data. Freeze frame data records part of the engine operating condition when a malfunction occurs, and this information is useful when troubleshooting.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM000000WPE01MX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000WPE01MX_04_0001" proc-id="RM0550J___0000DA700000">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Stop Light Switch)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), operate according to the screen display and select [ECU Data Monitor] - [Stop Light SW].</ptxt>
</test1>
<test1>
<ptxt>Read the [OFF→ON] displayed on SST (TaSCAN) when the brake pedal is operated (released → depressed).</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="4" align="center">
<colspec colname="COL1" colwidth="1.77in"/>
<colspec colname="COL2" colwidth="1.77in"/>
<colspec colname="COL3" colwidth="1.77in"/>
<colspec colname="COL4" colwidth="1.77in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Item Name</ptxt>
<ptxt>[Symbol]</ptxt>
</entry>
<entry valign="middle">
<ptxt>Item Description</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Reference Value</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Stop Light SW</ptxt>
<ptxt>[STP]</ptxt>
</entry>
<entry valign="middle">
<ptxt>Indicates the stop light switch status</ptxt>
</entry>
<entry valign="middle">
<ptxt>Brake pedal released → depressed</ptxt>
</entry>
<entry valign="middle">
<ptxt>OFF → ON</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>Check the data monitor of the stop light switch assembly while driving the vehicle.</ptxt>
</atten4>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>NG</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>OK</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000WPE01MX_04_0002" fin="false">A</down>
<right ref="RM000000WPE01MX_04_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000WPE01MX_04_0002" proc-id="RM0550J___0000DA800000">
<testtitle>Inspect Stop Light Switch Assembly</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the stop light switch assembly connector.</ptxt>
<figure>
<graphic graphicname="A072924J12" width="2.775699831in" height="1.771723296in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between each pair of terminals when the shaft is not pushed in (brake pedal depressed).</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Between terminal 1 and terminal 2</ptxt>
</entry>
<entry morerows="1" valign="middle">
<ptxt>Shaft not pushed in</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Between terminal 3 and terminal 4</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between each pair of terminals when the shaft is pushed in (brake pedal not depressed).</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Terminal 1 - Terminal 2</ptxt>
</entry>
<entry morerows="1" valign="middle">
<ptxt>Shaft pushed in</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Terminal 3 - Terminal 4</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000WPE01MX_04_0003" fin="false">OK</down>
<right ref="RM000000WPE01MX_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000WPE01MX_04_0003" proc-id="RM0550J___0000DA900000">
<testtitle>Inspect Wire Harness and Connector (Stop Light Switch Assembly - Engine Control Computer)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For wire harness and connector inspection procedures and precautions, refer to <xref label="Seep01" href="RM0000005D702RX"/></ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect the stop light switch assembly connector.</ptxt>
</test1>
<test1>
<ptxt>Disconnect connector B of the engine control computer.</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
<figure>
<graphic graphicname="A158134J04" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the terminals. (see <xref label="Seep02" href="X39400000QV01SD"/> for Terminals of ECU)</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.19in"/>
<colspec colname="COL2" colwidth="1.56in"/>
<colspec colname="COLSPEC0" colwidth="1.38in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
<ptxt>(Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B35(ST1-) - </ptxt>
<ptxt>Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shaft not pushed in →</ptxt>
<ptxt>Shaft pushed in</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0 to 1.5V→7.5 to 14.0V</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B36(STP) - </ptxt>
<ptxt>Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shaft not pushed in →</ptxt>
<ptxt>Shaft pushed in</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>7.5 to 14.0V→0 to 1.5V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000WPE01MX_04_0007" fin="true">OK</down>
<right ref="RM000000WPE01MX_04_0006" fin="true">NG</right>
</res>
</testgrp>
