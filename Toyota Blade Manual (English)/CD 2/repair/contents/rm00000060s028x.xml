<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1002J_S000U" variety="S000U">
<name>Brake Control</name>
<ttl id="1002J_S000U_744TG_T0089" variety="T0089">
<name>ABS with EBD &amp; TRC &amp; VSC &amp; BA System</name>
<para id="RM00000060S028X" category="J" type-id="300E0" name-id="443TI-01" from="200912">
<dtccode/>
<dtcname>ABS Warning Light Remains On</dtcname>
<subpara id="RM00000060S028X_05" type-id="33" category="03" proc-id="RM0550J___00007S000001">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This describes troubleshooting when the DTC output is normal but the ABS warning light remains on.</ptxt>
<ptxt>If the power source of the skid control computer has a high voltage malfunction, the skid control computer turns on the ABS warning light as a fail-safe and stops operating and responding.</ptxt>
<ptxt>If the power source voltage input (IG1) circuit to the skid control computer is open, the ABS warning light remains on.</ptxt>
</content5>
</subpara>
<subpara id="RM00000060S028X_06" type-id="32" category="03" proc-id="RM0550J___00007S100001">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C154594J02" width="7.106578999in" height="6.791605969in"/>
</figure>
</content5>
</subpara>
<subpara id="RM00000060S028X_07" type-id="51" category="05" proc-id="RM0550J___0000IVL00000">
<name>Inspection Procedure</name>
<content5 releasenbr="2">
<atten3>
<ptxt>If the actuator assembly is replaced, perform the "Yaw Rate &amp; G Sensor 0 Point Acquisition" for the VSC system. (see <xref label="Seep01" href="RM000001A8301MX"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM00000060S028X_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000060S028X_08_0012" proc-id="RM0550J___00007S200001">
<testtitle>Inspect Connection Condition of Each Part</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Lightly shake the actuator assembly connector and wire harness up and down and side to side, and inspect the ABS warning light illumination status.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Warning light display does not change</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060S028X_08_0013" fin="false">OK</down>
<right ref="RM00000060S028X_08_0017" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060S028X_08_0013" proc-id="RM0550J___00007S300001">
<testtitle>Inspect Control System CAN Communication System</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using the SST (TaSCAN), inspect the DTCs and check that there is no malfunction in the CAN communication system. (see <xref label="Seep01" href="RM000001R4W019X"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Normal DTC</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060S028X_08_0014" fin="false">OK</down>
<right ref="RM00000060S028X_08_0018" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060S028X_08_0014" proc-id="RM0550J___00007S400001">
<testtitle>Inspect ABS &amp; Traction Actuator Assembly (IG1,GND1)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Turn the IG OFF and disconnect the brake actuator assembly connector.</ptxt>
<figure>
<graphic graphicname="C146352J14" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using the SST (Toyota electrical tester), measure the resistance and voltage between the wire harness side connector of the brake actuator assembly and body ground.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.14in"/>
<colspec colname="COL2" colwidth="0.88in"/>
<colspec colname="COL3" colwidth="1.11in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1 (GND1) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.13in"/>
<colspec colname="COL2" colwidth="0.88in"/>
<colspec colname="COL3" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>34 (IG1) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060S028X_08_0015" fin="false">OK</down>
<right ref="RM00000060S028X_08_0019" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060S028X_08_0015" proc-id="RM0550J___00007S500001">
<scantool type="8"/>
<testtitle>Perform Active Test (ABS Light)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using the SST (TaSCAN), perform the Active Test of the ABS warning light. (see <xref label="Seep01" href="RM000000602011X"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Goes off ←→ comes on according to operation</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060S028X_08_0020" fin="true">OK</down>
<right ref="RM00000060S028X_08_0016" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060S028X_08_0016">
<testtitle>Go to Meter &amp; Gauge System<xref label="Seep01" href="RM000001L5T00JX"/>
</testtitle>
</testgrp>
<testgrp id="RM00000060S028X_08_0017">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM00000060S028X_08_0018">
<testtitle>Go to Control System CAN Communication System<xref label="Seep01" href="RM000001R4W019X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000060S028X_08_0019">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM00000060S028X_08_0020">
<testtitle>Replace ABS &amp; Traction Actuator Assembly<xref label="Seep01" href="RM00000304V000X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
