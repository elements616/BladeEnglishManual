<name>EFI System (2GR-FE)</name>
<para id="RM00000211300OX" category="C" type-id="3034K" name-id="0662M-00" from="200708">
<dtccode>P1602</dtccode>
<dtcname>Battery Deterioration</dtcname>
<subpara id="RM00000211300OX_01" type-id="31" category="03" proc-id="RM0550J___0000DAN00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>The battery condition is monitored, and if the voltage drops below a certain level while the engine is running (except during cranking), the engine control computer judges that the battery has deteriorated and outputs a DTC.</ptxt>
</item>
</list1>
<table frame="all" colsep="1" rowsep="1" pgwide="1">
<tgroup cols="3" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="0.84in"/>
<colspec colnum="02" colname="C02" colwidth="3.48in"/>
<colspec colnum="03" colname="C03" colwidth="2.76in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
<item>
<ptxt>Others</ptxt>
</item>
</list1>
</entry>
<entry colname="C03" valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>P1602</ptxt>
</entry>
<entry colname="C02" valign="middle" align="left">
<list1 type="ordered">
<item>
<ptxt>60 seconds or more have elapsed after starting, engine running, and electrical load signal OFF</ptxt>
</item>
<item>
<ptxt>Battery voltage less than 10.75V</ptxt>
</item>
<item>
<ptxt>10 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry colname="C03" valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Battery</ptxt>
</item>
<item>
<ptxt>Wire Harness or Connector</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
