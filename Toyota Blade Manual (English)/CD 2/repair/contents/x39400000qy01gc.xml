<list1 type="unordered">
<item>
<ptxt>Valve Timing</ptxt>
</item>
<item>
<ptxt>Camshaft Timing Oil Control Valve Assembly</ptxt>
</item>
<item>
<ptxt>Camshaft Timing Gear Assembly</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>P0012/59</ptxt>
</entry>
<entry colname="C02" valign="middle" align="left">
<list1 type="ordered">
<item>
<ptxt>After engine warm-up, engine speed 4000r/min or less</ptxt>
</item>
<item>
<ptxt>Valve timing stuck, cannot be advanced to the target value</ptxt>
</item>
<item>
<ptxt>5 seconds or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry colname="C03" valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Valve Timing</ptxt>
</item>
<item>
<ptxt>Camshaft Timing Oil Control Valve Assembly</ptxt>
</item>
<item>
<ptxt>Camshaft Timing Gear Assembly</ptxt>
</item>
<item>
