<ptxt>Tester Connection (Terminal Symbol)</ptxt>
<ptxt>(Certification ECU - Main Body ECU)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>10(LIN) - C12(LIN)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.99in"/>
<colspec colname="COL2" colwidth="1.07in"/>
<colspec colname="COL3" colwidth="1.07in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
<ptxt>(Main Body ECU)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>10 (LIN) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.15in"/>
<colspec colname="COL2" colwidth="0.98in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>If wire harness inspection is NG</ptxt>
</entry>
<entry align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>If current DTC and wire harness inspection is OK</ptxt>
</entry>
<entry align="center">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>If history DTC and wire harness inspection is OK</ptxt>
</entry>
<entry align="center">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000IH00WC_13_0007" fin="true">A</down>
<right ref="X39400000IH00WC_13_0004" fin="true">B</right>
<right ref="X39400000IH00WC_13_0003" fin="true">C</right>
</res>
</testgrp>
