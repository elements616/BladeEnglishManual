<descript-testgroup>
<testtitle>Inspect CAN Communication System Communication Function</testtitle>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), perform CAN bus diagnosis and confirm that there are no malfunctions in the communication lines of the ECUs connected to the CAN communication system.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.15in"/>
<colspec colname="COL2" align="center" colwidth="0.98in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>If CAN Communication System Is Normal</ptxt>
<ptxt>[No DTC Output (CAN Communication Malfunction, ECU Communication Malfunction/Lost Communication)]</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>If CAN Communication System Is Abnormal</ptxt>
<ptxt>[DTC Output (CAN Communication Malfunction, ECU Communication Malfunction/Lost Communication)]</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<results>
<result>B</result>
<action-ci-right>Go to each Troubleshooting Flowchart of CAN Communication System (see <xref label="Seep02" href="RM0000005RL01NX"/>)</action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
</descript-testgroup>
