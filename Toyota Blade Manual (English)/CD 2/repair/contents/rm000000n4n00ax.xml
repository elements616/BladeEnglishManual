<name>Power Steering</name>
<ttl id="1000V_S0011_744XO_T0099" variety="T0099">
<name>Steering Gear Assembly</name>
<para id="RM000000N4N00AX" category="A" type-id="8000E" name-id="490RF-00" from="200612" to="200912">
<name>Reassembly</name>
<subpara id="RM000000N4N00AX_01" type-id="01" category="01">
<s-1 id="RM000000N4N00AX_01_0007" proc-id="RM0550J___000050300000">
<ptxt>Install Tie Rod End Sub-assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the lock nut and tie rod end LH up to the matchmarks, and temporarily tighten the lock nut.</ptxt>
<atten4>
<ptxt>Perform final tightening after the toe-in adjustment.</ptxt>
</atten4>
<figure>
<graphic graphicname="C150341J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000N4N00AX_01_0008" proc-id="RM0550J___000050400000">
<ptxt>Install Tie Rod End Sub-assembly RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Use the same procedure for the RH side as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
</subpara>
</para>
</ttl>
