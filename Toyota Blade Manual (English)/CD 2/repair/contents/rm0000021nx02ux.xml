<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_746W2_T00DG" variety="T00DG">
<name>Back Guide Monitor System</name>
<para id="RM0000021NX02UX" category="C" type-id="803MD" name-id="673A7-01" from="200912">
<dtccode>C1622</dtccode>
<dtcname>Back Camera Not Connected</dtcname>
<subpara id="RM0000021NX02UX_05" type-id="33" category="03" proc-id="RM0550J___0000HY000000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the navigation receiver assembly self-diagnosis judges that the input/output signal line to the television camera assembly connected to the navigation receiver assembly is open.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="2.51in"/>
<colspec colname="COL3" colwidth="3.57in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1622</ptxt>
</entry>
<entry valign="middle">
<ptxt>Back Camera Signal Open Circuit</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire Harness and Connector</ptxt>
</item>
<item>
<ptxt>Navigation Receiver Assembly</ptxt>
</item>
<item>
<ptxt>Television Camera Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000021NX02UX_06" type-id="32" category="03" proc-id="RM0550J___0000HY100000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E168512J17" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM0000021NX02UX_07" type-id="51" category="05" proc-id="RM0550J___0000HY200000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the battery terminal is disconnected, perform steering sensor neutral point memorization. (see <xref label="Seep01" href="RM000000GCY00LX"/>)</ptxt>
</item>
<item>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration and setting operations for other systems as well as the back guide monitor system may be necessary. (see <xref label="Seep02" href="RM000002FZ603QX"/>)</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM0000021NX02UX_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000021NX02UX_08_0021" proc-id="RM0550J___0000HY300000">
<testtitle>Inspect Wire Harness and Connector (Navigation Receiver Assembly - Television Camera Assembly)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation  </ptxt>
<test2>
<ptxt>Disconnect connector D of the navigation receiver assembly.</ptxt>
</test2>
<test2>
<ptxt>Disconnect the television camera assembly connector.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance of the wire harness between the navigation receiver assembly and television camera assembly.</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>D2 (CA+) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>D12 (CGND) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>D1 (V+) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>D11 (V-) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>D2(CA+) - 4(CB+)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>D12(CGND) - 3(CGND)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>D1(V+) - 2(CV+)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>D11(V-) - 1(CV-)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021NX02UX_08_0024" fin="false">OK</down>
<right ref="RM0000021NX02UX_08_0014" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000021NX02UX_08_0024" proc-id="RM0550J___0000HY600000">
<testtitle>Inspect Navigation Receiver Assembly (V-, CGND)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation  </ptxt>
<test2>
<ptxt>Disconnect connector D of the navigation receiver assembly.</ptxt>
<figure>
<graphic graphicname="E187173J04" width="2.775699831in" height="1.771723296in"/>
</figure>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between each terminal of the connector and body ground.</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>D11 (V-) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>D12 (CGND) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.83in"/>
<colspec colname="COL2" colwidth="3.30in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry valign="middle">
<ptxt>Connector Disconnected</ptxt>
<ptxt>(Navigation Receiver Assembly)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM0000021NX02UX_08_0022" fin="false">OK</down>
<right ref="RM0000021NX02UX_08_0025" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000021NX02UX_08_0022" proc-id="RM0550J___0000HY400000">
<testtitle>Inspect Wire Harness and Connector (Television Camera Assembly Power Source)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation  </ptxt>
<test2>
<ptxt>Disconnect the television camera assembly connector.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Voltage Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), with the navigation receiver assembly connector D connected, measure the voltage between each terminal of the television camera assembly vehicle side wire harness connector.</ptxt>
<spec>
<title>Voltage</title>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>4(CB+) - 3(CGND)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON, shift lever in R</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>5.7 to 6.5 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021NX02UX_08_0023" fin="false">OK</down>
<right ref="RM0000021NX02UX_08_0020" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000021NX02UX_08_0023" proc-id="RM0550J___0000HY500000">
<testtitle>Inspect Navigation Receiver Assembly (V+, E)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Waveform Inspection</ptxt>
<figure>
<graphic graphicname="E187175J04" width="2.775699831in" height="3.779676365in"/>
</figure>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.83in"/>
<colspec colname="COL2" colwidth="3.30in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry valign="middle">
<ptxt>Connector connection condition</ptxt>
<ptxt>(Navigation Receiver Assembly)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<test2>
<ptxt>Using SST (TaSCAN), with the navigation receiver assembly and television camera assembly connectors connected, measure the waveform between connectors A and D of the navigation receiver assembly vehicle side wire harness.</ptxt>
<figure>
<graphic graphicname="E160007J08" width="2.775699831in" height="4.7836529in"/>
</figure>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>As shown in the illustration</ptxt>
</specitem>
<table>
<tgroup cols="2" align="left">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="2.75in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Terminal No. (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>D1(V+) - A7(E)</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Tool Setting</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>200 mV/DIV、50 μS/DIV</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Measurement Condition</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Waveform A: When the television camera assembly is not covered and the screen displays the rear surrounding image with IG ON and shift lever in R</ptxt>
</item>
<item>
<ptxt>Waveform B: When the television camera assembly is covered by hand, etc. and the screen displays a black screen with IG ON and shift lever in R</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>The image waveform varies depending on the image captured by the camera.</ptxt>
</atten3>
</test2>
</test1>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.83in"/>
<colspec colname="COL2" colwidth="3.30in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry valign="middle">
<ptxt>Waveform A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>*b</ptxt>
</entry>
<entry valign="middle">
<ptxt>Waveform B</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>*c</ptxt>
</entry>
<entry valign="middle">
<ptxt>Synchronizing signal</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>*d</ptxt>
</entry>
<entry valign="middle">
<ptxt>Image waveform</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM0000021NX02UX_08_0013" fin="true">OK</down>
<right ref="RM0000021NX02UX_08_0016" fin="true">NG</right>
</res>
</testgrp>
