<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7420N_T0015" variety="T0015">
<name>Lighting System</name>
<para id="RM000002ZYV000X" category="C" type-id="300V0" name-id="603KR-00" from="200612">
<dtccode>B1244</dtccode>
<dtcname>Light sensor malfunction</dtcname>
<subpara id="RM000002ZYV000X_01" type-id="31" category="03" proc-id="RM0550J___000065D00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The automatic light control sensor converts the detected ambient brightness into an electrical signal and outputs it to the instrument panel junction block assembly (main body ECU). According to this signal, the instrument panel junction block assembly (main body ECU) turns the headlights and taillights on and off.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="2.54in"/>
<colspec colname="COL3" colwidth="3.17in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B1244</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>IG ON, headlight dimmer switch at AUTO</ptxt>
</item>
<item>
<ptxt>Light sensor illuminance signal input malfunction</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Automatic light control sensor</ptxt>
</item>
<item>
<ptxt>Instrument Panel Junction Block Assembly (Main Body ECU)</ptxt>
</item>
<item>
<ptxt>Vehicle wire harness and connector (sensor input system)</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000002ZYV000X_02" type-id="32" category="03" proc-id="RM0550J___000065E00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E144381J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000002ZYV000X_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000002ZYV000X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002ZYV000X_04_0001" proc-id="RM0550J___000065F00000">
<testtitle>Read TaSCAN Data</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "ECU Data Monitor" screen and check the computer data.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>ECU Data Monitor reference values are normal</ptxt>
</specitem>
<table pgwide="1">
<title>[System selection screen: Body → Main Body → ECU Data Monitor]</title>
<tgroup cols="4">
<colspec colname="COL1" colwidth="1.49in"/>
<colspec colname="COL2" colwidth="2.23in"/>
<colspec colname="COL3" colwidth="2.52in"/>
<colspec colname="COL4" colwidth="0.84in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name (Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Item Description/Display Range</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard Value</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Remarks</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Light Sensor Illuminance Information</ptxt>
<ptxt>(LSEN)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Automatic light control sensor status</ptxt>
<ptxt>Display Range: 0 to 235600</ptxt>
</entry>
<entry valign="middle">
<ptxt>Outputs a value according to brightness (unit: lx)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Displays 0 when there is no light</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>NG</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>OK</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002ZYV000X_04_0002" fin="false">A</down>
<right ref="RM000002ZYV000X_04_0005" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000002ZYV000X_04_0002" proc-id="RM0550J___000065G00000">
<testtitle>Inspect Wire Harness and Connector (Instrument Panel Junction Block Assembly (Main Body ECU) - Automatic Light Control Sensor)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D701ZX"/>.</ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect connector U of the instrument panel junction block assembly (main body ECU) and the automatic light control sensor connector.</ptxt>
<figure>
<graphic graphicname="E140383J02" width="7.106578999in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the vehicle side wire harness connectors.</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U16(CLTB) - 1(CLTB)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U15(CLTS) - 4(CLTS)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U14(CLTE) - 3(CLTE)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between each terminal of the vehicle side wire harness connector and body ground.</ptxt>
</test1>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U16 (CLTB) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U15 (CLTS) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U14 (CLTE) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM000002ZYV000X_04_0003" fin="false">OK</down>
<right ref="RM000002ZYV000X_04_0006" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002ZYV000X_04_0003" proc-id="RM0550J___000065H00000">
<testtitle>Inspect Instrument Panel Junction Block Assembly</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect connector U of the instrument panel junction block assembly (main body ECU).</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the terminals from the back side of the connector.</ptxt>
<figure>
<graphic graphicname="E140384J02" width="7.106578999in" height="2.775699831in"/>
</figure>
<spec>
<title>Voltage</title>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U16(CLTB) - U14(CLTE)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002ZYV000X_04_0004" fin="false">OK</down>
<right ref="RM000002ZYV000X_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002ZYV000X_04_0004" proc-id="RM0550J___000065I00000">
<testtitle>Inspect Automatic Light Control Sensor</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect the automatic light control sensor connector.</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), check that a waveform is generated between the terminals below.</ptxt>
<figure>
<graphic graphicname="E148444J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>With the connector connected, inspect from the back side of the connector.</ptxt>
</atten3>
<spec>
<title>Standard (Waveform)</title>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL3" colwidth="1.91in"/>
<colspec colname="COL5" colwidth="2.44in"/>
<colspec colname="COL6" colwidth="2.73in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
<ptxt>[Positive - Negative]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>4(CLTS) - 3(CLTE)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON、</ptxt>
<ptxt>Light control switch AUTO</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Pulse generation (waveform 1)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<test2>
<ptxt>Waveform 1</ptxt>
<figure>
<graphic graphicname="E141421J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.26in"/>
<colspec colname="COL2" colwidth="2.87in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Tool Setting</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>5V/DIV、5ms/DIV</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten4>
<ptxt>The width of A becomes narrower as the surroundings become brighter.</ptxt>
</atten4>
</test2>
</test1>
</content6>
<res>
<down ref="RM000002ZYV000X_04_0005" fin="true">OK</down>
<right ref="RM000002ZYV000X_04_0007" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002ZYV000X_04_0005">
<testtitle>Replace Instrument Panel Junction Block Assembly</testtitle>
</testgrp>
<testgrp id="RM000002ZYV000X_04_0006">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000002ZYV000X_04_0007">
<testtitle>Replace Automatic Light Control Sensor</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
