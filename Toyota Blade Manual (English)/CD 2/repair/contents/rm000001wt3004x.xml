<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_742BT_T003Y" variety="T003Y">
<name>Antenna Cord Sub-assembly NO.4</name>
<para id="RM000001WT3004X" category="A" type-id="30014" name-id="652MY-00" from="200612" to="200912">
<name>Installation</name>
<subpara id="RM000001WT3004X_01" type-id="01" category="01">
<s-1 id="RM000001WT3004X_01_0001" proc-id="RM0550J___00001XQ00000">
<ptxt>Install Antenna Cord Sub-assembly NO.4</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E147021" width="7.106578999in" height="3.779676365in"/>
</figure>
<s2>
<ptxt>Engage the 12 clamps and temporarily install antenna cord NO.4.</ptxt>
</s2>
<s2>
<ptxt>Install the 2 bolts.</ptxt>
<torque>
<torqueitem>
<t-value1>7.0</t-value1>
<t-value2>71</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect each connector and install antenna cord NO.4.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001WT3004X_01_0007" proc-id="RM0550J___00009VP00000">
<ptxt>Install Back Door Trim Panel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 11 clips to install the back door trim panel assembly.</ptxt>
<figure>
<graphic graphicname="B155573J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install clip (A).</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001WT3004X_01_0008" proc-id="RM0550J___00009VQ00000">
<ptxt>Install Back Door Inside Handle
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws to install the back door inside handle.</ptxt>
<figure>
<graphic graphicname="B155572" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001WT3004X_01_0009" proc-id="RM0550J___00009VR00000">
<ptxt>Install Back Door Side Garnish LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the clips and claws to install the back door side garnish LH.</ptxt>
<figure>
<graphic graphicname="B155569" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Align the guide position, and engage the 2 claws to install the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B155570J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the pin of the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B163626" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001WT3004X_01_0010" proc-id="RM0550J___00009VS00000">
<ptxt>Install Back Door Side Garnish RH
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Install the RH side using the same procedure as for the LH side.</ptxt>
</atten4>
</content1></s-1>
<s-1 id="RM000001WT3004X_01_0011" proc-id="RM0550J___00009VV00000">
<ptxt>Install Back Door Trim Panel Assembly Upper
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and 4 claws to install the back door trim panel assembly upper.</ptxt>
<figure>
<graphic graphicname="B155566" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>