<subpara id="RM000000FTZ01FX_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000000FTZ01FX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000FTZ01FX_04_0001" proc-id="RM0550J___000045B00001">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (A/T Oil Temperature 1 (CVT Fluid Temperature))</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), display the [ECU Data Monitor] screen according to the screen display, and check the computer data.</ptxt>
<table pgwide="1">
<title>[Diagnosis menu screen: Powertrain → TCCS → ECU Data Monitor]</title>
<tgroup cols="4">
<colspec colname="COL1" colwidth="1.24in"/>
<colspec colname="COL2" colwidth="2.30in"/>
<colspec colname="COL3" colwidth="2.29in"/>
<colspec colname="COL4" colwidth="1.25in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
<ptxt>[Symbol]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Item Description</ptxt>
<ptxt>Display Range</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard Value</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Remarks</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>A/T Fluid Temperature1</ptxt>
<ptxt>[THO1]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates CVT fluid temperature</ptxt>
<ptxt>Display range: -40 to 215°C</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>IG ON when cold</ptxt>
<ptxt>Outside Temperature</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>-</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>A/T Fluid Temperature1</ptxt>
<ptxt>[THO1]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates CVT fluid temperature</ptxt>
<ptxt>Display range: -40 to 215°C</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>After stall test</ptxt>
<ptxt>Approx. 100°C</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>-</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Data monitor value is outside standard</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Data monitor value is within standard</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000FTZ01FX_04_0002" fin="false">A</down>
<right ref="RM000000FTZ01FX_04_0012" fin="false">B</right>
</res>
</testgrp>
<testgrp id="RM000000FTZ01FX_04_0002" proc-id="RM0550J___000045C00001">
<testtitle>Inspect Continuously Variable Transaxle Assembly (Fluid Temperature Sensor)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the transmission wire connector.</ptxt>
<figure>
<graphic graphicname="C102330J41" width="2.775699831in" height="1.771723296in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the connector terminals.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.50in"/>
<colspec colname="COL2" colwidth="1.25in"/>
<colspec colname="COL3" colwidth="1.38in"/>
<tbody>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Name)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1(THO) - 6(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Fluid temperature 10°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>5 to 8 kΩ</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1(THO) - 6(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Fluid temperature 25°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>2.5 to 4.5kΩ</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1(THO) - 6(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Fluid temperature 110°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>0.22 to 0.28 kΩ</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1 (THO) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000FTZ01FX_04_0003" fin="false">OK</down>
<right ref="RM000000FTZ01FX_04_0013" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000000FTZ01FX_04_0003" proc-id="RM0550J___000045D00001">
