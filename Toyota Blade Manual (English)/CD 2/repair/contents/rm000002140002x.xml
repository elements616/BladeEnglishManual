<para id="RM000002140002X" category="A" type-id="80001" name-id="5227Z-00" from="200612">
<name>Removal</name>
<subpara id="RM000002140002X_01" type-id="01" category="01">
<s-1 id="RM000002140002X_01_0117" proc-id="RM0550J___00009OG00000">
<ptxt>Remove Console Box Insert Front NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 3 claws.</ptxt>
<figure>
<graphic graphicname="B151140J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the guides and remove console box insert front No.2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002140002X_01_0007" proc-id="RM0550J___000015Y00000">
<ptxt>Remove Air Conditioner Amplifier Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect each connector and remove the screw.</ptxt>
<figure>
<graphic graphicname="E138511" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the air conditioner amplifier assembly as shown in the illustration.</ptxt>
<figure>
<graphic graphicname="E138512" width="7.106578999in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
