<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7420F_T000X" variety="T000X">
<name>Rear Combination Light Assembly LH</name>
<para id="RM000001X81008X" category="A" type-id="80001" name-id="604O7-01" from="200912">
<name>Removal</name>
<subpara id="RM000001X81008X_01" type-id="01" category="01">
<s-1 id="RM000001X81008X_01_0035" proc-id="RM0550J___0000A6D00001">
<ptxt>Remove Rear Combination Light Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws.</ptxt>
<figure>
<graphic graphicname="E145807J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 guides and remove the rear combination light cover LH.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X81008X_01_0037" proc-id="RM0550J___0000A6F00001">
<ptxt>Remove Rear Combination Light Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector and disengage the clamp.</ptxt>
<figure>
<graphic graphicname="E147285" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 nuts.</ptxt>
<figure>
<graphic graphicname="E206595" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Pull in the direction indicated by the arrow in the illustration to disengage the 2 clips and guide, and remove the rear combination light assembly LH.</ptxt>
<atten4>
<list1 type="unordered">
<item>
<ptxt>The tail light (rear combination light) guide remains on the vehicle.</ptxt>
</item>
<item>
<ptxt>Once removed, replace the clips with new ones.</ptxt>
</item>
</list1>
</atten4>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>