<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000U_S0017" variety="S0017">
<name>Steering Column</name>
<ttl id="1000U_S0017_745FR_T00AZ" variety="T00AZ">
<name>Electric Power Steering System</name>
<para id="RM000001YRG007X" category="C" type-id="3054S" name-id="480Y6-00" from="200612">
<dtccode>C1551/25</dtccode>
<dtcname>IG Power Supply Voltage Malfunction</dtcname>
<subpara id="RM000001YRG007X_01" type-id="33" category="03" proc-id="RM0550J___00005Y600000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>As a fail-safe function, power assist is stopped while there is a malfunction in the power supply system.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.82in"/>
<colspec colname="COL2" colwidth="2.90in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry align="center">
<ptxt>DTC No</ptxt>
</entry>
<entry align="center">
<ptxt>Detection Item</ptxt>
</entry>
<entry align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1551/25</ptxt>
</entry>
<entry valign="middle">
<ptxt>Open or short in IG power source circuit</ptxt>
</entry>
<entry>
<list1 type="unordered">
<item>
<ptxt>Power Steering Computer Assembly</ptxt>
</item>
<item>
<ptxt>Power Source System</ptxt>
</item>
<item>
<ptxt>LH ECU-IG fuse</ptxt>
</item>
<item>
<ptxt>Wire Harness</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000001YRG007X_02" type-id="32" category="03" proc-id="RM0550J___00005Y700000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="F100393J06" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000001YRG007X_03" type-id="51" category="05" proc-id="RM0550J___00005Y800000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>If the power steering computer assembly is replaced, perform the torque sensor 0 point calibration and rotation angle sensor output calibration. (see <xref label="Seep01" href="RM0000024YB004X"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000001YRG007X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000001YRG007X_04_0001" proc-id="RM0550J___00005Y900000">
<testtitle>Inspect Fuse (ECU-IG No.1 10A)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Using the SST (Toyota electrical tester), measure the resistance of the fuse (ECU-IG No.1 10A).</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>ECU-IG No.1 Fuse</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM000001YRG007X_04_0002" fin="false">OK</down>
<right ref="RM000001YRG007X_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001YRG007X_04_0002" proc-id="RM0550J___00005YA00000">
<testtitle>Inspect Wire Harness and Connector (IG Power Source and Ground)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Disconnect connectors C and D of the power steering computer assembly.</ptxt>
<figure>
<graphic graphicname="C149382J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage and resistance between the wire harness side connector of the power steering computer assembly and body ground.</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>C6 (IG) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>D2 (PGND) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM000001YRG007X_04_0003" fin="true">OK</down>
<right ref="RM000001YRG007X_04_0004" fin="true">NG</right>
</res>
</testgrp>
