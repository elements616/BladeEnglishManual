<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000002BJ1006X" category="C" type-id="80207" name-id="261IB-00" from="200708">
<dtccode>P0872/C2</dtccode>
<dtcname>Hydraulic Pressure SW1 Malfunction (Low)</dtcname>
<dtccode>P0873/C2</dtccode>
<dtcname>Hydraulic Pressure SW1 Malfunction (High)</dtcname>
<dtccode>P0877/C2</dtccode>
<dtcname>Hydraulic Pressure SW2 Malfunction (Low)</dtcname>
<dtccode>P0878/C2</dtccode>
<dtcname>Hydraulic Pressure SW2 Malfunction (High)</dtcname>
<dtccode>P0989/C2</dtccode>
<dtcname>Hydraulic Pressure SW3 Malfunction (Low)</dtcname>
<dtccode>P0990/C2</dtccode>
<dtcname>Hydraulic Pressure SW3 Malfunction (High)</dtcname>
<subpara id="RM000002BJ1006X_05" type-id="33" category="03" proc-id="RM0550J___0000FUY00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>Hydraulic pressure switches No.1, No.2 and No.3 are built into the transmission wire together with the fluid temperature sensor, and detect the fluid pressure in the valve body.</ptxt>
<ptxt>When a hydraulic pressure malfunction is input due to a solenoid malfunction, the transmission control computer performs fail-safe control. If the fail-safe function is operating normally, the hydraulic pressure switch is normal.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.90in"/>
<colspec colname="COL2" colwidth="3.04in"/>
<colspec colname="COL3" colwidth="3.14in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0872/C2</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While IG ON (driving)</ptxt>
</item>
<item>
<ptxt>Hydraulic pressure switch No.1 is OFF while 1, 2, 3 or 4 gear is normally engaged</ptxt>
</item>
<item>
<ptxt>Occurs 2 times or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Automatic Transmission Temperature Sensor</ptxt>
</item>
<item>
<ptxt>Transmission wire</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P0873/C2</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While IG ON (driving)</ptxt>
</item>
<item>
<ptxt>Hydraulic pressure switch No.1 is ON while 5 or 6 gear is normally engaged</ptxt>
</item>
<item>
<ptxt>Occurs 2 times or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Automatic Transmission Temperature Sensor</ptxt>
</item>
<item>
<ptxt>Transmission wire</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P0877/C2</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While IG ON (driving)</ptxt>
</item>
<item>
<ptxt>Hydraulic pressure switch No.2 is OFF while 4, 5 or 6 gear is normally engaged</ptxt>
</item>
<item>
<ptxt>Occurs 2 times or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Automatic Transmission Temperature Sensor</ptxt>
</item>
<item>
<ptxt>Transmission wire</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P0878/C2</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While IG ON (driving)</ptxt>
</item>
<item>
<ptxt>Hydraulic pressure switch No.2 is ON while 1, 2 or 3 gear is normally engaged</ptxt>
</item>
<item>
<ptxt>Occurs 2 times or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Automatic Transmission Temperature Sensor</ptxt>
</item>
<item>
<ptxt>Transmission wire</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P0989/C2</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While IG ON (driving)</ptxt>
</item>
<item>
<ptxt>Hydraulic pressure switch No.3 is OFF after lock-up operation</ptxt>
</item>
<item>
<ptxt>1.8 seconds or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Automatic Transmission Temperature Sensor</ptxt>
</item>
<item>
<ptxt>Transmission wire</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P0990/C2</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While lock-up is not operating</ptxt>
</item>
<item>
<ptxt>Hydraulic pressure switch No.3 is ON when lock-up is not engaged, and lock-up is not engaged when lock-up disengagement is requested</ptxt>
</item>
<item>
<ptxt>1.2 seconds or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Automatic Transmission Temperature Sensor</ptxt>
</item>
<item>
<ptxt>Transmission wire</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000002BJ1006X_06" type-id="32" category="03" proc-id="RM0550J___0000FUZ00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C173976J01" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000002BJ1006X_07" type-id="51" category="05" proc-id="RM0550J___0000FV000000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Using SST (TaSCAN), read the Freeze Frame Data. Freeze frame data records the engine and vehicle conditions when a malfunction occurs, and this information is useful for troubleshooting and malfunction reproduction tests.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM000002BJ1006X_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002BJ1006X_08_0015" proc-id="RM0550J___0000FV200000">
<scantool type="1"/>
<testtitle>Check DTC Output</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check whether any solenoid malfunction DTCs are output.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.08in"/>
<colspec colname="COL2" colwidth="1.05in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Only hydraulic pressure switch malfunction DTC is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Solenoid malfunction DTC is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<atten4>
<ptxt>If solenoid malfunction DTCs are stored at the same time, inspect and repair the solenoids first.</ptxt>
</atten4>
</content6>
<res>
<down ref="RM000002BJ1006X_08_0017" fin="false">A</down>
<right ref="RM000002BJ1006X_08_0016" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000002BJ1006X_08_0017" proc-id="RM0550J___0000FV300000">
<testtitle>Inspect Transmission Wire</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Remove the transmission control computer. (Refer to the procedure)</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<figure>
<graphic graphicname="C133212J16" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.90in"/>
<colspec colname="COL2" colwidth="1.14in"/>
<colspec colname="COL3" colwidth="1.09in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>10(TPS1) - 17(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>20(TPS2) - 17(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>19(TPS3) - 17(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002BJ1006X_08_0013" fin="false">OK</down>
<right ref="RM000002BJ1006X_08_0007" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000002BJ1006X_08_0013" proc-id="RM0550J___0000HCH00000">
<testtitle>Replace Transmission Control Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the transmission control computer assembly. (see <xref label="Seep01" href="RM0000024M8003X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002BJ1006X_08_0018" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002BJ1006X_08_0018">
<testtitle>A/T Unit Compensation<xref label="Seep01" href="RM000000OLY013X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002BJ1006X_08_0007" proc-id="RM0550J___0000FV100000">
<testtitle>Inspect Transmission Wire</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D702RX"/>.</ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the transmission wire from the automatic transmission temperature sensor.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the transmission wire.</ptxt>
<figure>
<graphic graphicname="C139038J04" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="1.00in"/>
<colspec colname="COL3" colwidth="1.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>10(TPS1) - 3(TPS1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>20(TPS2) - 4(TPS2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>19(TPS3) - 5(TPS3)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>17(E2) - 1(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>10(TPS1) - 1(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>20(TPS2) - 1(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>19(TPS3) - 1(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002BJ1006X_08_0008" fin="true">OK</down>
<right ref="RM000002BJ1006X_08_0012" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002BJ1006X_08_0008">
<testtitle>Replace Automatic Transmission Temperature Sensor<xref label="Seep01" href="RM000002BNZ003X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002BJ1006X_08_0016">
<testtitle>Go to Related DTC Chart<xref label="Seep01" href="RM000000DAO01DX"/>
</testtitle>
</testgrp>
<testgrp id="RM000002BJ1006X_08_0012">
<testtitle>Repair or Replace Transmission Wire<xref label="Seep01" href="RM000002BOQ004X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
