<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_746W2_T00DG" variety="T00DG">
<name>Back Guide Monitor System</name>
<para id="RM000003MMY00GX" category="J" type-id="303DF" name-id="673A5-01" from="200912">
<dtccode/>
<dtcname>Reverse Signal Circuit</dtcname>
<subpara id="RM000003MMY00GX_01" type-id="31" category="03" proc-id="RM0550J___0000HYQ00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The navigation receiver assembly receives the reverse signal from the neutral start switch assembly. When it receives the reverse signal, the navigation receiver assembly switches the screen display to the image from the television camera assembly.</ptxt>
</content5>
</subpara>
<subpara id="RM000003MMY00GX_02" type-id="32" category="03" proc-id="RM0550J___0000HYR00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E159986J06" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000003MMY00GX_03" type-id="51" category="05" proc-id="RM0550J___0000HYS00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the battery terminal is disconnected, perform steering sensor neutral point memorization. (see <xref label="Seep01" href="RM000000GCY00LX"/>) </ptxt>
</item>
<item>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration and setting operations for other systems as well as the back guide monitor system may be necessary. (see <xref label="Seep02" href="RM000002FZ603QX"/>)</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM000003MMY00GX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000003MMY00GX_04_0002" proc-id="RM0550J___0000HYT00000">
<testtitle>Inspect Navigation Receiver Assembly (REV)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="E176603J03" width="2.775699831in" height="2.775699831in"/>
</figure>
<test1>
<ptxt>Pre-inspection Preparation</ptxt>
<test2>
<ptxt>Disconnect navigation receiver assembly connector F.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Voltage Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between terminal F5 (REV) and body ground from the back of the connector.</ptxt>
<spec>
<title>Voltage</title>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>F5 (REV) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Shift lever in R position</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>7.5 to 14 V</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>F5 (REV) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Shift lever in any position other than R</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry>
<ptxt>Connector Disconnected</ptxt>
<ptxt>(Navigation Receiver Assembly)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test2>
</test1>
</content6>
<res>
<down ref="RM000003MMY00GX_04_0003" fin="true">OK</down>
<right ref="RM000003MMY00GX_04_0004" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000003MMY00GX_04_0003">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM000003MMY00GX_04_0004" proc-id="RM0550J___0000HYU00000">
<testtitle>Inspect Wire Harness and Connector (Navigation Receiver Assembly - Neutral Start Switch Assembly)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation  </ptxt>
<test2>
<ptxt>Disconnect navigation receiver assembly connector F.</ptxt>
</test2>
<test2>
<ptxt>Disconnect the neutral start switch assembly connector.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance of the wire harness between the navigation receiver assembly and neutral start switch assembly.</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>F5 (REV) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>F5(REV) - 2(RL)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000003MMY00GX_04_0005" fin="false">OK</down>
<right ref="RM000003MMY00GX_04_0008" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000003MMY00GX_04_0005" proc-id="RM0550J___0000HYV00000">
<testtitle>Inspect Neutral Start Switch Assembly</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Resistance Inspection</ptxt>
<figure>
<graphic graphicname="C125840J44" width="2.775699831in" height="1.771723296in"/>
</figure>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the neutral start switch assembly connector.</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1(RB) - 2(RL)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Shift lever in R position</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>1(RB) - 2(RL)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Shift lever in any position other than R</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
<test2>
<ptxt>Check the inspection result and proceed to the destination below.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>OK</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>NG (CVT models)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>NG (A/T models)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry>
<ptxt>Connector Disconnected</ptxt>
<ptxt>(Neutral Start Switch Assembly)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test2>
</test1>
</content6>
<res>
<down ref="RM000003MMY00GX_04_0006" fin="true">A</down>
<right ref="RM000003MMY00GX_04_0009" fin="true">B</right>
<right ref="RM000003MMY00GX_04_0010" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM000003MMY00GX_04_0006">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000003MMY00GX_04_0008">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000003MMY00GX_04_0009">
<testtitle>Replace Neutral Start Switch Assembly<xref label="Seep01" href="RM000000E1100DX"/>
</testtitle>
</testgrp>
<testgrp id="RM000003MMY00GX_04_0010">
<testtitle>Replace Neutral Start Switch Assembly<xref label="Seep01" href="RM000002BON003X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
