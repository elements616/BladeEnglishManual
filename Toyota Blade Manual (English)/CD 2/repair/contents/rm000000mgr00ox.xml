<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002O_S0008" variety="S0008">
<name>Engine Immobiliser</name>
<ttl id="1002O_S0008_741KM_T000P" variety="T000P">
<name>Engine Immobiliser System</name>
<para id="RM000000MGR00OX" category="C" type-id="302EP" name-id="580M4-00" from="200612">
<dtccode>B2784</dtccode>
<dtcname>Antenna Coil Malfunction</dtcname>
<subpara id="RM000000MGR00OX_07" type-id="31" category="03" proc-id="RM0550J___0000A4D00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The certification ECU (smart key computer assembly) outputs this code when a malfunction such as an open or short circuit is detected in the antenna coil in the engine switch, or when the engine switch is not connected. Also, past DTCs are not stored.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.08in"/>
<colspec colname="COL2" colwidth="2.64in"/>
<colspec colname="COL3" colwidth="3.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B2784</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Open or short circuit in antenna coil</ptxt>
</item>
<item>
<ptxt>Engine switch not connected</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Engine Switch</ptxt>
</item>
<item>
<ptxt>Certification ECU (Smart Key Computer Assembly)</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000MGR00OX_09" type-id="51" category="05" proc-id="RM0550J___0000A4E00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>When replacing the certification ECU (smart key computer assembly) or electrical key transmitter (electronic key), check the precautions. (see <xref label="Seep01" href="RM000000MGE00SX"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000000MGR00OX_10" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000MGR00OX_10_0009" proc-id="RM0550J___0000A4F00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs. (see <xref label="Seep01" href="RM000000MGS00TX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000MGR00OX_10_0019" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000MGR00OX_10_0019" proc-id="RM0550J___0000A4G00000">
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs.</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.07in"/>
<colspec colname="COL2" colwidth="1.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B2784 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>B2784 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000MGR00OX_10_0020" fin="false">A</down>
<right ref="RM000000MGR00OX_10_0022" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000MGR00OX_10_0020" proc-id="RM0550J___0000A4H00000">
<testtitle>Replace with Known Good Engine Switch</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the engine switch with a normal one, and check that the ignition switch can be turned ON and the engine can be started.</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.06in"/>
<colspec colname="COL2" colwidth="1.07in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Ignition switch can be turned ON and engine can be started</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Ignition switch cannot be turned ON and engine cannot be started</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000MGR00OX_10_0021" fin="true">OK</down>
<right ref="RM000000MGR00OX_10_0023" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000MGR00OX_10_0021">
<testtitle>End (engine switch malfunction)</testtitle>
</testgrp>
<testgrp id="RM000000MGR00OX_10_0022">
<testtitle>Go to Problem Symptom Simulation Method<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000MGR00OX_10_0023">
<testtitle>Replace Smart Key Computer Assembly</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>