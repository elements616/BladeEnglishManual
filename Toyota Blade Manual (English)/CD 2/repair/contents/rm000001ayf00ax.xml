</atten4>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>List by Symptom</testtitle>
<test1>
<ptxt>Check whether the symptom is listed in the symptom list. (see <xref label="Seep04" href="RM0000004UV00EX"/>)</ptxt>
</test1>
<table>
<title>Result</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
