<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="08">
<name>Heater &amp; Air Conditioner/Ventilation</name>
<section id="1002K_S000B" variety="S000B">
<name>Air Conditioner</name>
<ttl id="1002K_S000B_7421Y_T0028" variety="T0028">
<name>Air Conditioning Radiator Assembly</name>
<para id="RM00000213G002X" category="A" type-id="80002" name-id="5227N-00" from="200612">
<name>Disassembly</name>
<subpara id="RM00000213G002X_01" type-id="01" category="01">
<s-1 id="RM00000213G002X_01_0001" proc-id="RM0550J___000013800000">
<ptxt>Remove Mode Damper Servo Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="E125907J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 screws and remove the mode damper servo.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0002" proc-id="RM0550J___000013900000">
<ptxt>Remove Air Mix Damper Servo Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Automatic air conditioning (driver side)</ptxt>
<figure>
<graphic graphicname="E138549J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<s3>
<ptxt>Disconnect the connector.</ptxt>
</s3>
<s3>
<ptxt>Remove the 3 screws and remove the air mix damper servo.</ptxt>
</s3>
</s2>
<s2>
<ptxt>Dual mode automatic air conditioning (driver side)</ptxt>
<figure>
<graphic graphicname="E126017J03" width="2.775699831in" height="2.775699831in"/>
</figure>
<s3>
<ptxt>Disconnect the connector.</ptxt>
</s3>
<s3>
<ptxt>Remove the 3 screws and remove the air mix damper servo.</ptxt>
</s3>
</s2>
<s2>
<ptxt>Dual mode automatic air conditioning (front passenger side)</ptxt>
<figure>
<graphic graphicname="E147366J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<s3>
<ptxt>Disconnect the connector.</ptxt>
</s3>
<s3>
<ptxt>Remove the 3 screws and remove the air mix damper servo.</ptxt>
</s3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0003" proc-id="RM0550J___000013A00000">
<ptxt>Remove Air Conditioner Harness Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage each clamp and remove the air conditioner harness assembly.</ptxt>
<figure>
<graphic graphicname="E144710" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0006" proc-id="RM0550J___000013D00000">
<ptxt>Remove Upper Console Mounting Bracket</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claw and remove the upper console mounting bracket.</ptxt>
<figure>
<graphic graphicname="E126015J04" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0005" proc-id="RM0550J___000013C00000">
<ptxt>Remove Console Mounting Bracket LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the screw and remove the console mounting bracket LH.</ptxt>
<figure>
<graphic graphicname="E138555J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0004" proc-id="RM0550J___000013B00000">
<ptxt>Remove Air Conditioner Amplifier Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the screw, disengage the claw and remove the air conditioner amplifier assembly.</ptxt>
<figure>
<graphic graphicname="E139262J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0013" proc-id="RM0550J___000075T00000">
<ptxt>Remove Air Conditioner Duct</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the air conditioner duct.</ptxt>
<figure>
<graphic graphicname="E138551J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0014" proc-id="RM0550J___000075U00000">
<ptxt>Remove Drain Cooler Hose</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the cooler drain hose.</ptxt>
<figure>
<graphic graphicname="E139264J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0007" proc-id="RM0550J___000013E00000">
<ptxt>Remove Radiator Heater Unit</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the screw and remove the clamp.</ptxt>
<figure>
<graphic graphicname="E140735J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the radiator heater unit from the air conditioner unit assembly.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0008" proc-id="RM0550J___000013F00000">
<ptxt>Remove Cooler Expansion Valve</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a hexagon wrench, remove the 2 hexagon bolts and remove the cooler expansion valve.</ptxt>
<figure>
<graphic graphicname="E138554J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0009" proc-id="RM0550J___000013G00000">
<ptxt>Remove Cooler Evaporator NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 screws.</ptxt>
<figure>
<graphic graphicname="E139266J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 4 claws as shown in the illustration and remove the lower heater case.</ptxt>
<figure>
<graphic graphicname="E139267J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the clamp and remove the cooler evaporator NO.1 together with the cooler thermistor NO.1.</ptxt>
<figure>
<graphic graphicname="E139269J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 O-rings from the cooler evaporator NO.1.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213G002X_01_0010" proc-id="RM0550J___000013H00000">
<ptxt>Remove Cooler Thermistor NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the cooler thermistor NO.1 from the cooler evaporator NO.1.</ptxt>
<figure>
<graphic graphicname="E139270J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>