<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Tachometer</ptxt>
</entry>
<entry valign="middle">
<ptxt>Engine Speed Indication Switching</ptxt>
</entry>
<entry valign="middle">
<ptxt>7000、6000、5000、4000、3000、2000、1000、0(r/min)</ptxt>
