<name>DTC Check/Clear</name>
<subpara id="RM0000005KH00RX_z0" proc-id="RM0550J___000005V00000">
<content5 releasenbr="1">
<step1>
<ptxt>Check DTCs Using TaSCAN</ptxt>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<step2>
<ptxt>Using SST (TaSCAN), select "Diagnosis" → "ALL Diag" or "Diagnosis" → "Body" → "Meter" → "DTC" by following the screen instructions, and check the diagnostic trouble codes.</ptxt>
</step2>
</step1>
<step1>
<ptxt>Clear DTC Memory Using TaSCAN</ptxt>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<step2>
<ptxt>Using SST (TaSCAN), select "Diagnosis" → "ALL Diag" → "Clear" or "Diagnosis" → "Body" → "Meter" → "DTC" → "Clear" by following the screen instructions, and clear the diagnostic trouble codes.</ptxt>
</step2>
</step1>
</content5>
