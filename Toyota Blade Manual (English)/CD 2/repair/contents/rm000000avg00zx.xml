<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000000AVG00ZX" category="C" type-id="3007P" name-id="261HZ-00" from="200708">
<dtccode>P0500/42</dtccode>
<dtcname>Vehicle Speed Sensor System</dtcname>
<subpara id="RM000000AVG00ZX_05" type-id="31" category="03" proc-id="RM0550J___0000FQT00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The vehicle speed pulse signal output from the ABS speed sensor installed on each wheel is converted by the skid control computer into a vehicle speed pulse signal (equivalent to 4 pulses per 1 revolution of the transaxle rotating shaft), and input to the transmission control computer as the vehicle speed signal via the combination meter assembly.</ptxt>
<figure>
<graphic graphicname="A065387J09" width="7.106578999in" height="2.775699831in"/>
</figure>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.15in"/>
<colspec colname="COL2" colwidth="3.57in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0500/42</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While driving</ptxt>
</item>
<item>
<ptxt>SPD signal is not input</ptxt>
</item>
<item>
<ptxt>2 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire Harness or Connector</ptxt>
</item>
<item>
<ptxt>Combination Meter Assembly</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
<item>
<ptxt>ABS &amp; Traction Actuator Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000AVG00ZX_06" type-id="32" category="03" proc-id="RM0550J___0000FQU00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="G100110J14" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000AVG00ZX_07" type-id="51" category="05" proc-id="RM0550J___0000FQV00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<list1 type="unordered">
<item>
<ptxt>If the SPD line branches to other ECUs from an option connector, etc., first disconnect those circuits and check whether the problem is eliminated.</ptxt>
</item>
<item>
<ptxt>Using SST (TaSCAN), read the Freeze Frame Data. Freeze Frame Data records part of the engine operating conditions when a malfunction occurs, and this information is useful for troubleshooting.</ptxt>
</item>
</list1>
</atten4>
</content5>
</subpara>
<subpara id="RM000000AVG00ZX_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000AVG00ZX_08_0007" proc-id="RM0550J___0000FQW00000">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Vehicle Speed)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check that the speedometer operates normally.</ptxt>
</test1>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Perform a road test of the vehicle.</ptxt>
</test1>
<test1>
<ptxt>Following the SST (TaSCAN) screen display, read the Data List item [Vehicle Speed] from [Diagnosis Function Menu] → [ECU Data Monitor].</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>SST (TaSCAN) data monitor display and speedometer display are the same</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000AVG00ZX_08_0012" fin="true">OK</down>
<right ref="RM000000AVG00ZX_08_0008" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000000AVG00ZX_08_0008" proc-id="RM0550J___0000FQX00000">
<testtitle>Inspect Combination Meter Assembly (Vehicle Speed Pulse Signal Inspection)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<atten4>
<ptxt>Using the oscilloscope function of the SST (TaSCAN), a function check between the transmission control computer and the speed sensor can be performed.</ptxt>
</atten4>
<figure>
<graphic graphicname="E138615J06" width="2.775699831in" height="3.779676365in"/>
</figure>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Connect the SST (TaSCAN) between terminal 36 (+S) of the combination meter assembly connector and body ground.</ptxt>
</test1>
<test1>
<ptxt>Set the SST (TaSCAN) to the oscilloscope function.</ptxt>
</test1>
<test1>
<ptxt>Check the waveform while driving.</ptxt>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Item</ptxt>
</entry>
<entry valign="middle">
<ptxt>Description</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Measurement Terminal</ptxt>
</entry>
<entry valign="middle">
<ptxt>36 (+S) - Body ground</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Tool Setting</ptxt>
</entry>
<entry valign="middle">
<ptxt>2V/DIV、20ms/DIV</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Measurement Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Driving at approximately 20km/h</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten4>
<list1 type="unordered">
<item>
<ptxt>As the vehicle speed increases, the waveform cycle becomes shorter.</ptxt>
</item>
<item>
<ptxt>The ECU terminal potential is theoretically a pulse signal of 0 to 5V, but on vehicles with other ECUs branch-connected by options, etc., it may be a pulse signal of 0 to 12V.</ptxt>
</item>
</list1>
</atten4>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.08in"/>
<colspec colname="COL2" colwidth="1.05in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Waveform as shown in the illustration is not displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Waveform as shown in the illustration is displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000AVG00ZX_08_0010" fin="false">A</down>
<right ref="RM000000AVG00ZX_08_0011" fin="false">B</right>
</res>
</testgrp>
<testgrp id="RM000000AVG00ZX_08_0010" proc-id="RM0550J___0000FQZ00000">
<testtitle>Inspect Combination Meter Assembly (Terminal Voltage Inspection)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the combination meter assembly connector.</ptxt>
<figure>
<graphic graphicname="B172670J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the terminals.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.37in"/>
<colspec colname="COLSPEC0" colwidth="1.38in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>36 (+S) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>4.5 to 5.5V</ptxt>
<ptxt>(11 to 14V)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>The ECU terminal potential is theoretically a pulse signal of 0 to 5V, but on vehicles with other ECUs branch-connected by options, etc., it may be a pulse signal of 0 to 12V.</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="RM000000AVG00ZX_08_0015" fin="true">OK</down>
<right ref="RM000000AVG00ZX_08_0011" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000000AVG00ZX_08_0011" proc-id="RM0550J___0000FR000000">
<testtitle>Inspect Wire Harness and Connector (Transmission Control Computer - Combination Meter Assembly)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D702RX"/></ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the transmission control computer connector and the combination meter assembly connector.</ptxt>
<figure>
<graphic graphicname="C173973J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.37in"/>
<colspec colname="COLSPEC1" colwidth="2.35in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>3(SPD) - 36(+S)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.37in"/>
<colspec colname="COLSPEC1" colwidth="2.35in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>3 (SPD) and 36 (+S) - Other terminals or body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000AVG00ZX_08_0014" fin="false">OK</down>
<right ref="RM000000AVG00ZX_08_0013" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000AVG00ZX_08_0014" proc-id="RM0550J___0000HBX00000">
<testtitle>Replace Transmission Control Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the transmission control computer assembly. (see <xref label="Seep01" href="RM0000024M8003X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000AVG00ZX_08_0018" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000AVG00ZX_08_0012">
<testtitle>Inspection for Intermittent Problems<xref label="Seep01" href="RM000000CFT01CX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000AVG00ZX_08_0013">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000000AVG00ZX_08_0015">
<testtitle>Inspect Speedometer Circuit (Combination Meter System)<xref label="Seep01" href="RM0000005A2010X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000AVG00ZX_08_0018">
<testtitle>A/T Unit Compensation<xref label="Seep01" href="RM000000OLY013X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
