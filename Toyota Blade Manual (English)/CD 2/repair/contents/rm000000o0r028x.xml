<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74WIJ_T00FO" variety="T00FO">
<name>EFI System (2GR-FE)</name>
<para id="RM000000O0R028X" category="N" type-id="8009H" name-id="066N2-00" from="200708">
<name>Basic Inspection</name>
<subpara id="RM000000O0R028X_02" type-id="11" category="10" proc-id="RM0550J___0000CRX00000">
<content3 releasenbr="1">
<atten3>
<ptxt>If the malfunctioning area cannot be identified by troubleshooting, it can be narrowed down by performing the basic inspection shown below.</ptxt>
</atten3>
</content3>
</subpara>
<subpara id="RM000000O0R028X_01" type-id="01" category="01">
<s-1 id="RM000000O0R028X_01_0001" proc-id="RM0550J___0000CRO00000">
<ptxt>Inspect Battery</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect the condition of the battery. (see <xref label="Seep01" href="RM0000020XQ00QX_01_0001"/>)</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000O0R028X_01_0002" proc-id="RM0550J___0000CRP00000">
<ptxt>Inspect Cranking Operation</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that the engine cranks.</ptxt>
<atten4>
<ptxt>If the engine does not crank, inspect the starter system. (see <xref label="Seep01" href="RM000002AC0003X"/>)</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM000000O0R028X_01_0003" proc-id="RM0550J___0000CRQ00000">
<ptxt>Inspect Engine Starting</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that the engine starts.</ptxt>
<atten4>
<ptxt>If the engine does not start, perform the fuel pressure inspection and spark inspection.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM000000O0R028X_01_0004" proc-id="RM0550J___0000CRR00000">
<ptxt>Inspect Air Filter</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect the air filter.</ptxt>
<atten4>
<ptxt>If the air filter is dirty, clean or replace it.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM000000O0R028X_01_0005" proc-id="RM0550J___0000CRS00000">
<ptxt>Idle Speed Inspection</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect the idle speed. (see <xref label="Seep01" href="RM000001BL300EX_01_0009"/>)</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000O0R028X_01_0006" proc-id="RM0550J___0000CRT00000">
<ptxt>Inspect Ignition Timing</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect the ignition timing. (see <xref label="Seep01" href="RM000001BL300EX_01_0008"/>)</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000O0R028X_01_0007" proc-id="RM0550J___0000CRU00000">
<ptxt>Fuel Pressure Inspection</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect the fuel pressure. (see <xref label="Seep01" href="RM000002ABD006X_01_0001"/>)</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000O0R028X_01_0008" proc-id="RM0550J___0000CRV00000">
<ptxt>Inspect Spark</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect the spark. (see <xref label="Seep01" href="RM00000296J004X_01_0002"/>)</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000O0R028X_01_0009" proc-id="RM0550J___0000CRW00000">
<ptxt>Inspect Compression</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect the compression. (see <xref label="Seep01" href="RM000001BL300EX_01_0011"/>)</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>