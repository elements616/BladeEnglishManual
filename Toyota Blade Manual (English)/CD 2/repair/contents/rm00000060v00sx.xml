<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1002J_S000U" variety="S000U">
<name>Brake Control</name>
<ttl id="1002J_S000U_744TG_T0089" variety="T0089">
<name>ABS with EBD &amp; TRC &amp; VSC &amp; BA System</name>
<para id="RM00000060V00SX" category="J" type-id="300OC" name-id="442P0-00" from="200612">
<dtccode/>
<dtcname>VSC Does Not Operate (Difficult to Operate)</dtcname>
<subpara id="RM00000060V00SX_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM00000060V00SX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000060V00SX_04_0010" proc-id="RM0550J___00007UF00000">
<testtitle>Customer Problem Analysis</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Through customer problem analysis, check the illumination status of the VSC warning light when VSC did not operate.</ptxt>
<atten4>
<ptxt>When the VSC warning light is on (malfunction DTC being output), VSC does not operate due to the fail-safe function.</ptxt>
</atten4>
</test1>
<test1>
<ptxt>Through customer problem analysis, check whether the vehicle was being driven at 15km/h or less when VSC did not operate.</ptxt>
<atten4>
<ptxt>VSC does not operate at vehicle speeds of 15km/h or less.</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="RM00000060V00SX_04_0011" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000060V00SX_04_0011" proc-id="RM0550J___00007UG00000">
<scantool type="1"/>
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check whether the VSC warning light is on.</ptxt>
</test1>
<test1>
<ptxt>Using the SST (TaSCAN), check the DTCs. (see <xref label="Seep01" href="RM00000060000PX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>OK</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Malfunction Code</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060V00SX_04_0012" fin="false">A</down>
<right ref="RM00000060V00SX_04_0018" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000060V00SX_04_0012" proc-id="RM0550J___00007UH00000">
<testtitle>Inspect Tire Size</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check that tires of the specified size are installed.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Specified size</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060V00SX_04_0013" fin="false">OK</down>
<right ref="RM00000060V00SX_04_0016" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060V00SX_04_0013" proc-id="RM0550J___00007UI00000">
<testtitle>Inspect Yaw Rate Sensor</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Inspect the yaw rate sensor installation. (see <xref label="Seep01" href="RM000003054000X"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Installed correctly</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060V00SX_04_0014" fin="true">OK</down>
<right ref="RM00000060V00SX_04_0017" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060V00SX_04_0014">
<testtitle>Reacquire yaw rate sensor &amp; G sensor 0 point<xref label="Seep01" href="RM000001A8300PX"/>
</testtitle>
</testgrp>
<testgrp id="RM00000060V00SX_04_0016">
<testtitle>Return to specified size</testtitle>
</testgrp>
<testgrp id="RM00000060V00SX_04_0017">
<testtitle>Install Correctly<xref label="Seep01" href="RM000003054000X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000060V00SX_04_0018">
<testtitle>Go to Relevant DTC</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>