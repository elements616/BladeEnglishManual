<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000V_S0011" variety="S0011">
<name>Power Steering</name>
<ttl id="1000V_S0011_744XO_T0099" variety="T0099">
<name>Steering Gear Assembly</name>
<para id="RM000000N4K00AX" category="A" type-id="80002" name-id="490RD-00" from="200612" to="200912">
<name>Disassembly</name>
<subpara id="RM000000N4K00AX_01" type-id="01" category="01">
<s-1 id="RM000000N4K00AX_01_0010" proc-id="RM0550J___000072G00000">
<ptxt>Secure Steering Link Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST wrapped with protective tape, secure the power steering link assembly in a vise.</ptxt>
<figure>
<graphic graphicname="C150342J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09612-00012</s-number>
</sstitem>
</sst>
<atten4>
<ptxt>Remove and install SST as necessary.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM000000N4K00AX_01_0001" proc-id="RM0550J___00004ZY00000">
<ptxt>Remove Tie Rod End Sub-assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place matchmarks on the tie rod end LH and rack end.</ptxt>
<figure>
<graphic graphicname="C150341J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the tie rod end LH and lock nut.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000N4K00AX_01_0002" proc-id="RM0550J___00004ZZ00000">
<ptxt>Remove Tie Rod End Sub-assembly RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Use the same procedure for the RH side as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>