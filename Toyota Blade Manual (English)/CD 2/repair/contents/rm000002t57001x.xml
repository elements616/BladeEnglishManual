<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746ST_T00D9" variety="T00D9">
<name>Telephone Microphone Assembly</name>
<para id="RM000002T57001X" category="A" type-id="80001" name-id="652MQ-00" from="200612">
<name>Removal</name>
<subpara id="RM000002T57001X_01" type-id="01" category="01">
<s-1 id="RM000002T57001X_01_0003" proc-id="RM0550J___00009Y300000">
<ptxt>Remove Map Light Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a roof molding remover, disengage the 4 claws and 4 clips.</ptxt>
<figure>
<graphic graphicname="B153067" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect each connector and remove the map light assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002T57001X_01_0001" proc-id="RM0550J___0000AZS00000">
<ptxt>Remove Telephone Microphone Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="E137120" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 claws and remove the telephone microphone assembly from the map light assembly.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
