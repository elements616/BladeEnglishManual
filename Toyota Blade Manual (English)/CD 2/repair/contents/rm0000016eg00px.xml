<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y1E_T00HP" variety="T00HP">
<name>Shift Lock Control Unit Assembly (U660E)</name>
<para id="RM0000016EG00PX" category="A" type-id="8000E" name-id="261N4-01" from="200912">
<name>Reassembly</name>
<subpara id="RM0000016EG00PX_03" type-id="01" category="01">
<s-1 id="RM0000016EG00PX_03_0012" proc-id="RM0550J___0000HE600001">
<ptxt>Install Indicator Light Wire</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the bulb socket and indicator light wire to the position indicator light guide.</ptxt>
<figure>
<graphic graphicname="C221303" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the position indicator light guide together with the indicator light wire to the position indicator housing assembly with the 3 screws.</ptxt>
<figure>
<graphic graphicname="C221595" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the indicator light wire to the position indicator housing assembly with the clamp.</ptxt>
<figure>
<graphic graphicname="C221594" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000016EG00PX_03_0016" proc-id="RM0550J___0000I6K00000">
<ptxt>Install Shift Lock Control Computer</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 claws to install the shift lock control computer to the shift lock control unit assembly.</ptxt>
<figure>
<graphic graphicname="C218790" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the connector to the shift lock control computer.</ptxt>
<figure>
<graphic graphicname="C218789" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000016EG00PX_03_0017" proc-id="RM0550J___0000I6L00000">
<ptxt>Install Position Indicator Housing Lower</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert the guide of the position indicator housing LWR into the shift lock control unit assembly, and engage the 2 claws to install the position indicator housing LWR to the shift lock control unit assembly.</ptxt>
<figure>
<graphic graphicname="C218426" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<ptxt>Securely engage the claws.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM0000016EG00PX_03_0018" proc-id="RM0550J___0000I6M00000">
<ptxt>Install Position Indicator Slide Cover NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install position indicator slide cover No.2 to the position indicator slide cover.</ptxt>
<figure>
<graphic graphicname="C217245" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000016EG00PX_03_0013" proc-id="RM0550J___0000HE700001">
<ptxt>Install Position Indicator Slide Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the position indicator slide cover together with position indicator slide cover No.2 as a unit to the shift lock control unit assembly.</ptxt>
<figure>
<graphic graphicname="C217244" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000016EG00PX_03_0014" proc-id="RM0550J___0000HE800001">
<ptxt>Install Position Indicator Housing Upper</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws to install the position indicator housing UPR to the shift lock control unit assembly.</ptxt>
<figure>
<graphic graphicname="C217243" width="2.775699831in" height="3.779676365in"/>
</figure>
<atten3>
<ptxt>Securely engage the claws.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>