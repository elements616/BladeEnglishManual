<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74XTW_T00H6" variety="T00H6">
<name>Oxygen Sensor (2GR-FE)</name>
<para id="RM0000020VZ00EX" category="A" type-id="80001" name-id="066QF-00" from="200708">
<name>Removal</name>
<subpara id="RM0000020VZ00EX_02" type-id="01" category="01">
<s-1 id="RM0000020VZ00EX_02_0025" proc-id="RM0550J___0000EUJ00000">
<ptxt>Remove Engine Under Cover
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 4 screws, and remove the engine under cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020VZ00EX_02_0026" proc-id="RM0550J___0000EUI00000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020VZ00EX_02_0023" proc-id="RM0550J___0000GVC00000">
<ptxt>Remove Oxygen Sensor NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the oxygen sensor NO.2 connector.</ptxt>
</s2>
<s2>
<ptxt>Using SST, remove the oxygen sensor NO.2 from the front exhaust pipe assembly.</ptxt>
<figure>
<graphic graphicname="A177020" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020VZ00EX_02_0029" proc-id="RM0550J___0000HJ100000">
<ptxt>Remove Exhaust Pipe Assembly Center</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the oxygen sensor connector and clamp.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 nuts and 2 bolts.</ptxt>
<figure>
<graphic graphicname="A135140J05" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and 2 compression springs, and remove the exhaust center pipe assembly.</ptxt>
<figure>
<graphic graphicname="A135137J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020VZ00EX_02_0022" proc-id="RM0550J___0000GVB00000">
<ptxt>Remove Oxygen Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, remove the oxygen sensor from the exhaust center pipe assembly</ptxt>
<figure>
<graphic graphicname="A178918J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>