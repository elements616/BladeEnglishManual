<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001I_S000I" variety="S000I">
<name>Door Lock</name>
<ttl id="1001I_S000I_746FX_T00BY" variety="T00BY">
<name>Indoor Electrical Key Oscillator (Installed on Front Floor)</name>
<para id="RM000001J5400FX" category="A" type-id="80001" name-id="622P4-00" from="200612">
<name>Removal</name>
<subpara id="RM000001J5400FX_04" type-id="01" category="01">
<s-1 id="RM000001J5400FX_04_0072" proc-id="RM0550J___0000ABV00000">
<ptxt>Remove Console Box Cover Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a thin flat-tip screwdriver wrapped with protective tape, disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B163189J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Place your hand at the position shown in the illustration and disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B156562" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors and remove the console box rear cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001J5400FX_04_0073" proc-id="RM0550J___0000ABX00000">
<ptxt>Remove Console Box Carpet
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the console box carpet.</ptxt>
<figure>
<graphic graphicname="B156554" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J5400FX_04_0074" proc-id="RM0550J___0000ABZ00000">
<ptxt>Remove Console Box Assembly Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 2 screws.</ptxt>
<figure>
<graphic graphicname="B167309" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 4 claws and remove the console box assembly RR.</ptxt>
<figure>
<graphic graphicname="B167310" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J5400FX_04_0071" proc-id="RM0550J___00008M500000">
<ptxt>Remove Indoor Electrical Key Oscillator</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="B168021J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Detach the clamp and remove the indoor electrical key oscillator.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>