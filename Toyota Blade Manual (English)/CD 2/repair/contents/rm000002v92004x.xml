<name>Lubrication</name>
<ttl id="1000D_S000P_74Y1K_T00HV" variety="T00HV">
<name>Engine Oil Pressure Switch Assembly (2GR-FE)</name>
<para id="RM000002V92004X" category="A" type-id="80001" name-id="130W0-00" from="200708">
<name>Removal</name>
<subpara id="RM000002V92004X_01" type-id="01" category="01">
<s-1 id="RM000002V92004X_01_0003" proc-id="RM0550J___0000EUI00000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002V92004X_01_0002" proc-id="RM0550J___0000G8N00000">
<ptxt>Remove Engine Oil Pressure Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the engine oil pressure switch assembly connector.</ptxt>
</s2>
<s2>
<ptxt>Using a deep socket wrench 24mm, remove the engine oil pressure switch assembly.</ptxt>
<figure>
<graphic graphicname="A129647" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
