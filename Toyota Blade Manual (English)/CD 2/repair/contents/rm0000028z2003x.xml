<para id="RM0000028Z2003X" category="A" type-id="80001" name-id="5914I-00" from="200708">
<name>Removal</name>
<subpara id="RM0000028Z2003X_01" type-id="01" category="01">
<s-1 id="RM0000028Z2003X_01_0010" proc-id="RM0550J___00009OF00000">
<ptxt>Remove Fuse Box Opening Cover
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 clips and 4 claws.</ptxt>
<figure>
<graphic graphicname="B167288" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect each connector and remove the fuse box opening cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000028Z2003X_01_0003" proc-id="RM0550J___0000CC300000">
<ptxt>Remove Distance Control Computer Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and remove the distance control computer assembly.</ptxt>
<figure>
<graphic graphicname="B180358" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connector.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
