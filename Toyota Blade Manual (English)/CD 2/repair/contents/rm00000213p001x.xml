<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="08">
<name>Heater &amp; Air Conditioner/Ventilation</name>
<section id="1002K_S000B" variety="S000B">
<name>Air Conditioner</name>
<ttl id="1002K_S000B_74220_T002A" variety="T002A">
<name>Compressor Assembly (Engine Model 2AZ-FE)</name>
<para id="RM00000213P001X" category="A" type-id="80001" name-id="5227R-00" from="200612">
<name>Removal</name>
<subpara id="RM00000213P001X_01" type-id="01" category="01">
<s-1 id="RM00000213P001X_01_0025" proc-id="RM0550J___0000BGV00000">
<ptxt>Recover Refrigerant HFC-134a [R134a]</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000000N8300CX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM00000213P001X_01_0016">
<ptxt>Remove Front Tire RH</ptxt>
</s-1>
<s-1 id="RM00000213P001X_01_0024" proc-id="RM0550J___000038000000">
<ptxt>Remove Engine Under Cover Rear RH
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Use the same procedure for the RH side as for the LH side.</ptxt>
</atten4>
</content1></s-1>
<s-1 id="RM00000213P001X_01_0021" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000213P001X_01_0022" proc-id="RM0550J___000032E00000">
<ptxt>Remove Fan &amp; Alternator V Belt
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, slowly turn the V-belt tensioner clockwise.</ptxt>
<figure>
<graphic graphicname="A164227J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<sst>
<sstitem>
<s-number>09961-01270</s-number>
</sstitem>
</sst>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Check that the SST and tools are securely set.</ptxt>
</item>
<item>
<ptxt>When compressing the V-belt tensioner, slowly apply force perpendicular to the tool, taking 3 seconds or more.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Remove the V-belt from each pulley and slowly return the tensioner.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000213P001X_01_0002" proc-id="RM0550J___000014R00000">
<ptxt>Disconnect Suction Hose Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and disconnect the suction hose.</ptxt>
<figure>
<graphic graphicname="E145410" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the O-ring from the suction hose.</ptxt>
<atten3>
<ptxt>Wrap vinyl tape around the fitting portions of the disconnected suction hose and compressor assembly (with pulley) to prevent dirt, moisture, etc. from entering.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213P001X_01_0003" proc-id="RM0550J___000014S00000">
<ptxt>Disconnect Discharge Hose Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and disconnect the discharge hose.</ptxt>
<figure>
<graphic graphicname="E145411" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the O-ring from the discharge hose.</ptxt>
<atten3>
<ptxt>Wrap vinyl tape around the fitting portions of the disconnected discharge hose and compressor assembly (with pulley) to prevent dirt, moisture, etc. from entering.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213P001X_01_0004" proc-id="RM0550J___000014T00000">
<ptxt>Remove Compressor Assembly (with Pulley)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 bolts and 2 nuts.</ptxt>
<figure>
<graphic graphicname="E146557" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a Torx socket wrench (E8), remove the 2 stud bolts and remove the compressor assembly (with pulley).</ptxt>
<figure>
<graphic graphicname="E146558" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>