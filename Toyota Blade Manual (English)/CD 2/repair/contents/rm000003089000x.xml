<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1 (GND1) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG OFF</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
