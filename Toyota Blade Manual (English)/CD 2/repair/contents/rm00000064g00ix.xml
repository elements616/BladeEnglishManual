<testgrp id="RM00000064G00IX_04_0003" proc-id="RM0550J___0000C9H00000">
<testtitle>Inspect Cruise Control Main Switch</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the cruise control main switch connector.</ptxt>
<figure>
<graphic graphicname="E143515J01" width="7.106578999in" height="4.7836529in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the cruise control main switch assembly connector while operating the cruise control main switch assembly.</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL2" colwidth="2.37in"/>
<colspec colname="COLSPEC0" colwidth="2.37in"/>
<colspec colname="COL3" colwidth="2.34in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>3(CCS) - 1(ECC)</ptxt>
</entry>
<entry valign="middle">
<ptxt>MAIN switch ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 2.5 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>3(CCS) - 1(ECC)</ptxt>
</entry>
<entry valign="middle">
<ptxt>MAIN switch OFF</ptxt>
</entry>
<entry valign="middle">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>2(R/N) - 1(ECC)</ptxt>
</entry>
<entry valign="middle">
<ptxt>MODE switch ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 2.5 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>2(R/N) - 1(ECC)</ptxt>
</entry>
<entry valign="middle">
<ptxt>MODE switch OFF</ptxt>
</entry>
<entry valign="middle">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>3 (CCS) - 1 (ECC) </ptxt>
</entry>
<entry valign="middle">
<ptxt>+RES switch ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>216 to 264 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>3 (CCS) - 1 (ECC) </ptxt>
</entry>
<entry valign="middle">
<ptxt>-SET switch ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>567 to 693 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>3 (CCS) - 1 (ECC) </ptxt>
</entry>
<entry valign="middle">
<ptxt>CANCEL switch ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>1386 to 1674 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000064G00IX_04_0004" fin="false">OK</down>
<right ref="RM00000064G00IX_04_0010" fin="true">NG</right>
</res>
</testgrp>
