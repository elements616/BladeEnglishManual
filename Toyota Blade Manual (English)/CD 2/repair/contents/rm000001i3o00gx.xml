<subpara id="RM000001I3O00GX_06" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000001I3O00GX_07" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000001I3O00GX_07_0003" proc-id="RM0550J___0000FUK00000">
<testtitle>Inspect Wire Harness (Transmission Control Computer Assembly)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref href="RM0000005D702RX" label="Seep01"/>.</ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="C169062J07" width="2.775699831in" height="2.775699831in"/>
</figure>
<test1>
<ptxt>Disconnect the transmission control computer connector.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the terminals.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.08in"/>
<colspec colname="COL2" colwidth="1.06in"/>
<colspec colname="COL3" colwidth="0.99in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1(BATT) - 8(E1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000001I3O00GX_07_0013" fin="false">OK</down>
