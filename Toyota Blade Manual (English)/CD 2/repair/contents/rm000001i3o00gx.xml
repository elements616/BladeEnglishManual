<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000001I3O00GX" category="C" type-id="801A5" name-id="261I0-00" from="200708">
<dtccode>P0560/96</dtccode>
<dtcname>Battery Malfunction</dtcname>
<subpara id="RM000001I3O00GX_04" type-id="31" category="03" proc-id="RM0550J___0000FUH00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>Battery power is supplied to the BATT terminal of the transmission control computer even when the ignition is OFF. This allows the transmission control computer to store DTCs, freeze frame data and data from when a malfunction occurred.</ptxt>
<ptxt>If the battery voltage drops, these memories are erased, and the engine control computer judges that there is a malfunction in the power supply circuit and outputs a DTC.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.90in"/>
<colspec colname="COL2" colwidth="3.36in"/>
<colspec colname="COL3" colwidth="2.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0560/96</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>Always</ptxt>
</item>
<item>
<ptxt>Open or short circuit in BATT terminal circuit</ptxt>
</item>
<item>
<ptxt>3 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry>
<list1 type="unordered">
<item>
<ptxt>Wire Harness and Connector</ptxt>
</item>
<item>
<ptxt>ECU-B2 Fuse</ptxt>
</item>
<item>
<ptxt>Battery</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</item>
</list1>
</content5>
</subpara>
