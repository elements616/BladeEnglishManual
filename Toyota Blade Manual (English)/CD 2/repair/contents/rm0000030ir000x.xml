<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002X_S000H" variety="S000H">
<name>Body Exterior</name>
<ttl id="1002X_S000H_7460E_T00BR" variety="T00BR">
<name>Front Bumper Assembly</name>
<para id="RM0000030IR000X" category="A" type-id="80002" name-id="8216H-01" from="200612" to="200912">
<name>Disassembly</name>
<subpara id="RM0000030IR000X_01" type-id="01" category="01">
<s-1 id="RM0000030IR000X_01_0023" proc-id="RM0550J___0000C7300000">
<ptxt>Remove Hood to Front End Panel Seal</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and hood to front end panel seal.</ptxt>
<figure>
<graphic graphicname="B168871" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0001" proc-id="RM0550J___00008DR00000">
<ptxt>Remove Radiator Grille</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the 4 clamps of the television camera wire. (w/ Intelligent Parking Assist System) </ptxt>
<figure>
<graphic graphicname="B167065J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 4 claws and remove the radiator grille.</ptxt>
<figure>
<graphic graphicname="B167064" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0003" proc-id="RM0550J___0000AJK00000">
<ptxt>Remove Ultrasonic Sensor NO.1 (w/ Intelligent Parking Assist System)
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="E147313" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 claws and remove ultrasonic sensor NO.1.</ptxt>
<figure>
<graphic graphicname="E140917" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030IR000X_01_0004" proc-id="RM0550J___0000AJL00000">
<ptxt>Remove Ultrasonic Sensor Retainer NO.1 (w/ Intelligent Parking Assist System)
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 2 claws and remove ultrasonic sensor retainer NO.1 from the front bumper assembly.</ptxt>
<figure>
<graphic graphicname="E140918" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030IR000X_01_0002" proc-id="RM0550J___00008DS00000">
<ptxt>Remove Television Camera Wire (w/ Intelligent Parking Assist System)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the 2 clamps and remove the parking assist wire.</ptxt>
<figure>
<graphic graphicname="B167068" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Remove the RH side in the same way.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0007" proc-id="RM0550J___00008DX00000">
<ptxt>Remove Front Bumper Hole Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 2 claws and remove the front bumper hole cover LH.</ptxt>
<figure>
<graphic graphicname="B167074" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0008" proc-id="RM0550J___00008DY00000">
<ptxt>Remove Front Bumper Hole Cover RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove using the same procedure as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0019" proc-id="RM0550J___0000ALI00000">
<ptxt>Remove Radiator Grille Lower LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 6 claws and remove the radiator grille LWR LH.</ptxt>
<figure>
<graphic graphicname="B167075" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0020" proc-id="RM0550J___0000ALJ00000">
<ptxt>Remove Radiator Grille Lower RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove using the same procedure as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0022" proc-id="RM0550J___0000ALL00000">
<ptxt>Remove Fog Light Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 8 claws and remove the fog light cover LH.</ptxt>
<figure>
<graphic graphicname="B167069" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0021" proc-id="RM0550J___0000ALM00000">
<ptxt>Remove Fog Light Cover RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove using the same procedure as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0005" proc-id="RM0550J___00000MH00000">
<ptxt>Remove Fog Light Assembly LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the screw and remove the fog light assembly LH.</ptxt>
<figure>
<graphic graphicname="E146999" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030IR000X_01_0006" proc-id="RM0550J___00008DW00000">
<ptxt>Remove Fog Light Assembly RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove using the same procedure as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0011" proc-id="RM0550J___00008E000000">
<ptxt>Remove Front Bumper Side Retainer LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws.</ptxt>
<figure>
<graphic graphicname="B167070" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 claws and remove the front bumper side retainer LH.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0012" proc-id="RM0550J___00008E100000">
<ptxt>Remove Front Bumper Side Retainer RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove using the same procedure as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0013" proc-id="RM0550J___00008E200000">
<ptxt>Remove Front Bumper Energy Absorber</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 3 fitting points of the front bumper energy absorber, and remove the front bumper energy absorber from the front bumper reinforcement.</ptxt>
<figure>
<graphic graphicname="B167071J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IR000X_01_0018" proc-id="RM0550J___00008E500000">
<ptxt>Remove Front Bumper Reinforcement Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a clip remover, detach the 8 clamps and disconnect the harness.</ptxt>
<figure>
<graphic graphicname="B167072J02" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 8 bolts and front bumper reinforcement.</ptxt>
<figure>
<graphic graphicname="B167073" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>