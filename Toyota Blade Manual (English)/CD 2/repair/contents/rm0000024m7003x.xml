<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y1F_T00HQ" variety="T00HQ">
<name>Transmission Control Computer Assembly (U660E)</name>
<para id="RM0000024M7003X" category="A" type-id="30014" name-id="261IP-00" from="200708">
<name>Installation</name>
<subpara id="RM0000024M7003X_01" type-id="01" category="01">
<s-1 id="RM0000024M7003X_01_0001" proc-id="RM0550J___0000G7F00000">
<ptxt>Install Transmission Control Computer Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the computer to the transaxle.</ptxt>
</s2>
<s2>
<ptxt>Tighten the 2 bolts in the order shown in the illustration.</ptxt>
<figure>
<graphic graphicname="C139840J03" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>11</t-value1>
<t-value2>112</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the connector to the computer and lock the connector with the lock lever.</ptxt>
<figure>
<graphic graphicname="C139242" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000024M7003X_01_0014" proc-id="RM0550J___0000DLY00000">
<ptxt>Install Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install battery carrier NO.2 with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000024M7003X_01_0015" proc-id="RM0550J___0000FPD00000">
<ptxt>Install Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery carrier with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A176883" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Attach the 2 clamps to the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Install the battery tray.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000024M7003X_01_0016" proc-id="RM0550J___0000DLZ00000">
<ptxt>Install Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery to the vehicle</ptxt>
</s2>
<s2>
<ptxt>Install the insulator.</ptxt>
</s2>
<s2>
<ptxt>Connect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the battery clamp with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>17</t-value1>
<t-value2>173</t-value2>
<ptxt>(Bolt)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the battery positive terminal with the nut.</ptxt>
<torque>
<torqueitem>
<t-value1>13</t-value1>
<t-value2>130</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000024M7003X_01_0010" proc-id="RM0550J___0000G7G00000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM0000024M7003X_01_0018" proc-id="RM0550J___0000FQ400000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 9 clips.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000024M7003X_01_0012" proc-id="RM0550J___0000G7I00000">
<ptxt>TaSCAN A/T Learned Value Initialization and G Sensor 0-point Learning</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000000OLY013X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM0000024M7003X_01_0013" proc-id="RM0550J___0000G7J00000">
<ptxt>A/T Unit Compensation</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000000OLY013X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM0000024M7003X_01_0011" proc-id="RM0550J___0000G7H00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW011X"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>