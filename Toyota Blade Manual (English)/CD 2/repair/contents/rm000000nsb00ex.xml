<subpara id="RM000000NSB00EX_01" type-id="01" category="01">
<s-1 id="RM000000NSB00EX_01_0001" proc-id="RM0550J___0000G3G00000">
<ptxt>Operation Check</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C053442J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Check that the valve in the solenoid operates when the battery positive is connected to terminal 2 and the battery negative is connected to terminal 1 of clutch control solenoid No.1 (SL1, SL3) through the 12V-21W valve.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Operates (operating sound heard)</ptxt>
</specitem>
</spec>
</s2>
</content1>
</s-1>
