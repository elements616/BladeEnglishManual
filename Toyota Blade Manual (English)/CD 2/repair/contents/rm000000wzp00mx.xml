<entry valign="middle">
<ptxt>Symptom</ptxt>
</entry>
<entry valign="middle">
<ptxt>Suspected Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Air Conditioning ECU Communication Stop Mode</ptxt>
</entry>
