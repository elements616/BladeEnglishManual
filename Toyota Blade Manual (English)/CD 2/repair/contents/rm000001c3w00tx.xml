<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002R_S000G" variety="S000G">
<name>G-BOOK</name>
<ttl id="1002R_S000G_742BR_T003W" variety="T003W">
<name>G-BOOK System</name>
<para id="RM000001C3W00TX" category="J" type-id="304KE" name-id="66159-00" from="200612" to="200912">
<dtccode/>
<dtcname>"Check Your Phone" Remains Displayed</dtcname>
<subpara id="RM000001C3W00TX_01" type-id="51" category="05" proc-id="RM0550J___0000B3L00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<list1 type="unordered">
<item>
<ptxt>When replacing the navigation receiver assembly, perform the vehicle association setting, and then perform the G-BOOK use resumption operation and HELPNET service start operation. (see <xref label="Seep01" href="RM000001C3S00RX"/>)</ptxt>
</item>
<item>
<ptxt>If the navigation receiver assembly has been replaced while there are purchased G-SOUND unlimited licenses, perform G-SOUND license recovery. (see <xref label="Seep02" href="RM000001C3S00RX"/>)</ptxt>
</item>
</list1>
</atten4>
</content5>
</subpara>
<subpara id="RM000001C3W00TX_02" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000001C3W00TX_02_0001" proc-id="RM0550J___0000B3M00000">
<testtitle>Check Model Used</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Model Used</ptxt>
<test2>
<ptxt>Check that the cellular phone used by the customer is a Bluetooth compatible cellular phone whose operation has been verified.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Model whose operation has been verified</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>If the cellular phone being used is not a model whose operation has been verified, inform the customer. (Compatible models can be checked at G-BOOK.com on the Internet)</ptxt>
</atten4>
</test2>
</test1>
</content6>
<res>
<down ref="RM000001C3W00TX_02_0002" fin="false">OK</down>
<right ref="RM000001C3W00TX_02_0007" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0002" proc-id="RM0550J___0000B3N00000">
<testtitle>Cellular Phone Usage Method</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Cellular Phone Usage Method</ptxt>
<test2>
<ptxt>Check that the data communication method (packet/circuit switching) suitable for the cellular phone being used is selected.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Data communication method suitable for the cellular phone being used is selected</ptxt>
</specitem>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000001C3W00TX_02_0003" fin="false">OK</down>
<right ref="RM000001C3W00TX_02_0008" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0003" proc-id="RM0550J___0000B3O00000">
<testtitle>Cellular Phone Standalone Communication Inspection</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Cellular Phone Standalone Communication Inspection</ptxt>
<test2>
<ptxt>Check that the cellular phone operates normally by itself.</ptxt>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.24in"/>
<colspec colname="COL2" colwidth="2.89in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Cellular Phone Usage Method</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Items to Check</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Packet</ptxt>
</entry>
<entry valign="middle">
<ptxt>Check that packet communication (sending/receiving e-mail) is possible</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Circuit Switching</ptxt>
</entry>
<entry valign="middle">
<ptxt>Check that calls can be made</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Calls/sending and receiving can be performed normally</ptxt>
</specitem>
</spec>
<atten4>
<list1 type="unordered">
<item>
<ptxt>Check that there are no problems with the cellular phone, such as phone not connected, phone power OFF, insufficient phone charge or phone malfunction.</ptxt>
</item>
<item>
<ptxt>If there is a problem with the cellular phone, contact the customer and ask them to have the cellular phone checked.</ptxt>
</item>
</list1>
</atten4>
</test2>
</test1>
</content6>
<res>
<down ref="RM000001C3W00TX_02_0012" fin="false">OK</down>
<right ref="RM000001C3W00TX_02_0009" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0012" proc-id="RM0550J___0000BYP00000">
<testtitle>Check Bluetooth Call</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Bluetooth Call</ptxt>
<test2>
<ptxt>Check that the hands-free function operates normally with the Bluetooth connected cellular phone.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Operates normally</ptxt>
</specitem>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000001C3W00TX_02_0013" fin="false">OK</down>
<right ref="RM000001C3W00TX_02_0010" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0013" proc-id="RM0550J___0000BYU00000">
<testtitle>Inspect by Replacing Cellular Phone</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>With the customer's permission, connect a staff member's G-BOOK compatible cellular phone.</ptxt>
<atten4>
<ptxt>Following the owner's manual, register and connect the Bluetooth cellular phone.</ptxt>
</atten4>
</test1>
<test1>
<ptxt>Check the connection.  </ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.81in"/>
<colspec colname="COL2" colwidth="1.32in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Cannot connect to G-BOOK.com</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Can connect to G-BOOK.com</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<list1 type="unordered">
<item>
<ptxt>If there is a problem with the cellular phone, contact the customer and ask them to have the cellular phone repaired.</ptxt>
</item>
<item>
<ptxt>After the inspection is complete, delete the registered cellular phone.</ptxt>
</item>
</list1>
</atten4>
</test1>
</content6>
<res>
<down ref="RM000001C3W00TX_02_0006" fin="true">A</down>
<right ref="RM000001C3W00TX_02_0011" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0006">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG4006X"/>
</testtitle>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0007">
<testtitle>Replace Cellular Phone</testtitle>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0008">
<testtitle>Check Settings</testtitle>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0009">
<testtitle>Cellular Phone Malfunction</testtitle>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0010">
<testtitle>Go to another flowchart (Hands-free System - Bluetooth telephone cannot receive calls or connect)<xref label="Seep01" href="RM000001C4A00HX"/>
</testtitle>
</testgrp>
<testgrp id="RM000001C3W00TX_02_0011">
<testtitle>Cellular Phone Malfunction</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
