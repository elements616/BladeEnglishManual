<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742BE_T003O" variety="T003O">
<name>Ultrasonic Sensor NO.1</name>
<para id="RM0000028X5002X" category="A" type-id="30014" name-id="672ET-00" from="200612" to="200912">
<name>Installation</name>
<subpara id="RM0000028X5002X_01" type-id="01" category="01">
<s-1 id="RM0000028X5002X_01_0020" proc-id="RM0550J___0000AJM00000">
<ptxt>Install Ultrasonic Sensor Retainer NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>As shown in the illustration, align the key of the front bumper assembly with the snap of ultrasonic sensor retainer NO.1, and insert ultrasonic sensor retainer NO.1 into the installation hole of the front bumper assembly.</ptxt>
<figure>
<graphic graphicname="E142406J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 claws and install ultrasonic sensor retainer NO.1 to the front bumper assembly.</ptxt>
<figure>
<graphic graphicname="E140918" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Install it securely, as the parking space detection function may not operate normally otherwise.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028X5002X_01_0021" proc-id="RM0550J___0000AJN00000">
<ptxt>Install Ultrasonic Sensor NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 2 claws and install ultrasonic sensor NO.1.</ptxt>
<figure>
<graphic graphicname="E142407" width="2.775699831in" height="3.779676365in"/>
</figure>
<atten3>
<ptxt>Install it securely, as the parking space detection function may not operate normally otherwise.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
<figure>
<graphic graphicname="E147313" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028X5002X_01_0027" proc-id="RM0550J___00008EL00000">
<ptxt>Install Front Bumper Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 8 claws (4 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167063" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the front bumper assembly with the 5 clips, 2 bolts and 6 screws.</ptxt>
<figure>
<graphic graphicname="B167062" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the pin hold clip.</ptxt>
<figure>
<graphic graphicname="B167473" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Install the RH side using the same procedure.</ptxt>
</atten4>
</s2>
</content1></s-1>
<s-1 id="RM0000028X5002X_01_0028" proc-id="RM0550J___00008EM00000">
<ptxt>Install Radiator Grille Protector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the 2 radiator grille protectors.</ptxt>
<figure>
<graphic graphicname="B167060" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028X5002X_01_0029" proc-id="RM0550J___000031W00000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 8 clips.</ptxt>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>