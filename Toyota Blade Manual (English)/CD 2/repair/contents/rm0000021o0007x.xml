<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B9_T003J" variety="T003J">
<name>Intelligent Parking Assist System</name>
<para id="RM0000021O0007X" category="C" type-id="8039D" name-id="672FI-00" from="200612" to="200912">
<dtccode>C1644</dtccode>
<dtcname>Brake System Invalid</dtcname>
<subpara id="RM0000021O0007X_04" type-id="33" category="03" proc-id="RM0550J___0000A7000000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller self-diagnosis judges that the brake control system connected via CAN communication is invalid.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1644</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>SP1 Invalid</ptxt>
</item>
<item>
<ptxt>Wheel Speed Sensor Invalid</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Brake Control System - ABS with EBD &amp; TRC &amp; VSC &amp; BA System</ptxt>
</item>
<item>
<ptxt>CAN Communication System</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000021O0007X_05" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM0000021O0007X_06" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000021O0007X_06_0006" proc-id="RM0550J___0000A7100000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again, and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"C1644" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"C1644", "C1648" and "U0122" are output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021O0007X_06_0010" fin="true">A</down>
<right ref="RM0000021O0007X_06_0009" fin="true">B</right>
<right ref="RM0000021O0007X_06_0007" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM0000021O0007X_06_0007">
<testtitle>Go to CAN Communication System<xref label="Seep01" href="RM000001R4W009X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000021O0007X_06_0009">
<testtitle>Go to Brake Control System<xref label="Seep01" href="RM000000OUR00SX"/>
</testtitle>
</testgrp>
<testgrp id="RM0000021O0007X_06_0010">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>