<para id="RM00000050B01GX" category="D" type-id="3001B" name-id="554GF-00" from="200612">
<name>How to Proceed with Troubleshooting</name>
<subpara id="RM00000050B01GX_z0" proc-id="RM0550J___000068800000">
<content5 releasenbr="2">
<descript-diag>
<descript-testgroup>
<testtitle>Vehicle brought to workshop</testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Customer Problem Analysis and Symptom Check</testtitle>
<atten4>
<ptxt>For the procedure, see <xref label="Seep01" href="RM00000050C01GX"/></ptxt>
</atten4>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>CAN Communication System Check</testtitle>
<test1>
<ptxt>Using SST (TaSCAN), perform CAN bus diagnosis (check for communication malfunction DTCs).</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.76in"/>
<colspec colname="COL2" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>DTC normal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Malfunction DTC output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>If a malfunction code is output, inspect the control system CAN communication system.</ptxt>
</atten4>
</test1>
<results>
<result>B</result>
<action-ci-right>Go to Control System CAN Communication Section (see <xref label="Seep07" href="RM000001R4W009X"/>)</action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Check DTC</testtitle>
<atten4>
<ptxt>For the procedure, see <xref label="Seep02" href="RM00000050J01GX"/></ptxt>
</atten4>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Record the DTCs.</ptxt>
<atten4>
<ptxt>When DTCs are output, "refer to Diagnostic Trouble Code Chart (<xref label="Seep03" href="RM0000005LU01GX"/>)"</ptxt>
</atten4>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.76in"/>
<colspec colname="COL2" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC present</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<results>
<result>B</result>
<action-ci-right>Go to step 10</action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Diagnostic Trouble Code Chart</testtitle>
<atten4>
<ptxt>For the procedure, see <xref label="Seep08" href="RM0000005LU01GX"/></ptxt>
</atten4>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Circuit Inspection</testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Replacement, Repair</testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Clear DTC</testtitle>
<atten4>
<ptxt>For the procedure, see <xref label="Seep04" href="RM00000050J01GX"/></ptxt>
</atten4>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>DTC Check</testtitle>
<atten4>
<ptxt>For the procedure, see <xref label="Seep06" href="RM00000050J01GX"/></ptxt>
</atten4>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.76in"/>
<colspec colname="COL2" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC present</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<results>
<result>A</result>
<action-ci-right>Go to step 13</action-ci-right>
<result>B</result>
<action-ci-right>To Diagnostic Trouble Code Chart; for the procedure, refer to <xref label="Seep09" href="RM0000005LU01GX"/></action-ci-right>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Reproduction Method</testtitle>
<atten4>
<ptxt>For the procedure, see <xref label="Seep05" href="RM000000ABY03DX"/></ptxt>
</atten4>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Identify the Problem</testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Replacement, Repair</testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Confirmation Test</testtitle>
