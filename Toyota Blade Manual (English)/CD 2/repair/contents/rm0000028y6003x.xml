<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7421E_T001U" variety="T001U">
<name>Discharge Headlight Bulb</name>
<para id="RM0000028Y6003X" category="A" type-id="80001" name-id="603IX-00" from="200612">
<name>Removal</name>
<subpara id="RM0000028Y6003X_01" type-id="01" category="01">
<s-1 id="RM0000028Y6003X_01_0005" proc-id="RM0550J___00008NU00000">
<ptxt>Precautions for Handling Discharge Headlights</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM0000005JQ00JX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM0000028Y6003X_01_0004" proc-id="RM0550J___00000U300000">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM0000028Y6003X_01_0011" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000028Y6003X_01_0008" proc-id="RM0550J___0000A5R00000">
<ptxt>Remove Air Cleaner Inlet NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the clip.</ptxt>
<figure>
<graphic graphicname="E146997" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 claws and remove air cleaner inlet NO.1.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028Y6003X_01_0009" proc-id="RM0550J___0000A5S00000">
<ptxt>Remove Headlight Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Turn the headlight cover in the direction indicated by the arrow in the illustration and remove it.</ptxt>
<figure>
<graphic graphicname="E146987" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028Y6003X_01_0010" proc-id="RM0550J___0000A5T00000">
<ptxt>Remove Discharge Headlight Bulb</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Turn the socket of the headlight light control computer assembly LH in the direction of the arrow shown in the illustration and disconnect it.</ptxt>
<figure>
<graphic graphicname="E146988" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>In the order shown in the illustration, release the set spring lock and remove the discharge headlight bulb.</ptxt>
<figure>
<graphic graphicname="E146989J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Do not touch the glass portion of the bulb.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>