<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_747JM_T00DY" variety="T00DY">
<name>Oxygen Sensor (2AZ-FE)</name>
<para id="RM0000020VZ00AX" category="A" type-id="80001" name-id="065BQ-00" from="200612">
<name>Removal</name>
<subpara id="RM0000020VZ00AX_01" type-id="01" category="01">
<s-1 id="RM0000020VZ00AX_01_0005" proc-id="RM0550J___000070N00000">
<ptxt>Remove Exhaust Pipe Assembly Front
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the oxygen sensor connector.</ptxt>
<figure>
<graphic graphicname="A166429J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and disconnect the exhaust center pipe assembly.</ptxt>
<figure>
<graphic graphicname="A159959J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and 2 compression springs, and remove the exhaust pipe assembly FR.</ptxt>
<figure>
<graphic graphicname="A135090" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 gaskets.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020VZ00AX_01_0002" proc-id="RM0550J___0000BY800000">
<ptxt>Remove Oxygen Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, remove the oxygen sensor from the front exhaust pipe assembly.</ptxt>
<figure>
<graphic graphicname="A128927J03" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>