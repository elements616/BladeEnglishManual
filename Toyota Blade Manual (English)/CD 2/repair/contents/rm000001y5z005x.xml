<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_74X9W_T00GA" variety="T00GA">
<name>Engine Mounting Insulator LH (2GR-FE)</name>
<para id="RM000001Y5Z005X" category="A" type-id="30014" name-id="07258-00" from="200708">
<name>Installation</name>
<subpara id="RM000001Y5Z005X_01" type-id="01" category="01">
<s-1 id="RM000001Y5Z005X_01_0001" proc-id="RM0550J___0000EO800000">
<ptxt>Install Engine Mounting Insulator LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine mounting insulator LH with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A136931" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y5Z005X_01_0002" proc-id="RM0550J___0000EO900000">
<ptxt>Connect Engine Mounting Bracket LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine mounting insulator LH to the engine mounting bracket LH with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="A136930" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>56</t-value1>
<t-value2>571</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>Hold the bolt side and tighten the nut side.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y5Z005X_01_0065" proc-id="RM0550J___0000DM000000">
<ptxt>Install Air Cleaner Case
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the air cleaner case with the 3 bolts.</ptxt>
<figure>
<graphic graphicname="A178719" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>7.0</t-value1>
<t-value2>71</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the clamp.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Z005X_01_0066" proc-id="RM0550J___0000GUD00000">
<ptxt>Install Air Cleaner Filter Element Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the air cleaner filter element.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Z005X_01_0067" proc-id="RM0550J___0000F3H00000">
<ptxt>Install Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the hinge portion first, and then install the air cleaner cap w/ air cleaner hose with the 3 clamps.</ptxt>
<figure>
<graphic graphicname="A176815J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the clamp hose band. (<sup>*</sup>1)</ptxt>
</s2>
<s2>
<ptxt>Connect ventilation hose No.2. (<sup>*</sup>2)</ptxt>
</s2>
<s2>
<ptxt>Connect the air flow meter connector. (<sup>*</sup>3)</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Z005X_01_0058" proc-id="RM0550J___0000DLY00000">
<ptxt>Install Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install battery carrier NO.2 with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Z005X_01_0059" proc-id="RM0550J___0000FPD00000">
<ptxt>Install Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery carrier with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A176883" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Attach the 2 clamps to the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Install the battery tray.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Z005X_01_0060" proc-id="RM0550J___0000DLZ00000">
<ptxt>Install Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery to the vehicle</ptxt>
</s2>
<s2>
<ptxt>Install the insulator.</ptxt>
</s2>
<s2>
<ptxt>Connect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the battery clamp with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>17</t-value1>
<t-value2>173</t-value2>
<ptxt>(Bolt)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the battery positive terminal with the nut.</ptxt>
<torque>
<torqueitem>
<t-value1>13</t-value1>
<t-value2>130</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Z005X_01_0061">
<ptxt>Check Front Wheels Straight-ahead Position</ptxt>
</s-1>
<s-1 id="RM000001Y5Z005X_01_0062" proc-id="RM0550J___0000DM100000">
<ptxt>Connect Battery Negative Terminal
</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>40</t-value2>
</torqueitem>
</torque>
</content1></s-1>
<s-1 id="RM000001Y5Z005X_01_0063" proc-id="RM0550J___0000DMG00000">
<ptxt>Install V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 clips to install the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Make sure the clips are securely engaged.</ptxt>
</item>
<item>
<ptxt>Engaging them with excessive force or striking the top of the clips may cause damage.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Z005X_01_0064" proc-id="RM0550J___0000FQ400000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 9 clips.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5Z005X_01_0047" proc-id="RM0550J___0000EOK00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="2">
<ptxt>(see <xref label="Seep01" href="RM000001LYW011X"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>