<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1002M_S001G" variety="S001G">
<name>Pre-crash Safety</name>
<ttl id="1002M_S001G_74WT7_T00FP" variety="T00FP">
<name>Pre-crash Safety System</name>
<para id="RM000000DB900JX" category="C" type-id="8007O" name-id="540JF-00" from="200708">
<dtccode>B2055/31</dtccode>
<dtcname>Radar Sensor Malfunction</dtcname>
<subpara id="RM000000DB900JX_01" type-id="31" category="03" proc-id="RM0550J___0000CUE00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="unordered">
<item>
<ptxt>This DTC is output when a malfunction occurs in communication from the millimeter wave radar sensor assembly.</ptxt>
</item>
<item>
<ptxt>It is also output when the vehicle information sent from the millimeter wave radar sensor assembly is abnormal. In that case, perform initialization so that the millimeter wave radar sensor assembly recognizes the vehicle information.</ptxt>
</item>
</list1>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B2055/31</ptxt>
</entry>
<entry valign="middle">
<ptxt>Radar sensor malfunction or improper initialization</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Millimeter Wave Radar Sensor Assembly</ptxt>
</item>
<item>
<ptxt>Seat Belt Control Computer</ptxt>
</item>
<item>
<ptxt>Distance Control Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000DB900JX_03" type-id="51" category="05" proc-id="RM0550J___0000CUF00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>When the distance control computer assembly is replaced with a new one, be sure to perform initialization. (see <xref label="Seep01" href="RM000002GO2003X_01_0001"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000000DB900JX_07" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DB900JX_07_0006" proc-id="RM0550J___0000CUG00000">
<testtitle>Radar Cruise Initial Setting (Millimeter Wave Radar Sensor Assembly)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Perform initialization so that the millimeter wave radar sensor assembly recognizes the vehicle information. (see <xref label="Seep01" href="RM000002GO2003X_01_0001"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000DB900JX_07_0007" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000DB900JX_07_0007" proc-id="RM0550J___0000CUH00000">
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/Pre-crash" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen to clear the data.</ptxt>
</test1>
<test1>
<ptxt>Follow the prompts on the SST (TaSCAN) screen to display the "System Diagnosis Menu/Pre-crash" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Check for DTCs again.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B2055 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B2055 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DB900JX_07_0009" fin="false">A</down>
<right ref="RM000000DB900JX_07_0012" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DB900JX_07_0009" proc-id="RM0550J___0000CUI00000">
<testtitle>Replace Millimeter Wave Radar Sensor Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the millimeter wave radar sensor assembly with a new one.</ptxt>
<ptxt>(see <xref label="Seep01" href="RM0000028Z9003X"/>)</ptxt>
</test1>
<test1>
<ptxt>Perform radar beam axis adjustment of the millimeter wave radar sensor assembly.</ptxt>
<ptxt>(see <xref label="Seep02" href="RM0000028Z6003X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000DB900JX_07_0011" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000DB900JX_07_0010" proc-id="RM0550J___0000CUJ00000">
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu" screen, and select "ALL Diag".</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen to clear the data.</ptxt>
</test1>
<test1>
<ptxt>Put the vehicle in the conditions under which the DTC is detected.</ptxt>
<atten4>
<ptxt>The system cannot detect the malfunction unless the detection conditions are met.</ptxt>
</atten4>
<test2>
<ptxt>Drive the vehicle at 45km/h or more.</ptxt>
</test2>
<test2>
<ptxt>Turn the cruise control main switch ON and put the system in vehicle-to-vehicle distance control mode standby.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Follow the prompts on the SST (TaSCAN) screen to display the "System Diagnosis Menu" screen, and select "ALL Diag".</ptxt>
</test1>
<test1>
<ptxt>Check for DTCs again.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="4.96in"/>
<colspec colname="COL2" colwidth="2.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>DTCs B2055 and P1570 are not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>DTC B2055 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>DTCs B2055 and P1570 are output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DB900JX_07_0012" fin="true">A</down>
<right ref="RM000000DB900JX_07_0011" fin="true">B</right>
<right ref="RM000000DB900JX_07_0013" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM000000DB900JX_07_0011">
<testtitle>Replace Seat Belt Control Computer<xref label="Seep01" href="RM000002SZU002X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DB900JX_07_0012">
<testtitle>END</testtitle>
</testgrp>
<testgrp id="RM000000DB900JX_07_0013">
<testtitle>Replace Distance Control Computer Assembly<xref label="Seep01" href="RM0000028Z2003X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>