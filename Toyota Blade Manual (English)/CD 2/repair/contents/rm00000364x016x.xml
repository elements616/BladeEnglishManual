<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM00000364X016X" category="J" type-id="803NK" name-id="653G2-01" from="200912">
<dtccode/>
<dtcname>Screen does not dim or switch to night mode even when lights are turned on</dtcname>
<subpara id="RM00000364X016X_01" type-id="51" category="05" proc-id="RM0550J___0000IIY00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM0000002RM03SX"/>)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM00000364X016X_02" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000364X016X_02_0001" proc-id="RM0550J___0000IIZ00000">
<testtitle>Inspect Image Quality Adjustment Screen</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Settings</ptxt>
<test2>
<ptxt>Press the "PICTURE/OFF" switch on the navigation receiver assembly to display the "Picture Quality Adjustment" screen.</ptxt>
</test2>
<test2>
<ptxt>Turn the headlight dimmer switch to TAIL.</ptxt>
</test2>
<test2>
<ptxt>Check the "Day Mode" setting.</ptxt>
</test2>
</test1>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.99in"/>
<colspec colname="COL2" colwidth="1.14in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Not set to "Day Mode"</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Set to "Day Mode"</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM00000364X016X_02_0002" fin="false">A</down>
<right ref="RM00000364X016X_02_0005" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000364X016X_02_0002" proc-id="RM0550J___0000IJ000000">
<testtitle>Vehicle Signal Check</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Vehicle Signal</ptxt>
<figure>
<graphic graphicname="E150508" width="2.775699831in" height="1.771723296in"/>
</figure>
<test2>
<ptxt>Start the diagnosis and display the Service Inspection screen. (see <xref label="Seep01" href="RM000000JE903GX_01_0012"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Vehicle Signal Check" from the "Function Inspection/Adjustment" screen.</ptxt>
</test2>
<test2>
<ptxt>Check the TAIL signal condition when the headlight dimmer switch is turned "OFF → TAIL".</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.99in"/>
<colspec colname="COL2" colwidth="1.14in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Headlight dimmer switch</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Display</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>OFF</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>OFF</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>TAIL</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ON</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>The vehicle signals are updated every 1 seconds.</ptxt>
</atten4>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.99in"/>
<colspec colname="COL2" colwidth="1.14in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Does not operate normally when the dimmer switch is operated</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Operates normally when the dimmer switch is operated</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000364X016X_02_0003" fin="false">A</down>
<right ref="RM00000364X016X_02_0006" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000364X016X_02_0003" proc-id="RM0550J___0000IJ100000">
<testtitle>Inspect Wire Harness and Connector (ILL+)</testtitle>
<content6 releasenbr="2">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Voltage Inspection</ptxt>
<test2>
<ptxt>Disconnect connector A of the navigation receiver assembly.</ptxt>
</test2>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the navigation receiver assembly vehicle side wire harness connector terminal and body ground.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.37in"/>
<colspec colname="COLSPEC0" colwidth="1.38in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A10 (ILL+) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Headlight dimmer switch TAIL</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000364X016X_02_0006" fin="true">OK</down>
<right ref="RM00000364X016X_02_0004" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000364X016X_02_0004">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM00000364X016X_02_0005">
<testtitle>Cancel the forced day mode in picture quality adjustment</testtitle>
</testgrp>
<testgrp id="RM00000364X016X_02_0006">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>