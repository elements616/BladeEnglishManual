<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="05">
<name>Suspension</name>
<section id="1002I_S0016" variety="S0016">
<name>Suspension</name>
<ttl id="1002I_S0016_7450D_T00AO" variety="T00AO">
<name>Upper Control Arm Assembly Rear LH</name>
<para id="RM000001X3X002X" category="A" type-id="30014" name-id="421GT-00" from="200612">
<name>Installation</name>
<subpara id="RM000001X3X002X_02" type-id="01" category="01">
<s-1 id="RM000001X3X002X_02_0024" proc-id="RM0550J___000089W00000">
<ptxt>Temporarily Tighten Upper Control Arm Assembly Rear LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the upper control arm assembly rear LH to the suspension member and axle carrier, and temporarily tighten it with the 2 bolts and 2 nuts.</ptxt>
<figure>
<graphic graphicname="C149534" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X3X002X_02_0025" proc-id="RM0550J___000089X00000">
<ptxt>Fully Tighten Upper Control Arm Assembly Rear LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>With a block of wood in between, jack up the rear suspension arm assembly No.2 LH to the standard vehicle height condition as shown in the illustration to apply load to the rear suspension.</ptxt>
<figure>
<graphic graphicname="C149535" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Tighten the upper control arm assembly rear LH with the 2 bolts and 2 nuts.</ptxt>
<figure>
<graphic graphicname="C149534" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>90</t-value1>
<t-value2>918</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>Hold the nut and tighten with the bolt.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X3X002X_02_0026" proc-id="RM0550J___000089Z00000">
<ptxt>Install Rear Tire</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>103</t-value1>
<t-value2>1050</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM000001X3X002X_02_0027" proc-id="RM0550J___00008A000000">
<ptxt>Stabilize Suspension</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Lower the vehicle and bounce it up and down several times to stabilize the rear suspension.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X3X002X_02_0023" proc-id="RM0550J___000089Y00000">
<ptxt>Inspect / Adjust Rear Wheel Alignment</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000000MIL00DX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>