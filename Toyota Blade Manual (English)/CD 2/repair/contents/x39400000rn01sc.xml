<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74WIJ_T00FO" variety="T00FO">
<name>EFI System (2GR-FE)</name>
<para id="X39400000RN01SC" category="C" type-id="302EU" name-id="066OI-00" from="200708">
<dtccode>P2118/89</dtccode>
<dtcname>Electronic Throttle Actuator Power Supply Malfunction</dtcname>
<subpara id="X39400000RN01SC_10" type-id="31" category="03" proc-id="RM0550J___0000DBF00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>In the electronic throttle control system, battery positive voltage is supplied to the +BM terminal of the engine control computer via the ETCS fuse.</ptxt>
</item>
</list1>
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="3" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="1.498008     in"/>
<colspec colnum="02" colname="C02" colwidth="3.154628     in"/>
<colspec colnum="03" colname="C03" colwidth="2.494272     in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>DTCNo.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
<item>
<ptxt>Others</ptxt>
</item>
</list1>
</entry>
<entry colname="C03" valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>P2118/89</ptxt>
</entry>
<entry colname="C02" valign="middle" align="left">
<list1 type="ordered">
<item>
<ptxt>IG ON</ptxt>
</item>
<item>
<ptxt>ECU main power source (+B) 8V or more, and electronic throttle power source (+BM) 4V or less (open in electronic throttle power source circuit)</ptxt>
</item>
<item>
<ptxt>0.8 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry colname="C03" valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Wire Harness or Connector</ptxt>
</item>
<item>
<ptxt>ETCS Fuse</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="X39400000RN01SC_11" type-id="32" category="03" proc-id="RM0550J___0000DBG00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="A162769J02" width="7.106578999in" height="4.7836529in"/>
</figure>
</content5>
</subpara>
<subpara id="X39400000RN01SC_12" type-id="51" category="05" proc-id="RM0550J___0000DBH00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Using SST (TaSCAN), read the freeze data. Freeze data records part of the engine operating condition when a malfunction occurs, and this information is useful when troubleshooting.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="X39400000RN01SC_13" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X39400000RN01SC_13_0006" proc-id="RM0550J___0000DBK00000">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (+BM Voltage)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), operate according to the screen display and select [ECU Data Monitor].</ptxt>
</test1>
<test1>
<ptxt>Read [+BM Voltage] displayed on SST (TaSCAN).</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>11 to 14V</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000RN01SC_13_0007" fin="true">OK</down>
<right ref="X39400000RN01SC_13_0001" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="X39400000RN01SC_13_0001" proc-id="RM0550J___0000DBI00000">
<testtitle>Inspect Fuse (ETCS Fuse)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Remove the ETCS fuse from the engine room R/B.</ptxt>
<figure>
<graphic graphicname="A158135J02" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Inspection terminal fuse</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>ETCS Fuse</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000RN01SC_13_0002" fin="false">OK</down>
<right ref="X39400000RN01SC_13_0004" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X39400000RN01SC_13_0002" proc-id="RM0550J___0000DBJ00000">
<testtitle>Inspect Wire Harness and Connector (Engine Control Computer - Battery)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D702RX"/></ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect the ETCS fuse.</ptxt>
</test1>
<test1>
<ptxt>Disconnect connector A and connector B of the engine control computer.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the terminals. (see <xref label="Seep02" href="X39400000QV01SD"/> for Terminals of ECU)</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B3(+BM)←→A81(E1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<figure>
<graphic graphicname="A106902J36" width="2.775699831in" height="3.779676365in"/>
</figure>
</test1>
</content6>
<res>
<down ref="X39400000RN01SC_13_0005" fin="true">OK</down>
<right ref="X39400000RN01SC_13_0003" fin="true">NG</right>
</res>
</testgrp>
