<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002R_S000G" variety="S000G">
<name>G-BOOK</name>
<ttl id="1002R_S000G_742BR_T003W" variety="T003W">
<name>G-BOOK System</name>
<para id="RM000001C3T00TX" category="D" type-id="303F3" name-id="66155-00" from="200612" to="200912">
<name>Diagnosis System</name>
<subpara id="RM000001C3T00TX_z0" proc-id="RM0550J___0000B3D00000">
<content5 releasenbr="1">
<step1>
<ptxt>Diagnosis Screen Transitions</ptxt>
<atten4>
<ptxt>For diagnosis screen transitions, refer to HDD Navigation System - Diagnosis System (<xref label="Seep01" href="RM0000002RV02BX"/>).</ptxt>
</atten4>
</step1>
<step1>
<ptxt>Starting and Ending Diagnosis</ptxt>
<step2>
<ptxt>Start Diagnosis (see <xref label="Seep02" href="RM0000002RV02BX"/>)</ptxt>
</step2>
<step2>
<ptxt>Cancel Diagnosis (see <xref label="Seep03" href="RM0000002RV02BX"/>)</ptxt>
</step2>
</step1>
<step1>
<ptxt>G Terminal Information</ptxt>
<figure>
<graphic graphicname="E122217" width="2.775699831in" height="1.771723296in"/>
</figure>
<step2>
<ptxt>G Terminal Information</ptxt>
<step3>
<ptxt>Start diagnosis and display the diagnosis inspection menu screen.</ptxt>
</step3>
<step3>
<ptxt>Select "G Terminal Information" on the diagnosis check menu screen to display the G terminal information screen.</ptxt>
</step3>
<step3>
<ptxt>Check the G-BOOK terminal information.</ptxt>
<table>
<title>G Terminal Information Screen Display</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.43in"/>
<colspec colname="COL2" colwidth="2.70in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Display</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Meaning</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>G Terminal Serial No.</ptxt>
</entry>
<entry valign="middle">
<ptxt>Reads and displays the G-BOOK terminal serial No. held by the navigation receiver assembly (G-BOOK terminal ID)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</step3>
</step2>
</step1>
<step1>
<ptxt>HELPNET Inspection Menu</ptxt>
<figure>
<graphic graphicname="E100922" width="2.775699831in" height="1.771723296in"/>
</figure>
<step2>
<ptxt>HELPNET Inspection Menu</ptxt>
<step3>
<ptxt>Start diagnosis and display the diagnosis inspection menu screen.</ptxt>
</step3>
<step3>
<ptxt>Select "HELPNET Check" on the diagnosis check menu screen to display the HELPNET check menu screen.</ptxt>
</step3>
<step3>
<ptxt>Check the content.</ptxt>
<table>
<title>HELPNET Check Menu Screen Display</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.35in"/>
<colspec colname="COL2" colwidth="2.78in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Display Content</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Mayday Type</ptxt>
</entry>
<entry valign="middle">
<ptxt>Displays the type of HELPNET in-vehicle unit installed ("C (one-touch type)" is displayed on this model)</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>In-vehicle Unit ID</ptxt>
</entry>
<entry valign="middle">
<ptxt>Displays the ID of the installed HELPNET in-vehicle unit</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Contract Status</ptxt>
</entry>
<entry valign="middle">
<ptxt>Displays the HELPNET service contract status as follows</ptxt>
<list1 type="unordered">
<item>
<ptxt>"Activated": Contracted and member registration completed</ptxt>
</item>
<item>
<ptxt>"Not Activated": Contracted but member registration not performed</ptxt>
</item>
<item>
<ptxt>"Not Contracted": Not contracted</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Next Maintenance Check</ptxt>
</entry>
<entry valign="middle">
<ptxt>Displays the next automatic maintenance check date</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</step3>
</step2>
</step1>
</content5>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>