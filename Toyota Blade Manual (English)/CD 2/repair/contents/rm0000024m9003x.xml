<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y1F_T00HQ" variety="T00HQ">
<name>Transmission Control Computer Assembly (U660E)</name>
<para id="RM0000024M9003X" category="A" type-id="80001" name-id="261IO-00" from="200708">
<name>Removal</name>
<subpara id="RM0000024M9003X_01" type-id="01" category="01">
<s-1 id="RM0000024M9003X_01_0009" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000024M9003X_01_0010" proc-id="RM0550J___0000HIO00000">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
<content1 releasenbr="2">
<ptxt>(see <xref label="Seep01" href="RM000000D9902LX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM0000024M9003X_01_0011" proc-id="RM0550J___0000EUD00000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000024M9003X_01_0012" proc-id="RM0550J___0000EUE00000">
<ptxt>Remove Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the battery tray.</ptxt>
<figure>
<graphic graphicname="A176883" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 clamps and disconnect the wire harness from the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Remove the 4 bolts and the battery carrier.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000024M9003X_01_0013" proc-id="RM0550J___0000EUF00000">
<ptxt>Remove Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and battery carrier NO.2.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000024M9003X_01_0005" proc-id="RM0550J___0000G7M00000">
<ptxt>Remove Transmission Control Computer Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Release the lock lever and disconnect the connector from the computer.</ptxt>
<figure>
<graphic graphicname="C133604" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and remove the computer from the transaxle.</ptxt>
<figure>
<graphic graphicname="C139840J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>