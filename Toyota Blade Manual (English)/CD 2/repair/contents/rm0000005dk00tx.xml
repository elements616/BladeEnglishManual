<descript-testgroup>
<testtitle>Inspect Large-scale Body Multiplex Communication System [LIN] Communication Function</testtitle>
<test1>
<ptxt>Using SST (TaSCAN), perform a communication function inspection of the body multiplex communication [LIN] and confirm that there is no malfunction in the communication system. (see <xref label="Seep02" href="RM000001Z23006X"/>)</ptxt>
<table>
<title>Result</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>(ECU not connected, communication line malfunction) No code output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>(ECU not connected, communication line malfunction) Code output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test1>
<results>
<result>B</result>
<action-ci-right>Go to Large-scale Body Multiplex Communication [LIN] Section (see <xref label="Seep03" href="RM00000068J00MX"/>)</action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
