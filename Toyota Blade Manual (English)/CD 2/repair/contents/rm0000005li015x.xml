<tmc-service-inc>
<pub id="RM0550J">
<servcat id="08">
<name>Heater &amp; Air Conditioner/Ventilation</name>
<section id="1002K_S000B" variety="S000B">
<name>Air Conditioner</name>
<ttl id="1002K_S000B_7421V_T0025" variety="T0025">
<name>Heater &amp; Air Conditioner System</name>
<para id="RM0000005LI015X" category="D" type-id="303F4" name-id="52231-00" from="200612">
<name>DTC Check/Clear</name>
<subpara id="RM0000005LI015X_z0" proc-id="RM0550J___00000YA00000">
<content5 releasenbr="1">
<step1>
<ptxt>DTC Check (Reading Using TaSCAN)</ptxt>
<step2>
<ptxt>With the IG OFF, connect SST (TaSCAN) to DLC3.</ptxt>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
</step2>
<step2>
<ptxt>Turn IG ON.</ptxt>
</step2>
<step2>
<ptxt>Following the TaSCAN screen instructions, display the [Diagnosis Menu] → [Body] → [A/C] screen and select [DTC/Freeze Data].</ptxt>
</step2>
<step2>
<ptxt>Check the diagnostic trouble codes.</ptxt>
</step2>
</step1>
<step1>
<ptxt>Clearing DTC Memory (Clearing Using TaSCAN)</ptxt>
<step2>
<ptxt>With the IG OFF, connect SST (TaSCAN) to DLC3.</ptxt>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
</step2>
<step2>
<ptxt>Turn IG ON.</ptxt>
</step2>
<step2>
<ptxt>Following the TaSCAN screen instructions, display the [Diagnosis Menu] → [Body] → [A/C] screen and select [DTC/Freeze Data].</ptxt>
</step2>
<step2>
<ptxt>Select [Clear] on the screen to clear the data.</ptxt>
</step2>
</step1>
</content5>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
