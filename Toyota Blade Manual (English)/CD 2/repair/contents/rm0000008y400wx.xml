<subpara id="RM0000008Y400WX_04" type-id="51" category="05" proc-id="RM0550J___00002PR00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Using SST (TaSCAN), read the Freeze Frame Data. Freeze Frame Data records part of the engine operating conditions when a malfunction occurs, and this information is useful for troubleshooting.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000008Y400WX_01" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000008Y400WX_01_0001" proc-id="RM0550J___00002PI00000">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Engine Coolant Temperature)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn the IG ON and, with the engine stopped, read the engine coolant temperature displayed on the SST (TaSCAN).</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Display</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>-40°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>140°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Same as actual coolant temperature</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000008Y400WX_01_0002" fin="false">A</down>
<right ref="RM0000008Y400WX_01_0016" fin="false">B</right>
<right ref="RM0000008Y400WX_01_0018" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM0000008Y400WX_01_0002" proc-id="RM0550J___00002PJ00000">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Wire Harness Open Circuit Inspection)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09843-18040</s-number>
</sstitem>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
<figure>
<graphic graphicname="A080124J10" width="2.775699831in" height="1.771723296in"/>
</figure>
</test1>
<test1>
<ptxt>Disconnect the E.F.I. water temperature sensor connector.</ptxt>
</test1>
<test1>
<ptxt>Using SST (diagnosis check wire No.2), connect between terminals 2 (THW) ←→ 1 (E2) of the E.F.I. water temperature sensor.</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Read the engine coolant temperature displayed on the SST (TaSCAN).</ptxt>
<spec>
<title>Displayed Temperature</title>
<specitem>
<ptxt>140°C</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000008Y400WX_01_0019" fin="true">OK</down>
<right ref="RM0000008Y400WX_01_0013" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM0000008Y400WX_01_0013" proc-id="RM0550J___00002PK00000">
