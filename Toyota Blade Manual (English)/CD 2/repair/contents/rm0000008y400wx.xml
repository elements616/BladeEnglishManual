</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>If THW voltage is outside the standard</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>If there is no continuity between terminal E2 and body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000008Y400WX_01_0014" fin="false">A</down>
<right ref="RM0000008Y400WX_01_0015" fin="false">B</right>
</res>
</testgrp>
