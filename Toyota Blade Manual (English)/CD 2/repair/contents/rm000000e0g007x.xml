<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002W_S001A" variety="S001A">
<name>Instrument Panel</name>
<ttl id="1002W_S001A_746H6_T00C6" variety="T00C6">
<name>Console Box Assembly</name>
<para id="RM000000E0G007X" category="A" type-id="80001" name-id="78083-00" from="200612" to="200912">
<name>Removal</name>
<subpara id="RM000000E0G007X_05" type-id="01" category="01">
<s-1 id="RM000000E0G007X_05_0029" proc-id="RM0550J___0000ABV00000">
<ptxt>Remove Console Box Cover Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a thin flat-tip screwdriver wrapped with protective tape, disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B163189J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Place your hand at the position shown in the illustration and disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B156562" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors and remove the console box rear cover.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E0G007X_05_0031" proc-id="RM0550J___0000ABX00000">
<ptxt>Remove Console Box Carpet</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the console box carpet.</ptxt>
<figure>
<graphic graphicname="B156554" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E0G007X_05_0033" proc-id="RM0550J___0000ABZ00000">
<ptxt>Remove Console Box Assembly Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 2 screws.</ptxt>
<figure>
<graphic graphicname="B167309" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 4 claws and remove the console box assembly RR.</ptxt>
<figure>
<graphic graphicname="B167310" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>