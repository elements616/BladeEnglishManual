<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM0000035GT01MX" category="C" type-id="803M3" name-id="NS2Z2-24" from="200912">
<dtccode>U0073</dtccode>
<dtcname>CAN communication malfunction</dtcname>
<subpara id="RM0000035GT01MX_02" type-id="33" category="03" proc-id="RM0550J___0000IHJ00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the self-diagnosis of the navigation receiver assembly determines that there is a malfunction in the CAN communication system.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>U0073</ptxt>
</entry>
<entry valign="middle">
<ptxt>CAN connection malfunction</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>CAN Communication System</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000035GT01MX_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM0000035GT01MX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000035GT01MX_04_0004" proc-id="RM0550J___0000IHL00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM0000035GT01MX_04_0001" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000035GT01MX_04_0001" proc-id="RM0550J___0000IHK00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>No code output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000035GT01MX_04_0003" fin="true">A</down>
<right ref="RM0000035GT01MX_04_0002" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035GT01MX_04_0002">
<testtitle>Go to CAN Communication System<xref label="Seep01" href="RM000001R4W019X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035GT01MX_04_0003">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY07EX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>