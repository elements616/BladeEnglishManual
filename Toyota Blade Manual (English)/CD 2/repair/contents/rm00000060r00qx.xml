</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060R00QX_08_0011" fin="true">A</down>
<right ref="RM00000060R00QX_08_0012" fin="true">B</right>
</res>
</testgrp>
