<para id="RM000002G59004X" category="C" type-id="302Z3" name-id="066NJ-00" from="200708">
<dtccode>P0031/28</dtccode>
<dtcname>O2 (A/F) Sensor Heater Performance DeteriorationB1S1</dtcname>
<dtccode>P0032/28</dtccode>
