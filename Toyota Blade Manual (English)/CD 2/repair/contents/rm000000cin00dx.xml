<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1000N_S0010" variety="S0010">
<name>Brake</name>
<ttl id="1000N_S0010_744Y6_T009R" variety="T009R">
<name>Rear Brake</name>
<para id="RM000000CIN00DX" category="A" type-id="80002" name-id="45112-00" from="200612">
<name>Disassembly</name>
<subpara id="RM000000CIN00DX_05" type-id="01" category="01">
<s-1 id="RM000000CIN00DX_05_0074" proc-id="RM0550J___000061B00000">
<ptxt>Remove Rear Disc Brake Piston</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C108952J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Using SST, turn the piston counterclockwise to remove it.</ptxt>
<sst>
<sstitem>
<s-number>09960-10010</s-number>
<s-subnumber>09963-00400</s-subnumber>
</sstitem>
</sst>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Do not damage the piston.</ptxt>
</item>
</list1>
<list1 type="unordered">
<item>
<ptxt>Do not splash the fluid.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CIN00DX_05_0075" proc-id="RM0550J___000061C00000">
<ptxt>Remove Cylinder Boot</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the cylinder boot from the piston.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CIN00DX_05_0076" proc-id="RM0550J___000061D00000">
<ptxt>Remove Piston Seal</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C116888J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Using a flat-head screwdriver with its tip wrapped with protective tape, remove the piston seal.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CIN00DX_05_0077">
<ptxt>Remove Rear Disc Brake Bleeder Plug Cap</ptxt>
</s-1>
<s-1 id="RM000000CIN00DX_05_0078">
<ptxt>Remove Rear Disc Brake Bleeder Plug</ptxt>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>