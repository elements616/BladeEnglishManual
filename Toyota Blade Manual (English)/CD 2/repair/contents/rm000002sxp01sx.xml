<ptxt>Image waveform</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6><res>
<down ref="RM000002SXP01SX_21_0049" fin="true">OK</down>
<right ref="RM000002SXP01SX_21_0052" fin="true">NG</right>
