<name>Yaw Rate Sensor</name>
<para id="RM000003052000X" category="A" type-id="30014" name-id="442NW-00" from="200612">
<name>Installation</name>
<subpara id="RM000003052000X_01" type-id="01" category="01">
<s-1 id="RM000003052000X_01_0014" proc-id="RM0550J___00007RO00000">
<ptxt>Install Yaw Rate Sensor Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the yaw rate sensor connector.</ptxt>
<figure>
<graphic graphicname="C150164" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Insert the claw of the yaw rate sensor cover into the yaw rate sensor assembly, and install the yaw rate sensor assembly together with the cover to the body with the 2 bolts.</ptxt>
<torque>
<torqueitem>
<t-value1>20</t-value1>
<t-value2>204</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="C150166" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Do not deform the yaw rate sensor cover.</ptxt>
</item>
<item>
<ptxt>Do not allow foreign matter or carpet to be caught between the yaw rate sensor assembly and the body.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000003052000X_01_0015" proc-id="RM0550J___00007RP00000">
<ptxt>Install Front Seat Assembly LH</ptxt>
<content1 releasenbr="1">
