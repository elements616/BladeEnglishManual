<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B9_T003J" variety="T003J">
<name>Intelligent Parking Assist System</name>
<para id="RM0000021NX008X" category="C" type-id="80391" name-id="672E3-00" from="200612" to="200912">
<dtccode>C1621</dtccode>
<dtcname>Back Camera Overcurrent Malfunction</dtcname>
<dtccode>C1622</dtccode>
<dtcname>Back Camera Signal Open Circuit</dtcname>
<subpara id="RM0000021NX008X_05" type-id="33" category="03" proc-id="RM0550J___00007MI00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller self-diagnosis judges that the power supply voltage output from the television camera controller to the television camera assembly is abnormal.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="2.51in"/>
<colspec colname="COL3" colwidth="3.57in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1621</ptxt>
</entry>
<entry valign="middle">
<ptxt>Back Camera Overcurrent Malfunction</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Television Camera Controller</ptxt>
</item>
<item>
<ptxt>Television Camera Assembly</ptxt>
</item>
<item>
<ptxt>Wire harness and connector between television camera controller and television camera assembly</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C1622</ptxt>
</entry>
<entry valign="middle">
<ptxt>Back Camera Signal Open Circuit</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Television Camera Controller</ptxt>
</item>
<item>
<ptxt>Television Camera Assembly</ptxt>
</item>
<item>
<ptxt>Wire harness and connector between television camera controller and television camera assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000021NX008X_06" type-id="32" category="03" proc-id="RM0550J___00007MJ00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E131312J03" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM0000021NX008X_07" type-id="51" category="05" proc-id="RM0550J___00007MK00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the battery terminal is disconnected, perform the setting operations required when the battery terminal is removed and installed. (see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</item>
<item>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration settings for other systems may be necessary in addition to the intelligent parking assist system. (see <xref label="Seep02" href="RM00000304S000X"/>)</ptxt>
</item>
<item>
<ptxt>If registration/setting becomes necessary while proceeding with the inspection, perform the registration/setting work before proceeding to the next inspection step.</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM0000021NX008X_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000021NX008X_08_0010" proc-id="RM0550J___00007ML00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again, and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"C1621" or "C1622" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021NX008X_08_0011" fin="false">A</down>
<right ref="RM0000021NX008X_08_0014" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000021NX008X_08_0011" proc-id="RM0550J___00007MM00000">
<testtitle>Inspect Wire Harness and Connector (Television Camera Controller - Television Camera Assembly)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation  </ptxt>
<test2>
<ptxt>Disconnect connector B of the television camera controller shown in the illustration.</ptxt>
<figure>
<graphic graphicname="E141825J03" width="2.775699831in" height="2.775699831in"/>
</figure>
</test2>
<test2>
<ptxt>Disconnect the television camera assembly connector.</ptxt>
<figure>
<graphic graphicname="E141822J04" width="2.775699831in" height="2.775699831in"/>
</figure>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance of the wire harness between the television camera controller and the television camera assembly.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.65in"/>
<colspec colname="COL2" colwidth="1.45in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B35(CB+) - 4(CB+)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B11(CGND) - 3(CGND)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B10(CV+) - 2(CV+)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B34(CV-) - 1(CV-)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B35 (CB+) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B11 (CGND) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B10 (CV+) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B34 (CV-) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021NX008X_08_0012" fin="false">OK</down>
<right ref="RM0000021NX008X_08_0015" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000021NX008X_08_0012" proc-id="RM0550J___00007MN00000">
<testtitle>Inspect Television Camera Controller (CB+, CGND, CV-)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Resistance Inspection</ptxt>
<figure>
<graphic graphicname="E141822J05" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Connect connector B of the television camera controller and, using SST (Toyota electrical tester) with the television camera assembly connector disconnected, measure the resistance between each terminal and body ground from the back side of the vehicle side wire harness connector.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.65in"/>
<colspec colname="COL2" colwidth="1.45in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>3 (CGND) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1 (CV-) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<test1>
<ptxt>Voltage Inspection</ptxt>
<figure>
<graphic graphicname="E141822J06" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Using SST (Toyota electrical tester) with the television camera assembly connector disconnected, measure the voltage between each terminal from the back side of the vehicle side wire harness connector.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.65in"/>
<colspec colname="COL2" colwidth="1.45in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>4(CB+) - 3(CGND)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON, shift lever in R</ptxt>
</entry>
<entry valign="middle">
<ptxt>5.7 to 6.5 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021NX008X_08_0018" fin="false">OK</down>
<right ref="RM0000021NX008X_08_0013" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000021NX008X_08_0018" proc-id="RM0550J___00007MP00000">
<testtitle>Inspect Television Camera Assembly (CV+, CGND, CV-)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect connector B of the television camera controller.</ptxt>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<figure>
<graphic graphicname="E144429J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Using SST (Toyota electrical tester) with the television camera assembly connector connected, measure the resistance between each terminal from the back side of the vehicle wire harness connector.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.65in"/>
<colspec colname="COL2" colwidth="1.45in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1(CV-) - 3(CGND)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<test1>
<ptxt>Connect connector B of the television camera controller.</ptxt>
</test1>
<test1>
<ptxt>Waveform Inspection</ptxt>
<figure>
<graphic graphicname="E144430J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<test2>
<ptxt>Using SST (TaSCAN) with the television camera assembly connector connected, measure the waveform from the back side of the vehicle side wire harness connector.</ptxt>
<spec>
<subtitle>Specified Condition</subtitle>
<specitem>
<ptxt>As shown in the illustration</ptxt>
</specitem>
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="2" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="1.166535     in"/>
<colspec colnum="02" colname="C02" colwidth="3.019267     in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>Item</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>2(CV+) - 1(CV-)</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Tool Setting</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.2 V/DIV、0.2 μS/DIV</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Measurement Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>IG ON, shift lever in R</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>The GND level varies depending on the image captured by the camera.</ptxt>
</atten3>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021NX008X_08_0013" fin="true">OK</down>
<right ref="RM0000021NX008X_08_0016" fin="true">NG</right>
</res>
</testgrp>
