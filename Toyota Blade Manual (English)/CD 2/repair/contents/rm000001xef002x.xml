<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001B_S000A" variety="S000A">
<name>Wiper &amp; Washer</name>
<ttl id="1001B_S000A_7421N_T001X" variety="T001X">
<name>Rear Wiper Motor Assembly</name>
<para id="RM000001XEF002X" category="A" type-id="80001" name-id="611DA-00" from="200612">
<name>Removal</name>
<subpara id="RM000001XEF002X_01" type-id="01" category="01">
<s-1 id="RM000001XEF002X_01_0012" proc-id="RM0550J___0000B6N00000">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000001XEF002X_01_0014" proc-id="RM0550J___00009UW00000">
<ptxt>Remove Back Door Trim Panel Assembly Upper
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 clips and 4 claws, and remove the back door trim panel assembly upper.</ptxt>
<figure>
<graphic graphicname="B155566" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001XEF002X_01_0015" proc-id="RM0550J___00009UX00000">
<ptxt>Remove Back Door Side Garnish LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the pin of the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B163625" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the clips and claws, and remove the back door side garnish LH together with the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B155568" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 claws and remove the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B155571" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001XEF002X_01_0016" proc-id="RM0550J___00009UY00000">
<ptxt>Remove Back Door Side Garnish RH
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove the RH side using the same procedure as for the LH side.</ptxt>
</atten4>
</content1></s-1>
<s-1 id="RM000001XEF002X_01_0017" proc-id="RM0550J___00009UZ00000">
<ptxt>Remove Back Door Inside Handle
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="B232579" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Insert a moulding remover at the position shown in the illustration, disengage the 4 claws as shown in the illustration, and remove the back door inside handle.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001XEF002X_01_0018" proc-id="RM0550J___00009V000000">
<ptxt>Remove Back Door Trim Panel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove clip (A).</ptxt>
<figure>
<graphic graphicname="B155573J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 11 clips and remove the back door trim panel assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001XEF002X_01_0002" proc-id="RM0550J___00000UP00000">
<ptxt>Remove Rear Wiper Arm Head Cap</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the rear wiper arm head cap.</ptxt>
<figure>
<graphic graphicname="E144600" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001XEF002X_01_0003" proc-id="RM0550J___00000UQ00000">
<ptxt>Remove Rear Wiper Arm &amp; Blade Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E145415" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Remove the rear wiper arm nut and remove the rear wiper arm &amp; blade assembly.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001XEF002X_01_0013" proc-id="RM0550J___00001XX00000">
<ptxt>Remove Rear Wiper Motor Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E145417" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Disconnect the connector.</ptxt>
</s2>
<s2>
<ptxt>Remove the 3 bolts and remove the rear wiper motor assembly.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001XEF002X_01_0004" proc-id="RM0550J___00000UR00000">
<ptxt>Remove Rear Wiper Motor Grommet</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E147280" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Remove the rear wiper motor grommet.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>