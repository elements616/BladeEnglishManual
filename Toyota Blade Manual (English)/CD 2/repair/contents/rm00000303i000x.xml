<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B9_T003J" variety="T003J">
<name>Intelligent Parking Assist System</name>
<para id="RM00000303I000X" category="C" type-id="8039P" name-id="672FF-00" from="200612" to="200912">
<dtccode>C1632</dtccode>
<dtcname>FRS Sensor Frozen</dtcname>
<subpara id="RM00000303I000X_01" type-id="33" category="03" proc-id="RM0550J___00007P300000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller's self-diagnosis determines, while ultrasonic sensor NO.1 is being driven (when the shift lever is in a position other than "P" or "R" and the vehicle is not stopped), that ultrasonic sensor NO.1 (FRS sensor) is frozen or has dirt such as ice, snow or mud on it.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1632</ptxt>
</entry>
<entry valign="middle">
<ptxt>IPA Ultrasonic Sensor Frozen (Right)</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Ultrasonic sensor NO.1 (FRS sensor)</ptxt>
</item>
<item>
<ptxt>Television Camera Controller</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000303I000X_02" type-id="51" category="05" proc-id="RM0550J___00007P400000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the battery terminal is disconnected, perform the setting operations required when the battery terminal is removed and installed. (see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</item>
<item>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration settings for other systems may be necessary in addition to the intelligent parking assist system. (see <xref label="Seep02" href="RM00000304S000X"/>)</ptxt>
</item>
</list1>
</atten3>
<atten4>
<ptxt>If "Sonar dirty. Please wipe sensor" is displayed on the intelligent parking assist screen, clean ultrasonic sensors NO.1 (FLS sensor and FRS sensor).</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM00000303I000X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000303I000X_03_0001" proc-id="RM0550J___00007P500000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"C1632" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"C1632", "C1AE5" and "C1AEE" are output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000303I000X_03_0002" fin="false">A</down>
<right ref="RM00000303I000X_03_0008" fin="true">B</right>
<right ref="RM00000303I000X_03_0009" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM00000303I000X_03_0002" proc-id="RM0550J___00007P600000">
<testtitle>Inspect Ultrasonic Sensor NO.1 (FRS Sensor)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Ultrasonic Sensor NO.1 (FRS Sensor) Condition</ptxt>
<test2>
<ptxt>Check whether ultrasonic sensor NO.1 (FRS sensor) is frozen due to low ambient temperature or has dirt such as ice, snow or mud on it, and proceed as indicated below.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Frozen or dirt such as ice, snow or mud is adhering</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Not frozen and no dirt such as ice, snow or mud is adhering</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000303I000X_03_0003" fin="false">A</down>
<right ref="RM00000303I000X_03_0005" fin="false">B</right>
</res>
</testgrp>
<testgrp id="RM00000303I000X_03_0003" proc-id="RM0550J___00007P700000">
<testtitle>Clean Ultrasonic Sensor NO.1 (FRS Sensor)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Remove the ice, snow, mud or other dirt from ultrasonic sensor NO.1 (FRS sensor).</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000303I000X_03_0004" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000303I000X_03_0004" proc-id="RM0550J___00007P800000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn the IG OFF, and if the ambient temperature is low, warm the area around ultrasonic sensor NO.1 (FRS sensor).</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, and if the ambient temperature is low, recheck the DTCs while warming the area around ultrasonic sensor NO.1 (FRS sensor), and proceed as indicated below.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"C1632" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000303I000X_03_0005" fin="false">A</down>
<right ref="RM00000303I000X_03_0010" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000303I000X_03_0005" proc-id="RM0550J___00007P900000">
<testtitle>Replace Ultrasonic Sensor NO.1 (FRS Sensor)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace ultrasonic sensor NO.1 (FRS sensor). (see <xref label="Seep01" href="RM0000028X7002X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000303I000X_03_0006" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000303I000X_03_0006" proc-id="RM0550J___00007PA00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"C1632" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000303I000X_03_0007" fin="true">A</down>
<right ref="RM00000303I000X_03_0011" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000303I000X_03_0007">
<testtitle>Replace Television Camera Controller<xref label="Seep01" href="RM000000MZ5001X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000303I000X_03_0008">
<testtitle>Go to other DTC flowchart<xref label="Seep01" href="RM00000303R000X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000303I000X_03_0009">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
<testgrp id="RM00000303I000X_03_0010">
<testtitle>No malfunction (returned to normal)</testtitle>
</testgrp>
<testgrp id="RM00000303I000X_03_0011">
<testtitle>No malfunction (returned to normal)</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
