<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000C_S000O" variety="S000O">
<name>Cooling</name>
<ttl id="1000C_S000O_744GE_T0070" variety="T0070">
<name>Thermostat (2AZ-FE)</name>
<para id="RM00000237M009X" category="A" type-id="8000D" name-id="121DM-00" from="200612">
<name>Inspection</name>
<subpara id="RM00000237M009X_01" type-id="01" category="01">
<s-1 id="RM00000237M009X_01_0001" proc-id="RM0550J___00003VV00000">
<ptxt>Inspect Thermostat</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>The valve opening temperature is stamped on the thermostat.</ptxt>
</atten4>
<figure>
<graphic graphicname="P013560" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Immerse the thermostat in water and gradually heat the water.</ptxt>
<figure>
<graphic graphicname="P000436" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Check the valve opening temperature.</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt>80 to 84°C</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>If it is not as specified, replace the thermostat.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Check the valve lift.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Valve lift 10 mm or more</ptxt>
</specitem>
<specitem>
<ptxt>Fully open temperature 95°C</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>If it is not as specified, replace the thermostat.</ptxt>
</atten4>
<figure>
<graphic graphicname="A051911" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Check that the valve is fully closed when the thermostat is at a low temperature (77°C or less).</ptxt>
<atten4>
<ptxt>If the valve is not fully closed, replace the thermostat.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>