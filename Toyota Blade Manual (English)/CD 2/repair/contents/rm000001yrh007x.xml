<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000U_S0017" variety="S0017">
<name>Steering Column</name>
<ttl id="1000U_S0017_745FR_T00AZ" variety="T00AZ">
<name>Electric Power Steering System</name>
<para id="RM000001YRH007X" category="C" type-id="3054T" name-id="480Y7-00" from="200612">
<dtccode>C1552/22</dtccode>
<dtcname>PIG Power Supply Voltage Malfunction</dtcname>
<subpara id="RM000001YRH007X_01" type-id="33" category="03" proc-id="RM0550J___00005YB00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>As a fail-safe function, power assist is stopped while there is a PIG power source malfunction.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Detection Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1552/22</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>PIG Power Supply Voltage Malfunction</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>EPS fuse</ptxt>
</item>
<item>
<ptxt>Power Steering Computer Assembly</ptxt>
</item>
<item>
<ptxt>Wire Harness</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000001YRH007X_02" type-id="32" category="03" proc-id="RM0550J___00005YC00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C149383J02" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000001YRH007X_03" type-id="51" category="05" proc-id="RM0550J___00005YD00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>If the power steering computer assembly is replaced, perform the torque sensor 0 point calibration and rotation angle sensor output calibration. (see <xref label="Seep01" href="RM0000024YB004X"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000001YRH007X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000001YRH007X_04_0001" proc-id="RM0550J___00005YE00000">
<testtitle>Inspect Fuse (EPS 60A)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance of the fuse (EPS 60A).</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>EPS fuse</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM000001YRH007X_04_0002" fin="false">OK</down>
<right ref="RM000001YRH007X_04_0004" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001YRH007X_04_0002" proc-id="RM0550J___00005YF00000">
<testtitle>Inspect Wire Harness and Connector (PIG Power Source)</testtitle>
<content6 releasenbr="1">
<figure>
<graphic graphicname="C149384J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<test1>
<ptxt>Disconnect connector D of the power steering computer assembly.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage and resistance between the wire harness side connector of the power steering computer assembly and body ground.</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.23in"/>
<colspec colname="COL2" colwidth="0.95in"/>
<colspec colname="COL3" colwidth="0.95in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>D1 (PIG) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.23in"/>
<colspec colname="COL2" colwidth="0.95in"/>
<colspec colname="COL3" colwidth="0.95in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>D2 (PGND) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM000001YRH007X_04_0003" fin="true">OK</down>
<right ref="RM000001YRH007X_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001YRH007X_04_0003">
<testtitle>Replace Power Steering Computer Assembly</testtitle>
</testgrp>
<testgrp id="RM000001YRH007X_04_0004">
<testtitle>Replace Fuse</testtitle>
</testgrp>
<testgrp id="RM000001YRH007X_04_0005">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
