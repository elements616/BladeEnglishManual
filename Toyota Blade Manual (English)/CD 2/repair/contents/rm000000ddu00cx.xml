<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="1001O_S001F" variety="S001F">
<name>Cruise Control</name>
<ttl id="1001O_S001F_74QXD_T00FC" variety="T00FC">
<name>Radar Cruise Control System</name>
<para id="RM000000DDU00CX" category="C" type-id="301RO" name-id="59153-00" from="200708">
<dtccode>P1578/69</dtccode>
<dtcname>Brake system malfunction</dtcname>
<subpara id="RM000000DDU00CX_01" type-id="31" category="03" proc-id="RM0550J___0000CAH00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P1578/69</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>During cruise control (vehicle-to-vehicle distance control mode)</ptxt>
</item>
<item>
<ptxt>Brake system malfunction</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>ABS with EBD &amp; TRC &amp; VSC &amp; BA system</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000DDU00CX_03" type-id="51" category="05" proc-id="RM0550J___0000CAI00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the engine control computer is replaced with a new one, be sure to perform initialization. (see <xref label="Seep02" href="RM000002GO2003X"/>)</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM000000DDU00CX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DDU00CX_04_0001" proc-id="RM0550J___0000CAJ00000">
<testtitle>Check DTC (ABS with EBD &amp; TRC &amp; VSC &amp; BA System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/ABS/VSC" screen.</ptxt>
</test1>
<test1>
<ptxt>Select DTC/Freeze Data and check the DTCs.</ptxt>
<spec>
<title>Result</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTCs are displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTCs are displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DDU00CX_04_0006" fin="false">A</down>
<right ref="RM000000DDU00CX_04_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DDU00CX_04_0006" proc-id="RM0550J___0000CEQ00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Clear the DTCs using SST (TaSCAN). (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000DDU00CX_04_0007" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000DDU00CX_04_0007" proc-id="RM0550J___0000CER00000">
<testtitle>Check DTCs (Radar Cruise Control System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Put the vehicle in the conditions under which the DTC is detected.</ptxt>
<atten4>
<ptxt>The system cannot detect the malfunction unless the detection conditions are met.</ptxt>
</atten4>
<test2>
<ptxt>Drive within the cruise control set vehicle speed range.</ptxt>
</test2>
<test2>
<ptxt>Turn the cruise control main switch ON and put the system in vehicle-to-vehicle distance mode standby.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs. (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>P1578 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>P1578 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DDU00CX_04_0008" fin="true">A</down>
<right ref="RM000000DDU00CX_04_0005" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DDU00CX_04_0008">
<testtitle>Go to Problem Symptom Simulation Method<xref label="Seep01" href="RM000000ABY04BX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DDU00CX_04_0004">
<testtitle>Go to ABS with EBD &amp; TRC &amp; VSC &amp; BA system<xref label="Seep01" href="RM0000005ZT00PX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DDU00CX_04_0005">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM000002ADB004X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
