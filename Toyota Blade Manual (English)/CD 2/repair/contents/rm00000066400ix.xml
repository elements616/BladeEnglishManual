<name>Radar Cruise Control System</name>
<para id="RM00000066400IX" category="J" type-id="300WL" name-id="5915E-00" from="200708">
<dtccode/>
<dtcname>Indicator output circuit</dtcname>
<subpara id="RM00000066400IX_02" type-id="31" category="03" proc-id="RM0550J___0000C9N00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="unordered">
<item>
<ptxt>The engine control computer outputs the indicator output request signal to the combination meter assembly via CAN communication.</ptxt>
</item>
<item>
<ptxt>The "CRUISE" indicator comes on when the cruise control main switch is ON, and blinks if a malfunction occurs during cruise control.</ptxt>
</item>
</list1>
</content5>
</subpara>
<subpara id="RM00000066400IX_03" type-id="32" category="03" proc-id="RM0550J___0000C9O00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E143506J03" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM00000066400IX_04" type-id="51" category="05" proc-id="RM0550J___0000C9P00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>CAN communication is used in this circuit. Before performing the inspection, inspect CAN communication and make sure that the communication system is normal.</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM00000066400IX_01" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000066400IX_01_0001" proc-id="RM0550J___0000C9M00000">
