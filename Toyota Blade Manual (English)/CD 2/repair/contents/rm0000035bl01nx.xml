<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM0000035BL01NX" category="C" type-id="803M4" name-id="NS2YT-24" from="200912">
<dtccode>B15A0</dtccode>
<dtcname>Master component malfunction</dtcname>
<dtccode>B15AD</dtccode>
<dtcname>Navigation processing section malfunction</dtcname>
<dtccode>B15B3</dtccode>
<dtcname>Radio tuner malfunction</dtcname>
<dtccode>B15B4</dtccode>
<dtcname>CD changer malfunction</dtcname>
<dtccode>B15B5</dtccode>
<dtcname>DVD changer malfunction</dtcname>
<dtccode>B15B7</dtccode>
<dtcname>Bluetooth module malfunction</dtcname>
<subpara id="RM0000035BL01NX_01" type-id="33" category="03" proc-id="RM0550J___0000IHM00000">
<name>Function Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>These DTCs are output when a malfunction occurs in a component inside the navigation receiver assembly.</ptxt>
</item>
</list1>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.14in"/>
<colspec colname="COL2" colwidth="4.11in"/>
<colspec colname="COL3" colwidth="1.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTCNo.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B15A0</ptxt>
</entry>
<entry valign="middle">
<ptxt>Bus malfunction / sub-microcomputer malfunction</ptxt>
</entry>
<entry morerows="5" valign="middle">
<ptxt>Navigation Receiver Assembly</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B15AD</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Short to +B, short to ground or open in gyro signal</ptxt>
</item>
<item>
<ptxt>Gyro failure</ptxt>
</item>
<item>
<ptxt>Short to +B, short to ground or open in G sensor signal</ptxt>
</item>
<item>
<ptxt>G sensor failure</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B15B3</ptxt>
</entry>
<entry valign="middle">
<ptxt>Radio tuner communication malfunction</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B15B4</ptxt>
</entry>
<entry valign="middle">
<ptxt>CD mechanism malfunction</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B15B5</ptxt>
</entry>
<entry valign="middle">
<ptxt>DVD mechanism malfunction</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B15B7</ptxt>
</entry>
<entry valign="middle">
<ptxt>TEL ECU (Bluetooth module) malfunction</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000035BL01NX_03" type-id="51" category="05" proc-id="RM0550J___0000IHN00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM0000002RM03SX"/>)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000035BL01NX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000035BL01NX_04_0019" proc-id="RM0550J___0000IHP00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM0000035BL01NX_04_0001" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000035BL01NX_04_0001" proc-id="RM0550J___0000IHO00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.83in"/>
<colspec colname="COL2" colwidth="1.30in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>No code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000035BL01NX_04_0002" fin="true">A</down>
<right ref="RM0000035BL01NX_04_0018" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035BL01NX_04_0002">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY07EX"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035BL01NX_04_0018">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>