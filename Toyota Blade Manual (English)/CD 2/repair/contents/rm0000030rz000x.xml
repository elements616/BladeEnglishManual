<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B9_T003J" variety="T003J">
<name>Intelligent Parking Assist System</name>
<para id="RM0000030RZ000X" category="C" type-id="803CR" name-id="672FP-00" from="200612" to="200912">
<dtccode>C1699</dtccode>
<dtcname>2WD/4WD Undetermined</dtcname>
<subpara id="RM0000030RZ000X_01" type-id="33" category="03" proc-id="RM0550J___0000A8500000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller's self-diagnosis determines that the drive type cannot be identified, or that the drive type signal cannot be received from the engine control computer connected via CAN communication.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1699</ptxt>
</entry>
<entry valign="middle">
<ptxt>Drive Type Undetermined</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Check Drive Type Determination Signal</ptxt>
</item>
<item>
<ptxt>Television Camera Controller</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000030RZ000X_02" type-id="51" category="05" proc-id="RM0550J___0000A8600000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the battery terminal is disconnected, perform steering sensor steering angle neutral point memorization. (see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</item>
<item>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration settings for other systems may be necessary in addition to the intelligent parking assist system. (see <xref label="Seep02" href="RM00000304S000X"/>)</ptxt>
</item>
<item>
<ptxt>If the engine control computer has been replaced, perform the registration and setting work for other systems. (see <xref label="Seep03" href="RM000001LYX00OX"/>)</ptxt>
</item>
<item>
<ptxt>If registration/setting becomes necessary while proceeding with the inspection, perform the registration/setting work before proceeding to the next inspection step.  </ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM0000030RZ000X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000030RZ000X_03_0001" proc-id="RM0550J___0000A8700000">
<testtitle>Check Drive Type Determination Signal</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Drive Type Determination Signal</ptxt>
<figure>
<graphic graphicname="E141988J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<test2>
<ptxt>Start the engine.</ptxt>
</test2>
<test2>
<ptxt>Display the Intelligent Parking Assist Diagnosis System - Signal Connection Check screen. (see <xref label="Seep01" href="RM0000002O8017X"/>)</ptxt>
</test2>
<test2>
<ptxt>Check that "2WD" or "4WD" is displayed in A.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"2WD" or "4WD" is displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"WD CHK" is displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000030RZ000X_03_0002" fin="false">A</down>
<right ref="RM0000030RZ000X_03_0003" fin="false">B</right>
</res>
</testgrp>
<testgrp id="RM0000030RZ000X_03_0002" proc-id="RM0550J___0000A8800000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again, and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"C1699" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000030RZ000X_03_0003" fin="false">A</down>
<right ref="RM0000030RZ000X_03_0006" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000030RZ000X_03_0003" proc-id="RM0550J___0000A8900000">
<testtitle>Replace Television Camera Controller</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Television Camera Controller Swap Inspection</ptxt>
<test2>
<ptxt>Prepare a new television camera controller and replace it. (see <xref label="Seep01" href="RM000000MZ5001X"/>)</ptxt>
</test2>
</test1>
<ptxt/>
</content6>
<res>
<down ref="RM0000030RZ000X_03_0004" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000030RZ000X_03_0004" proc-id="RM0550J___0000A8A00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again, and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"C1699" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000030RZ000X_03_0005" fin="true">A</down>
<right ref="RM0000030RZ000X_03_0007" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000030RZ000X_03_0005">
<testtitle>Replace Television Camera Controller<xref label="Seep01" href="RM000000MZ5001X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000030RZ000X_03_0006">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
<testgrp id="RM0000030RZ000X_03_0007">
