<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002T_S000D" variety="S000D">
<name>Other Electrical</name>
<ttl id="1002T_S000D_746SZ_T00DB" variety="T00DB">
<name>Hands-free System</name>
<para id="RM000001C4800HX" category="D" type-id="303F3" name-id="7326D-00" from="200612" to="200912">
<name>Diagnosis System</name>
<subpara id="RM000001C4800HX_z0" proc-id="RM0550J___0000B4K00000">
<content5 releasenbr="1">
<step1>
<ptxt>Diagnosis Screen Transitions</ptxt>
<atten4>
<ptxt>For diagnosis screen transitions, refer to HDD Navigation System - Diagnosis System (<xref label="Seep01" href="RM0000002RV02BX"/>).</ptxt>
</atten4>
</step1>
<step1>
<ptxt>Starting and Ending Diagnosis</ptxt>
<step2>
<ptxt>Start Diagnosis (see <xref label="Seep02" href="RM0000002RV02BX"/>)</ptxt>
</step2>
<step2>
<ptxt>Cancel Diagnosis (see <xref label="Seep03" href="RM0000002RV02BX"/>)</ptxt>
</step2>
</step1>
<step1>
<ptxt>BT Hands-free Inspection</ptxt>
<figure>
<graphic graphicname="E100883" width="2.775699831in" height="1.771723296in"/>
</figure>
<table>
<title>BT Hands-free Check Menu Screen Display</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.50in"/>
<colspec colname="COL2" colwidth="2.63in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Display</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Bluetooth Check</ptxt>
</entry>
<entry valign="middle">
<ptxt>Displays the Bluetooth check screen</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Hands-free Sound Quality Setting</ptxt>
</entry>
<entry valign="middle">
<ptxt>Displays the screen for setting hands-free sound quality</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten4>
<ptxt>Each BT hands-free inspection screen is drawn by the navigation receiver assembly.</ptxt>
</atten4>
<step2>
<ptxt>Bluetooth Check</ptxt>
<figure>
<graphic graphicname="E100884" width="2.775699831in" height="1.771723296in"/>
</figure>
<step3>
<ptxt>Start diagnosis and display the diagnosis inspection menu screen.</ptxt>
</step3>
<step3>
<ptxt>Select "BT Hands-free Check" on the diagnosis check menu screen to display the BT hands-free check menu screen.</ptxt>
</step3>
<step3>
<ptxt>Select "Bluetooth Check" on the BT hands-free check menu screen to display the Bluetooth check menu screen.</ptxt>
</step3>
<step3>
<ptxt>Select "Version Information" on the Bluetooth check menu screen to display the version information screen.</ptxt>
</step3>
<step3>
<ptxt>Check the version information.</ptxt>
<figure>
<graphic graphicname="E100886" width="2.775699831in" height="1.771723296in"/>
</figure>
<table>
<title>Version Information Screen Display</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.50in"/>
<colspec colname="COL2" colwidth="2.63in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Display</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Integrated Ver.</ptxt>
</entry>
<entry valign="middle">
<ptxt>Version of the entire Bluetooth module software; software is managed by the integrated version</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>API Version Information Display</ptxt>
</entry>
<entry valign="middle">
<ptxt>Indicates the version of the API software</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Upper Stack Version Information Display</ptxt>
</entry>
<entry valign="middle">
<ptxt>Indicates the version of the Upper Stack software</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Lower Stack Version Information Display</ptxt>
</entry>
<entry valign="middle">
<ptxt>Indicates the version of the Lower Stack software</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</step3>
</step2>
<step2>
<ptxt>Hands-free Sound Quality Setting</ptxt>
<figure>
<graphic graphicname="E122081J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<step3>
<ptxt>Start diagnosis and display the diagnosis inspection menu screen.</ptxt>
</step3>
<step3>
<ptxt>Select "BT Hands-free Check" on the diagnosis check menu screen to display the BT hands-free check menu screen.</ptxt>
</step3>
<step3>
<ptxt>Select "Hands-free Sound Quality Setting" on the BT hands-free check menu screen to display the hands-free sound quality setting screen.</ptxt>
</step3>
<step3>
<ptxt>Operate the screen switches to adjust the volume.</ptxt>
<table>
<title>Hands-free Sound Quality Setting Screen Display</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.50in"/>
<colspec colname="COL2" colwidth="2.63in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Display Content</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Receiving Volume Adjustment Item</ptxt>
</entry>
<entry valign="middle">
<ptxt>Adjusts the receiving volume (other party's voice heard by you) during hands-free calls</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Transmitting Volume Adjustment Item</ptxt>
</entry>
<entry valign="middle">
<ptxt>Adjusts the transmitting volume (your voice heard by the other party) during hands-free calls</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten3>
<ptxt>Do not change the sound quality setting number.</ptxt>
</atten3>
<atten4>
<ptxt>This screen is drawn by the navigation receiver assembly.</ptxt>
</atten4>
</step3>
</step2>
</step1>
</content5>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>