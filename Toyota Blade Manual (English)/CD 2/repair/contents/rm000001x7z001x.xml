<para id="RM000001X7Z001X" category="A" type-id="30014" name-id="603JC-00" from="200612" to="200912">
<name>Installation</name>
<subpara id="RM000001X7Z001X_01" type-id="01" category="01">
<s-1 id="RM000001X7Z001X_01_0034" proc-id="RM0550J___0000A6V00000">
<ptxt>Install Rear Combination Light Assembly LH</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E147041J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Engage the 2 clips and the tail light (rear combination light) guide, and install the tail light (rear combination light) assembly LH.</ptxt>
</s2>
<s2>
<ptxt>Install the 2 nuts.</ptxt>
</s2>
<s2>
<ptxt>Connect the connector and engage the clamp.</ptxt>
<figure>
<graphic graphicname="E147285" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X7Z001X_01_0036" proc-id="RM0550J___0000A6X00000">
<ptxt>Install Rear Combination Light Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert the 2 guides.</ptxt>
<figure>
<graphic graphicname="E145807J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 4 claws and install the rear combination light cover LH.</ptxt>
</s2>
</content1>
</s-1>
