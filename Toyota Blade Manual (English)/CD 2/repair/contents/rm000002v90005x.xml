<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000D_S000P" variety="S000P">
<name>Lubrication</name>
<ttl id="1000D_S000P_74Y1K_T00HV" variety="T00HV">
<name>Engine Oil Pressure Switch Assembly (2GR-FE)</name>
<para id="RM000002V90005X" category="A" type-id="30014" name-id="130W1-00" from="200708">
<name>Installation</name>
<subpara id="RM000002V90005X_01" type-id="01" category="01">
<s-1 id="RM000002V90005X_01_0001" proc-id="RM0550J___0000G8O00000">
<ptxt>Install Engine Oil Pressure Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Degrease the threads of the engine oil pressure switch assembly.</ptxt>
</s2>
<s2>
<ptxt>Apply adhesive 1324 to the threads.</ptxt>
<figure>
<graphic graphicname="A177271J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a deep socket wrench 24mm, install the engine oil pressure switch assembly.</ptxt>
<figure>
<graphic graphicname="A129647" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>15</t-value1>
<t-value2>153</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>After installation, leave it without starting the engine for 1 hours.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Connect the engine oil pressure switch assembly connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002V90005X_01_0004" proc-id="RM0550J___0000FQ300000">
<ptxt>Install Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install engine under cover NO.1 with the 6 bolts and 7 clips.</ptxt>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>