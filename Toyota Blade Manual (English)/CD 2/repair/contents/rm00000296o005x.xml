<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_747JK_T00DW" variety="T00DW">
<name>Crank Position Sensor (2AZ-FE)</name>
<para id="RM00000296O005X" category="A" type-id="30014" name-id="065B6-00" from="200612">
<name>Installation</name>
<subpara id="RM00000296O005X_01" type-id="01" category="01">
<s-1 id="RM00000296O005X_01_0018" proc-id="RM0550J___0000BXM00000">
<ptxt>Install Crankshaft Position Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply a light coat of engine oil to the O-ring.</ptxt>
<figure>
<graphic graphicname="A095436J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the crank position sensor with the bolt.</ptxt>
<figure>
<graphic graphicname="A138142J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>9.0</t-value1>
<t-value2>92</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>Install the O-ring to the timing chain cover so that it is not cut or pinched.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Fit the wire harness into the wire harness clamp bracket.</ptxt>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000296O005X_01_0010" proc-id="RM0550J___000031G00000">
<ptxt>Install Alternator Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that the crankshaft position sensor wire harness is securely fitted into the wire harness clamp bracket and passes behind the rib of the timing chain cover.</ptxt>
<figure>
<graphic graphicname="A097394J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the Alternator with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A137076J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<subtitle>Bolt A</subtitle>
<torqueitem>
<t-value1>21</t-value1>
<t-value2>214</t-value2>
</torqueitem>
<subtitle>Bolt B</subtitle>
<torqueitem>
<t-value1>52</t-value1>
<t-value2>530</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the harness clamp.</ptxt>
<figure>
<graphic graphicname="A137075" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the clamp bracket with the bolt.</ptxt>
<torque>
<torqueitem>
<t-value1>7.7</t-value1>
<t-value2>79</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the harness to the +B terminal with the nut.</ptxt>
<torque>
<torqueitem>
<t-value1>9.8</t-value1>
<t-value2>100</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the terminal cap.</ptxt>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000296O005X_01_0011" proc-id="RM0550J___000031H00000">
<ptxt>Install Fan &amp; Alternator V Belt
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>When reusing the belt, inspect the entire circumference of the ribs and back for wear and cracks, and replace it if wear or cracks reach the core (1 or more places) or if the rib rubber is chipped (1 or more places).</ptxt>
</atten4>
<s2>
<ptxt>Using SST, slowly turn the V-belt tensioner clockwise and install the V-belt.</ptxt>
<figure>
<graphic graphicname="A164227J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<sst>
<sstitem>
<s-number>09961-01270</s-number>
</sstitem>
</sst>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Check that the SST and tools are securely set.</ptxt>
</item>
<item>
<ptxt>When compressing the V-belt tensioner, slowly apply force perpendicular to the tool, taking 3 seconds or more.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Check that the belt is fitted on each pulley.</ptxt>
<figure>
<graphic graphicname="A127534J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Check that the belt is correctly set on each pulley.</ptxt>
<figure>
<graphic graphicname="A088652" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Start the engine and check that the belt rotates smoothly with no abnormal noise.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000296O005X_01_0019" proc-id="RM0550J___000031W00000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 8 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000296O005X_01_0020" proc-id="RM0550J___000037H00000">
<ptxt>Install Engine Under Cover Rear RH
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Use the same procedure for the RH side as for the LH side.</ptxt>
</atten4>
</content1></s-1>
<s-1 id="RM00000296O005X_01_0015" proc-id="RM0550J___0000BXJ00000">
<ptxt>Install Front Tire RH</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>103</t-value1>
<t-value2>1050</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM00000296O005X_01_0016" proc-id="RM0550J___0000BXK00000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM00000296O005X_01_0017" proc-id="RM0550J___0000BXL00000">
<ptxt>Initialization When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>