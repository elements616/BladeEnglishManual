<para id="RM000000DC900WX" category="C" type-id="3055L" name-id="261I7-00" from="200708">
<dtccode>P0748/62</dtccode>
<dtcname>SL1 Solenoid Circuit (Open)</dtcname>
<dtccode>P0778/63</dtccode>
<dtcname>SL2 Solenoid Circuit (Open)</dtcname>
