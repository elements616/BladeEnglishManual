<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_742BO_T003T" variety="T003T">
<name>Amplifier Microphone Assembly</name>
<para id="RM000001K0X002X" category="A" type-id="80001" name-id="652MZ-00" from="200612">
<name>Removal</name>
<subpara id="RM000001K0X002X_01" type-id="01" category="01">
<s-1 id="RM000001K0X002X_01_0006" proc-id="RM0550J___00009Y200000">
<ptxt>Remove Interior Illumination Light Assembly NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a roof molding remover, detach the clips in order from the front.</ptxt>
<figure>
<graphic graphicname="B167258" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Detach the harness at the position shown in the illustration from the clamp.</ptxt>
<figure>
<graphic graphicname="B168874" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connector and remove interior illumination light assembly NO.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001K0X002X_01_0003" proc-id="RM0550J___00001R700000">
<ptxt>Remove Amplifier Microphone Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 2 claws and separate the amplifier microphone assembly from the interior illumination light NO,1.</ptxt>
<figure>
<graphic graphicname="E147024" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connector and remove the amplifier microphone assembly from the interior illumination light NO,1.</ptxt>
<figure>
<graphic graphicname="E147025" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>