<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001I_S000I" variety="S000I">
<name>Door Lock</name>
<ttl id="1001I_S000I_746FW_T00BX" variety="T00BX">
<name>Indoor Electrical Key Oscillator (Installed in Luggage Room)</name>
<para id="RM000001W0G005X" category="A" type-id="80001" name-id="622P1-00" from="200612">
<name>Removal</name>
<subpara id="RM000001W0G005X_02" type-id="01" category="01">
<s-1 id="RM000001W0G005X_02_0011" proc-id="RM0550J___00009XJ00000">
<ptxt>Remove Package Tray Trim Panel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the 2 suspenders from the package tray trim garnish hooks.</ptxt>
<figure>
<graphic graphicname="B167256J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 pins and remove the package tray trim panel assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001W0G005X_02_0017" proc-id="RM0550J___00009XL00000">
<ptxt>Remove Rear Floor Mat Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the rear floor mat rear.</ptxt>
<figure>
<graphic graphicname="B167257" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001W0G005X_02_0018" proc-id="RM0550J___00009XM00000">
<ptxt>Remove Deck Floor Box RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 nuts.</ptxt>
<figure>
<graphic graphicname="B152866J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the guide and remove the deck floor box RH.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001W0G005X_02_0016" proc-id="RM0550J___00008LU00000">
<ptxt>Remove Indoor Electrical Key Oscillator</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="B167259" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the claws and remove the indoor electrical key oscillator.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>