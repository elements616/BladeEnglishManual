<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000C_S000O" variety="S000O">
<name>Cooling</name>
<ttl id="1000C_S000O_74XTI_T00GW" variety="T00GW">
<name>Thermostat (2GR-FE)</name>
<para id="RM0000020WI00BX" category="A" type-id="80001" name-id="121KS-00" from="200708">
<name>Removal</name>
<subpara id="RM0000020WI00BX_01" type-id="01" category="01">
<s-1 id="RM0000020WI00BX_01_0029" proc-id="RM0550J___0000DHU00000">
<ptxt>Remove V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place both hands on the front of the cover and lift it upward to disengage the 2 front clips, then continue lifting upward to disengage the 1 rear clips, and remove the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Pulling up the front and rear at the same time may cause damage.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0030" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0031">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM0000020WI00BX_01_0032" proc-id="RM0550J___0000GWD00000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0033" proc-id="RM0550J___00008DP00000">
<ptxt>Remove Radiator Grille Protector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 radiator grille protectors.</ptxt>
<figure>
<graphic graphicname="B167060" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0034" proc-id="RM0550J___0000AJ800000">
<ptxt>Remove Engine Under Cover
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 4 screws, and remove the engine under cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0035" proc-id="RM0550J___0000AJ700000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove the engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0056" proc-id="RM0550J___0000EUM00000">
<ptxt>Remove Engine Under Cover Rear RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 5 clips and the engine under cover rear RH.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0036" proc-id="RM0550J___00008DQ00000">
<ptxt>Remove Front Bumper Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a flat-tip screwdriver, turn the pin hold clip 90° and remove the pin hold clip.</ptxt>
<figure>
<graphic graphicname="B167061J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Perform the same procedure on the RH side.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Apply protective tape around the front bumper assembly.</ptxt>
<figure>
<graphic graphicname="B167062J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Using a clip remover, remove the 3 upper clips.</ptxt>
</s2>
<s2>
<ptxt>Remove the 6 screws, 2 clips and 2 bolts.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly outward from the vehicle to disengage the 8 claws (4 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167063" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly toward the front of the vehicle and remove the front bumper assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0037" proc-id="RM0550J___0000CCB00000">
<ptxt>Remove Millimeter Wave Radar Sensor Assembly (w/ Cruise Control (w/ Radar Cruise))
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="B180359" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 bolts and the millimeter wave radar sensor assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0038" proc-id="RM0550J___0000CWV00000">
<ptxt>Remove Millimeter Wave Radar Sensor Bracket NO.1 (w/ Cruise Control (w/ Radar Cruise))
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and millimeter wave radar sensor bracket NO.1.</ptxt>
<figure>
<graphic graphicname="B180360" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0039" proc-id="RM0550J___0000GUZ00000">
<ptxt>Remove Radiator Side Deflector LH
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="A178923" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Disengage the 3 clips and guide, and remove the radiator side cover LH.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0040" proc-id="RM0550J___0000HBM00000">
<ptxt>Remove Radiator Side Cover RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 2 clips and remove the radiator side cover RH.</ptxt>
<figure>
<graphic graphicname="A178924" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0041" proc-id="RM0550J___0000GW000000">
<ptxt>Drain Coolant (Toyota Genuine Super Long Life Coolant)<xref href="RM0000020WA00BX_02_0078"/>
</ptxt>
</s-1>
<s-1 id="RM0000020WI00BX_01_0042" proc-id="RM0550J___0000GW200000">
<ptxt>Disconnect Water Bypass Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and 2 clamps, and disconnect water bypass hose NO.2 from the radiator support assembly.</ptxt>
<figure>
<graphic graphicname="A176291J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0043" proc-id="RM0550J___0000GW300000">
<ptxt>Disconnect Hood Lock Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the hood lock control assembly from the 2 clamps.</ptxt>
<figure>
<graphic graphicname="A155392" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 bolts and disconnect the hood lock assembly.</ptxt>
<figure>
<graphic graphicname="A162973" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0044" proc-id="RM0550J___0000HBU00000">
<ptxt>Remove Radiator Support Upper
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and the UPR2 radiator supports.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0045" proc-id="RM0550J___0000HBV00000">
<ptxt>Remove Radiator Support Cushion
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 radiator support cushions from fan shroud No. 2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0046" proc-id="RM0550J___0000GW400000">
<ptxt>Remove Radiator Support Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the 2 horn assembly connectors.</ptxt>
<figure>
<graphic graphicname="A162974" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 4 bolts and radiator support assembly.</ptxt>
<figure>
<graphic graphicname="A176292" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0047" proc-id="RM0550J___0000GW600000">
<ptxt>Disconnect Water Bypass Hose
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="A176293J02" width="2.775699831in" height="3.779676365in"/>
</figure>
<s2>
<ptxt>Slide the 2 clamps and disconnect water bypass hose No.1 and water bypass hose No.3.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0048" proc-id="RM0550J___0000GW500000">
<ptxt>Remove Fan Shroud NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the 2 clamps and disconnect the 2 horn assembly connectors from fan shroud No.2.</ptxt>
<figure>
<graphic graphicname="A178925" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and separate fan shroud No.2 from the radiator assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0049" proc-id="RM0550J___0000GW700000">
<ptxt>Disconnect Radiator Hose NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the clamp and disconnect radiator hose NO.2.</ptxt>
<figure>
<graphic graphicname="A159946" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0050" proc-id="RM0550J___0000GW800000">
<ptxt>Disconnect Radiator Hose NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the clamp and disconnect the radiator hose NO.1.</ptxt>
<atten4>
<ptxt>Pinch the claws at the clamp joint to remove it.</ptxt>
</atten4>
<figure>
<graphic graphicname="A176812" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Slide the clamp and disconnect radiator hose NO.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0051" proc-id="RM0550J___0000HBN00000">
<ptxt>Disconnect Oil Cooler Inlet Hose NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the clamp and disconnect the oil cooler inlet hose NO.1.</ptxt>
<figure>
<graphic graphicname="A177055" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0052" proc-id="RM0550J___0000HBO00000">
<ptxt>Disconnect Oil Cooler Outlet Hose NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the clamp and disconnect the oil cooler outlet hose NO.1.</ptxt>
<figure>
<graphic graphicname="A177056" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0053" proc-id="RM0550J___0000GW900000">
<ptxt>Disconnect Wire Harness
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the cooling fan motor connector and 2 wire harness clamps.</ptxt>
<figure>
<graphic graphicname="A176814" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0054" proc-id="RM0550J___0000GWA00000">
<ptxt>Disconnect Thermistor Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the clip and disconnect the thermistor assembly.</ptxt>
<figure>
<graphic graphicname="A155390" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0055" proc-id="RM0550J___0000GWB00000">
<ptxt>Remove Radiator Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Separate the cooler condenser assembly from the fan shroud.   </ptxt>
</s2>
<s2>
<ptxt>Remove the radiator assembly together with the fan shroud from the vehicle.</ptxt>
<figure>
<graphic graphicname="A159948" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>When removing the radiator assembly, do not apply excessive force to the cooler condenser assembly and pipes.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Remove the 2 radiator supports lower.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0020" proc-id="RM0550J___0000FIB00000">
<ptxt>Disconnect Radiator Hose NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the clamp and disconnect the radiator outlet hose.</ptxt>
<figure>
<graphic graphicname="A137753" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020WI00BX_01_0026" proc-id="RM0550J___0000DHB00000">
<ptxt>Remove Fan &amp; Alternator V Belt
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Put a tool on the pulley set bolt of the tensioner, and turn the tensioner counterclockwise to loosen the tension.</ptxt>
<figure>
<graphic graphicname="A176882" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Performing this from under the vehicle may damage the tensioner.</ptxt>
</item>
<item>
<ptxt>The pulley set bolt has a left-hand thread, so turning it clockwise loosens the pulley set bolt.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Using a 5mm hexagon wrench, fix the tensioner as shown in the illustration and remove the belt.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0022" proc-id="RM0550J___0000DJN00000">
<ptxt>Remove Idler Pulley Sub-assembly NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and idler pulley No.2.</ptxt>
<figure>
<graphic graphicname="A118311" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI00BX_01_0027" proc-id="RM0550J___0000FIC00000">
<ptxt>Remove Water Inlet</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 nuts and remove the water inlet.</ptxt>
<figure>
<graphic graphicname="A132393" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020WI00BX_01_0028">
<ptxt>Remove Thermostat</ptxt>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>