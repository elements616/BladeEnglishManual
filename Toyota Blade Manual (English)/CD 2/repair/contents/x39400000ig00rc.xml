<subpara id="X39400000IG00RC_12" type-id="51" category="05" proc-id="RM0550J___00004AF00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>When the engine control computer (engine ECU) has been replaced, refer to the immobiliser registration procedure in the reference section.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="X39400000IG00RC_13" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X39400000IG00RC_13_0001" proc-id="RM0550J___00004AG00000">
