<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005KZ013X_08_0019" fin="false">OK</down>
<right ref="RM0000005KZ013X_08_0022" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005KZ013X_08_0019" proc-id="RM0550J___0000C0P00000">
