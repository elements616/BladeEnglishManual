<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1000Y_S0012" variety="S0012">
<name>SRS Airbag</name>
<ttl id="1000Y_S0012_745Q2_T00B8" variety="T00B8">
<name>SRS Airbag System</name>
<para id="RM00000050H00TX" category="J" type-id="300ER" name-id="554HU-00" from="200612">
<dtccode/>
<dtcname>Warning Light Remains On</dtcname>
<subpara id="RM00000050H00TX_02" type-id="31" category="03" proc-id="RM0550J___00006JG00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The airbag warning light is built into the combination meter assembly. </ptxt>
<ptxt>When the SRS airbag system is normal, the airbag warning light comes on for approximately 6 seconds after the ignition switch is turned ON, and then goes off automatically. If there is a malfunction in the SRS airbag system (including poor connection of connectors, etc.), the airbag warning light comes on to inform the driver of the malfunction. </ptxt>
<ptxt>If there is an open, +B short or ground short in the W/H between the airbag computer assembly and combination meter assembly, or a malfunction in the combination meter assembly or airbag computer assembly, the airbag warning light stays on.</ptxt>
</content5>
</subpara>
<subpara id="RM00000050H00TX_03" type-id="32" category="03" proc-id="RM0550J___00006JH00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C159682J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM00000050H00TX_04" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM00000050H00TX_01" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000050H00TX_01_0006" proc-id="RM0550J___00006JF00000">
<testtitle>Inspect CAN Communication System</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs and confirm that there is no malfunction in the CAN communication system. (see <xref label="Seep01" href="RM0000005S001MX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>DTC normal</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000050H00TX_01_0001" fin="false">OK</down>
<right ref="RM00000050H00TX_01_0007" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000050H00TX_01_0001" proc-id="RM0550J___00006JD00000">
<testtitle>Inspect Connector Connection Condition</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Disconnect the battery negative terminal and wait for 90 seconds.</ptxt>
<atten4>
<ptxt>Make sure the ignition switch is OFF before disconnecting the cable from the negative (-) battery terminal.</ptxt>
</atten4>
</test1>
<test1>
<ptxt>Check the connection condition of the connectors connected to the airbag computer assembly.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Connectors are properly connected to the airbag computer assembly </ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000050H00TX_01_0002" fin="false">OK</down>
<right ref="RM00000050H00TX_01_0004" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000050H00TX_01_0002" proc-id="RM0550J___00006JE00000">
<scantool type="8"/>
<testtitle>Perform TaSCAN Active Test</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect the cable to the negative (-) battery terminal and turn the ignition switch ON.</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), perform the Active Test of the combination meter computer. </ptxt>
<table pgwide="1">
<title>[System selection screen: Body → Meter → Active Test]</title>
<tgroup cols="4">
<colspec colname="COL1" colwidth="1.77in"/>
<colspec colname="COL2" colwidth="1.77in"/>
<colspec colname="COL3" colwidth="1.77in"/>
<colspec colname="COL4" colwidth="1.77in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Item Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Reference Value</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>TelltaleNo.1</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Meter Indicator Display</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>AIR BAG</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>1Hz blinking/off</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test1>
</content6>
<res>
<down ref="RM00000050H00TX_01_0003" fin="true">OK</down>
<right ref="RM00000050H00TX_01_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000050H00TX_01_0007">
<testtitle>Go to CAN Communication System<xref label="Seep01" href="RM000001R4W009X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000050H00TX_01_0003">
<testtitle>Replace Airbag Computer Assembly<xref label="Seep01" href="RM000002RR0002X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000050H00TX_01_0004">
<testtitle>Reconnect connector</testtitle>
</testgrp>
<testgrp id="RM00000050H00TX_01_0005">
<testtitle>Replace Combination Meter Assembly<xref label="Seep01" href="RM000002C0G001X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
