<ptxt>Inspect Steering Pad Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Resistance Inspection</ptxt>
<figure>
<graphic graphicname="E146629J03" width="7.106578999in" height="4.7836529in"/>
</figure>
<s3>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the steering pad switch assembly connector when each switch is operated.</ptxt>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<spec>
<title>Resistance</title>
<specitem>
<ptxt/>
</specitem>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" align="center" colwidth="2.36in"/>
<colspec colname="COL2" align="center" colwidth="2.36in"/>
<colspec colname="COL3" align="center" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Tester Connection)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry morerows="1" valign="middle">
