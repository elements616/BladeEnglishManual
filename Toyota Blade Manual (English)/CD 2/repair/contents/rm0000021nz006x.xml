<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B9_T003J" variety="T003J">
<name>Intelligent Parking Assist System</name>
<para id="RM0000021NZ006X" category="C" type-id="80396" name-id="672E7-00" from="200612" to="200912">
<dtccode>C1628</dtccode>
<dtcname>Height Sensor System</dtcname>
<subpara id="RM0000021NZ006X_09" type-id="33" category="03" proc-id="RM0550J___00007NY00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller self-diagnosis judges that the vehicle height sensor signal input from the height control sensor assembly (rear) is abnormal.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1628</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Height Sensor Signal Malfunction</ptxt>
</item>
<item>
<ptxt>Height Sensor Signal Stuck</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire harness and connector between television camera controller and height control sensor assembly (rear)</ptxt>
</item>
<item>
<ptxt>Television Camera Controller</ptxt>
</item>
<item>
<ptxt>Height Control Sensor Assembly (Rear)</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000021NZ006X_10" type-id="32" category="03" proc-id="RM0550J___00007NZ00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E144418J01" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="RM0000021NZ006X_11" type-id="51" category="05" proc-id="RM0550J___00007O000000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the battery terminal is disconnected, perform the setting operations required when the battery terminal is removed and installed. (see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</item>
<item>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration settings for other systems may be necessary in addition to the intelligent parking assist system. (see <xref label="Seep02" href="RM00000304S000X"/>)</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM0000021NZ006X_12" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000021NZ006X_12_0033" proc-id="RM0550J___00007O100000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (For the procedure, refer to <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine and drive at a speed of 30km/h or more.</ptxt>
</test2>
<test2>
<ptxt>After driving, with the engine still running, check the DTCs again and proceed to the corresponding destination below.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"C1628" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021NZ006X_12_0034" fin="false">A</down>
<right ref="RM0000021NZ006X_12_0037" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000021NZ006X_12_0034" proc-id="RM0550J___00007O200000">
<testtitle>Inspect Wire Harness and Connector (Television Camera Controller - Height Control Sensor Assembly (Rear))</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
<sstitem>
<s-number>09843-18040</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation</ptxt>
<test2>
<ptxt>Disconnect connector A of the television camera controller shown in the illustration.</ptxt>
<figure>
<graphic graphicname="E141824J05" width="2.775699831in" height="2.775699831in"/>
</figure>
</test2>
<test2>
<ptxt>Disconnect the height control sensor assembly (rear) connector.</ptxt>
<figure>
<graphic graphicname="E141971J02" width="2.775699831in" height="2.775699831in"/>
</figure>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance of the wire harness between the television camera controller and height control sensor assembly (rear).</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.65in"/>
<colspec colname="COL2" colwidth="1.45in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>3 (SHB) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>2 (SHRR) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1 (SHG) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>A25(HB1) - 3(SHB)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>A18(HI1) - 2(SHRR)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>A3(HG1) - 1(SHG)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021NZ006X_12_0035" fin="false">OK</down>
<right ref="RM0000021NZ006X_12_0038" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000021NZ006X_12_0035" proc-id="RM0550J___00007O300000">
<testtitle>Inspect Television Camera Controller (SHB, SHG)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
<sstitem>
<s-number>09843-18040</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Voltage Inspection</ptxt>
<figure>
<graphic graphicname="E141971J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Connect the television camera controller connector A and, using SST (Toyota electrical tester), with the height control sensor assembly (rear) connector disconnected, measure the voltage between each terminal of the vehicle side wire harness connector.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.65in"/>
<colspec colname="COL2" colwidth="1.45in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>3(SHB) - 1(SHG)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>4.75 to 5.25 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000021NZ006X_12_0036" fin="true">OK</down>
<right ref="RM0000021NZ006X_12_0039" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000021NZ006X_12_0036">
<testtitle>Replace Height Control Sensor Sub-assembly Rear<xref label="Seep01" href="RM000001X8Q001X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000021NZ006X_12_0037">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
<testgrp id="RM0000021NZ006X_12_0038">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM0000021NZ006X_12_0039">
<testtitle>Replace Television Camera Controller<xref label="Seep01" href="RM000000MZ5001X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
