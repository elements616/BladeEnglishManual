<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn the IG ON.</ptxt>
</test1>
<test1>
<ptxt>Check that communication is possible between SST (TaSCAN) and the engine control computer.</ptxt>
<atten4>
<ptxt>The ECU data monitor of the TCCS system can be checked.</ptxt>
</atten4>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.04in"/>
<colspec colname="COL2" colwidth="1.09in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Does not communicate</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Communicates</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002NZF00QX_04_0003" fin="false">A</down>
<right ref="RM000002NZF00QX_04_0009" fin="true">B</right>
</res>
</testgrp>
