<para id="RM000000E0H007X" category="A" type-id="80002" name-id="78084-00" from="200612" to="200912">
<name>Disassembly</name>
<subpara id="RM000000E0H007X_04" type-id="01" category="01">
<s-1 id="RM000000E0H007X_04_0028" proc-id="RM0550J___0000AC100000">
<ptxt>Remove Console Rear End Panel</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 10 claws and remove the console rear end panel.</ptxt>
<figure>
<graphic graphicname="B167530" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E0H007X_04_0029" proc-id="RM0550J___0000AC200000">
<ptxt>Remove Console Compartment Door Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws.</ptxt>
<figure>
<graphic graphicname="B167529" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the claws and remove the console door.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E0H007X_04_0032" proc-id="RM0550J___0000AC500000">
<ptxt>Remove Console Compartment Door Lock Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws and console door lock.</ptxt>
<figure>
<graphic graphicname="B156557" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
