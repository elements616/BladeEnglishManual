<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002U_S0003" variety="S0003">
<name>Glass &amp; Window</name>
<ttl id="1002U_S0003_741PP_T000S" variety="T000S">
<name>Front Wiper Deicer Switch</name>
<para id="RM000000FPU009X" category="G" type-id="8000T" name-id="7526W-00" from="200612">
<name>On-vehicle Inspection</name>
<subpara id="RM000000FPU009X_01" type-id="01" category="01">
<s-1 id="RM000000FPU009X_01_0001" proc-id="RM0550J___00000M800000">
<ptxt>Inspect Front Wiper Deicer Switch</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect vehicle wire harness</ptxt>
<s3>
<ptxt>Disconnect the front wiper deicer switch connector.</ptxt>
</s3>
<s3>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between each terminal of the vehicle side wire harness connector.</ptxt>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="B141740J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Voltage</title>
<specitem>
<ptxt/>
</specitem>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.62in"/>
<colspec colname="COL3" align="center" colwidth="3.55in"/>
<colspec colname="COL4" colwidth="1.91in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
<ptxt>(Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1(ILL+) - 6(ILL-)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Headlight dimmer switch (light control switch) OFF → TAIL</ptxt>
</entry>
<entry valign="middle">
<ptxt>1V or less → 11 to 14 V</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>8(D) - 5(E)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>4(IG) - 5(E)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>If the result is not as specified, there may be a malfunction on the vehicle side.</ptxt>
</atten3>
</s3>
<s3>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between each terminal of the vehicle side wire harness connector.</ptxt>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<spec>
<title>Resistance</title>
<specitem>
<ptxt/>
</specitem>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.60in"/>
<colspec colname="COL3" align="center" colwidth="3.55in"/>
<colspec colname="COL4" colwidth="1.93in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
<ptxt>(Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>6 (ILL-) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>5 (E) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>If the result is not as specified, there may be a malfunction on the vehicle side.</ptxt>
</atten3>
</s3>
</s2>
<s2>
<ptxt>Operation Check</ptxt>
<s3>
<ptxt>Connect the front wiper deicer switch connector.</ptxt>
</s3>
<s3>
<ptxt>Using SST (Toyota electrical tester), measure the voltage of each terminal of the connector.</ptxt>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="B141741J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Voltage</title>
<specitem>
<ptxt/>
</specitem>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.57in"/>
<colspec colname="COL3" colwidth="3.60in"/>
<colspec colname="COL4" colwidth="1.91in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
<ptxt>(Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>8(D) - 5(E)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON, front wiper deicer switch OFF → ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>1V or less → 11 to 14 V (1V or less after 15 ±3 minutes)</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>4(IG) - 5(E)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON, front wiper deicer switch OFF → ON (when pushed in)</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14 V → 1V or less</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s3>
</s2>
<s2>
<ptxt>Indicator Illumination Inspection</ptxt>
<s3>
<ptxt>Turn IG ON.</ptxt>
</s3>
<s3>
<ptxt>Check that the indicator comes on when the front wiper deicer switch is turned ON, and goes off after 15 ±3 minutes.</ptxt>
</s3>
</s2>
<s2>
<ptxt>Illumination Inspection</ptxt>
<s3>
<ptxt>Turn IG ON.</ptxt>
</s3>
<s3>
<ptxt>Check that the illumination indicator comes on when the headlight dimmer switch is turned from OFF to TAIL.</ptxt>
</s3>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>