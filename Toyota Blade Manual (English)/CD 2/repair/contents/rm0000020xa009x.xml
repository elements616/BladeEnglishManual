<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10024_S000T" variety="S000T">
<name>Starting</name>
<ttl id="10024_S000T_74XTS_T00H2" variety="T00H2">
<name>Starter Assembly (2GR-FE)</name>
<para id="RM0000020XA009X" category="A" type-id="30014" name-id="1626Z-00" from="200708">
<name>Installation</name>
<subpara id="RM0000020XA009X_01" type-id="01" category="01">
<s-1 id="RM0000020XA009X_01_0001" proc-id="RM0550J___0000FIM00000">
<ptxt>Install Starter Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the starter assembly with the 2 bolts (B in the illustration).</ptxt>
<figure>
<graphic graphicname="A179068J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>37</t-value1>
<t-value2>380</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the wire harness clamp bracket with the bolt (A in the illustration).</ptxt>
<torque>
<torqueitem>
<t-value1>8.4</t-value1>
<t-value2>86</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect terminal B with the nut.</ptxt>
<torque>
<torqueitem>
<t-value1>9.8</t-value1>
<t-value2>100</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the terminal cap cover.</ptxt>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020XA009X_01_0017" proc-id="RM0550J___0000DLY00000">
<ptxt>Install Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install battery carrier NO.2 with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000020XA009X_01_0018" proc-id="RM0550J___0000FPD00000">
<ptxt>Install Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery carrier with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A176883" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Attach the 2 clamps to the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Install the battery tray.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020XA009X_01_0019" proc-id="RM0550J___0000DLZ00000">
<ptxt>Install Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery to the vehicle</ptxt>
</s2>
<s2>
<ptxt>Install the insulator.</ptxt>
</s2>
<s2>
<ptxt>Connect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the battery clamp with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>17</t-value1>
<t-value2>173</t-value2>
<ptxt>(Bolt)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the battery positive terminal with the nut.</ptxt>
<torque>
<torqueitem>
<t-value1>13</t-value1>
<t-value2>130</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000020XA009X_01_0020">
<ptxt>Connect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM0000020XA009X_01_0021" proc-id="RM0550J___0000FQ400000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 9 clips.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020XA009X_01_0022" proc-id="RM0550J___0000HJE00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="2">
<ptxt>(see <xref label="Seep01" href="RM000001LYX00ZX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>