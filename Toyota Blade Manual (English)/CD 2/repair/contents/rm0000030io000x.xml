<section id="1002X_S000H" variety="S000H">
<name>Body Exterior</name>
<ttl id="1002X_S000H_7460E_T00BR" variety="T00BR">
<name>Front Bumper Assembly</name>
<para id="RM0000030IO000X" category="A" type-id="30014" name-id="8216F-00" from="200612">
<name>Installation</name>
<subpara id="RM0000030IO000X_01" type-id="01" category="01">
<s-1 id="RM0000030IO000X_01_0001" proc-id="RM0550J___00008EL00000">
<ptxt>Install Front Bumper Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 8 claws (4 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167063" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the front bumper assembly with the 5 clips, 2 bolts and 6 screws.</ptxt>
<figure>
<graphic graphicname="B167062" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the pin hold clip.</ptxt>
<figure>
<graphic graphicname="B167473" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Install the RH side using the same procedure.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IO000X_01_0002" proc-id="RM0550J___00008EM00000">
<ptxt>Install Radiator Grille Protector</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the 2 radiator grille protectors.</ptxt>
<figure>
<graphic graphicname="B167060" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IO000X_01_0016" proc-id="RM0550J___000031W00000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 8 clips.</ptxt>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
