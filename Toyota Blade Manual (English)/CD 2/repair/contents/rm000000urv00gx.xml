<para id="RM000000URV00GX" category="U" type-id="303FJ" name-id="480XX-00" from="200612" to="200912">
<name>ECU Data Monitor/Active Test</name>
<subpara id="RM000000URV00GX_z0" proc-id="RM0550J___00005XQ00000">
<content5 releasenbr="1">
<step1>
<ptxt>ECU Data Monitor</ptxt>
<step2>
<ptxt>Turn IG OFF.</ptxt>
</step2>
<step2>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
</step2>
<step2>
<ptxt>Turn the IG ON, select "Diagnosis" → "Chassis" → "Electric Power Steering" → "ECU Data Monitor" on the display screen of SST (TaSCAN), and check the ECU data monitor.</ptxt>
</step2>
</step1>
<table frame="all">
