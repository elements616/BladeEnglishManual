<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="1001O_S001F" variety="S001F">
<name>Cruise Control</name>
<ttl id="1001O_S001F_74QXH_T00FG" variety="T00FG">
<name>Cruise Control Main Switch</name>
<para id="RM0000028Z5007X" category="A" type-id="80001" name-id="5914A-00" from="200708">
<name>Removal</name>
<subpara id="RM0000028Z5007X_05" type-id="01" category="01">
<s-1 id="RM0000028Z5007X_05_0022" proc-id="RM0550J___0000CCN00000">
<ptxt>Handling and Work Precautions</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM0000028Z5007X_05_0023" proc-id="RM0550J___0000CCO00000">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM0000028Z5007X_05_0024" proc-id="RM0550J___0000CF300000">
<ptxt>Remove Steering Wheel Cover Lower NO.3
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claws and remove steering wheel cover lower NO.3.</ptxt>
<figure>
<graphic graphicname="C148600J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028Z5007X_05_0025" proc-id="RM0550J___0000CF400000">
<ptxt>Remove Steering Wheel Cover Lower NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claws and remove steering wheel cover lower NO.2.</ptxt>
<figure>
<graphic graphicname="C148599J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028Z5007X_05_0026" proc-id="RM0550J___0000CF500000">
<ptxt>Remove Horn Button Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a torx socket wrench (T30), loosen the 2 torx bolts until they turn freely.</ptxt>
<figure>
<graphic graphicname="C172737J01" width="7.106578999in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Using needle-nose pliers, pull out the 2 torx bolts.</ptxt>
</s2>
<s2>
<ptxt>Pull the horn button assembly toward the rear of the vehicle.</ptxt>
<figure>
<graphic graphicname="C172738" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a thin-bladed screwdriver with its tip wrapped with protective tape, release the lock of the airbag connector.</ptxt>
<figure>
<graphic graphicname="C148602J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the airbag connector and horn connector, and remove the horn button assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000028Z5007X_05_0004" proc-id="RM0550J___0000CCM00000">
<ptxt>Remove Cruise Control Main Switch</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="B180370" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 screws.</ptxt>
</s2>
<s2>
<ptxt>Pull out the cruise control main switch in the direction of the arrow shown in the illustration.</ptxt>
<figure>
<graphic graphicname="B180371" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>