<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1000Y_S0012" variety="S0012">
<name>SRS Airbag</name>
<ttl id="1000Y_S0012_744XQ_T009B" variety="T009B">
<name>Horn Button Assembly</name>
<para id="RM000000QFB00MX" category="A" type-id="30014" name-id="554HX-00" from="200612" to="200708">
<name>Installation</name>
<subpara id="RM000000QFB00MX_02" type-id="01" category="01">
<s-1 id="RM000000QFB00MX_02_0018" proc-id="RM0550J___00006KS00000">
<ptxt>Install Horn Button Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C162622" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Connect the horn connector to the horn button assembly.</ptxt>
</s2>
<s2>
<ptxt>Connect the airbag connector to the horn button assembly and lock it securely.</ptxt>
<atten3>
<ptxt>Securely lock the airbag connector.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Using a torx socket wrench (T30), install the horn button assembly to the steering wheel assembly with the 2 torx bolts.</ptxt>
<figure>
<graphic graphicname="C159692J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<torque>
<torqueitem>
<t-value1>8.8</t-value1>
<t-value2>90</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000000QFB00MX_02_0019" proc-id="RM0550J___00006LH00000">
<ptxt>Install Steering Wheel Cover Lower NO.3</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C154144" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Engage the claws and install the steering wheel cover lower No.3.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000QFB00MX_02_0020" proc-id="RM0550J___00006LI00000">
<ptxt>Install Steering Wheel Cover Lower NO.2</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C154145" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Engage the claws and install the steering wheel cover lower No.2.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000QFB00MX_02_0021" proc-id="RM0550J___0000BCZ00000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM000000QFB00MX_02_0022" proc-id="RM0550J___00008BV00000">
<ptxt>Airbag Warning Light Inspection</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM00000050I01GX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000000QFB00MX_02_0023" proc-id="RM0550J___00008BW00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
