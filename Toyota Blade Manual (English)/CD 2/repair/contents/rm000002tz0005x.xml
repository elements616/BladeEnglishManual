<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002O_S0008" variety="S0008">
<name>Engine Immobiliser</name>
<ttl id="1002O_S0008_741KM_T000P" variety="T000P">
<name>Engine Immobiliser System</name>
<para id="RM000002TZ0005X" category="C" type-id="3018W" name-id="580M7-00" from="200612">
<dtccode>B2799</dtccode>
<dtcname>Immobiliser: Separate ECU Communication Malfunction</dtcname>
<subpara id="RM000002TZ0005X_01" type-id="31" category="03" proc-id="RM0550J___0000A5E00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The engine ECU (engine control computer) outputs this code when there is a communication line malfunction with the ID code box (immobiliser code computer) or when the communication ID is different.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry>
<ptxt>DTC No.</ptxt>
</entry>
<entry>
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry>
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B2799</ptxt>
</entry>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Communication malfunction or communication line malfunction between the engine ECU (engine control computer) and ID code box (immobiliser code computer)</ptxt>
</item>
<item>
<ptxt>When the communication ID is different during communication with the ID code box (immobiliser code computer)</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>ID code box (immobiliser code computer)</ptxt>
</item>
<item>
<ptxt>Engine ECU (Engine Control Computer)</ptxt>
</item>
<item>
<ptxt>Wire Harness and Connector</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000002TZ0005X_05" type-id="32" category="03" proc-id="RM0550J___0000A5L00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="B164454J03" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000002TZ0005X_03" type-id="51" category="05" proc-id="RM0550J___0000A5F00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>When replacing the ID code box (immobiliser code computer) and engine ECU (engine control computer), check the precautions. (Refer to the procedure)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000002TZ0005X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002TZ0005X_04_0013" proc-id="RM0550J___0000BDB00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs. (see <xref label="Seep01" href="RM000000MGS00TX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002TZ0005X_04_0014" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0014" proc-id="RM0550J___0000BDC00000">
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs. (see <xref label="Seep01" href="RM000000MGS00TX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>B2799 is not output</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002TZ0005X_04_0015" fin="true">OK</down>
<right ref="RM000002TZ0005X_04_0004" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0015">
<testtitle>Go to Problem Symptom Simulation Method<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0004" proc-id="RM0550J___0000A5H00000">
<testtitle>Re-register Communication ID (Immobiliser Code Computer - Engine Control Computer)</testtitle>
<content6 releasenbr="2">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs. (see <xref label="Seep01" href="RM000000MGS00TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Perform ECU code registration between the ID code box (immobiliser code computer) and engine ECU (engine control computer). (For the procedure, refer to the registration procedure in the reference section)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002TZ0005X_04_0005" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0005" proc-id="RM0550J___0000A5I00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again. (see <xref label="Seep01" href="RM000000MGS00TX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>B2799 is not output</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002TZ0005X_04_0016" fin="true">OK</down>
<right ref="RM000002TZ0005X_04_0017" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0016">
<testtitle>END (Normal after re-registering the identification code)</testtitle>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0017" proc-id="RM0550J___0000C2500000">
<testtitle>Check Connector Engagement</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
<test1>
<ptxt>Check that the connectors of the ID code box (immobiliser code computer) and engine ECU (engine control computer) are each connected correctly.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Each connector is connected correctly.</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002TZ0005X_04_0003" fin="false">OK</down>
<right ref="RM000002TZ0005X_04_0019" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0003" proc-id="RM0550J___0000A5G00000">
<testtitle>Inspect Wire Harness or Connector (Immobiliser Code Computer - Engine Control Computer)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="B157949J03" width="2.775699831in" height="4.7836529in"/>
</figure>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Disconnect connector B of the ID code box (immobiliser code computer) and engine ECU (engine control computer).</ptxt>
</test2>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the vehicle side wire harness connectors.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.99in"/>
<colspec colname="COL2" colwidth="1.15in"/>
<colspec colname="COL3" colwidth="0.99in"/>
<thead>
<row>
<entry>
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry>
<ptxt>Condition</ptxt>
</entry>
<entry>
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>5(EFII) - B10(IMO)</ptxt>
</entry>
<entry>
<ptxt>Always</ptxt>
</entry>
<entry>
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>6(EFIO) - B11(IMI)</ptxt>
</entry>
<entry>
<ptxt>Always</ptxt>
</entry>
<entry>
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.99in"/>
<colspec colname="COL2" colwidth="1.15in"/>
<colspec colname="COL3" colwidth="0.99in"/>
<thead>
<row>
<entry>
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry>
<ptxt>Condition</ptxt>
</entry>
<entry>
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>5 (EFII) - Body ground</ptxt>
</entry>
<entry>
<ptxt>Always</ptxt>
</entry>
<entry>
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>6 (EFIO) - Body ground</ptxt>
</entry>
<entry>
<ptxt>Always</ptxt>
</entry>
<entry>
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.97in"/>
<colspec colname="COL2" colwidth="1.16in"/>
<colspec colname="COL3" colwidth="1.00in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt> B10 (IMO) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>B11 (IMI) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000002TZ0005X_04_0006" fin="false">OK</down>
<right ref="RM000002TZ0005X_04_0010" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0006" proc-id="RM0550J___0000A5J00000">
<testtitle>Replace with Known Good Engine ECU</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace with a known good engine ECU (engine control computer). (see <xref label="Seep01" href="RM000002ADG003X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002TZ0005X_04_0018" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0018" proc-id="RM0550J___0000C2600000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs. (see <xref label="Seep01" href="RM000000MGS00TX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002TZ0005X_04_0007" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0007" proc-id="RM0550J___0000A5K00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again. (see <xref label="Seep01" href="RM000000MGS00TX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>B2799 is not output</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002TZ0005X_04_0008" fin="true">OK</down>
<right ref="RM000002TZ0005X_04_0020" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0008">
<testtitle>END (Engine ECU malfunction)</testtitle>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0019">
<testtitle>Connect the connectors correctly (poor connector engagement)</testtitle>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0010">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000002TZ0005X_04_0020">
<testtitle>Replace ID code box (immobiliser code computer) (for the procedure, refer to the registration method in the reference section)</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>