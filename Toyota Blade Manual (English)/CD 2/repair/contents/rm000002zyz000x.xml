<para id="RM000002ZYZ000X" category="C" type-id="8031E" name-id="603KX-00" from="200612">
<dtccode>B2451</dtccode>
<dtcname>Variation writing not performed</dtcname>
<subpara id="RM000002ZYZ000X_01" type-id="33" category="03" proc-id="RM0550J___000066G00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the vehicle variation information has not been written to the headlight leveling computer assembly.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="3.43in"/>
<colspec colname="COL3" colwidth="2.28in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B2451</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Variation writing not performed</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Headlight Leveling Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000002ZYZ000X_02" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000002ZYZ000X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002ZYZ000X_03_0001" proc-id="RM0550J___000066H00000">
<testtitle>Replace Headlight Leveling Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace with a headlight leveling computer assembly to which variation information has been written. (see <xref label="Seep01" href="RM000001X8N001X"/>)</ptxt>
<atten4>
<ptxt>Variation information is written at the factory.</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="RM000002ZYZ000X_03_0002" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002ZYZ000X_03_0002" proc-id="RM0550J___000066I00000">
<testtitle>Initialize Headlight Leveling Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Initialize the headlight leveling computer assembly. (see <xref label="Seep01" href="RM0000030GL000X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002ZYZ000X_03_0003" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002ZYZ000X_03_0003">
<testtitle>Complete</testtitle>
</testgrp>
</subpara>
</para>
