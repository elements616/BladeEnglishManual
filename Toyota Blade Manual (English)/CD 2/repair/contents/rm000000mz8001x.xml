<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B7_T003H" variety="T003H">
<name>Television Camera Assembly</name>
<para id="RM000000MZ8001X" category="A" type-id="80001" name-id="672EO-00" from="200612">
<name>Removal</name>
<subpara id="RM000000MZ8001X_01" type-id="01" category="01">
<s-1 id="RM000000MZ8001X_01_0006" proc-id="RM0550J___00009UW00000">
<ptxt>Remove Back Door Trim Panel Assembly Upper
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 clips and 4 claws, and remove the back door trim panel assembly upper.</ptxt>
<figure>
<graphic graphicname="B155566" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000000MZ8001X_01_0007" proc-id="RM0550J___00009UX00000">
<ptxt>Remove Back Door Side Garnish LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the pin of the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B163625" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the clips and claws, and remove the back door side garnish LH together with the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B155568" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 claws and remove the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B155571" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000000MZ8001X_01_0008" proc-id="RM0550J___00009UY00000">
<ptxt>Remove Back Door Side Garnish RH
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove the RH side using the same procedure as for the LH side.</ptxt>
</atten4>
</content1></s-1>
<s-1 id="RM000000MZ8001X_01_0009" proc-id="RM0550J___00009UZ00000">
<ptxt>Remove Back Door Inside Handle
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="B232579" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Insert a moulding remover at the position shown in the illustration, disengage the 4 claws as shown in the illustration, and remove the back door inside handle.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000MZ8001X_01_0010" proc-id="RM0550J___00009V000000">
<ptxt>Remove Back Door Trim Panel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove clip (A).</ptxt>
<figure>
<graphic graphicname="B155573J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 11 clips and remove the back door trim panel assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000MZ8001X_01_0011" proc-id="RM0550J___00008HB00000">
<ptxt>Remove Back Door Outside Garnish Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connectors.</ptxt>
<figure>
<graphic graphicname="B167185" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 4 nuts and the back door outside garnish.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000MZ8001X_01_0004" proc-id="RM0550J___00001I800000">
<ptxt>Remove Television Camera Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws and the television camera assembly from the back door outside garnish assembly.</ptxt>
<figure>
<graphic graphicname="E147027" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>