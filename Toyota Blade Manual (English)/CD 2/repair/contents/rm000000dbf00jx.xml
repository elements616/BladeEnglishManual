<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "Active Test" screen and perform the Active Test.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Buzzer sounds</ptxt>
</specitem>
