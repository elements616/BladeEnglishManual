<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000C_S000O" variety="S000O">
<name>Cooling</name>
<ttl id="1000C_S000O_74Z18_T00IH" variety="T00IH">
<name>Cooling Fan Computer (2GR-FE)</name>
<para id="RM000002X11004X" category="A" type-id="80001" name-id="121L2-00" from="200708">
<name>Removal</name>
<subpara id="RM000002X11004X_01" type-id="01" category="01">
<s-1 id="RM000002X11004X_01_0007" proc-id="RM0550J___0000DHQ00000">
<ptxt>Disconnect Battery Negative Terminal
</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000000D9902LX"/>)</ptxt>
</content1></s-1>
<s-1 id="RM000002X11004X_01_0006" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002X11004X_01_0003" proc-id="RM0550J___0000HBB00000">
<ptxt>Remove Cooling Fan Computer</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the cooling fan computer connector.</ptxt>
<figure>
<graphic graphicname="A176814" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 screws and disconnect the 2 cooling fan motor connectors, then remove the cooling fan computer.</ptxt>
<figure>
<graphic graphicname="A176818" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>