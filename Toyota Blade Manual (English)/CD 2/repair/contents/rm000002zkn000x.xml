<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1002J_S000U" variety="S000U">
<name>Brake Control</name>
<ttl id="1002J_S000U_744TG_T0089" variety="T0089">
<name>ABS with EBD &amp; TRC &amp; VSC &amp; BA System</name>
<para id="RM000002ZKN000X" category="J" type-id="300OB" name-id="442P2-00" from="200612" to="200912">
<dtccode/>
<dtcname>VSC warning is displayed, but no DTC is output</dtcname>
<subpara id="RM000002ZKN000X_01" type-id="33" category="03" proc-id="RM0550J___00007UU00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This describes troubleshooting when the VSC warning is displayed although the DTCs are normal.</ptxt>
<ptxt>The skid control computer controls the VSC warning in the combination meter assembly via CAN communication.</ptxt>
</content5>
</subpara>
<subpara id="RM000002ZKN000X_02" type-id="32" category="03" proc-id="RM0550J___00007UV00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C154594J01" width="7.106578999in" height="6.791605969in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000002ZKN000X_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000002ZKN000X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002ZKN000X_04_0001" proc-id="RM0550J___00007UW00000">
<testtitle>Inspect Connection Condition of Each Part</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Lightly shake the skid control computer connector and wire harness up and down and side to side, and check the VSC warning display condition on the combination meter assembly.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>VSC warning display does not change</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002ZKN000X_04_0002" fin="false">OK</down>
<right ref="RM000002ZKN000X_04_0006" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002ZKN000X_04_0002" proc-id="RM0550J___00007UX00000">
<testtitle>Inspect Control System CAN Communication System</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using the SST (TaSCAN), inspect the DTCs and check that there is no malfunction in the CAN communication system. (see <xref label="Seep01" href="RM000001R4W009X"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Normal DTC</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002ZKN000X_04_0003" fin="false">OK</down>
<right ref="RM000002ZKN000X_04_0007" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002ZKN000X_04_0003" proc-id="RM0550J___00007UY00000">
<testtitle>Inspect ABS &amp; Traction Actuator Assembly (IG1, GND1)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Turn the IG OFF and disconnect the brake actuator assembly connector.</ptxt>
<figure>
<graphic graphicname="C146352J14" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using the SST (Toyota electrical tester), measure the resistance and voltage between the wire harness side connector of the brake actuator assembly and body ground.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.14in"/>
<colspec colname="COL2" colwidth="0.88in"/>
<colspec colname="COL3" colwidth="1.11in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1 (GND1) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.13in"/>
<colspec colname="COL2" colwidth="0.88in"/>
<colspec colname="COL3" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>34 (IG1) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002ZKN000X_04_0004" fin="false">OK</down>
<right ref="RM000002ZKN000X_04_0008" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002ZKN000X_04_0004" proc-id="RM0550J___00007UZ00000">
<scantool type="8"/>
<testtitle>Perform Active Test (VSC Light)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), perform the VSC warning active test. (see <xref label="Seep01" href="RM000000602011X"/>)</ptxt>
<table frame="all">
<title>Active Test</title>
<tgroup cols="3">
<colspec colname="col1" colwidth="1.93in"/>
<colspec colname="col2" colwidth="2.79in"/>
<colspec colname="col3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Test Details</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Restrictions</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>VSC Light</ptxt>
</entry>
<entry valign="middle">
<ptxt>VSC warning display ON←→OFF</ptxt>
</entry>
<entry valign="middle">
<ptxt>Possible at SPD = 0km/h</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>The VSC warning switches between not displayed←→displayed according to the operation</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002ZKN000X_04_0009" fin="true">OK</down>
<right ref="RM000002ZKN000X_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002ZKN000X_04_0005">
<testtitle>Go to Meter &amp; Gauge System<xref label="Seep01" href="RM000001L5T00JX"/>
</testtitle>
</testgrp>
<testgrp id="RM000002ZKN000X_04_0006">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000002ZKN000X_04_0007">
<testtitle>Go to Control System CAN Communication System<xref label="Seep01" href="RM000001R4W009X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002ZKN000X_04_0008">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000002ZKN000X_04_0009">
<testtitle>Replace ABS &amp; Traction Actuator Assembly<xref label="Seep01" href="RM00000304V000X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>