<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000002BO9007X" category="C" type-id="3007R" name-id="261I3-00" from="200708">
<dtccode>P0711/38</dtccode>
<dtcname>Fluid Temperature Sensor Circuit (Out of Range)</dtcname>
<subpara id="RM000002BO9007X_01" type-id="33" category="03" proc-id="RM0550J___0000FR600000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The fluid temperature sensor installed in the valve body detects the fluid temperature in the transmission hydraulic control circuit and inputs a signal corresponding to the fluid temperature to the transmission control computer.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.81in"/>
<colspec colname="COL2" colwidth="3.08in"/>
<colspec colname="COL3" colwidth="3.19in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0711/38</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>When the engine is started with intake air temperature and engine coolant temperature at 10°C or higher, and 16 min 40 sec have elapsed or the vehicle has been driven 8km or more</ptxt>
</item>
<item>
<ptxt>ATF temperature does not reach 20°C or higher</ptxt>
</item>
<item>
<ptxt>3 seconds or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Automatic Transmission Temperature Sensor</ptxt>
</item>
<item>
<ptxt>ATF Level</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
<item>
<ptxt>Transmission wire</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000002BO9007X_02" type-id="32" category="03" proc-id="RM0550J___0000FR700000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C173974J02" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000002BO9007X_03" type-id="51" category="05" proc-id="RM0550J___0000FR800000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Using SST (TaSCAN), read the Freeze Frame Data. Freeze Frame Data records the engine and vehicle conditions when a malfunction occurred, and this information is useful for troubleshooting and malfunction reproduction tests.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM000002BO9007X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002BO9007X_04_0004" proc-id="RM0550J___0000FR900000">
<scantool type="1"/>
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the [Diagnosis Menu/ECT] screen, and select [DTC Freeze Data].</ptxt>
</test1>
<test1>
<ptxt>Check the DTCs and freeze frame data.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.08in"/>
<colspec colname="COL2" colwidth="1.05in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Only P0711 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>DTCs other than P0711 are output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002BO9007X_04_0006" fin="false">A</down>
<right ref="RM000002BO9007X_04_0007" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000002BO9007X_04_0006" proc-id="RM0550J___0000FRB00000">
<testtitle>Inspect Automatic Transaxle Fluid Level</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check the automatic transaxle fluid level.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Fluid level is normal</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002BO9007X_04_0014" fin="false">OK</down>
<right ref="RM000002BO9007X_04_0013" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002BO9007X_04_0014" proc-id="RM0550J___0000FRC00000">
<testtitle>Inspect Transmission Wire</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D702RX"/></ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Remove the transmission control computer. (see <xref label="Seep02" href="RM0000024M8003X"/>)</ptxt>
</test1>
<test1>
<ptxt>Check that the connector cases and terminals of the transmission control computer and transmission wire are not deformed or damaged.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<figure>
<graphic graphicname="C133212J13" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.88in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<colspec colname="COL3" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>18(THO1) - 17(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Fluid temperature 10°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>5 to 8kΩ</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>18(THO1) - 17(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Fluid temperature 110°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>0.22 to 0.28kΩ</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.86in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<colspec colname="COL3" colwidth="1.14in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>18 (THO1) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002BO9007X_04_0011" fin="false">OK</down>
<right ref="RM000002BO9007X_04_0005" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000002BO9007X_04_0011" proc-id="RM0550J___0000HC800000">
<testtitle>Replace Transmission Control Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the transmission control computer assembly. (see <xref label="Seep01" href="RM0000024M8003X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002BO9007X_04_0016" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002BO9007X_04_0016">
<testtitle>A/T Unit Compensation<xref label="Seep01" href="RM000000OLY013X"/>
</testtitle>
</testgrp>
