<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_747JJ_T00DV" variety="T00DV">
<name>Cam Position Sensor (2AZ-FE)</name>
<para id="RM00000296K005X" category="A" type-id="30014" name-id="065B2-00" from="200612">
<name>Installation</name>
<subpara id="RM00000296K005X_01" type-id="01" category="01">
<s-1 id="RM00000296K005X_01_0001" proc-id="RM0550J___0000BX600000">
<ptxt>Install Camshaft Position Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply a light coat of engine oil to the O-ring.</ptxt>
<figure>
<graphic graphicname="A095434" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the camshaft position sensor with the bolt.</ptxt>
<figure>
<graphic graphicname="A124557" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>9.0</t-value1>
<t-value2>92</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>Install it to the cylinder head so that the O-ring is not cut or pinched.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Connect the cam position sensor connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000296K005X_01_0002" proc-id="RM0550J___00002ZF00000">
<ptxt>Install Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the hinge portion first, then install the air cleaner cap with the 3 clamps.</ptxt>
</s2>
<s2>
<ptxt>Install air cleaner hose No.1 to the throttle body assembly and release the lock of air cleaner hose clamp No.1.</ptxt>
<figure>
<graphic graphicname="A162892" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Align the triangular projection of air cleaner hose No.1 with the throttle body bolt on the right front side of the vehicle.</ptxt>
</item>
<item>
<ptxt>Align the position of air cleaner hose clamp No.1 using the triangular projection of air cleaner hose No.1 as a reference.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Connect the clamp and intake air flow meter connector.</ptxt>
<figure>
<graphic graphicname="A162887" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the fuel vapor feed hose and fuel vapor feed hose No.2 to vacuum switching valve assembly No.1.</ptxt>
<figure>
<graphic graphicname="A163392" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the clamp and vacuum switching valve connector.  </ptxt>
</s2>
<s2>
<ptxt>Connect the ventilation hose.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000296K005X_01_0017" proc-id="RM0550J___00004E000000">
<ptxt>Install Engine Cover Sub-assembly NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine cover assembly No.1 with the 2 nuts.</ptxt>
<figure>
<graphic graphicname="A159817" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>9.0</t-value1>
<t-value2>92</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM00000296K005X_01_0014" proc-id="RM0550J___0000BX900000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM00000296K005X_01_0013" proc-id="RM0550J___0000BX800000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>