<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002W_S001A" variety="S001A">
<name>Instrument Panel</name>
<ttl id="1002W_S001A_746H6_T00C6" variety="T00C6">
<name>Console Box Assembly</name>
<para id="RM000000E0G00FX" category="A" type-id="80001" name-id="780CS-01" from="200912">
<name>Removal</name>
<subpara id="RM000000E0G00FX_05" type-id="01" category="01">
<s-1 id="RM000000E0G00FX_05_0029" proc-id="RM0550J___0000ABV00001">
<ptxt>Remove Box Panel NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply protective tape to the positions shown in the illustration.</ptxt>
<figure>
<graphic graphicname="B236930J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Apply protective tape on the RH side in the same way.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Using a moulding remover, disengage the 4 clips.</ptxt>
</s2>
<s2>
<ptxt>Using a moulding remover, disengage the 2 claws.</ptxt>
<figure>
<graphic graphicname="B236931" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect each connector and remove box panel No.2.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E0G00FX_05_0031" proc-id="RM0550J___0000ABX00001">
<ptxt>Remove Console Box Cover Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 clips and 2 guides, and remove the console box cover rear.</ptxt>
<figure>
<graphic graphicname="B236966" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E0G00FX_05_0034" proc-id="RM0550J___0000IM600000">
<ptxt>Remove Console Box Carpet</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the console box carpet.</ptxt>
<figure>
<graphic graphicname="B236967" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E0G00FX_05_0033" proc-id="RM0550J___0000ABZ00001">
<ptxt>Remove Console Box Assembly Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 2 screws.</ptxt>
<figure>
<graphic graphicname="B236968" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 4 guides and remove the console box assembly rear.</ptxt>
<figure>
<graphic graphicname="B236969" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>