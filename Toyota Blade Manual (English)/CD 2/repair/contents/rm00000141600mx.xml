<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_746W2_T00DG" variety="T00DG">
<name>Back Guide Monitor System</name>
<para id="RM00000141600MX" category="J" type-id="800YH" name-id="672EJ-00" from="200612" to="200912">
<dtccode/>
<dtcname>Expected course lines are not displayed and "Guide Unavailable" is displayed</dtcname>
<subpara id="RM00000141600MX_08" type-id="31" category="03" proc-id="RM0550J___0000BCR00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The steering angle detected by the steering sensor is input to the navigation receiver assembly via CAN communication.</ptxt>
</content5>
</subpara>
<subpara id="RM00000141600MX_09" type-id="32" category="03" proc-id="RM0550J___0000BCS00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E144416J02" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM00000141600MX_10" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM00000141600MX_11" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000141600MX_11_0013" proc-id="RM0550J___0000BCT00000">
<testtitle>Service Inspection (Steering Sensor)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Service Inspection</ptxt>
<test2>
<ptxt>Start diagnosis, and check whether "DTC 5C-41, 42" is displayed in the individual diagnosis. (see <xref label="Seep01" href="RM0000006XI02BX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>"DTC 5C-41, 42" is displayed</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>DTC 5C - 42 is always output with the IG at ACC, so always perform the work with the IG ON. Also, if no DTC is output, turn the steering wheel from lock to lock several times and check again.</ptxt>
</atten4>
<table>
<title>Result</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"DTC 5C - 42" is displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"DTC 5C - 41" is displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000141600MX_11_0014" fin="false">A</down>
<right ref="RM00000141600MX_11_0015" fin="true">B</right>
<right ref="RM00000141600MX_11_0016" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM00000141600MX_11_0014" proc-id="RM0550J___0000BCU00000">
<testtitle>Inspect Wire Harness or Connector (Steering Sensor Power Source)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Resistance Inspection</ptxt>
<figure>
<graphic graphicname="E141969J03" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Using SST (Toyota electrical tester), with the vehicle side wire harness connector disconnected, measure the resistance between the terminals from the back side of the connector.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.00in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<colspec colname="COL3" colwidth="1.00in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1 (ESS) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<test1>
<ptxt>Voltage Inspection</ptxt>
<figure>
<graphic graphicname="E141969J04" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Using SST (Toyota electrical tester), with the vehicle side wire harness connector disconnected, measure the voltage between each terminal from the back of the connector.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<colspec colname="COL3" colwidth="1.00in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>4(IG) - 1(ESS)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>5(BAT) - 1(ESS)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000141600MX_11_0015" fin="true">OK</down>
<right ref="RM00000141600MX_11_0017" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000141600MX_11_0015">
<testtitle>Replace Steering Sensor<xref label="Seep01" href="RM000000QFH008X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000141600MX_11_0016">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000141600MX_11_0017">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
