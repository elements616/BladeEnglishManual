<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B9_T003J" variety="T003J">
<name>Intelligent Parking Assist System</name>
<para id="RM0000028GX006X" category="C" type-id="8039J" name-id="672BR-00" from="200612" to="200912">
<dtccode>C1695</dtccode>
<dtcname>Height Sensor 0-point Not Written</dtcname>
<dtccode>C1696</dtccode>
<dtcname>G Sensor 0-point Not Written</dtcname>
<subpara id="RM0000028GX006X_04" type-id="33" category="03" proc-id="RM0550J___0000A8100000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller self-diagnosis determines that vehicle height sensor 0 point writing and G sensor 0 point writing have not been performed (height control sensor vehicle height difference setting and G sensor 0 point writing not performed).</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1695</ptxt>
</entry>
<entry valign="middle">
<ptxt>Height Sensor 0-point Not Written</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Height Control Sensor Vehicle Height Difference Setting / G Sensor 0-point Writing</ptxt>
</item>
<item>
<ptxt>Television Camera Controller</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C1696</ptxt>
</entry>
<entry valign="middle">
<ptxt>G Sensor 0-point Not Written</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Height Control Sensor Vehicle Height Difference Setting / G Sensor 0-point Writing</ptxt>
</item>
<item>
<ptxt>Television Camera Controller</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000028GX006X_05" type-id="51" category="05" proc-id="RM0550J___0000A8200000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration settings for other systems may be necessary in addition to the intelligent parking assist system. (see <xref label="Seep02" href="RM00000304S000X"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM0000028GX006X_06" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000028GX006X_06_0007" proc-id="RM0550J___0000A8300000">
<testtitle>Height Control Sensor Vehicle Height Difference Setting and G Sensor 0-point Writing</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Perform height control sensor vehicle height difference setting and G sensor 0 point writing. (see <xref label="Seep01" href="RM00000304S000X_02_0001"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM0000028GX006X_06_0008" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000028GX006X_06_0008" proc-id="RM0550J___0000A8400000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again, and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>"C1695" or "C1696" is output even after performing height control sensor vehicle height difference setting and G sensor 0 point writing 3 times</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>Be sure to perform height control sensor setting and G sensor 0 point writing 3 times.</ptxt>
</atten4>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000028GX006X_06_0009" fin="true">A</down>
<right ref="RM0000028GX006X_06_0010" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000028GX006X_06_0009">
<testtitle>No malfunction (returned to normal by initialization)</testtitle>
</testgrp>
<testgrp id="RM0000028GX006X_06_0010">
<testtitle>Replace Television Camera Controller<xref label="Seep01" href="RM000000MZ5001X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>