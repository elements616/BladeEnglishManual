<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10024_S000T" variety="S000T">
<name>Starting</name>
<ttl id="10024_S000T_744HU_T0086" variety="T0086">
<name>Engine Switch</name>
<para id="RM0000021UR004X" category="A" type-id="30014" name-id="161WN-00" from="200612">
<name>Installation</name>
<subpara id="RM0000021UR004X_01" type-id="01" category="01">
<s-1 id="RM0000021UR004X_01_0001" proc-id="RM0550J___00004D000000">
<ptxt>Install Engine Switch</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine switch to the switch hole base No.1.</ptxt>
<figure>
<graphic graphicname="A156486J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten4>
<ptxt>Check that the clips are fully engaged.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM0000021UR004X_01_0031" proc-id="RM0550J___00009P300000">
<ptxt>Install Switch Hole Base NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
<s2>
<ptxt>Engage the 2 clips and 2 claws, and install the switch hole base No.1.</ptxt>
<figure>
<graphic graphicname="B156570" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0053" proc-id="RM0550J___00006P100000">
<ptxt>Install Instrument Panel Airbag Assembly Lower NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector to the instrument lower airbag No.1.</ptxt>
<figure>
<graphic graphicname="C154076" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Securely lock the connector.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the instrument lower airbag No.1 with the 6 claws and 2 guides.</ptxt>
<figure>
<graphic graphicname="C163136J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the instrument lower airbag No.1 with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="C163133" width="2.775699831in" height="3.779676365in"/>
</figure>
<torque>
<torqueitem>
<t-value1>10</t-value1>
<t-value2>102</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0062" proc-id="RM0550J___0000BH000000">
<ptxt>Install Instrument Panel Under Cover Sub-assembly NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 2 screws and claws, and install instrument panel under cover NO.1.</ptxt>
<figure>
<graphic graphicname="B167525" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0055" proc-id="RM0550J___00005VX00000">
<ptxt>Install Steering Column Cover
</ptxt>
<content1 releasenbr="1">
<atten3>
<ptxt>If the installation procedure is incorrect, gaps may form in the column cover.</ptxt>
</atten3>
<s2>
<ptxt>Engage the 2 claws and pins, and install the steering column cover (upper side).</ptxt>
<figure>
<graphic graphicname="C160714" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 claws and install the steering column cover (lower side).</ptxt>
<figure>
<graphic graphicname="C160713" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 4 claws.</ptxt>
<figure>
<graphic graphicname="C160711" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the claws.</ptxt>
<figure>
<graphic graphicname="C161537" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<ptxt>Push the bottom surface of the steering column cover (lower side) to securely engage the claws.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0056" proc-id="RM0550J___00005VZ00000">
<ptxt>Install Steering Wheel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Align the matchmarks and install the steering wheel assembly to the steering column assembly.  </ptxt>
<figure>
<graphic graphicname="C160709J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the nut.  </ptxt>
<torque>
<torqueitem>
<t-value1>50</t-value1>
<t-value2>510</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect each connector to the spiral cable.  </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0057" proc-id="RM0550J___00006KS00000">
<ptxt>Install Horn Button Assembly
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C162622" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Connect the horn connector to the horn button assembly.</ptxt>
</s2>
<s2>
<ptxt>Connect the airbag connector to the horn button assembly and lock it securely.</ptxt>
<atten3>
<ptxt>Securely lock the airbag connector.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Using a torx socket wrench (T30), install the horn button assembly to the steering wheel assembly with the 2 torx bolts.</ptxt>
<figure>
<graphic graphicname="C159692J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<torque>
<torqueitem>
<t-value1>8.8</t-value1>
<t-value2>90</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0058" proc-id="RM0550J___00006LH00000">
<ptxt>Install Steering Wheel Cover Lower NO.3
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C154144" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Engage the claws and install the steering wheel cover lower No.3.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0059" proc-id="RM0550J___00006LI00000">
<ptxt>Install Steering Wheel Cover Lower NO.2
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C154145" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Engage the claws and install the steering wheel cover lower No.2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0032" proc-id="RM0550J___00009P400000">
<ptxt>Install Instrument Panel Finish Panel Lower NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Push in the direction of the arrow shown in the illustration to engage the 2 clips and guide.</ptxt>
<figure>
<graphic graphicname="B162990J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install instrument panel finish panel lower No.2 with the 2 screws &lt;C&gt;.</ptxt>
<figure>
<graphic graphicname="B151158" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0033" proc-id="RM0550J___00009P500000">
<ptxt>Install Instrument Panel Finish Panel Lower NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Push in the direction of the arrow shown in the illustration to engage the 2 clips and guide.</ptxt>
<figure>
<graphic graphicname="B162989J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 4 claws and 2 guides.</ptxt>
<figure>
<graphic graphicname="B151154J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Install instrument panel finish panel lower No.1 with the 2 screws &lt;C&gt;.</ptxt>
<figure>
<graphic graphicname="B151152" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0034" proc-id="RM0550J___00009P600000">
<ptxt>Install Instrument Panel Under Tray
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the instrument panel under tray.</ptxt>
<figure>
<graphic graphicname="B162993" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0064">
<ptxt>Install Box Bottom Mat</ptxt>
</s-1>
<s-1 id="RM0000021UR004X_01_0035" proc-id="RM0550J___00009PA00000">
<ptxt>Install Console Box Insert Front NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert the guide.</ptxt>
<figure>
<graphic graphicname="B151144J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 3 claws and install the console box insert.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0038" proc-id="RM0550J___00009P700000">
<ptxt>Install Console Box Insert
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert the guide.</ptxt>
<figure>
<graphic graphicname="B151140J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 3 claws to install console box insert front No.2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0040" proc-id="RM0550J___0000ACF00000">
<ptxt>Install Console Box Assembly Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws.</ptxt>
<figure>
<graphic graphicname="B167310" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the console box assembly RR with the 4 bolts and 2 screws.</ptxt>
<figure>
<graphic graphicname="B167309" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0042" proc-id="RM0550J___0000ACH00000">
<ptxt>Install Console Box Carpet
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the console box carpet.</ptxt>
<figure>
<graphic graphicname="B156554" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0043" proc-id="RM0550J___00009MS00000">
<ptxt>Install Instrument Panel Finish Panel Lower Center
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 6 clips and 4 claws.</ptxt>
<figure>
<graphic graphicname="B164922" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Install the instrument panel finish panel LWR CTR with the 2 screws &lt;C&gt;.</ptxt>
<figure>
<graphic graphicname="B164921" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0044" proc-id="RM0550J___00007D000000">
<ptxt>Install Position Indicator Housing Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector.</ptxt>
<figure>
<graphic graphicname="C159976" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 7 claws and install the position indicator housing assembly.</ptxt>
<figure>
<graphic graphicname="C161665" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<ptxt>Securely engage the claws.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0045" proc-id="RM0550J___0000ACI00000">
<ptxt>Install Console Box Cover Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 4 clips to install the console box rear cover.</ptxt>
<figure>
<graphic graphicname="B162870" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0046" proc-id="RM0550J___00007D200000">
<ptxt>Install Shift Lever Knob
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Turn the shift lever knob in the direction of the arrow shown in the illustration to install it.</ptxt>
<figure>
<graphic graphicname="C161666" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0047" proc-id="RM0550J___00009N200000">
<ptxt>Install Instrument Panel Finish Panel End RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and install the instrument panel finish panel end RH.</ptxt>
<figure>
<graphic graphicname="B169227" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0048" proc-id="RM0550J___00009N300000">
<ptxt>Install Instrument Panel Finish Panel End LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and install the instrument panel finish panel end LH.</ptxt>
<figure>
<graphic graphicname="B169226" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0063" proc-id="RM0550J___0000A2400000">
<ptxt>Install Instrument Cluster Finish Panel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 2 claws and 9 clips, and install the instrument cluster finish panel.</ptxt>
<figure>
<graphic graphicname="B167302" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the protective tape that was applied.</ptxt>
<figure>
<graphic graphicname="B167301" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0050" proc-id="RM0550J___00007LM00000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM0000021UR004X_01_0061" proc-id="RM0550J___00008CC00000">
<ptxt>Airbag Warning Light Inspection
</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM00000050I01GX"/>)</ptxt>
</content1></s-1>
<s-1 id="RM0000021UR004X_01_0051" proc-id="RM0550J___0000BUF00000">
<ptxt>Initialization When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="2">
<ptxt>(see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
