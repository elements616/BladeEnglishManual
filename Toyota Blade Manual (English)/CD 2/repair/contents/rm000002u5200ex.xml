<colspec colname="COL1" colwidth="2.29in"/>
<colspec colname="COL2" colwidth="1.84in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Active Test (Electric Fan)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Electric Fan Condition</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>Rotates</ptxt>
</entry>
