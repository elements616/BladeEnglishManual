</test1>
<test1>
<ptxt>Turn the IG ON with the engine stopped.</ptxt>
</test1>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>The cooling fan rotates.</ptxt>
</specitem>
</spec>
