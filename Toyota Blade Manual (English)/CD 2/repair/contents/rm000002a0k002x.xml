<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002X_S000H" variety="S000H">
<name>Body Exterior</name>
<ttl id="1002X_S000H_746FD_T00BS" variety="T00BS">
<name>Rear Spoiler</name>
<para id="RM000002A0K002X" category="A" type-id="80001" name-id="82166-00" from="200612">
<name>Removal</name>
<subpara id="RM000002A0K002X_02" type-id="01" category="01">
<s-1 id="RM000002A0K002X_02_0008" proc-id="RM0550J___00009UW00000">
<ptxt>Remove Back Door Trim Panel Assembly Upper
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 clips and 4 claws, and remove the back door trim panel assembly upper.</ptxt>
<figure>
<graphic graphicname="B155566" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002A0K002X_02_0010" proc-id="RM0550J___00008FG00000">
<ptxt>Remove Rear Spoiler Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 plug hole covers.</ptxt>
<figure>
<graphic graphicname="B167178" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Remove the 4 nuts.</ptxt>
</s2>
<s2>
<ptxt>Disengage the clips and remove the rear spoiler assembly.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>