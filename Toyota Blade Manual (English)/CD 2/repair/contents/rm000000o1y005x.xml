<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B9_T003J" variety="T003J">
<name>Intelligent Parking Assist System</name>
<para id="RM000000O1Y005X" category="C" type-id="8039G" name-id="672BO-00" from="200612" to="200912">
<dtccode>C1662</dtccode>
<dtcname>Function Stopped (High Temperature)</dtcname>
<subpara id="RM000000O1Y005X_05" type-id="33" category="03" proc-id="RM0550J___0000A7K00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller's self-diagnosis determines that the ambient temperature has risen to a level that impairs ECU function.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1662</ptxt>
</entry>
<entry valign="middle">
<ptxt>Ambient Temperature Rise Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Television Camera Controller</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000O1Y005X_06" type-id="51" category="05" proc-id="RM0550J___0000A7L00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration settings for other systems may be necessary in addition to the intelligent parking assist system. (see <xref label="Seep02" href="RM00000304S000X"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000000O1Y005X_07" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000O1Y005X_07_0004" proc-id="RM0550J___0000A7M00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
<test2>
<ptxt>Keep the vehicle interior at normal temperature and leave the vehicle for a while.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>After confirming that the area around the television camera controller is at normal temperature, start the engine, check the DTCs again and proceed to the destination below.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"C1662" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000000O1Y005X_07_0006" fin="true">A</down>
<right ref="RM000000O1Y005X_07_0005" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000O1Y005X_07_0005">
<testtitle>Replace Television Camera Controller<xref label="Seep01" href="RM000000MZ5001X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000O1Y005X_07_0006">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>