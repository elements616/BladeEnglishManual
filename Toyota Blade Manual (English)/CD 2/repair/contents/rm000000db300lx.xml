<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1002M_S001G" variety="S001G">
<name>Pre-crash Safety</name>
<ttl id="1002M_S001G_74WT7_T00FP" variety="T00FP">
<name>Pre-crash Safety System</name>
<para id="RM000000DB300LX" category="C" type-id="80073" name-id="540J9-00" from="200708">
<dtccode>B2002/21</dtccode>
<dtcname>Driver Side Belt Motor Circuit Open</dtcname>
<dtccode>B2007/21</dtccode>
<dtcname>Front Passenger Side Belt Motor Circuit Open</dtcname>
<subpara id="RM000000DB300LX_01" type-id="31" category="03" proc-id="RM0550J___0000CTT00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The seat belt control computer receives information from the distance control computer assembly and ABS &amp; traction actuator assembly via CAN communication, and retracts the seat belt using the motor in the front seat outer belt assembly RH or LH.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B2002/21</ptxt>
</entry>
<entry valign="middle">
<ptxt>Open in the seat belt motor RH side circuit continues for 1 seconds or more</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Front Seat Outer Belt Assembly RH</ptxt>
</item>
<item>
<ptxt>Wire harness and connector (seat belt control computer - front seat outer belt assembly RH)</ptxt>
</item>
<item>
<ptxt>Seat Belt Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B2007/21</ptxt>
</entry>
<entry valign="middle">
<ptxt>Open in the seat belt motor LH side circuit continues for 1 seconds or more</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Front Seat Outer Belt Assembly LH</ptxt>
</item>
<item>
<ptxt>Wire harness and connector (seat belt control computer - front seat outer belt assembly LH)</ptxt>
</item>
<item>
<ptxt>Seat Belt Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000DB300LX_02" type-id="32" category="03" proc-id="RM0550J___0000CTU00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E143516J01" width="7.106578999in" height="2.775699831in"/>
</figure>
<figure>
<graphic graphicname="E143516J02" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000DB300LX_03" type-id="51" category="05" proc-id="RM0550J___0000CTV00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten2>
<ptxt>The front seat outer belt assembly has a built-in pretensioner, and incorrect inspection such as checking the wrong connector may activate the pretensioner, so be very careful to follow the correct inspection procedure.</ptxt>
</atten2>
</content5>
</subpara>
<subpara id="RM000000DB300LX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DB300LX_04_0001" proc-id="RM0550J___0000CTW00000">
<testtitle>Inspect Seat Belt Control Computer</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect seat belt control computer connector A.</ptxt>
<figure>
<graphic graphicname="E157076J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of seat belt control computer vehicle side wire harness connector A.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COLSPEC0" colwidth="1.03in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A1(MOR-) - A2(MOR+)</ptxt>
</entry>
<entry morerows="1" valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry morerows="1" valign="middle">
<ptxt>0.2 to below 100 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>A3(MOL+) - A4(MOL-)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten2>
<ptxt>Do not inspect the wrong connector.</ptxt>
</atten2>
</test1>
</content6>
<res>
<down ref="RM000000DB300LX_04_0003" fin="true">OK</down>
<right ref="RM000000DB300LX_04_0002" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000000DB300LX_04_0002" proc-id="RM0550J___0000CTX00000">
<testtitle>Inspect Wire Harness and Connector (Front Seat Outer Belt Assembly RH or LH - Seat Belt Control Computer)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D702RX"/>.</ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the connector of the front seat outer belt assembly RH or LH.</ptxt>
<figure>
<graphic graphicname="E157075J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</test1>
<test1>
<ptxt>Check that seat belt control computer connector A is disconnected.</ptxt>
</test1>
<test1>
<ptxt>Using SST, connect the terminals of the vehicle side wire harness connector of the front seat outer belt assembly RH or LH.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of seat belt control computer vehicle side wire harness connector A.</ptxt>
<figure>
<graphic graphicname="E157076J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COLSPEC0" colwidth="1.03in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A1(MOR-) - A2(MOR+)</ptxt>
</entry>
<entry morerows="1" valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry morerows="1" valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>A3(MOL+) - A4(MOL-)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>NG</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>OK (when B2002 is output)</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>OK (when B2007 is output)</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DB300LX_04_0005" fin="true">A</down>
<right ref="RM000000DB300LX_04_0004" fin="true">B</right>
<right ref="RM000000DB300LX_04_0006" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM000000DB300LX_04_0003">
<testtitle>Replace Seat Belt Control Computer<xref label="Seep01" href="RM000002SZU002X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DB300LX_04_0005">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000000DB300LX_04_0004">
<testtitle>Replace Front Seat Outer Belt Assembly RH<xref label="Seep01" href="RM000001ESF005X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DB300LX_04_0006">
<testtitle>Replace Front Seat Outer Belt Assembly LH<xref label="Seep01" href="RM000001ESF005X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>