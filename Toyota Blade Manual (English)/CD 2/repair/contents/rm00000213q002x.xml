<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="08">
<name>Heater &amp; Air Conditioner/Ventilation</name>
<section id="1002K_S000B" variety="S000B">
<name>Air Conditioner</name>
<ttl id="1002K_S000B_74221_T002B" variety="T002B">
<name>Cooler Condenser Assembly (Engine Model 2AZ-FE)</name>
<para id="RM00000213Q002X" category="A" type-id="30014" name-id="5227X-00" from="200612">
<name>Installation</name>
<subpara id="RM00000213Q002X_01" type-id="01" category="01">
<s-1 id="RM00000213Q002X_01_0001" proc-id="RM0550J___000014X00000">
<ptxt>Install Condenser Assembly (with Receiver)</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E147031" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Insert the condenser assembly (with receiver) from above.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213Q002X_01_0014" proc-id="RM0550J___00007DJ00000">
<ptxt>Install Discharge Hose Sub-assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E145408" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Remove the vinyl tape wrapped around the joints of the discharge hose and condenser assembly (with receiver).</ptxt>
</s2>
<s2>
<ptxt>Apply sufficient compressor oil (ND-OIL8) to a new O-ring and install it to the discharge hose.</ptxt>
<atten3>
<ptxt>Do not allow dirt or foreign matter to adhere to the O-ring or O-ring sealing surface.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the discharge hose to the condenser assembly (with receiver) with the bolt.</ptxt>
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213Q002X_01_0015" proc-id="RM0550J___00007DK00000">
<ptxt>Install Air Conditioner Tube &amp; Accessory Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E145407" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Remove the vinyl tape wrapped around the joints of the air conditioner tube &amp; accessory assembly and condenser assembly (with receiver).</ptxt>
</s2>
<s2>
<ptxt>Apply sufficient compressor oil (ND-OIL8) to a new O-ring and install it to the air conditioner tube &amp; accessory assembly.</ptxt>
<atten3>
<ptxt>Do not allow dirt or foreign matter to adhere to the O-ring or O-ring sealing surface.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the air conditioner tube &amp; accessory assembly to the condenser assembly (with receiver) with the bolt.</ptxt>
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt/>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213Q002X_01_0004" proc-id="RM0550J___00000ZC00000">
<ptxt>Charge Refrigerant HFC-134a (R134a)
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Evacuate the system using a vacuum pump.</ptxt>
</s2>
<s2>
<ptxt>Charge with refrigerant HFC-134a (R134a).</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt>440±50g</ptxt>
</specitem>
</spec>
<atten3>
<ptxt>Never operate the cooler compressor before charging refrigerant, as operating it without refrigerant may cause it to seize due to insufficient lubrication.</ptxt>
</atten3>
<atten4>
<ptxt>When reusing recovered refrigerant gas, the recovery rate of the refrigerant recovery/recycling machine is approximately 90%, so additional refrigerant from a service can is required when recharging; prepare it in advance.</ptxt>
</atten4>
<figure>
<graphic graphicname="E143108J02" width="7.106578999in" height="4.7836529in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0005" proc-id="RM0550J___00000ZD00000">
<ptxt>Engine Warm-up
</ptxt>
<content1 releasenbr="1">
<atten3>
<ptxt>After charging with refrigerant, perform a break-in operation at 2000r/min or less for 2 minutes or more.</ptxt>
</atten3>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0006" proc-id="RM0550J___00000ZE00000">
<ptxt>Refrigerant Gas Leak Inspection
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>After charging the refrigerant gas, inspect for refrigerant gas leaks using a halogen leak detector.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0025" proc-id="RM0550J___00003UU00000">
<ptxt>Install Fan Shroud NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install fan shroud No.2 to the radiator assembly with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A159943" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>7.0</t-value1>
<t-value2>71</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Using the clamp, install the water bypass hose No.3 to the fan shroud No.2.</ptxt>
</s2>
<s2>
<ptxt>Install the 2 radiator support cushions to the fan shroud No.2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0019" proc-id="RM0550J___00003UT00000">
<ptxt>Install Radiator Support Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator support assembly with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A159942" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>13</t-value1>
<t-value2>133</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the 2 horn assembly connectors.</ptxt>
<figure>
<graphic graphicname="A162974" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0020" proc-id="RM0550J___00003V200000">
<ptxt>Install Hood Lock Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the hood lock assembly with the 3 bolts.</ptxt>
<figure>
<graphic graphicname="A162973" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>7.5</t-value1>
<t-value2>77</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Attach the hood lock control cable assembly to the 2 clamps.</ptxt>
<figure>
<graphic graphicname="A155392" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0026" proc-id="RM0550J___00009QK00000">
<ptxt>Inspect Hood Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that each clearance dimension is within the reference value.</ptxt>
<figure>
<graphic graphicname="B167272J01" width="7.106578999in" height="3.779676365in"/>
</figure>
<spec>
<title>Reference Value</title>
<table pgwide="1">
<tgroup cols="4">
<colspec colname="COL1" align="center" colwidth="1.06in"/>
<colspec colname="COL2" align="center" colwidth="2.48in"/>
<colspec colname="COL3" align="center" colwidth="1.06in"/>
<colspec colname="COL4" align="center" colwidth="2.48in"/>
<tbody>
<row>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
<entry valign="middle">
<ptxt>6.2±1.5 mm</ptxt>
</entry>
<entry valign="middle">
<ptxt>D</ptxt>
</entry>
<entry valign="middle">
<ptxt>3.8±1.5 mm</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
<entry valign="middle">
<ptxt>4.3±1.5 mm</ptxt>
</entry>
<entry valign="middle">
<ptxt>E</ptxt>
</entry>
<entry valign="middle">
<ptxt>0±1.0 mm</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
<entry valign="middle">
<ptxt>0.1±1.5 mm</ptxt>
</entry>
<entry namest="COL3" nameend="COL4" valign="middle"/>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0028" proc-id="RM0550J___00009QM00000">
<ptxt>Adjust Hood Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Adjustment in forward/rearward direction of hood and left/right direction at rear end</ptxt>
<s3>
<ptxt>Loosen the bolts of the bonnet (hood) hinge assembly and adjust.</ptxt>
<figure>
<graphic graphicname="B153597" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>13</t-value1>
<t-value2>133</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>When adjusting, use a service bolt to adjust the fit.</ptxt>
</atten3>
</s3>
</s2>
<s2>
<ptxt>Vertical adjustment of left and right front end of hood</ptxt>
<s3>
<ptxt>Turn the 2 cushions on each of the left and right sides to adjust the height.</ptxt>
<figure>
<graphic graphicname="B167273" width="2.775699831in" height="1.771723296in"/>
</figure>
</s3>
</s2>
<s2>
<ptxt>Vertical and lateral adjustment of front end of hood</ptxt>
<s3>
<ptxt>Loosen the 3 bolts of the bonnet (hood) lock assembly and adjust.</ptxt>
<figure>
<graphic graphicname="B170163" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>7.5</t-value1>
<t-value2>77</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>When adjusting, use a service bolt to adjust the fit.</ptxt>
</atten3>
</s3>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0031" proc-id="RM0550J___00004JH00000">
<ptxt>Connect Water Bypass Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the water bypass hose to the radiator support assembly with the 2 bolts and 2 clamps.</ptxt>
<figure>
<graphic graphicname="A159941" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0022" proc-id="RM0550J___00008EL00000">
<ptxt>Install Front Bumper Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 8 claws (4 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167063" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the front bumper assembly with the 5 clips, 2 bolts and 6 screws.</ptxt>
<figure>
<graphic graphicname="B167062" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the pin hold clip.</ptxt>
<figure>
<graphic graphicname="B167473" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Install the RH side using the same procedure.</ptxt>
</atten4>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0023" proc-id="RM0550J___00008EM00000">
<ptxt>Install Radiator Grille Protector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the 2 radiator grille protectors.</ptxt>
<figure>
<graphic graphicname="B167060" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000213Q002X_01_0024" proc-id="RM0550J___000031W00000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 8 clips.</ptxt>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>