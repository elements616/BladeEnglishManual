<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1000O_S0019" variety="S0019">
<name>Parking Brake</name>
<ttl id="1000O_S0019_745H3_T00B6" variety="T00B6">
<name>Parking Brake Lever Sub-assembly</name>
<para id="RM000000WAW00CX" category="A" type-id="80001" name-id="460IF-00" from="200612" to="200912">
<name>Removal</name>
<subpara id="RM000000WAW00CX_02" type-id="01" category="01">
<s-1 id="RM000000WAW00CX_02_0036" proc-id="RM0550J___0000ABV00000">
<ptxt>Remove Console Box Cover Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a thin flat-tip screwdriver wrapped with protective tape, disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B163189J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Place your hand at the position shown in the illustration and disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B156562" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors and remove the console box rear cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000WAW00CX_02_0037" proc-id="RM0550J___0000ABX00000">
<ptxt>Remove Console Box Carpet
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the console box carpet.</ptxt>
<figure>
<graphic graphicname="B156554" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000000WAW00CX_02_0038" proc-id="RM0550J___0000ABZ00000">
<ptxt>Remove Console Box Assembly Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 2 screws.</ptxt>
<figure>
<graphic graphicname="B167309" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 4 claws and remove the console box assembly RR.</ptxt>
<figure>
<graphic graphicname="B167310" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000000WAW00CX_02_0035" proc-id="RM0550J___00006JZ00000">
<ptxt>Remove Parking Brake Lever Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C155538" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Detach the wire harness clamp from the console box mounting bracket UPR LH.</ptxt>
</s2>
<s2>
<ptxt>Detach the 2 wire harness clamps from the console box mounting bracket UPR RH.</ptxt>
<figure>
<graphic graphicname="C155537" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the lock nut and adjusting nut from parking brake cable assembly No.1.</ptxt>
<figure>
<graphic graphicname="C163101J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the parking brake switch connector.</ptxt>
<figure>
<graphic graphicname="C155532" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 bolts and parking brake lever assembly.</ptxt>
<figure>
<graphic graphicname="C163105" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Raise the claw of the parking brake lever assembly and remove parking brake cable assembly No.1 from the parking brake lever assembly.</ptxt>
<figure>
<graphic graphicname="C155533J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>