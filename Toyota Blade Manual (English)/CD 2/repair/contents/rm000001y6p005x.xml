<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_74X9X_T00GB" variety="T00GB">
<name>Engine Mounting Insulator RH (2GR-FE)</name>
<para id="RM000001Y6P005X" category="A" type-id="30014" name-id="0725B-00" from="200708">
<name>Installation</name>
<subpara id="RM000001Y6P005X_01" type-id="01" category="01">
<s-1 id="RM000001Y6P005X_01_0001" proc-id="RM0550J___0000EPB00000">
<ptxt>Install Engine Mounting Insulator Sub-assembly RH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine mounting insulator RH with the 3 bolts.</ptxt>
<figure>
<graphic graphicname="A136934" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y6P005X_01_0024" proc-id="RM0550J___0000EPH00000">
<ptxt>Connect Engine Mounting Insulator Sub-assembly RH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine mounting insulator RH to the engine mounting bracket RH with the 2 bolts and 2 nuts.</ptxt>
<figure>
<graphic graphicname="A136933J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
<ptxt>(Bolt)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
<ptxt>(Nut A)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>52</t-value1>
<t-value2>530</t-value2>
<ptxt>(Nut B)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the cooler pipe bracket with the 2 bolts and nut.</ptxt>
<figure>
<graphic graphicname="A162927" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the ground wire with the 2 bolts and 2 clamps.</ptxt>
<figure>
<graphic graphicname="A177054" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y6P005X_01_0020" proc-id="RM0550J___0000EPE00000">
<ptxt>Install Radiator Reserve Tank Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator reserve tank assembly with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A162931" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>5</t-value1>
<t-value2>51</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y6P005X_01_0039" proc-id="RM0550J___0000FPZ00000">
<ptxt>Install Engine Under Cover Rear RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine under cover rear RH with the 5 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y6P005X_01_0040" proc-id="RM0550J___0000HO300000">
<ptxt>Install Front Tire RH</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>103</t-value1>
<t-value2>1050</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM000001Y6P005X_01_0033" proc-id="RM0550J___0000DN600000">
<ptxt>Install Engine Mounting Stay NO.2 RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install engine mounting stay No.2 RH with the bolt and 2 nuts.</ptxt>
<figure>
<graphic graphicname="A136932" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>20</t-value1>
<t-value2>204</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000001Y6P005X_01_0036" proc-id="RM0550J___0000DMG00000">
<ptxt>Install V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 clips to install the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Make sure the clips are securely engaged.</ptxt>
</item>
<item>
<ptxt>Engaging them with excessive force or striking the top of the clips may cause damage.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000001Y6P005X_01_0037" proc-id="RM0550J___0000FQ400000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 9 clips.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>