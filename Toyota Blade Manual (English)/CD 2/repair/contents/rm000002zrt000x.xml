<name>Brake</name>
<section id="1000N_S0010" variety="S0010">
<name>Brake</name>
<ttl id="1000N_S0010_744YS_T009T" variety="T009T">
<name>Brake Master Cylinder Assembly</name>
<para id="RM000002ZRT000X" category="A" type-id="80002" name-id="4510J-00" from="200612">
<name>Disassembly</name>
<subpara id="RM000002ZRT000X_01" type-id="01" category="01">
<s-1 id="RM000002ZRT000X_01_0001" proc-id="RM0550J___00005ET00000">
<ptxt>Remove Brake Master Cylinder Reservoir Sub-assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C150122" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Using a pin punch and hammer, drive out the pin.</ptxt>
</s2>
<s2>
<ptxt>Remove the brake master cylinder reservoir assembly from the brake master cylinder sub-assembly.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZRT000X_01_0002" proc-id="RM0550J___00005EU00000">
<ptxt>Remove Master Cylinder Reservoir Grommet</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 brake master cylinder reservoir grommets from the master cylinder reservoir.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
