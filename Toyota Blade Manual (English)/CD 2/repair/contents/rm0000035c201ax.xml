<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM0000035C201AX" category="C" type-id="803MI" name-id="653FQ-01" from="200912">
<dtccode>B15B8</dtccode>
<dtcname>Hard disk malfunction</dtcname>
<subpara id="RM0000035C201AX_01" type-id="33" category="03" proc-id="RM0550J___0000IIO00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The navigation receiver assembly outputs this code when an initialization malfunction or read/write errors occur a specified number of times or more for the built-in HDD.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COLSPEC0" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>DTC.No.</ptxt>
</entry>
<entry valign="middle">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B15B8</ptxt>
</entry>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Initialization malfunction</ptxt>
</item>
<item>
<ptxt>Read/write errors for the HDD occur a specified number of times or more</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="left">
<ptxt>Navigation Receiver Assembly</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000035C201AX_03" type-id="51" category="05" proc-id="RM0550J___0000IIS00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM0000002RM03SX"/>)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000035C201AX_02" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000035C201AX_02_0001" proc-id="RM0550J___0000IIP00000">
<testtitle>Perform HDD Diagnosis</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Start Diagnosis</ptxt>
<test2>
<ptxt>Start diagnosis and display the service inspection menu screen. (see <xref label="Seep01" href="RM0000002RV04DX"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Diagnosis/Diagnostic Information Collection" on the service inspection menu screen to display the diagnosis/diagnostic information collection screen.</ptxt>
</test2>
</test1>
<test1>
<ptxt>HDD Diagnosis</ptxt>
<figure>
<graphic graphicname="E150539J06" width="2.775699831in" height="1.771723296in"/>
</figure>
<test2>
<ptxt>Perform HDD diagnosis.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>The diagnosis result "OK" is displayed</ptxt>
</specitem>
</spec>
</test2>
</test1>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry valign="middle">
<ptxt>Diagnosis Result</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM0000035C201AX_02_0005" fin="false">OK</down>
<right ref="RM0000035C201AX_02_0003" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000035C201AX_02_0005" proc-id="RM0550J___0000IIR00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM0000035C201AX_02_0002" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000035C201AX_02_0002" proc-id="RM0550J___0000IIQ00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.83in"/>
<colspec colname="COL2" colwidth="1.30in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>No code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>Even if DTC (B15B8) is not output, the HDD may be damaged.</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="RM0000035C201AX_02_0006" fin="true">A</down>
<right ref="RM0000035C201AX_02_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035C201AX_02_0006">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035C201AX_02_0003">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035C201AX_02_0004">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY07EX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>