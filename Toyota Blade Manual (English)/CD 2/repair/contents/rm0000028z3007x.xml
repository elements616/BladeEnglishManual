<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="1001O_S001F" variety="S001F">
<name>Cruise Control</name>
<ttl id="1001O_S001F_74QXH_T00FG" variety="T00FG">
<name>Cruise Control Main Switch</name>
<para id="RM0000028Z3007X" category="A" type-id="30014" name-id="5914B-00" from="200708">
<name>Installation</name>
<subpara id="RM0000028Z3007X_01" type-id="01" category="01">
<s-1 id="RM0000028Z3007X_01_0001" proc-id="RM0550J___0000CCE00000">
<ptxt>Install Cruise Control Main Switch</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert the cruise control main switch in the direction of the arrow shown in the illustration.</ptxt>
<figure>
<graphic graphicname="B180372" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the cruise control main switch with the 2 screws.</ptxt>
<figure>
<graphic graphicname="B180370" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028Z3007X_01_0020" proc-id="RM0550J___0000CEU00000">
<ptxt>Install Horn Button Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the horn connector to the horn button assembly.</ptxt>
<figure>
<graphic graphicname="C148603" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the airbag connector to the horn button assembly and lock it securely.</ptxt>
<atten3>
<ptxt>Securely lock the airbag connector.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Using a torx socket wrench (T30), install the horn button assembly to the steering wheel assembly with the 2 torx bolts.</ptxt>
<torque>
<torqueitem>
<t-value1>8.8</t-value1>
<t-value2>90</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="C172739J01" width="7.106578999in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028Z3007X_01_0021" proc-id="RM0550J___0000CEV00000">
<ptxt>Install Steering Wheel Cover Lower NO.3
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the claws and install steering wheel cover lower NO.3.</ptxt>
<figure>
<graphic graphicname="C148600J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028Z3007X_01_0022" proc-id="RM0550J___0000CEW00000">
<ptxt>Install Steering Wheel Cover Lower NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the claws and install steering wheel cover lower NO.2.</ptxt>
<figure>
<graphic graphicname="C148599J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028Z3007X_01_0023">
<ptxt>Connect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM0000028Z3007X_01_0027" proc-id="RM0550J___00008BZ00000">
<ptxt>Airbag Warning Light Inspection
</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM00000050I01GX"/>)</ptxt>
</content1></s-1>
<s-1 id="RM0000028Z3007X_01_0025" proc-id="RM0550J___0000CCI00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW011X"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
