<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_744F0_T005M" variety="T005M">
<name>Engine Mounting Insulator RH (2AZ-FE)</name>
<para id="RM0000027J7006X" category="A" type-id="80001" name-id="071TG-00" from="200612">
<name>Removal</name>
<subpara id="RM0000027J7006X_01" type-id="01" category="01">
<s-1 id="RM0000027J7006X_01_0012">
<ptxt>Remove Front Tire RH</ptxt>
</s-1>
<s-1 id="RM0000027J7006X_01_0010" proc-id="RM0550J___0000AJ700000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove the engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000027J7006X_01_0011" proc-id="RM0550J___0000BJ100000">
<ptxt>Remove Engine Under Cover Rear RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 5 clips and remove the RH rear engine cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000027J7006X_01_0008" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000027J7006X_01_0006" proc-id="RM0550J___0000AQA00000">
<ptxt>Disconnect Radiator Reserve Tank Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and disconnect the radiator reserve tank.</ptxt>
<figure>
<graphic graphicname="A162931" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Without disconnecting the hose, suspend the radiator reserve tank from the body with a string, etc.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM0000027J7006X_01_0004" proc-id="RM0550J___000032D00000">
<ptxt>Remove Engine Mounting Insulator Sub-assembly RH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Support the oil pan with a jack, using a piece of wood, etc.</ptxt>
<figure>
<graphic graphicname="A066226J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and the nut, and remove the 2 cooler pipe brackets.</ptxt>
<figure>
<graphic graphicname="A162927" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and 2 nuts, and disconnect the engine mounting insulator RH from the engine mounting bracket RH.</ptxt>
<figure>
<graphic graphicname="A162928" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 bolts and remove the RH engine mounting insulator.</ptxt>
<figure>
<graphic graphicname="A162929" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>