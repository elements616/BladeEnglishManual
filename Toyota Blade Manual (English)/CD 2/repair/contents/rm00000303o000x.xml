<para id="RM00000303O000X" category="C" type-id="8039A" name-id="672BS-00" from="200612" to="200912">
<dtccode>U0073</dtccode>
<dtcname>CAN Transmission Malfunction (Bus Off Detected Continuously)</dtcname>
<dtccode>U0100</dtccode>
<dtcname>EFI ECU Communication Stop</dtcname>
<dtccode>U0122</dtccode>
<dtcname>VSC (Electronically Controlled Brake System) ECU Communication Malfunction</dtcname>
