<dtcname>Steering Angle Sensor Communication Malfunction</dtcname>
<dtccode>U0131</dtccode>
<dtcname>EPS ECU Communication Malfunction</dtcname>
<dtccode>U0164</dtccode>
<dtcname>Lost Communication with Air Conditioner ECU</dtcname>
<dtccode>U1000</dtccode>
<dtcname>ECU Malfunction (CAN Related)</dtcname>
<subpara id="RM00000303O000X_01" type-id="33" category="03" proc-id="RM0550J___0000A9200000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller's self-diagnosis determines that the CAN communication system is malfunctioning.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U0100</ptxt>
</entry>
<entry valign="middle">
<ptxt>CAN Reception Malfunction (from ENG, ECT)</ptxt>
</entry>
<entry valign="middle">
<ptxt>CAN Communication System</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U0073</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>CAN Transmission Malfunction (Bus Off Detected Continuously)</ptxt>
</item>
<item>
<ptxt>CAN Transmission Malfunction</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>CAN Communication System</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U0129</ptxt>
</entry>
<entry valign="middle">
<ptxt>CAN Reception Malfunction (from VSC)</ptxt>
</entry>
<entry valign="middle">
<ptxt>CAN Communication System</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U0126</ptxt>
</entry>
<entry valign="middle">
<ptxt>CAN reception malfunction (from steering angle sensor)</ptxt>
</entry>
<entry valign="middle">
<ptxt>CAN Communication System</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U0131</ptxt>
</entry>
<entry valign="middle">
<ptxt>CAN Reception Malfunction (from EPS)</ptxt>
</entry>
<entry valign="middle">
<ptxt>CAN Communication System</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U0164</ptxt>
</entry>
<entry valign="middle">
