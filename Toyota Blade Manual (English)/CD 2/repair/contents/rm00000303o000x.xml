</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000303O000X_02" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM00000303O000X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000303O000X_03_0001" proc-id="RM0550J___0000A9300000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again, and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTCs are output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>When "U0122" is output, "C1644" and "C1648" are also output.</ptxt>
</atten4>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000303O000X_03_0003" fin="true">A</down>
<right ref="RM00000303O000X_03_0002" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000303O000X_03_0002">
<testtitle>Go to CAN Communication System<xref label="Seep01" href="RM000001R4W009X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000303O000X_03_0003">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
