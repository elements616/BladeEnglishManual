<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002O_S0008" variety="S0008">
<name>Engine Immobiliser</name>
<ttl id="1002O_S0008_741KM_T000P" variety="T000P">
<name>Engine Immobiliser System</name>
<para id="RM000001W5400GX" category="C" type-id="801NG" name-id="580M6-00" from="200612">
<dtccode>B2790</dtccode>
<dtcname>ID Code Box Malfunction</dtcname>
<subpara id="RM000001W5400GX_01" type-id="31" category="03" proc-id="RM0550J___0000A5900000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The certification ECU (smart key computer assembly) outputs this code when an internal malfunction occurs in the ID code box (immobiliser code computer).</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.83in"/>
<colspec colname="COL2" colwidth="2.85in"/>
<colspec colname="COL3" colwidth="3.40in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B2790</ptxt>
</entry>
<entry valign="middle">
<ptxt>When an internal malfunction of the ID code box occurs</ptxt>
</entry>
<entry valign="middle">
<ptxt>ID Code Box (Immobiliser Code Computer)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000001W5400GX_02" type-id="51" category="05" proc-id="RM0550J___0000A5A00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>When replacing the ID code box (immobiliser code computer), check the precautions (see <xref label="Seep01" href="RM000000MGE00SX"/>) and the registration procedure in the reference section before proceeding.</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000001W5400GX_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000001W5400GX_03_0001" proc-id="RM0550J___0000A5B00000">
<testtitle>Replace Immobiliser Code Computer</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the ID code box (immobiliser code computer).</ptxt>
</test1>
</content6>
<res>
<down ref="RM000001W5400GX_03_0003" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000001W5400GX_03_0003" proc-id="RM0550J___0000A5C00000">
<testtitle>ID Code Registration</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check the registration procedure in the reference section and register the ID code.</ptxt>
</test1>
</content6>
<res>
<down ref="RM000001W5400GX_03_0004" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000001W5400GX_03_0004" proc-id="RM0550J___0000A5D00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again. (see <xref label="Seep01" href="RM000000MGS00TX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.97in"/>
<colspec colname="COL2" colwidth="1.16in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B2790 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>B2790 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000001W5400GX_03_0002" fin="true">A</down>
<right ref="RM000001W5400GX_03_0005" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000001W5400GX_03_0005">
<testtitle>Replace Smart Key Computer Assembly</testtitle>
</testgrp>
<testgrp id="RM000001W5400GX_03_0002">
<testtitle>Complete</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>