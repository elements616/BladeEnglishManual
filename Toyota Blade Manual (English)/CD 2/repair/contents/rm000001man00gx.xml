<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1002M_S001G" variety="S001G">
<name>Pre-crash Safety</name>
<ttl id="1002M_S001G_74WT7_T00FP" variety="T00FP">
<name>Pre-crash Safety System</name>
<para id="RM000001MAN00GX" category="C" type-id="801HY" name-id="540JI-00" from="200708">
<dtccode>B2058/31</dtccode>
<dtcname>Steering Angle Sensor Malfunction</dtcname>
<subpara id="RM000001MAN00GX_02" type-id="31" category="03" proc-id="RM0550J___0000CVT00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="unordered">
<item>
<ptxt>This DTC is output when a steering sensor malfunction occurs.</ptxt>
</item>
<item>
<ptxt>This circuit consists of the steering sensor, seat belt control computer and distance control computer assembly.</ptxt>
</item>
</list1>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.99in"/>
<colspec colname="COL2" colwidth="3.02in"/>
<colspec colname="COLSPEC0" colwidth="3.07in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B2058/31</ptxt>
</entry>
<entry valign="middle">
<ptxt>Vehicle speed 50km/h or more, steering sensor malfunction</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>ABS with EBD &amp; TRC &amp; VSC &amp; BA system</ptxt>
</item>
<item>
<ptxt>Distance Control Computer Assembly</ptxt>
</item>
<item>
<ptxt>Seat Belt Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000001MAN00GX_03" type-id="32" category="03" proc-id="RM0550J___0000CVU00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E143520J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000001MAN00GX_04" type-id="51" category="05" proc-id="RM0550J___0000CVV00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>When the distance control computer assembly is replaced with a new one, be sure to perform initialization. (see <xref label="Seep01" href="RM000002GO2003X_01_0001"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000001MAN00GX_01" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000001MAN00GX_01_0008" proc-id="RM0550J___0000CVQ00000">
<testtitle>Check DTC (Brake System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/ABS/VSC" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Check for DTCs.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>DTC C1231 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC C1231 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000001MAN00GX_01_0012" fin="false">A</down>
<right ref="RM000001MAN00GX_01_0011" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000001MAN00GX_01_0012" proc-id="RM0550J___0000CVS00000">
<testtitle>Replace Seat Belt Control Computer</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the seat belt control computer with a new one.</ptxt>
<ptxt>(see <xref label="Seep01" href="RM000002SZU002X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000001MAN00GX_01_0009" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000001MAN00GX_01_0009" proc-id="RM0550J___0000CVR00000">
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/Pre-crash" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen to clear the data.</ptxt>
</test1>
<test1>
<ptxt>Follow the prompts on the SST (TaSCAN) screen to display the "System Diagnosis Menu/Pre-crash" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Check for DTCs again.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B2058 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B2058 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000001MAN00GX_01_0013" fin="true">A</down>
<right ref="RM000001MAN00GX_01_0006" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000001MAN00GX_01_0013">
<testtitle>END</testtitle>
</testgrp>
<testgrp id="RM000001MAN00GX_01_0011">
<testtitle>Go to the relevant DTC chart<xref label="Seep01" href="RM0000005ZT00PX"/>
</testtitle>
</testgrp>
<testgrp id="RM000001MAN00GX_01_0006">
<testtitle>Replace Distance Control Computer Assembly<xref label="Seep01" href="RM0000028Z2003X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
