<name>Brake</name>
<section id="1000O_S0019" variety="S0019">
<name>Parking Brake</name>
<ttl id="1000O_S0019_745H1_T00B4" variety="T00B4">
<name>Parking Brake Cable Assembly NO.1</name>
<para id="RM0000006NI00OX" category="A" type-id="30014" name-id="460Q3-01" from="200912">
<name>Installation</name>
<subpara id="RM0000006NI00OX_02" type-id="01" category="01">
<s-1 id="RM0000006NI00OX_02_0157" proc-id="RM0550J___000065500001">
<ptxt>Install Parking Brake Cable Assembly NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install parking brake cable assembly No.1 to the parking brake control pedal assembly.</ptxt>
<figure>
<graphic graphicname="C222597" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the clip to parking brake cable assembly No.1.</ptxt>
</s2>
<s2>
<ptxt>Bend the claw of the parking brake control pedal assembly.</ptxt>
<figure>
<graphic graphicname="C222598" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Temporarily install wire adjusting nut No.1 to parking brake cable assembly No.1.</ptxt>
<figure>
<graphic graphicname="C222595" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000006NI00OX_02_0168" proc-id="RM0550J___0000IT100000">
<ptxt>Install Parking Brake Control Pedal Assembly</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>For the procedure from installation of the parking brake control pedal assembly, refer to <xref label="Seep01" href="RM000000WAU00SX"/>.</ptxt>
</atten4>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
