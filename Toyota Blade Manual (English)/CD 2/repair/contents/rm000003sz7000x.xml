<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001H_S0001" variety="S0001">
<name>Seat</name>
<ttl id="1001H_S0001_76AU3_T00JK" variety="T00JK">
<name>Seat Heater Switch</name>
<para id="RM000003SZ7000X" category="A" type-id="80001" name-id="791YD-01" from="200810" to="200912">
<name>Removal</name>
<subpara id="RM000003SZ7000X_01" type-id="01" category="01">
<s-1 id="RM000003SZ7000X_01_0003" proc-id="RM0550J___0000ABV00000">
<ptxt>Remove Console Box Cover Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a thin flat-tip screwdriver wrapped with protective tape, disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B163189J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Place your hand at the position shown in the illustration and disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B156562" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors and remove the console box rear cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000003SZ7000X_01_0002" proc-id="RM0550J___0000HVM00000">
<ptxt>Remove Seat Heater Switch</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="B214371" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Disengage the 2 claws and remove the seat heater switch.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>