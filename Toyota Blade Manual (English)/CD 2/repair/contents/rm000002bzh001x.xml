<name>Radio Receiver Assembly</name>
<para id="RM000002BZH001X" category="A" type-id="30014" name-id="641JO-00" from="200612">
<name>Installation</name>
<subpara id="RM000002BZH001X_01" type-id="01" category="01">
<s-1 id="RM000002BZH001X_01_0019">
<ptxt>Install Radio Receiver Assembly</ptxt>
</s-1>
<s-1 id="RM000002BZH001X_01_0009" proc-id="RM0550J___000016M00000">
<ptxt>Install Radio Bracket NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radio bracket NO.2 to the radio receiver assembly with the 4 screws.</ptxt>
<figure>
<graphic graphicname="E137087" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002BZH001X_01_0012" proc-id="RM0550J___00007DQ00000">
<ptxt>Install Radio Bracket NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radio bracket NO.1 to the radio receiver assembly with the 4 screws.</ptxt>
<figure>
<graphic graphicname="E137088" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002BZH001X_01_0013" proc-id="RM0550J___00007DR00000">
<ptxt>Install Radio Receiver Assembly w/ Bracket</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 4 clips and temporarily install the radio receiver assembly w/ bracket.</ptxt>
<figure>
<graphic graphicname="E137086" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the radio receiver assembly w/ bracket with 4 bolts.</ptxt>
<figure>
<graphic graphicname="E137085" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002BZH001X_01_0020" proc-id="RM0550J___00009N100000">
<ptxt>Install Instrument Panel Register Assembly Center
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector.</ptxt>
<figure>
<graphic graphicname="B151129" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 clips, 5 claws and 3 guides, and install the instrument panel register assembly CTR.</ptxt>
<figure>
<graphic graphicname="B169225J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002BZH001X_01_0021" proc-id="RM0550J___00009N200000">
<ptxt>Install Instrument Panel Finish Panel End RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and install the instrument panel finish panel end RH.</ptxt>
<figure>
<graphic graphicname="B169227" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002BZH001X_01_0022" proc-id="RM0550J___00009N300000">
<ptxt>Install Instrument Panel Finish Panel End LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and install the instrument panel finish panel end LH.</ptxt>
<figure>
<graphic graphicname="B169226" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
