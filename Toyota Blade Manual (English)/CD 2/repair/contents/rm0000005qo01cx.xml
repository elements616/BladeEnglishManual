</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Vehicle horn</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ON/OFF</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000005QO01CX_01_0014" fin="true">OK</down>
<right ref="RM0000005QO01CX_01_0021" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005QO01CX_01_0014">
<testtitle>OK (horn replaced)<xref label="Seep01" href="RM000000Q97005X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000005QO01CX_01_0012">
<testtitle>Replace Fuse</testtitle>
</testgrp>
<testgrp id="RM0000005QO01CX_01_0026">
<testtitle>Replace Integration Relay NO.1</testtitle>
</testgrp>
<testgrp id="RM0000005QO01CX_01_0021">
<testtitle>Repair or Replace Wire Harness and Connector</testtitle>
</testgrp>
<testgrp id="RM0000005QO01CX_01_0028">
<testtitle>Replace Steering Pad Switch Assembly or Steering Pad Switch LH<xref label="Seep01" href="RM000002C07007X"/>
</testtitle>
</testgrp>
</subpara>
</para>
