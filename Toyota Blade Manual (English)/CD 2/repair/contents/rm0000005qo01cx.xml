</testtitle>
</testgrp>
<testgrp id="RM0000005QO01CX_01_0018">
<testtitle>Replace Spiral Cable Sub-assembly<xref label="Seep01" href="RM000000QFH008X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000005QO01CX_01_0002" proc-id="RM0550J___0000B5B00001">
<testtitle>Inspect Fuse</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (Toyota electrical tester), inspect the HORN fuse.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>HORN fuse</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005QO01CX_01_0025" fin="false">OK</down>
<right ref="RM0000005QO01CX_01_0012" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005QO01CX_01_0025" proc-id="RM0550J___0000B5H00001">
<testtitle>Inspect Integration Relay NO.1 (Horn Relay)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the connector terminals.</ptxt>
<figure>
<graphic graphicname="E138327J08" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1 - A8</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<test1>
<ptxt>Measure the voltage of each terminal when the positive (+) battery lead is connected to terminal C1 and the negative (-) battery lead is connected to terminal A7.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>A8 - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>When battery voltage is applied between terminals C1 and A7</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005QO01CX_01_0005" fin="false">OK</down>
<right ref="RM0000005QO01CX_01_0026" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005QO01CX_01_0005" proc-id="RM0550J___0000B5C00001">
