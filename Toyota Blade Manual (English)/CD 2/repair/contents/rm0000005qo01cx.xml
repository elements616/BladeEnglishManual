<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Active Test</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), perform the Active Test of the main body ECU.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<title>[Diagnosis menu screen: Body → Main Body → Active Test]</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
