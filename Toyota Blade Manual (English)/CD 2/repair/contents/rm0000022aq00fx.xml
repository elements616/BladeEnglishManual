</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>IG ON</ptxt>
</item>
<item>
<ptxt>Battery current sensor output value is 0.2V or less</ptxt>
</item>
<item>
<ptxt>0.5 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
