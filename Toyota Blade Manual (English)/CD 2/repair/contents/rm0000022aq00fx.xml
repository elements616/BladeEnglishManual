</item>
<item>
<ptxt>Difference between maximum and minimum current is 1A or less</ptxt>
</item>
<item>
<ptxt>10 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
