<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_74X9W_T00GA" variety="T00GA">
<name>Engine Mounting Insulator LH (2GR-FE)</name>
<para id="RM000001Y60005X" category="A" type-id="80001" name-id="07257-00" from="200708">
<name>Removal</name>
<subpara id="RM000001Y60005X_01" type-id="01" category="01">
<s-1 id="RM000001Y60005X_01_0061">
<ptxt>Check Front Wheels Straight-ahead Position</ptxt>
</s-1>
<s-1 id="RM000001Y60005X_01_0062" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y60005X_01_0063" proc-id="RM0550J___0000DHU00000">
<ptxt>Remove V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place both hands on the front of the cover and lift it upward to disengage the 2 front clips, then continue lifting upward to disengage the 1 rear clips, and remove the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Pulling up the front and rear at the same time may cause damage.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000001Y60005X_01_0022" proc-id="RM0550J___0000ENP00000">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
<content1 releasenbr="2">
<ptxt>(see <xref label="Seep01" href="RM000000D9902LX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000001Y60005X_01_0064" proc-id="RM0550J___0000EUD00000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y60005X_01_0065" proc-id="RM0550J___0000EUE00000">
<ptxt>Remove Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the battery tray.</ptxt>
<figure>
<graphic graphicname="A176883" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 clamps and disconnect the wire harness from the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Remove the 4 bolts and the battery carrier.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y60005X_01_0066" proc-id="RM0550J___0000EUF00000">
<ptxt>Remove Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and battery carrier NO.2.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y60005X_01_0071" proc-id="RM0550J___0000F4000000">
<ptxt>Remove Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the air flow meter connector. (<sup>*</sup>1). </ptxt>
<figure>
<graphic graphicname="A176815J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect ventilation hose No.2. (<sup>*</sup>2).</ptxt>
</s2>
<s2>
<ptxt>Disconnect the hose band (<sup>*</sup>3)</ptxt>
</s2>
<s2>
<ptxt>Disengage the 3 clamps and remove the air cleaner cap w/ air cleaner hose.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y60005X_01_0072" proc-id="RM0550J___0000GU000000">
<ptxt>Remove Air Cleaner Filter Element Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the air cleaner filter element from the air cleaner case.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y60005X_01_0073" proc-id="RM0550J___0000EUG00000">
<ptxt>Remove Air Cleaner Case
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 bolts and clamp, and remove the air cleaner case.</ptxt>
<figure>
<graphic graphicname="A178719" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y60005X_01_0011" proc-id="RM0550J___0000ENO00000">
<ptxt>Remove Engine Mounting Insulator LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Support the engine assembly w/ transaxle with a transmission jack using a wooden block or similar.</ptxt>
<figure>
<graphic graphicname="A177284J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and disconnect the engine mounting insulator LH from the engine mounting bracket LH.</ptxt>
<figure>
<graphic graphicname="A136930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Operate the transmission jack to lower the engine assembly w/ transaxle.</ptxt>
<atten3>
<ptxt>Do not lower the engine assembly w/ transaxle more than necessary.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Remove the 4 bolts and remove the engine mounting insulator LH.</ptxt>
<figure>
<graphic graphicname="A136931" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>