<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001C_S000C" variety="S000C">
<name>Audio &amp; Visual</name>
<ttl id="1001C_S000C_74X5S_T00G6" variety="T00G6">
<name>Steering Pad Switch Assembly (3-spoke Steering Wheel)</name>
<para id="RM000002C07004X" category="A" type-id="80001" name-id="641OR-00" from="200708" to="200912">
<name>Removal</name>
<subpara id="RM000002C07004X_05" type-id="01" category="01">
<s-1 id="RM000002C07004X_05_0019" proc-id="RM0550J___0000CF100000">
<ptxt>Handling and Work Precautions
</ptxt>
<content1 releasenbr="1">
<ptxt>(For the procedure, refer to <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1></s-1>
<s-1 id="RM000002C07004X_05_0001" proc-id="RM0550J___0000DGA00000">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000002C07004X_05_0020" proc-id="RM0550J___0000CF300000">
<ptxt>Remove Steering Wheel Cover Lower NO.3
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claws and remove steering wheel cover lower NO.3.</ptxt>
<figure>
<graphic graphicname="C148600J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002C07004X_05_0021" proc-id="RM0550J___0000CF400000">
<ptxt>Remove Steering Wheel Cover Lower NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claws and remove steering wheel cover lower NO.2.</ptxt>
<figure>
<graphic graphicname="C148599J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002C07004X_05_0022" proc-id="RM0550J___0000CF500000">
<ptxt>Remove Horn Button Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a torx socket wrench (T30), loosen the 2 torx bolts until they turn freely.</ptxt>
<figure>
<graphic graphicname="C172737J01" width="7.106578999in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Using needle-nose pliers, pull out the 2 torx bolts.</ptxt>
</s2>
<s2>
<ptxt>Pull the horn button assembly toward the rear of the vehicle.</ptxt>
<figure>
<graphic graphicname="C172738" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a thin-bladed screwdriver with its tip wrapped with protective tape, release the lock of the airbag connector.</ptxt>
<figure>
<graphic graphicname="C148602J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the airbag connector and horn connector, and remove the horn button assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002C07004X_05_0005" proc-id="RM0550J___0000DGB00000">
<ptxt>Remove Steering Pad Switch Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E155717" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Disengage the clamp.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the 2 connectors.</ptxt>
</s2>
<s2>
<ptxt>Remove the screw.</ptxt>
<figure>
<graphic graphicname="E155193J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 pins and 2 clamps, and separate the steering pad switch LH side from the steering wheel assembly.</ptxt>
</s2>
<s2>
<ptxt>Remove the screw.</ptxt>
<figure>
<graphic graphicname="E155194J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 pins and 2 clamps, detach the steering pad switch RH side from the steering wheel assembly, and remove the steering pad switch assembly.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>