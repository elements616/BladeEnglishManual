<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_746W2_T00DG" variety="T00DG">
<name>Back Guide Monitor System</name>
<para id="RM000002SXP001X" category="J" type-id="802T9" name-id="672EH-00" from="200612" to="200912">
<dtccode/>
<dtcname>Back Guide Monitor Image Is Not Displayed When Shift Lever Is in R Position (Screen Is Black)</dtcname>
<subpara id="RM000002SXP001X_10" type-id="32" category="03" proc-id="RM0550J___0000BCV00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E131312J04" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000002SXP001X_11" type-id="51" category="05" proc-id="RM0550J___0000BCW00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<list1 type="unordered">
<item>
<ptxt>When replacing the navigation receiver assembly on a vehicle not subscribed to the G-BOOK service, perform the vehicle linking setting. (see <xref label="Seep01" href="RM000001C3S00RX"/>)</ptxt>
</item>
<item>
<ptxt>When replacing the navigation receiver assembly on a vehicle subscribed to the G-BOOK service, perform the vehicle linking setting, then perform the G-BOOK communication initial setting and HELPNET service start operation. (see <xref label="Seep02" href="RM000001C3S00RX"/>)</ptxt>
</item>
<item>
<ptxt>If the navigation receiver assembly is replaced while a purchased G-SOUND unlimited license exists, perform G-SOUND license recovery. (see <xref label="Seep03" href="RM000001C3S00RX"/>)</ptxt>
</item>
</list1>
</atten4>
</content5>
</subpara>
<subpara id="RM000002SXP001X_12" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002SXP001X_12_0028" proc-id="RM0550J___0000BCX00000">
<testtitle>Service Inspection (AVN)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Service Inspection</ptxt>
<test2>
<ptxt>Start the diagnosis and check whether "DTC 5C - 40" is displayed in individual diagnosis, AVN. (see <xref label="Seep01" href="RM0000006XI02BX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"DTC 5C-40" is not displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"DTC 5C-40" is displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000002SXP001X_12_0029" fin="false">A</down>
<right ref="RM000002SXP001X_12_0030" fin="false">B</right>
</res>
</testgrp>
<testgrp id="RM000002SXP001X_12_0029" proc-id="RM0550J___0000BCO00000">
<testtitle>Inspect Navigation Receiver Assembly (CA+, CGND, V-)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Resistance Inspection</ptxt>
<figure>
<graphic graphicname="E144427J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Using SST (Toyota electrical tester), with connector H of the vehicle side wire harness connected, measure the resistance between each terminal and body ground from the back side of connector H.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<colspec colname="COL3" colwidth="0.82in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>H21 (CGND) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>H23 (V-) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<test1>
<ptxt>Voltage Inspection</ptxt>
<figure>
<graphic graphicname="E144427J02" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Using SST (Toyota electrical tester), with connector H of the vehicle side wire harness connected, measure the voltage between each terminal from the back side of connector H.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<colspec colname="COL3" colwidth="0.82in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>H24(CA+) - H21(CGND)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>IG ON</ptxt>
<ptxt>Shift lever in R</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>5.7 to 6.5 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000002SXP001X_12_0030" fin="false">OK</down>
<right ref="RM000002SXP001X_12_0034" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002SXP001X_12_0030" proc-id="RM0550J___0000BCP00000">
<testtitle>Inspect Wire Harness and Connector (Television Camera Assembly - Navigation Receiver Assembly)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation</ptxt>
<test2>
<ptxt>Disconnect the television camera assembly and connector H of the navigation receiver assembly.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), with the connectors disconnected, measure the resistance of the vehicle side wire harness between the television camera assembly and navigation receiver assembly.</ptxt>
<figure>
<graphic graphicname="E144428J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<colspec colname="COL3" colwidth="0.82in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>H22 (V+) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>H23 (V-) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>H21 (CGND) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>H24 (CA+) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>2(CV+) - H22(V+)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>1(CV-) - H23(V-)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>3(CGND) - H21(CGND)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>4(CB+) - H24(CA+)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002SXP001X_12_0031" fin="false">OK</down>
<right ref="RM000002SXP001X_12_0035" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002SXP001X_12_0031" proc-id="RM0550J___0000BCQ00000">
<testtitle>Inspect Television Camera Assembly (CV+, CGND, CV-)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect navigation receiver assembly connector H.</ptxt>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<figure>
<graphic graphicname="E144429J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Using SST (Toyota electrical tester), with the television camera assembly connector connected, measure the resistance between each terminal from the back side of the vehicle side wire harness connector.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<colspec colname="COL3" colwidth="0.82in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1(CV-) - 3(CGND)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<test1>
<ptxt>Connect connector H of the navigation receiver assembly.</ptxt>
</test1>
<test1>
<ptxt>Waveform Inspection</ptxt>
<figure>
<graphic graphicname="E144430J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<test2>
<ptxt>Using SST (TaSCAN), with the television camera assembly connector connected, check the waveform from the back side of the vehicle side wire harness connector.  </ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>As shown in the illustration  </ptxt>
</specitem>
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="2" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="1.166535     in"/>
<colspec colnum="02" colname="C02" colwidth="3.019267     in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>Item</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>Measurement Terminal</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>2(CV+) - 1(CV-)</ptxt>
</entry>
</row>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>Tool Setting</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>0.2V/DIV, 0.2μS/DIV</ptxt>
</entry>
</row>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>Measurement Condition</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>IG ON, shift lever in R</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>The GND level varies depending on the image captured by the camera.  </ptxt>
</atten3>
</test2>
</test1>
</content6>
<res>
<down ref="RM000002SXP001X_12_0032" fin="true">OK</down>
<right ref="RM000002SXP001X_12_0036" fin="true">NG</right>
</res>
</testgrp>
