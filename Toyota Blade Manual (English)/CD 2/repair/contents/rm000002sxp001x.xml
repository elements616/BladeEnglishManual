</testtitle>
</testgrp>
<testgrp id="RM000002SXP001X_12_0034">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002SXP001X_12_0035">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000002SXP001X_12_0036">
<testtitle>Replace Television Camera Assembly<xref label="Seep01" href="RM000000MZ8001X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
