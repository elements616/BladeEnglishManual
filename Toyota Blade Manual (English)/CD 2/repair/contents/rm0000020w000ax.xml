<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_747JL_T00DX" variety="T00DX">
<name>Air Fuel Ratio Sensor (2AZ-FE)</name>
<para id="RM0000020W000AX" category="A" type-id="30014" name-id="065BM-00" from="200612">
<name>Installation</name>
<subpara id="RM0000020W000AX_01" type-id="01" category="01">
<s-1 id="RM0000020W000AX_01_0001" proc-id="RM0550J___0000BXX00000">
<ptxt>Install Air Fuel Ratio Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, install the air fuel ratio sensor to the exhaust manifold.</ptxt>
<figure>
<graphic graphicname="A135148J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<torque>
<torqueitem>
<t-value1>44</t-value1>
<t-value2>449</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the air fuel ratio sensor connector.</ptxt>
<figure>
<graphic graphicname="A098744" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W000AX_01_0005" proc-id="RM0550J___000071600000">
<ptxt>Install Exhaust Manifold Heat Insulator NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the exhaust manifold heat insulator No.1 with 4 bolts.</ptxt>
<figure>
<graphic graphicname="A112189" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>12</t-value1>
<t-value2>122</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000020W000AX_01_0007" proc-id="RM0550J___000031W00000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 8 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020W000AX_01_0008" proc-id="RM0550J___0000B7500000">
<ptxt>Exhaust Gas Leak Inspection
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that there are no exhaust gas leaks from the locations shown in the illustration (exhaust pipe joints and each sensor installation area).</ptxt>
<figure>
<graphic graphicname="A162346J01" width="7.106578999in" height="5.787629434in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
