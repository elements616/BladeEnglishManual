<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10024_S000T" variety="S000T">
<name>Starting</name>
<ttl id="10024_S000T_744HR_T0083" variety="T0083">
<name>Starter Assembly (2AZ-FE)</name>
<para id="RM0000020XC007X" category="A" type-id="80001" name-id="161WI-00" from="200612">
<name>Removal</name>
<subpara id="RM0000020XC007X_01" type-id="01" category="01">
<s-1 id="RM0000020XC007X_01_0012">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM0000020XC007X_01_0011" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020XC007X_01_0006" proc-id="RM0550J___000030700000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020XC007X_01_0007" proc-id="RM0550J___000030C00000">
<ptxt>Remove Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the battery tray.</ptxt>
<figure>
<graphic graphicname="A162914" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Detach the 2 clamps and disconnect the wire harness from the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Remove the 4 bolts and battery carrier.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020XC007X_01_0008" proc-id="RM0550J___000036A00000">
<ptxt>Remove Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and battery carrier No.2.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020XC007X_01_0005" proc-id="RM0550J___00004CT00000">
<ptxt>Remove Starter Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector from the starter assembly.</ptxt>
<figure>
<graphic graphicname="A130463" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Open the terminal cap cover.</ptxt>
</s2>
<s2>
<ptxt>Remove the nut and disconnect terminal B.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 bolts and the starter assembly.</ptxt>
<figure>
<graphic graphicname="A130464" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>