<content1 releasenbr="1">
<figure>
<graphic graphicname="E147193" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
<s2>
<ptxt>Engage the 4 clips and install the air conditioner control assembly.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002141002X_01_0026" proc-id="RM0550J___00001PG00000">
