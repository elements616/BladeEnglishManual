<s2>
<ptxt>Install the radio tuner opening cover w/ bracket with 4 bolts &lt;G&gt;. </ptxt>
<figure>
<graphic graphicname="B158741" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
