<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_744EI_T0054" variety="T0054">
<name>Engine Control Computer (2AZ-FE)</name>
<para id="RM0000020V0005X" category="A" type-id="80001" name-id="065B9-00" from="200612">
<name>Removal</name>
<subpara id="RM0000020V0005X_02" type-id="01" category="01">
<s-1 id="RM0000020V0005X_02_0043">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM0000020V0005X_02_0038" proc-id="RM0550J___00004DZ00000">
<ptxt>Remove Engine Cover Sub-assembly NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 nuts and engine cover assembly No.1.</ptxt>
<figure>
<graphic graphicname="A159817" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020V0005X_02_0039" proc-id="RM0550J___00002ZP00000">
<ptxt>Remove Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the ventilation hose.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the vacuum switching valve connector and clamp, and disconnect the wire harness.</ptxt>
<figure>
<graphic graphicname="A163392" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the fuel vapor feed hose and fuel vapor feed hose No.2.  </ptxt>
</s2>
<s2>
<ptxt>Disconnect the intake air flow meter connector and clamp, and disconnect the wire harness from the air cleaner cap.</ptxt>
<figure>
<graphic graphicname="A162887" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Lock air cleaner hose clamp No.1.</ptxt>
<figure>
<graphic graphicname="A162888" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>With the clamp locked, remove the air cleaner cap w/ air cleaner hose. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020V0005X_02_0042" proc-id="RM0550J___000030900000">
<ptxt>Remove Air Cleaner Case
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the air cleaner filter element.</ptxt>
</s2>
<s2>
<ptxt>Remove the 3 bolts and clamp, and remove the air cleaner case.</ptxt>
<figure>
<graphic graphicname="A162913" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020V0005X_02_0041" proc-id="RM0550J___00009IF00000">
<ptxt>Remove Engine Control Computer</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>While pushing the lock on the lever, lift the lever and disconnect the 2 engine control computer connectors.</ptxt>
<atten3>
<ptxt>When disconnecting the connectors, be careful not to allow foreign matter such as mud or water to adhere to the connecting parts.</ptxt>
</atten3>
<figure>
<graphic graphicname="A135674" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the clamp and 2 bolts, and remove the engine control computer.</ptxt>
<figure>
<graphic graphicname="A162895" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 4 screws and remove the 2 engine control computer brackets.</ptxt>
<figure>
<graphic graphicname="A162896" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>