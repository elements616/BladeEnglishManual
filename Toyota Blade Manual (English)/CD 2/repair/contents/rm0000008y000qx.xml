<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000008Y000QX_09_0068" fin="false">OK</down>
<right ref="RM0000008Y000QX_09_0070" fin="false">NG</right>
</res>
