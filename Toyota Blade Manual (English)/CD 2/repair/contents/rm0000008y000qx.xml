</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1 - 2</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.2 to 3.0 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<test1>
<ptxt>Operation Check</ptxt>
<test2>
<ptxt>Apply battery voltage between the fuel pump connector terminals, and check that the motor rotates.</ptxt>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Perform the inspection in a short time (10 seconds or less).</ptxt>
</item>
<item>
<ptxt>Keep the pump as far away from the battery as possible.</ptxt>
</item>
<item>
<ptxt>Always perform switching on the battery terminal side.</ptxt>
</item>
</list1>
</atten3>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000008Y000QX_09_0080" fin="true">OK</down>
<right ref="RM0000008Y000QX_09_0078" fin="true">NG</right>
</res>
