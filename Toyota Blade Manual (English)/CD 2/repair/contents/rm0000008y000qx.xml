<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Terminal 4 - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Circuit relay ON</ptxt>
</entry>
