<tmc-service-inc>
<pub id="RM0550J">
<servcat id="04">
<name>Driveline/Axle</name>
<section id="1002H_S000Z" variety="S000Z">
<name>Axle</name>
<ttl id="1002H_S000Z_744UD_T008S" variety="T008S">
<name>Front Axle Hub Bolt LH</name>
<para id="RM0000021S8005X" category="A" type-id="80001" name-id="380G0-00" from="200612">
<name>Removal</name>
<subpara id="RM0000021S8005X_01" type-id="01" category="01">
<s-1 id="RM0000021S8005X_01_0001">
<ptxt>Remove Front Tire</ptxt>
</s-1>
<s-1 id="RM0000021S8005X_01_0005" proc-id="RM0550J___00004V100000">
<ptxt>Disconnect Front Disc Brake Caliper Assembly LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and disconnect the front disc brake caliper assembly LH from the steering knuckle.</ptxt>
<atten3>
<ptxt>Suspend the front disc brake caliper assembly LH with wire or equivalent.</ptxt>
</atten3>
<figure>
<graphic graphicname="C130484" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000021S8005X_01_0007" proc-id="RM0550J___00005FV00000">
<ptxt>Remove Front Disc
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C150099J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Put matchmarks on the disc and axle hub, and remove the disc.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000021S8005X_01_0004" proc-id="RM0550J___00004VV00000">
<ptxt>Remove Front Axle Hub Bolt LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, remove the hub bolt from the front axle hub.</ptxt>
<figure>
<graphic graphicname="C147017J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09611-12010</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>