<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y2D_T00IA" variety="T00IA">
<name>Shift Lever Assembly (U660E)</name>
<para id="RM000001MA900TX" category="A" type-id="80001" name-id="261JX-00" from="200708" to="200912">
<name>Removal</name>
<subpara id="RM000001MA900TX_01" type-id="01" category="01">
<s-1 id="RM000001MA900TX_01_0001" proc-id="RM0550J___0000HST00000">
<ptxt>Handling and Work Precautions</ptxt>
<content1 releasenbr="2">
<ptxt>(see <xref label="Seep01" href="RM000000D9902LX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000001MA900TX_01_0002">
<ptxt>Check Front Wheels Straight-ahead Position</ptxt>
</s-1>
<s-1 id="RM000001MA900TX_01_0003" proc-id="RM0550J___0000GQI00000">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
<content1 releasenbr="3">
<ptxt>(see <xref label="Seep01" href="RM000001LYW011X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000001MA900TX_01_0009" proc-id="RM0550J___0000CF400000">
<ptxt>Remove Steering Wheel Cover Lower NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claws and remove steering wheel cover lower NO.2.</ptxt>
<figure>
<graphic graphicname="C148599J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001MA900TX_01_0010" proc-id="RM0550J___0000CF300000">
<ptxt>Remove Steering Wheel Cover Lower NO.3
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claws and remove steering wheel cover lower NO.3.</ptxt>
<figure>
<graphic graphicname="C148600J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001MA900TX_01_0006" proc-id="RM0550J___0000CF500000">
<ptxt>Remove Horn Button Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a torx socket wrench (T30), loosen the 2 torx bolts until they turn freely.</ptxt>
<figure>
<graphic graphicname="C172737J01" width="7.106578999in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Using needle-nose pliers, pull out the 2 torx bolts.</ptxt>
</s2>
<s2>
<ptxt>Pull the horn button assembly toward the rear of the vehicle.</ptxt>
<figure>
<graphic graphicname="C172738" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a thin-bladed screwdriver with its tip wrapped with protective tape, release the lock of the airbag connector.</ptxt>
<figure>
<graphic graphicname="C148602J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the airbag connector and horn connector, and remove the horn button assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001MA900TX_01_0007" proc-id="RM0550J___0000GO400000">
<ptxt>Remove Steering Wheel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Operate the tilt and telescopic mechanisms and fix the steering column assembly in its most extended and highest position.</ptxt>
</s2>
<s2>
<ptxt>Remove the nut and put matchmarks on the steering wheel assembly and steering column assembly.</ptxt>
<figure>
<graphic graphicname="C172700J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST, remove the steering wheel assembly.</ptxt>
<figure>
<graphic graphicname="C172701J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<sst>
<sstitem>
<s-number>09950-50013</s-number>
<s-subnumber>09951-05010</s-subnumber>
<s-subnumber>09952-05010</s-subnumber>
<s-subnumber>09953-05020</s-subnumber>
<s-subnumber>09954-05070</s-subnumber>
</sstitem>
</sst>
<atten3>
<ptxt>Apply a small amount of grease to the threads and tip of the SST center bolt (09953-05020) before use.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000001MA900TX_01_0008" proc-id="RM0550J___0000GQL00000">
<ptxt>Remove Transmission Shift Switch</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the connector clamp from the steering wheel assembly and disconnect the switch wire connector.</ptxt>
<figure>
<graphic graphicname="C120812" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors from the 2 transmission shift switches and remove the switch wire.</ptxt>
<figure>
<graphic graphicname="C120811" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 4 screws, and remove the 2 brackets and 2 transmission shift switches.</ptxt>
<figure>
<graphic graphicname="C120810J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>