<ptxt>"Could not acquire information because the line is busy, etc." is displayed</ptxt>
</entry>
<entry colname="2" colsep="1" align="left">
<ptxt>Wait a while, change location and operate again</ptxt>
</entry>
<entry colname="3" colsep="1" valign="middle" align="center">
<ptxt>-</ptxt>
</entry>
</row>
