<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001I_S000I" variety="S000I">
<name>Door Lock</name>
<ttl id="1001I_S000I_746FY_T00BZ" variety="T00BZ">
<name>Indoor Electrical Key Oscillator (Installed on Rear Floor)</name>
<para id="RM000001J4O00FX" category="A" type-id="30014" name-id="622OK-00" from="200612">
<name>Installation</name>
<subpara id="RM000001J4O00FX_02" type-id="01" category="01">
<s-1 id="RM000001J4O00FX_02_0027" proc-id="RM0550J___0000BG900000">
<ptxt>Install Indoor Electrical Key Oscillator</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the indoor electrical key oscillator with the bolt.</ptxt>
<figure>
<graphic graphicname="B155926" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001J4O00FX_02_0016" proc-id="RM0550J___000083300000">
<ptxt>Install Rear Seat Assembly RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Set the rear seat assembly RH in the vehicle, and install the 2 rear side bolts in the order inner → outer.</ptxt>
<torque>
<torqueitem>
<t-value1>42</t-value1>
<t-value2>428</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155443" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Raise the seatback, and install the 2 front side bolts of the rear seat assembly RH in the order inner → outer.</ptxt>
<torque>
<torqueitem>
<t-value1>42</t-value1>
<t-value2>428</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155442" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4O00FX_02_0017" proc-id="RM0550J___000083400000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the rear seat cushion hinge cover NO.2.</ptxt>
<figure>
<graphic graphicname="B162910" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4O00FX_02_0018" proc-id="RM0550J___000083500000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the rear seat cushion hinge cover NO.1.</ptxt>
<figure>
<graphic graphicname="B161942" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4O00FX_02_0019">
<ptxt>Install Rear Seat Headrest Assembly Center</ptxt>
</s-1>
<s-1 id="RM000001J4O00FX_02_0020">
<ptxt>Install Rear Seat Headrest Assembly</ptxt>
</s-1>
<s-1 id="RM000001J4O00FX_02_0025" proc-id="RM0550J___00009ZO00000">
<ptxt>Install Rear Door Scuff Plate RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 8 claws to install the rear door scuff plate RH.</ptxt>
<figure>
<graphic graphicname="B152871" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4O00FX_02_0021" proc-id="RM0550J___000084H00000">
<ptxt>Install Rear Seat Assembly LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Set the rear seat assembly LH in the vehicle, and install the 2 rear side bolts in the order inner → outer.</ptxt>
<torque>
<torqueitem>
<t-value1>42</t-value1>
<t-value2>428</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155445" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Raise the seatback, and install the 2 front side bolts of the rear seat assembly LH in the order inner → outer.</ptxt>
<torque>
<torqueitem>
<t-value1>42</t-value1>
<t-value2>428</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155444" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4O00FX_02_0022" proc-id="RM0550J___000084I00000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws to install the rear seat cushion hinge cover NO.2.</ptxt>
<figure>
<graphic graphicname="B162912" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4O00FX_02_0023" proc-id="RM0550J___000084J00000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the rear seat cushion hinge cover NO.1.</ptxt>
<figure>
<graphic graphicname="B162911" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4O00FX_02_0024">
<ptxt>Install Rear Seat Headrest Assembly</ptxt>
</s-1>
<s-1 id="RM000001J4O00FX_02_0026" proc-id="RM0550J___00009ZV00000">
<ptxt>Install Rear Door Scuff Plate LH
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Install using the same procedure as for the RH side.</ptxt>
</atten4>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
