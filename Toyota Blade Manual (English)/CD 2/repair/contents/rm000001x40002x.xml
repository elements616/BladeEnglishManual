<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="05">
<name>Suspension</name>
<section id="1002I_S0016" variety="S0016">
<name>Suspension</name>
<ttl id="1002I_S0016_7450E_T00AP" variety="T00AP">
<name>Trailing Arm Assembly Rear</name>
<para id="RM000001X40002X" category="A" type-id="80001" name-id="421GV-00" from="200612">
<name>Removal</name>
<subpara id="RM000001X40002X_02" type-id="01" category="01">
<s-1 id="RM000001X40002X_02_0009">
<ptxt>Remove Rear Tire</ptxt>
</s-1>
<s-1 id="RM000001X40002X_02_0010" proc-id="RM0550J___000086H00000">
<ptxt>Disconnect Parking Brake Cable Assembly NO.3</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and disconnect the parking brake cable assembly NO.3 from the trailing arm assembly rear.</ptxt>
<figure>
<graphic graphicname="C149530" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X40002X_02_0014" proc-id="RM0550J___00008CJ00000">
<ptxt>Disconnect Skid Control Sensor Wire (Drive Type FF)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the clamp.</ptxt>
<figure>
<graphic graphicname="C160795" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and disconnect the skid control sensor wire.</ptxt>
<figure>
<graphic graphicname="C161442" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X40002X_02_0011" proc-id="RM0550J___000086I00000">
<ptxt>Disconnect Speed Sensor Rear LH (Drive Type 4WD)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the clamp.</ptxt>
<figure>
<graphic graphicname="C149531" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and disconnect the speed sensor rear LH.</ptxt>
<figure>
<graphic graphicname="C149532" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X40002X_02_0012" proc-id="RM0550J___000086J00000">
<ptxt>Disconnect Rear Suspension Arm Assembly NO.1 LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and nut, and disconnect the rear suspension arm assembly NO.1 LH from the rear suspension member assembly.</ptxt>
<figure>
<graphic graphicname="C149529" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Hold the nut and loosen the bolt.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X40002X_02_0013" proc-id="RM0550J___000086K00000">
<ptxt>Remove Trailing Arm Assembly Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and remove the trailing arm assembly rear.</ptxt>
<figure>
<graphic graphicname="C149533" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>