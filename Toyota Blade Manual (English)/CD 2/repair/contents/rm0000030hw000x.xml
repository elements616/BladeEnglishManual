<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001H_S0001" variety="S0001">
<name>Seat</name>
<ttl id="1001H_S0001_74605_T00BN" variety="T00BN">
<name>Rear Seat Assembly LH</name>
<para id="RM0000030HW000X" category="A" type-id="80002" name-id="791BW-00" from="200612">
<name>Disassembly</name>
<subpara id="RM0000030HW000X_01" type-id="01" category="01">
<s-1 id="RM0000030HW000X_01_0001" proc-id="RM0550J___000083U00000">
<ptxt>Remove Rear Seatback Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt> Using a Torx socket wrench T45, remove the 2 Torx bolts, 2 bushings and rear seatback assembly LH.</ptxt>
<figure>
<graphic graphicname="B155464" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0002" proc-id="RM0550J___000083V00000">
<ptxt>Remove Rear Seatback Lock Control Lever w/ Base</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws.</ptxt>
<figure>
<graphic graphicname="B155504" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 3 claws and remove the rear seatback lock control lever w/ base.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0003" proc-id="RM0550J___000083W00000">
<ptxt>Remove Rear Seat Lock Control Lever NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide rear seat lock control lever NO.1 as shown in the illustration to remove it.</ptxt>
<figure>
<graphic graphicname="B158201" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0004" proc-id="RM0550J___000083X00000">
<ptxt>Remove Rear Seat Lock Base</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 3 claws and remove the rear seat lock base.</ptxt>
<figure>
<graphic graphicname="B155506" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0005" proc-id="RM0550J___000083Y00000">
<ptxt>Remove Rear Seatback Lock Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws and rear seatback lock cover LH.</ptxt>
<figure>
<graphic graphicname="B155466" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0006" proc-id="RM0550J___000083Z00000">
<ptxt>Remove Rear Seatback Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the rear seatback cover.</ptxt>
<figure>
<graphic graphicname="B155467" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0007" proc-id="RM0550J___000084000000">
<ptxt>Remove Rear Seatback Board Carpet Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a clip remover, remove the 2 clips.</ptxt>
<figure>
<graphic graphicname="B155468" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a clip remover, remove the 2 clips.</ptxt>
<figure>
<graphic graphicname="B155469" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Detach each J hook and remove the rear seatback board carpet assembly LH.</ptxt>
<figure>
<graphic graphicname="B155470" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0008" proc-id="RM0550J___000084100000">
<ptxt>Remove Rear Seat Headrest Support</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the 2 rear seat headrest supports.</ptxt>
<figure>
<graphic graphicname="B162923" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0009" proc-id="RM0550J___000084200000">
<ptxt>Remove Separate Type Rear Seatback Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the separate type rear seatback cover w/ pad from the rear seatback frame sub-assembly LH.</ptxt>
</s2>
<s2>
<ptxt>Remove the 10 hog rings and separate type rear seatback cover LH.</ptxt>
<figure>
<graphic graphicname="B155475J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0010" proc-id="RM0550J___000084300000">
<ptxt>Remove Rear Seatback Lock Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and rear seatback lock assembly LH.</ptxt>
<figure>
<graphic graphicname="B155476" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HW000X_01_0011" proc-id="RM0550J___000084400000">
<ptxt>Remove Separate Type Rear Seat Cushion Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the 13 J hooks and remove the separate type rear seat cushion cover w/ pad.</ptxt>
<figure>
<graphic graphicname="B155477" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 6 hog rings and separate type rear seat cushion cover LH.</ptxt>
<figure>
<graphic graphicname="B155478J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>