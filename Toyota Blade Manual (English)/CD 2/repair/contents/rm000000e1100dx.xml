<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1001Y_S000S" variety="S000S">
<name>CVT</name>
<ttl id="1001Y_S000S_744H5_T007Q" variety="T007Q">
<name>Neutral Start Switch Assembly</name>
<para id="RM000000E1100DX" category="A" type-id="80001" name-id="32244-00" from="200612">
<name>Removal</name>
<subpara id="RM000000E1100DX_01" type-id="01" category="01">
<s-1 id="RM000000E1100DX_01_0014">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM000000E1100DX_01_0013" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000E1100DX_01_0009" proc-id="RM0550J___0000BJ400000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000E1100DX_01_0010" proc-id="RM0550J___000030C00000">
<ptxt>Remove Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the battery tray.</ptxt>
<figure>
<graphic graphicname="A162914" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Detach the 2 clamps and disconnect the wire harness from the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Remove the 4 bolts and battery carrier.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000E1100DX_01_0011" proc-id="RM0550J___000036A00000">
<ptxt>Remove Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and battery carrier No.2.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000000E1100DX_01_0004" proc-id="RM0550J___000043700000">
<ptxt>Disconnect Transmission Control Cable Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Move the shift lever to the N range, remove the nut and disconnect the control cable from the control shaft lever.</ptxt>
<figure>
<graphic graphicname="A159727" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the clip and disconnect the transmission control cable assembly from the control cable bracket.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E1100DX_01_0002" proc-id="RM0550J___000043600000">
<ptxt>Remove Neutral Start Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the neutral start switch assembly connector.</ptxt>
</s2>
<s2>
<ptxt>Remove the nut and spring washer, and remove the control shaft lever.</ptxt>
<figure>
<graphic graphicname="C128919" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a flat-head screwdriver, unstake the nut stopper, and remove the lock nut and nut stopper.</ptxt>
<figure>
<graphic graphicname="C091666J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and neutral start switch assembly.</ptxt>
<figure>
<graphic graphicname="C069812" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>