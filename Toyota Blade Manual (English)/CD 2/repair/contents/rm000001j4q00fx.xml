<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001I_S000I" variety="S000I">
<name>Door Lock</name>
<ttl id="1001I_S000I_746FY_T00BZ" variety="T00BZ">
<name>Indoor Electrical Key Oscillator (Installed on Rear Floor)</name>
<para id="RM000001J4Q00FX" category="A" type-id="80001" name-id="622OL-00" from="200612">
<name>Removal</name>
<subpara id="RM000001J4Q00FX_02" type-id="01" category="01">
<s-1 id="RM000001J4Q00FX_02_0013">
<ptxt>Remove Rear Seat Headrest Assembly</ptxt>
</s-1>
<s-1 id="RM000001J4Q00FX_02_0014">
<ptxt>Remove Rear Seat Headrest Assembly Center</ptxt>
</s-1>
<s-1 id="RM000001J4Q00FX_02_0015" proc-id="RM0550J___000081T00000">
<ptxt>Remove Rear Seat Cushion Hinge Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the rear seat cushion hinge cover NO.1.</ptxt>
<figure>
<graphic graphicname="B161942" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4Q00FX_02_0016" proc-id="RM0550J___000081U00000">
<ptxt>Remove Rear Seat Cushion Hinge Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the rear seat cushion hinge cover NO.2.</ptxt>
<figure>
<graphic graphicname="B162910" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4Q00FX_02_0017" proc-id="RM0550J___000081V00000">
<ptxt>Remove Rear Seat Assembly RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 front side bolts of the rear seat assembly RH.</ptxt>
<figure>
<graphic graphicname="B155442" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Fold the rear seat assembly RH forward.</ptxt>
<figure>
<graphic graphicname="B155443" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 rear side bolts and remove the rear seat assembly RH.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001J4Q00FX_02_0022" proc-id="RM0550J___00009X600000">
<ptxt>Remove Rear Door Scuff Plate RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 8 claws and remove the rear door scuff plate RH.</ptxt>
<figure>
<graphic graphicname="B152871" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4Q00FX_02_0018">
<ptxt>Remove Rear Seat Headrest Assembly</ptxt>
</s-1>
<s-1 id="RM000001J4Q00FX_02_0019" proc-id="RM0550J___000083R00000">
<ptxt>Remove Rear Seat Cushion Hinge Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the rear seat cushion hinge cover NO.1.</ptxt>
<figure>
<graphic graphicname="B162911" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4Q00FX_02_0020" proc-id="RM0550J___000083S00000">
<ptxt>Remove Rear Seat Cushion Hinge Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the rear seat cushion hinge cover NO.2.</ptxt>
<figure>
<graphic graphicname="B162912" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4Q00FX_02_0021" proc-id="RM0550J___000083T00000">
<ptxt>Remove Rear Seat Assembly LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 front side bolts.</ptxt>
<figure>
<graphic graphicname="B155444" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Fold the rear seat assembly LH forward.</ptxt>
<figure>
<graphic graphicname="B155445" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 rear side bolts and remove the rear seat assembly LH.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001J4Q00FX_02_0023" proc-id="RM0550J___00009XD00000">
<ptxt>Remove Rear Door Scuff Plate LH
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove using the same procedure as for the RH side.</ptxt>
</atten4>
</content1></s-1>
<s-1 id="RM000001J4Q00FX_02_0012" proc-id="RM0550J___00008MI00000">
<ptxt>Remove Indoor Electrical Key Oscillator</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="B155926" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and remove the indoor electrical key oscillator.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>