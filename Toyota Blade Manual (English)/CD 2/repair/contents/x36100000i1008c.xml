<name>Driveline/Axle</name>
<section id="1000K_S0015" variety="S0015">
<name>Differential</name>
<ttl id="1000K_S0015_744ZW_T00A7" variety="T00A7">
<name>Active Torque Control 4WD System</name>
<para id="X36100000I1008C" category="C" type-id="301CH" name-id="370ED-00" from="200612">
<dtccode>C1280/82</dtccode>
<dtcname>Engine System Malfunction</dtcname>
<subpara id="X36100000I1008C_10" type-id="33" category="03" proc-id="RM0550J___00005IW00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>If a malfunction occurs in the EFI system, the 4WD control computer assembly outputs DTC C1280/82.</ptxt>
<table frame="all" colsep="1" rowsep="1" pgwide="1">
<tgroup cols="3" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="1.35in"/>
<colspec colnum="02" colname="C02" colwidth="2.97in"/>
<colspec colnum="03" colname="C03" colwidth="2.76in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>DTC No</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry colname="C03" valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>C1280/82</ptxt>
</entry>
<entry colname="C02" valign="middle" align="left">
<ptxt>Engine malfunction signal continues for 5 seconds or more</ptxt>
</entry>
<entry colname="C03" valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>EFI System</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
<item>
<ptxt>4WD Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="X36100000I1008C_11" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="X36100000I1008C_12" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X36100000I1008C_12_0001" proc-id="RM0550J___00005IX00000">
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Turn the IG ON and read the EFI system DTCs following the SST (TaSCAN) screen display.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>No DTC output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>DTC output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X36100000I1008C_12_0003" fin="true">A</down>
<right ref="X36100000I1008C_12_0002" fin="true">B</right>
</res>
</testgrp>
<testgrp id="X36100000I1008C_12_0003">
<testtitle>Replace 4WD computer assembly<xref label="Seep01" href="RM000002WLE001X"/>
</testtitle>
</testgrp>
<testgrp id="X36100000I1008C_12_0002">
<testtitle>Go to Relevant DTC<xref label="Seep01" href="X39400000QT013D"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
