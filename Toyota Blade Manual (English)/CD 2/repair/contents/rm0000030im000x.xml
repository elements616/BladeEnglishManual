<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002X_S000H" variety="S000H">
<name>Body Exterior</name>
<ttl id="1002X_S000H_7460C_T00BP" variety="T00BP">
<name>Rear Bumper</name>
<para id="RM0000030IM000X" category="A" type-id="8000E" name-id="8216D-00" from="200612">
<name>Reassembly</name>
<subpara id="RM0000030IM000X_01" type-id="01" category="01">
<s-1 id="RM0000030IM000X_01_0003" proc-id="RM0550J___00008F900000">
<ptxt>Install Rear Bumper Side Retainer LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 2 claws.</ptxt>
<figure>
<graphic graphicname="B167165" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the rear bumper side retainer LH with the 2 screws.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IM000X_01_0004" proc-id="RM0550J___00008FA00000">
<ptxt>Install Rear Bumper Side Retainer RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Install it in the same way as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IM000X_01_0001" proc-id="RM0550J___00008F700000">
<ptxt>Install Rear Bumper Retainer Upper LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 2 claws.</ptxt>
<figure>
<graphic graphicname="B167166" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the rear bumper retainer UPR LH with the screw.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IM000X_01_0002" proc-id="RM0550J___00008F800000">
<ptxt>Install Rear Bumper Retainer Upper RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Install it in the same way as for the LH side</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IM000X_01_0010" proc-id="RM0550J___00000ON00000">
<ptxt>Install License Plate Light Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector.</ptxt>
<figure>
<graphic graphicname="E147016" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the claws and install the license plate light assembly.</ptxt>
<figure>
<graphic graphicname="E147299" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030IM000X_01_0011" proc-id="RM0550J___0000C7600000">
<ptxt>Install Rear Bumper Retainer Lower RH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the claw and install the rear bumper retainer lower RH.</ptxt>
<figure>
<graphic graphicname="B168878" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IM000X_01_0006" proc-id="RM0550J___0000AQ800000">
<ptxt>Install Reflex Reflector Assembly RH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the reflex reflector assembly RH with the screw.</ptxt>
<figure>
<graphic graphicname="B167164" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IM000X_01_0008" proc-id="RM0550J___0000BGU00000">
<ptxt>Install Reflex Reflector Assembly LH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Install it in the same way as for the RH side</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IM000X_01_0007" proc-id="RM0550J___0000AQ900000">
<ptxt>Install Rear Bumper Guard</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Temporarily install the rear bumper guard with the 6 outside molding retainers.</ptxt>
<figure>
<graphic graphicname="B167162" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the rear bumper guard with the 3 clips.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>