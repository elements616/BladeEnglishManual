<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1002M_S001G" variety="S001G">
<name>Pre-crash Safety</name>
<ttl id="1002M_S001G_74WT7_T00FP" variety="T00FP">
<name>Pre-crash Safety System</name>
<para id="RM000000DBG00JX" category="C" type-id="8007V" name-id="540JR-00" from="200708">
<dtccode>U0235/31</dtccode>
<dtcname>Radar → Distance Control Communication Malfunction</dtcname>
<subpara id="RM000000DBG00JX_01" type-id="31" category="03" proc-id="RM0550J___0000CV500000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<table frame="all" pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="col1" colwidth="1.00in"/>
<colspec colname="col2" colwidth="3.00in"/>
<colspec colname="col3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U0235/31</ptxt>
</entry>
<entry valign="middle">
<ptxt>Communication from the millimeter wave radar sensor assembly to the distance control computer assembly is abnormal or interrupted</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Radar cruise control system</ptxt>
</item>
<item>
<ptxt>Seat Belt Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000DBG00JX_03" type-id="51" category="05" proc-id="RM0550J___0000CV600000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>A poor connector connection is a possible cause of this DTC, so make sure that each connector is securely connected.</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000000DBG00JX_05" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DBG00JX_05_0007" proc-id="RM0550J___0000CV700000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn the ignition switch ON and record the DTCs according to the SST (TaSCAN) screen. (see <xref label="Seep01" href="RM0000006EM00JX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000DBG00JX_05_0010" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000DBG00JX_05_0010">
<testtitle>Go to radar cruise control system (U0237/71)<xref label="Seep01" href="RM00000064N00DX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>