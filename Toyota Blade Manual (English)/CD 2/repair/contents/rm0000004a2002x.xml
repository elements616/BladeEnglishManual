<name>Side Mudguard LH</name>
<para id="RM0000004A2002X" category="A" type-id="80001" name-id="82163-00" from="200612">
<name>Removal</name>
<subpara id="RM0000004A2002X_04" type-id="01" category="01">
<s-1 id="RM0000004A2002X_04_0006" proc-id="RM0550J___00008FR00000">
<ptxt>Remove Side Mudguard Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply protective tape around the side mudguard assembly LH.</ptxt>
<figure>
<graphic graphicname="B164522J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 screws and 9 retainers.</ptxt>
</s2>
<s2>
<ptxt>Disengage the 9 clips and remove the side mudguard assembly LH.</ptxt>
<figure>
<graphic graphicname="B164523" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
