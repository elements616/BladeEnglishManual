<ttl id="1001K_S001B_746H7_T00C7" variety="T00C7">
<name>Hood Sub-assembly</name>
<para id="RM0000007RC009X" category="N" type-id="3000G" name-id="80154-00" from="200612">
<name>Adjustment</name>
<subpara id="RM0000007RC009X_02" type-id="01" category="01">
<s-1 id="RM0000007RC009X_02_0029" proc-id="RM0550J___00009QK00000">
<ptxt>Inspect Hood Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that each clearance dimension is within the reference value.</ptxt>
<figure>
<graphic graphicname="B167272J01" width="7.106578999in" height="3.779676365in"/>
</figure>
<spec>
<title>Reference Value</title>
<table pgwide="1">
<tgroup cols="4">
<colspec colname="COL1" align="center" colwidth="1.06in"/>
<colspec colname="COL2" align="center" colwidth="2.48in"/>
<colspec colname="COL3" align="center" colwidth="1.06in"/>
<colspec colname="COL4" align="center" colwidth="2.48in"/>
<tbody>
<row>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
<entry valign="middle">
<ptxt>6.2±1.5 mm</ptxt>
</entry>
<entry valign="middle">
<ptxt>D</ptxt>
</entry>
<entry valign="middle">
<ptxt>3.8±1.5 mm</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
<entry valign="middle">
<ptxt>4.3±1.5 mm</ptxt>
</entry>
<entry valign="middle">
<ptxt>E</ptxt>
</entry>
<entry valign="middle">
