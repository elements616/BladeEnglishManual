<dtccode>P0100/31</dtccode>
<dtcname>Air Flow Meter Open Circuit</dtcname>
<dtccode>P0102/31</dtccode>
<dtcname>Air Flow Meter Open Circuit (Low)</dtcname>
<dtccode>P0103/31</dtccode>
