<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_744EC_T004Y" variety="T004Y">
<name>E.F.I. Water Temperature Sensor (2AZ-FE)</name>
<para id="RM0000030JX000X" category="A" type-id="80001" name-id="065BH-00" from="200612">
<name>Removal</name>
<subpara id="RM0000030JX000X_01" type-id="01" category="01">
<s-1 id="RM0000030JX000X_01_0005">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM0000030JX000X_01_0006" proc-id="RM0550J___000030H00000">
<ptxt>Drain Coolant (Toyota Genuine Super Long Life Coolant)
</ptxt>
<content1 releasenbr="1">
<atten2>
<ptxt>To avoid the danger of being burned, do not remove the reservoir tank cap while the engine and radiator are still hot. Liquid and steam will spray out under pressure.</ptxt>
</atten2>
<s2>
<ptxt>Loosen the radiator drain cock plug.</ptxt>
</s2>
<s2>
<ptxt>Remove the radiator cap and drain the coolant.</ptxt>
</s2>
<s2>
<ptxt>Loosen the cylinder block drain cock plug and drain the coolant from the engine.</ptxt>
<figure>
<graphic graphicname="A160380J01" width="7.106578999in" height="4.7836529in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX000X_01_0001" proc-id="RM0550J___00004DZ00000">
<ptxt>Remove Engine Cover Sub-assembly NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 nuts and engine cover assembly No.1.</ptxt>
<figure>
<graphic graphicname="A159817" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX000X_01_0002" proc-id="RM0550J___00002ZP00000">
<ptxt>Remove Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the ventilation hose.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the vacuum switching valve connector and clamp, and disconnect the wire harness.</ptxt>
<figure>
<graphic graphicname="A163392" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the fuel vapor feed hose and fuel vapor feed hose No.2.  </ptxt>
</s2>
<s2>
<ptxt>Disconnect the intake air flow meter connector and clamp, and disconnect the wire harness from the air cleaner cap.</ptxt>
<figure>
<graphic graphicname="A162887" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Lock air cleaner hose clamp No.1.</ptxt>
<figure>
<graphic graphicname="A162888" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>With the clamp locked, remove the air cleaner cap w/ air cleaner hose. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX000X_01_0003" proc-id="RM0550J___000030900000">
<ptxt>Remove Air Cleaner Case
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the air cleaner filter element.</ptxt>
</s2>
<s2>
<ptxt>Remove the 3 bolts and clamp, and remove the air cleaner case.</ptxt>
<figure>
<graphic graphicname="A162913" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX000X_01_0004" proc-id="RM0550J___00009HZ00000">
<ptxt>Remove E.F.I. Water Temperature Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the E.F.I. water temperature sensor connector.</ptxt>
<figure>
<graphic graphicname="A162900" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST, remove the E.F.I. water temperature sensor and gasket.</ptxt>
<figure>
<graphic graphicname="A162901" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09817-33190</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>