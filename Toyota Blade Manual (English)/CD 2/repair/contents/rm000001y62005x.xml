<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_74X9V_T00G9" variety="T00G9">
<name>Engine Mounting Insulator Rear (2GR-FE)</name>
<para id="RM000001Y62005X" category="A" type-id="80001" name-id="0725D-00" from="200708">
<name>Removal</name>
<subpara id="RM000001Y62005X_01" type-id="01" category="01">
<s-1 id="RM000001Y62005X_01_0009" proc-id="RM0550J___0000EUK00000">
<ptxt>Remove Engine Under Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 5 clips and engine under cover No.2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y62005X_01_0010" proc-id="RM0550J___0000F3D00000">
<ptxt>Disconnect Transmission Control Cable Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and disconnect the transmission control cable support from the engine mounting insulator rear.</ptxt>
<figure>
<graphic graphicname="A178720" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y62005X_01_0008" proc-id="RM0550J___0000FQG00000">
<ptxt>Disconnect Engine Mounting Insulator Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Support the engine assembly w/ transaxle with a transmission jack using a wooden block or similar.</ptxt>
<figure>
<graphic graphicname="A162930J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and disconnect the engine mounting insulator rear from the engine mounting bracket rear.</ptxt>
<figure>
<graphic graphicname="A136940" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y62005X_01_0003" proc-id="RM0550J___0000EPR00000">
<ptxt>Remove Engine Mounting Insulator Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and 2 nuts, and remove the engine mounting insulator rear from the front suspension crossmember.</ptxt>
<figure>
<graphic graphicname="A124842" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>