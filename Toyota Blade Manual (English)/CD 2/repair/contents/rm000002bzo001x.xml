<name>Speaker Assembly Front NO.2</name>
<para id="RM000002BZO001X" category="A" type-id="30014" name-id="641JV-00" from="200612">
<name>Installation</name>
<subpara id="RM000002BZO001X_01" type-id="01" category="01">
<s-1 id="RM000002BZO001X_01_0003" proc-id="RM0550J___000018L00000">
<ptxt>Install Speaker Assembly Front NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 claws to install speaker assembly FR NO.2.</ptxt>
<figure>
<graphic graphicname="E137090" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002BZO001X_01_0005" proc-id="RM0550J___00009SR00000">
<ptxt>Install Front Door Trim Board Sub-assembly RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws to install the front door trim board RH to the front door glass weatherstrip inner RH.</ptxt>
<figure>
<graphic graphicname="B153617" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 9 clips to install the front door trim board RH to the front door panel.</ptxt>
</s2>
<s2>
<ptxt>Install the 3 screws.</ptxt>
<figure>
<graphic graphicname="B157312" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002BZO001X_01_0006" proc-id="RM0550J___00009SS00000">
<ptxt>Install Door Assist Grip Cover RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws to install the door assist grip cover RH to the front door trim board RH.</ptxt>
<figure>
<graphic graphicname="B153616" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002BZO001X_01_0007" proc-id="RM0550J___00009ST00000">
<ptxt>Install Front Door Inside Handle Bezel RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 claws to install the front door inside handle bezel RH to the front door trim board RH.</ptxt>
<figure>
<graphic graphicname="B153614" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
