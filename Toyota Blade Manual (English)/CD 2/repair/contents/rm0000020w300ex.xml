<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74XTX_T00H7" variety="T00H7">
<name>Air Fuel Ratio Sensor (2GR-FE)</name>
<para id="RM0000020W300EX" category="A" type-id="80001" name-id="066QB-00" from="200708">
<name>Removal</name>
<subpara id="RM0000020W300EX_03" type-id="01" category="01">
<s-1 id="RM0000020W300EX_03_0013" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020W300EX_03_0017" proc-id="RM0550J___0000EUJ00000">
<ptxt>Remove Engine Under Cover
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 4 screws, and remove the engine under cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020W300EX_03_0018" proc-id="RM0550J___0000EUI00000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020W300EX_03_0053" proc-id="RM0550J___0000H3200000">
<ptxt>Remove Air Fuel Ratio Sensor NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the air fuel ratio sensor No.2 connector.</ptxt>
</s2>
<s2>
<ptxt>Using SST, disconnect the air fuel ratio sensor No.2 from the exhaust manifold.</ptxt>
<figure>
<graphic graphicname="A135166J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W300EX_03_0060" proc-id="RM0550J___0000HJ200000">
<ptxt>Remove Exhaust Pipe Assembly Center</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the oxygen sensor connector and clamp.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 nuts and 2 bolts.</ptxt>
<figure>
<graphic graphicname="A135140J05" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and 2 compression springs, and remove the exhaust center pipe assembly.</ptxt>
<figure>
<graphic graphicname="A135137J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W300EX_03_0061" proc-id="RM0550J___0000FBG00000">
<ptxt>Remove Exhaust Pipe Assembly Front
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the NO.2 oxygen sensor connector and, using SST, remove the oxygen sensor.</ptxt>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="A177020" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and exhaust pipe bracket.</ptxt>
<figure>
<graphic graphicname="A179449" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 nuts and exhaust pipe assembly front.</ptxt>
<figure>
<graphic graphicname="A179450" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the gasket.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020W300EX_03_0062" proc-id="RM0550J___0000HAO00000">
<ptxt>Remove Exhaust Manifold Sub-assembly RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the air fuel ratio sensor connector.</ptxt>
</s2>
<s2>
<ptxt>Remove the 6 nuts and the exhaust manifold RH.</ptxt>
<figure>
<graphic graphicname="A182103" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020W300EX_03_0056" proc-id="RM0550J___0000H3500000">
<ptxt>Remove Air Fuel Ratio Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, remove the air fuel ratio sensor.</ptxt>
<figure>
<graphic graphicname="A176286J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>