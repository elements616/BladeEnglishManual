<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="08">
<name>Heater &amp; Air Conditioner/Ventilation</name>
<section id="1002K_S000B" variety="S000B">
<name>Air Conditioner</name>
<ttl id="1002K_S000B_7421W_T0026" variety="T0026">
<name>Refrigerant HFC-134a[R134a]</name>
<para id="RM000000N8300CX" category="N" type-id="3000G" name-id="52299-00" from="200612">
<name>Adjustment</name>
<subpara id="RM000000N8300CX_01" type-id="01" category="01">
<s-1 id="RM000000N8300CX_01_0001" proc-id="RM0550J___00000ZB00000">
<ptxt>Discharge Refrigerant HFC-134a (R134a)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Operate the A/C under the following conditions.</ptxt>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Engine Speed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Idling</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Operating time</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>3 minutes or more</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>A/C Switch</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ON</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Blower level</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>HI</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Set Temperature</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>MAX COOL</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten3>
<ptxt>If the A/C cannot be operated due to compressor lock etc., operation is not necessary.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Stop the engine.</ptxt>
</s2>
<s2>
<ptxt>Connect a refrigerant recovery/recycling machine and recover the refrigerant gas.</ptxt>
<atten3>
<ptxt>When using a refrigerant recovery/recycling machine, use it correctly according to its instruction manual.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000000N8300CX_01_0002" proc-id="RM0550J___00000ZC00000">
<ptxt>Charge Refrigerant HFC-134a (R134a)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Evacuate the system using a vacuum pump.</ptxt>
</s2>
<s2>
<ptxt>Charge with refrigerant HFC-134a (R134a).</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt>440±50g</ptxt>
</specitem>
</spec>
<atten3>
<ptxt>Never operate the cooler compressor before charging refrigerant, as operating it without refrigerant may cause it to seize due to insufficient lubrication.</ptxt>
</atten3>
<atten4>
<ptxt>When reusing recovered refrigerant gas, the recovery rate of the refrigerant recovery/recycling machine is approximately 90%, so additional refrigerant from a service can is required when recharging; prepare it in advance.</ptxt>
</atten4>
<figure>
<graphic graphicname="E143108J02" width="7.106578999in" height="4.7836529in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000N8300CX_01_0003" proc-id="RM0550J___00000ZD00000">
<ptxt>Engine Warm-up</ptxt>
<content1 releasenbr="1">
<atten3>
<ptxt>After charging with refrigerant, perform a break-in operation at 2000r/min or less for 2 minutes or more.</ptxt>
</atten3>
</content1>
</s-1>
<s-1 id="RM000000N8300CX_01_0004" proc-id="RM0550J___00000ZE00000">
<ptxt>Refrigerant Gas Leak Inspection</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>After charging the refrigerant gas, inspect for refrigerant gas leaks using a halogen leak detector.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>