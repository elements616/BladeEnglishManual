<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7421I_T001V" variety="T001V">
<name>Headlight NO.1 Bulb</name>
<para id="RM0000022H5002X" category="A" type-id="80001" name-id="603IV-00" from="200612">
<name>Removal</name>
<subpara id="RM0000022H5002X_01" type-id="01" category="01">
<s-1 id="RM0000022H5002X_01_0008" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000022H5002X_01_0011" proc-id="RM0550J___0000BAN00000">
<ptxt>Remove Air Cleaner Inlet NO.1</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E146997" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Remove the clip.</ptxt>
</s2>
<s2>
<ptxt>Disengage the claw and remove the air cleaner inlet NO.1.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000022H5002X_01_0003" proc-id="RM0550J___00000U700000">
<ptxt>Remove Headlight NO.1 Bulb</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Turn the headlight bulb NO.1 in the direction indicated by the arrow in the illustration and remove it.</ptxt>
<figure>
<graphic graphicname="E146994" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
