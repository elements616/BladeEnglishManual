<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10007_S000L" variety="S000L">
<name>Fuel</name>
<ttl id="10007_S000L_74XT8_T00GM" variety="T00GM">
<name>Fuel Suction Tube Assembly (w/ Pump &amp; Gauge) (2GR-FE)</name>
<para id="RM000002AB8005X" category="A" type-id="8000E" name-id="081B2-00" from="200708">
<name>Reassembly</name>
<subpara id="RM000002AB8005X_03" type-id="01" category="01">
<s-1 id="RM000002AB8005X_03_0016" proc-id="RM0550J___0000HCX00000">
<ptxt>Install Fuel Pressure Regulator Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply gasoline to 2 new O-rings and install them to the fuel pressure regulator.</ptxt>
<figure>
<graphic graphicname="A148186J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the fuel pressure regulator to the fuel filter.</ptxt>
<figure>
<graphic graphicname="A130364" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002AB8005X_03_0017" proc-id="RM0550J___0000HCY00000">
<ptxt>Install Fuel Pump</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply gasoline to a new O-ring and install it to the fuel filter.</ptxt>
<figure>
<graphic graphicname="A125203J02" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the fuel pump harness connector.</ptxt>
<figure>
<graphic graphicname="A126130" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 5 claws of the filter and install the fuel pump.</ptxt>
<figure>
<graphic graphicname="A126129" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002AB8005X_03_0018" proc-id="RM0550J___0000HCZ00000">
<ptxt>Install Fuel Suction Support NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the fuel suction support No.1.</ptxt>
<figure>
<graphic graphicname="A126816" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002AB8005X_03_0019" proc-id="RM0550J___0000HD000000">
<ptxt>Install Fuel Pump Assembly w/ Filter</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply gasoline to a new O-ring and install it to the jet pump.</ptxt>
<figure>
<graphic graphicname="A124269J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Check the positions of the 2 claws of the fuel sub-tank, engage the fuel suction support, and install the fuel filter.</ptxt>
<figure>
<graphic graphicname="A126815" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Do not apply excessive force to the fuel tube and suction support.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the jet pump aligned with its installation position on the fuel sub-tank.</ptxt>
<figure>
<graphic graphicname="A152335J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the fuel pump harness connector.</ptxt>
<figure>
<graphic graphicname="A179249" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the 2 harness clamps.</ptxt>
<atten3>
<ptxt>Do not damage the harness covering.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000002AB8005X_03_0020" proc-id="RM0550J___0000HD100000">
<ptxt>Install Fuel Sender Gauge Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the fuel sender gauge to install it.</ptxt>
<figure>
<graphic graphicname="A179248J02" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the 3 harness clamps.</ptxt>
<atten3>
<ptxt>Do not damage the harness covering.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the 2 harness protectors to the wire harness.</ptxt>
</s2>
<s2>
<ptxt>Connect the fuel sender gauge connector.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>