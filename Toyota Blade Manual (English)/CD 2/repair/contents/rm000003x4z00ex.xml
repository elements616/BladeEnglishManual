<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM000003X4Z00EX" category="C" type-id="804LY" name-id="NS4FH-11" from="200912">
<dtccode>B1585</dtccode>
<dtcname>USB-BOX connected device malfunction</dtcname>
<subpara id="RM000003X4Z00EX_01" type-id="33" category="03" proc-id="RM0550J___0000IJR00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when a malfunction occurs in the USB memory or "iPod".</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.42in"/>
<colspec colname="COL2" colwidth="2.83in"/>
<colspec colname="COL3" colwidth="2.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Diagnostic Trouble Code (DTC)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Point</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B1585</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>When a USB memory that is not mass storage class or uses an unsupported protocol is connected</ptxt>
</item>
<item>
<ptxt>When a USB memory with an unsupported file system or abnormal FAT system is connected</ptxt>
</item>
<item>
<ptxt>When the "iPod" malfunctions</ptxt>
</item>
<item>
<ptxt>When an "iPod" with an unsupported firmware version is connected</ptxt>
</item>
<item>
<ptxt>When an unsupported "iPod" model is connected</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>A USB memory or "iPod"</ptxt>
</item>
<item>
<ptxt>Multimedia Interface ECU</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000003X4Z00EX_02" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000003X4Z00EX_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000003X4Z00EX_03_0005" proc-id="RM0550J___0000IJU00000">
<testtitle>Replace USB Memory or "iPod"</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Disconnect the USB memory or "iPod" from stereo jack adapter assembly NO.1.</ptxt>
</test1>
<test1>
<ptxt>Turn the ignition OFF → ACC ON.</ptxt>
<atten4>
<ptxt>When connecting a different USB memory or "iPod", the ignition must be turned OFF for the vehicle to recognize the connected device.</ptxt>
</atten4>
</test1>
<test1>
<ptxt>Connect a normal USB memory or "iPod" to stereo jack adapter assembly NO.1.</ptxt>
<atten4>
<list1 type="unordered">
<item>
<ptxt>If using a USB memory, check with a different USB memory.</ptxt>
</item>
<item>
<ptxt>If using an "iPod", check with a different "iPod".</ptxt>
</item>
<item>
<ptxt>For supported formats and versions, refer to <xref label="Seep01" href="RM00000014J044X"/></ptxt>
</item>
</list1>
</atten4>
</test1>
</content6>
<res>
<down ref="RM000003X4Z00EX_03_0001" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000003X4Z00EX_03_0001" proc-id="RM0550J___0000IJS00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM000003X4Z00EX_03_0002" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000003X4Z00EX_03_0002" proc-id="RM0550J___0000IJT00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.83in"/>
<colspec colname="COL2" colwidth="1.30in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>No code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test1>
</content6>
<res>
<down ref="RM000003X4Z00EX_03_0003" fin="true">A</down>
<right ref="RM000003X4Z00EX_03_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000003X4Z00EX_03_0003">
<testtitle>USB memory has an unsupported format, or "iPod" has an unsupported version or is defective</testtitle>
</testgrp>
<testgrp id="RM000003X4Z00EX_03_0004">
<testtitle>Replace Multimedia Interface Computer<xref label="Seep01" href="RM000004AZJ000X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>