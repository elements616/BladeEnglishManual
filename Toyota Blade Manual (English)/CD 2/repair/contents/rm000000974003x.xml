<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001I_S000I" variety="S000I">
<name>Door Lock</name>
<ttl id="1001I_S000I_746G1_T00C2" variety="T00C2">
<name>Transmitter Battery (Smart Key)</name>
<para id="RM000000974003X" category="A" type-id="30019" name-id="622OS-00" from="200612">
<name>Replacement</name>
<subpara id="RM000000974003X_01" type-id="01" category="01">
<s-1 id="RM000000974003X_01_0001" proc-id="RM0550J___00008KN00000">
<ptxt>Remove Transmitter Battery</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Push in the release hook knob and pull out the emergency key.</ptxt>
<figure>
<graphic graphicname="B158034J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a screwdriver wrapped with protective tape, remove the transmitter housing cover.</ptxt>
<atten3>
<ptxt>Do not pry the cover forcibly.</ptxt>
</atten3>
<figure>
<graphic graphicname="B157512J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a precision screwdriver wrapped with protective tape, insert the precision screwdriver into the groove shown in the illustration and remove the battery [lithium battery (CR1632)].</ptxt>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Do not press the terminal with your fingers.</ptxt>
</item>
<item>
<ptxt>Forcibly prying out the battery [lithium battery (CR1632)] will deform the terminal.</ptxt>
</item>
</list1>
</atten3>
<figure>
<graphic graphicname="B159250J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000974003X_01_0002" proc-id="RM0550J___00008KO00000">
<ptxt>Install Transmitter Battery</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery [lithium battery (CR1632)].</ptxt>
<figure>
<graphic graphicname="B107853" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Install the battery with the positive side facing up.</ptxt>
</item>
<item>
<ptxt>Do not deform the terminal.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Install the transmitter housing cover.</ptxt>
<figure>
<graphic graphicname="B157513" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Insert the emergency key.</ptxt>
<figure>
<graphic graphicname="B157514" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Check that the LED on the unit comes on when any of the remote control switches is pressed.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>