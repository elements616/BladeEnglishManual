<testgrp id="RM000002BPV007X_08_0012" proc-id="RM0550J___0000BZT00000">
<testtitle>Inspect Wire Harness or Connector (Air Conditioner Amplifier Assembly - Air Conditioner Control Assembly)</testtitle>
