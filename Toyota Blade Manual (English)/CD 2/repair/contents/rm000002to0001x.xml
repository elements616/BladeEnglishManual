<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000D_S000P" variety="S000P">
<name>Lubrication</name>
<ttl id="1000D_S000P_747J6_T00DU" variety="T00DU">
<name>Engine Oil Pressure Switch Assembly (2AZ-FE)</name>
<para id="RM000002TO0001X" category="A" type-id="30014" name-id="130RJ-00" from="200612">
<name>Installation</name>
<subpara id="RM000002TO0001X_01" type-id="01" category="01">
<s-1 id="RM000002TO0001X_01_0001" proc-id="RM0550J___0000BWZ00000">
<ptxt>Install Engine Oil Pressure Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply adhesive 1324 to the threads.</ptxt>
<figure>
<graphic graphicname="A146156J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a deep socket wrench 24mm, install the oil pressure switch.</ptxt>
<figure>
<graphic graphicname="A128875" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>15</t-value1>
<t-value2>153</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>After installation, leave it without starting the engine for 1 hours.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Connect the oil pressure switch connector.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>