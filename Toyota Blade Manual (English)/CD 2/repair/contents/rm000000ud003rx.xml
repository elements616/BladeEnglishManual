<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000U_S0017" variety="S0017">
<name>Steering Column</name>
<ttl id="1000U_S0017_745FS_T00B0" variety="T00B0">
<name>Steering Column Assembly</name>
<para id="RM000000UD003RX" category="A" type-id="80002" name-id="481CJ-01" from="200912">
<name>Disassembly</name>
<subpara id="RM000000UD003RX_01" type-id="01" category="01">
<s-1 id="RM000000UD003RX_01_0012" proc-id="RM0550J___0000AP500001">
<ptxt>Remove Steering Intermediate Shaft Assembly NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt from steering intermediate shaft assembly No.2.</ptxt>
<figure>
<graphic graphicname="C149892" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Put matchmarks on steering intermediate shaft assembly No.2 and the steering column assembly.</ptxt>
<figure>
<graphic graphicname="C149893J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove steering intermediate shaft assembly No.2 from the steering column assembly.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000UD003RX_01_0009" proc-id="RM0550J___0000AP400001">
<ptxt>Remove Steering Lock Actuator Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Secure the steering column assembly in a vise with aluminum plates.</ptxt>
<atten3>
<ptxt>Do not overtighten the vise.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Using a drill, make a hole in the steering lock set bolt for a reverse tap.</ptxt>
</s2>
<s2>
<ptxt>Using a tap wrench and screw extractor, remove the steering lock set bolt and remove the steering lock actuator.</ptxt>
<figure>
<graphic graphicname="C149895" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000UD003RX_01_0023" proc-id="RM0550J___0000IUQ00000">
<ptxt>Remove Steering Column Protector NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and remove steering column protector No.1 from the steering column assembly.</ptxt>
<figure>
<graphic graphicname="C206688" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>