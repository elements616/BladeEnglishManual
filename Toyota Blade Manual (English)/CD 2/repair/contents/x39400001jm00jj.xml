<dtccode/>
<dtcname>Magnetic clutch relay circuit</dtcname>
<subpara id="X39400001JM00JJ_10" type-id="31" category="03" proc-id="RM0550J___0000EQ200000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The air conditioner amplifier assembly operates the magnetic clutch relay to turn the magnetic clutch ON.</ptxt>
</content5>
</subpara>
<subpara id="X39400001JM00JJ_11" type-id="32" category="03" proc-id="RM0550J___0000EQ300000">
