<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001D_S0018" variety="S0018">
<name>Power Source &amp; Wire Harness</name>
<ttl id="1001D_S0018_74X4K_T00G4" variety="T00G4">
<name>Fusible Link Block Assembly (Engine Model 2GR-FE)</name>
<para id="RM000002ZZ2003X" category="A" type-id="30014" name-id="68093-00" from="200708">
<name>Installation</name>
<subpara id="RM000002ZZ2003X_01" type-id="01" category="01">
<s-1 id="RM000002ZZ2003X_01_0006" proc-id="RM0550J___0000D0200000">
<ptxt>Install Fusible Link Block Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E140932" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Connect the 3 wire harnesses to the fusible link block assembly with the 3 bolts (M5).</ptxt>
</s2>
<s2>
<ptxt>Connect the 2 connectors to the fusible link block assembly.</ptxt>
</s2>
<s2>
<ptxt> Connect the 2 wire harnesses to the fusible link block assembly with the 2 bolts (M6).</ptxt>
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="E140931" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the claw and install the fuse holder to the fusible link block assembly.</ptxt>
<figure>
<graphic graphicname="E140930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the bolt (M6).</ptxt>
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Engage the 4 claws and install the fuse holder and fusible link block assembly.</ptxt>
<figure>
<graphic graphicname="E140928" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 10 claws and assemble the upper side and lower side of the fuse block cover.</ptxt>
<figure>
<graphic graphicname="E140927" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<ptxt>Assemble securely so that the wire harness is not pinched.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZZ2003X_01_0005" proc-id="RM0550J___0000D0100000">
<ptxt>Install Engine Room Relay Block</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E155725J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Engage the guide and claw of the relay block.</ptxt>
</s2>
<s2>
<ptxt>Install the 3 bolts.</ptxt>
<torque>
<torqueitem>
<t-value1>8.4</t-value1>
<t-value2>86</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Clamp the harness.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZZ2003X_01_0004" proc-id="RM0550J___0000D0000000">
<ptxt>Install Front Fender Liner LH</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E146982" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Install the front fender liner LH with the pin hold clip and 4 clips.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZZ2003X_01_0003" proc-id="RM0550J___0000CZZ00000">
<ptxt>Connect Wire Harness</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E155210" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Connect the wire harness with the 2 nuts, 4 connectors and 2 clamps.</ptxt>
<torque>
<torqueitem>
<t-value1>8.4</t-value1>
<t-value2>86</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZZ2003X_01_0002">
<ptxt>Install Relay Block Cover Upper NO.1</ptxt>
</s-1>
<s-1 id="RM000002ZZ2003X_01_0013" proc-id="RM0550J___0000GT200000">
<ptxt>Install Engine Control Computer
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine control computer bracket with the 4 screws.</ptxt>
<figure>
<graphic graphicname="A162896" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the clamp and install the engine control computer with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A162895" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>8.0</t-value1>
<t-value2>82</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the 2 engine control computer connectors to the engine control computer.</ptxt>
<figure>
<graphic graphicname="A157544" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>When connecting the connectors, be careful not to allow foreign matter such as mud or water to adhere to the connecting parts.</ptxt>
</item>
</list1>
</atten3>
<list1 type="unordered">
<item>
<ptxt>Securely lock the lever.</ptxt>
</item>
</list1>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2003X_01_0019" proc-id="RM0550J___0000DM000000">
<ptxt>Install Air Cleaner Case
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the air cleaner case with the 3 bolts.</ptxt>
<figure>
<graphic graphicname="A178719" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>7.0</t-value1>
<t-value2>71</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the clamp.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2003X_01_0020" proc-id="RM0550J___0000F3H00000">
<ptxt>Install Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the hinge portion first, and then install the air cleaner cap w/ air cleaner hose with the 3 clamps.</ptxt>
<figure>
<graphic graphicname="A176815J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the clamp hose band. (<sup>*</sup>1)</ptxt>
</s2>
<s2>
<ptxt>Connect ventilation hose No.2. (<sup>*</sup>2)</ptxt>
</s2>
<s2>
<ptxt>Connect the air flow meter connector. (<sup>*</sup>3)</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2003X_01_0016" proc-id="RM0550J___0000DLZ00000">
<ptxt>Install Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery to the vehicle</ptxt>
</s2>
<s2>
<ptxt>Install the insulator.</ptxt>
</s2>
<s2>
<ptxt>Connect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the battery clamp with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>17</t-value1>
<t-value2>173</t-value2>
<ptxt>(Bolt)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the battery positive terminal with the nut.</ptxt>
<torque>
<torqueitem>
<t-value1>13</t-value1>
<t-value2>130</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2003X_01_0001" proc-id="RM0550J___0000CZY00000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM000002ZZ2003X_01_0017" proc-id="RM0550J___0000FQ400000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 9 clips.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2003X_01_0018" proc-id="RM0550J___0000DMG00000">
<ptxt>Install V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 clips to install the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Make sure the clips are securely engaged.</ptxt>
</item>
<item>
<ptxt>Engaging them with excessive force or striking the top of the clips may cause damage.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2003X_01_0012" proc-id="RM0550J___0000D0800000">
<ptxt>Settings Required when Replacing or Removing/Installing Parts</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYX00ZX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000002ZZ2003X_01_0007" proc-id="RM0550J___0000D0300000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW011X"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
