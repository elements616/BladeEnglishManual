<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1000Y_S0012" variety="S0012">
<name>SRS Airbag</name>
<ttl id="1000Y_S0012_744XQ_T009B" variety="T009B">
<name>Horn Button Assembly</name>
<para id="RM000002RNO002X" category="A" type-id="80001" name-id="554VE-00" from="200708" to="200912">
<name>Removal</name>
<subpara id="RM000002RNO002X_01" type-id="01" category="01">
<s-1 id="RM000002RNO002X_01_0001" proc-id="RM0550J___0000CF100000">
<ptxt>Handling and Work Precautions</ptxt>
<content1 releasenbr="1">
<ptxt>(For the procedure, refer to <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000002RNO002X_01_0003" proc-id="RM0550J___0000CF200000">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(For the procedure, refer to <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000002RNO002X_01_0004" proc-id="RM0550J___0000CF300000">
<ptxt>Remove Steering Wheel Cover Lower NO.3</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claws and remove steering wheel cover lower NO.3.</ptxt>
<figure>
<graphic graphicname="C148600J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002RNO002X_01_0005" proc-id="RM0550J___0000CF400000">
<ptxt>Remove Steering Wheel Cover Lower NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claws and remove steering wheel cover lower NO.2.</ptxt>
<figure>
<graphic graphicname="C148599J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002RNO002X_01_0006" proc-id="RM0550J___0000CF500000">
<ptxt>Remove Horn Button Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a torx socket wrench (T30), loosen the 2 torx bolts until they turn freely.</ptxt>
<figure>
<graphic graphicname="C172737J01" width="7.106578999in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Using needle-nose pliers, pull out the 2 torx bolts.</ptxt>
</s2>
<s2>
<ptxt>Pull the horn button assembly toward the rear of the vehicle.</ptxt>
<figure>
<graphic graphicname="C172738" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a thin-bladed screwdriver with its tip wrapped with protective tape, release the lock of the airbag connector.</ptxt>
<figure>
<graphic graphicname="C148602J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the airbag connector and horn connector, and remove the horn button assembly.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>