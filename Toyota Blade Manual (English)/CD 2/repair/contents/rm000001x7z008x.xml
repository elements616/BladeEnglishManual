<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7420F_T000X" variety="T000X">
<name>Rear Combination Light Assembly LH</name>
<para id="RM000001X7Z008X" category="A" type-id="30014" name-id="604O5-01" from="200912">
<name>Installation</name>
<subpara id="RM000001X7Z008X_01" type-id="01" category="01">
<s-1 id="RM000001X7Z008X_01_0034" proc-id="RM0550J___0000A6V00001">
<ptxt>Install Rear Combination Light Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 2 clips and guide, and install the rear combination light assembly LH.</ptxt>
</s2>
<s2>
<ptxt>Install the 2 nuts.</ptxt>
<torque>
<torqueitem>
<t-value1>4.9</t-value1>
<t-value2>50</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the connector and engage the clamp.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X7Z008X_01_0036" proc-id="RM0550J___0000A6X00001">
<ptxt>Install Rear Combination Light Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert the 2 guides.</ptxt>
</s2>
<s2>
<ptxt>Engage the 4 claws and install the rear combination light cover LH.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>