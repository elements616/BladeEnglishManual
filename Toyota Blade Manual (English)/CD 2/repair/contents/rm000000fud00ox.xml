<para id="RM000000FUD00OX" category="C" type-id="8009L" name-id="32260-00" from="200612">
<dtccode>P2763/64</dtccode>
<dtcname>DSU Solenoid Circuit (High)</dtcname>
<dtccode>P2764/64</dtccode>
<dtcname>DSU Solenoid Circuit (Low)</dtcname>
<subpara id="RM000000FUD00OX_01" type-id="33" category="03" proc-id="RM0550J___000047E00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The engine control computer controls the signal to solenoid DSU to control the lock-up clutch pressure according to the input torque.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.06in"/>
<colspec colname="COL2" colwidth="3.13in"/>
<colspec colname="COL3" colwidth="2.89in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P2763/64</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While driving</ptxt>
</item>
<item>
<ptxt>Open in solenoid DSU circuit</ptxt>
</item>
<item>
<ptxt>Detected 2 times or more consecutively</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire harness and connector (solenoid DSU signal system)</ptxt>
</item>
<item>
<ptxt>Continuously Variable Transaxle</ptxt>
<ptxt>(Solenoid DSU)</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P2764/64</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While driving</ptxt>
</item>
<item>
<ptxt>Short in solenoid DSU circuit</ptxt>
</item>
<item>
<ptxt>Detected 2 times or more consecutively</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire harness and connector (solenoid DSU signal system)</ptxt>
</item>
<item>
<ptxt>Continuously Variable Transaxle</ptxt>
