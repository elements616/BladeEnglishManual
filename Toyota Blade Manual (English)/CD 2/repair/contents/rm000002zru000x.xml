<subpara id="RM000002ZRU000X_01" type-id="01" category="01">
<s-1 id="RM000002ZRU000X_01_0001" proc-id="RM0550J___00005EV00000">
<ptxt>Install Master Cylinder Reservoir Grommet</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply a thin coat of rubber grease to the entire circumference of the 2 new brake master cylinder reservoir grommets, and install them to the brake master cylinder reservoir assembly.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZRU000X_01_0002" proc-id="RM0550J___00005EW00000">
<ptxt>Install Brake Master Cylinder Reservoir Sub-assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C150122" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Using a pin punch and hammer, drive in the pin.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
