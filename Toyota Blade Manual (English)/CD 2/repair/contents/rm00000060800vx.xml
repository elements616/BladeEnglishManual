<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Relevant Solenoid</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C0226/21</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>SFRH、SFRR</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C0236/22</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>SFLH、SFLR</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C0246/23</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>SRRH、SRRR</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C0256/24</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>SRLH、SRLR</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C1225/25</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>SM1、SM2</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</atten4>
</content5>
</subpara>
