<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001C_S000C" variety="S000C">
<name>Audio &amp; Visual</name>
<ttl id="1001C_S000C_77T6W_T00JM" variety="T00JM">
<name>Multimedia Interface ECU</name>
<para id="RM000004AZH000X" category="A" type-id="30014" name-id="6421G-01" from="200912">
<name>Installation</name>
<subpara id="RM000004AZH000X_01" type-id="01" category="01">
<s-1 id="RM000004AZH000X_01_0001">
<ptxt>Install Multimedia Interface Computer</ptxt>
</s-1>
<s-1 id="RM000004AZH000X_01_0002" proc-id="RM0550J___0000IS500000">
<ptxt>Install Multimedia Interface Bracket NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install multimedia interface bracket No.1 with the 2 screws.</ptxt>
<figure>
<graphic graphicname="E206703" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000004AZH000X_01_0003" proc-id="RM0550J___0000IS600000">
<ptxt>Install Multimedia Interface Computer Assembly w/ Bracket</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Insert the 2 guides and install the multimedia interface computer assembly w/ bracket with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="E206702J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000004AZH000X_01_0004" proc-id="RM0550J___000016000000">
<ptxt>Install Air Conditioner Control Assembly
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E147193" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
<s2>
<ptxt>Engage the 4 clips and install the air conditioner control assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000004AZH000X_01_0005" proc-id="RM0550J___00001PG00000">
<ptxt>Install Navigation Receiver Assembly w/ Bracket
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 4 clips and temporarily install the navigation receiver assembly w/ bracket.</ptxt>
<figure>
<graphic graphicname="E137111" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the navigation receiver assembly w/ bracket with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="E137109" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000004AZH000X_01_0006" proc-id="RM0550J___00009MS00001">
<ptxt>Install Instrument Cluster Finish Panel Assembly Center NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 6 clips and 4 claws.</ptxt>
<figure>
<graphic graphicname="B236937" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install instrument cluster finish panel assembly center No.1 with the 2 screws &lt;C&gt;.</ptxt>
<figure>
<graphic graphicname="B236936" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000004AZH000X_01_0007" proc-id="RM0550J___00009MT00001">
<ptxt>Install Position Indicator Housing Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
<s2>
<ptxt>Engage the 9 claws and install the position indicator housing assembly.</ptxt>
<figure>
<graphic graphicname="B236935" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000004AZH000X_01_0008" proc-id="RM0550J___0000IMB00000">
<ptxt>Install Box Panel NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 2 claws and 4 clips to install box panel No.2.</ptxt>
<figure>
<graphic graphicname="B236932" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000004AZH000X_01_0009" proc-id="RM0550J___00009MV00001">
<ptxt>Install Shift Lever Knob
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Turn the shift lever knob in the direction of the arrow shown in the illustration to install it.</ptxt>
<figure>
<graphic graphicname="B236929" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000004AZH000X_01_0010" proc-id="RM0550J___00009N100001">
<ptxt>Install Instrument Panel Register Assembly Center
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector.</ptxt>
<figure>
<graphic graphicname="B151129" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 clips, 5 claws and 3 guides, and install the instrument panel register assembly CTR.</ptxt>
<figure>
<graphic graphicname="B169225J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000004AZH000X_01_0011" proc-id="RM0550J___00009N200001">
<ptxt>Install Instrument Panel Finish Panel End RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and install the instrument panel finish panel end RH.</ptxt>
<figure>
<graphic graphicname="B236943" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000004AZH000X_01_0012" proc-id="RM0550J___00009N300001">
<ptxt>Install Instrument Panel Finish Panel End LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and install the instrument panel finish panel end LH.</ptxt>
<figure>
<graphic graphicname="B236944" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
