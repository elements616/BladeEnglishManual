<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74XSO_T00GG" variety="T00GG">
<name>Engine Control Computer (2GR-FE)</name>
<para id="RM000002ADC004X" category="A" type-id="80001" name-id="066Q0-00" from="200708">
<name>Removal</name>
<subpara id="RM000002ADC004X_03" type-id="01" category="01">
<s-1 id="RM000002ADC004X_03_0119" proc-id="RM0550J___0000DHU00000">
<ptxt>Remove V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place both hands on the front of the cover and lift it upward to disengage the 2 front clips, then continue lifting upward to disengage the 1 rear clips, and remove the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Pulling up the front and rear at the same time may cause damage.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000002ADC004X_03_0117" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002ADC004X_03_0111">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM000002ADC004X_03_0118" proc-id="RM0550J___0000EUD00000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002ADC004X_03_0120" proc-id="RM0550J___0000F4000000">
<ptxt>Remove Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the air flow meter connector. (<sup>*</sup>1). </ptxt>
<figure>
<graphic graphicname="A176815J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect ventilation hose No.2. (<sup>*</sup>2).</ptxt>
</s2>
<s2>
<ptxt>Disconnect the hose band (<sup>*</sup>3)</ptxt>
</s2>
<s2>
<ptxt>Disengage the 3 clamps and remove the air cleaner cap w/ air cleaner hose.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002ADC004X_03_0121" proc-id="RM0550J___0000EUG00000">
<ptxt>Remove Air Cleaner Case
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 bolts and clamp, and remove the air cleaner case.</ptxt>
<figure>
<graphic graphicname="A178719" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002ADC004X_03_0115" proc-id="RM0550J___0000GT300000">
<ptxt>Remove Engine Control Computer</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>While pushing the lock on the lever, lift the lever and disconnect the 2 engine control computer connectors.</ptxt>
<figure>
<graphic graphicname="A157544" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>When disconnecting the connectors, be careful not to let mud, water or other foreign matter adhere to the connector connections.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Remove the clamp and 2 bolts, and remove the engine control computer.</ptxt>
<figure>
<graphic graphicname="A162895" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 4 screws and 2 engine control computer brackets.</ptxt>
<figure>
<graphic graphicname="A162896" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>