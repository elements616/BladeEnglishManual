<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM0000035BY01BX" category="C" type-id="803MJ" name-id="653FV-01" from="200912">
<dtccode>B15E7</dtccode>
<dtcname>Hard disk read/write malfunction (low temperature)</dtcname>
<dtccode>B15E8</dtccode>
<dtcname>Hard disk read/write malfunction (high temperature)</dtcname>
<subpara id="RM0000035BY01BX_01" type-id="33" category="03" proc-id="RM0550J___0000IIT00000">
<name>Function Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>This DTC is recorded when read/write errors for the HDD occur a specified number of times or more in a temperature environment above (below) the HDD operating range.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.06in"/>
<colspec colname="COL2" colwidth="3.02in"/>
<colspec colname="COL3" colwidth="3.00in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC.No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Point</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B15E7</ptxt>
</entry>
<entry valign="middle">
<ptxt>HDD read/write malfunction due to low temperature</ptxt>
</entry>
<entry morerows="1" valign="middle">
<ptxt>Navigation Receiver Assembly</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B15E8</ptxt>
</entry>
<entry valign="middle">
<ptxt>HDD read/write malfunction due to high temperature</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</item>
</list1>
</content5>
</subpara>
<subpara id="RM0000035BY01BX_04" type-id="51" category="05" proc-id="RM0550J___0000IIX00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM0000002RM03SX"/>)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000035BY01BX_02" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000035BY01BX_02_0006" proc-id="RM0550J___0000IIW00000">
<testtitle>Check Environment</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Place the vehicle in a normal temperature environment and bring the cabin temperature to -20°C or higher and 65°C or lower.</ptxt>
<atten4>
<list1 type="unordered">
<item>
<ptxt>The HDD may not be usable at high or low temperatures.</ptxt>
</item>
<item>
<ptxt>Clear and recheck the DTCs in a normal temperature environment.</ptxt>
</item>
</list1>
</atten4>
</test1>
</content6>
<res>
<down ref="RM0000035BY01BX_02_0005" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000035BY01BX_02_0005" proc-id="RM0550J___0000IIV00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM0000035BY01BX_02_0004" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000035BY01BX_02_0004" proc-id="RM0550J___0000IIU00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.63in"/>
<colspec colname="COL2" colwidth="1.50in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>No code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000035BY01BX_02_0002" fin="true">A</down>
<right ref="RM0000035BY01BX_02_0007" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035BY01BX_02_0002">
<testtitle>Return to Normal</testtitle>
</testgrp>
<testgrp id="RM0000035BY01BX_02_0007">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>