<ttl id="1001I_S000I_746FW_T00BX" variety="T00BX">
<name>Indoor Electrical Key Oscillator (Installed in Luggage Room)</name>
<para id="RM000001W0E005X" category="A" type-id="30014" name-id="622P2-00" from="200612">
<name>Installation</name>
<subpara id="RM000001W0E005X_01" type-id="01" category="01">
<s-1 id="RM000001W0E005X_01_0008" proc-id="RM0550J___00008LV00000">
<ptxt>Install Indoor Electrical Key Oscillator</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the claws and install the indoor electrical key oscillator.</ptxt>
<figure>
<graphic graphicname="B167259" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001W0E005X_01_0014" proc-id="RM0550J___00009ZF00000">
<ptxt>Install Deck Floor Box RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert the guide.</ptxt>
<figure>
<graphic graphicname="B152866J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the deck floor box RH with the 2 nuts.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001W0E005X_01_0015" proc-id="RM0550J___00009ZG00000">
<ptxt>Install Rear Floor Mat Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the rear floor mat rear.</ptxt>
<figure>
<graphic graphicname="B167257" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001W0E005X_01_0016" proc-id="RM0550J___00009ZI00000">
<ptxt>Install Package Tray Trim Panel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the package tray trim panel assembly with the 2 pins.</ptxt>
<figure>
<graphic graphicname="B167256J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the 2 suspenders to the package tray trim garnish hooks, and install the package tray trim panel assembly.</ptxt>
</s2>
</content1></s-1>
</subpara>
</para>
