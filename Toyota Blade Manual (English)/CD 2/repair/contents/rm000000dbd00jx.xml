</subpara>
<subpara id="RM000000DBD00JX_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000000DBD00JX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DBD00JX_04_0007" proc-id="RM0550J___0000CV200000">
<testtitle>Replace Distance Control Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the distance control computer assembly with a new one.</ptxt>
<ptxt>(see <xref label="Seep01" href="RM0000028Z2003X"/>)</ptxt>
</test1>
<test1>
<ptxt>Perform initialization of the distance control computer.</ptxt>
<ptxt>(see <xref label="Seep02" href="RM000002GO2003X_01_0001"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000DBD00JX_04_0003" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000DBD00JX_04_0003" proc-id="RM0550J___0000CV100000">
<scantool type="1"/>
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/Pre-crash" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen to clear the data.</ptxt>
</test1>
<test1>
<ptxt>Follow the prompts on the SST (TaSCAN) screen to display the "System Diagnosis Menu/Pre-crash" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Check for DTCs again.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B2065/81 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B2065/81 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DBD00JX_04_0008" fin="true">A</down>
<right ref="RM000000DBD00JX_04_0006" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DBD00JX_04_0008">
<testtitle>END</testtitle>
</testgrp>
<testgrp id="RM000000DBD00JX_04_0006">
