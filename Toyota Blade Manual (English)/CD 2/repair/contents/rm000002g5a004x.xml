<para id="RM000002G5A004X" category="C" type-id="302ZV" name-id="066NT-00" from="200708">
<dtccode>P0327/55</dtccode>
<dtcname>Knock Sensor Circuit1 (Low)</dtcname>
<dtccode>P0328/55</dtccode>
