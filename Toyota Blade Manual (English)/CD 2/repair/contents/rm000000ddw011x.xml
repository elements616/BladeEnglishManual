<para id="RM000000DDW011X" category="C" type-id="302FC" name-id="59150-00" from="200708">
<dtccode>P0607/54</dtccode>
<dtcname>ECU Internal Malfunction 2</dtcname>
<subpara id="RM000000DDW011X_01" type-id="33" category="03" proc-id="RM0550J___0000CEH00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>When the engine control computer detects an internal malfunction in the engine control computer, it performs cruise control cancel control and outputs a DTC.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0607/54</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<title>STP input circuit</title>
<item>
<ptxt>IG ON</ptxt>
</item>
<item>
<ptxt>Stop light switch input circuit malfunction in ECU</ptxt>
</item>
</list1>
<list1 type="ordered">
<title>Cancel circuit malfunction</title>
<item>
<ptxt>During cruise control operation</ptxt>
</item>
<item>
<ptxt>Cancel circuit malfunction in ECU</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>Engine Control Computer</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
