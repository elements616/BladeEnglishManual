<testtitle>Replace Engine Control Computer</testtitle>
<content6 releasenbr="2">
<test1>
<ptxt>Replace the engine control computer. (see <xref label="Seep02" href="RM000002ADB004X"/>)</ptxt>
</test1>
<atten4>
