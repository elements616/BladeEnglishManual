<subpara id="RM000000Q8Z004X_01" type-id="01" category="01">
<s-1 id="RM000000Q8Z004X_01_0022" proc-id="RM0550J___00001EY00000">
<ptxt>Install Power Outlet Socket Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Align the guide of a new power outlet socket cover with the cutout of the console box rear cover.</ptxt>
<figure>
<graphic graphicname="E155726J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 claws and install the power outlet socket cover.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000Q8Z004X_01_0079" proc-id="RM0550J___0000EX100000">
<ptxt>Install Power Point Socket Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Align the guide of the power point socket assembly with the cutout of the power outlet socket cover.</ptxt>
<figure>
<graphic graphicname="E155727J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 claws and install the power point socket assembly.</ptxt>
</s2>
</content1>
</s-1>
