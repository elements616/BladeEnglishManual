<testgrp id="RM0000036HL01WX_04_0005" proc-id="RM0550J___0000IKS00000">
<testtitle>Inspect Wire Harness and Connector (Navigation Receiver Assembly - Multimedia Interface Computer)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
