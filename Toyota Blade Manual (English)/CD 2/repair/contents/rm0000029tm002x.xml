<para id="RM0000029TM002X" category="N" type-id="3000G" name-id="8015D-00" from="200612">
<name>Adjustment</name>
<subpara id="RM0000029TM002X_02" type-id="01" category="01">
<s-1 id="RM0000029TM002X_02_0005" proc-id="RM0550J___00009VX00000">
<ptxt>Inspect Back Door Panel Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that each clearance dimension is within the reference value.</ptxt>
<figure>
<graphic graphicname="B167279J01" width="7.106578999in" height="3.779676365in"/>
</figure>
<spec>
<title>Reference Value</title>
<table pgwide="1">
<tgroup cols="4">
<colspec colname="COL1" align="center" colwidth="1.06in"/>
<colspec colname="COL2" align="center" colwidth="2.48in"/>
<colspec colname="COL3" align="center" colwidth="1.06in"/>
<colspec colname="COL4" align="center" colwidth="2.48in"/>
<tbody>
<row>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
<entry valign="middle">
<ptxt>5.1±1.5 mm</ptxt>
</entry>
<entry valign="middle">
<ptxt>D</ptxt>
</entry>
<entry valign="middle">
<ptxt>5.1±1.5 mm</ptxt>
</entry>
