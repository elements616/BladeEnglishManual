<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1002M_S001G" variety="S001G">
<name>Pre-crash Safety</name>
<ttl id="1002M_S001G_74WT7_T00FP" variety="T00FP">
<name>Pre-crash Safety System</name>
<para id="RM000000DBB00JX" category="C" type-id="8007Q" name-id="540JJ-00" from="200708">
<dtccode>B2059/31</dtccode>
<dtcname>Vehicle Speed Sensor Malfunction</dtcname>
<subpara id="RM000000DBB00JX_01" type-id="31" category="03" proc-id="RM0550J___0000CUQ00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="unordered">
<item>
<ptxt>The seat belt control computer receives vehicle speed information from the engine control computer and ABS &amp; traction actuator assembly via CAN communication.</ptxt>
</item>
<item>
<ptxt>The engine control computer receives vehicle speed information from the ABS &amp; traction actuator assembly via the combination meter assembly.</ptxt>
</item>
<item>
<ptxt>This DTC is output when the difference between the vehicle speed information from the engine control computer and that from the ABS &amp; traction actuator assembly exceeds a certain value.</ptxt>
</item>
</list1>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B2059/31</ptxt>
</entry>
<entry valign="middle">
<ptxt>The vehicle speed information from the engine control computer and ABS &amp; traction actuator assembly differs by a certain amount or more</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Radar cruise control system</ptxt>
</item>
<item>
<ptxt>Meter &amp; gauge system</ptxt>
</item>
<item>
<ptxt>Distance Control Computer Assembly</ptxt>
</item>
<item>
<ptxt>Seat Belt Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000DBB00JX_05" type-id="32" category="03" proc-id="RM0550J___0000CUX00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E143521J01" width="7.106578999in" height="4.7836529in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000DBB00JX_03" type-id="51" category="05" proc-id="RM0550J___0000CUR00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the distance control computer assembly and engine control computer are replaced with new ones, always perform initialization. (see <xref label="Seep01" href="RM000002GO2003X_01_0001"/>)</ptxt>
</item>
<item>
<ptxt>CAN communication is used in this circuit. Before inspection, check the CAN communication and confirm that the communication system is normal.</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM000000DBB00JX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DBB00JX_04_0001" proc-id="RM0550J___0000CUS00000">
<scantool type="1"/>
<testtitle>Check DTC (EFI System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/TCCS" screen and select "DTC Freeze Data".</ptxt>
</test1>
<test1>
<ptxt>Check for DTCs.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>DTC P0500 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC P0500 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DBB00JX_04_0002" fin="false">A</down>
<right ref="RM000000DBB00JX_04_0005" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DBB00JX_04_0002" proc-id="RM0550J___0000CUT00000">
<testtitle>Read TaSCAN Data (Vehicle Speed)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/ABS/VSC" screen, and select "ECU Data Monitor".</ptxt>
</test1>
<test1>
<ptxt>Perform a road test.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>The ECU data monitor value matches the vehicle speed on the combination meter assembly</ptxt>
</specitem>
<table pgwide="1">
<title>[System Selection Screen: Body → ABS/VSC → ECU Data Monitor]</title>
<tgroup cols="4">
<colspec colname="COL1" colwidth="1.77in"/>
<colspec colname="COLSPEC0" colwidth="1.77in"/>
<colspec colname="COLSPEC1" colwidth="1.77in"/>
<colspec colname="COL2" colwidth="1.77in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
<ptxt>(Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Item Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Reference Value</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Vehicle Speed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates vehicle speed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Driving at a constant speed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>No large fluctuations</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DBB00JX_04_0003" fin="false">OK</down>
<right ref="RM000000DBB00JX_04_0006" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000DBB00JX_04_0003" proc-id="RM0550J___0000CUU00000">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Vehicle Speed)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/TCCS" screen, and select "ECU Data Monitor".</ptxt>
</test1>
<test1>
<ptxt>Perform a road test.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>The ECU data monitor value matches the vehicle speed on the combination meter assembly</ptxt>
</specitem>
<table pgwide="1">
<title>[System Selection Screen: Body → TCCS → ECU Data Monitor]</title>
<tgroup cols="4">
<colspec colname="COL1" colwidth="1.77in"/>
<colspec colname="COLSPEC0" colwidth="1.77in"/>
<colspec colname="COLSPEC1" colwidth="1.77in"/>
<colspec colname="COL2" colwidth="1.77in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
<ptxt>(Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Item Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Reference Value</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Vehicle Speed</ptxt>
<ptxt>(SPD1)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates vehicle speed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Driving at a constant speed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Almost the same as meter vehicle speed</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DBB00JX_04_0009" fin="false">OK</down>
<right ref="RM000000DBB00JX_04_0007" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000DBB00JX_04_0009" proc-id="RM0550J___0000CUW00000">
<testtitle>Replace Seat Belt Control Computer</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the seat belt control computer with a new one.</ptxt>
</test1>
<ptxt>(see <xref label="Seep01" href="RM000002SZU002X"/>)</ptxt>
</content6>
<res>
<down ref="RM000000DBB00JX_04_0008" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000DBB00JX_04_0008" proc-id="RM0550J___0000CUV00000">
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/Pre-crash" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen to clear the data.</ptxt>
</test1>
<test1>
<ptxt>Follow the prompts on the SST (TaSCAN) screen to display the "System Diagnosis Menu/Pre-crash" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Check for DTCs again.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B2059 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B2059 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DBB00JX_04_0010" fin="true">A</down>
<right ref="RM000000DBB00JX_04_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DBB00JX_04_0010">
<testtitle>END</testtitle>
</testgrp>
<testgrp id="RM000000DBB00JX_04_0004">
<testtitle>Replace Distance Control Computer Assembly<xref label="Seep01" href="RM0000028Z2003X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DBB00JX_04_0005">
<testtitle>Go to the relevant DTC chart<xref label="Seep01" href="RM000001KT7004X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DBB00JX_04_0006">
<testtitle>Go to Meter &amp; Gauge System<xref label="Seep01" href="RM000001L5T00JX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DBB00JX_04_0007">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM000002ADC004X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
