</subpara>
<subpara id="X39400000IB00RC_11" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="X39400000IB00RC_12" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X39400000IB00RC_12_0001" proc-id="RM0550J___000049V00000">
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Clear the DTCs.</ptxt>
</test1>
<test1>
<ptxt>Check the DTCs again 270 to 330 seconds after turning the IG ON, and check that no DTC is output.</ptxt>
<spec>
<title>Result</title>
