<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_746W2_T00DG" variety="T00DG">
<name>Back Guide Monitor System</name>
<para id="RM00000141601SX" category="J" type-id="800YH" name-id="PM2XE-03" from="200912">
<dtccode/>
<dtcname>Expected course lines are not displayed and "Guide Unavailable" is displayed</dtcname>
<subpara id="RM00000141601SX_08" type-id="31" category="03" proc-id="RM0550J___0000HXW00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The steering angle signal detected by the steering sensor is input to the navigation receiver assembly via CAN communication.</ptxt>
</content5>
</subpara>
<subpara id="RM00000141601SX_09" type-id="32" category="03" proc-id="RM0550J___0000HXX00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E141986J26" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="RM00000141601SX_15" type-id="51" category="05" proc-id="RM0550J___0000HXY00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the battery terminal is disconnected, perform steering sensor neutral point memorization. (see <xref label="Seep01" href="RM000000GCY00LX"/>)</ptxt>
</item>
<item>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration and setting operations for other systems as well as the back guide monitor system may be necessary. (see <xref label="Seep02" href="RM000002FZ603QX"/>)</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM00000141601SX_16" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000141601SX_16_0024" proc-id="RM0550J___0000HXZ00000">
<testtitle>Inspect Wire Harness and Connector (Steering Sensor Power Source System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation</ptxt>
<test2>
<ptxt>Disconnect the steering sensor connector.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the connector terminals.</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1 (ESS) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<test1>
<ptxt>Voltage Inspection  </ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between each terminal of the connector.</ptxt>
<spec>
<title>Voltage</title>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>4(IG) - 1(ESS)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>5(BAT) - 1(ESS)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000141601SX_16_0025" fin="true">OK</down>
<right ref="RM00000141601SX_16_0027" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000141601SX_16_0025">
<testtitle>Replace Steering Sensor<xref label="Seep01" href="RM000000QFH008X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000141601SX_16_0027">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
