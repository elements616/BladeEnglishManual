<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM0000036H3038X" category="J" type-id="804QD" name-id="653G3-01" from="200912">
<dtccode/>
<dtcname>Map cannot be updated using media (CD-R/DVD-R)</dtcname>
<subpara id="RM0000036H3038X_01" type-id="51" category="05" proc-id="RM0550J___0000IJD00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<list1 type="unordered">
<item>
<ptxt>For details on map updates, refer to the Owner's Manual.</ptxt>
</item>
<item>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM0000002RM03SX"/>)</ptxt>
</item>
</list1>
</atten4>
</content5>
</subpara>
<subpara id="RM0000036H3038X_02" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000036H3038X_02_0001" proc-id="RM0550J___0000IJE00000">
<testtitle>Check GPS Time Acquisition</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Time Acquisition by GPS</ptxt>
<test2>
<ptxt>Select "Calendar" on the Information/G screen to display the calendar. ”</ptxt>
</test2>
<test2>
<ptxt>Check that "GPS" is displayed on the screen.</ptxt>
<figure>
<graphic graphicname="E150531" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>"GPS" displayed</ptxt>
</specitem>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036H3038X_02_0002" fin="false">OK</down>
<right ref="RM0000036H3038X_02_0006" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000036H3038X_02_0002" proc-id="RM0550J___0000IJF00000">
<testtitle>Check Update Service Period</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Update Service Period</ptxt>
<test2>
<ptxt>Press "Setup/Edit" to display the "Setup/Edit" screen.</ptxt>
</test2>
<test2>
<ptxt>Select the "Navi" tab, then select "Map Update" to display the "Map Update" screen.</ptxt>
</test2>
<test2>
<ptxt>Check the end date of the update service.</ptxt>
<figure>
<graphic graphicname="E150532" width="2.775699831in" height="1.771723296in"/>
</figure>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Status</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Within update service period</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>-</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>End date of update service period is displayed as "**"</ptxt>
</entry>
<entry valign="middle">
<ptxt>The vehicle has been driven 100 km or more since new vehicle purchase (new navigation purchase)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>End date of update service period is displayed as "**"</ptxt>
</entry>
<entry valign="middle">
<ptxt>At purchase of annual update version (after full map data update)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten4>
<ptxt>After new vehicle purchase (new navigation purchase), the end date is displayed as "**" until the vehicle has been driven 100 km.</ptxt>
</atten4>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036H3038X_02_0003" fin="false">A</down>
<right ref="RM0000036H3038X_02_0005" fin="true">B</right>
<right ref="RM0000036H3038X_02_0007" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM0000036H3038X_02_0003" proc-id="RM0550J___0000IJG00000">
<testtitle>Check Map Data for Update</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Update Map Data for Errors</ptxt>
<test2>
<ptxt>Check whether a data error message was displayed on the display when the update media (CD-R/DVD-R) was inserted.</ptxt>
<table pgwide="1">
<tgroup cols="2" align="left">
<colspec colname="COL1" colwidth="3.55in"/>
<colspec colname="COL2" colwidth="3.53in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Display Content</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Display Timing</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>"There is an error in the data for ○○○, ○○○, ○○○. Updating of the remaining data will continue."</ptxt>
</entry>
<entry valign="middle">
<ptxt>When starting conversion for map update using media (CD-R/DVD-R)</ptxt>
<ptxt>When some (but not all) of the selected multiple prefectures are invalid</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>"There is an error in the data. Please select another list."</ptxt>
</entry>
<entry valign="middle">
<ptxt>When starting conversion for map update using media (CD-R/DVD-R) and while a map update related screen is displayed</ptxt>
<ptxt>When all selected prefectures are invalid</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>"There is an error in the map update data. Please select another list from the map update screen."</ptxt>
</entry>
<entry valign="middle">
<ptxt>When starting conversion for map update using media (CD-R/DVD-R) and while a screen other than a map update related screen is displayed</ptxt>
<ptxt>When all selected prefectures are invalid</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test2>
</test1>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>No Display</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM0000036H3038X_02_0004" fin="false">A</down>
<right ref="RM0000036H3038X_02_0008" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000036H3038X_02_0004" proc-id="RM0550J___0000IJH00000">
<testtitle>Check Error</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Update Media (CD-R/DVD-R)</ptxt>
<test2>
<ptxt>Check whether there was an error when the update media (CD-R/DVD-R) was created.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>No error</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Error present</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036H3038X_02_0005" fin="true">A</down>
<right ref="RM0000036H3038X_02_0009" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000036H3038X_02_0005">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000036H3038X_02_0006">
<testtitle>Move the vehicle (to receive GPS)</testtitle>
</testgrp>
<testgrp id="RM0000036H3038X_02_0007">
<testtitle>Perform Full Map Data Update Again</testtitle>
</testgrp>
<testgrp id="RM0000036H3038X_02_0008">
<testtitle>Recreate Update Map Data and Perform Update</testtitle>
</testgrp>
<testgrp id="RM0000036H3038X_02_0009">
<testtitle>Recreate Update Map Data and Perform Update</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>