<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000U_S0017" variety="S0017">
<name>Steering Column</name>
<ttl id="1000U_S0017_745FR_T00AZ" variety="T00AZ">
<name>Electric Power Steering System</name>
<para id="RM00000057F00GX" category="C" type-id="3054Y" name-id="480Y5-00" from="200612">
<dtccode>C1541/13</dtccode>
<dtcname>Vehicle Speed Signal Malfunction 1</dtcname>
<subpara id="RM00000057F00GX_01" type-id="33" category="03" proc-id="RM0550J___00005YG00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The power steering computer assembly receives the vehicle speed signal from the ABS ECU via CAN communication.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.72in"/>
<colspec colname="COL2" colwidth="2.31in"/>
<colspec colname="COL3" colwidth="3.05in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Detection Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Trouble Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1541/13</ptxt>
</entry>
<entry valign="middle">
<ptxt>Vehicle speed signal malfunction</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Speed sensor system</ptxt>
</item>
<item>
<ptxt>Skid control computer</ptxt>
</item>
<item>
<ptxt>CAN communication system</ptxt>
</item>
<item>
<ptxt>Power Steering Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000057F00GX_03" type-id="51" category="05" proc-id="RM0550J___00005YH00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>If the power steering computer assembly is replaced, perform the torque sensor 0 point calibration and rotation angle sensor output calibration. (see <xref label="Seep01" href="RM0000024YB004X"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM00000057F00GX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000057F00GX_04_0001" proc-id="RM0550J___00005YI00000">
<testtitle>Check DTC Output (CAN Communication System)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check whether DTC U0129/42 (Brake ECU Communication Malfunction) is output. (see <xref label="Seep01" href="RM0000005S001MX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.48in"/>
<colspec colname="COL2" align="center" colwidth="1.65in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>U0129/42 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>U0129/42 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000057F00GX_04_0002" fin="false">OK</down>
<right ref="RM00000057F00GX_04_0004" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000057F00GX_04_0002" proc-id="RM0550J___00005YJ00000">
<scantool type="1"/>
<testtitle>Check DTC Output (ABS System)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check the DTCs of the ABS with EBD &amp; TRC &amp; VSC &amp; BA system. (see <xref label="Seep01" href="RM00000060000PX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.48in"/>
<colspec colname="COL2" align="center" colwidth="1.65in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>Normal code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>Malfunction code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000057F00GX_04_0003" fin="true">A</down>
<right ref="RM00000057F00GX_04_0005" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000057F00GX_04_0003">
<testtitle>Replace Power Steering Computer Assembly<xref label="Seep01" href="RM000000UNH00TX"/>
</testtitle>
</testgrp>
<testgrp id="RM00000057F00GX_04_0004">
<testtitle>Go to Relevant DTC<xref label="Seep01" href="RM000002GFH005X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000057F00GX_04_0005">
<testtitle>Go to Relevant DTC<xref label="Seep01" href="RM0000005ZT00PX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>