<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_74X9U_T00G8" variety="T00G8">
<name>Engine Mounting Insulator Front (2GR-FE)</name>
<para id="RM000001Y5X005X" category="A" type-id="30014" name-id="07255-00" from="200708">
<name>Installation</name>
<subpara id="RM000001Y5X005X_01" type-id="01" category="01">
<s-1 id="RM000001Y5X005X_01_0001" proc-id="RM0550J___0000ENF00000">
<ptxt>Install Engine Mounting Insulator Front</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine mounting insulator front to the front crossmember with the 3 bolts.</ptxt>
<figure>
<graphic graphicname="A136945" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y5X005X_01_0023" proc-id="RM0550J___0000FQ900000">
<ptxt>Install Front Crossmember Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the front crossmember with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A128870" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>96</t-value1>
<t-value2>979</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y5X005X_01_0024" proc-id="RM0550J___0000FQF00000">
<ptxt>Connect Engine Mounting Insulator Front</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the engine mounting insulator front to the engine mounting bracket front with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="A178718" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>145</t-value1>
<t-value2>1479</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y5X005X_01_0011" proc-id="RM0550J___0000DL100000">
<ptxt>Install Front Suspension Member Reinforcement LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the front suspension member reinforcement LH with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A136937" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>96</t-value1>
<t-value2>979</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0012" proc-id="RM0550J___0000DL200000">
<ptxt>Install Front Suspension Member Reinforcement RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the front suspension member reinforcement RH with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A136938" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>96</t-value1>
<t-value2>979</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0019" proc-id="RM0550J___0000FQ200000">
<ptxt>Install Engine Under Cover
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine under cover with the 4 bolts and 4 screws.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0020" proc-id="RM0550J___0000FQ300000">
<ptxt>Install Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install engine under cover NO.1 with the 6 bolts and 7 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0013" proc-id="RM0550J___0000DLY00000">
<ptxt>Install Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install battery carrier NO.2 with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0014" proc-id="RM0550J___0000FPD00000">
<ptxt>Install Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery carrier with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A176883" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Attach the 2 clamps to the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Install the battery tray.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0015" proc-id="RM0550J___0000DLZ00000">
<ptxt>Install Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery to the vehicle</ptxt>
</s2>
<s2>
<ptxt>Install the insulator.</ptxt>
</s2>
<s2>
<ptxt>Connect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the battery clamp with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>17</t-value1>
<t-value2>173</t-value2>
<ptxt>(Bolt)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the battery positive terminal with the nut.</ptxt>
<torque>
<torqueitem>
<t-value1>13</t-value1>
<t-value2>130</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0016">
<ptxt>Check Front Wheels Straight-ahead Position</ptxt>
</s-1>
<s-1 id="RM000001Y5X005X_01_0017" proc-id="RM0550J___0000DM100000">
<ptxt>Connect Battery Negative Terminal
</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>40</t-value2>
</torqueitem>
</torque>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0021" proc-id="RM0550J___0000DMG00000">
<ptxt>Install V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 clips to install the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Make sure the clips are securely engaged.</ptxt>
</item>
<item>
<ptxt>Engaging them with excessive force or striking the top of the clips may cause damage.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0022" proc-id="RM0550J___0000FQ400000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 9 clips.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001Y5X005X_01_0018" proc-id="RM0550J___0000DMJ00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal
</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW011X"/>)</ptxt>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
