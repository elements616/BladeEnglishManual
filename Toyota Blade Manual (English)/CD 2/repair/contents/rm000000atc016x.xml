<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001I_S000I" variety="S000I">
<name>Door Lock</name>
<ttl id="1001I_S000I_744CR_T004N" variety="T004N">
<name>Wireless Door Lock Control System</name>
<para id="RM000000ATC016X" category="D" type-id="3001B" name-id="622IB-00" from="200612">
<name>How to Proceed with Troubleshooting</name>
<subpara id="RM000000ATC016X_z0" proc-id="RM0550J___00002BU00000">
<content5 releasenbr="1">
<descript-diag>
<descript-testgroup>
<testtitle>Vehicle brought to workshop</testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Customer Problem Analysis and Symptom Check</testtitle>
<atten4>
<ptxt>Customer Problem Analysis and Symptom Check (see <xref label="Seep01" href="RM0000005B301GX"/>)</ptxt>
</atten4>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>CAN Communication System Check</testtitle>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), display the "CAN Bus Diagnosis / CAN Bus Connected ECU Check" screen, and check all ECUs and sensors connected to CAN communication. (see <xref label="Seep02" href="RM000001Z23006X"/>)</ptxt>
<table>
<title>Result: </title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.82in"/>
<colspec colname="COL2" colwidth="1.31in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No Abnormality</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Abnormal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test1>
<results>
<result>B</result>
<action-ci-right>Go to CAN Communication System (see <xref label="Seep07" href="RM000001R4W009X"/>)</action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Check DTC</testtitle>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check that no DTCs related to the wireless door lock control system are output. (see <xref label="Seep09" href="RM000000XH100GX"/>)</ptxt>
<table>
<title>Result: </title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.82in"/>
<colspec colname="COL2" colwidth="1.31in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Code (B1242) not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Code (B1242) output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test1>
<results>
<result>B</result>
<action-ci-right>Go to troubleshooting for the output DTC (see <xref label="Seep08" href="RM0000005BB010X"/>)</action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>List by Symptom</testtitle>
<atten4>
<ptxt>Check whether the symptom is listed in the symptom list. (see <xref label="Seep03" href="RM0000005B7011X"/>)</ptxt>
</atten4>
<table>
<title>Result: </title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.82in"/>
<colspec colname="COL2" colwidth="1.31in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Not listed in List by Symptom</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Corresponds to List by Symptom</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<results>
<result>B</result>
<action-ci-right>Go to Inspection Procedure 7</action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Perform troubleshooting using the following methods based on the problem symptom</testtitle>
<test1>
<ptxt>Function Inspection (see <xref label="Seep06" href="RM000000IU801GX"/>)</ptxt>
</test1>
<test1>
<ptxt>Terminals of ECU (see <xref label="Seep05" href="RM000000ATG011X"/>)</ptxt>
</test1>
<test1>
<ptxt>ECU Data Monitor/Active Test (see <xref label="Seep04" href="RM0000005BD014X"/>)</ptxt>
</test1>
<test1>
<ptxt>Component Inspection</ptxt>
</test1>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Adjust, Repair or Replace</testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
<action-ci-fin>END</action-ci-fin>
</results>
</descript-testgroup>
</descript-diag>
</content5>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>