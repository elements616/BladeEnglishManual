<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="04">
<name>Driveline/Axle</name>
<section id="1000K_S0015" variety="S0015">
<name>Differential</name>
<ttl id="1000K_S0015_744ZW_T00A7" variety="T00A7">
<name>Active Torque Control 4WD System</name>
<para id="X36100000I3008C" category="C" type-id="300UV" name-id="370EE-00" from="200612">
<dtccode>C1296/96</dtccode>
<dtcname>ABS System Malfunction</dtcname>
<subpara id="X36100000I3008C_13" type-id="33" category="03" proc-id="RM0550J___00005IA00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>If a malfunction occurs in the speed sensor circuit or G sensor circuit, the 4WD computer assembly outputs a DTC.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.06in"/>
<colspec colname="COL2" colwidth="2.55in"/>
<colspec colname="COL3" colwidth="3.47in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1296/96</ptxt>
</entry>
<entry valign="middle">
<ptxt>Speed sensor malfunction signal is received from the skid control computer</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Speed Sensor</ptxt>
</item>
<item>
<ptxt>Yaw rate sensor (G sensor)</ptxt>
</item>
<item>
<ptxt>Wire Harness and Connector (Speed Sensor Circuit)</ptxt>
</item>
<item>
<ptxt>ABS &amp; Traction Actuator Assembly (Skid Control Computer)</ptxt>
</item>
<item>
<ptxt>4WD Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="X36100000I3008C_14" type-id="32" category="03" proc-id="RM0550J___00005IB00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C159416J01" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="X36100000I3008C_15" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="X36100000I3008C_16" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X36100000I3008C_16_0003" proc-id="RM0550J___00005IC00000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Turn the ignition switch ON and, following the SST (TaSCAN) screen display, read the DTCs of the ABS with EBD &amp; TRC &amp; VSC &amp; BA system.</ptxt>
<atten4>
<ptxt>For the ABS with EBD &amp; TRC &amp; VSC &amp; BA system procedure, refer to <xref label="Seep02" href="RM00000060000PX"/>.</ptxt>
</atten4>
</test1>
<test1>
<ptxt>Check whether, in addition to DTC C1296/96, speed sensor malfunction codes (C0200/31, C0205/32, C0210/33, C0215/34, C1235/35, C1236/36, C1238/38C1239/39) and yaw rate sensor (G sensor) malfunction codes (C1243/43, C1244/44, C1245/45, C1336/39, C1381/97, U0124/95) of the ABS &amp; TRC &amp; VSC &amp; BA system with EBD are output.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Speed sensor malfunction or G sensor malfunction code is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Speed sensor malfunction or G sensor malfunction code is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X36100000I3008C_16_0004" fin="false">A</down>
<right ref="X36100000I3008C_16_0006" fin="true">B</right>
</res>
</testgrp>
<testgrp id="X36100000I3008C_16_0004" proc-id="RM0550J___00005ID00000">
<scantool type="4"/>
<testtitle>Inspect ECU Data Monitor (Speed Sensor)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Using SST (TaSCAN), inspect the speed sensor output value. (see <xref label="Seep01" href="RM00000068G00EX"/>)</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Output value changes according to vehicle speed, with no sudden rise or drop in speed</ptxt>
</specitem>
</spec>
</content6>
<res>
<down ref="X36100000I3008C_16_0007" fin="true">OK</down>
<right ref="X36100000I3008C_16_0010" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X36100000I3008C_16_0010">
<testtitle>Inspect and Replace Related Parts (Speed Sensor Circuit)</testtitle>
</testgrp>
<testgrp id="X36100000I3008C_16_0006">
<testtitle>Go to Diagnostic Trouble Code Chart<xref label="Seep01" href="RM0000005ZT00PX"/>
</testtitle>
</testgrp>
<testgrp id="X36100000I3008C_16_0007">
<testtitle>Replace 4WD computer assembly<xref label="Seep01" href="RM000002WLE001X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>