<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_746VG_T00DF" variety="T00DF">
<name>Rear Light Assembly LH</name>
<para id="RM0000031CC000X" category="A" type-id="8000E" name-id="603JI-00" from="200612">
<name>Reassembly</name>
<subpara id="RM0000031CC000X_01" type-id="01" category="01">
<s-1 id="RM0000031CC000X_01_0001">
<ptxt>Install Rear Light Lens &amp; Body LH</ptxt>
</s-1>
<s-1 id="RM0000031CC000X_01_0003" proc-id="RM0550J___0000BGH00000">
<ptxt>Install Rear Light Gasket LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install a new rear light gasket LH.</ptxt>
<figure>
<graphic graphicname="E147013" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>If it is stuck to the body, be sure to peel it all off.</ptxt>
</item>
<item>
<ptxt>Once removed, always replace it with a service part rear light gasket LH, as reusing it may cause water leakage.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM0000031CC000X_01_0002" proc-id="RM0550J___0000BGG00000">
<ptxt>Install Rear Light Socket &amp; Wire</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector and install the rear light socket &amp; wire.</ptxt>
<figure>
<graphic graphicname="E147014" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>