<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002R_S000G" variety="S000G">
<name>G-BOOK</name>
<ttl id="1002R_S000G_742BR_T003W" variety="T003W">
<name>G-BOOK System</name>
<para id="RM0000036FZ010X" category="J" type-id="803O4" name-id="GB0B8-02" from="200912">
<dtccode/>
<dtcname>Communication Failure</dtcname>
<subpara id="RM0000036FZ010X_01" type-id="51" category="05" proc-id="RM0550J___0000I5500000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM000001C3S022X"/>)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000036FZ010X_02" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000036FZ010X_02_0001" proc-id="RM0550J___0000I5600000">
<testtitle>Symptom Check</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Take the action for the check items corresponding to the displayed message, and check that the problem is reproduced.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COLSPEC0" colwidth="2.14in"/>
<colspec colname="COLSPEC1" colwidth="1.93in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Displayed Message</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Cause</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Items to Check</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>"Information could not be obtained because the line is busy, etc." is displayed</ptxt>
</entry>
<entry morerows="1" valign="middle">
<list1 type="unordered">
<item>
<ptxt>Other communication failure</ptxt>
</item>
<item>
<ptxt>Mobile carrier differs from setting</ptxt>
</item>
<item>
<ptxt>Connection retry count exceeded</ptxt>
</item>
<item>
<ptxt>PPP authentication error</ptxt>
</item>
<item>
<ptxt>Error other than PPP authentication</ptxt>
</item>
<item>
<ptxt>No socket available</ptxt>
</item>
<item>
<ptxt>No response from the center for a certain time after sending request</ptxt>
</item>
<item>
<ptxt>HTTP error</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>Wait a while, operate again and check that the problem is reproduced (*1)</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>"Cannot display because the line is busy, etc. Please wait a while before operating." is displayed</ptxt>
</entry>
<entry valign="middle">
<ptxt>Wait a while, operate again and check that the problem is reproduced (*1)</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>"Information could not be obtained because the line was disconnected" is displayed</ptxt>
</entry>
<entry valign="middle">
<ptxt>Unexpected disconnection of telephone line</ptxt>
</entry>
<entry valign="middle">
<ptxt>Wait a while, operate again and check that the problem is reproduced (*1)</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>"Please check the telephone" is displayed</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Cannot make calls due to telephone settings</ptxt>
</item>
<item>
<ptxt>No mobile phone number (SIM card not inserted, etc.)</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>Check that calls can be made from the telephone, operate again and check that the problem is reproduced</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>"Telephone is not connected" is displayed</ptxt>
</entry>
<entry valign="middle">
<ptxt>Telephone not connected</ptxt>
</entry>
<entry valign="middle">
<ptxt>Re-register the telephone, operate again and check that the problem is reproduced</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>"Outside service area. Please move to a service area." is displayed</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Out of service area</ptxt>
</item>
<item>
<ptxt>Goes out of service area during communication</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>Move into the service area, operate again and check that the problem is reproduced</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten4>
<ptxt>*1: If this message occurs temporarily, it is due to radio wave conditions or base station congestion and is not a malfunction. (Explain to the customer and have them continue using it)</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="RM0000036FZ010X_02_0033" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0033" proc-id="RM0550J___0000I5G00000">
<testtitle>Move Vehicle</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Move Vehicle</ptxt>
<test2>
<ptxt>If the current location is outside the service area, move the vehicle into the service area and operate again after a while.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Does not return to normal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Returns to normal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036FZ010X_02_0034" fin="false">A</down>
<right ref="RM0000036FZ010X_02_0038" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0034" proc-id="RM0550J___0000I5H00000">
<testtitle>Check Bluetooth Setting Procedure</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Bluetooth Setting Procedure</ptxt>
<test2>
<ptxt>Check that the phone has been registered using the correct procedure.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Registered using the correct procedure</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>When using a mobile phone with portable audio function as a hands-free device, it must be registered as a Bluetooth telephone connected device.</ptxt>
</atten4>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036FZ010X_02_0035" fin="false">OK</down>
<right ref="RM0000036FZ010X_02_0039" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0035" proc-id="RM0550J___0000I5I00000">
<testtitle>Check Model Used</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Model Used</ptxt>
<test2>
<ptxt>Check that the cellular phone used by the customer is a Bluetooth compatible cellular phone whose operation has been verified.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Model whose operation has been verified</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>If the cellular phone being used is not a model whose operation has been verified, inform the customer. (Compatible models can be checked at G-BOOK.com on the Internet)</ptxt>
</atten4>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036FZ010X_02_0036" fin="false">OK</down>
<right ref="RM0000036FZ010X_02_0040" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0036" proc-id="RM0550J___0000I5J00000">
<testtitle>Inspect by Replacing Cellular Phone</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>With the customer's permission, connect a staff member's G-BOOK compatible cellular phone.</ptxt>
<atten4>
<ptxt>Following the owner's manual, register and connect the Bluetooth cellular phone.</ptxt>
</atten4>
</test1>
<test1>
<ptxt>Check the connection.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Cannot connect to G-BOOK.com</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Can connect to G-BOOK.com</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<list1 type="unordered">
<item>
<ptxt>If there is a problem with the cellular phone, contact the customer and ask them to have the cellular phone checked.</ptxt>
</item>
<item>
<ptxt>After the inspection is complete, delete the registered cellular phone.</ptxt>
</item>
</list1>
</atten4>
</test1>
</content6>
<res>
<down ref="RM0000036FZ010X_02_0005" fin="false">A</down>
<right ref="RM0000036FZ010X_02_0041" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0005" proc-id="RM0550J___0000I5700000">
<testtitle>Contact G-BOOK Support Center</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Make an inquiry using the G-BOOK Support Center inquiry check sheet. (see <xref label="Seep01" href="RM000001C3Y021X"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>No center-side cause</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Center-side cause present</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000036FZ010X_02_0037" fin="true">A</down>
<right ref="RM0000036FZ010X_02_0042" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0037">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0038">
<testtitle>END</testtitle>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0039">
<testtitle>Check Settings</testtitle>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0040">
<testtitle>Replace Cellular Phone</testtitle>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0041">
<testtitle>Cellular Phone Malfunction</testtitle>
</testgrp>
<testgrp id="RM0000036FZ010X_02_0042">
<testtitle>Follow the instructions from the G-BOOK Support Center</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>