<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY07EX"/>
</testtitle>
</testgrp>
<testgrp id="RM00000365B014X_03_0009">
<testtitle>Replace Navigation Antenna Assembly<xref label="Seep01" href="RM000001XG8006X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000365B014X_03_0010">
<testtitle>Replace Navigation Antenna Assembly<xref label="Seep01" href="RM000001XG8006X"/>
</testtitle>
</testgrp>
</subpara>
</para>
