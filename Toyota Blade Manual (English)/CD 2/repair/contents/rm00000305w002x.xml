<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000B_S000N" variety="S000N">
<name>Exhaust</name>
<ttl id="1000B_S000N_74Y23_T00I4" variety="T00I4">
<name>Exhaust Manifold (2GR-FE)</name>
<para id="RM00000305W002X" category="A" type-id="80001" name-id="111I0-00" from="200708">
<name>Removal</name>
<subpara id="RM00000305W002X_02" type-id="01" category="01">
<s-1 id="RM00000305W002X_02_0060" proc-id="RM0550J___0000DHU00000">
<ptxt>Remove V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place both hands on the front of the cover and lift it upward to disengage the 2 front clips, then continue lifting upward to disengage the 1 rear clips, and remove the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Pulling up the front and rear at the same time may cause damage.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0061" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0062">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM00000305W002X_02_0063" proc-id="RM0550J___0000GWD00000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0064" proc-id="RM0550J___00008DP00000">
<ptxt>Remove Radiator Grille Protector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 radiator grille protectors.</ptxt>
<figure>
<graphic graphicname="B167060" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0065" proc-id="RM0550J___0000AJ800000">
<ptxt>Remove Engine Under Cover
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 4 screws, and remove the engine under cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0066" proc-id="RM0550J___0000AJ700000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove the engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0067" proc-id="RM0550J___00008DQ00000">
<ptxt>Remove Front Bumper Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a flat-tip screwdriver, turn the pin hold clip 90° and remove the pin hold clip.</ptxt>
<figure>
<graphic graphicname="B167061J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Perform the same procedure on the RH side.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Apply protective tape around the front bumper assembly.</ptxt>
<figure>
<graphic graphicname="B167062J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Using a clip remover, remove the 3 upper clips.</ptxt>
</s2>
<s2>
<ptxt>Remove the 6 screws, 2 clips and 2 bolts.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly outward from the vehicle to disengage the 8 claws (4 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167063" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly toward the front of the vehicle and remove the front bumper assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0068" proc-id="RM0550J___0000CCB00000">
<ptxt>Remove Millimeter Wave Radar Sensor Assembly (w/ Cruise Control (w/ Radar Cruise))
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="B180359" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 bolts and the millimeter wave radar sensor assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0069" proc-id="RM0550J___0000CWV00000">
<ptxt>Remove Millimeter Wave Radar Sensor Bracket NO.1 (w/ Cruise Control (w/ Radar Cruise))
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and millimeter wave radar sensor bracket NO.1.</ptxt>
<figure>
<graphic graphicname="B180360" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0070" proc-id="RM0550J___0000GUZ00000">
<ptxt>Remove Radiator Side Deflector LH
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="A178923" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Disengage the 3 clips and guide, and remove the radiator side cover LH.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0071" proc-id="RM0550J___0000HBM00000">
<ptxt>Remove Radiator Side Cover RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 2 clips and remove the radiator side cover RH.</ptxt>
<figure>
<graphic graphicname="A178924" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0072" proc-id="RM0550J___0000GW000000">
<ptxt>Drain Coolant (Toyota Genuine Super Long Life Coolant)<xref href="RM0000020WA00BX_02_0078"/>
</ptxt>
</s-1>
<s-1 id="RM00000305W002X_02_0073" proc-id="RM0550J___0000GW200000">
<ptxt>Disconnect Water Bypass Hose NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and 2 clamps, and disconnect water bypass hose NO.2 from the radiator support assembly.</ptxt>
<figure>
<graphic graphicname="A176291J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0074" proc-id="RM0550J___0000GW300000">
<ptxt>Disconnect Hood Lock Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the hood lock control assembly from the 2 clamps.</ptxt>
<figure>
<graphic graphicname="A155392" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 bolts and disconnect the hood lock assembly.</ptxt>
<figure>
<graphic graphicname="A162973" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0075" proc-id="RM0550J___0000HBU00000">
<ptxt>Remove Radiator Support Upper
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and the UPR2 radiator supports.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0076" proc-id="RM0550J___0000HBV00000">
<ptxt>Remove Radiator Support Cushion
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 radiator support cushions from fan shroud No. 2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0077" proc-id="RM0550J___0000GW400000">
<ptxt>Remove Radiator Support Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the 2 horn assembly connectors.</ptxt>
<figure>
<graphic graphicname="A162974" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 4 bolts and radiator support assembly.</ptxt>
<figure>
<graphic graphicname="A176292" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0078" proc-id="RM0550J___0000GW600000">
<ptxt>Disconnect Water Bypass Hose
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="A176293J02" width="2.775699831in" height="3.779676365in"/>
</figure>
<s2>
<ptxt>Slide the 2 clamps and disconnect water bypass hose No.1 and water bypass hose No.3.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0079" proc-id="RM0550J___0000GW500000">
<ptxt>Remove Fan Shroud NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the 2 clamps and disconnect the 2 horn assembly connectors from fan shroud No.2.</ptxt>
<figure>
<graphic graphicname="A178925" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and separate fan shroud No.2 from the radiator assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0080" proc-id="RM0550J___0000GW700000">
<ptxt>Disconnect Radiator Hose NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the clamp and disconnect radiator hose NO.2.</ptxt>
<figure>
<graphic graphicname="A159946" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0081" proc-id="RM0550J___0000GW800000">
<ptxt>Disconnect Radiator Hose NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the clamp and disconnect the radiator hose NO.1.</ptxt>
<atten4>
<ptxt>Pinch the claws at the clamp joint to remove it.</ptxt>
</atten4>
<figure>
<graphic graphicname="A176812" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Slide the clamp and disconnect radiator hose NO.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0082" proc-id="RM0550J___0000HBN00000">
<ptxt>Disconnect Oil Cooler Inlet Hose NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the clamp and disconnect the oil cooler inlet hose NO.1.</ptxt>
<figure>
<graphic graphicname="A177055" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0083" proc-id="RM0550J___0000HBO00000">
<ptxt>Disconnect Oil Cooler Outlet Hose NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the clamp and disconnect the oil cooler outlet hose NO.1.</ptxt>
<figure>
<graphic graphicname="A177056" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0084" proc-id="RM0550J___0000GW900000">
<ptxt>Disconnect Wire Harness
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the cooling fan motor connector and 2 wire harness clamps.</ptxt>
<figure>
<graphic graphicname="A176814" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0085" proc-id="RM0550J___0000GWA00000">
<ptxt>Disconnect Thermistor Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Detach the clip and disconnect the thermistor assembly.</ptxt>
<figure>
<graphic graphicname="A155390" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0086" proc-id="RM0550J___0000GWB00000">
<ptxt>Remove Radiator Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Separate the cooler condenser assembly from the fan shroud.   </ptxt>
</s2>
<s2>
<ptxt>Remove the radiator assembly together with the fan shroud from the vehicle.</ptxt>
<figure>
<graphic graphicname="A159948" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>When removing the radiator assembly, do not apply excessive force to the cooler condenser assembly and pipes.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Remove the 2 radiator supports lower.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0090" proc-id="RM0550J___0000HJ100000">
<ptxt>Remove Exhaust Pipe Assembly Center
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the oxygen sensor connector and clamp.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 nuts and 2 bolts.</ptxt>
<figure>
<graphic graphicname="A135140J05" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and 2 compression springs, and remove the exhaust center pipe assembly.</ptxt>
<figure>
<graphic graphicname="A135137J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0091" proc-id="RM0550J___0000FBG00000">
<ptxt>Remove Exhaust Pipe Assembly Front
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the NO.2 oxygen sensor connector and, using SST, remove the oxygen sensor.</ptxt>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="A177020" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and exhaust pipe bracket.</ptxt>
<figure>
<graphic graphicname="A179449" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 nuts and exhaust pipe assembly front.</ptxt>
<figure>
<graphic graphicname="A179450" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the gasket.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W002X_02_0024" proc-id="RM0550J___0000HJ600000">
<ptxt>Remove Manifold Stay</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and disconnect the exhaust manifold stay.</ptxt>
<figure>
<graphic graphicname="A133293" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0025" proc-id="RM0550J___0000HAO00000">
<ptxt>Remove Exhaust Manifold Sub-assembly RH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the air fuel ratio sensor connector.</ptxt>
</s2>
<s2>
<ptxt>Remove the 6 nuts and the exhaust manifold RH.</ptxt>
<figure>
<graphic graphicname="A182103" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0026" proc-id="RM0550J___0000HAP00000">
<ptxt>Remove Exhaust Manifold to Head Gasket</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the exhaust manifold to head gasket from the cylinder head.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0087" proc-id="RM0550J___0000HJJ00000">
<ptxt>Remove Exhaust Manifold Heat Insulator NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 bolts and exhaust manifold heat insulator NO.1.</ptxt>
<figure>
<graphic graphicname="A180025" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0089" proc-id="RM0550J___0000HJ700000">
<ptxt>Remove Air Fuel Ratio Sensor</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="A176286J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Using SST, remove the air fuel ratio sensor.</ptxt>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0027" proc-id="RM0550J___0000HAQ00000">
<ptxt>Remove Oil Level Gauge Guide</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="A129638" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Remove the oil level gauge.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 bolts, and remove the oil level gauge guide and oil level gauge guide NO.2.</ptxt>
</s2>
<s2>
<ptxt>Remove the O-rings from the oil level gauge guide and oil level gauge guide NO.2.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0028" proc-id="RM0550J___0000HAR00000">
<ptxt>Remove Manifold Stay NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and nut, and remove manifold stay NO.2.</ptxt>
<figure>
<graphic graphicname="A140783" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0029" proc-id="RM0550J___0000HAS00000">
<ptxt>Remove Exhaust Manifold Heat Insulator NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 bolts and exhaust manifold heat insulator NO.2.</ptxt>
<figure>
<graphic graphicname="A140784" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0088" proc-id="RM0550J___0000HJ800000">
<ptxt>Remove Air Fuel Ratio Sensor NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, remove air fuel ratio sensor NO.2.</ptxt>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="A180026J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0030" proc-id="RM0550J___0000HAT00000">
<ptxt>Remove Exhaust Manifold Sub-assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the air fuel ratio sensor connector.</ptxt>
</s2>
<s2>
<ptxt>Remove the 6 nuts and the exhaust manifold LH.</ptxt>
<figure>
<graphic graphicname="A179973" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W002X_02_0031" proc-id="RM0550J___0000HAU00000">
<ptxt>Remove Exhaust Manifold to Head Gasket LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the exhaust manifold to head gasket from the cylinder head.</ptxt>
<figure>
<graphic graphicname="A102842J04" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>