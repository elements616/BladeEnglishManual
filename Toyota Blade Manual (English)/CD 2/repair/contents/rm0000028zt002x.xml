<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002X_S000H" variety="S000H">
<name>Body Exterior</name>
<ttl id="1002X_S000H_746FH_T00BT" variety="T00BT">
<name>Back Door Garnish Sub-assembly Outside</name>
<para id="RM0000028ZT002X" category="A" type-id="30014" name-id="8215A-00" from="200612">
<name>Installation</name>
<subpara id="RM0000028ZT002X_02" type-id="01" category="01">
<s-1 id="RM0000028ZT002X_02_0031" proc-id="RM0550J___00008HC00000">
<ptxt>Install Back Door Garnish Sub-assembly Outside</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the back door outside garnish with the 4 nuts.</ptxt>
<figure>
<graphic graphicname="B167185" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect each connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028ZT002X_02_0043" proc-id="RM0550J___00009VP00000">
<ptxt>Install Back Door Trim Panel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 11 clips to install the back door trim panel assembly.</ptxt>
<figure>
<graphic graphicname="B155573J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install clip (A).</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000028ZT002X_02_0038" proc-id="RM0550J___00009VQ00000">
<ptxt>Install Back Door Inside Handle
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws to install the back door inside handle.</ptxt>
<figure>
<graphic graphicname="B155572" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028ZT002X_02_0039" proc-id="RM0550J___00009VR00000">
<ptxt>Install Back Door Side Garnish LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the clips and claws to install the back door side garnish LH.</ptxt>
<figure>
<graphic graphicname="B155569" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Align the guide position, and engage the 2 claws to install the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B155570J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the pin of the package tray trim garnish hook.</ptxt>
<figure>
<graphic graphicname="B163626" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028ZT002X_02_0040" proc-id="RM0550J___00009VS00000">
<ptxt>Install Back Door Side Garnish RH
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Install the RH side using the same procedure as for the LH side.</ptxt>
</atten4>
</content1></s-1>
<s-1 id="RM0000028ZT002X_02_0041" proc-id="RM0550J___00009VV00000">
<ptxt>Install Back Door Trim Panel Assembly Upper
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and 4 claws to install the back door trim panel assembly upper.</ptxt>
<figure>
<graphic graphicname="B155566" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028ZT002X_02_0042" proc-id="RM0550J___00009VW00000">
<ptxt>Camera Optical Axis Adjustment
</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM00000304S000X_02_0003"/>)</ptxt>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>