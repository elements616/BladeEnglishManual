<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="1001O_S001F" variety="S001F">
<name>Cruise Control</name>
<ttl id="1001O_S001F_74QXD_T00FC" variety="T00FC">
<name>Radar Cruise Control System</name>
<para id="RM00000064M00CX" category="C" type-id="301CU" name-id="59158-00" from="200708">
<dtccode>P1631/65</dtccode>
<dtcname>Engine → VSC Communication Malfunction</dtcname>
<subpara id="RM00000064M00CX_01" type-id="31" category="03" proc-id="RM0550J___0000CAC00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="unordered">
<item>
<ptxt>The distance control computer assembly outputs the brake control request signal and warning request signal to the ABS &amp; traction actuator assembly via the engine control computer. When these signals are input, the brake actuator is driven and the warning buzzer sounds.</ptxt>
</item>
<item>
<ptxt>The ABS &amp; traction actuator assembly outputs brake system malfunction signals, etc. to the engine control computer.</ptxt>
</item>
</list1>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P1631/65</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>Control vehicle speed (40 - 100 km/h), cruise control main switch ON (vehicle-to-vehicle distance control mode)</ptxt>
</item>
<item>
<ptxt>Communication data from the engine control computer to the ABS &amp; traction actuator assembly is abnormal</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
<item>
<ptxt>ABS &amp; Traction Actuator Assembly</ptxt>
</item>
<item>
<ptxt>CAN Communication System</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000064M00CX_02" type-id="32" category="03" proc-id="RM0550J___0000CAD00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E143506J02" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM00000064M00CX_03" type-id="51" category="05" proc-id="RM0550J___0000CAE00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>When the engine control computer is replaced with a new one, be sure to perform initialization. (see <xref label="Seep01" href="RM000002GO2003X"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM00000064M00CX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000064M00CX_04_0005" proc-id="RM0550J___0000CAG00000">
<testtitle>Replace Engine Control Computer</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the engine control computer with a new one. (see <xref label="Seep01" href="RM000002ADB004X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000064M00CX_04_0007" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000064M00CX_04_0007" proc-id="RM0550J___0000CHX00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs. (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000064M00CX_04_0001" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000064M00CX_04_0001" proc-id="RM0550J___0000CAF00000">
<testtitle>Check DTCs (Radar Cruise Control System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Put the vehicle in the conditions under which the DTC is detected.</ptxt>
<atten4>
<ptxt>The system cannot detect the malfunction unless the detection conditions are met.</ptxt>
</atten4>
<test2>
<ptxt>Drive within the cruise control set vehicle speed range.</ptxt>
</test2>
<test2>
<ptxt>Turn the cruise control main switch ON and put the system in vehicle-to-vehicle distance control mode standby.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs. (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.90in"/>
<colspec colname="COL2" colwidth="1.23in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P1631 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P1631 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000064M00CX_04_0006" fin="true">A</down>
<right ref="RM00000064M00CX_04_0002" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000064M00CX_04_0006">
<testtitle>Complete</testtitle>
</testgrp>
<testgrp id="RM00000064M00CX_04_0002">
<testtitle>Replace ABS &amp; Traction Actuator Assembly<xref label="Seep01" href="RM00000304U000X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>