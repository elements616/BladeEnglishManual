<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y1E_T00HP" variety="T00HP">
<name>Shift Lock Control Unit Assembly (U660E)</name>
<para id="RM0000016EG00HX" category="A" type-id="8000E" name-id="261JO-00" from="200708" to="200912">
<name>Reassembly</name>
<subpara id="RM0000016EG00HX_03" type-id="01" category="01">
<s-1 id="RM0000016EG00HX_03_0011" proc-id="RM0550J___0000HE500000">
<ptxt>Install Position Indicator Light Bulb</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the bulb cap to the position indicator light bulb.</ptxt>
</s2>
<s2>
<ptxt>Install the position indicator light bulb to the indicator light wire.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000016EG00HX_03_0012" proc-id="RM0550J___0000HE600000">
<ptxt>Install Indicator Light Wire</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the bulb socket and the 5 clamps to the position indicator housing.</ptxt>
<figure>
<graphic graphicname="C156201" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000016EG00HX_03_0013" proc-id="RM0550J___0000HE700000">
<ptxt>Install Position Indicator Slide Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install position indicator slide cover No.2 to the position indicator slide cover.</ptxt>
<figure>
<graphic graphicname="C156200" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the position indicator slide cover together with position indicator slide cover No.2 to the shift lock control unit.</ptxt>
<figure>
<graphic graphicname="C156199" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000016EG00HX_03_0014" proc-id="RM0550J___0000HE800000">
<ptxt>Install Position Indicator Housing Upper</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the position indicator housing UPR to the shift lock control unit.</ptxt>
<figure>
<graphic graphicname="C157083" width="2.775699831in" height="3.779676365in"/>
</figure>
<atten3>
<ptxt>Securely engage the claws.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>