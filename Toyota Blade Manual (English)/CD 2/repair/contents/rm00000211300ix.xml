<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_744E7_T004T" variety="T004T">
<name>EFI System (2AZ-FE)</name>
<para id="RM00000211300IX" category="C" type-id="303NO" name-id="065AE-00" from="200612">
<dtccode>P1602/A7</dtccode>
<dtcname>Battery Deterioration</dtcname>
<subpara id="RM00000211300IX_01" type-id="31" category="03" proc-id="RM0550J___0000C8Q00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>The battery condition is monitored, and if the voltage drops below a certain level while the engine is running (except during cranking), the engine control computer judges that the battery has deteriorated and outputs a DTC.</ptxt>
</item>
</list1>
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="3" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="0.8384652     in"/>
<colspec colnum="02" colname="C02" colwidth="3.154228     in"/>
<colspec colnum="03" colname="C03" colwidth="3.154227     in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry colname="C03" valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>P1602/A7</ptxt>
</entry>
<entry colname="C02" valign="middle" align="left">
<ptxt>1. Engine running (except during cranking)</ptxt>
<ptxt>2. When battery capacity drops abnormally</ptxt>
<ptxt>3.10 seconds or more</ptxt>
<ptxt>4.1 trip</ptxt>
</entry>
<entry colname="C03" valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Battery</ptxt>
</item>
<item>
<ptxt>Wire Harness or Connector</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000211300IX_02" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM00000211300IX_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000211300IX_03_0001" proc-id="RM0550J___0000C8R00000">
<testtitle>Inspect Battery</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Inspect Fluid Level</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Fluid level is within the specified range and there is no difference in fluid level</ptxt>
</specitem>
</spec>
</test1>
<test1>
<ptxt>Inspect Specific Gravity</ptxt>
<test2>
<ptxt>Inspect the battery specific gravity of each cell.</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt>1.25 to 1.29 (fluid temperature 20°C), specific gravity difference 0.04 or less</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>If it is not within the standard (no specific gravity difference), charge the battery.</ptxt>
</atten4>
<figure>
<graphic graphicname="A086946J02" width="2.775699831in" height="3.779676365in"/>
</figure>
</test2>
</test1>
<test1>
<ptxt>Voltage Inspection</ptxt>
<test2>
<ptxt>Measure the battery voltage during cranking.</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt>Approximately 9.6V or more</ptxt>
</specitem>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM00000211300IX_03_0002" fin="true">OK</down>
<right ref="RM00000211300IX_03_0003" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000211300IX_03_0002">
<testtitle>Inspect ECU Power Source System</testtitle>
</testgrp>
<testgrp id="RM00000211300IX_03_0003">
<testtitle>Battery Replacement</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>