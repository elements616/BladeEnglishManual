</testgrp>
<testgrp id="RM000002CVW008X_04_0005" proc-id="RM0550J___00002VT00000">
<scantool type="1"/>
<testtitle>Check DTC</testtitle>
<content6 releasenbr="2">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>After warming up the engine, drive in city traffic for 10 minutes.</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs. (see <xref label="Seep01" href="RM000000CCX015X"/>)</ptxt>
<spec>
