</test1>
</content6>
<res>
<down ref="RM00000060G00MX_08_0010" fin="false">OK</down>
<right ref="RM00000060G00MX_08_0016" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060G00MX_08_0010" proc-id="RM0550J___00007PH00000">
<testtitle>Inspect Wire Harness and Connector (IG1, GND1, GND2)</testtitle>
<content6 releasenbr="1">
