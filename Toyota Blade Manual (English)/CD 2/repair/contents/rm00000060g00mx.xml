<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Start the engine and measure the battery voltage using the SST (Toyota electrical tester).</ptxt>
