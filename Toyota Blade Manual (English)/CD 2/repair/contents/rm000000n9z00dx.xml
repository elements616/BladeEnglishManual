<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000N9Z00DX_04_0005" fin="true">OK</down>
<right ref="RM000000N9Z00DX_04_0004" fin="true">NG</right>
