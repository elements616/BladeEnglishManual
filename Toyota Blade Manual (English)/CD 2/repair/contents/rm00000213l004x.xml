<tmc-service-inc>
<pub id="RM0550J">
<servcat id="08">
<name>Heater &amp; Air Conditioner/Ventilation</name>
<section id="1002K_S000B" variety="S000B">
<name>Air Conditioner</name>
<ttl id="1002K_S000B_7421Z_T0029" variety="T0029">
<name>Blower Assembly</name>
<para id="RM00000213L004X" category="A" type-id="80002" name-id="5227P-00" from="200612">
<name>Disassembly</name>
<subpara id="RM00000213L004X_01" type-id="01" category="01">
<s-1 id="RM00000213L004X_01_0001" proc-id="RM0550J___000079L00000">
<ptxt>Remove Recirculation Damper Servo Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws and remove the recirculation damper servo.</ptxt>
<figure>
<graphic graphicname="E139301J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213L004X_01_0002" proc-id="RM0550J___000079M00000">
<ptxt>Remove Air Filter Case</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 2 claws as shown in the illustration and remove the air filter case.</ptxt>
<figure>
<graphic graphicname="E139303J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213L004X_01_0003" proc-id="RM0550J___000079N00000">
<ptxt>Remove Clean Air Filter</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the clean air filter from the blower assembly.</ptxt>
<figure>
<graphic graphicname="E139305J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213L004X_01_0004" proc-id="RM0550J___000079O00000">
<ptxt>Remove Blower Motor (with Fan)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 screws and remove the blower motor (with fan).</ptxt>
<figure>
<graphic graphicname="E139302J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>