<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000D_S000P" variety="S000P">
<name>Lubrication</name>
<ttl id="1000D_S000P_744GJ_T0075" variety="T0075">
<name>Oil Filter Element (2AZ-FE)</name>
<para id="RM000002963003X" category="A" type-id="80001" name-id="130RF-00" from="200612">
<name>Removal</name>
<subpara id="RM000002963003X_01" type-id="01" category="01">
<s-1 id="RM000002963003X_01_0001" proc-id="RM0550J___000032700000">
<ptxt>Drain Engine Oil</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the drain plug and drain the engine oil.</ptxt>
</s2>
<s2>
<ptxt>After draining the oil, install the drain plug with a new gasket.</ptxt>
<torque>
<torqueitem>
<t-value1>40</t-value1>
<t-value2>408</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000002963003X_01_0003" proc-id="RM0550J___00003W500000">
<ptxt>Remove Oil Filter Element Service Hole Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the clip.</ptxt>
<figure>
<graphic graphicname="A212179" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>As shown in the illustration, crease the service hole cover and open it.</ptxt>
<figure>
<graphic graphicname="A212181J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten4>
<ptxt>Crease the service hole cover so that its fold angle is held at 90° or more.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM000002963003X_01_0002" proc-id="RM0550J___00003W400000">
<ptxt>Remove Oil Filter Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, remove the oil filter.</ptxt>
<figure>
<graphic graphicname="A136990J03" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09228-06501</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>