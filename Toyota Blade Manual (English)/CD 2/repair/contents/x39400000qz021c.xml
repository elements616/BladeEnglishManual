<subpara id="X39400000QZ021C_12" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="X39400000QZ021C_13" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X39400000QZ021C_13_0004" proc-id="RM0550J___0000EVQ00000">
<scantool type="2"/>
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn the IG ON and clear the DTCs following the SST (TaSCAN) screen display. (see <xref label="Seep01" href="RM0000008YS014X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0005" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0005" proc-id="RM0550J___0000EVR00000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Perform a road test.</ptxt>
</test1>
<test1>
<ptxt>Check the DTCs by following the SST (TaSCAN) screen display. (see <xref label="Seep01" href="RM0000008YS014X"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Normal code is output.</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>The DTC judgment can be confirmed using the [Diagnosis Judgment Result Check] function of SST (TaSCAN). (see <xref label="Seep02" href="RM0000008YS014X"/>)</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0006" fin="true">OK</down>
<right ref="X39400000QZ021C_13_0002" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0006">
<testtitle>Inspection for Intermittent Problems<xref label="Seep01" href="RM000000CD101YX"/>
</testtitle>
</testgrp>
<testgrp id="X39400000QZ021C_13_0002" proc-id="RM0550J___0000HRZ00000">
<testtitle>Check for Rough Idle or Engine Stall</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check the engine idle condition.</ptxt>
<spec>
<title>Result</title>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="3.29in"/>
<colspec colname="COL2" colwidth="2.72in"/>
<colspec colname="COL3" colwidth="1.07in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>DTC Output</ptxt>
</entry>
<entry valign="middle">
<ptxt>Vehicle Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>P0016/18</ptxt>
</entry>
<entry valign="middle">
<ptxt>Normal idle speed</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>P0018/18</ptxt>
</entry>
<entry valign="middle">
<ptxt>Normal idle speed</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>P0016/18 or P0018/18</ptxt>
</entry>
<entry valign="middle">
<ptxt>Engine stalls or idles roughly</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0007" fin="false">A</down>
<right ref="X39400000QZ021C_13_0009" fin="false">B</right>
<right ref="X39400000QZ021C_13_0011" fin="false">C</right>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0007" proc-id="RM0550J___0000HS000000">
<scantool type="8"/>
<testtitle>Perform TaSCAN Active Test (VVT Control)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>With the engine stopped, turn the ignition ON.</ptxt>
</test1>
<test1>
<ptxt>Following the SST (TaSCAN) screen display, select [Active Test] - [VVT Control].</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Active Test (Oil Control Valve Condition)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Engine Condition</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>ON (OCV operates)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Engine stalls or idles roughly</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>OFF (OCV does not operate)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Normal idle speed</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0008" fin="true">OK</down>
<right ref="X39400000QZ021C_13_0011" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0008">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM000002ADB004X"/>
</testtitle>
</testgrp>
<testgrp id="X39400000QZ021C_13_0009" proc-id="RM0550J___0000HS100000">
<scantool type="8"/>
<testtitle>Perform TaSCAN Active Test (VVT Control Bank 2)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>With the engine stopped, turn the ignition ON.</ptxt>
</test1>
<test1>
<ptxt>Following the SST (TaSCAN) screen display, select [Active Test] - [VVT Control Bank 2].</ptxt>
</test1>
<test1>
<ptxt>With the engine idling, perform [OFF/ON].</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Active Test (Oil Control Valve Condition)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Engine Condition</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>ON (OCV operates)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Engine stalls or idles roughly</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>OFF (OCV does not operate)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Normal idle speed</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0010" fin="true">OK</down>
<right ref="X39400000QZ021C_13_0011" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0010">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM000002ADB004X"/>
</testtitle>
</testgrp>
<testgrp id="X39400000QZ021C_13_0011" proc-id="RM0550J___0000HS200000">
<testtitle>Inspect Camshaft Timing Oil Control Valve Assembly</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Remove the camshaft timing oil control valve assembly (intake side).</ptxt>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Terminal 1 - Terminal 2</ptxt>
</entry>
<entry valign="middle">
<ptxt>Approx. 20°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>6.9 to 7.9Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<figure>
<graphic graphicname="A145883J05" width="2.775699831in" height="2.775699831in"/>
</figure>
<test1>
<ptxt>Operation Check</ptxt>
<test2>
<ptxt>Apply battery voltage between the terminals and check that the spool valve operates.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Operates</ptxt>
</specitem>
</spec>
<atten3>
<ptxt>Check that the spool valve is not stuck.</ptxt>
</atten3>
<atten4>
<ptxt>A spool valve that does not return properly due to foreign matter such as sludge being caught may cause a slight pressure leak to the advance side, which may cause a DTC to be detected.</ptxt>
</atten4>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.03in"/>
<colspec colname="COL2" colwidth="1.10in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>OK</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>RH side malfunction</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>LH side malfunction</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0012" fin="false">A</down>
<right ref="X39400000QZ021C_13_0018" fin="true">B</right>
<right ref="X39400000QZ021C_13_0019" fin="true">C</right>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0012" proc-id="RM0550J___0000HS300000">
<testtitle>Inspect Valve Timing</testtitle>
<content6 releasenbr="1">
<figure>
<graphic graphicname="A095456J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<test1>
<ptxt>Inspect Valve Timing</ptxt>
<test2>
<ptxt>Remove the cylinder head cover and cylinder head cover LH.</ptxt>
</test2>
<test2>
<ptxt>Turn the crankshaft clockwise and align the notch of the crankshaft pulley with the 0° position.</ptxt>
</test2>
<test2>
<ptxt>As shown in the illustration, check that the timing marks of the camshaft timing gears are aligned. If the marks are not aligned, turn the crankshaft clockwise 1 more revolution.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Timing marks are aligned</ptxt>
</specitem>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0013" fin="false">OK</down>
<right ref="X39400000QZ021C_13_0020" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0013" proc-id="RM0550J___0000HS400000">
<testtitle>Inspect Oil Control Valve Filter</testtitle>
<content6 releasenbr="1">
<figure>
<graphic graphicname="A135388J02" width="2.775699831in" height="3.779676365in"/>
</figure>
<test1>
<ptxt>Remove oil pipe NO.1 or the oil pipe, and remove the oil control valve filter RH or LH.</ptxt>
</test1>
<test1>
<ptxt>Inspect the oil control valve filter for clogging</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>There is no clogging or adhering foreign matter</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0014" fin="false">OK</down>
<right ref="X39400000QZ021C_13_0021" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0014" proc-id="RM0550J___0000HS500000">
<testtitle>Inspect and Replace Oil Pipe</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Inspect and replace the oil pipe.</ptxt>
<atten4>
<ptxt>Check that the oil check valve bolt and oil pipe union are not clogged.</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0015" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0015" proc-id="RM0550J___0000HS600000">
<scantool type="2"/>
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn the ignition ON and clear the DTCs following the SST (TaSCAN) screen display. (see <xref label="Seep01" href="RM0000008YS014X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0016" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="X39400000QZ021C_13_0016" proc-id="RM0550J___0000HS700000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Perform a road test.</ptxt>
</test1>
<test1>
<ptxt>Check the DTCs by following the SST (TaSCAN) screen display. (see <xref label="Seep01" href="RM0000008YS014X"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Normal code is output</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>The DTC judgment can be confirmed using the [Diagnosis Judgment Result Check] function of SST (TaSCAN). (see <xref label="Seep02" href="RM0000008YS014X"/>)</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="X39400000QZ021C_13_0017" fin="true">OK</down>
<right ref="X39400000QZ021C_13_0022" fin="true">NG</right>
</res>
</testgrp>
