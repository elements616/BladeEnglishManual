<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="1001O_S001F" variety="S001F">
<name>Cruise Control</name>
<ttl id="1001O_S001F_74QXD_T00FC" variety="T00FC">
<name>Radar Cruise Control System</name>
<para id="RM000000DDT00CX" category="C" type-id="301CL" name-id="59152-00" from="200708">
<dtccode>P1575/66</dtccode>
<dtcname>Warning Buzzer Malfunction</dtcname>
<subpara id="RM000000DDT00CX_01" type-id="31" category="03" proc-id="RM0550J___0000C9Q00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1575/66</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>Control vehicle speed (40 - 100 km/h), cruise control main switch ON (vehicle-to-vehicle distance control mode)</ptxt>
</item>
<item>
<ptxt>Approach warning buzzer malfunction</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>ABS with EBD &amp; TRC &amp; VSC &amp; BA system</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000DDT00CX_03" type-id="51" category="05" proc-id="RM0550J___0000C9R00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the engine control computer is replaced with a new one, be sure to perform initialization. (see <xref label="Seep02" href="RM000002GO2003X"/>)</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM000000DDT00CX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DDT00CX_04_0006" proc-id="RM0550J___0000C9S00000">
<testtitle>Perform TaSCAN Active Test (VSC/HB Buzzer)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "Active Test" screen, and perform the Active Test.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Buzzer sounds</ptxt>
</specitem>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Test Details</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Restrictions</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>VSC, HB Buzzer</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Buzzer can be turned ON - OFF</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Possible at vehicle speed of 0km/h</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DDT00CX_04_0008" fin="false">OK</down>
<right ref="RM000000DDT00CX_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000DDT00CX_04_0008" proc-id="RM0550J___0000CEO00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Clear the DTCs using SST (TaSCAN). (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000DDT00CX_04_0009" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000DDT00CX_04_0009" proc-id="RM0550J___0000CEP00000">
<testtitle>Check DTCs (Radar Cruise Control System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Put the vehicle in the conditions under which the DTC is detected.</ptxt>
<atten4>
<ptxt>The system cannot detect the malfunction unless the detection conditions are met.</ptxt>
</atten4>
<test2>
<ptxt>Drive within the cruise control set vehicle speed range.</ptxt>
</test2>
<test2>
<ptxt>Turn the cruise control main switch ON and put the system in vehicle-to-vehicle distance mode standby.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs. (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.89in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>P1575 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>P1575 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DDT00CX_04_0010" fin="true">A</down>
<right ref="RM000000DDT00CX_04_0003" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DDT00CX_04_0010">
<testtitle>Go to Problem Symptom Simulation Method<xref label="Seep01" href="RM000000ABY04BX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DDT00CX_04_0005">
<testtitle>Go to ABS with EBD &amp; TRC &amp; VSC &amp; BA system<xref label="Seep01" href="RM00000061000RX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DDT00CX_04_0003">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM000002ADB004X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>