<item>
<ptxt>IG ON</ptxt>
</item>
<item>
<ptxt>Open or short in cooler thermistor circuit</ptxt>
</item>
<item>
<ptxt>Current malfunction, or recorded as past malfunction if continuous for 8.5 minutes or more</ptxt>
</item>
</list1>
</entry>
