<testgrp id="RM000002R2Y005X_04_0001" proc-id="RM0550J___0000FUE00000">
<testtitle>Inspect Transmission Control Computer Assembly (STA Voltage Inspection)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the transmission control computer connector.</ptxt>
<figure>
<graphic graphicname="C169062J03" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the terminals. (see <xref label="Seep01" href="RM000000AVF018X"/> for Terminals of ECU)</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COLSPEC1" colwidth="1.03in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>10(STA) - 8(E1)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 2 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002R2Y005X_04_0008" fin="false">OK</down>
<right ref="RM000002R2Y005X_04_0006" fin="true">NG</right>
</res>
</testgrp>
