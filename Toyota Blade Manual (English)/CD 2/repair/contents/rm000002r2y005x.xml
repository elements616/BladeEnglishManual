<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000002R2Y005X" category="C" type-id="800K2" name-id="261I1-00" from="200708">
<dtccode>P0617/43</dtccode>
<dtcname>Starter Circuit (High)</dtcname>
<subpara id="RM000002R2Y005X_01" type-id="31" category="03" proc-id="RM0550J___0000FUC00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>While the engine is cranking, battery voltage is applied to the STA terminal of the transmission control computer.</ptxt>
<ptxt>If the transmission control computer detects the starter control (STA) signal while the vehicle is being driven, it determines that there is a malfunction in the STA circuit, illuminates the check engine light and stores a DTC.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.06in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<colspec colname="COL3" colwidth="2.48in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>P0617/43</ptxt>
</entry>
<entry valign="middle" align="left">
<list1 type="ordered">
<item>
<ptxt>While driving (1000r/min or more, 20km/h or more)</ptxt>
</item>
<item>
<ptxt>STA signal input</ptxt>
</item>
<item>
<ptxt>20 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Neutral Start Switch Assembly</ptxt>
</item>
<item>
<ptxt>ST relay circuit</ptxt>
</item>
<item>
<ptxt>Starter system</ptxt>
</item>
<item>
<ptxt>Wire Harness or Connector</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
