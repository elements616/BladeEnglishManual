<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_746W2_T00DG" variety="T00DG">
<name>Back Guide Monitor System</name>
<para id="RM000000T8102EX" category="C" type-id="803MM" name-id="672RC-14" from="200912">
<dtccode>C1626</dtccode>
<dtcname>Steering Sensor Malfunction</dtcname>
<subpara id="RM000000T8102EX_05" type-id="33" category="03" proc-id="RM0550J___0000HY700000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when an internal malfunction signal is received from the steering sensor connected to the navigation receiver assembly via CAN communication.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1626</ptxt>
</entry>
<entry valign="middle">
<ptxt>Steering Angle Sensor Internal Malfunction</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Steering Sensor</ptxt>
</item>
<item>
<ptxt>Navigation Receiver Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000T8102EX_06" type-id="51" category="05" proc-id="RM0550J___0000HY800000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the battery terminal is disconnected, perform steering sensor neutral point memorization. (see <xref label="Seep01" href="RM000000GCY00LX"/>)</ptxt>
</item>
<item>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration and setting operations for other systems as well as the back guide monitor system may be necessary. (see <xref label="Seep02" href="RM000002FZ603QX"/>)</ptxt>
</item>
<item>
<ptxt>If registration/setting becomes necessary while proceeding with the inspection, perform the registration/setting work before proceeding to the next inspection step.</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM000000T8102EX_07" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000T8102EX_07_0010" proc-id="RM0550J___0000HY900000">
<testtitle>Replace Steering Sensor</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the steering sensor. (see <xref label="Seep01" href="RM000000QFH008X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000T8102EX_07_0011" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000T8102EX_07_0011" proc-id="RM0550J___0000HYA00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ05NX"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again, and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>"C1626" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000000T8102EX_07_0009" fin="true">A</down>
<right ref="RM000000T8102EX_07_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000T8102EX_07_0009">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000T8102EX_07_0004">
<testtitle>END</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>