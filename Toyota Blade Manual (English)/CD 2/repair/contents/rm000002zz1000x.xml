<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7420N_T0015" variety="T0015">
<name>Lighting System</name>
<para id="RM000002ZZ1000X" category="C" type-id="8031J" name-id="603KU-00" from="200612">
<dtccode>B2450</dtccode>
<dtcname>Initialization not performed</dtcname>
<subpara id="RM000002ZZ1000X_01" type-id="33" category="03" proc-id="RM0550J___000066D00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when initialization has not been performed after replacing the headlight leveling computer assembly.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.29in"/>
<colspec colname="COL2" colwidth="3.56in"/>
<colspec colname="COL3" colwidth="2.24in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B2450</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Headlight leveling computer assembly not initialized</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Headlight Leveling Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000002ZZ1000X_02" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000002ZZ1000X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002ZZ1000X_03_0001" proc-id="RM0550J___000066E00000">
<testtitle>Initialize Headlight Leveling Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Initialize the headlight leveling computer assembly. (see <xref label="Seep01" href="RM0000030GL000X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002ZZ1000X_03_0002" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002ZZ1000X_03_0002" proc-id="RM0550J___000066F00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), recheck the DTCs.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.97in"/>
<colspec colname="COL2" colwidth="1.16in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>No DTC output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>DTC "B2450" is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>If B2450 is output even after initialization is performed, the headlight leveling computer assembly may be malfunctioning.</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="RM000002ZZ1000X_03_0004" fin="true">A</down>
<right ref="RM000002ZZ1000X_03_0003" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000002ZZ1000X_03_0003">
<testtitle>Replace Headlight Leveling Computer Assembly<xref label="Seep01" href="RM000001X8N001X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002ZZ1000X_03_0004">
<testtitle>Complete</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>