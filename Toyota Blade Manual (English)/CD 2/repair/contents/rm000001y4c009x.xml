<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.37in"/>
<colspec colname="COL2" colwidth="1.92in"/>
<colspec colname="COL3" colwidth="0.84in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>13(T) - 19(E)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Light control switch OFF</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>13(T) - 19(E)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Light control switch TAIL</ptxt>
</entry>
