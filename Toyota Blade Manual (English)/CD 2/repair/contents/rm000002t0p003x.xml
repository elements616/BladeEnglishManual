</entry>
<entry valign="middle" align="center">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test1>
</content6>
<res>
<down ref="RM000002T0P003X_04_0008" fin="true">A</down>
<right ref="RM000002T0P003X_04_0010" fin="true">B</right>
<right ref="RM000002T0P003X_04_0011" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM000002T0P003X_04_0008">
<testtitle>Perform Simulation Method<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
