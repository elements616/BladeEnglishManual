<ptxt>Using SST (Toyota electrical tester), measure the voltage between each terminal of connector B and body ground.</ptxt>
<table>
<title>Voltage:</title>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.19in"/>
<colspec colname="COL2" colwidth="0.96in"/>
<colspec colname="COL3" colwidth="0.98in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1-29 (+SR) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>1V or less</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
