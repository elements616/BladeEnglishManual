<tmc-service-inc>
<pub id="RM0550J">
<servcat id="S1">
<name>Introduction</name>
<section id="10002_S0013" variety="S0013">
<name>Introduction</name>
<ttl id="10002_S0013_744ZM_T009X" variety="T009X">
<name>Frame, Engine and Transaxle Serial Numbers</name>
<para id="RM0000005D202AX" category="F" type-id="30020" name-id="012PL-01" from="200708" to="200810">
<name>Stamp Location</name>
<subpara id="RM0000005D202AX_z0" proc-id="RM0550J___0000GT500000">
<content5 releasenbr="1">
<step1>
<ptxt>Frame No.</ptxt>
<step2>
<ptxt>The frame No. is stamped on the vehicle body inside the cabin (under the floor carpet cover below the front seat RH) and printed on the name label on the center pillar.</ptxt>
<figure>
<graphic graphicname="D101802J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>A</title>
<specitem>
<ptxt>Frame No.</ptxt>
</specitem>
</spec>
<spec>
<title>B</title>
<specitem>
<ptxt>Name Label</ptxt>
</specitem>
</spec>
</step2>
</step1>
<step1>
<ptxt>Engine No. and Transaxle No.</ptxt>
<step2>
<ptxt>The engine No. is stamped on the cylinder block.</ptxt>
<figure>
<graphic graphicname="D102233J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>A</title>
<specitem>
<ptxt>2AZ-FE</ptxt>
</specitem>
</spec>
<spec>
<title>B</title>
<specitem>
<ptxt>2GR-FE</ptxt>
</specitem>
</spec>
</step2>
<step2>
<ptxt>The transaxle No. is stamped on the transaxle case or transaxle housing.</ptxt>
<atten4>
<ptxt>The location of the transmission No. stamp differs depending on the vehicle.</ptxt>
</atten4>
<figure>
<graphic graphicname="D100989J02" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>A</title>
<specitem>
<ptxt>K112</ptxt>
</specitem>
</spec>
<spec>
<title>B</title>
<specitem>
<ptxt>K112F</ptxt>
</specitem>
</spec>
<figure>
<graphic graphicname="D102234J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>C</title>
<specitem>
<ptxt>U660E</ptxt>
</specitem>
</spec>
</step2>
</step1>
</content5>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>