</content5>
</subpara>
<subpara id="RM00000060E00VX_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM00000060E00VX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000060E00VX_04_0004" proc-id="RM0550J___00004GL00000">
<testtitle>Acquire Yaw Rate Sensor 0-point</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Perform the 0 point acquisition procedure for the yaw rate sensor (with built-in G sensor). (see <xref label="Seep01" href="RM000001A8300PX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000060E00VX_04_0005" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000060E00VX_04_0005" proc-id="RM0550J___00004GM00000">
<scantool type="1"/>
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Clear the DTCs and check again. (see <xref label="Seep01" href="RM00000060000PX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>OK</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Malfunction Code</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060E00VX_04_0006" fin="true">A</down>
<right ref="RM00000060E00VX_04_0009" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000060E00VX_04_0006">
<testtitle>Return to Normal</testtitle>
</testgrp>
<testgrp id="RM00000060E00VX_04_0009">
<testtitle>Replace ABS &amp; Traction Actuator Assembly<xref label="Seep01" href="RM00000304V000X"/>
</testtitle>
</testgrp>
</subpara>
</para>
