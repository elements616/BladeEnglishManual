<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_747JL_T00DX" variety="T00DX">
<name>Air Fuel Ratio Sensor (2AZ-FE)</name>
<para id="RM0000020W300AX" category="A" type-id="80001" name-id="065BL-00" from="200612">
<name>Removal</name>
<subpara id="RM0000020W300AX_02" type-id="01" category="01">
<s-1 id="RM0000020W300AX_02_0009" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020W300AX_02_0006" proc-id="RM0550J___000070S00000">
<ptxt>Remove Exhaust Manifold Heat Insulator NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and remove the exhaust manifold heat insulator No.1.</ptxt>
<figure>
<graphic graphicname="A112189" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020W300AX_02_0004" proc-id="RM0550J___0000BY200000">
<ptxt>Remove Air Fuel Ratio Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the air fuel ratio sensor connector.</ptxt>
<figure>
<graphic graphicname="A098744" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST, disconnect the air fuel ratio sensor from the exhaust manifold.</ptxt>
<figure>
<graphic graphicname="A135149J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>