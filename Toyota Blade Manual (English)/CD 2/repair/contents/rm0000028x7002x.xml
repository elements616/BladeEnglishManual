<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742BE_T003O" variety="T003O">
<name>Ultrasonic Sensor NO.1</name>
<para id="RM0000028X7002X" category="A" type-id="80001" name-id="672ES-00" from="200612" to="200912">
<name>Removal</name>
<subpara id="RM0000028X7002X_01" type-id="01" category="01">
<s-1 id="RM0000028X7002X_01_0019" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000028X7002X_01_0020" proc-id="RM0550J___00008DP00000">
<ptxt>Remove Radiator Grille Protector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 radiator grille protectors.</ptxt>
<figure>
<graphic graphicname="B167060" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000028X7002X_01_0021" proc-id="RM0550J___00008DQ00000">
<ptxt>Remove Front Bumper Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a flat-tip screwdriver, turn the pin hold clip 90° and remove the pin hold clip.</ptxt>
<figure>
<graphic graphicname="B167061J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Perform the same procedure on the RH side.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Apply protective tape around the front bumper assembly.</ptxt>
<figure>
<graphic graphicname="B167062J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Using a clip remover, remove the 3 upper clips.</ptxt>
</s2>
<s2>
<ptxt>Remove the 6 screws, 2 clips and 2 bolts.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly outward from the vehicle to disengage the 8 claws (4 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167063" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly toward the front of the vehicle and remove the front bumper assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000028X7002X_01_0017" proc-id="RM0550J___0000AJK00000">
<ptxt>Remove Ultrasonic Sensor NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="E147313" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 claws and remove ultrasonic sensor NO.1.</ptxt>
<figure>
<graphic graphicname="E140917" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028X7002X_01_0018" proc-id="RM0550J___0000AJL00000">
<ptxt>Remove Ultrasonic Sensor Retainer NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 2 claws and remove ultrasonic sensor retainer NO.1 from the front bumper assembly.</ptxt>
<figure>
<graphic graphicname="E140918" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>