<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>HTR</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005LE017X_08_0015" fin="false">OK</down>
<right ref="RM0000005LE017X_08_0022" fin="true">NG</right>
</res>
</testgrp>
