<para id="RM0000005LE017X" category="J" type-id="300CJ" name-id="5229G-00" from="200612">
<dtccode/>
<dtcname>Blower motor circuit</dtcname>
<subpara id="RM0000005LE017X_05" type-id="31" category="03" proc-id="RM0550J___0000BZF00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The blower motor (with fan) reads signals from the air conditioner amplifier assembly and controls the rotation and speed of the blower motor.</ptxt>
</content5>
</subpara>
<subpara id="RM0000005LE017X_06" type-id="32" category="03" proc-id="RM0550J___0000BZG00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E145611J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM0000005LE017X_07" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM0000005LE017X_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000005LE017X_08_0013" proc-id="RM0550J___0000BZH00000">
<testtitle>Perform TaSCAN Active Test (Blower Level)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), operate according to the screen instructions and perform the Active Test.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<title>[Diagnosis menu screen: Body → A/C → Active Test]</title>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Test Details</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Restrictions</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Blower Airflow</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Blower motor operation</ptxt>
</entry>
<entry valign="middle">
<ptxt>Range 0 to 31 (Level)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<table>
<title>Result</title>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.89in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Active Test is not performed normally</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Active Test is performed normally</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005LE017X_08_0014" fin="false">A</down>
<right ref="RM0000005LE017X_08_0021" fin="true">B</right>
</res>
