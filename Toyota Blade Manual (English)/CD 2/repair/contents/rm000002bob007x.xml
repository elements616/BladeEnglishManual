<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000002BOB007X" category="C" type-id="3037R" name-id="261I5-00" from="200708">
<dtccode>P0741/64</dtccode>
<dtcname>SL Solenoid Circuit (Performance)</dtcname>
<subpara id="RM000002BOB007X_01" type-id="33" category="03" proc-id="RM0550J___0000FS500000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The transmission control computer controls the hydraulic pressure to the lock-up relay valve by the ON or OFF signal of solenoid SL, turning lock-up ON or OFF. </ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.90in"/>
<colspec colname="COL2" colwidth="3.34in"/>
<colspec colname="COL3" colwidth="2.84in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0741/64</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>While driving in D range with engine coolant temperature 40°C or higher and ATF temperature -10°C or higher (no malfunction of SL1, SL2, SL3, SL4, transmission revolution sensor (NT, NC) or fluid temperature sensor is detected)</ptxt>
</item>
<item>
<ptxt>Engine speed is 70rpm or more higher than turbine speed during (a) and (b)</ptxt>
<ptxt>(a). When lock-up is requested</ptxt>
<ptxt>(b). Hydraulic pressure switch No.3 is ON</ptxt>
</item>
<item>
<ptxt>3.5 seconds or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Automatic transmission 3 way solenoid assembly (SL)</ptxt>
</item>
<item>
<ptxt>Transmission wire</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
<item>
<ptxt>Transmission Valve Body Assembly </ptxt>
</item>
<item>
<ptxt>Torque Converter Assembly </ptxt>
</item>
<item>
<ptxt>Transaxle Assembly </ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000002BOB007X_02" type-id="51" category="05" proc-id="RM0550J___0000FS600000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Using SST (TaSCAN), read the Freeze Frame Data. Freeze frame data records the engine and vehicle conditions when a malfunction occurs, and this information is useful for troubleshooting and malfunction reproduction tests.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM000002BOB007X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002BOB007X_03_0001" proc-id="RM0550J___0000FS700000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the [Diagnosis Menu/ECT] screen, and select [DTC Freeze Data].</ptxt>
</test1>
<test1>
<ptxt>Check the DTCs and freeze data.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.07in"/>
<colspec colname="COL2" colwidth="1.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Only P0741/64 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>P0741/64 and other DTCs are output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<atten4>
<list1 type="unordered">
<item>
<ptxt>If any DTCs other than solenoid and hydraulic pressure switch malfunctions are output, troubleshoot those DTCs first.</ptxt>
</item>
<item>
<ptxt>If only multiple solenoid malfunction codes are output, inspect the solenoids corresponding to the output DTCs at the same time.</ptxt>
</item>
</list1>
</atten4>
</content6>
<res>
<down ref="RM000002BOB007X_03_0008" fin="false">A</down>
<right ref="RM000002BOB007X_03_0005" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000002BOB007X_03_0008" proc-id="RM0550J___0000FSA00000">
<testtitle>Inspect Transmission Wire</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Remove the transmission control computer. (see <xref label="Seep01" href="RM0000024M9003X"/>)</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the transmission wire.</ptxt>
<figure>
<graphic graphicname="C133212J14" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.99in"/>
<colspec colname="COL2" colwidth="1.11in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>6 (SL) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>20°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 15Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>NG</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>OK</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002BOB007X_03_0002" fin="false">A</down>
<right ref="RM000002BOB007X_03_0018" fin="false">B</right>
</res>
</testgrp>
<testgrp id="RM000002BOB007X_03_0002" proc-id="RM0550J___0000FS800000">
<testtitle>Inspect Transmission 3-way Solenoid Assembly (ATM) (SL)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (Toyota electrical tester), check the resistance between the terminals.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.99in"/>
<colspec colname="COL2" colwidth="1.11in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Terminal 1 - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>20°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 15Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002BOB007X_03_0010" fin="true">OK</down>
<right ref="RM000002BOB007X_03_0006" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002BOB007X_03_0010">
<testtitle>Repair or Replace Transmission Wire<xref label="Seep01" href="RM000002BOQ004X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002BOB007X_03_0018" proc-id="RM0550J___0000FSB00000">
<testtitle>Inspect Transmission Valve Body Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Visually check that there are no abnormalities in the solenoid installation areas of the valve body, etc.</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002BOB007X_03_0021" fin="false">OK</down>
<right ref="RM000002BOB007X_03_0022" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002BOB007X_03_0021" proc-id="RM0550J___0000FSE00000">
<testtitle>Replace Transmission Control Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the transmission control computer. (see <xref label="Seep02" href="RM0000024M8003X"/>)</ptxt>
</test1>
<test1>
<ptxt>Perform AT learned value initialization and AT unit compensation. (see <xref label="Seep01" href="RM000000OLY013X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002BOB007X_03_0019" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002BOB007X_03_0019" proc-id="RM0550J___0000FSC00000">
<scantool type="2"/>
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Clear the DTCs. (see <xref label="Seep01" href="RM000000AW201LX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002BOB007X_03_0020" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002BOB007X_03_0020" proc-id="RM0550J___0000FSD00000">
<scantool type="1"/>
<testtitle>Check DTC Output</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Perform a road test based on the customer problem analysis and freeze frame data. (see <xref label="Seep02" href="RM000000ITK01FX_01_0008"/>)</ptxt>
</test1>
<test1>
<ptxt>Recheck the DTCs. (see <xref label="Seep01" href="RM000000AW201LX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.10in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>P0741/64 is output again</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>DTC normal</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002BOB007X_03_0003" fin="false">A</down>
<right ref="RM000002BOB007X_03_0016" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000002BOB007X_03_0003" proc-id="RM0550J___0000FS900000">
<testtitle>Inspect Torque Converter Assembly</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the torque converter assembly inspection procedure, refer to <xref label="Seep01" href="RM0000016ES00BX"/>.</ptxt>
</atten4>
</content6>
<res>
<down ref="RM000002BOB007X_03_0004" fin="false">OK</down>
<right ref="RM000002BOB007X_03_0007" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002BOB007X_03_0004" proc-id="RM0550J___0000HCB00000">
<testtitle>Repair or Replace Automatic Transaxle Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Repair or replace the transaxle assembly (ATM). (see <xref label="Seep01" href="RM0000016DU00JX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000002BOB007X_03_0023" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000002BOB007X_03_0023">
<testtitle>A/T Unit Compensation<xref label="Seep01" href="RM000000OLY013X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002BOB007X_03_0005">
<testtitle>Go to Related DTC Chart<xref label="Seep01" href="RM000000DAO01DX"/>
</testtitle>
</testgrp>
<testgrp id="RM000002BOB007X_03_0006">
<testtitle>Replace transmission 3 way solenoid assembly (ATM) (SL)</testtitle>
</testgrp>
<testgrp id="RM000002BOB007X_03_0007">
<testtitle>Replace Torque Converter Assembly</testtitle>
</testgrp>
<testgrp id="RM000002BOB007X_03_0016">
<testtitle>Complete</testtitle>
</testgrp>
<testgrp id="RM000002BOB007X_03_0022">
<testtitle>Repair or replace transmission valve body assembly<xref label="Seep01" href="RM000002BOT003X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>