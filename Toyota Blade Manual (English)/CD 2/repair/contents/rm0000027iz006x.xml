<name>Engine Mechanical</name>
<ttl id="1000A_S000K_744EY_T005K" variety="T005K">
<name>Engine Mounting Insulator Rear (2AZ-FE)</name>
<para id="RM0000027IZ006X" category="A" type-id="30014" name-id="071TA-00" from="200612">
<name>Installation</name>
<subpara id="RM0000027IZ006X_01" type-id="01" category="01">
<s-1 id="RM0000027IZ006X_01_0001" proc-id="RM0550J___000033R00000">
<ptxt>Install Engine Mounting Insulator Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine mounting insulator RR with the 2 bolts and 2 nuts.</ptxt>
<figure>
<graphic graphicname="A124842" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the engine mounting insulator RR to the engine mounting bracket RR with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="A136361" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM0000027IZ006X_01_0004" proc-id="RM0550J___0000BBJ00000">
<ptxt>Connect Transmission Control Cable Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the transmission control cable support to the engine mounting insulator RR with the bolt.</ptxt>
<figure>
<graphic graphicname="C155726J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<torque>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM0000027IZ006X_01_0005" proc-id="RM0550J___0000AJA00000">
<ptxt>Install Engine Under Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install engine under cover No.2 with the 5 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000027IZ006X_01_0006" proc-id="RM0550J___0000AJC00000">
<ptxt>Install Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine under cover No.1 with the 6 bolts and 7 clips.</ptxt>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
