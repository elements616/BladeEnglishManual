<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1000Y_S0012" variety="S0012">
<name>SRS Airbag</name>
<ttl id="1000Y_S0012_744XV_T009G" variety="T009G">
<name>Instrument Panel Airbag Assembly Lower NO.1</name>
<para id="RM000000QFT007X" category="A" type-id="30014" name-id="554IB-00" from="200612">
<name>Installation</name>
<subpara id="RM000000QFT007X_02" type-id="01" category="01">
<s-1 id="RM000000QFT007X_02_0031" proc-id="RM0550J___00006P100000">
<ptxt>Install Instrument Panel Airbag Assembly Lower NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector to the instrument lower airbag No.1.</ptxt>
<figure>
<graphic graphicname="C154076" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Securely lock the connector.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the instrument lower airbag No.1 with the 6 claws and 2 guides.</ptxt>
<figure>
<graphic graphicname="C163136J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the instrument lower airbag No.1 with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="C163133" width="2.775699831in" height="3.779676365in"/>
</figure>
<torque>
<torqueitem>
<t-value1>10</t-value1>
<t-value2>102</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000000QFT007X_02_0032">
<ptxt>Install Instrument Panel Under Cover Sub-assembly NO.1</ptxt>
</s-1>
<s-1 id="RM000000QFT007X_02_0041" proc-id="RM0550J___00005VX00000">
<ptxt>Install Steering Column Cover
</ptxt>
<content1 releasenbr="1">
<atten3>
<ptxt>If the installation procedure is incorrect, gaps may form in the column cover.</ptxt>
</atten3>
<s2>
<ptxt>Engage the 2 claws and pins, and install the steering column cover (upper side).</ptxt>
<figure>
<graphic graphicname="C160714" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 claws and install the steering column cover (lower side).</ptxt>
<figure>
<graphic graphicname="C160713" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 4 claws.</ptxt>
<figure>
<graphic graphicname="C160711" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the claws.</ptxt>
<figure>
<graphic graphicname="C161537" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<ptxt>Push the bottom surface of the steering column cover (lower side) to securely engage the claws.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000000QFT007X_02_0037" proc-id="RM0550J___00005VZ00000">
<ptxt>Install Steering Wheel Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Align the matchmarks and install the steering wheel assembly to the steering column assembly.  </ptxt>
<figure>
<graphic graphicname="C160709J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the nut.  </ptxt>
<torque>
<torqueitem>
<t-value1>50</t-value1>
<t-value2>510</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect each connector to the spiral cable.  </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000QFT007X_02_0038" proc-id="RM0550J___00006KS00000">
<ptxt>Install Horn Button Assembly
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C162622" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Connect the horn connector to the horn button assembly.</ptxt>
</s2>
<s2>
<ptxt>Connect the airbag connector to the horn button assembly and lock it securely.</ptxt>
<atten3>
<ptxt>Securely lock the airbag connector.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Using a torx socket wrench (T30), install the horn button assembly to the steering wheel assembly with the 2 torx bolts.</ptxt>
<figure>
<graphic graphicname="C159692J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<torque>
<torqueitem>
<t-value1>8.8</t-value1>
<t-value2>90</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000000QFT007X_02_0039" proc-id="RM0550J___00006LH00000">
<ptxt>Install Steering Wheel Cover Lower NO.3
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C154144" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Engage the claws and install the steering wheel cover lower No.3.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000QFT007X_02_0040" proc-id="RM0550J___00006LI00000">
<ptxt>Install Steering Wheel Cover Lower NO.2
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C154145" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Engage the claws and install the steering wheel cover lower No.2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000QFT007X_02_0034" proc-id="RM0550J___0000BD300000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM000000QFT007X_02_0035" proc-id="RM0550J___00008CC00000">
<ptxt>Airbag Warning Light Inspection</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM00000050I01GX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000000QFT007X_02_0036" proc-id="RM0550J___00008CD00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>