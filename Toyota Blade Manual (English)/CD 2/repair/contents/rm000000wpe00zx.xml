<testtitle>Inspection for Intermittent Problems<xref label="Seep01" href="RM000000CD101FX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000WPE00ZX_04_0005">
<testtitle>Replace Stop Light Switch Assembly</testtitle>
</testgrp>
<testgrp id="RM000000WPE00ZX_04_0006">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000000WPE00ZX_04_0007">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM0000020V0005X"/>
</testtitle>
</testgrp>
</subpara>
</para>
