<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_744E7_T004T" variety="T004T">
<name>EFI System (2AZ-FE)</name>
<para id="RM000000WPE00ZX" category="C" type-id="305RH" name-id="065AA-00" from="200612">
<dtccode>P0724/95</dtccode>
<dtcname>STP Light SW ON Malfunction</dtcname>
<subpara id="RM000000WPE00ZX_01" type-id="31" category="03" proc-id="RM0550J___00002V600000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The stop light switch detects the operating condition of the brake pedal and outputs it to the engine control computer. The stop light switch is installed on the brake pedal bracket, and is connected to the engine control computer via the wire harness.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.85in"/>
<colspec colname="COL2" colwidth="3.04in"/>
<colspec colname="COL3" colwidth="3.19in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0724/95</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>With the stop light switch remaining ON, driving condition (30km/h or more) and stopped condition (3km/h or less) were repeated 10 times</ptxt>
</item>
<item>
<ptxt>STP signal stuck ON</ptxt>
</item>
<item>
<ptxt>-</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Stop Light Switch Assembly</ptxt>
</item>
<item>
<ptxt>Wire Harness or Connector</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000WPE00ZX_02" type-id="32" category="03" proc-id="RM0550J___00002V700000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="A160628J02" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000WPE00ZX_03" type-id="51" category="05" proc-id="RM0550J___00002V800000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Using SST (TaSCAN), read the Freeze Frame Data. Freeze frame data records part of the engine operating condition when a malfunction occurs, and this information is useful when troubleshooting.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM000000WPE00ZX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000WPE00ZX_04_0001" proc-id="RM0550J___00002V900000">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Stop Light Switch)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), operate according to the screen display and select the data list item [Stop Light SW] from [Diagnosis Function Menu] → [ECU Data Monitor].</ptxt>
</test1>
<test1>
<ptxt>Read the [OFF→ON] displayed on SST (TaSCAN) when the brake pedal is operated (released → depressed).</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Specified Condition</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Brake pedal released → depressed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>OFF → ON</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>Check the data monitor of the stop light switch assembly while driving the vehicle.</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="RM000000WPE00ZX_04_0004" fin="true">OK</down>
<right ref="RM000000WPE00ZX_04_0002" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000000WPE00ZX_04_0002" proc-id="RM0550J___00002VA00000">
<testtitle>Inspect Stop Light Switch Assembly</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the connector.</ptxt>
<figure>
<graphic graphicname="A072924J08" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.92in"/>
<colspec colname="COLSPEC0" colwidth="2.05in"/>
<colspec colname="COL2" colwidth="1.16in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Specified Condition</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry morerows="1" valign="middle" align="center">
<ptxt>1 - 2</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shaft not pushed in</ptxt>
<ptxt>(Brake depressed)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Shaft pushed in</ptxt>
<ptxt>(Brake not depressed)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry morerows="1" valign="middle" align="center">
<ptxt>3 - 4</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shaft not pushed in</ptxt>
<ptxt>(Brake depressed)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Shaft pushed in</ptxt>
<ptxt>(Brake not depressed)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000WPE00ZX_04_0003" fin="false">OK</down>
<right ref="RM000000WPE00ZX_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000WPE00ZX_04_0003" proc-id="RM0550J___00002VB00000">
<testtitle>Inspect Wire Harness and Connector (Stop Light Switch Assembly - Engine Control Computer)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D701ZX"/></ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the stop light switch assembly connector and connector B of the engine control computer.</ptxt>
<figure>
<graphic graphicname="A107846J09" width="2.775699831in" height="3.779676365in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the engine control computer and the stop light switch assembly vehicle side connector. (see <xref label="Seep02" href="X39400000QV016D"/> for Terminals of ECU)</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COLSPEC0" colwidth="1.37in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Name)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B36 (STP) - Terminal 1</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>B35 (ST1-) - Terminal 4</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000WPE00ZX_04_0007" fin="true">OK</down>
<right ref="RM000000WPE00ZX_04_0006" fin="true">NG</right>
</res>
</testgrp>
