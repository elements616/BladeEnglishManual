<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7420E_T000W" variety="T000W">
<name>Side Turn Signal Light Assembly LH</name>
<para id="RM000001X7U001X" category="A" type-id="30014" name-id="603J5-00" from="200612">
<name>Installation</name>
<subpara id="RM000001X7U001X_01" type-id="01" category="01">
<s-1 id="RM000001X7U001X_01_0007" proc-id="RM0550J___0000A6900000">
<ptxt>Install Side Turn Signal Light Assembly LH</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E147002" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Install the side turn signal light assembly LH with the 3 screws.</ptxt>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X7U001X_01_0012" proc-id="RM0550J___00001Y400000">
<ptxt>Install Outer Mirror Cover LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Fit the outer mirror cover RH over the outer rear view mirror assembly from the direction of claws A and B.</ptxt>
<figure>
<graphic graphicname="B164041" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Check that the outer circumference of the outer mirror cover RH is securely fitted into the outer rear view mirror assembly RH.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Engage the 7 claws and install the outer mirror cover RH.</ptxt>
<atten3>
<ptxt>Make sure the claws are securely engaged.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000001X7U001X_01_0013" proc-id="RM0550J___00001YC00000">
<ptxt>Install Outer Mirror LH (w/o Cold Area Specification)
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert the 2 guides.</ptxt>
<figure>
<graphic graphicname="B167051J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 claws and install the outer mirror RH.</ptxt>
<figure>
<graphic graphicname="B167472" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001X7U001X_01_0014" proc-id="RM0550J___00001YD00000">
<ptxt>Install Outer Mirror LH (w/ Cold Area Specification)
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
<figure>
<graphic graphicname="B156290" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Insert the 2 guides.</ptxt>
<figure>
<graphic graphicname="B167051J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 claws and install the outer mirror RH.</ptxt>
<figure>
<graphic graphicname="B167472" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
