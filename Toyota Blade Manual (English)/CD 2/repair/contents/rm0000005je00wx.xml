<s-number>09991-70200</s-number>
</sstitem>
</sst>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>OK</ptxt>
</specitem>
</spec>
</content6>
<res>
<down ref="RM0000005JE00WX_02_0029" fin="true">OK</down>
<right ref="RM0000005JE00WX_02_0031" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005JE00WX_02_0022" proc-id="RM0550J___0000A1H00000">
<testtitle>Replace Immobiliser Code Computer (ID Code Box)</testtitle>
<content6 releasenbr="1">
