<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="60001_S0006" variety="S0006">
<name>Body Multiplex Communication [LIN]</name>
<ttl id="60001_S0006_741KA_T000J" variety="T000J">
<name>Large-scale Body Multiplex Communication System [LIN]</name>
<para id="RM00000210W008X" category="C" type-id="801RZ" name-id="940AG-00" from="200612">
<dtccode>B1206</dtccode>
<dtcname>Power window SW not connected</dtcname>
<subpara id="RM00000210W008X_01" type-id="31" category="03" proc-id="RM0550J___000009L00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The instrument panel junction block assembly (main body ECU) outputs this code when communication with the multiplex network master switch assembly (driver side power window switch) is interrupted for 10 seconds or more.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.85in"/>
<colspec colname="COL2" colwidth="2.83in"/>
<colspec colname="COL3" colwidth="3.40in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Trouble Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B1206</ptxt>
</entry>
<entry valign="middle">
<ptxt>Communication malfunction between the power window regulator master switch assembly (driver side power window switch) and the instrument panel junction block assembly (main body ECU) (communication interrupted for 10 seconds or more) and communication line malfunction</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Fuse (ECU-B2 7.5A)</ptxt>
</item>
<item>
<ptxt>Wire Harness or Connector</ptxt>
</item>
<item>
<ptxt>Power window regulator master switch assembly (driver side power window switch)</ptxt>
</item>
<item>
<ptxt>Instrument Panel Junction Block Assembly (Main Body ECU)</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000210W008X_02" type-id="32" category="03" proc-id="RM0550J___000009M00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="B162408J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM00000210W008X_03" type-id="51" category="05" proc-id="RM0550J___000009N00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<list1 type="unordered">
<item>
<ptxt>When using SST (TaSCAN) with the ignition switch OFF, repeatedly turn any door courtesy light switch ON/OFF (at intervals of 1.5 seconds or less) until communication between SST (TaSCAN) and the vehicle starts.</ptxt>
</item>
<item>
<ptxt>When the main body ECU is replaced with a new one and the battery negative terminal is reconnected, it enters the IG ON state. Also, when the battery is removed and reinstalled, it returns to the state it was in when the battery was removed.</ptxt>
</item>
</list1>
</atten4>
</content5>
</subpara>
<subpara id="RM00000210W008X_05" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000210W008X_05_0008" proc-id="RM0550J___000009O00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs. (see <xref label="Seep01" href="RM000000693012X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000210W008X_05_0009" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000210W008X_05_0009" proc-id="RM0550J___000009P00000">
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs. (see <xref label="Seep01" href="RM000000693012X"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.60in"/>
<colspec colname="COL2" colwidth="1.53in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B1206 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B1206 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000210W008X_05_0010" fin="false">A</down>
<right ref="RM00000210W008X_05_0014" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000210W008X_05_0010" proc-id="RM0550J___000009Q00000">
<testtitle>Inspect Fuse</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), measure the resistance of the fuse. Check that the 7.5A fuse is normal.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Inspection Fuse</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>ECU-B2 Fuse</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000210W008X_05_0011" fin="false">OK</down>
<right ref="RM00000210W008X_05_0015" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000210W008X_05_0011" proc-id="RM0550J___000009R00000">
<testtitle>Inspect Wire Harness or Connector (Power Source and Ground)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="E125936J12" width="2.775699831in" height="1.771723296in"/>
</figure>
<test1>
<ptxt>Disconnect the connector of the power window regulator master switch assembly (driver side power window switch).</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage of the vehicle side wire harness connector terminal.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.96in"/>
<colspec colname="COL2" colwidth="1.17in"/>
<colspec colname="COL3" colwidth="1.00in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>11 (B) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance of the vehicle side wire harness connector terminal.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.94in"/>
<colspec colname="COL2" colwidth="1.17in"/>
<colspec colname="COL3" colwidth="1.02in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>12 (GND) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000210W008X_05_0012" fin="false">OK</down>
<right ref="RM00000210W008X_05_0016" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000210W008X_05_0012" proc-id="RM0550J___000009S00000">
<testtitle>Inspect Wire Harness or Connector (Instrument Panel Junction Block Assembly - Power Window Regulator Master Switch Assembly)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="B162409J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<test1>
<ptxt>Disconnect the instrument panel junction block assembly (main body ECU) connector V and the power window regulator master switch assembly (driver side power window switch) connector.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the vehicle side wire harness connector.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.03in"/>
<colspec colname="COL2" colwidth="1.10in"/>
<colspec colname="COL3" colwidth="1.00in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
<ptxt>(Main Body ECU - Driver Side Power Window Switch)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>V23(LIN2) - 17(LIN1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.01in"/>
<colspec colname="COL2" colwidth="1.10in"/>
<colspec colname="COL3" colwidth="1.02in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
<ptxt>(Driver Side Power Window Switch)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>17 (LIN1) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000210W008X_05_0013" fin="false">OK</down>
<right ref="RM00000210W008X_05_0016" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000210W008X_05_0013" proc-id="RM0550J___000009T00000">
<testtitle>Replace with Known Good Driver Side Power Window Switch</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Replace the power window regulator master switch assembly (driver side power window switch) with a known good one.</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs. (see <xref label="Seep01" href="RM000000693012X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000210W008X_05_0019" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000210W008X_05_0019" proc-id="RM0550J___000009U00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again. (see <xref label="Seep01" href="RM000000693012X"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.60in"/>
<colspec colname="COL2" colwidth="1.53in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B1206 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTC B1206 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000210W008X_05_0018" fin="true">A</down>
<right ref="RM00000210W008X_05_0017" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000210W008X_05_0014">
<testtitle>Go to Problem Symptom Simulation Method<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
<testgrp id="RM00000210W008X_05_0015">
<testtitle>Replace Fuse</testtitle>
</testgrp>
<testgrp id="RM00000210W008X_05_0016">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM00000210W008X_05_0017">
<testtitle>Replace Instrument Panel Junction Block Assembly</testtitle>
</testgrp>
<testgrp id="RM00000210W008X_05_0018">
<testtitle>End (driver side power window switch malfunction)</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>