<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="08">
<name>Heater &amp; Air Conditioner/Ventilation</name>
<section id="1002K_S000B" variety="S000B">
<name>Air Conditioner</name>
<ttl id="1002K_S000B_7421V_T0025" variety="T0025">
<name>Heater &amp; Air Conditioner System</name>
<para id="RM0000005L600GX" category="C" type-id="300BE" name-id="5227H-00" from="200612">
<dtccode>B1424/24</dtccode>
<dtcname>D-seat solar sensor malfunction (normal output indoors)</dtcname>
<subpara id="RM0000005L600GX_10" type-id="11" category="10">
<name>Warning/Caution/Reference</name>
</subpara>
<subpara id="RM0000005L600GX_01" type-id="31" category="03" proc-id="RM0550J___00000X900000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The cooler thermistor (solar sensor) is installed on the top of the instrument panel, detects the amount of sunlight and performs "AUTO" control of the heater &amp; air conditioner. The output voltage of the cooler thermistor (solar sensor) changes in accordance with changes in the amount of sunlight: as sunlight increases, the output voltage increases, and as sunlight decreases, the output voltage decreases. The air conditioner amplifier assembly reads the voltage output from the cooler thermistor (solar sensor).</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B1424/24</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>Sunlight present</ptxt>
</item>
<item>
<ptxt>Open or short in cooler thermistor (solar sensor) D-seat side circuit</ptxt>
</item>
<item>
<ptxt>Continuous for 8.5 minutes or more (recorded as past malfunction only when shorted)</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Cooler Thermistor (Solar Sensor)</ptxt>
</item>
<item>
<ptxt>Wire harness and connector (between air conditioner amplifier assembly and cooler thermistor (solar sensor))</ptxt>
</item>
<item>
<ptxt>Air Conditioner Amplifier Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000005L600GX_02" type-id="32" category="03" proc-id="RM0550J___00000XA00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E145615J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM0000005L600GX_03" type-id="51" category="05" proc-id="RM0550J___00000XB00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>Diagnostic trouble codes may be output in conditions with no direct sunlight, such as indoors or in cloudy weather.</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM0000005L600GX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000005L600GX_04_0001" proc-id="RM0550J___00000XC00000">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Solar Sensor D Seat)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), inspect the ECU Data Monitor by following the screen instructions.</ptxt>
<spec>
<table pgwide="1">
<title>[Diagnosis menu screen: Body → A/C → ECU Data Monitor]</title>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.49in"/>
<colspec colname="COL2" colwidth="2.50in"/>
<colspec colname="COL3" colwidth="3.09in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
<ptxt>[Item Symbol]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Reference Value</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Driver Side Solar Sensor</ptxt>
<ptxt>[SUD]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Sunlight present</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Increases as it gets brighter, in range 0-255</ptxt>
</item>
<item>
<ptxt>When open: (0) displayed</ptxt>
</item>
<item>
<ptxt>When shorted: (255) displayed</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.03in"/>
<colspec colname="COL2" colwidth="1.10in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>ECU Data Monitor reference values are abnormal</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>ECU Data Monitor reference values are normal (when inspecting according to Diagnostic Trouble Code Chart)</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Reference values by ECU Data Monitor are normal (when inspecting according to List by Symptom)</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005L600GX_04_0003" fin="false">A</down>
<right ref="RM0000005L600GX_04_0004" fin="true">B</right>
<right ref="RM0000005L600GX_04_0020" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM0000005L600GX_04_0003" proc-id="RM0550J___00000XE00000">
<testtitle>Inspect Wire Harness and Connector (Cooler Thermistor (Solar Sensor) - Air Conditioner Amplifier Assembly)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D701ZX"/>.</ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the cooler thermistor (solar sensor) connector.</ptxt>
</test1>
<test1>
<ptxt>Disconnect connector A of the air conditioner amplifier assembly.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the connector terminals of the vehicle wire harness. (see <xref label="Seep02" href="RM0000005KW01EX"/> for Terminals of ECU)</ptxt>
<figure>
<graphic graphicname="E144393J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.65in"/>
<colspec colname="COL2" colwidth="1.36in"/>
<colspec colname="COL3" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1 (S5) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>3 (TSD) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1(S5) - A31(S5-4)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>3(TSD) - A33(TSD)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005L600GX_04_0002" fin="false">OK</down>
<right ref="RM0000005L600GX_04_0012" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005L600GX_04_0002" proc-id="RM0550J___00000XD00000">
<testtitle>Inspect Cooler Thermistor (Solar Sensor)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect the cooler thermistor (solar sensor) connector.</ptxt>
</test1>
<test1>
<ptxt>Connect connector A of the air conditioner amplifier assembly.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the terminals of the cooler thermistor (solar sensor) connector.</ptxt>
<figure>
<graphic graphicname="E127185J03" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.36in"/>
<colspec colname="COL2" colwidth="1.65in"/>
<colspec colname="COL3" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1(S5) - 3(TSD)</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>Not exposed to direct sunlight (sensor covered with cloth)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 0.8V</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1(S5) - 3(TSD)</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>When inspection light is brought close</ptxt>
</entry>
<entry valign="middle">
<ptxt>0.8 to 4.3V</ptxt>
<ptxt>(Changes according to light intensity)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>The sensor may not respond if the light is weak, so use an incandescent inspection light and bring it 30cm or closer when measuring.</ptxt>
</atten3>
</test1>
</content6>
<res>
<down ref="RM0000005L600GX_04_0009" fin="true">OK</down>
<right ref="RM0000005L600GX_04_0011" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005L600GX_04_0004">
<testtitle>Replace Air Conditioner Amplifier Assembly<xref label="Seep01" href="RM000002140002X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000005L600GX_04_0020">
<testtitle>Go to the next circuit inspection shown in the List by Symptom<xref label="Seep01" href="RM0000005KX01HX"/>
</testtitle>
</testgrp>
<testgrp id="RM0000005L600GX_04_0011">
<testtitle>Replace Cooler Thermistor (Solar Sensor)</testtitle>
</testgrp>
<testgrp id="RM0000005L600GX_04_0012">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM0000005L600GX_04_0009">
<testtitle>Replace Air Conditioner Amplifier Assembly<xref label="Seep01" href="RM000002140002X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
