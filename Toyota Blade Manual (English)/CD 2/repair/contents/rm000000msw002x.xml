<ptxt>Inspect Front Door Lock Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Door Lock Operation Inspection</ptxt>
<figure>
<graphic graphicname="B148075J04" width="2.775699831in" height="3.779676365in"/>
</figure>
<s3>
<ptxt>Inspect the door lock operation when battery voltage is applied to each terminal of the connector.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.93in"/>
<colspec colname="COL2" colwidth="1.2in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Battery connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Door Lock Operation</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Battery positive → 4 (L)</ptxt>
<ptxt>Battery negative → 1 (UL)</ptxt>
</entry>
<entry valign="middle">
<ptxt>LOCK</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Battery positive → 1 (UL)</ptxt>
<ptxt>Battery negative → 4 (L)</ptxt>
</entry>
<entry valign="middle">
<ptxt>UNLOCK</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s3>
</s2>
