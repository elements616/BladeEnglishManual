<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74XSO_T00GG" variety="T00GG">
<name>Engine Control Computer (2GR-FE)</name>
<para id="RM0000020UY00CX" category="A" type-id="30014" name-id="066Q1-00" from="200708">
<name>Installation</name>
<subpara id="RM0000020UY00CX_03" type-id="01" category="01">
<s-1 id="RM0000020UY00CX_03_0053" proc-id="RM0550J___0000GT200000">
<ptxt>Install Engine Control Computer</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine control computer bracket with the 4 screws.</ptxt>
<figure>
<graphic graphicname="A162896" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the clamp and install the engine control computer with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A162895" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>8.0</t-value1>
<t-value2>82</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the 2 engine control computer connectors to the engine control computer.</ptxt>
<figure>
<graphic graphicname="A157544" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>When connecting the connectors, be careful not to allow foreign matter such as mud or water to adhere to the connecting parts.</ptxt>
</item>
</list1>
</atten3>
<list1 type="unordered">
<item>
<ptxt>Securely lock the lever.</ptxt>
</item>
</list1>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020UY00CX_03_0063" proc-id="RM0550J___0000DM000000">
<ptxt>Install Air Cleaner Case
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the air cleaner case with the 3 bolts.</ptxt>
<figure>
<graphic graphicname="A178719" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>7.0</t-value1>
<t-value2>71</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the clamp.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020UY00CX_03_0064" proc-id="RM0550J___0000F3H00000">
<ptxt>Install Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the hinge portion first, and then install the air cleaner cap w/ air cleaner hose with the 3 clamps.</ptxt>
<figure>
<graphic graphicname="A176815J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the clamp hose band. (<sup>*</sup>1)</ptxt>
</s2>
<s2>
<ptxt>Connect ventilation hose No.2. (<sup>*</sup>2)</ptxt>
</s2>
<s2>
<ptxt>Connect the air flow meter connector. (<sup>*</sup>3)</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020UY00CX_03_0062" proc-id="RM0550J___0000DLZ00000">
<ptxt>Install Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery to the vehicle</ptxt>
</s2>
<s2>
<ptxt>Install the insulator.</ptxt>
</s2>
<s2>
<ptxt>Connect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the battery clamp with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>17</t-value1>
<t-value2>173</t-value2>
<ptxt>(Bolt)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the battery positive terminal with the nut.</ptxt>
<torque>
<torqueitem>
<t-value1>13</t-value1>
<t-value2>130</t-value2>
<ptxt>(Nut)</ptxt>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000020UY00CX_03_0057">
<ptxt>Connect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM0000020UY00CX_03_0061" proc-id="RM0550J___0000FQ400000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 9 clips.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020UY00CX_03_0060" proc-id="RM0550J___0000DMG00000">
<ptxt>Install V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 clips to install the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Make sure the clips are securely engaged.</ptxt>
</item>
<item>
<ptxt>Engaging them with excessive force or striking the top of the clips may cause damage.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM0000020UY00CX_03_0065" proc-id="RM0550J___0000HJG00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW011X"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>