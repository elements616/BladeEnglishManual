<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001H_S0001" variety="S0001">
<name>Seat</name>
<ttl id="1001H_S0001_76AU3_T00JK" variety="T00JK">
<name>Seat Heater Switch</name>
<para id="RM000003SZ7001X" category="A" type-id="80001" name-id="791YD-02" from="200912">
<name>Removal</name>
<subpara id="RM000003SZ7001X_01" type-id="01" category="01">
<s-1 id="RM000003SZ7001X_01_0003" proc-id="RM0550J___0000ABV00001">
<ptxt>Remove Box Panel NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply protective tape to the positions shown in the illustration.</ptxt>
<figure>
<graphic graphicname="B236930J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Apply protective tape on the RH side in the same way.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Using a moulding remover, disengage the 4 clips.</ptxt>
</s2>
<s2>
<ptxt>Using a moulding remover, disengage the 2 claws.</ptxt>
<figure>
<graphic graphicname="B236931" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect each connector and remove box panel No.2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000003SZ7001X_01_0002" proc-id="RM0550J___0000HVM00001">
<ptxt>Remove Seat Heater Switch</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 2 claws and remove the seat heater switch.</ptxt>
<figure>
<graphic graphicname="B247430" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Remove the LH side using the same procedure.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>