<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="05">
<name>Suspension</name>
<section id="1002I_S0016" variety="S0016">
<name>Suspension</name>
<ttl id="1002I_S0016_7450F_T00AQ" variety="T00AQ">
<name>Rear Suspension Arm Assembly NO.1 LH</name>
<para id="RM000001X41002X" category="A" type-id="30014" name-id="421GN-00" from="200612">
<name>Installation</name>
<subpara id="RM000001X41002X_02" type-id="01" category="01">
<s-1 id="RM000001X41002X_02_0018" proc-id="RM0550J___000085T00000">
<ptxt>Temporarily Tighten Rear Suspension Arm Assembly NO.1 LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert the stud of the rear suspension arm assembly No.1 LH into the rear axle carrier, and temporarily tighten it with the nut.</ptxt>
<figure>
<graphic graphicname="C149527" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the rear suspension arm assembly No.1 LH to the rear suspension member, and temporarily tighten it with the bolt and nut.</ptxt>
<figure>
<graphic graphicname="C149529" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Hold the nut and tighten the bolt.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Fully tighten the nut of the rear suspension arm assembly No.1 LH.</ptxt>
<figure>
<graphic graphicname="C149527" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>100</t-value1>
<t-value2>1020</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X41002X_02_0019" proc-id="RM0550J___000085U00000">
<ptxt>Install Rear Tire</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>103</t-value1>
<t-value2>1050</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM000001X41002X_02_0020" proc-id="RM0550J___000085Y00000">
<ptxt>Stabilize Suspension</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Lower the vehicle and bounce it up and down several times to stabilize the rear suspension.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X41002X_02_0021" proc-id="RM0550J___000085W00000">
<ptxt>Fully Tighten Rear Suspension Arm Assembly NO.1 LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Fully tighten the bolt of the rear suspension arm assembly No.1 LH (rear suspension member side).</ptxt>
<figure>
<graphic graphicname="C149529" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>90</t-value1>
<t-value2>918</t-value2>
</torqueitem>
</torque>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Hold the nut and tighten the bolt.</ptxt>
</item>
<item>
<ptxt>Perform the work with the vehicle on the ground.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X41002X_02_0022" proc-id="RM0550J___000085X00000">
<ptxt>Inspect / Adjust Rear Wheel Alignment</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000000MIL00DX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>