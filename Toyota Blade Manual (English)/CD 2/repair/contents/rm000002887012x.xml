<subpara id="RM000002887012X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002887012X_04_0021" proc-id="RM0550J___00006A300001">
<scantool type="1"/>
<testtitle>Check DTCs (Check Past Malfunction DTCs)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check for history DTCs. (see <xref label="Seep01" href="RM00000050J01GX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>DTC B1622 is not output</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002887012X_04_0001" fin="false">OK</down>
<right ref="RM000002887012X_04_0023" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002887012X_04_0001" proc-id="RM0550J___000069Q00001">
<testtitle>Connector Inspection</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D705AX"/></ptxt>
</atten4>
<test1>
<ptxt>Disconnect the battery negative terminal and wait for 90 seconds.</ptxt>
<atten4>
<ptxt>Make sure the ignition switch is OFF before disconnecting the cable from the negative (-) battery terminal.</ptxt>
</atten4>
</test1>
<test1>
<ptxt>Inspect the condition of the connectors connected to the airbag computer assembly, side airbag sensor assembly RH and airbag sensor rear RH.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>The connector is connected properly</ptxt>
</specitem>
</spec>
</test1>
<test1>
<ptxt>Disconnect the connectors from the airbag computer assembly, side airbag sensor assembly RH and airbag sensor rear RH, and inspect the condition of the terminals of each connector.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>The terminals are not deformed or damaged</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002887012X_04_0002" fin="false">OK</down>
<right ref="RM000002887012X_04_0016" fin="true">NG</right>
</res>
</testgrp>
