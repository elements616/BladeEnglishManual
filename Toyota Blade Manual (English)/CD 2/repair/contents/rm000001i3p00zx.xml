</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Shift Position D Range</ptxt>
<ptxt>[D]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates D range / S position</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shift lever N → D</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>OFF→ON</ptxt>
</entry>
