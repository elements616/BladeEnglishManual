<para id="RM000001I3P00ZX" category="C" type-id="801ED" name-id="066O9-00" from="200708">
<dtccode>P0705/C2</dtccode>
<dtcname>T/M Control SW Malfunction</dtcname>
<subpara id="RM000001I3P00ZX_01" type-id="33" category="03" proc-id="RM0550J___0000D9U00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The engine control computer detects the shift position using signals from the neutral start switch assembly. The engine can be started only when the shift lever is in the P or N position.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.06in"/>
<colspec colname="COL2" colwidth="2.97in"/>
<colspec colname="COL3" colwidth="3.05in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
<item>
<ptxt>Others</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0705/C2</ptxt>
</entry>
<entry>
<list1 type="ordered">
<item>
<ptxt>IG ON, battery voltage 10.5V or more</ptxt>
</item>
<item>
<ptxt>(a). 2 or more of the P, R, N and D position signals are ON simultaneously</ptxt>
<ptxt>(b). 2 or more of the NSW (STAR), R and D range signals are ON simultaneously</ptxt>
<ptxt>(c). With the S position signal input, any of the NSW (STAR), P, R or N position signals is ON simultaneously</ptxt>
<ptxt>(d). All NSW (STAR), P, R, N and D position signals are OFF</ptxt>
</item>
<item>
<ptxt>2 seconds or more [(a), (b) and (c)]</ptxt>
<ptxt>60 seconds or more [(d)]</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Neutral Start Switch Assembly</ptxt>
</item>
<item>
<ptxt>Transmission Control Switch</ptxt>
</item>
<item>
<ptxt>Wire Harness and Connector</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
