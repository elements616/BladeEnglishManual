</entry>
<entry valign="middle" align="center">
<ptxt>Shift lever N → R → P</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ON→OFF→ON</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Shift Position P Range</ptxt>
<ptxt>[P]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates P range</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shift lever P</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ON</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Shift Position R Range</ptxt>
<ptxt>[R]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates R range</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shift lever N → R</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>OFF→ON</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Shift Position N Range</ptxt>
