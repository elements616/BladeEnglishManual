<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000B_S000N" variety="S000N">
<name>Exhaust</name>
<ttl id="1000B_S000N_74XTD_T00GR" variety="T00GR">
<name>Exhaust Pipe Assembly (2GR-FE)</name>
<para id="RM0000020W700BX" category="A" type-id="80001" name-id="111I3-00" from="200708">
<name>Removal</name>
<subpara id="RM0000020W700BX_01" type-id="01" category="01">
<s-1 id="RM0000020W700BX_01_0003" proc-id="RM0550J___0000FBE00000">
<ptxt>Remove Exhaust Tail Pipe Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and 2 compression springs.</ptxt>
<figure>
<graphic graphicname="C160032" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the 2 exhaust pipe supports and remove the exhaust tail pipe assembly.</ptxt>
</s2>
<s2>
<ptxt>Remove the gasket.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W700BX_01_0007" proc-id="RM0550J___0000HIU00000">
<ptxt>Remove Front Floor Brace Center</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and the front floor brace center.</ptxt>
<figure>
<graphic graphicname="A159958" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W700BX_01_0004" proc-id="RM0550J___0000FBF00000">
<ptxt>Remove Exhaust Pipe Sub-assembly Center NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and 2 compression springs. </ptxt>
<figure>
<graphic graphicname="A135137J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 4 exhaust pipe supports and remove the center exhaust pipe assembly NO.2.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W700BX_01_0006" proc-id="RM0550J___0000FBH00000">
<ptxt>Remove Exhaust Pipe Assembly Center</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the oxygen sensor and, using SST, remove the oxygen sensor.</ptxt>
<figure>
<graphic graphicname="A135138" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Remove the 2 bolts and 2 nuts, and remove the exhaust center pipe assembly.</ptxt>
<figure>
<graphic graphicname="A135140J05" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 gaskets.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W700BX_01_0005" proc-id="RM0550J___0000FBG00000">
<ptxt>Remove Exhaust Pipe Assembly Front</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the NO.2 oxygen sensor connector and, using SST, remove the oxygen sensor.</ptxt>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="A177020" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and exhaust pipe bracket.</ptxt>
<figure>
<graphic graphicname="A179449" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 nuts and exhaust pipe assembly front.</ptxt>
<figure>
<graphic graphicname="A179450" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the gasket.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>