</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the stop light switch assembly.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.92in"/>
<colspec colname="COL2" colwidth="2.16in"/>
<colspec colname="COL3" colwidth="1.05in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry morerows="1" valign="middle" align="center">
<ptxt>1 - 2</ptxt>
</entry>
<entry>
<ptxt>Shaft not pushed in</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>When shaft is pushed in</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt> 10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<figure>
<graphic graphicname="A161615J01" width="2.775699831in" height="1.771723296in"/>
