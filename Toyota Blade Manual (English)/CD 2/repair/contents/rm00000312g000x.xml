<name>Body &amp; Electrical</name>
<section id="1002X_S000H" variety="S000H">
<name>Body Exterior</name>
<ttl id="1002X_S000H_746FH_T00BT" variety="T00BT">
<name>Back Door Garnish Sub-assembly Outside</name>
<para id="RM00000312G000X" category="A" type-id="80002" name-id="82158-00" from="200612">
<name>Disassembly</name>
<subpara id="RM00000312G000X_01" type-id="01" category="01">
<s-1 id="RM00000312G000X_01_0004" proc-id="RM0550J___00001I800000">
<ptxt>Remove Television Camera Assembly (w/ HDD Navigation System)
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws and the television camera assembly from the back door outside garnish assembly.</ptxt>
<figure>
<graphic graphicname="E147027" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000312G000X_01_0002" proc-id="RM0550J___0000AQC00000">
<ptxt>Remove Rear Garnish Bracket NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide rear garnish bracket NO.1 upward as shown in the illustration to remove it.</ptxt>
<figure>
<graphic graphicname="B167186" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000312G000X_01_0003" proc-id="RM0550J___0000AQD00000">
<ptxt>Remove Back Door Opener Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 nuts and back door opener switch.</ptxt>
<figure>
<graphic graphicname="B167187" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
