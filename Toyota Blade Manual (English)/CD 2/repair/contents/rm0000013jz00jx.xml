<para id="RM0000013JZ00JX" category="C" type-id="800YA" name-id="3225U-00" from="200612">
<dtccode>P0840/C8</dtccode>
<dtcname>Belt Clamping Pressure Sensor Circuit</dtcname>
<dtccode>P0842/C8</dtccode>
<dtcname>Belt Clamping Pressure Sensor Circuit (Low)</dtcname>
<dtccode>P0843/C8</dtccode>
<dtcname>Belt Clamping Pressure Sensor Circuit (High)</dtcname>
<subpara id="RM0000013JZ00JX_01" type-id="33" category="03" proc-id="RM0550J___000047U00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The engine control computer performs learning control of the belt clamping pressure based on the belt clamping pressure signal detected by the oil pressure sensor.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.40in"/>
<colspec colname="COL3" colwidth="2.68in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other </ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0840/C8</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>2 seconds have elapsed after starting the engine</ptxt>
</item>
<item>
<ptxt>Oil pressure sensor circuit shorted then opened, or opened then shorted, within 0.5 seconds</ptxt>
</item>
<item>
<ptxt>Detected continuously for 0.5 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire Harness and Connector</ptxt>
<ptxt>(Oil Pressure Sensor Signal System)</ptxt>
</item>
<item>
<ptxt>Oil Pressure Sensor</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P0842/C8</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>2 seconds have elapsed after starting the engine</ptxt>
</item>
<item>
<ptxt>Short in oil pressure sensor circuit</ptxt>
</item>
<item>
<ptxt>Detected continuously for 0.5 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire Harness and Connector</ptxt>
<ptxt>(Oil Pressure Sensor Signal System)</ptxt>
</item>
<item>
<ptxt>Oil Pressure Sensor</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P0843/C8</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>2 seconds have elapsed after starting the engine</ptxt>
</item>
<item>
<ptxt>Open in oil pressure sensor circuit</ptxt>
</item>
<item>
<ptxt>Detected continuously for 0.5 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire Harness and Connector</ptxt>
<ptxt>(Oil Pressure Sensor Signal System)</ptxt>
</item>
<item>
<ptxt>Oil Pressure Sensor</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
