</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000013JZ00JX_04_0006" fin="false">OK</down>
<right ref="RM0000013JZ00JX_04_0004" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM0000013JZ00JX_04_0006" proc-id="RM0550J___0000BL700000">
<testtitle>Replace Oil Pressure Sensor</testtitle>
<content6 releasenbr="1">
<ptxt>For the replacement procedure, refer to <xref label="Seep01" href="RM0000020TV009X"/></ptxt>
