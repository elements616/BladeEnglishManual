<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1000O_S0019" variety="S0019">
<name>Parking Brake</name>
<ttl id="1000O_S0019_745H1_T00B4" variety="T00B4">
<name>Parking Brake Cable Assembly NO.1</name>
<para id="RM0000006NK00OX" category="A" type-id="80001" name-id="460Q2-01" from="200912">
<name>Removal</name>
<subpara id="RM0000006NK00OX_02" type-id="01" category="01">
<s-1 id="RM0000006NK00OX_02_0137" proc-id="RM0550J___0000IT000000">
<ptxt>Remove Parking Brake Control Pedal Assembly</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>For the procedure up to removal of the parking brake control pedal assembly, refer to <xref label="Seep01" href="RM000000WAW00SX"/>.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000006NK00OX_02_0135" proc-id="RM0550J___000065200001">
<ptxt>Remove Parking Brake Cable Assembly NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove wire adjusting nut No.1 from parking brake cable assembly No.1.</ptxt>
<figure>
<graphic graphicname="C222595" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Raise the claw of the parking brake control pedal assembly.</ptxt>
<figure>
<graphic graphicname="C222596" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the clip from parking brake cable assembly No.1.</ptxt>
<figure>
<graphic graphicname="C222597" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove parking brake cable assembly No.1 from the parking brake control pedal assembly.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>