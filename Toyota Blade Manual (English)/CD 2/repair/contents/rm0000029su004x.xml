<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74WIJ_T00FO" variety="T00FO">
<name>EFI System (2GR-FE)</name>
<para id="RM0000029SU004X" category="C" type-id="801B0" name-id="066ON-00" from="200708">
<dtccode>U0101/A2</dtccode>
<dtcname>ECT ECU Communication Malfunction</dtcname>
<subpara id="RM0000029SU004X_01" type-id="33" category="03" proc-id="RM0550J___0000DDM00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The engine control computer sends and receives data to and from the transmission control computer via local CAN communication. The engine control computer outputs a DTC when a communication malfunction with the transmission control computer occurs.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.25in"/>
<colspec colname="COL2" colwidth="3.07in"/>
<colspec colname="COL3" colwidth="2.76in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
<item>
<ptxt>Others</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U0101/A2</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>IG ON</ptxt>
</item>
<item>
<ptxt>Communication lost between engine control computer and transmission control computer</ptxt>
</item>
<item>
<ptxt>2 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire harness or connector</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
<item>
<ptxt>CAN Communication System</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000029SU004X_02" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM0000029SU004X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000029SU004X_03_0001" proc-id="RM0550J___0000DDN00000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn the IG ON and check for DTCs following the SST (TaSCAN) screen display. (see <xref label="Seep01" href="RM0000008YS014X"/>)</ptxt>
</test1>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.79in"/>
<colspec colname="COL2" colwidth="1.34in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U0101/A2 is displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Other than U0101/A2 is displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM0000029SU004X_03_0006" fin="false">A</down>
<right ref="RM0000029SU004X_03_0009" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000029SU004X_03_0006" proc-id="RM0550J___0000DDO00000">
<testtitle>Inspect Transmission Control Computer Assembly (Power Source Voltage)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the transmission control computer assembly connector.</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the terminals.</ptxt>
<figure>
<graphic graphicname="A137445J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.00in"/>
<colspec colname="COL2" colwidth="1.08in"/>
<colspec colname="COL3" colwidth="1.05in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Name)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>18(+B) - 8(E1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1(BATT) - 8(E1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>13(IG2) - 8(E1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000029SU004X_03_0007" fin="false">OK</down>
<right ref="RM0000029SU004X_03_0010" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000029SU004X_03_0007" proc-id="RM0550J___0000DDP00000">
<testtitle>Inspect Wire Harness and Connector</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D702RX"/></ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect connector A of the engine control computer.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals. (see <xref label="Seep02" href="X39400000QV01SD"/> for Terminals of ECU)</ptxt>
<figure>
<graphic graphicname="A137453J02" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.86in"/>
<colspec colname="COL2" colwidth="0.62in"/>
<colspec colname="COL3" colwidth="0.65in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A1(CAN-) - 7(CAN-)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>A2(CAN+) - 6(CAN+)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.86in"/>
<colspec colname="COL2" colwidth="0.62in"/>
<colspec colname="COL3" colwidth="0.65in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A1 (CAN-) and 7 (CAN-) - Other terminals and body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>A2 (CAN+) and 6 (CAN+) - Other terminals and body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000029SU004X_03_0012" fin="false">OK</down>
<right ref="RM0000029SU004X_03_0011" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000029SU004X_03_0012" proc-id="RM0550J___0000DDQ00000">
<testtitle>Replace Engine Control Computer</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the engine control computer and complete each registration procedure. (see <xref label="Seep01" href="RM000002ADB004X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM0000029SU004X_03_0013" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000029SU004X_03_0013" proc-id="RM0550J___0000DDR00000">
<scantool type="1"/>
<testtitle>Check DTC Output</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check for DTCs.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>DTC normal</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>U0101/A2 is output again</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000029SU004X_03_0014" fin="true">A</down>
<right ref="RM0000029SU004X_03_0008" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000029SU004X_03_0014">
<testtitle>Complete</testtitle>
</testgrp>
<testgrp id="RM0000029SU004X_03_0008">
<testtitle>Replace Transmission Control Computer Assembly<xref label="Seep01" href="RM0000024M8003X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000029SU004X_03_0009">
<testtitle>Go to Related DTC Chart<xref label="Seep01" href="RM000001KT7004X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000029SU004X_03_0010">
<testtitle>Inspect Power Supply Circuit</testtitle>
</testgrp>
<testgrp id="RM0000029SU004X_03_0011">
<testtitle>Repair or Replace Wire Harness and Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>