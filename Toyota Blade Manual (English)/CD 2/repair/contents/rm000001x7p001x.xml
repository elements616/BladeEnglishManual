<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7420D_T000V" variety="T000V">
<name>Fog Light Assembly LH</name>
<para id="RM000001X7P001X" category="A" type-id="30014" name-id="603J2-00" from="200612">
<name>Installation</name>
<subpara id="RM000001X7P001X_01" type-id="01" category="01">
<s-1 id="RM000001X7P001X_01_0001" proc-id="RM0550J___00000ME00000">
<ptxt>Install Fog Light Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the fog light assembly LH with the screw.</ptxt>
<figure>
<graphic graphicname="E146999" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X7P001X_01_0024" proc-id="RM0550J___00008EL00000">
<ptxt>Install Front Bumper Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 8 claws (4 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167063" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the front bumper assembly with the 5 clips, 2 bolts and 6 screws.</ptxt>
<figure>
<graphic graphicname="B167062" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the pin hold clip.</ptxt>
<figure>
<graphic graphicname="B167473" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Install the RH side using the same procedure.</ptxt>
</atten4>
</s2>
</content1></s-1>
<s-1 id="RM000001X7P001X_01_0025" proc-id="RM0550J___00008EM00000">
<ptxt>Install Radiator Grille Protector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the 2 radiator grille protectors.</ptxt>
<figure>
<graphic graphicname="B167060" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001X7P001X_01_0027" proc-id="RM0550J___000031W00000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 8 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001X7P001X_01_0005" proc-id="RM0550J___00000MB00000">
<ptxt>Preparation for Fog Light Aim Adjustment
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Adjust the tire pressure to the specified value. (see <xref label="Seep01" href="RM000000VNQ00LX"/>)</ptxt>
</s2>
<s2>
<ptxt>Start the engine and keep the battery in a charging condition.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001X7P001X_01_0006" proc-id="RM0550J___00000MC00000">
<ptxt>Fog Light Aim Adjustment
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Turn the aiming screw from under the vehicle to adjust.</ptxt>
<figure>
<graphic graphicname="E147000J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten4>
<ptxt>Turning the screwdriver in the tightening direction moves the fog light aim up, and turning it in the loosening direction moves it down.</ptxt>
</atten4>
</s2>
</content1></s-1>
<s-1 id="RM000001X7P001X_01_0007" proc-id="RM0550J___00000MD00000">
<ptxt>Fog Light Aim Inspection
</ptxt>
<content1 releasenbr="1">
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Illuminates within 40m</ptxt>
</specitem>
</spec>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>