<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000B_S000N" variety="S000N">
<name>Exhaust</name>
<ttl id="1000B_S000N_744TO_T008B" variety="T008B">
<name>Exhaust Manifold (2AZ-FE)</name>
<para id="RM00000305W000X" category="A" type-id="80001" name-id="111FF-00" from="200612">
<name>Removal</name>
<subpara id="RM00000305W000X_01" type-id="01" category="01">
<s-1 id="RM00000305W000X_01_0001">
<ptxt>Remove Front Tire RH</ptxt>
</s-1>
<s-1 id="RM00000305W000X_01_0014" proc-id="RM0550J___0000BJ100000">
<ptxt>Remove Engine Under Cover Rear RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 5 clips and remove the RH rear engine cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W000X_01_0015" proc-id="RM0550J___0000AJ700000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove the engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W000X_01_0016" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W000X_01_0017" proc-id="RM0550J___000032E00000">
<ptxt>Remove Fan &amp; Alternator V Belt
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, slowly turn the V-belt tensioner clockwise.</ptxt>
<figure>
<graphic graphicname="A164227J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<sst>
<sstitem>
<s-number>09961-01270</s-number>
</sstitem>
</sst>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Check that the SST and tools are securely set.</ptxt>
</item>
<item>
<ptxt>When compressing the V-belt tensioner, slowly apply force perpendicular to the tool, taking 3 seconds or more.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Remove the V-belt from each pulley and slowly return the tensioner.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000305W000X_01_0018" proc-id="RM0550J___000032F00000">
<ptxt>Remove Alternator Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="A137075" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the terminal cap.</ptxt>
</s2>
<s2>
<ptxt>Remove the nut and disconnect the harness from the +B terminal.</ptxt>
</s2>
<s2>
<ptxt>Remove the bolt and disconnect the clamp bracket.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the harness clamp.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 bolts and the Alternator assembly.</ptxt>
<figure>
<graphic graphicname="A137076" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000305W000X_01_0006" proc-id="RM0550J___000070N00000">
<ptxt>Remove Exhaust Pipe Assembly Front</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the oxygen sensor connector.</ptxt>
<figure>
<graphic graphicname="A166429J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and disconnect the exhaust center pipe assembly.</ptxt>
<figure>
<graphic graphicname="A159959J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and 2 compression springs, and remove the exhaust pipe assembly FR.</ptxt>
<figure>
<graphic graphicname="A135090" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 gaskets.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W000X_01_0007" proc-id="RM0550J___000070O00000">
<ptxt>Remove Oil Level Gauge Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the oil level gauge.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W000X_01_0008" proc-id="RM0550J___000070P00000">
<ptxt>Remove Oil Level Gauge Guide</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and remove the oil level gauge guide.</ptxt>
<figure>
<graphic graphicname="A161764" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the O-ring from the oil level gauge guide.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W000X_01_0011" proc-id="RM0550J___000070S00000">
<ptxt>Remove Exhaust Manifold Heat Insulator NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and remove the exhaust manifold heat insulator No.1.</ptxt>
<figure>
<graphic graphicname="A112189" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W000X_01_0019" proc-id="RM0550J___0000BY200000">
<ptxt>Remove Air Fuel Ratio Sensor
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the air fuel ratio sensor connector.</ptxt>
<figure>
<graphic graphicname="A098744" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST, disconnect the air fuel ratio sensor from the exhaust manifold.</ptxt>
<figure>
<graphic graphicname="A135149J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
</content1></s-1>
<s-1 id="RM00000305W000X_01_0009" proc-id="RM0550J___000070Q00000">
<ptxt>Remove Manifold Stay</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and nut and remove the manifold stay.</ptxt>
<figure>
<graphic graphicname="A112193" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W000X_01_0010" proc-id="RM0550J___000070R00000">
<ptxt>Remove Manifold Stay NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and nut and remove manifold stay No.2.</ptxt>
<figure>
<graphic graphicname="A112192" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000305W000X_01_0012" proc-id="RM0550J___000070T00000">
<ptxt>Remove Exhaust Manifold Converter Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 5 nuts and remove the exhaust manifold converter.</ptxt>
<figure>
<graphic graphicname="A112190" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the exhaust manifold to head gasket from the cylinder head.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>