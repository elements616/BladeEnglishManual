<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_744E7_T004T" variety="T004T">
<name>EFI System (2AZ-FE)</name>
<para id="X39400000RT017J" category="J" type-id="300OF" name-id="065AN-00" from="200612">
<dtccode/>
<dtcname>ECU Backup Power Source Circuit</dtcname>
<subpara id="X39400000RT017J_10" type-id="31" category="03" proc-id="RM0550J___00002RP00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>Battery power is supplied to the BATT terminal of the engine control computer even when the IG is turned OFF. This is used for storing DTCs and data when a malfunction occurs.</ptxt>
</item>
</list1>
</content5>
</subpara>
<subpara id="X39400000RT017J_11" type-id="32" category="03" proc-id="RM0550J___00002RQ00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="A136704J03" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="X39400000RT017J_12" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="X39400000RT017J_13" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X39400000RT017J_13_0002" proc-id="RM0550J___00002RR00000">
<testtitle>Inspect Fuse (EFI MAIN)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Remove the EFI MAIN fuse from the engine room R/B.</ptxt>
<figure>
<graphic graphicname="A154429J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>EFI MAIN fuse</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000RT017J_13_0003" fin="false">OK</down>
<right ref="X39400000RT017J_13_0006" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X39400000RT017J_13_0003" proc-id="RM0550J___00002RS00000">
<testtitle>Inspect Wire Harness or Connector (Engine Control Computer - Engine Room R/B LH)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep02" href="RM0000005D701ZX"/></ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the battery negative terminal.</ptxt>
<figure>
<graphic graphicname="A154428J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Disconnect connector B of the engine control computer.</ptxt>
</test1>
<test1>
<ptxt>Remove the EFI MAIN fuse from the engine room R/B.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the engine control computer vehicle side connector and the EFI MAIN fuse holder. (see <xref href="X39400000QV016D" label="Seep01"/> for Terminals of ECU)</ptxt>
<atten3>
<ptxt>When measuring by applying a tester probe, etc., be careful not to press too hard, as this may damage the holder.</ptxt>
</atten3>
<spec>
<title>Resistance</title>
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="3" colsep="1" rowsep="1">
<colspec colnum="1" colname="C01" colwidth="1.52in"/>
<colspec colnum="2" colname="COLSPEC0" colwidth="1.31in"/>
<colspec colnum="3" colname="C02" colwidth="1.3in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>Tester Connection (Terminal Name)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B20(BATT) - 2</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>B20 (BATT) and 2 - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000RT017J_13_0004" fin="true">OK</down>
<right ref="X39400000RT017J_13_0007" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X39400000RT017J_13_0004">
<testtitle>Inspect ECU Power Source System</testtitle>
</testgrp>
<testgrp id="X39400000RT017J_13_0006">
<testtitle>Replace EFI Fuse</testtitle>
</testgrp>
<testgrp id="X39400000RT017J_13_0007">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>