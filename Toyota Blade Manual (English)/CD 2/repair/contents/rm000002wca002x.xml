<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1000Z_S001D" variety="S001D">
<name>Seat Belt</name>
<ttl id="1000Z_S001D_746PU_T00CT" variety="T00CT">
<name>Cross Anchor Bracket</name>
<para id="RM000002WCA002X" category="A" type-id="30014" name-id="5610G-00" from="200612">
<name>Installation</name>
<subpara id="RM000002WCA002X_01" type-id="01" category="01">
<s-1 id="RM000002WCA002X_01_0001" proc-id="RM0550J___0000AIB00000">
<ptxt>Install Cross Anchor Bracket</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the cross anchor bracket with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="B167515" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>31</t-value1>
<t-value2>316</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000002WCA002X_01_0026" proc-id="RM0550J___0000BKK00000">
<ptxt>Install Rear Seat Outer Belt Assembly Center
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the rear seat outer belt assembly center, rear seat inner belt assembly and washer with the bolt.</ptxt>
<torque>
<torqueitem>
<t-value1>41</t-value1>
<t-value2>420</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B160921J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Pay attention to the installation direction of the floor anchor.</ptxt>
</item>
<item>
<ptxt>Be careful that the floor anchor does not ride up onto the locator.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000002WCA002X_01_0027" proc-id="RM0550J___000083300000">
<ptxt>Install Rear Seat Assembly RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Set the rear seat assembly RH in the vehicle, and install the 2 rear side bolts in the order inner → outer.</ptxt>
<torque>
<torqueitem>
<t-value1>42</t-value1>
<t-value2>428</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155443" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Raise the seatback, and install the 2 front side bolts of the rear seat assembly RH in the order inner → outer.</ptxt>
<torque>
<torqueitem>
<t-value1>42</t-value1>
<t-value2>428</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155442" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002WCA002X_01_0028" proc-id="RM0550J___000083400000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the rear seat cushion hinge cover NO.2.</ptxt>
<figure>
<graphic graphicname="B162910" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002WCA002X_01_0029" proc-id="RM0550J___000083500000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the rear seat cushion hinge cover NO.1.</ptxt>
<figure>
<graphic graphicname="B161942" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002WCA002X_01_0030">
<ptxt>Install Rear Seat Headrest Assembly Center</ptxt>
</s-1>
<s-1 id="RM000002WCA002X_01_0031">
<ptxt>Install Rear Seat Headrest Assembly</ptxt>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>