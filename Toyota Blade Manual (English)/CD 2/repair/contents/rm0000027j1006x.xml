<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_744EY_T005K" variety="T005K">
<name>Engine Mounting Insulator Rear (2AZ-FE)</name>
<para id="RM0000027J1006X" category="A" type-id="80001" name-id="071TC-00" from="200612">
<name>Removal</name>
<subpara id="RM0000027J1006X_01" type-id="01" category="01">
<s-1 id="RM0000027J1006X_01_0005" proc-id="RM0550J___0000AJ700000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove the engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000027J1006X_01_0006" proc-id="RM0550J___0000AJ900000">
<ptxt>Remove Engine Under Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 5 clips and engine under cover No.2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000027J1006X_01_0004" proc-id="RM0550J___0000BBI00000">
<ptxt>Disconnect Transmission Control Cable Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and disconnect the transmission control cable support from the engine mounting insulator RR.</ptxt>
<figure>
<graphic graphicname="C155726J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000027J1006X_01_0003" proc-id="RM0550J___000035T00000">
<ptxt>Remove Engine Mounting Insulator Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Support the oil pan with a transmission jack using a wooden block or similar.</ptxt>
<figure>
<graphic graphicname="A162930J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and disconnect the engine mounting insulator RR from the engine mounting bracket RR.</ptxt>
<figure>
<graphic graphicname="A136361" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and 2 nuts, and remove the engine mounting insulator RR.</ptxt>
<figure>
<graphic graphicname="A124842" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>