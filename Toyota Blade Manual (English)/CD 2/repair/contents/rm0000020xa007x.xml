<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10024_S000T" variety="S000T">
<name>Starting</name>
<ttl id="10024_S000T_744HR_T0083" variety="T0083">
<name>Starter Assembly (2AZ-FE)</name>
<para id="RM0000020XA007X" category="A" type-id="30014" name-id="161WJ-00" from="200612">
<name>Installation</name>
<subpara id="RM0000020XA007X_01" type-id="01" category="01">
<s-1 id="RM0000020XA007X_01_0001" proc-id="RM0550J___00004CL00000">
<ptxt>Install Starter Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the starter assembly with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A130464" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>37</t-value1>
<t-value2>380</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect terminal B with the nut.</ptxt>
<figure>
<graphic graphicname="A130463" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>9.8</t-value1>
<t-value2>100</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the terminal cap cover.</ptxt>
</s2>
<s2>
<ptxt>Connect the connector to the starter assembly.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020XA007X_01_0006" proc-id="RM0550J___000034H00000">
<ptxt>Install Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install battery carrier No.2 with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000020XA007X_01_0007" proc-id="RM0550J___00002ZX00000">
<ptxt>Install Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery carrier with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="A162914" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>19</t-value1>
<t-value2>194</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the wire harness with the 2 clamps.</ptxt>
</s2>
<s2>
<ptxt>Install the battery tray.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020XA007X_01_0008" proc-id="RM0550J___000030200000">
<ptxt>Install Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the battery to the vehicle.</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the insulator.</ptxt>
</s2>
<s2>
<ptxt>Install the battery clamp with the bolt and nut. (*1)</ptxt>
<torque>
<torqueitem>
<t-value1>17</t-value1>
<t-value2>173</t-value2>
<ptxt>(Bolt)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the battery positive terminal with the nut.</ptxt>
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020XA007X_01_0011" proc-id="RM0550J___000031W00000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 8 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020XA007X_01_0009" proc-id="RM0550J___00004CQ00000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM0000020XA007X_01_0005" proc-id="RM0550J___00004CM00000">
<ptxt>Initialization When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>For the procedure, see <xref label="Seep01" href="RM000001LYW00PX"/></ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>