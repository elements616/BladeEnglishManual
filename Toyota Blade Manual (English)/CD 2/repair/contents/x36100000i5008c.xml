<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="04">
<name>Driveline/Axle</name>
<section id="1000K_S0015" variety="S0015">
<name>Differential</name>
<ttl id="1000K_S0015_744ZW_T00A7" variety="T00A7">
<name>Active Torque Control 4WD System</name>
<para id="X36100000I5008C" category="C" type-id="300UY" name-id="370EG-00" from="200612">
<dtccode>C1299/99</dtccode>
<dtcname>4WD Control Suspended</dtcname>
<subpara id="X36100000I5008C_10" type-id="33" category="03" proc-id="RM0550J___00005IP00000">
<name>Function Description</name>
<content5 releasenbr="1">
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="3" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="1.235104     in"/>
<colspec colnum="02" colname="C02" colwidth="3.431369     in"/>
<colspec colnum="03" colname="C03" colwidth="2.480435     in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>DTC No</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry colname="C03" valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>C1299/99</ptxt>
</entry>
<entry colname="C02" valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>When the heat generated by the differential coupling exceeds the specified value</ptxt>
</item>
<item>
<ptxt>When the estimated transfer fluid temperature continuously exceeds the specified value</ptxt>
</item>
<item>
<ptxt>When the vehicle is driven with tires whose front and rear loaded radii differ by 3% or more</ptxt>
</item>
<item>
<ptxt>When differential coupling seizure is detected 4 times or more</ptxt>
</item>
</list1>
</entry>
<entry colname="C03" valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Tire Size and Inflation Pressure (Front and Rear Wheels)</ptxt>
</item>
<item>
<ptxt>Transmission Coupling Assembly</ptxt>
</item>
<item>
<ptxt>4WD Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="X36100000I5008C_11" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="X36100000I5008C_12" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X36100000I5008C_12_0001" proc-id="RM0550J___00005IQ00000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Turn the IG ON and read the DTCs following the SST (TaSCAN) screen display. (see <xref label="Seep01" href="RM000000MJ9007X"/>)</ptxt>
</test1>
<test1>
<ptxt>Check whether, in addition to DTC C1299/99, any malfunction codes of the ABS &amp; TRC &amp; VSC &amp; BA system with EBD are output.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Diagnostic Trouble Code (DTC)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Only C1299/99 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTCs of the ABS &amp; TRC &amp; VSC &amp; BA system with EBD are output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X36100000I5008C_12_0002" fin="false">A</down>
<right ref="X36100000I5008C_12_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="X36100000I5008C_12_0002" proc-id="RM0550J___00005IR00000">
<testtitle>Inspect Related Parts</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Inspect front and rear tire condition, size and tire inflation pressure.</ptxt>
</test1>
<test1>
<ptxt>Inspect suspension, ball joints, etc. for looseness.</ptxt>
</test1>
<test1>
<ptxt>Inspect drive shaft and propeller shaft rotation condition.</ptxt>
</test1>
</content6>
<res>
<down ref="X36100000I5008C_12_0007" fin="false">OK</down>
<right ref="X36100000I5008C_12_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X36100000I5008C_12_0007" proc-id="RM0550J___00005IT00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Turn the IG ON, operate following the screen display, and clear the DTCs. (see <xref label="Seep01" href="RM000000MJ9007X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="X36100000I5008C_12_0008" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="X36100000I5008C_12_0008" proc-id="RM0550J___00005IU00000">
<testtitle>Road Test</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Actually drive the vehicle.</ptxt>
</test1>
</content6>
<res>
<down ref="X36100000I5008C_12_0009" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="X36100000I5008C_12_0009" proc-id="RM0550J___00005IV00000">
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Turn the IG ON and read the Active Torque Control 4WD system DTCs following the SST (TaSCAN) screen display. (see <xref label="Seep01" href="RM000000MJ9007X"/>)</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.93in"/>
<colspec colname="COLSPEC0" colwidth="1.2in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Diagnostic Trouble Code (DTC)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>C1299/99 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>C1299/99 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X36100000I5008C_12_0003" fin="false">A</down>
<right ref="X36100000I5008C_12_0006" fin="true">B</right>
</res>
</testgrp>
<testgrp id="X36100000I5008C_12_0003" proc-id="RM0550J___00005IS00000">
<testtitle>Inspect 4WD Computer Assembly</testtitle>
<content6 releasenbr="1">
<ptxt>For the procedure, refer to <xref label="Seep01" href="RM00000068800EX"/>.</ptxt>
</content6>
<res>
<down ref="X36100000I5008C_12_0010" fin="true">OK</down>
<right ref="X36100000I5008C_12_0011" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X36100000I5008C_12_0004">
<testtitle>Go to Diagnostic Trouble Code Chart<xref label="Seep01" href="RM0000005ZT00PX"/>
</testtitle>
</testgrp>
<testgrp id="X36100000I5008C_12_0005">
<testtitle>Repair or replace applicable part</testtitle>
</testgrp>
<testgrp id="X36100000I5008C_12_0006">
<testtitle>Go to Problem Symptom Simulation Method<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
<testgrp id="X36100000I5008C_12_0010">
<testtitle>Replace Transmission Coupling Assembly</testtitle>
</testgrp>
<testgrp id="X36100000I5008C_12_0011">
<testtitle>Replace 4WD computer assembly<xref label="Seep01" href="RM000002WLE001X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>