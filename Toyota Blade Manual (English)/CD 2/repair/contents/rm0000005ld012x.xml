<testgrp id="RM0000005LD012X_08_0011" proc-id="RM0550J___0000BZ900000">
<testtitle>Inspect Wire Harness and Connector (Compressor Assembly (with Pulley) - Air Conditioner Amplifier Assembly)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D701ZX"/>.</ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
