</subpara>
<subpara id="RM0000005LD012X_07" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM0000005LD012X_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000005LD012X_08_0008" proc-id="RM0550J___0000BZ600000">
<testtitle>Read TaSCAN Data (Externally Variable Output Current Value)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST, inspect the ECU Data Monitor by following the screen instructions.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<title>[Diagnosis menu screen: Body → A/C → ECU Data Monitor]</title>
<tgroup cols="3">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
<ptxt>[Item Symbol]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Reference Value</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>External Variable Output Current Value</ptxt>
<ptxt>[OROA]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>When compressor assembly (w/ pulley) is operating</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Displayed in range 0A (minimum capacity) to 1A (maximum capacity)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<table>
<title>Result</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.89in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>ECU Data Monitor reference values are abnormal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>ECU Data Monitor reference values are normal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005LD012X_08_0009" fin="false">A</down>
<right ref="RM0000005LD012X_08_0012" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000005LD012X_08_0009" proc-id="RM0550J___0000BZ700000">
<testtitle>Inspect Compressor Assembly (with Pulley)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the compressor assembly (w/ pulley) connector.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the connector terminals.</ptxt>
<figure>
<graphic graphicname="E103261J07" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.36in"/>
<colspec colname="COLSPEC0" colwidth="1.53in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1(SOL+) - 2(SOL-)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always (compressor temperature 25°C)</ptxt>
</entry>
<entry valign="middle">
<ptxt>10.1 to 11.1Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005LD012X_08_0010" fin="false">OK</down>
<right ref="RM0000005LD012X_08_0013" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005LD012X_08_0010" proc-id="RM0550J___0000BZ800000">
