<name>Heater &amp; Air Conditioner System</name>
<para id="RM0000005LD012X" category="C" type-id="300BV" name-id="5229J-00" from="200612" to="200708">
<dtccode>B1451/51</dtccode>
<dtcname>External variable compressor solenoid malfunction</dtcname>
<subpara id="RM0000005LD012X_05" type-id="31" category="03" proc-id="RM0550J___0000BZ400000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The compressor assembly (w/ pulley) changes the refrigerant discharge volume according to signals from the air conditioner amplifier assembly. The air conditioner amplifier assembly converts the discharge capacity appropriate to changes in heat load, engine speed, etc. into a signal and controls the compressor.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Detection Condition</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B1451/51</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>When compressor assembly (w/ pulley) is operating</ptxt>
</item>
<item>
<ptxt>Open or short in compressor variable capacity control circuit</ptxt>
</item>
<item>
<ptxt>Current malfunction only</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Compressor Assembly (w/ Pulley)</ptxt>
</item>
<item>
<ptxt>Wire harness and connector (compressor assembly (w/ pulley) - air conditioner amplifier assembly)</ptxt>
</item>
<item>
<ptxt>Air Conditioner Amplifier Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000005LD012X_06" type-id="32" category="03" proc-id="RM0550J___0000BZ500000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E145610J01" width="7.106578999in" height="2.775699831in"/>
