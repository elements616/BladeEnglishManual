<ttl id="10006_S000J_74WIJ_T00FO" variety="T00FO">
<name>EFI System (2GR-FE)</name>
<para id="RM0000039YA000X" category="C" type-id="803QE" name-id="066OF-00" from="200708">
<dtccode>P1660/96</dtccode>
<dtcname>Intake Passage Control VSV (AICV)</dtcname>
<subpara id="RM0000039YA000X_01" type-id="33" category="03" proc-id="RM0550J___0000G8900000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The air intake control valve opens when the engine speed and throttle valve opening are above certain levels, increasing the intake air volume. The engine control computer controls the opening and closing of the vacuum switching valve, so the intake air volume changes according to the driving conditions.</ptxt>
<figure>
<graphic graphicname="A061332J01" width="7.106578999in" height="2.775699831in"/>
</figure>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.19in"/>
<colspec colname="COL2" colwidth="3.05in"/>
<colspec colname="COL3" colwidth="2.84in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
<item>
<ptxt>Others</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P1660/96</ptxt>
</entry>
<entry>
<list1 type="ordered">
<item>
<ptxt>Engine running</ptxt>
</item>
<item>
<ptxt>Open or short in air intake control valve circuit</ptxt>
</item>
<item>
<ptxt>0.5 seconds or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry>
<list1 type="unordered">
<item>
<ptxt>Vacuum Switching Valve</ptxt>
</item>
<item>
<ptxt>Wire Harness and Connector</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000039YA000X_02" type-id="32" category="03" proc-id="RM0550J___0000G8A00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="A177154J03" width="7.106578999in" height="5.787629434in"/>
</figure>
</content5>
</subpara>
<subpara id="RM0000039YA000X_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM0000039YA000X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000039YA000X_04_0001" proc-id="RM0550J___0000FQI00000">
<scantool type="8"/>
<testtitle>Perform TaSCAN Active Test (VSV for Intake Air Control)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>With the engine stopped, turn the IG ON.</ptxt>
</test1>
<test1>
<ptxt>Following the SST (TaSCAN) screen display, select [Active Test] - [Intake Passage Control VSV].</ptxt>
</test1>
<test1>
<ptxt>Operate the VSV (vacuum switching valve) and check whether an operating sound can be heard.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.10in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Operating sound cannot be heard</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Operating sound can be heard</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000039YA000X_04_0002" fin="false">A</down>
<right ref="RM0000039YA000X_04_0011" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000039YA000X_04_0002" proc-id="RM0550J___0000FQJ00000">
<testtitle>Inspect Vacuum Switching Valve</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Disconnect the vacuum switching valve connector.</ptxt>
<figure>
<graphic graphicname="A093008J03" width="2.775699831in" height="1.771723296in"/>
</figure>
</test1>
<test1>
<ptxt>Apply battery voltage between the terminals of the vacuum switching valve.</ptxt>
</test1>
<test1>
<ptxt>Check that a "click" sound is heard inside the air cleaner assembly.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>A "click" sound is heard inside the air cleaner assembly</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000039YA000X_04_0003" fin="false">OK</down>
<right ref="RM0000039YA000X_04_0008" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000039YA000X_04_0003" proc-id="RM0550J___0000FQK00000">
<testtitle>Inspect Wire Harness and Connector (Power Source Voltage)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D702RX"/></ptxt>
</atten4>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<figure>
<graphic graphicname="A177158J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the terminal voltage of the vacuum switching valve vehicle side connector.</ptxt>
<spec>
<title>Standard</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1 (+B) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000039YA000X_04_0007" fin="false">OK</down>
<right ref="RM0000039YA000X_04_0010" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000039YA000X_04_0007" proc-id="RM0550J___0000FQL00000">
<testtitle>Inspect Wire Harness and Connector (Vacuum Switching Valve - Engine Control Computer)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D702RX"/></ptxt>
</atten4>
<figure>
<graphic graphicname="A177157J01" width="7.106578999in" height="2.775699831in"/>
</figure>
<test1>
<ptxt>Disconnect connector B of the engine control computer.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals. (see <xref label="Seep02" href="X39400000QV01SD"/> for Terminals of ECU)</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="4.82in"/>
<colspec colname="COL2" colwidth="1.14in"/>
<colspec colname="COL3" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B4 (AICV) - 2 terminal</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="4.82in"/>
<colspec colname="COL2" colwidth="1.14in"/>
<colspec colname="COL3" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B4 (AICV) and 2 terminal - Other terminals and body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000039YA000X_04_0006" fin="true">OK</down>
<right ref="RM0000039YA000X_04_0009" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000039YA000X_04_0006">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM000002ADB004X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000039YA000X_04_0008">
<testtitle>Replace Vacuum Switching Valve</testtitle>
</testgrp>
<testgrp id="RM0000039YA000X_04_0009">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM0000039YA000X_04_0010">
<testtitle>Inspect Power Supply Circuit</testtitle>
</testgrp>
<testgrp id="RM0000039YA000X_04_0011">
<testtitle>Inspection for Intermittent Problems<xref label="Seep01" href="RM000000CD101YX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
