<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002P_S0005" variety="S0005">
<name>Meter</name>
<ttl id="1002P_S0005_741K5_T000E" variety="T000E">
<name>Meter &amp; Gauge System</name>
<para id="RM000000IU4017X" category="N" type-id="8009I" name-id="630TZ-00" from="200612" to="200708">
<name>Function Inspection</name>
<subpara id="RM000000IU4017X_01" type-id="01" category="01">
<s-1 id="RM000000IU4017X_01_0001" proc-id="RM0550J___000005Y00000">
<ptxt>LED Check</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>LED Illumination Inspection</ptxt>
<s3>
<ptxt>Check that each indicator/warning light comes on for the time below when the IG is turned OFF → ON.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt/>
</specitem>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Indicator/Warning Name</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Illumination Specification</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Brake, ABS, slip, automatic leveling, P/S (EMPS), eco drive</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Light comes on for approximately 3 seconds at IG OFF → ON</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Airbag</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Light comes on for approximately 6 seconds at IG OFF → ON</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Check engine, charge, 4WD AUTO</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Light comes on at IG OFF → ON</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<list1 type="unordered">
<item>
<ptxt>Except for the eco drive indicator, the illumination request is made by the other ECU. (For the other ECU, refer to <xref label="Seep01" href="RM0000005AC016X"/>)</ptxt>
</item>
<item>
<ptxt>Inspect the brake warning light with the parking brake released.</ptxt>
</item>
</list1>
</atten4>
</s3>
</s2>
</content1>
</s-1>
<s-1 id="RM000000IU4017X_01_0002" proc-id="RM0550J___000005Z00000">
<ptxt>Inspect Speedometer</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Operation Check</ptxt>
<s3>
<ptxt>Using a speedometer tester, inspect the speedometer for indication errors.</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt/>
</specitem>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Indicated Standard Speed [km/h]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Meter Indication Tolerance [km/h]</ptxt>
<ptxt>() indicates reference value</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>20</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>(21 to 25)</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>40</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>41.7 to 46.2</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>60</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>62.7 to 67.2</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>80</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>83.4 to 88.4</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>100</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>104.3 to 109.3</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>120</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>125.1 to 130.6</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>140</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>145.8 to 151.8</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>160</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>166.2 to 173.2</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>180</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>186.9 to 194.5</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>If the tire pressure is outside the specified value, the indication error increases.</ptxt>
</atten3>
</s3>
<s3>
<ptxt>Check the needle deflection.</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt>Within 0.3° (without vibration)</ptxt>
</specitem>
</spec>
</s3>
</s2>
</content1>
</s-1>
<s-1 id="RM000000IU4017X_01_0003" proc-id="RM0550J___000006000000">
<ptxt>Inspect Tachometer</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Operation Check</ptxt>
<s3>
<ptxt>Start the engine.</ptxt>
</s3>
<s3>
<ptxt>Using a tachometer, inspect the tachometer for indication errors.</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt/>
</specitem>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tachometer Indication [r/min]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Meter Indication Tolerance [r/min]</ptxt>
<ptxt>() indicates reference value</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>700</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>630 to 770</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>1000</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>(900 to 1100)</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>2000</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>(1850 to 2150)</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>3000</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>2800 to 3200</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>4000</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>(3800 to 4200)</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>5000</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>4800 to 5200</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>6000</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>(5750 to 6250)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>Do not run the engine above the allowable speed (above the red zone speed shown on the meter).</ptxt>
</atten3>
</s3>
</s2>
</content1>
</s-1>
<s-1 id="RM000000IU4017X_01_0006" proc-id="RM0550J___000006100000">
<ptxt>Inspect Oil Pressure Warning</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Operation Check</ptxt>
<s3>
<ptxt>Disconnect the engine oil pressure switch assembly connector.</ptxt>
</s3>
<s3>
<ptxt>Start the engine.</ptxt>
</s3>
<s3>
<ptxt>Using SST, check the display in the combination meter assembly when the engine oil pressure switch assembly vehicle side wire harness connector terminal is shorted to body ground.</ptxt>
<sst>
<sstitem>
<s-number>09843-18040</s-number>
</sstitem>
</sst>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>"Low Engine Oil Pressure" is displayed on the multi-information display.</ptxt>
</specitem>
</spec>
</s3>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
