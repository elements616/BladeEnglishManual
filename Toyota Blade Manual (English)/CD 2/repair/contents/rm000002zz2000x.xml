<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001D_S0018" variety="S0018">
<name>Power Source &amp; Wire Harness</name>
<ttl id="1001D_S0018_745GD_T00B2" variety="T00B2">
<name>Fusible Link Block Assembly (Engine Model 2AZ-FE)</name>
<para id="RM000002ZZ2000X" category="A" type-id="30014" name-id="6808K-00" from="200612">
<name>Installation</name>
<subpara id="RM000002ZZ2000X_01" type-id="01" category="01">
<s-1 id="RM000002ZZ2000X_01_0006" proc-id="RM0550J___000085700000">
<ptxt>Install Fusible Link Block Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E140932" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Connect the 3 wire harnesses to the fusible link block assembly with the 3 bolts (M5).</ptxt>
</s2>
<s2>
<ptxt>Connect the 2 connectors to the fusible link block assembly.</ptxt>
</s2>
<s2>
<ptxt> Connect the 2 wire harnesses to the fusible link block assembly with the 2 bolts (M6).</ptxt>
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="E140931" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the claw and install the fuse holder to the fusible link block assembly.</ptxt>
<figure>
<graphic graphicname="E140930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the bolt (M6).</ptxt>
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Engage the 4 claws and install the fuse holder and fusible link block assembly.</ptxt>
<figure>
<graphic graphicname="E140928" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 10 claws and assemble the upper side and lower side of the fuse block cover.</ptxt>
<figure>
<graphic graphicname="E140927" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<ptxt>Assemble securely so that the wire harness is not pinched.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZZ2000X_01_0005" proc-id="RM0550J___000085800000">
<ptxt>Install Engine Room Relay Block</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E146744J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Engage the guide and claw of the relay block.</ptxt>
</s2>
<s2>
<ptxt>Install the 3 bolts.</ptxt>
<torque>
<torqueitem>
<t-value1>8.4</t-value1>
<t-value2>86</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Clamp the harness.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZZ2000X_01_0004" proc-id="RM0550J___000085900000">
<ptxt>Install Front Fender Liner LH</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E146982" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Install the front fender liner LH with the pin hold clip and 4 clips.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZZ2000X_01_0008" proc-id="RM0550J___00009IG00000">
<ptxt>Install Engine Control Computer
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine control computer bracket with the 4 screws.</ptxt>
<figure>
<graphic graphicname="A162896" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the clamp and install the engine control computer with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="A162895" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>8.0</t-value1>
<t-value2>82</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the 2 engine control computer connectors to the engine control computer.</ptxt>
<figure>
<graphic graphicname="A157544" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>When installing the connector, be careful not to allow foreign matter such as mud or water to adhere to the connector connection.</ptxt>
</item>
<item>
<ptxt>Securely lock the lever.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2000X_01_0009" proc-id="RM0550J___000030000000">
<ptxt>Install Air Cleaner Case
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the air cleaner case with the 3 bolts and clamp.</ptxt>
<figure>
<graphic graphicname="A162913" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>7.0</t-value1>
<t-value2>71</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the air cleaner filter element.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2000X_01_0010" proc-id="RM0550J___00002ZF00000">
<ptxt>Install Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the hinge portion first, then install the air cleaner cap with the 3 clamps.</ptxt>
</s2>
<s2>
<ptxt>Install air cleaner hose No.1 to the throttle body assembly and release the lock of air cleaner hose clamp No.1.</ptxt>
<figure>
<graphic graphicname="A162892" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Align the triangular projection of air cleaner hose No.1 with the throttle body bolt on the right front side of the vehicle.</ptxt>
</item>
<item>
<ptxt>Align the position of air cleaner hose clamp No.1 using the triangular projection of air cleaner hose No.1 as a reference.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Connect the clamp and intake air flow meter connector.</ptxt>
<figure>
<graphic graphicname="A162887" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the fuel vapor feed hose and fuel vapor feed hose No.2 to vacuum switching valve assembly No.1.</ptxt>
<figure>
<graphic graphicname="A163392" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the clamp and vacuum switching valve connector.  </ptxt>
</s2>
<s2>
<ptxt>Connect the ventilation hose.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2000X_01_0011" proc-id="RM0550J___00004E000000">
<ptxt>Install Engine Cover Sub-assembly NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine cover assembly No.1 with the 2 nuts.</ptxt>
<figure>
<graphic graphicname="A159817" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>9.0</t-value1>
<t-value2>92</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000002ZZ2000X_01_0003" proc-id="RM0550J___000085A00000">
<ptxt>Connect Wire Harness</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E147101" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Connect the wire harness with the 2 nuts, 2 connectors and 2 clamps.</ptxt>
<torque>
<torqueitem>
<t-value1>8.4</t-value1>
<t-value2>86</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000002ZZ2000X_01_0002">
<ptxt>Install Relay Block Cover Upper NO.1</ptxt>
</s-1>
<s-1 id="RM000002ZZ2000X_01_0001" proc-id="RM0550J___0000C7700000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM000002ZZ2000X_01_0012" proc-id="RM0550J___0000BD900000">
<ptxt>Settings Required when Replacing or Removing/Installing Parts</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYX00OX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000002ZZ2000X_01_0007" proc-id="RM0550J___000085B00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
