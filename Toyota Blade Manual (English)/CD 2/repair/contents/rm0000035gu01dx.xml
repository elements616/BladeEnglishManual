<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM0000035GU01DX" category="C" type-id="803M9" name-id="653FR-01" from="200912">
<dtccode>B15C0</dtccode>
<dtcname>GPS antenna connection malfunction (short)</dtcname>
<dtccode>B15C1</dtccode>
<dtcname>GPS antenna connection malfunction (open)</dtcname>
<subpara id="RM0000035GU01DX_01" type-id="33" category="03" proc-id="RM0550J___0000IHU00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the navigation receiver assembly detects an antenna short (open) condition from the GPS antenna (navigation antenna assembly).</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.61in"/>
<colspec colname="COL2" colwidth="2.68in"/>
<colspec colname="COL3" colwidth="2.79in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC.No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Point</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B15C0</ptxt>
</entry>
<entry valign="middle">
<ptxt>GPS antenna connection malfunction (short)</ptxt>
</entry>
<entry morerows="1" valign="middle">
<list1 type="unordered">
<item>
<ptxt>Navigation Antenna Assembly</ptxt>
</item>
<item>
<ptxt>Vehicle wire harness or connector</ptxt>
</item>
<item>
<ptxt>Navigation Receiver Assembly</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>B15C1</ptxt>
</entry>
<entry valign="middle">
<ptxt>GPS antenna connection malfunction (open)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000035GU01DX_02" type-id="51" category="05" proc-id="RM0550J___0000IHV00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM0000002RM03SX"/>)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000035GU01DX_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000035GU01DX_03_0006" proc-id="RM0550J___0000IHY00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM0000035GU01DX_03_0001" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000035GU01DX_03_0001" proc-id="RM0550J___0000IHW00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.71in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>No code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000035GU01DX_03_0007" fin="false">A</down>
<right ref="RM0000035GU01DX_03_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035GU01DX_03_0007" proc-id="RM0550J___0000IHZ00000">
<testtitle>Inspect Navigation Antenna Assembly</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Inspect Installation Condition</ptxt>
<test2>
<ptxt>Check the navigation antenna assembly cord for installation problems such as sharp bends, pinching and incompletely engaged connectors.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Installation normal</ptxt>
</specitem>
</spec>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<figure>
<graphic graphicname="E170077J07" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Disconnect the navigation antenna assembly connector shown in the illustration.</ptxt>
</test2>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between terminals 7 - 10 of the connector.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.74in"/>
<colspec colname="COL2" colwidth="1.02in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>7 - 10</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>50 to 500 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry valign="middle">
<ptxt>Connector Disconnected</ptxt>
<ptxt>(Navigation Antenna Assembly)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM0000035GU01DX_03_0002" fin="false">OK</down>
<right ref="RM0000035GU01DX_03_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000035GU01DX_03_0002" proc-id="RM0550J___0000IHX00000">
<testtitle>Inspect Wire Harness or Connector</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<atten4>
<ptxt>The wire harness between the navigation receiver assembly and navigation antenna assembly is built into the vehicle wire harness.</ptxt>
</atten4>
<test1>
<ptxt>Inspect Installation Condition</ptxt>
<test2>
<ptxt>Check the wire harness between the navigation receiver assembly and navigation antenna assembly for installation problems such as sharp bends, pinching and incompletely engaged connectors.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Installation normal</ptxt>
</specitem>
</spec>
</test2>
</test1>
<test1>
<ptxt>Pre-inspection Preparation</ptxt>
<test2>
<ptxt>Disconnect the connector shown in the illustration that is connected to the navigation antenna assembly.</ptxt>
<figure>
<graphic graphicname="E170109J05" width="2.775699831in" height="2.775699831in"/>
</figure>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry>
<ptxt>Front view of wire harness connector</ptxt>
<ptxt>(to Navigation Antenna Assembly)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test2>
<test2>
<ptxt>Disconnect the connector shown in the illustration that is connected to the navigation receiver assembly.</ptxt>
<figure>
<graphic graphicname="E167629J33" width="2.775699831in" height="2.775699831in"/>
</figure>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry>
<ptxt>Front view of wire harness connector</ptxt>
<ptxt>(to Navigation Receiver Assembly)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance of the vehicle wire harness between the navigation receiver assembly and navigation antenna assembly.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>7 - 1</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the vehicle wire harness connector terminal and body ground.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>7 - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000035GU01DX_03_0003" fin="true">OK</down>
<right ref="RM0000035GU01DX_03_0010" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000035GU01DX_03_0003">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035GU01DX_03_0004">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY07EX"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035GU01DX_03_0005">
<testtitle>Replace Navigation Antenna Assembly<xref label="Seep01" href="RM000001XG8006X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035GU01DX_03_0010">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>