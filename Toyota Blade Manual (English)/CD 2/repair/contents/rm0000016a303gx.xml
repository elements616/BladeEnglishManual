<testgrp id="RM0000016A303GX_03_0077" proc-id="RM0550J___0000IPH00000">
<testtitle>Microphone Check (Microphone Input Level)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Microphone Check (Microphone Input Level)</ptxt>
<figure>
<graphic graphicname="E122550J08" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Select "Function Check/Adjustment" on the Service Check Menu screen to display the function check/adjustment screen.</ptxt>
</test2>
<test2>
<ptxt>Select "Microphone &amp; Voice Recognition Check" on the function check/adjustment screen to display the microphone voice recognition check screen.</ptxt>
</test2>
<test2>
<ptxt>Speak into the microphone and inspect the display of the microphone input level gauge.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Microphone input level gauge moves</ptxt>
</specitem>
</spec>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
