<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000U_S0017" variety="S0017">
<name>Steering Column</name>
<ttl id="1000U_S0017_745FS_T00B0" variety="T00B0">
<name>Steering Column Assembly</name>
<para id="RM000000UD100WX" category="A" type-id="8000E" name-id="480YU-00" from="200612" to="200912">
<name>Reassembly</name>
<subpara id="RM000000UD100WX_01" type-id="01" category="01">
<s-1 id="RM000000UD100WX_01_0009" proc-id="RM0550J___0000APF00000">
<ptxt>Install Steering Lock Actuator Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Secure the steering column assembly in a vise with aluminum plates.</ptxt>
<atten3>
<ptxt>Do not overtighten the vise.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the steering lock actuator with a new steering lock set bolt, and tighten the bolt until the bolt head breaks off.</ptxt>
<figure>
<graphic graphicname="C149896" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000UD100WX_01_0021" proc-id="RM0550J___0000APL00000">
<ptxt>Install Steering Intermediate Shaft Assembly NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Align the matchmarks and connect steering intermediate shaft assembly No.2 to the steering column assembly.</ptxt>
<figure>
<graphic graphicname="C149893J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the bolt.</ptxt>
<figure>
<graphic graphicname="C149892" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>35</t-value1>
<t-value2>360</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>