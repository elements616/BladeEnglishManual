<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1002J_S000U" variety="S000U">
<name>Brake Control</name>
<ttl id="1002J_S000U_744TG_T0089" variety="T0089">
<name>ABS with EBD &amp; TRC &amp; VSC &amp; BA System</name>
<para id="RM00000060Q00MX" category="C" type-id="300AB" name-id="442OQ-00" from="200612">
<dtccode>C1251/51</dtccode>
<dtcname>Motor System Malfunction</dtcname>
<subpara id="RM00000060Q00MX_05" type-id="33" category="03" proc-id="RM0550J___00007R700000">
<name>Function Description</name>
<content5 releasenbr="1">
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.42in"/>
<colspec colname="COL2" colwidth="2.77in"/>
<colspec colname="COL3" colwidth="2.89in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Output Related Items</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1251/51</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Actuator pump drive motor does not rotate normally</ptxt>
</item>
<item>
<ptxt>Open in actuator pump drive motor continues for 2 seconds or more</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Actuator assembly GND malfunction</ptxt>
</item>
<item>
<ptxt>Open in motor circuit in actuator assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000060Q00MX_06" type-id="32" category="03" proc-id="RM0550J___00007R800000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C146383J01" width="7.106578999in" height="5.787629434in"/>
</figure>
</content5>
</subpara>
<subpara id="RM00000060Q00MX_07" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM00000060Q00MX_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000060Q00MX_08_0007" proc-id="RM0550J___00007R900000">
<testtitle>Inspect Wire Harness and Connector (Actuator Assembly - Body Ground)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check that the brake actuator assembly connector is properly engaged.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>No malfunction</ptxt>
</specitem>
</spec>
</test1>
<test1>
<ptxt>Turn the IG OFF and disconnect the brake actuator assembly connector.</ptxt>
</test1>
<test1>
<ptxt>Check that the connector case and terminals are free of deformation and corrosion.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>No deformation or corrosion</ptxt>
</specitem>
</spec>
</test1>
<test1>
<ptxt>Using the SST (Toyota electrical tester), inspect the resistance between the wire harness side connector of the brake actuator assembly and body ground.</ptxt>
<figure>
<graphic graphicname="C146352J13" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.14in"/>
<colspec colname="COL2" colwidth="0.98in"/>
<colspec colname="COL3" colwidth="1.00in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1 (GND1) - Body ground</ptxt>
</entry>
<entry morerows="1" valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry morerows="1" valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>13 (GND2) - Body ground</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060Q00MX_08_0008" fin="false">OK</down>
<right ref="RM00000060Q00MX_08_0011" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060Q00MX_08_0008" proc-id="RM0550J___00007RA00000">
<scantool type="8"/>
<testtitle>Perform Active Test (ABS Motor Relay)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using the SST (TaSCAN), drive the ABS motor relay following the screen and check that the ABS motor operates normally (motor operating sound is heard). (see <xref label="Seep01" href="RM000000602011X"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Operates normally</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060Q00MX_08_0009" fin="false">OK</down>
<right ref="RM00000060Q00MX_08_0012" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060Q00MX_08_0009" proc-id="RM0550J___00007RB00000">
<scantool type="1"/>
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Clear the DTCs and check the DTCs again. (see <xref label="Seep01" href="RM00000060000PX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL2" colwidth="2.69in"/>
<colspec colname="COLSPEC0" colwidth="1.44in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>OK</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Motor system malfunction code is output again</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060Q00MX_08_0010" fin="true">A</down>
<right ref="RM00000060Q00MX_08_0012" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000060Q00MX_08_0010">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
<testgrp id="RM00000060Q00MX_08_0011">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM00000060Q00MX_08_0012">
<testtitle>Replace ABS &amp; Traction Actuator Assembly<xref label="Seep01" href="RM00000304V000X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
