<subpara id="RM0000026XZ007X_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM0000026XZ007X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000026XZ007X_04_0001" proc-id="RM0550J___0000D8A00000">
<scantool type="8"/>
<testtitle>Perform TaSCAN Active Test (Purge VSV)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>With the engine stopped, turn the IG ON.</ptxt>
</test1>
<test1>
<ptxt>Following the SST (TaSCAN) screen display, select [Active Test] - [Purge VSV].</ptxt>
</test1>
<test1>
<ptxt>Operate vacuum switching valve assembly NO.1 and check whether air passes through.</ptxt>
<figure>
<graphic graphicname="A127787J03" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.10in"/>
<colspec colname="COL2" colwidth="3.03in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>VSV</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Specified Condition</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>ON</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Air passes from port E to port F</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>OFF</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Air does not pass from port E to port F</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>NG</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>OK</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000026XZ007X_04_0002" fin="false">A</down>
<right ref="RM0000026XZ007X_04_0005" fin="true">B</right>
</res>
</testgrp>
