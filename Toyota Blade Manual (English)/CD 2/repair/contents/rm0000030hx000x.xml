<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001H_S0001" variety="S0001">
<name>Seat</name>
<ttl id="1001H_S0001_74605_T00BN" variety="T00BN">
<name>Rear Seat Assembly LH</name>
<para id="RM0000030HX000X" category="A" type-id="8000E" name-id="791BX-00" from="200612">
<name>Reassembly</name>
<subpara id="RM0000030HX000X_01" type-id="01" category="01">
<s-1 id="RM0000030HX000X_01_0001" proc-id="RM0550J___000084600000">
<ptxt>Install Separate Type Rear Seat Cushion Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using hog ring pliers, install the separate type rear seat cushion cover LH with 6 new hog rings.</ptxt>
<figure>
<graphic graphicname="B155485J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Install the separate type rear cushion cover w/ pad with the 13 J hooks.</ptxt>
<figure>
<graphic graphicname="B155477" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0002" proc-id="RM0550J___000084700000">
<ptxt>Install Rear Seatback Lock Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the rear seatback lock assembly LH with the 4 bolts.</ptxt>
<torque>
<torqueitem>
<t-value1>18</t-value1>
<t-value2>184</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155476" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0003" proc-id="RM0550J___000084800000">
<ptxt>Install Separate Type Rear Seatback Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using hog ring pliers, install the separate type rear seatback cover LH with 10 new hog rings.</ptxt>
<figure>
<graphic graphicname="B155484J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0004" proc-id="RM0550J___000084900000">
<ptxt>Install Rear Seat Headrest Support</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Temporarily install the separate type rear seatback cover w/ pad to the rear seatback frame sub-assembly LH.</ptxt>
</s2>
<s2>
<ptxt>Engage the 4 claws and install the 2 rear seat headrest supports.</ptxt>
<figure>
<graphic graphicname="B162923" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0005" proc-id="RM0550J___000084A00000">
<ptxt>Install Rear Seatback Board Carpet Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Temporarily install the rear seatback board carpet assembly LH to the rear seatback frame sub-assembly LH.</ptxt>
</s2>
<s2>
<ptxt>Install the rear seatback board carpet assembly LH with the 3 J hooks.</ptxt>
<figure>
<graphic graphicname="B155480" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the 2 clips.</ptxt>
<figure>
<graphic graphicname="B155469" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the 2 clips.</ptxt>
<figure>
<graphic graphicname="B155468" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0006" proc-id="RM0550J___000084B00000">
<ptxt>Install Rear Seatback Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the rear seatback cover.</ptxt>
<figure>
<graphic graphicname="B155467" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0007" proc-id="RM0550J___000084C00000">
<ptxt>Install Rear Seatback Lock Cover LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the rear seatback lock cover LH with the 2 screws.</ptxt>
<figure>
<graphic graphicname="B155466" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0008" proc-id="RM0550J___000084D00000">
<ptxt>Install Rear Seat Lock Base</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 claws and install the rear seat lock base.</ptxt>
<figure>
<graphic graphicname="B155506" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0009" proc-id="RM0550J___000084E00000">
<ptxt>Install Rear Seat Lock Control Lever NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide rear seatback lock control lever NO.1 as shown in the illustration to install it.</ptxt>
<figure>
<graphic graphicname="B158202" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0010" proc-id="RM0550J___000084F00000">
<ptxt>Install Rear Seatback Lock Control Lever w/ Base</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 claws and temporarily install the rear seatback lock control lever w/ base.</ptxt>
<figure>
<graphic graphicname="B155504" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the rear seatback lock control lever w/ base with the 2 screws.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HX000X_01_0011" proc-id="RM0550J___000084G00000">
<ptxt>Install Rear Seatback Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a Torx socket wrench T45, install the rear seatback assembly LH with the 2 Torx bolts.</ptxt>
<torque>
<torqueitem>
<t-value1>18</t-value1>
<t-value2>184</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155464" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>