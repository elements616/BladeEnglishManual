<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000000AVC01HX" category="D" type-id="3001B" name-id="261HQ-00" from="200708">
<name>How to Proceed with Troubleshooting</name>
<subpara id="RM000000AVC01HX_z0" proc-id="RM0550J___0000FQM00000">
<content5 releasenbr="1">
<descript-diag>
<descript-testgroup>
<testtitle>Vehicle brought to workshop</testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Customer Problem Analysis and Symptom Check (see <xref label="Seep01" href="RM000000AVD014X"/>)</testtitle>
<test1>
<ptxt>Perform customer problem analysis and symptom check.</ptxt>
</test1>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>CAN communication system communication function inspection (see <xref label="Seep02" href="RM0000005S001VX"/>) </testtitle>
<test1>
<ptxt>Using SST (TaSCAN), display the [CAN Bus Diagnosis/CAN Bus Connected ECU Check] screen (see <xref label="Seep12" href="RM0000005S001VX"/>) and check that all ECUs and sensors connected to CAN communication are displayed on the screen.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.14in"/>
<colspec colname="COL2" colwidth="0.99in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Code (ECU not connected, communication line malfunction) not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Code (ECU not connected, communication line malfunction) output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<results>
<result>B</result>
<action-ci-right>Go to CAN Communication Section <xref label="Seep03" href="RM000001R4W00DX"/></action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Check DTC (see <xref label="Seep08" href="RM000000AW201LX"/>)</testtitle>
<test1>
<ptxt>Check DTCs and Freeze Frame Data</ptxt>
<test2>
<ptxt>Record the DTCs and freeze frame data.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Clear DTCs and Freeze Frame Data</ptxt>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Based on the recorded DTCs and Freeze Frame Data, reproduce the problem symptom and check whether the DTC is output again.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.14in"/>
<colspec colname="COL2" colwidth="0.99in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>No code, symptom can be confirmed and reproduced</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>No code, symptom cannot be confirmed and reproduced</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<results>
<result>B</result>
<action-ci-right>Go to Problem Simulation <xref label="Seep07" href="RM000000ABY04BX"/> </action-ci-right>
<result>C</result>
<action-ci-right>Go to DTC Chart <xref label="Seep04" href="RM000000DAO01DX"/></action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Problem Symptoms Table (see <xref label="Seep05" href="RM000000DAV012X"/>)</testtitle>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.14in"/>
<colspec colname="COL2" colwidth="0.99in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Not listed in List by Symptom</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Corresponds to List by Symptom</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<results>
<result>B</result>
<action-ci-right>Go to step 7 </action-ci-right>
<result-ci-down>A</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Perform troubleshooting using the following methods based on the problem symptom </testtitle>
<test1>
<ptxt>TaSCAN - ECU Data Monitor (see <xref label="Seep09" href="RM000000AW301NX"/>)</ptxt>
</test1>
<test1>
<ptxt>TaSCAN - Active Test (see <xref label="Seep10" href="RM000000AW301NX"/>)</ptxt>
</test1>
<test1>
<ptxt>Manual Driving Test (see <xref label="Seep11" href="RM000000ITK01FX"/>)</ptxt>
</test1>
<test1>
<ptxt>Terminals of ECU (see <xref label="Seep06" href="RM000000AVF018X"/>)</ptxt>
</test1>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Adjust, Repair or Replace </testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
</results>
</descript-testgroup>
<descript-testgroup>
<testtitle>Confirmation Test </testtitle>
<results>
<result-ci-down>NEXT</result-ci-down>
<action-ci-fin>END</action-ci-fin>
</results>
</descript-testgroup>
</descript-diag>
</content5>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>