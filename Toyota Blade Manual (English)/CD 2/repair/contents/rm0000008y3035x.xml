<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000008Y3035X_04_0002" fin="false">A</down>
<right ref="RM0000008Y3035X_04_0004" fin="false">B</right>
<right ref="RM0000008Y3035X_04_0016" fin="true">C</right>
</res>
</testgrp>
