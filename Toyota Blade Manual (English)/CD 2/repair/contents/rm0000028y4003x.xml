<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7421E_T001U" variety="T001U">
<name>Discharge Headlight Bulb</name>
<para id="RM0000028Y4003X" category="A" type-id="30014" name-id="603IY-00" from="200612">
<name>Installation</name>
<subpara id="RM0000028Y4003X_01" type-id="01" category="01">
<s-1 id="RM0000028Y4003X_01_0006" proc-id="RM0550J___0000A5U00000">
<ptxt>Install Discharge Headlight Bulb</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>In the order shown in the illustration, lock the set spring and install the discharge headlight bulb.</ptxt>
<figure>
<graphic graphicname="E147036J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Turn in the direction indicated by the arrow in the illustration and connect the socket of the headlight light control computer assembly LH.</ptxt>
<figure>
<graphic graphicname="E147035" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>After replacing the discharge headlight bulb, check that it comes on before reassembling.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028Y4003X_01_0007" proc-id="RM0550J___0000A5V00000">
<ptxt>Install Headlight Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Turn the headlight cover in the direction of the arrow shown in the illustration to install it.</ptxt>
<figure>
<graphic graphicname="E147034" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028Y4003X_01_0008" proc-id="RM0550J___0000A5W00000">
<ptxt>Install Air Cleaner Inlet NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 2 claws.</ptxt>
<figure>
<graphic graphicname="E146997" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install air cleaner inlet NO.1 with the clips.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000028Y4003X_01_0011" proc-id="RM0550J___000031W00000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 8 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000028Y4003X_01_0009" proc-id="RM0550J___0000BX400000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM0000028Y4003X_01_0005" proc-id="RM0550J___00000TY00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
