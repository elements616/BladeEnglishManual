<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000003AEJ000X" category="J" type-id="3009M" name-id="261IM-00" from="200708">
<dtccode/>
<dtcname>ECU Power Source System</dtcname>
<subpara id="RM000003AEJ000X_01" type-id="31" category="03" proc-id="RM0550J___0000H2T00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>When the ignition is turned ON, current from the MREL terminal of the engine control computer flows to the EFI MAIN relay, closing its contacts and supplying power to the +B terminal of the transmission control computer.</ptxt>
</content5>
</subpara>
<subpara id="RM000003AEJ000X_02" type-id="32" category="03" proc-id="RM0550J___0000H6800000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C173987J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000003AEJ000X_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000003AEJ000X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000003AEJ000X_04_0001" proc-id="RM0550J___0000H2U00000">
<testtitle>Inspect Transmission Control Computer Assembly (Power Source Voltage)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="C169062J06" width="2.775699831in" height="2.775699831in"/>
</figure>
<test1>
<ptxt>Disconnect the transmission control computer connector.</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage between the terminals. (see <xref label="Seep01" href="RM000000AVF018X"/> for Terminals of ECU)</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.86in"/>
<colspec colname="COL2" colwidth="1.11in"/>
<colspec colname="COL3" colwidth="1.16in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>18(+B) - 8(E1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals. (see <xref label="Seep02" href="RM000000AVF018X"/> for Terminals of ECU)</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.86in"/>
<colspec colname="COL2" colwidth="1.11in"/>
<colspec colname="COL3" colwidth="1.16in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>8 (E1) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000003AEJ000X_04_0002" fin="true">OK</down>
<right ref="RM000003AEJ000X_04_0003" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000003AEJ000X_04_0002">
<testtitle>To EFI system, ECU power source circuit<xref label="Seep01" href="X362000006X016J"/>
</testtitle>
</testgrp>
<testgrp id="RM000003AEJ000X_04_0003">
<testtitle>Inspect Wire Harness and Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
