<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="1001O_S001F" variety="S001F">
<name>Cruise Control</name>
<ttl id="1001O_S001F_74QXD_T00FC" variety="T00FC">
<name>Radar Cruise Control System</name>
<para id="RM000000DDS01BX" category="C" type-id="300SK" name-id="5914W-00" from="200708">
<dtccode>P0500/21</dtccode>
<dtcname>Vehicle Speed Sensor System</dtcname>
<subpara id="RM000000DDS01BX_05" type-id="31" category="03" proc-id="RM0550J___0000C9900000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The wheel speed pulse signals output from the ABS speed sensors installed on each wheel are converted into vehicle speed pulse signals by the ABS &amp; traction actuator assembly, output to the combination meter assembly as a vehicle speed signal, and input into the engine control computer.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="2.47in"/>
<colspec colname="COL3" colwidth="3.61in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0500/21</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>During cruise control operation</ptxt>
</item>
<item>
<ptxt>No vehicle speed signal is input</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Combination meter assembly (speed signal)</ptxt>
</item>
<item>
<ptxt>Wire harness and connector (combination meter assembly - engine control computer)</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000DDS01BX_09" type-id="32" category="03" proc-id="RM0550J___0000C9B00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E143500J05" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000DDS01BX_07" type-id="51" category="05" proc-id="RM0550J___0000C9A00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>This DTC may be output together with EFI system DTCs; if they are output together, perform EFI system diagnosis first.</ptxt>
</item>
<item>
<ptxt>When the engine control computer is replaced with a new one, be sure to perform initialization. (see <xref label="Seep01" href="RM000002GO2003X"/>)</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM000000DDS01BX_10" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DDS01BX_10_0024" proc-id="RM0550J___0000CED00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs. (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000DDS01BX_10_0021" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000DDS01BX_10_0021" proc-id="RM0550J___0000C9C00000">
<scantool type="1"/>
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Put the vehicle in the conditions under which the DTC is detected.</ptxt>
<atten4>
<ptxt>The system cannot detect the malfunction unless the detection conditions are met.</ptxt>
</atten4>
<test2>
<ptxt>Drive the vehicle in the D position for 2 seconds or more (engine coolant temperature 20°C or higher).</ptxt>
</test2>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), check for DTCs (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.10in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>P0500 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>P0500 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DDS01BX_10_0026" fin="true">A</down>
<right ref="RM000000DDS01BX_10_0023" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DDS01BX_10_0026">
<testtitle>Go to Problem Symptom Simulation Method<xref label="Seep01" href="RM000000ABY04BX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DDS01BX_10_0023">
<testtitle>Go to EFI system (P0500/42)<xref label="Seep01" href="RM0000008Y100ZX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
