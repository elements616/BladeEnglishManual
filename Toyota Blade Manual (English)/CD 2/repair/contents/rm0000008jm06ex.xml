<entry valign="middle" align="center">
<ptxt>ANT ←→ Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Receiving radio (AM/FM)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>11 to 14 V</ptxt>
</entry>
