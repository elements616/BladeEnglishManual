</testgrp>
<testgrp id="RM0000008JM06EX_06_0041" proc-id="RM0550J___00005H000002">
<testtitle>Inspect Radio Receiver Assembly (Antenna)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Noise generation check</ptxt>
<test2>
<ptxt>Disconnect the antenna plug.</ptxt>
