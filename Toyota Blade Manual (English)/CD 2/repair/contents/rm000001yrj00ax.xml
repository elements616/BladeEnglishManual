<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000U_S0017" variety="S0017">
<name>Steering Column</name>
<ttl id="1000U_S0017_745FR_T00AZ" variety="T00AZ">
<name>Electric Power Steering System</name>
<para id="RM000001YRJ00AX" category="C" type-id="800PI" name-id="480Y8-00" from="200612">
<dtccode>C1581/26</dtccode>
<dtcname>Assist Map Not Written</dtcname>
<subpara id="RM000001YRJ00AX_05" type-id="33" category="03" proc-id="RM0550J___0000AEM00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The assist map is selected according to the vehicle specifications; if it is determined that the assist map has not been written to the power steering computer assembly, a DTC is output.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.69in"/>
<colspec colname="COL2" colwidth="2.95in"/>
<colspec colname="COL3" colwidth="2.44in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Detection Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Trouble Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1581/26</ptxt>
</entry>
<entry valign="middle">
<ptxt>Assist map not written to power steering computer assembly</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Assist Map Not Written</ptxt>
</item>
<item>
<ptxt>Power Steering Computer Assembly</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
<item>
<ptxt>ABS &amp; Traction Actuator Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000001YRJ00AX_06" type-id="51" category="05" proc-id="RM0550J___0000AEN00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>If the power steering computer assembly is replaced, perform the torque sensor 0 point calibration and rotation angle sensor output calibration. (see <xref label="Seep01" href="RM0000024YB004X"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000001YRJ00AX_07" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000001YRJ00AX_07_0014" proc-id="RM0550J___0000AEO00000">
<testtitle>Perform Assist Map Writing</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Turn the IG ON and wait for 1 seconds or more.</ptxt>
</test1>
<test1>
<ptxt>Check the diagnostic trouble codes. (see <xref label="Seep01" href="RM000000URU00GX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.48in"/>
<colspec colname="COL2" align="center" colwidth="1.65in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>C1581/26 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>C1581/26 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>The assist map is automatically acquired approximately 1 seconds after the IG is turned ON. After automatic acquisition, code C1581/26 is cleared.</ptxt>
</atten4>
</test1>
</content6>
<res>
<down ref="RM000001YRJ00AX_07_0029" fin="false">A</down>
<right ref="RM000001YRJ00AX_07_0020" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000001YRJ00AX_07_0029" proc-id="RM0550J___0000AIL00000">
<testtitle>Inspect Control System CAN Communication System</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Using TaSCAN (SST), check for DTCs of the CAN communication system. (see <xref label="Seep01" href="RM0000005S001MX"/>)</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
</content6>
<res>
<down ref="RM000001YRJ00AX_07_0017" fin="false">OK</down>
<right ref="RM000001YRJ00AX_07_0021" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001YRJ00AX_07_0017" proc-id="RM0550J___0000AEQ00000">
<testtitle>Inspect Engine Control Computer</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check whether the correct engine control computer is installed.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Engine control computer is the correct part</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000001YRJ00AX_07_0026" fin="false">OK</down>
<right ref="RM000001YRJ00AX_07_0025" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001YRJ00AX_07_0026" proc-id="RM0550J___0000AER00000">
<testtitle>Inspect ABS &amp; Traction Actuator Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check that the correct ABS &amp; traction actuator assembly is installed.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>ABS &amp; traction actuator assembly is the correct part</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000001YRJ00AX_07_0019" fin="true">OK</down>
<right ref="RM000001YRJ00AX_07_0028" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001YRJ00AX_07_0019">
<testtitle>Replace Power Steering Computer Assembly<xref label="Seep01" href="RM000000UNH00TX"/>
</testtitle>
</testgrp>
<testgrp id="RM000001YRJ00AX_07_0020">
<testtitle>No malfunction (returns to normal on completion of assist map writing)</testtitle>
</testgrp>
<testgrp id="RM000001YRJ00AX_07_0021">
<testtitle>Go to Control System CAN Communication System<xref label="Seep01" href="RM000001R4W009X"/>
</testtitle>
</testgrp>
<testgrp id="RM000001YRJ00AX_07_0025">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM0000020V0005X"/>
</testtitle>
</testgrp>
<testgrp id="RM000001YRJ00AX_07_0028">
<testtitle>Replace ABS &amp; Traction Actuator Assembly<xref label="Seep01" href="RM00000304V000X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>