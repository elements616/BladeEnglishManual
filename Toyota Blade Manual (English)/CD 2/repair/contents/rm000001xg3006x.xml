<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_742BN_T003S" variety="T003S">
<name>Navigation Receiver Assembly</name>
<para id="RM000001XG3006X" category="A" type-id="30014" name-id="652MN-00" from="200612">
<name>Installation</name>
<subpara id="RM000001XG3006X_01" type-id="01" category="01">
<s-1 id="RM000001XG3006X_01_0009">
<ptxt>Install Navigation Receiver Assembly</ptxt>
</s-1>
<s-1 id="RM000001XG3006X_01_0010" proc-id="RM0550J___00001QT00000">
<ptxt>Install Radio Bracket NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radio bracket NO.2 to the navigation receiver assembly with the 4 screws.</ptxt>
<figure>
<graphic graphicname="E140889" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001XG3006X_01_0011" proc-id="RM0550J___00001QU00000">
<ptxt>Install Radio Bracket NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radio bracket NO.1 to the navigation receiver assembly with the 4 screws.</ptxt>
<figure>
<graphic graphicname="E140888" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001XG3006X_01_0019" proc-id="RM0550J___00001PG00000">
<ptxt>Install Navigation Receiver Assembly w/ Bracket</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 4 clips and temporarily install the navigation receiver assembly w/ bracket.</ptxt>
<figure>
<graphic graphicname="E137111" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the navigation receiver assembly w/ bracket with the 4 bolts.</ptxt>
<figure>
<graphic graphicname="E137109" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001XG3006X_01_0025" proc-id="RM0550J___00009N100000">
<ptxt>Install Instrument Panel Register Assembly Center
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector.</ptxt>
<figure>
<graphic graphicname="B151129" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 clips, 5 claws and 3 guides, and install the instrument panel register assembly CTR.</ptxt>
<figure>
<graphic graphicname="B169225J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001XG3006X_01_0026" proc-id="RM0550J___00009N200000">
<ptxt>Install Instrument Panel Finish Panel End RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and install the instrument panel finish panel end RH.</ptxt>
<figure>
<graphic graphicname="B169227" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001XG3006X_01_0027" proc-id="RM0550J___00009N300000">
<ptxt>Install Instrument Panel Finish Panel End LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 clips and install the instrument panel finish panel end LH.</ptxt>
<figure>
<graphic graphicname="B169226" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001XG3006X_01_0024" proc-id="RM0550J___0000BX200000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM000001XG3006X_01_0008" proc-id="RM0550J___00001QS00000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
