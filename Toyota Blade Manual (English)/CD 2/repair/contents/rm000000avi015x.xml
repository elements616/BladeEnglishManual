<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000000AVI015X" category="J" type-id="3009N" name-id="261IL-01" from="200912">
<dtccode/>
<dtcname>Park/Neutral Position Switch Assembly Circuit</dtcname>
<subpara id="RM000000AVI015X_01" type-id="33" category="03" proc-id="RM0550J___0000FRD00001">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The engine control computer detects the shift position (forward and reverse only) using signals from the neutral start switch assembly.</ptxt>
</content5>
</subpara>
<subpara id="RM000000AVI015X_02" type-id="31" category="03" proc-id="RM0550J___0000FRE00001">
<name>Circuit Description</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="C139041J03" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000AVI015X_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000000AVI015X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000AVI015X_04_0001" proc-id="RM0550J___0000FRF00001">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Shift Position R and D Range)</testtitle>
<content6 releasenbr="2">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), display the [ECU Data Monitor] screen according to the screen display, and check the computer data.</ptxt>
<table pgwide="1">
<title>[Diagnosis menu screen: Powertrain → ECT → ECU Data Monitor]</title>
<tgroup cols="4">
<colspec colname="COL1" colwidth="1.77in"/>
<colspec colname="COL2" colwidth="1.77in"/>
<colspec colname="COL3" colwidth="1.77in"/>
<colspec colname="COL4" colwidth="1.77in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
<ptxt>[Symbol]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Item Description/Display Range</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard Value</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Remarks</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Shift Position R Range</ptxt>
<ptxt>[R]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates R range</ptxt>
<ptxt>Display: ON/OFF</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>OFF→ON:</ptxt>
<ptxt>Shift lever N → R</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Neutral start switch (R) signal</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Shift Position D Range</ptxt>
<ptxt>[D]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates D range</ptxt>
<ptxt>Display: ON/OFF</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>OFF→ON:</ptxt>
<ptxt>Shift lever N → D</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Neutral start switch (D) signal</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test1>
</content6>
<res>
<down ref="RM000000AVI015X_04_0005" fin="true">OK</down>
<right ref="RM000000AVI015X_04_0002" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000000AVI015X_04_0002" proc-id="RM0550J___0000FRG00001">
<testtitle>Inspect Wire Harness and Connector (Power Source System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D705AX"/>.</ptxt>
</atten4>
<test1>
<ptxt>Disconnect the neutral start switch assembly connector.</ptxt>
<figure>
<graphic graphicname="C141931J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</test1>
<test1>
<ptxt>Turn the IG ON and, using SST (Toyota electrical tester), measure the voltage between the terminals.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.14in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<colspec colname="COL3" colwidth="0.96in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Terminal No. (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1 (RB) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>7.5 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000AVI015X_04_0003" fin="false">OK</down>
<right ref="RM000000AVI015X_04_0006" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000AVI015X_04_0003" proc-id="RM0550J___0000FRH00001">
<testtitle>Inspect Neutral Start Switch Assembly</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<figure>
<graphic graphicname="C141932J03" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.85in"/>
<colspec colname="COL2" colwidth="1.14in"/>
<colspec colname="COL3" colwidth="1.14in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Terminal No. (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>2(RL) - 1(RB)</ptxt>
</entry>
<entry valign="middle">
<ptxt>R position</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1(RB) - 7(DL)</ptxt>
</entry>
<entry valign="middle">
<ptxt>D position / M position</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000AVI015X_04_0004" fin="false">OK</down>
<right ref="RM000000AVI015X_04_0007" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000AVI015X_04_0004" proc-id="RM0550J___0000FRI00001">
<testtitle>Inspect Wire Harness and Connector (Neutral Start Switch Assembly - Transmission Control Computer)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D705AX"/>.</ptxt>
</atten4>
<test1>
<ptxt>Connect the neutral start switch assembly connector.</ptxt>
</test1>
<test1>
<ptxt>Disconnect the engine control computer connector.</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), check the voltage between each terminal of the wire harness.</ptxt>
<figure>
<graphic graphicname="C169062J05" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.04in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Terminal No. (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry morerows="1" valign="middle">
<ptxt>15(R) - 8(E1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>R position</ptxt>
</entry>
<entry valign="middle">
<ptxt>7.5 to 14V</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Other than R position</ptxt>
</entry>
<entry valign="middle">
<ptxt>0 to 1.5V</ptxt>
</entry>
</row>
<row>
<entry morerows="1" valign="middle">
<ptxt>16(D) - 8(E1)</ptxt>
</entry>
<entry valign="middle">
<ptxt>D position / M position</ptxt>
</entry>
<entry valign="middle">
<ptxt>7.5 to 14V</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Other than D position / M position</ptxt>
</entry>
<entry valign="middle">
<ptxt>0 to 1.5V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000AVI015X_04_0009" fin="false">OK</down>
<right ref="RM000000AVI015X_04_0008" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000AVI015X_04_0005">
<testtitle>Go to the related circuit inspection shown in the List by Symptom<xref label="Seep01" href="RM000000DAV01FX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000AVI015X_04_0006">
<testtitle>Inspect Power Source System</testtitle>
</testgrp>
<testgrp id="RM000000AVI015X_04_0007">
<testtitle>Replace Neutral Start Switch Assembly<xref label="Seep01" href="RM000002BOM003X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000AVI015X_04_0008">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000000AVI015X_04_0009" proc-id="RM0550J___0000HCQ00001">
<testtitle>Inspect and Replace Transmission Control Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the transmission control computer assembly. (see <xref label="Seep01" href="RM0000024M8003X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000AVI015X_04_0011" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000AVI015X_04_0011">
<testtitle>A/T Unit Compensation<xref label="Seep01" href="RM000000OLY013X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>