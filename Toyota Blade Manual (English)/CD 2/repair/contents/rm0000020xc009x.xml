<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10024_S000T" variety="S000T">
<name>Starting</name>
<ttl id="10024_S000T_74XTS_T00H2" variety="T00H2">
<name>Starter Assembly (2GR-FE)</name>
<para id="RM0000020XC009X" category="A" type-id="80001" name-id="1626Y-00" from="200708">
<name>Removal</name>
<subpara id="RM0000020XC009X_01" type-id="01" category="01">
<s-1 id="RM0000020XC009X_01_0016" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020XC009X_01_0017">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM0000020XC009X_01_0018" proc-id="RM0550J___0000EUD00000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020XC009X_01_0019" proc-id="RM0550J___0000EUE00000">
<ptxt>Remove Battery Carrier
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the battery tray.</ptxt>
<figure>
<graphic graphicname="A176883" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 clamps and disconnect the wire harness from the battery carrier.</ptxt>
</s2>
<s2>
<ptxt>Remove the 4 bolts and the battery carrier.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020XC009X_01_0020" proc-id="RM0550J___0000EUF00000">
<ptxt>Remove Battery Carrier NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and battery carrier NO.2.</ptxt>
<figure>
<graphic graphicname="A159803" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020XC009X_01_0005" proc-id="RM0550J___0000FIV00000">
<ptxt>Remove Starter Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="A179068J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Open the terminal cap cover.</ptxt>
</s2>
<s2>
<ptxt>Remove the nut and disconnect terminal B.</ptxt>
</s2>
<s2>
<ptxt>Remove the bolt (A in the illustration) and disconnect the wire harness clamp bracket.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 bolts (B in the illustration) and the starter assembly.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>