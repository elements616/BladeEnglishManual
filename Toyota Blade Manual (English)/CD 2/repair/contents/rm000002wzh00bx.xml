<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10008_S000M" variety="S000M">
<name>Emission Control</name>
<ttl id="10008_S000M_74Y1X_T00HY" variety="T00HY">
<name>Ventilation Valve Sub-assembly (2GR-FE)</name>
<para id="RM000002WZH00BX" category="A" type-id="80001" name-id="09102-00" from="200708">
<name>Removal</name>
<subpara id="RM000002WZH00BX_01" type-id="01" category="01">
<s-1 id="RM000002WZH00BX_01_0025" proc-id="RM0550J___0000DHU00000">
<ptxt>Remove V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place both hands on the front of the cover and lift it upward to disengage the 2 front clips, then continue lifting upward to disengage the 1 rear clips, and remove the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Pulling up the front and rear at the same time may cause damage.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM000002WZH00BX_01_0005" proc-id="RM0550J___0000HAI00000">
<ptxt>Disconnect Ventilation Hose</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="A177017" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Slide the clamp and disconnect the ventilation hose.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002WZH00BX_01_0001" proc-id="RM0550J___0000HAJ00000">
<ptxt>Remove Ventilation Valve Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a ball joint lock nut wrench (22mm), remove the ventilation valve.</ptxt>
<figure>
<graphic graphicname="A178688" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>