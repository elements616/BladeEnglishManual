<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), measure the waveform between each terminal of the air conditioner amplifier assembly connector.</ptxt>
<figure>
<graphic graphicname="E155342J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
