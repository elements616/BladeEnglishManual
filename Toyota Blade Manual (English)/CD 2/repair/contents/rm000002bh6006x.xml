<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.71in"/>
<colspec colname="COL2" colwidth="1.05in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A13 (SG-2) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002BH6006X_04_0009" fin="false">OK</down>
<right ref="RM000002BH6006X_04_0004" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002BH6006X_04_0009" proc-id="RM0550J___0000HGZ00000">
<testtitle>Inspect Air Conditioner Amplifier Assembly (LOCK Terminal)</testtitle>
<content6 releasenbr="1">
