</row>
<row>
<entry valign="middle" align="center">
<ptxt>Measurement Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Engine idling, blower switch LO, A/C switch ON</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
