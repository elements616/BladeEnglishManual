<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_744F0_T005M" variety="T005M">
<name>Engine Mounting Insulator RH (2AZ-FE)</name>
<para id="RM0000027J5006X" category="A" type-id="30014" name-id="071TH-00" from="200612">
<name>Installation</name>
<subpara id="RM0000027J5006X_03" type-id="01" category="01">
<s-1 id="RM0000027J5006X_03_0009" proc-id="RM0550J___000031I00000">
<ptxt>Install Engine Mounting Insulator Sub-assembly RH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the RH engine mounting insulator with 3 bolts.</ptxt>
<figure>
<graphic graphicname="A162929" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the engine mounting insulator RH to the engine mounting bracket RH with the bolt and 2 nuts.</ptxt>
<figure>
<graphic graphicname="A162928J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
<ptxt>(Bolt)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
<ptxt>(Nut A)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>52</t-value1>
<t-value2>530</t-value2>
<ptxt>(Nut B)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the cooler pipe bracket with 2 bolts and the nut.</ptxt>
<figure>
<graphic graphicname="A162927" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM0000027J5006X_03_0014" proc-id="RM0550J___0000AQB00000">
<ptxt>Install Radiator Reserve Tank Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator reserve tank assembly with 2 bolts.</ptxt>
<figure>
<graphic graphicname="A162931" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM0000027J5006X_03_0016" proc-id="RM0550J___000031W00000">
<ptxt>Install Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the radiator upper air deflector with the 8 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000027J5006X_03_0018" proc-id="RM0550J___0000BJ200000">
<ptxt>Install Engine Under Cover Rear RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine under cover rear RH with the 5 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000027J5006X_03_0019" proc-id="RM0550J___0000AJC00000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine under cover No.1 with the 6 bolts and 7 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000027J5006X_03_0020" proc-id="RM0550J___0000BRN00000">
<ptxt>Install Front Tire RH</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>103</t-value1>
<t-value2>1050</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>