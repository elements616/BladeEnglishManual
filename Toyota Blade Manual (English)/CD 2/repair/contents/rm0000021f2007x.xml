<para id="RM0000021F2007X" category="C" type-id="302NP" name-id="3225S-00" from="200612">
<dtccode>P0717/37</dtccode>
<dtcname>Speed Sensor Circuit</dtcname>
<subpara id="RM0000021F2007X_01" type-id="33" category="03" proc-id="RM0550J___000045H00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The transmission revolution sensor (NT) inputs the turbine speed as a signal to the engine control computer, and the engine control computer performs lock-up engagement pressure control and forward/reverse clutch pressure control.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.25in"/>
<colspec colname="COL2" colwidth="3.22in"/>
<colspec colname="COL3" colwidth="2.61in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P0717/37</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>Driving in the D position with an output shaft speed of 300rpm or more (vehicle speed of approximately 7km/h or more) (provided that no neutral start switch malfunction is detected)</ptxt>
</item>
<item>
<ptxt>Turbine speed less than 300rpm</ptxt>
</item>
<item>
<ptxt>Continuously for 2 seconds or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire Harness and Connector</ptxt>
<ptxt>(NT Sensor Signal System)</ptxt>
</item>
<item>
<ptxt>Transmission Revolution Sensor (NT)</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000021F2007X_02" type-id="32" category="03" proc-id="RM0550J___000045I00000">
