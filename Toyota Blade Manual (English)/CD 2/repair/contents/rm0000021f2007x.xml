</subpara>
<subpara id="RM0000021F2007X_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM0000021F2007X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000021F2007X_04_0001" proc-id="RM0550J___000045J00000">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Turbine Speed)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), display the [ECU Data Monitor] screen according to the screen display, and check the computer data.</ptxt>
<table pgwide="1">
<title>[Diagnosis menu screen: Powertrain → TCCS → ECU Data Monitor]</title>
<tgroup cols="4" align="center">
<colspec colname="COL1" colwidth="1.32in"/>
<colspec colname="COL2" colwidth="2.15in"/>
<colspec colname="COL3" colwidth="2.06in"/>
<colspec colname="COL4" colwidth="1.55in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Item Name</ptxt>
<ptxt>[Symbol]</ptxt>
</entry>
<entry valign="middle">
<ptxt>Item Description</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Reference Value</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Turbine Speed (NT)</ptxt>
<ptxt>[NT]</ptxt>
</entry>
<entry valign="middle">
<ptxt>Indicates turbine speed</ptxt>
<ptxt>Display Range: 0 to 12750rpm</ptxt>
</entry>
<entry valign="middle">
<ptxt>Vehicle stopped in P or N position</ptxt>
<ptxt>(Engine idling)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Almost the same as the engine idle speed</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Turbine Speed (NT)</ptxt>
<ptxt>[NT]</ptxt>
</entry>
<entry valign="middle">
<ptxt>Indicates turbine speed</ptxt>
<ptxt>Display Range: 0 to 12750rpm</ptxt>
</entry>
<entry valign="middle">
<ptxt>Vehicle stopped in D position</ptxt>
</entry>
<entry valign="middle">
<ptxt>0rpm</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Turbine Speed (NT)</ptxt>
<ptxt>[NT]</ptxt>
</entry>
<entry valign="middle">
<ptxt>Indicates turbine speed</ptxt>
<ptxt>Display Range: 0 to 12750rpm</ptxt>
</entry>
<entry valign="middle">
<ptxt>Lock-up ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>Same as engine speed</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
