<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001C_S000C" variety="S000C">
<name>Audio &amp; Visual</name>
<ttl id="1001C_S000C_742AJ_T002U" variety="T002U">
<name>Steering Pad Switch Assembly (4-spoke Steering Wheel)</name>
<para id="RM000002C05001X" category="A" type-id="30014" name-id="641K6-00" from="200612" to="200912">
<name>Installation</name>
<subpara id="RM000002C05001X_01" type-id="01" category="01">
<s-1 id="RM000002C05001X_01_0005" proc-id="RM0550J___00001E400000">
<ptxt>Install Steering Pad Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Steering pad switch RH side</ptxt>
<figure>
<graphic graphicname="E145404" width="2.775699831in" height="1.771723296in"/>
</figure>
<s3>
<ptxt>Engage the 2 pins.</ptxt>
</s3>
<s3>
<ptxt>Install the steering pad switch RH side with the screw.</ptxt>
</s3>
<s3>
<ptxt>Route the harness of the steering pad switch RH side under the clamp.</ptxt>
</s3>
</s2>
<s2>
<ptxt>Steering pad switch LH side</ptxt>
<figure>
<graphic graphicname="E145405" width="2.775699831in" height="1.771723296in"/>
</figure>
<s3>
<ptxt>Engage the 2 pins.</ptxt>
</s3>
<s3>
<ptxt>Install the steering pad switch LH side with the screw.</ptxt>
</s3>
<s3>
<ptxt>Route the harness of the steering pad switch LH side under the clamp.</ptxt>
</s3>
</s2>
<s2>
<ptxt>Connect the connector to the spiral cable.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002C05001X_01_0017" proc-id="RM0550J___00006KS00000">
<ptxt>Install Horn Button Assembly
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C162622" width="2.775699831in" height="2.775699831in"/>
</figure>
<s2>
<ptxt>Connect the horn connector to the horn button assembly.</ptxt>
</s2>
<s2>
<ptxt>Connect the airbag connector to the horn button assembly and lock it securely.</ptxt>
<atten3>
<ptxt>Securely lock the airbag connector.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Using a torx socket wrench (T30), install the horn button assembly to the steering wheel assembly with the 2 torx bolts.</ptxt>
<figure>
<graphic graphicname="C159692J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<torque>
<torqueitem>
<t-value1>8.8</t-value1>
<t-value2>90</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000002C05001X_01_0018" proc-id="RM0550J___00006LH00000">
<ptxt>Install Steering Wheel Cover Lower NO.3
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C154144" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Engage the claws and install the steering wheel cover lower No.3.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002C05001X_01_0019" proc-id="RM0550J___00006LI00000">
<ptxt>Install Steering Wheel Cover Lower NO.2
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C154145" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Engage the claws and install the steering wheel cover lower No.2.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002C05001X_01_0020" proc-id="RM0550J___0000BWB00000">
<ptxt>Connect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>5.4</t-value1>
<t-value2>55</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
<s-1 id="RM000002C05001X_01_0021" proc-id="RM0550J___0000AMO00000">
<ptxt>Airbag Warning Light Inspection
</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000000GDZ00ZX"/>)</ptxt>
</content1></s-1>
<s-1 id="RM000002C05001X_01_0022" proc-id="RM0550J___0000B7300000">
<ptxt>Setting Procedure When Disconnecting/Reconnecting Battery Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
