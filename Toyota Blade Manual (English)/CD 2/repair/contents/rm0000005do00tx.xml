<ptxt>1 V or less → 11 to 14 V</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>15(DOWN) ←→ 12(GND)</ptxt>
</entry>
<entry valign="middle">
<ptxt>/IG ON</ptxt>
