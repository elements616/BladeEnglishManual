<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1000O_S0019" variety="S0019">
<name>Parking Brake</name>
<ttl id="1000O_S0019_77UQH_T00JR" variety="T00JR">
<name>Parking Brake Control Pedal Assembly</name>
<para id="RM000003MKB00BX" category="A" type-id="8000E" name-id="460PZ-01" from="200912">
<name>Reassembly</name>
<subpara id="RM000003MKB00BX_01" type-id="01" category="01">
<s-1 id="RM000003MKB00BX_01_0002" proc-id="RM0550J___0000IRC00000">
<ptxt>Install Parking Pedal Pad</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the parking pedal pad to the parking brake pedal.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000003MKB00BX_01_0005" proc-id="RM0550J___000065500001">
<ptxt>Install Parking Brake Cable Assembly NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install parking brake cable assembly No.1 to the parking brake control pedal assembly.</ptxt>
<figure>
<graphic graphicname="C222597" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the clip to parking brake cable assembly No.1.</ptxt>
</s2>
<s2>
<ptxt>Bend the claw of the parking brake control pedal assembly.</ptxt>
<figure>
<graphic graphicname="C222598" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Temporarily install wire adjusting nut No.1 to parking brake cable assembly No.1.</ptxt>
<figure>
<graphic graphicname="C222595" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000003MKB00BX_01_0004" proc-id="RM0550J___0000IST00000">
<ptxt>Install Parking Brake Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the parking brake switch assembly to the parking brake control pedal assembly with the screw.</ptxt>
<figure>
<graphic graphicname="C206666" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>3.2</t-value1>
<t-value2>33</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>