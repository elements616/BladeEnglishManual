<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74WIJ_T00FO" variety="T00FO">
<name>EFI System (2GR-FE)</name>
<para id="X39400000RO01SC" category="C" type-id="302EV" name-id="0662O-00" from="200708">
<dtccode>P2119/89</dtccode>
<dtcname>Electronic Throttle System Malfunction</dtcname>
<subpara id="X39400000RO01SC_10" type-id="31" category="03" proc-id="RM0550J___0000DBL00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>When this DTC is stored, the engine control computer cuts off the current to the throttle motor, and the throttle valve is returned to a predetermined opening angle (6°) by the return spring.</ptxt>
</item>
</list1>
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="3" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="1.498008     in"/>
<colspec colnum="02" colname="C02" colwidth="3.154628     in"/>
<colspec colnum="03" colname="C03" colwidth="2.494272     in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>DTCNo.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
<item>
<ptxt>Others</ptxt>
</item>
</list1>
</entry>
<entry colname="C03" valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>P2119/89</ptxt>
</entry>
<entry colname="C02" valign="middle" align="left">
<list1 type="ordered">
<item>
<ptxt>Engine running</ptxt>
</item>
<item>
<ptxt>Electronic throttle control system circuit malfunction</ptxt>
</item>
<item>
<ptxt>1 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry colname="C03" valign="middle" align="center">
<ptxt>Engine Control Computer</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="X39400000RO01SC_11" type-id="51" category="05" proc-id="RM0550J___0000DBM00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Using SST (TaSCAN), read the freeze data. Freeze data records part of the engine operating condition when a malfunction occurs, and this information is useful when troubleshooting.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="X39400000RO01SC_12" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X39400000RO01SC_12_0005" proc-id="RM0550J___0000DBO00000">
<scantool type="2"/>
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn the IG ON and clear the DTCs following the SST (TaSCAN) screen display. (see <xref label="Seep01" href="RM0000008YS014X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="X39400000RO01SC_12_0001" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="X39400000RO01SC_12_0001" proc-id="RM0550J___0000DBN00000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Perform a road test.</ptxt>
</test1>
<test1>
<ptxt>Turn the IG ON and check the DTCs following the SST (TaSCAN) screen display. (see <xref label="Seep02" href="RM0000008YS014X"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>P2119/89 is displayed again</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Codes other than P2119/89 are displayed again</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Normal code displayed</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000RO01SC_12_0002" fin="true">A</down>
<right ref="X39400000RO01SC_12_0003" fin="true">B</right>
<right ref="X39400000RO01SC_12_0004" fin="true">C</right>
</res>
</testgrp>
<testgrp id="X39400000RO01SC_12_0002">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM000002ADB004X"/>
</testtitle>
</testgrp>
<testgrp id="X39400000RO01SC_12_0003">
<testtitle>Go to Related DTC Chart<xref label="Seep01" href="RM000001KT7004X"/>
</testtitle>
</testgrp>
<testgrp id="X39400000RO01SC_12_0004">
<testtitle>Inspection for Intermittent Problems<xref label="Seep01" href="RM000000CD101YX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
