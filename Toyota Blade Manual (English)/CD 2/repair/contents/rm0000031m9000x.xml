<subpara id="RM0000031M9000X_01" type-id="01" category="01">
<s-1 id="RM0000031M9000X_01_0001" proc-id="RM0550J___0000BNK00000">
<ptxt>Inspect Interior Illumination Light Assembly NO.1</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="E147571J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Inspect Light Illumination</ptxt>
<s3>
<ptxt>Connect a battery between the connector terminals and inspect the illumination condition of the lights.   </ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.50in"/>
<colspec colname="COL2" colwidth="1.37in"/>
<colspec colname="COL3" colwidth="1.25in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Specified Condition</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry morerows="3" valign="middle" align="left">
<ptxt>Battery positive → 5 (+B1)</ptxt>
<ptxt>Battery negative → 6 (GND)</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>All switches OFF</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>All lights off</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>RH side switch ON</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>RH side light comes on</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>LH side switch ON</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>LH side light comes on</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Dome light switch (ON/OFF switch) ON</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>Dome light on</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s3>
<s3>
<ptxt>Connect a battery between the terminals of the connector, and check the lighting condition of the lights when the DOOR switch is turned OFF→ON.</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.49in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.25in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Specified Condition</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry morerows="1" valign="middle">
<ptxt>Battery positive → 5 (+B1)</ptxt>
<ptxt>Battery negative → 1 (CTY)</ptxt>
</entry>
<entry valign="middle">
<ptxt>DOOR switch OFF</ptxt>
</entry>
<entry valign="middle">
<ptxt>Front map light and dome light off</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>DOOR switch ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>Front map light and dome light on</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s3>
<s3>
<ptxt>Connect a battery between the terminals of the connector, and check the lighting condition of the LED when the ROOM switch is turned OFF→ON.</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.50in"/>
<colspec colname="COL2" colwidth="1.37in"/>
<colspec colname="COL3" colwidth="1.25in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Specified Condition</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry morerows="1" valign="middle">
<ptxt>Battery positive → 5 (+B1)</ptxt>
<ptxt>Battery negative → 2 (CILL)</ptxt>
</entry>
<entry valign="middle">
<ptxt>ROOM switch OFF</ptxt>
</entry>
<entry valign="middle">
<ptxt>Indirect lighting off</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>ROOM switch ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>Indirect lighting on</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s3>
</s2>
</content1>
