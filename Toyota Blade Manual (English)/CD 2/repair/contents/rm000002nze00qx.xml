<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74WIJ_T00FO" variety="T00FO">
<name>EFI System (2GR-FE)</name>
<para id="RM000002NZE00QX" category="J" type-id="3018M" name-id="066OQ-00" from="200708">
<dtccode/>
<dtcname>Check Engine Warning Light Circuit</dtcname>
<subpara id="RM000002NZE00QX_01" type-id="31" category="03" proc-id="RM0550J___0000EUQ00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>The check engine warning light is used to indicate vehicle malfunctions detected by the engine control computer. When the IG is turned ON, power is supplied to the check engine warning light circuit, and the check engine warning light comes on when grounded inside the engine control computer. The operation of the check engine warning light can be checked visually. When the IG is first turned ON, the check engine warning light comes on and then goes off. If the check engine warning light remains on or remains off, perform the following troubleshooting.</ptxt>
</item>
</list1>
</content5>
</subpara>
<subpara id="RM000002NZE00QX_02" type-id="32" category="03" proc-id="RM0550J___0000EUR00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="A177931J01" width="7.106578999in" height="5.787629434in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000002NZE00QX_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000002NZE00QX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002NZE00QX_04_0001" proc-id="RM0550J___0000EUS00000">
<testtitle>Check that Check Engine Warning Light Comes On</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Perform troubleshooting according to the table below.</ptxt>
</test1>
<table>
<title>Check engine warning light condition:</title>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.48in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<colspec colname="COLSPEC0" colwidth="0.82in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Check engine warning light</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Remains on</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Remains off</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Comes on -&gt; goes off</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM000002NZE00QX_04_0007" fin="false">A</down>
<right ref="RM000002NZE00QX_04_0011" fin="false">B</right>
<right ref="RM000002NZE00QX_04_0022" fin="true">C</right>
</res>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0007" proc-id="RM0550J___0000EUT00000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Read the DTCs of the EFI system following the SST (TaSCAN) screen display. (see <xref label="Seep01" href="RM0000008YS014X"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.82in"/>
<colspec colname="COL2" colwidth="1.31in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>No DTC is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>DTCs are output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002NZE00QX_04_0008" fin="false">A</down>
<right ref="RM000002NZE00QX_04_0015" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0008" proc-id="RM0550J___0000EUU00000">
<testtitle>Inspect Wire Harness and Connector (Short Circuit Inspection)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Disconnect connector B of the engine control computer.</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Check that the check engine warning light in the combination meter assembly does not come on.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.81in"/>
<colspec colname="COL2" colwidth="1.32in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Check engine warning light comes on</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Check engine warning light does not come on</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002NZE00QX_04_0009" fin="false">A</down>
<right ref="RM000002NZE00QX_04_0016" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0009" proc-id="RM0550J___0000EUV00000">
<testtitle>Inspect Wire Harness and Connector (Engine Control Computer - Combination Meter Assembly)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep01" href="RM0000005D702RX"/>.</ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="A154767J04" width="7.106578999in" height="2.775699831in"/>
</figure>
<test1>
<ptxt>Disconnect the combination meter assembly connector.</ptxt>
</test1>
<test1>
<ptxt>Disconnect connector B of the engine control computer.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals. (For terminals, refer to <xref label="Seep02" href="X39400000QV01SD"/>)</ptxt>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" align="center" colwidth="4.25in"/>
<colspec colname="COL2" colwidth="1.39in"/>
<colspec colname="COL3" colwidth="1.44in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry>
<ptxt>Condition</ptxt>
</entry>
<entry>
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Between B24 (W) and 20 (EFI) - Body ground</ptxt>
</entry>
<entry>
<ptxt>Always</ptxt>
</entry>
<entry>
<ptxt>10k Ω or more</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002NZE00QX_04_0017" fin="true">OK</down>
<right ref="RM000002NZE00QX_04_0013" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0011" proc-id="RM0550J___0000EUW00000">
<testtitle>Inspect Engine Starting</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check that the engine starts.</ptxt>
</test1>
<table>
<title>Result:</title>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Engine starts</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Engine does not start</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM000002NZE00QX_04_0020" fin="true">A</down>
<right ref="RM000002NZE00QX_04_0019" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0013">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0015">
<testtitle>Go to Related DTC Chart<xref label="Seep01" href="RM000001KT7004X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0016">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM000002ADB004X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0017">
<testtitle>Replace Combination Meter Assembly<xref label="Seep01" href="RM000002C0F001X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0019">
<testtitle>Go to VC power source circuit inspection<xref label="Seep01" href="RM000002NZF00QX"/>
</testtitle>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0020">
<testtitle>Replace Combination Meter Assembly<xref label="Seep01" href="RM000002C0F001X"/>
</testtitle>
</testgrp>
<testgrp id="RM000002NZE00QX_04_0022">
<testtitle>System Normal</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>