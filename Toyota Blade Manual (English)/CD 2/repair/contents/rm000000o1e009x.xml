<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B9_T003J" variety="T003J">
<name>Intelligent Parking Assist System</name>
<para id="RM000000O1E009X" category="C" type-id="8038Z" name-id="672E1-00" from="200612" to="200912">
<dtccode>C1612</dtccode>
<dtcname>IG Voltage Malfunction</dtcname>
<subpara id="RM000000O1E009X_05" type-id="33" category="03" proc-id="RM0550J___00007M600000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller determines through its self-diagnosis that the input IG voltage is abnormal.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1612</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>IG Voltage Drop</ptxt>
</item>
<item>
<ptxt>IG Voltage Rise</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Television Camera Controller</ptxt>
</item>
<item>
<ptxt>Television camera controller power source system wire harness and connector</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000O1E009X_06" type-id="32" category="03" proc-id="RM0550J___00007M700000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E144415J01" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000O1E009X_07" type-id="51" category="05" proc-id="RM0550J___00007M800000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When the battery terminal is disconnected, perform the setting operations required when the battery terminal is removed and installed. (see <xref label="Seep01" href="RM000001LYW00PX"/>)</ptxt>
</item>
<item>
<ptxt>Depending on the parts replaced or the work performed during inspection, registration settings for other systems may be necessary in addition to the intelligent parking assist system. (see <xref label="Seep02" href="RM00000304S000X"/>)</ptxt>
</item>
</list1>
</atten3>
</content5>
</subpara>
<subpara id="RM000000O1E009X_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000O1E009X_08_0006" proc-id="RM0550J___00007M900000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again, and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.01in"/>
<colspec colname="COL2" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>"C1612" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000000O1E009X_08_0007" fin="false">A</down>
<right ref="RM000000O1E009X_08_0009" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000O1E009X_08_0007" proc-id="RM0550J___00007MA00000">
<testtitle>Inspect Wire Harness and Connector (Television Camera Controller Power Source)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Voltage Inspection </ptxt>
<figure>
<graphic graphicname="E141824J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Using SST (Toyota electrical tester), with the vehicle side wire harness connector shown in the illustration disconnected from the television camera controller, measure the voltage between each terminal from the back of the connector.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>A1(IG) - A4(GND1)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>11 to 14 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000000O1E009X_08_0008" fin="true">OK</down>
<right ref="RM000000O1E009X_08_0010" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000O1E009X_08_0008">
<testtitle>Replace Television Camera Controller<xref label="Seep01" href="RM000000MZ5001X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000O1E009X_08_0009">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000O1E009X_08_0010">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
