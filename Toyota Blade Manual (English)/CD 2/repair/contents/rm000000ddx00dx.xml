<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="1001O_S001F" variety="S001F">
<name>Cruise Control</name>
<ttl id="1001O_S001F_74QXD_T00FC" variety="T00FC">
<name>Radar Cruise Control System</name>
<para id="RM000000DDX00DX" category="C" type-id="3030I" name-id="59151-00" from="200708">
<dtccode>P1572/75</dtccode>
<dtcname>Radar Sensor Beam Axis Misalignment</dtcname>
<subpara id="RM000000DDX00DX_01" type-id="31" category="03" proc-id="RM0550J___0000CB700000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P1572/75</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>Control vehicle speed (40 - 100 km/h), cruise control main switch ON (vehicle-to-vehicle distance control mode)</ptxt>
</item>
<item>
<ptxt>The beam axis of the millimeter wave radar sensor assembly is misaligned</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>Millimeter Wave Radar Sensor Assembly</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten3>
<ptxt>This DTC may be output together with brake system DTCs; if they are output together, perform brake system diagnosis first.</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM000000DDX00DX_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000000DDX00DX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DDX00DX_04_0010" proc-id="RM0550J___0000CB800000">
<testtitle>Check DTCs (Pre-crash Safety System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the screen display to display the "System Diagnosis Menu/Pre-crash" screen.</ptxt>
</test1>
<test1>
<ptxt>Select "DTC Freeze Data" and check the DTCs.</ptxt>
</test1>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.90in"/>
<colspec colname="COL2" colwidth="1.23in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B2056 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>B2056 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM000000DDX00DX_04_0012" fin="false">A</down>
<right ref="RM000000DDX00DX_04_0014" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DDX00DX_04_0012" proc-id="RM0550J___0000CEM00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Clear the DTCs using SST (TaSCAN). (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000DDX00DX_04_0013" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000DDX00DX_04_0013" proc-id="RM0550J___0000CEN00000">
<testtitle>Check DTCs (Radar Cruise Control System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Put the vehicle in the conditions under which the DTC is detected.</ptxt>
<atten4>
<ptxt>The system cannot detect the malfunction unless the detection conditions are met.</ptxt>
</atten4>
<test2>
<ptxt>Drive within the cruise control set vehicle speed range.</ptxt>
</test2>
<test2>
<ptxt>Turn the cruise control main switch ON and put the system in vehicle-to-vehicle distance mode standby.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs. (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.90in"/>
<colspec colname="COL2" colwidth="1.23in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>P1572 is not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>P1572 is output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DDX00DX_04_0011" fin="true">A</down>
<right ref="RM000000DDX00DX_04_0015" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DDX00DX_04_0011">
<testtitle>Go to Problem Symptom Simulation Method<xref label="Seep01" href="RM000000ABY04BX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DDX00DX_04_0014">
<testtitle>Go to the relevant diagnostic trouble code (B2056)</testtitle>
</testgrp>
<testgrp id="RM000000DDX00DX_04_0015">
<testtitle>Replace Distance Control Computer Assembly<xref label="Seep01" href="RM0000028Z1003X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>