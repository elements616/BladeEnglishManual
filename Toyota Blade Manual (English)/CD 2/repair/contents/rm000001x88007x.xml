<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7420G_T000Y" variety="T000Y">
<name>Headlight Assembly LH</name>
<para id="RM000001X88007X" category="A" type-id="80001" name-id="604OD-01" from="200912">
<name>Removal</name>
<subpara id="RM000001X88007X_01" type-id="01" category="01">
<s-1 id="RM000001X88007X_01_0010" proc-id="RM0550J___00009IZ00001">
<ptxt>Precautions for Handling Discharge Headlights (Discharge Type Headlight)</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM0000005JQ00JX"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000001X88007X_01_0011" proc-id="RM0550J___0000BAL00001">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
<content1 releasenbr="1">
<ptxt>(see <xref label="Seep01" href="RM000002ZPI000X"/>)</ptxt>
</content1>
</s-1>
<s-1 id="RM000001X88007X_01_0025" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001X88007X_01_0023" proc-id="RM0550J___00008DP00000">
<ptxt>Remove Radiator Grille Protector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 radiator grille protectors.</ptxt>
<figure>
<graphic graphicname="B167060" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001X88007X_01_0024" proc-id="RM0550J___00008DQ00000">
<ptxt>Remove Front Bumper Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a flat-tip screwdriver, turn the pin hold clip 90° and remove the pin hold clip.</ptxt>
<figure>
<graphic graphicname="B167061J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Perform the same procedure on the RH side.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Apply protective tape around the front bumper assembly.</ptxt>
<figure>
<graphic graphicname="B167062J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Using a clip remover, remove the 3 upper clips.</ptxt>
</s2>
<s2>
<ptxt>Remove the 6 screws, 2 clips and 2 bolts.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly outward from the vehicle to disengage the 8 claws (4 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167063" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Pull the front bumper assembly toward the front of the vehicle and remove the front bumper assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000001X88007X_01_0013" proc-id="RM0550J___00009J100001">
<ptxt>Remove Headlight Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and screw.</ptxt>
<figure>
<graphic graphicname="E206583" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect each connector and remove the headlight assembly LH.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>