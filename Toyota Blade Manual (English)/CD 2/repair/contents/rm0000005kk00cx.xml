<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001A_S0009" variety="S0009">
<name>Lighting</name>
<ttl id="1001A_S0009_7420N_T0015" variety="T0015">
<name>Lighting System</name>
<para id="RM0000005KK00CX" category="U" type-id="303FP" name-id="603CR-00" from="200612">
<name>Fail-safe List</name>
<subpara id="RM0000005KK00CX_z0" proc-id="RM0550J___00000RQ00000">
<content5 releasenbr="1">
<step1>
<ptxt>Fail-safe Function</ptxt>
<step2>
<ptxt>Headlight Light Control Computer Assembly</ptxt>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.76in"/>
<colspec colname="COL2" colwidth="5.32in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Status</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Output open</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Operation stops after approximately 1 seconds.</ptxt>
</item>
<item>
<ptxt>Operation remains stopped until power is reapplied (light control switch OFF → HEAD).</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Short between output terminals</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Operation stops within approximately 1 seconds.</ptxt>
</item>
<item>
<ptxt>Operation remains stopped until power is reapplied (light control switch OFF → HEAD).</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Leak between output terminal and ground</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Operation stops after approximately 0.1 seconds.</ptxt>
</item>
<item>
<ptxt>Operation remains stopped until power is reapplied (light control switch OFF → HEAD).</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Lamp voltage too low</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Operation stops after approximately 80 seconds.</ptxt>
</item>
<item>
<ptxt>Operation remains stopped until power is reapplied (light control switch OFF → HEAD).</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Lamp voltage too high</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Operation stops within approximately 1 seconds.</ptxt>
</item>
<item>
<ptxt>Operation remains stopped until power is reapplied (light control switch OFF → HEAD).</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Bulb blinking</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>If blinking continues for approximately 60 seconds, operation stops.</ptxt>
</item>
<item>
<ptxt>Operation remains stopped until power is reapplied (light control switch OFF → HEAD).</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Input overvoltage</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Operation stops when power source voltage is 20 ± 3V.</ptxt>
</item>
<item>
<ptxt>Operation resumes when power source voltage returns to 16V or less.</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Input low voltage</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Operation stops when power source voltage is 6V or less.</ptxt>
</item>
<item>
<ptxt>Operation resumes when power source voltage returns to 10V or more.</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</step2>
<step2>
<ptxt>Headlight Leveling Computer Assembly</ptxt>
<step3>
<ptxt>The headlight leveling computer assembly stops auto leveling control if it detects any of the following malfunctions. Also, if a malfunction is detected while the actuator is being driven, actuator drive is stopped.</ptxt>
<table pgwide="1">
<tgroup cols="4">
<colspec colname="COL1" colwidth="1.61in"/>
<colspec colname="COL2" colwidth="1.93in"/>
<colspec colname="COL3" colwidth="1.82in"/>
<colspec colname="COL4" colwidth="1.72in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Malfunction Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Return Conditions</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Warning Display</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Height Sensor Malfunction</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>When vehicle height sensor power source malfunction (4.6V or less) is detected</ptxt>
</item>
<item>
<ptxt>When vehicle height sensor signal malfunction (0.25V or less or 4.75V or more) is detected</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>When normal value is detected and IG turned ON again</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Yes</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Vehicle Speed</ptxt>
</entry>
<entry valign="middle">
<ptxt>When excessive vehicle speed is detected</ptxt>
</entry>
<entry valign="middle">
<ptxt>When speed below a certain level is detected</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>None</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Power Supply Overvoltage</ptxt>
</entry>
<entry valign="middle">
<ptxt>When IG power source voltage of 18.5V or more is detected</ptxt>
</entry>
<entry valign="middle">
<ptxt>When 17.5V or less is detected</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>None</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Power Supply Low Voltage</ptxt>
</entry>
<entry valign="middle">
<ptxt>When IG power source voltage of 9V or less is detected</ptxt>
</entry>
<entry valign="middle">
<ptxt>When 9.3V or more is detected</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>None</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Reset While Driving</ptxt>
</entry>
<entry valign="middle">
<ptxt>When the driving status judgment immediately after IG ON was driving</ptxt>
</entry>
<entry valign="middle">
<ptxt>When judged as stopped</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>None</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</step3>
</step2>
</step1>
</content5>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>