<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1000Z_S001D" variety="S001D">
<name>Seat Belt</name>
<ttl id="1000Z_S001D_746PU_T00CT" variety="T00CT">
<name>Cross Anchor Bracket</name>
<para id="RM000002WCC002X" category="A" type-id="80001" name-id="5610F-00" from="200612">
<name>Removal</name>
<subpara id="RM000002WCC002X_01" type-id="01" category="01">
<s-1 id="RM000002WCC002X_01_0018">
<ptxt>Remove Rear Seat Headrest Assembly</ptxt>
</s-1>
<s-1 id="RM000002WCC002X_01_0019">
<ptxt>Remove Rear Seat Headrest Assembly Center</ptxt>
</s-1>
<s-1 id="RM000002WCC002X_01_0020" proc-id="RM0550J___000081T00000">
<ptxt>Remove Rear Seat Cushion Hinge Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the rear seat cushion hinge cover NO.1.</ptxt>
<figure>
<graphic graphicname="B161942" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002WCC002X_01_0021" proc-id="RM0550J___000081U00000">
<ptxt>Remove Rear Seat Cushion Hinge Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the rear seat cushion hinge cover NO.2.</ptxt>
<figure>
<graphic graphicname="B162910" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002WCC002X_01_0022" proc-id="RM0550J___000081V00000">
<ptxt>Remove Rear Seat Assembly RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 front side bolts of the rear seat assembly RH.</ptxt>
<figure>
<graphic graphicname="B155442" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Fold the rear seat assembly RH forward.</ptxt>
<figure>
<graphic graphicname="B155443" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 rear side bolts and remove the rear seat assembly RH.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000002WCC002X_01_0024" proc-id="RM0550J___0000BKJ00000">
<ptxt>Disconnect Rear Seat Outer Belt Assembly Center
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and disconnect the rear seat outer belt assembly center together with the rear seat inner belt assembly.</ptxt>
<figure>
<graphic graphicname="B164162" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the washer and rear seat outer belt assembly center from the rear seat inner belt assembly.</ptxt>
<figure>
<graphic graphicname="B160926" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002WCC002X_01_0001" proc-id="RM0550J___0000AID00000">
<ptxt>Remove Cross Anchor Bracket</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and cross anchor bracket.</ptxt>
<figure>
<graphic graphicname="B167515" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>