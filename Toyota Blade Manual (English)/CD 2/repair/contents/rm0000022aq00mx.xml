<para id="RM0000022AQ00MX" category="C" type-id="3034C" name-id="066OB-00" from="200708">
<dtccode>P1550</dtccode>
<dtcname>Battery Current Sensor Circuit</dtcname>
<dtccode>P1551</dtccode>
