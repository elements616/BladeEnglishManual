<subpara id="RM0000022AQ00MX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000022AQ00MX_04_0001" proc-id="RM0550J___0000DAC00000">
<testtitle>Inspect Battery Current Sensor Assembly</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the battery current sensor assembly connector.</ptxt>
</test1>
<test1>
<ptxt> Using the SST (Toyota electrical tester), measure the resistance between each terminal.</ptxt>
<figure>
<graphic graphicname="A105340J25" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.03in"/>
<colspec colname="COL2" colwidth="1.03in"/>
<colspec colname="COL3" colwidth="1.07in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>2(VC5) - 4(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>3 to 10kΩ</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>2(VC5) - 3(IB)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>0.5k Ω or less</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>3(IB) - 4(E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>3 to 10kΩ</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000022AQ00MX_04_0002" fin="false">OK</down>
<right ref="RM0000022AQ00MX_04_0003" fin="true">NG</right>
</res>
</testgrp>
