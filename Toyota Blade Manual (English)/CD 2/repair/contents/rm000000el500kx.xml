<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1000Y_S0012" variety="S0012">
<name>SRS Airbag</name>
<ttl id="1000Y_S0012_745Q2_T00B8" variety="T00B8">
<name>SRS Airbag System</name>
<para id="RM000000EL500KX" category="C" type-id="305D5" name-id="554GK-00" from="200612">
<dtccode>B1000</dtccode>
<dtcname>Airbag computer assembly malfunction</dtcname>
<subpara id="RM000000EL500KX_06" type-id="31" category="03" proc-id="RM0550J___00006KI00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The airbag computer assembly consists of a G sensor, safing sensor, drive circuit, diagnosis circuit, ignition control, etc. The airbag computer assembly receives signals from the G sensor, determines whether to activate the airbags (horn button assembly, instrument panel passenger airbag assembly, curtain shield airbags RH and LH, front seat airbag assemblies RH and LH) and pretensioners (front seat outer belt assemblies RH and LH), and detects malfunctions in the airbag system. </ptxt>
<ptxt>When a malfunction is detected in the airbag computer assembly, DTC B1000 is stored. </ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Trouble Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B1000</ptxt>
</entry>
<entry valign="middle" align="center">
<list1 type="nonmark">
<item>
<ptxt>Airbag Computer Assembly Malfunction</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<list1 type="nonmark">
<item>
<ptxt>Airbag Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000EL500KX_07" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000000EL500KX_08" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000EL500KX_08_0022" proc-id="RM0550J___00006KJ00000">
<scantool type="2"/>
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs.</ptxt>
<ptxt>(see <xref label="Seep01" href="RM00000050J01GX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000000EL500KX_08_0023" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000000EL500KX_08_0023" proc-id="RM0550J___00006KK00000">
<scantool type="1"/>
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Turn the ignition switch ON and wait for 60 seconds.</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs.</ptxt>
<ptxt>(see <xref label="Seep01" href="RM00000050J01GX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.06in"/>
<colspec colname="COL2" colwidth="1.07in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>No DTCs other than B1000 are output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>DTCs other than B1000 are also output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000EL500KX_08_0024" fin="true">A</down>
<right ref="RM000000EL500KX_08_0025" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000EL500KX_08_0024">
<testtitle>Replace Airbag Computer Assembly<xref label="Seep01" href="RM000002RR0002X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000EL500KX_08_0025">
<testtitle>Go to the relevant DTC</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>