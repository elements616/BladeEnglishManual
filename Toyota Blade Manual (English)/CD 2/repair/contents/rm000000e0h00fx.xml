<s-1 id="RM000000E0H00FX_04_0028" proc-id="RM0550J___0000AC100001">
<ptxt>Remove Console Rear End Panel (Drive Type FF)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 10 claws and remove the console rear end panel.</ptxt>
<figure>
<graphic graphicname="B236970" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E0H00FX_04_0035" proc-id="RM0550J___0000IM700000">
<ptxt>Remove Console Rear End Panel (Drive Type 4WD)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 6 claws and remove the console rear end panel.</ptxt>
<figure>
<graphic graphicname="B236976" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000E0H00FX_04_0029" proc-id="RM0550J___0000AC200001">
<ptxt>Remove Console Compartment Door Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
