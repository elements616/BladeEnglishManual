<content5 releasenbr="1">
<figure>
<graphic graphicname="E145617J01" width="7.106578999in" height="4.7836529in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000000FM600UX_08" type-id="51" category="05">
<name>Inspection Procedure</name>
