<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74XTX_T00H7" variety="T00H7">
<name>Air Fuel Ratio Sensor (2GR-FE)</name>
<para id="RM0000020W000EX" category="A" type-id="30014" name-id="066QC-00" from="200708">
<name>Installation</name>
<subpara id="RM0000020W000EX_01" type-id="01" category="01">
<s-1 id="RM0000020W000EX_01_0001" proc-id="RM0550J___0000FO300000">
<ptxt>Install Air Fuel Ratio Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, install the air fuel ratio sensor to the exhaust manifold.</ptxt>
<figure>
<graphic graphicname="A179066J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<torque>
<torqueitem>
<t-value1>44</t-value1>
<t-value2>449</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W000EX_01_0022" proc-id="RM0550J___0000HB100000">
<ptxt>Install Exhaust Manifold Sub-assembly RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the exhaust manifold RH with 6 new nuts.</ptxt>
</s2>
<s2>
<ptxt>Tighten the nuts in the order shown in the illustration.</ptxt>
<figure>
<graphic graphicname="A182103" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the air fuel ratio sensor connector.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020W000EX_01_0023" proc-id="RM0550J___0000HC000000">
<ptxt>Install Exhaust Pipe Assembly Front
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install with 2 new gaskets, 2 nuts and 2 bolts.</ptxt>
<figure>
<graphic graphicname="A135140J05" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>43</t-value1>
<t-value2>438</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the exhaust center pipe assembly with 2 bolts and 2 compression springs.</ptxt>
<figure>
<graphic graphicname="A135137J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>43</t-value1>
<t-value2>438</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the oxygen sensor No.2 connector.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020W000EX_01_0024" proc-id="RM0550J___0000FBA00000">
<ptxt>Install Exhaust Pipe Assembly Center
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the exhaust center pipe assembly with 2 new gaskets, 2 nuts and 2 bolts.</ptxt>
<figure>
<graphic graphicname="A135140J05" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<subtitle>Bolt</subtitle>
<torqueitem>
<t-value1>62</t-value1>
<t-value2>632</t-value2>
</torqueitem>
<subtitle>Nut</subtitle>
<torqueitem>
<t-value1>43</t-value1>
<t-value2>438</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Before installing the oxygen sensor body, twist it approximately 4 turns as shown in the illustration, then install it.</ptxt>
<figure>
<graphic graphicname="A128944J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST, install the oxygen sensor.</ptxt>
<figure>
<graphic graphicname="A135139" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<torque>
<torqueitem>
<t-value1>44</t-value1>
<t-value2>449</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000020W000EX_01_0007" proc-id="RM0550J___0000FO600000">
<ptxt>Install Air Fuel Ratio Sensor NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, install the air fuel ratio sensor No.2 to the exhaust manifold.</ptxt>
<figure>
<graphic graphicname="A135165J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<torque>
<torqueitem>
<t-value1>44</t-value1>
<t-value2>449</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the air fuel ratio sensor No.2 connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W000EX_01_0018" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020W000EX_01_0015" proc-id="RM0550J___0000FQ300000">
<ptxt>Install Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install engine under cover NO.1 with the 6 bolts and 7 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020W000EX_01_0016" proc-id="RM0550J___0000FQ200000">
<ptxt>Install Engine Under Cover
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine under cover with the 4 bolts and 4 screws.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020W000EX_01_0025" proc-id="RM0550J___0000H6D00000">
<ptxt>Exhaust Gas Leak Inspection
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that there are no exhaust gas leaks from the locations shown in the illustration (exhaust pipe joints and each sensor installation area).</ptxt>
<figure>
<graphic graphicname="A176820" width="7.106578999in" height="5.787629434in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>