<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="A154430J04" width="2.775699831in" height="3.779676365in"/>
</figure>
<test1>
<ptxt>Remove the integration relay from the engine room R/B.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage of the integration relay vehicle side connector terminals.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.11in"/>
<colspec colname="COL2" colwidth="1.07in"/>
<colspec colname="COL3" colwidth="0.95in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A1 - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X362000006X016J_14_0047" fin="false">OK</down>
<right ref="X362000006X016J_14_0049" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X362000006X016J_14_0047" proc-id="RM0550J___0000GVE00000">
<testtitle>Inspect Fuse (EFI MAIN, EFI NO.1, IG2, IGN)</testtitle>
<content6 releasenbr="1">
