<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1002M_S001G" variety="S001G">
<name>Pre-crash Safety</name>
<ttl id="1002M_S001G_74WT7_T00FP" variety="T00FP">
<name>Pre-crash Safety System</name>
<para id="RM000000DBC00KX" category="C" type-id="8007R" name-id="540JK-00" from="200708">
<dtccode>B2060/41</dtccode>
<dtcname>VSC Malfunction</dtcname>
<subpara id="RM000000DBC00KX_01" type-id="31" category="03" proc-id="RM0550J___0000CUY00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="unordered">
<item>
<ptxt>This DTC is output when a malfunction occurs in the brake system.</ptxt>
</item>
<item>
<ptxt>This circuit consists of the ABS &amp; traction actuator assembly and seat belt control computer, and receives information from the ABS &amp; traction actuator assembly via CAN communication.</ptxt>
</item>
</list1>
<table frame="all" pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="col1" colwidth="1.01in"/>
<colspec colname="col2" colwidth="2.99in"/>
<colspec colname="col3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B2060/41</ptxt>
</entry>
<entry valign="middle">
<ptxt>Brake system malfunction is detected</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>ABS with EBD &amp; TRC &amp; VSC &amp; BA system</ptxt>
</item>
<item>
<ptxt>Seat Belt Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000DBC00KX_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000000DBC00KX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000DBC00KX_04_0001" proc-id="RM0550J___0000CUZ00000">
<testtitle>Check DTC (Brake System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), follow the prompts on the screen to display the "System Diagnosis Menu/ABS/VSC" screen, and select "DTC".</ptxt>
</test1>
<test1>
<ptxt>Check for DTCs.</ptxt>
<spec>
<title>Specified Condition</title>
<table pgwide="1">
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.54in"/>
<colspec colname="COL3" colwidth="3.54in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>DTCs are output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000DBC00KX_04_0006" fin="true">A</down>
<right ref="RM000000DBC00KX_04_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000DBC00KX_04_0006">
<testtitle>Replace Seat Belt Control Computer<xref label="Seep01" href="RM000002SZU002X"/>
</testtitle>
</testgrp>
<testgrp id="RM000000DBC00KX_04_0004">
<testtitle>Go to the relevant DTC chart<xref label="Seep01" href="RM0000005ZT00PX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>