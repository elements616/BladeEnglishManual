<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_747JK_T00DW" variety="T00DW">
<name>Crank Position Sensor (2AZ-FE)</name>
<para id="RM00000296R005X" category="A" type-id="80001" name-id="065B5-00" from="200612">
<name>Removal</name>
<subpara id="RM00000296R005X_01" type-id="01" category="01">
<s-1 id="RM00000296R005X_01_0019">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM00000296R005X_01_0010">
<ptxt>Remove Front Tire RH</ptxt>
</s-1>
<s-1 id="RM00000296R005X_01_0018" proc-id="RM0550J___000038000000">
<ptxt>Remove Engine Under Cover Rear RH
</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Use the same procedure for the RH side as for the LH side.</ptxt>
</atten4>
</content1></s-1>
<s-1 id="RM00000296R005X_01_0017" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000296R005X_01_0014" proc-id="RM0550J___000032E00000">
<ptxt>Remove Fan &amp; Alternator V Belt
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, slowly turn the V-belt tensioner clockwise.</ptxt>
<figure>
<graphic graphicname="A164227J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<sst>
<sstitem>
<s-number>09961-01270</s-number>
</sstitem>
</sst>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Check that the SST and tools are securely set.</ptxt>
</item>
<item>
<ptxt>When compressing the V-belt tensioner, slowly apply force perpendicular to the tool, taking 3 seconds or more.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Remove the V-belt from each pulley and slowly return the tensioner.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM00000296R005X_01_0015" proc-id="RM0550J___000032F00000">
<ptxt>Remove Alternator Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="A137075" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the terminal cap.</ptxt>
</s2>
<s2>
<ptxt>Remove the nut and disconnect the harness from the +B terminal.</ptxt>
</s2>
<s2>
<ptxt>Remove the bolt and disconnect the clamp bracket.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the harness clamp.</ptxt>
</s2>
<s2>
<ptxt>Remove the 2 bolts and the Alternator assembly.</ptxt>
<figure>
<graphic graphicname="A137076" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM00000296R005X_01_0016" proc-id="RM0550J___0000BXU00000">
<ptxt>Remove Crankshaft Position Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the connector.</ptxt>
<figure>
<graphic graphicname="A138142J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the wire harness from the wire harness clamp bracket.</ptxt>
</s2>
<s2>
<ptxt>Remove the bolt and remove the crank position sensor.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>