<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1000N_S0010" variety="S0010">
<name>Brake</name>
<ttl id="1000N_S0010_744Y2_T009N" variety="T009N">
<name>Brake Pedal Support Assembly</name>
<para id="RM000000CI000EX" category="A" type-id="8000E" name-id="4510E-00" from="200612">
<name>Reassembly</name>
<subpara id="RM000000CI000EX_02" type-id="01" category="01">
<s-1 id="RM000000CI000EX_02_0005" proc-id="RM0550J___00008F000000">
<ptxt>Install Brake Pedal Pad</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the brake pedal pad.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CI000EX_02_0006" proc-id="RM0550J___00005EC00000">
<ptxt>Install Brake Pedal Bush</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply MP grease No.2 to the sides and inner surfaces of the 2 new brake pedal bushes.</ptxt>
</s2>
<s2>
<ptxt>Install the 2 brake pedal bushes to the brake pedal.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CI000EX_02_0007" proc-id="RM0550J___00005ED00000">
<ptxt>Install Brake Pedal Sub-assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C151111" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Install the brake pedal to the brake pedal support with the bolt and nut.</ptxt>
<torque>
<torqueitem>
<t-value1>37</t-value1>
<t-value2>377</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>Insert the bolt from right to left as viewed from the driver seat.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CI000EX_02_0008" proc-id="RM0550J___00005EE00000">
<ptxt>Install Stop Light Switch Mounting Adjuster</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the adjuster to the brake pedal support.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CI000EX_02_0009" proc-id="RM0550J___00005EF00000">
<ptxt>Temporarily Tighten Stop Light Switch Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C132726" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Turn the stop light switch assembly clockwise to temporarily install it to the brake pedal support.</ptxt>
<atten4>
<ptxt>Fully tighten the stop light switch when inspecting and adjusting the brake pedal height.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>