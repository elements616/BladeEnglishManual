<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10008_S000M" variety="S000M">
<name>Emission Control</name>
<ttl id="10008_S000M_747J4_T00DS" variety="T00DS">
<name>Ventilation Valve Sub-assembly (2AZ-FE)</name>
<para id="RM000002WZF003X" category="G" type-id="3001K" name-id="090SU-00" from="200612">
<name>Component Inspection</name>
<subpara id="RM000002WZF003X_01" type-id="01" category="01">
<s-1 id="RM000002WZF003X_01_0001" proc-id="RM0550J___0000BWU00000">
<ptxt>Inspect Ventilation Valve Sub-assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Ventilation Valve Operation Inspection</ptxt>
<s3>
<ptxt>Install a hose to the cylinder head side.</ptxt>
</s3>
<s3>
<ptxt>Check that air passes smoothly when air is blown in from the cylinder head side.</ptxt>
<figure>
<graphic graphicname="A059511" width="2.775699831in" height="1.771723296in"/>
</figure>
</s3>
<s3>
<ptxt>Remove the hose.</ptxt>
</s3>
<s3>
<ptxt>Install a hose to the manifold side.</ptxt>
</s3>
<s3>
<ptxt>Check that air does not pass when air is blown in from the manifold side.</ptxt>
<figure>
<graphic graphicname="A059512" width="2.775699831in" height="1.771723296in"/>
</figure>
</s3>
<s3>
<ptxt>Remove the hose.</ptxt>
</s3>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
