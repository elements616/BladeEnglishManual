<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000U_S0017" variety="S0017">
<name>Steering Column</name>
<ttl id="1000U_S0017_745FS_T00B0" variety="T00B0">
<name>Steering Column Assembly</name>
<para id="RM000002S5U002X" category="A" type-id="8000D" name-id="480YT-00" from="200612">
<name>Inspection</name>
<subpara id="RM000002S5U002X_01" type-id="01" category="01">
<s-1 id="RM000002S5U002X_01_0001" proc-id="RM0550J___0000APD00000">
<ptxt>Inspect Preload</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Secure the steering column assembly in a vise with aluminum plates.</ptxt>
<atten3>
<ptxt>Do not overtighten the vise.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Using SST and a torque wrench, measure the preload of the steering column assembly.</ptxt>
<figure>
<graphic graphicname="C149897J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09616-00011</s-number>
</sstitem>
</sst>
<torque>
<torqueitem>
<t-value1>0.8 to 1.2</t-value1>
<t-value2>8.2 to 12.2</t-value2>
</torqueitem>
</torque>
<atten4>
<ptxt>If the result is not as specified, replace the steering column assembly.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>