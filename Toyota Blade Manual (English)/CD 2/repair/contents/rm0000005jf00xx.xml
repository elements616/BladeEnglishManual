<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="07">
<name>Steering</name>
<section id="1000U_S0017" variety="S0017">
<name>Steering Column</name>
<ttl id="1000U_S0017_746I2_T00CG" variety="T00CG">
<name>Steering Lock System</name>
<para id="RM0000005JF00XX" category="J" type-id="3053G" name-id="480YP-00" from="200612">
<dtccode/>
<dtcname>Steering Lock Does Not Operate</dtcname>
<subpara id="RM0000005JF00XX_01" type-id="51" category="05" proc-id="RM0550J___0000A1I00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>When using the tool with the IG OFF, after connecting the tool to the vehicle, repeatedly turn the courtesy switch of any door ON/OFF until communication between the tool and the vehicle starts. (ON/OFF interval within 1.5 seconds)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000005JF00XX_02" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000005JF00XX_02_0001" proc-id="RM0550J___0000A1J00000">
<testtitle>Check DTC Output</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Using SST (TaSCAN), check whether any certification ECU diagnostic trouble codes are output. (see <xref label="Seep01" href="RM0000005GM00UX"/>)</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.89in"/>
<colspec colname="COL2" align="center" colwidth="1.24in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>No certification ECU malfunction code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>Certification ECU malfunction code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM0000005JF00XX_02_0022" fin="false">A</down>
<right ref="RM0000005JF00XX_02_0026" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000005JF00XX_02_0022" proc-id="RM0550J___0000A1P00000">
<testtitle>Check DTC Output</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Using SST (TaSCAN), check whether any main body ECU diagnostic trouble codes are output. (see <xref label="Seep01" href="RM0000005GM00UX"/>)</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" align="center" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>No main body ECU malfunction code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>Main body ECU malfunction code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM0000005JF00XX_02_0009" fin="false">A</down>
<right ref="RM0000005JF00XX_02_0027" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000005JF00XX_02_0009" proc-id="RM0550J___0000A1L00000">
<testtitle>Read TaSCAN Data</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Within 10 seconds of performing the engine starting operation, read the certification ECU data monitor and check [Steering Lock Operation Request Reception History]. (see <xref label="Seep01" href="RM0000005GN00VX"/>)</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Command received</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005JF00XX_02_0002" fin="false">OK</down>
<right ref="RM0000005JF00XX_02_0012" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005JF00XX_02_0002" proc-id="RM0550J___0000A1K00000">
<testtitle>Inspect Steering Lock Actuator Assembly (IGE and SGND Continuity)</testtitle>
<content6 releasenbr="1">
<figure>
<graphic graphicname="C104383J59" width="2.775699831in" height="1.771723296in"/>
</figure>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), inspect the voltage between steering lock actuator terminals 3 (IGE) ←→ 2 (SGND) immediately after opening the door with the IG OFF and the shift in P.  </ptxt>
</test1>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<table>
<title>Result:</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1 V or less occurs immediately after door is opened</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Remains at 11to14 V and never drops to 1 V or less</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM0000005JF00XX_02_0032" fin="true">A</down>
<right ref="RM0000005JF00XX_02_0028" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000005JF00XX_02_0012" proc-id="RM0550J___0000A1M00000">
<testtitle>Read TaSCAN Data</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Using SST (TaSCAN), read the certification ECU data monitor and check [S Code Verification Result]. (see <xref label="Seep01" href="RM0000005GN00VX"/>)</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>OK</ptxt>
</specitem>
</spec>
</content6>
<res>
<down ref="RM0000005JF00XX_02_0013" fin="false">OK</down>
<right ref="RM0000005JF00XX_02_0024" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005JF00XX_02_0013" proc-id="RM0550J___0000A1N00000">
<testtitle>Read TaSCAN Data</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Using SST (TaSCAN), read the certification ECU data monitor and check [L Code Verification Result]. (see <xref label="Seep01" href="RM0000005GN00VX"/>)</ptxt>
</test1>
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>OK</ptxt>
</specitem>
</spec>
</content6>
<res>
<down ref="RM0000005JF00XX_02_0015" fin="false">OK</down>
<right ref="RM0000005JF00XX_02_0025" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005JF00XX_02_0015" proc-id="RM0550J___0000A1O00000">
<testtitle>Replace Steering Lock Actuator Assembly</testtitle>
<content6 releasenbr="2">
<test1>
<ptxt>Replace the steering actuator with a new one. (see <xref label="Seep01" href="RM000000UCZ00QX"/>)</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Operate the steering wheel and check the steering lock status.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Steering lock is released and engine starts</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000005JF00XX_02_0035" fin="true">OK</down>
<right ref="RM0000005JF00XX_02_0030" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000005JF00XX_02_0024" proc-id="RM0550J___0000A1Q00000">
<testtitle>Replace Immobiliser Code Computer (ID Code Box)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the ID code box with a new one. (Refer to the procedure)</ptxt>
</test1>
<test1>
<ptxt>Using SST (TaSCAN) again, read the certification ECU data monitor and check [S Code Verification Result]. (see <xref label="Seep01" href="RM0000005GN00VX"/>)</ptxt>
