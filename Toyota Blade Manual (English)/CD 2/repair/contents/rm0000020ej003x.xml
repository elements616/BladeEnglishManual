<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1000Z_S001D" variety="S001D">
<name>Seat Belt</name>
<ttl id="1000Z_S001D_746RN_T00CY" variety="T00CY">
<name>Rear Seat Belt Assembly Inner w/ (Center) LH</name>
<para id="RM0000020EJ003X" category="A" type-id="30014" name-id="5610D-00" from="200612">
<name>Installation</name>
<subpara id="RM0000020EJ003X_01" type-id="01" category="01">
<s-1 id="RM0000020EJ003X_01_0001" proc-id="RM0550J___0000AQP00000">
<ptxt>Install Rear Seat Belt Assembly Inner (w/ Center) LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the rear seat inner belt assembly (center) LH with the bolt.</ptxt>
<figure>
<graphic graphicname="B156989J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<torque>
<torqueitem>
<t-value1>41</t-value1>
<t-value2>420</t-value2>
</torqueitem>
</torque>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Pay attention to the installation direction of the floor anchor.</ptxt>
</item>
<item>
<ptxt>Be careful that the floor anchor does not ride up onto the locator.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020EJ003X_01_0005" proc-id="RM0550J___0000AQQ00000">
<ptxt>Install Rear Seat Cushion Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Return the rear seat cushion assembly to its original position.</ptxt>
</s2>
<s2>
<ptxt>Install the rear seat cushion assembly with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="B156984" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>42</t-value1>
<t-value2>428</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020EJ003X_01_0008" proc-id="RM0550J___000083400000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the rear seat cushion hinge cover NO.2.</ptxt>
<figure>
<graphic graphicname="B162910" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020EJ003X_01_0009" proc-id="RM0550J___000083500000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the rear seat cushion hinge cover NO.1.</ptxt>
<figure>
<graphic graphicname="B161942" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>