<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001B_S000A" variety="S000A">
<name>Wiper &amp; Washer</name>
<ttl id="1001B_S000A_7421M_T001W" variety="T001W">
<name>Wiper Rubber LH</name>
<para id="RM000001XEC003X" category="A" type-id="80001" name-id="611D7-00" from="200612">
<name>Removal</name>
<subpara id="RM000001XEC003X_01" type-id="01" category="01">
<s-1 id="RM000001XEC003X_01_0001" proc-id="RM0550J___00000UB00000">
<ptxt>Remove Front Wiper Blade LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Release the holder of the front wiper blade LH as shown in the illustration.</ptxt>
</s2>
<s2>
<ptxt>Remove the front wiper blade LH from the front wiper arm LH.</ptxt>
<atten3>
<ptxt>To prevent damage to the windshield glass, place a cloth or similar between the windshield glass and the front wiper arm LH.</ptxt>
</atten3>
<figure>
<graphic graphicname="E146272J01" width="7.106578999in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001XEC003X_01_0002" proc-id="RM0550J___00000UC00000">
<ptxt>Remove Wiper Rubber LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the wiper rubber LH together with the wiper rubber backing plate.</ptxt>
<figure>
<graphic graphicname="E125259" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the wiper rubber LH from the wiper rubber backing plate.</ptxt>
<figure>
<graphic graphicname="E125260J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>