</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1 (GND1) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000060P014X_32_0176" fin="false">OK</down>
<right ref="RM00000060P014X_32_0181" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000060P014X_32_0176" proc-id="RM0550J___0000A3R00000">
<scantool type="1"/>
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Clear the DTCs, perform a road test, and check the DTCs again. (see <xref label="Seep01" href="RM00000060000PX"/>)</ptxt>
<spec>
