<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001H_S0001" variety="S0001">
<name>Seat</name>
<ttl id="1001H_S0001_74605_T00BN" variety="T00BN">
<name>Rear Seat Assembly LH</name>
<para id="RM0000030HT000X" category="A" type-id="30014" name-id="791BY-00" from="200612">
<name>Installation</name>
<subpara id="RM0000030HT000X_01" type-id="01" category="01">
<s-1 id="RM0000030HT000X_01_0001" proc-id="RM0550J___000084H00000">
<ptxt>Install Rear Seat Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Set the rear seat assembly LH in the vehicle, and install the 2 rear side bolts in the order inner → outer.</ptxt>
<torque>
<torqueitem>
<t-value1>42</t-value1>
<t-value2>428</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155445" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Raise the seatback, and install the 2 front side bolts of the rear seat assembly LH in the order inner → outer.</ptxt>
<torque>
<torqueitem>
<t-value1>42</t-value1>
<t-value2>428</t-value2>
</torqueitem>
</torque>
<figure>
<graphic graphicname="B155444" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HT000X_01_0002" proc-id="RM0550J___000084I00000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws to install the rear seat cushion hinge cover NO.2.</ptxt>
<figure>
<graphic graphicname="B162912" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HT000X_01_0003" proc-id="RM0550J___000084J00000">
<ptxt>Install Rear Seat Cushion Hinge Cover NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws and install the rear seat cushion hinge cover NO.1.</ptxt>
<figure>
<graphic graphicname="B162911" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030HT000X_01_0004">
<ptxt>Install Rear Seat Headrest Assembly</ptxt>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
