<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002P_S0005" variety="S0005">
<name>Meter</name>
<ttl id="1002P_S0005_746H3_T00C3" variety="T00C3">
<name>Combination Meter Assembly</name>
<para id="RM000002C0E001X" category="A" type-id="30014" name-id="630WF-00" from="200612">
<name>Installation</name>
<subpara id="RM000002C0E001X_02" type-id="01" category="01">
<s-1 id="RM000002C0E001X_02_0023" proc-id="RM0550J___0000A2300000">
<ptxt>Install Combination Meter Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors and temporarily install the combination meter assembly.</ptxt>
<figure>
<graphic graphicname="B167304" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<ptxt>When installing the combination meter assembly, be careful not to damage the instrument panel safety pad and combination meter assembly.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the combination meter assembly with the 4 screws.</ptxt>
<figure>
<graphic graphicname="B167303" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002C0E001X_02_0024" proc-id="RM0550J___0000A2400000">
<ptxt>Install Instrument Cluster Finish Panel Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 2 claws and 9 clips, and install the instrument cluster finish panel.</ptxt>
<figure>
<graphic graphicname="B167302" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the protective tape that was applied.</ptxt>
<figure>
<graphic graphicname="B167301" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>