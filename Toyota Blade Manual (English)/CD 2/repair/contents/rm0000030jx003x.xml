<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74XSQ_T00GI" variety="T00GI">
<name>E.F.I. Water Temperature Sensor (2GR-FE)</name>
<para id="RM0000030JX003X" category="A" type-id="80001" name-id="066Q7-00" from="200708">
<name>Removal</name>
<subpara id="RM0000030JX003X_01" type-id="01" category="01">
<s-1 id="RM0000030JX003X_01_0008" proc-id="RM0550J___0000DHU00000">
<ptxt>Remove V-bank Cover Sub-assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place both hands on the front of the cover and lift it upward to disengage the 2 front clips, then continue lifting upward to disengage the 1 rear clips, and remove the V-bank cover.</ptxt>
<figure>
<graphic graphicname="A132968" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Pulling up the front and rear at the same time may cause damage.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX003X_01_0010" proc-id="RM0550J___0000EUP00000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 9 clips and the radiator upper air deflector.</ptxt>
<figure>
<graphic graphicname="A177049" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX003X_01_0005">
<ptxt>Disconnect Battery Negative Terminal</ptxt>
</s-1>
<s-1 id="RM0000030JX003X_01_0007" proc-id="RM0550J___0000EUD00000">
<ptxt>Remove Battery
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Loosen the nut and disconnect the battery positive terminal. (*1)</ptxt>
<figure>
<graphic graphicname="A162912J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and nut, and remove the battery clamp.</ptxt>
</s2>
<s2>
<ptxt>Disconnect the current sensor connector.</ptxt>
<figure>
<graphic graphicname="A154930" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the insulator.</ptxt>
</s2>
<s2>
<ptxt>Remove the battery.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX003X_01_0013" proc-id="RM0550J___0000EUI00000">
<ptxt>Remove Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 6 bolts and 7 clips, and remove engine under cover No.1.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX003X_01_0006" proc-id="RM0550J___0000GWI00000">
<ptxt>Drain Coolant (Toyota Genuine Super Long Life Coolant)
</ptxt>
<content1 releasenbr="1">
<atten2>
<ptxt>To avoid the danger of being burned, do not remove the reservoir tank cap while the engine and radiator are still hot. Liquid and steam will spray out under pressure.</ptxt>
</atten2>
<s2>
<ptxt>Loosen the radiator drain cock plug.</ptxt>
</s2>
<s2>
<ptxt>Remove the reserve tank cap and drain the coolant.</ptxt>
</s2>
<s2>
<ptxt>Loosen the cylinder block drain cock plug and drain the coolant from the engine.</ptxt>
<figure>
<graphic graphicname="A179447J01" width="7.106578999in" height="4.7836529in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX003X_01_0002" proc-id="RM0550J___0000F4000000">
<ptxt>Remove Air Cleaner Cap w/ Air Cleaner Hose
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the air flow meter connector. (<sup>*</sup>1). </ptxt>
<figure>
<graphic graphicname="A176815J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect ventilation hose No.2. (<sup>*</sup>2).</ptxt>
</s2>
<s2>
<ptxt>Disconnect the hose band (<sup>*</sup>3)</ptxt>
</s2>
<s2>
<ptxt>Disengage the 3 clamps and remove the air cleaner cap w/ air cleaner hose.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX003X_01_0003" proc-id="RM0550J___0000EUG00000">
<ptxt>Remove Air Cleaner Case
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 bolts and clamp, and remove the air cleaner case.</ptxt>
<figure>
<graphic graphicname="A178719" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030JX003X_01_0012" proc-id="RM0550J___0000H2Y00000">
<ptxt>Remove E.F.I. Water Temperature Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the E.F.I. water temperature sensor connector.</ptxt>
<figure>
<graphic graphicname="A178152" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST, remove the E.F.I. water temperature sensor and gasket.</ptxt>
<figure>
<graphic graphicname="A178153" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09817-33190</s-number>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>