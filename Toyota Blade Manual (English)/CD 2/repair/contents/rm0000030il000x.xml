<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002X_S000H" variety="S000H">
<name>Body Exterior</name>
<ttl id="1002X_S000H_7460C_T00BP" variety="T00BP">
<name>Rear Bumper</name>
<para id="RM0000030IL000X" category="A" type-id="80002" name-id="8216C-00" from="200612">
<name>Disassembly</name>
<subpara id="RM0000030IL000X_01" type-id="01" category="01">
<s-1 id="RM0000030IL000X_01_0005" proc-id="RM0550J___0000AQ600000">
<ptxt>Remove Rear Bumper Guard</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a clip remover, remove the 3 clips.</ptxt>
<figure>
<graphic graphicname="B167162" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 6 outside molding retainers and rear bumper guard.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IL000X_01_0006" proc-id="RM0550J___0000AQ700000">
<ptxt>Remove Reflex Reflector Assembly RH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the screw and reflex reflector assembly RH.</ptxt>
<figure>
<graphic graphicname="B167164" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IL000X_01_0008" proc-id="RM0550J___0000BGT00000">
<ptxt>Remove Reflex Reflector Assembly LH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove it in the same way as for the RH side.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IL000X_01_0011" proc-id="RM0550J___0000C7500000">
<ptxt>Remove Rear Bumper Retainer Lower RH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the claw and remove the rear bumper retainer lower RH.</ptxt>
<figure>
<graphic graphicname="B168878" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IL000X_01_0010" proc-id="RM0550J___00000OP00000">
<ptxt>Remove License Plate Light Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a screwdriver with its tip wrapped in protective tape, disengage the claws and separate the license plate light assembly from the rear bumper assembly.</ptxt>
<figure>
<graphic graphicname="E147015" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connector and remove the license plate light assembly.</ptxt>
<figure>
<graphic graphicname="E147016" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000030IL000X_01_0003" proc-id="RM0550J___00008F500000">
<ptxt>Remove Rear Bumper Retainer Upper LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the screw.</ptxt>
<figure>
<graphic graphicname="B167166" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 claws and remove the rear bumper retainer UPR LH.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IL000X_01_0004" proc-id="RM0550J___00008F600000">
<ptxt>Remove Rear Bumper Retainer Upper RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove it in the same way as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM0000030IL000X_01_0001" proc-id="RM0550J___00008F300000">
<ptxt>Remove Rear Bumper Side Retainer LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws.</ptxt>
<figure>
<graphic graphicname="B167165" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 2 claws and remove the rear bumper side retainer LH.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000030IL000X_01_0002" proc-id="RM0550J___00008F400000">
<ptxt>Remove Rear Bumper Side Retainer RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Remove it in the same way as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>