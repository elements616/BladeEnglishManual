<s-1 id="RM000002BNY003X_01_0001" proc-id="RM0550J___0000G2O00000">
<ptxt>Inspect Automatic Transmission Temperature Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the automatic transmission temperature sensor connector.</ptxt>
</s2>
<s2>
<ptxt>Check that the connector case and terminals of the automatic transmission temperature sensor are not deformed or damaged.</ptxt>
</s2>
<s2>
<ptxt>Using SST (Toyota electrical tester), inspect terminals 2 (THO1) and 1 (E2) of the automatic transmission temperature sensor.</ptxt>
<figure>
<graphic graphicname="C133224J04" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.65in"/>
<colspec colname="COLSPEC0" colwidth="1.24in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>2(THO1) - (E2)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Fluid temperature 10 °C</ptxt>
</entry>
<entry valign="middle">
<ptxt>5.8 to 7.1</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>2(THO1) - (E2)</ptxt>
</entry>
