<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001C_S000C" variety="S000C">
<name>Audio &amp; Visual</name>
<ttl id="1001C_S000C_742AF_T002Q" variety="T002Q">
<name>Speaker Assembly Rear</name>
<para id="RM000002BZS001X" category="A" type-id="30014" name-id="641JZ-00" from="200612">
<name>Installation</name>
<subpara id="RM000002BZS001X_01" type-id="01" category="01">
<s-1 id="RM000002BZS001X_01_0001" proc-id="RM0550J___000018S00000">
<ptxt>Install Speaker Assembly Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the speaker assembly RR to the rear door with 3 new rivets.</ptxt>
<figure>
<graphic graphicname="E137091" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002BZS001X_01_0011" proc-id="RM0550J___00009UL00000">
<ptxt>Install Rear Door Trim Board Sub-assembly RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 claws to install the rear door trim board RH to the rear door glass weatherstrip inner RH.</ptxt>
<figure>
<graphic graphicname="B153656" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 9 clips to install the rear door trim board RH to the rear door panel.</ptxt>
</s2>
<s2>
<ptxt>Install the 3 screws.</ptxt>
<figure>
<graphic graphicname="B157313" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002BZS001X_01_0012" proc-id="RM0550J___00009UM00000">
<ptxt>Install Door Assist Grip Cover RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws to install the door assist grip cover RH to the rear door trim board RH.</ptxt>
<figure>
<graphic graphicname="B153655" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000002BZS001X_01_0013" proc-id="RM0550J___00009UN00000">
<ptxt>Install Rear Door Inside Handle Bezel RH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 3 claws to install the rear door inside handle bezel RH to the rear door trim board RH.</ptxt>
<figure>
<graphic graphicname="B153653" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>