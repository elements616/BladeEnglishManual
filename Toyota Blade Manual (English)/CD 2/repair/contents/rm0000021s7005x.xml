<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="04">
<name>Driveline/Axle</name>
<section id="1002H_S000Z" variety="S000Z">
<name>Axle</name>
<ttl id="1002H_S000Z_744UD_T008S" variety="T008S">
<name>Front Axle Hub Bolt LH</name>
<para id="RM0000021S7005X" category="A" type-id="30014" name-id="380G1-00" from="200612">
<name>Installation</name>
<subpara id="RM0000021S7005X_01" type-id="01" category="01">
<s-1 id="RM0000021S7005X_01_0004" proc-id="RM0550J___00004VU00000">
<ptxt>Install Front Axle Hub Bolt LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install a new hub bolt to the front axle hub and, with a plate washer, install the hub bolt by tightening a nut (M12×P1.5mm).</ptxt>
<figure>
<graphic graphicname="C147122J02" width="2.775699831in" height="2.775699831in"/>
</figure>
<atten3>
<ptxt>Install the hub nut to prevent damage to the hub bolt.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM0000021S7005X_01_0007" proc-id="RM0550J___00005G000000">
<ptxt>Install Front Disc
</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C150099J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Align the matchmarks on the disc and axle hub, and install the disc.</ptxt>
<atten3>
<ptxt>When replacing the disc, select the installation position where the disc runout is minimal.</ptxt>
</atten3>
</s2>
</content1></s-1>
<s-1 id="RM0000021S7005X_01_0006" proc-id="RM0550J___00004V400000">
<ptxt>Install Front Disc Brake Caliper Assembly LH
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the front disc brake caliper assembly LH to the steering knuckle with the 2 bolts.</ptxt>
<figure>
<graphic graphicname="C130484" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>107</t-value1>
<t-value2>1090</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM0000021S7005X_01_0003" proc-id="RM0550J___00004VT00000">
<ptxt>Install Front Tire</ptxt>
<content1 releasenbr="1">
<torque>
<torqueitem>
<t-value1>103</t-value1>
<t-value2>1050</t-value2>
</torqueitem>
</torque>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>