<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1002B_S001H" variety="S001H">
<name>Automatic Transaxle</name>
<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000001J7A00GX" category="C" type-id="801F6" name-id="261II-00" from="200708">
<dtccode>U0100/A2</dtccode>
<dtcname>Engine ECU Communication Malfunction</dtcname>
<subpara id="RM000001J7A00GX_04" type-id="33" category="03" proc-id="RM0550J___0000FUL00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The transmission control computer sends and receives data to and from the engine control computer via local CAN communication.</ptxt>
<ptxt>The transmission control computer outputs a DTC when a communication malfunction with the engine control computer occurs.</ptxt>
<ptxt>Since the transmission control computer responds with DTCs via the engine control computer over local CAN communication, this code is not output while communication is lost. (If the DTC can be read, it is a past malfunction output, and the communication line can be considered normal now.)</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.25in"/>
<colspec colname="COL2" colwidth="3.07in"/>
<colspec colname="COL3" colwidth="2.76in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U0100/A2<sup>*</sup>1</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>IG ON</ptxt>
</item>
<item>
<ptxt>Communication lost between engine control computer and transmission control computer</ptxt>
</item>
<item>
<ptxt>1.25 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wire harness or connector</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
<item>
<ptxt>Engine Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten4>
<ptxt>
<sup>*</sup>1...A2 (lamp code) indicates that the tens digit of the conventional 2-digit code blinks 10 times and the ones digit blinks 2 times.</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM000001J7A00GX_05" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000001J7A00GX_06" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000001J7A00GX_06_0004" proc-id="RM0550J___0000FUM00000">
<scantool type="1"/>
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check the DTCs of the EFI system and check whether EFI ECU power supply malfunction, internal malfunction and CAN communication malfunction codes (main CAN bus side communication malfunction) are output.</ptxt>
<spec>
<title>Result</title>
<table pgwide="1">
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="5.28in"/>
<colspec colname="COL2" colwidth="1.80in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>EFI ECU outputs (stores) only U0101 (lost communication with ECT ECU)</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>EFI ECU outputs (stores) power supply malfunction, internal malfunction or main CAN side communication malfunction codes</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>EFI system DTC normal</ptxt>
</entry>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000001J7A00GX_06_0006" fin="false">A</down>
<right ref="RM000001J7A00GX_06_0005" fin="true">B</right>
<right ref="RM000001J7A00GX_06_0007" fin="false">C</right>
</res>
</testgrp>
<testgrp id="RM000001J7A00GX_06_0006" proc-id="RM0550J___0000FUN00000">
<testtitle>Inspect Wire Harness (Transmission Control Computer - Engine Control Computer)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the transmission control computer connector.</ptxt>
</test1>
<test1>
<ptxt>Disconnect connector A of the engine control computer.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<figure>
<graphic graphicname="A137453J04" width="2.775699831in" height="3.779676365in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.17in"/>
<colspec colname="COL2" colwidth="1.04in"/>
<colspec colname="COL3" colwidth="0.92in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A2(CAN+) - 6(CAN+)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>A1(CAN-) - 7(CAN-)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.17in"/>
<colspec colname="COL2" colwidth="1.04in"/>
<colspec colname="COL3" colwidth="0.92in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A2 (CAN+) and 6 (CAN+) - Other terminals or body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>A1 (CAN-) and 7 (CAN-) - Other terminals or body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000001J7A00GX_06_0009" fin="false">OK</down>
<right ref="RM000001J7A00GX_06_0010" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000001J7A00GX_06_0009" proc-id="RM0550J___0000FUO00000">
<testtitle>Replace Engine Control Computer</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the engine control computer. (see <xref label="Seep01" href="RM000002ADB004X"/>)</ptxt>
</test1>
<test1>
<ptxt>Complete each registration procedure.</ptxt>
</test1>
