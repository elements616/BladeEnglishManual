<testgrp id="RM000001J7A00GX_06_0012" proc-id="RM0550J___0000FUP00000">
<testtitle>Check DTC Output</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check for DTCs. (see <xref label="Seep01" href="RM000000AW201LX"/>)</ptxt>
