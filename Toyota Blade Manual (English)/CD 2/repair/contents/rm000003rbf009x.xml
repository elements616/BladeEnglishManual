<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1001Y_S000S" variety="S000S">
<name>CVT</name>
<ttl id="1001Y_S000S_744HD_T007Y" variety="T007Y">
<name>CVT System [Super CVT-i] (K112/K112F)</name>
<para id="RM000003RBF009X" category="C" type-id="8048E" name-id="CV09G-07" from="200912">
<dtccode>P1750/17</dtccode>
<dtcname>Brake ECU Malfunction</dtcname>
<subpara id="RM000003RBF009X_01" type-id="33" category="03" proc-id="RM0550J___0000I8600000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>When the engine control computer receives a VSC system malfunction signal from the brake actuator assembly (skid control computer), it stores P1750/17.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.06in"/>
<colspec colname="COL2" colwidth="2.83in"/>
<colspec colname="COL3" colwidth="3.19in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC NO.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
<item>
<ptxt>Malfunction Duration</ptxt>
</item>
<item>
<ptxt>Others</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P1750/17</ptxt>
</entry>
<entry>
<list1 type="ordered">
<item>
<ptxt>Always</ptxt>
</item>
<item>
<ptxt>Malfunction signal input from brake actuator assembly (skid control computer)</ptxt>
</item>
<item>
<ptxt>Continuously for 3 seconds or more</ptxt>
</item>
<item>
<ptxt>1 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>VSC system</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000003RBF009X_02" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000003RBF009X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000003RBF009X_03_0002" proc-id="RM0550J___0000I8700000">
<scantool type="1"/>
<testtitle>Check DTC (VSC System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn IG ON.</ptxt>
</test1>
<test1>
<ptxt>Following the SST (TaSCAN) screen display, read the VSC system DTCs. (see <xref label="Seep01" href="RM00000060000PX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>VSC system DTCs are not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>VSC system DTCs are output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000003RBF009X_03_0003" fin="true">A</down>
<right ref="RM000003RBF009X_03_0001" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000003RBF009X_03_0001">
<testtitle>Go to VSC system troubleshooting<xref label="Seep01" href="RM000000OUR00SX"/>
</testtitle>
</testgrp>
<testgrp id="RM000003RBF009X_03_0003">
<testtitle>Go to Problem Symptom Simulation Method<xref label="Seep01" href="RM000000ABY07EX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>