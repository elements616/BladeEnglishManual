<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="05">
<name>Suspension</name>
<section id="1002I_S0016" variety="S0016">
<name>Suspension</name>
<ttl id="1002I_S0016_746SJ_T00D6" variety="T00D6">
<name>Stabilizer Bar Rear (FF)</name>
<para id="RM000001X46004X" category="A" type-id="80001" name-id="421GY-00" from="200612">
<name>Removal</name>
<subpara id="RM000001X46004X_02" type-id="01" category="01">
<s-1 id="RM000001X46004X_02_0090" proc-id="RM0550J___0000AYY00000">
<ptxt>Remove Rear Suspension Member Brace LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 bolts and remove the rear suspension member brace LH.</ptxt>
<figure>
<graphic graphicname="C160962" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X46004X_02_0091" proc-id="RM0550J___0000AYZ00000">
<ptxt>Remove Rear Stabilizer Link Assembly LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the nut and remove the rear stabilizer cushion.</ptxt>
<figure>
<graphic graphicname="C160800" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the nut and remove the rear stabilizer link assembly LH.</ptxt>
<figure>
<graphic graphicname="C160801" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Using socket hexagon wrench 6, hold the stud bolt so that it does not spin.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X46004X_02_0092" proc-id="RM0550J___0000AZ000000">
<ptxt>Remove Rear Stabilizer Link Assembly RH</ptxt>
<content1 releasenbr="1">
<atten4>
<ptxt>Use the same procedure for the RH side as for the LH side.</ptxt>
</atten4>
</content1>
</s-1>
<s-1 id="RM000001X46004X_02_0093" proc-id="RM0550J___0000AZ100000">
<ptxt>Remove Stabilizer Bar Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and the 2 rear stabilizer bar brackets No.1.</ptxt>
<figure>
<graphic graphicname="C160802" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the rear stabilizer bar.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000001X46004X_02_0094" proc-id="RM0550J___0000AZ200000">
<ptxt>Remove Stabilizer Bushing Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 rear stabilizer bushings from the rear stabilizer bar.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>