<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1000N_S0010" variety="S0010">
<name>Brake</name>
<ttl id="1000N_S0010_744Y2_T009N" variety="T009N">
<name>Brake Pedal Support Assembly</name>
<para id="RM000000CHZ00EX" category="A" type-id="80002" name-id="4510D-00" from="200612">
<name>Disassembly</name>
<subpara id="RM000000CHZ00EX_02" type-id="01" category="01">
<s-1 id="RM000000CHZ00EX_02_0005" proc-id="RM0550J___00005E700000">
<ptxt>Remove Stop Light Switch Assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C132725J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Turn the stop light switch assembly 1/4 turn and remove it.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CHZ00EX_02_0006" proc-id="RM0550J___00005E800000">
<ptxt>Remove Stop Light Switch Mounting Adjuster</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the adjuster from the brake pedal support.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CHZ00EX_02_0007" proc-id="RM0550J___00005E900000">
<ptxt>Remove Brake Pedal Sub-assembly</ptxt>
<content1 releasenbr="1">
<figure>
<graphic graphicname="C151110" width="2.775699831in" height="1.771723296in"/>
</figure>
<s2>
<ptxt>Remove the bolt and nut, and remove the brake pedal from the brake pedal support.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CHZ00EX_02_0008" proc-id="RM0550J___00005EA00000">
<ptxt>Remove Brake Pedal Bush</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 brake pedal bushes from the brake pedal.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000CHZ00EX_02_0009" proc-id="RM0550J___00005EB00000">
<ptxt>Remove Brake Pedal Pad</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the brake pedal pad.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>