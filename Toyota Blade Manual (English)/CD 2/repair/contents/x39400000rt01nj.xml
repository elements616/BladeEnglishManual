<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74WIJ_T00FO" variety="T00FO">
<name>EFI System (2GR-FE)</name>
<para id="X39400000RT01NJ" category="J" type-id="300OF" name-id="066OS-00" from="200708">
<dtccode/>
<dtcname>ECU Backup Power Source Circuit</dtcname>
<subpara id="X39400000RT01NJ_10" type-id="31" category="03" proc-id="RM0550J___0000DEL00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<list1 type="nonmark">
<item>
<ptxt>Battery power is supplied to the BATT terminal of the engine control computer even when the IG is turned OFF. This is used for storing DTCs and data when a malfunction occurs.</ptxt>
</item>
</list1>
</content5>
</subpara>
<subpara id="X39400000RT01NJ_11" type-id="32" category="03" proc-id="RM0550J___0000DEM00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="A136704J05" width="7.106578999in" height="3.779676365in"/>
</figure>
</content5>
</subpara>
<subpara id="X39400000RT01NJ_12" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="X39400000RT01NJ_13" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="X39400000RT01NJ_13_0002" proc-id="RM0550J___0000DEN00000">
<testtitle>Inspect Fuse (EFI Fuse)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="A154429J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<test1>
<ptxt>Remove the EFI MAIN fuse from the engine room R/B.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>EFI MAIN fuse</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000RT01NJ_13_0003" fin="false">OK</down>
<right ref="X39400000RT01NJ_13_0006" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X39400000RT01NJ_13_0003" proc-id="RM0550J___0000DEO00000">
<testtitle>Inspect Wire Harness or Connector (Engine Control Computer - Engine Room R/B)</testtitle>
<content6 releasenbr="1">
<atten4>
<ptxt>For the wire harness and connector inspection procedure and precautions, see <xref label="Seep02" href="RM0000005D702RX"/></ptxt>
</atten4>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="A154428J02" width="7.106578999in" height="3.779676365in"/>
</figure>
<test1>
<ptxt>Disconnect the battery negative terminal.</ptxt>
</test1>
<test1>
<ptxt>Disconnect connector B of the engine control computer.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals. (see <xref href="X39400000QV01SD" label="Seep01"/> for Terminals of ECU)</ptxt>
<atten3>
<ptxt>When measuring by applying a tester probe, etc., be careful not to press too hard, as this may damage the holder.</ptxt>
</atten3>
<spec>
<title>Resistance</title>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="4.83in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<colspec colname="COL3" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B20 (BATT) - Terminal 2</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>B20 (BATT) and terminal 2 - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="X39400000RT01NJ_13_0004" fin="true">OK</down>
<right ref="X39400000RT01NJ_13_0007" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="X39400000RT01NJ_13_0004">
<testtitle>Inspect ECU Power Source System<xref label="Seep01" href="X362000006X016J"/>
</testtitle>
</testgrp>
<testgrp id="X39400000RT01NJ_13_0006">
<testtitle>Replace EFI MAIN Fuse</testtitle>
</testgrp>
<testgrp id="X39400000RT01NJ_13_0007">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
