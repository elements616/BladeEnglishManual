</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1(+B) - 8(GND)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000032J7000X_04_0007" fin="true">OK</down>
<right ref="RM0000032J7000X_04_0009" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000032J7000X_04_0007">
<testtitle>Replace Engine Control Computer<xref label="Seep01" href="RM000002ADG003X"/>
</testtitle>
