<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="09">
<name>SRS Airbag &amp; Seat Belt</name>
<section id="1000Z_S001D" variety="S001D">
<name>Seat Belt</name>
<ttl id="1000Z_S001D_746RN_T00CY" variety="T00CY">
<name>Rear Seat Belt Assembly Inner w/ (Center) LH</name>
<para id="RM0000020EL003X" category="A" type-id="80001" name-id="5610C-00" from="200612">
<name>Removal</name>
<subpara id="RM0000020EL003X_02" type-id="01" category="01">
<s-1 id="RM0000020EL003X_02_0009" proc-id="RM0550J___000081T00000">
<ptxt>Remove Rear Seat Cushion Hinge Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the rear seat cushion hinge cover NO.1.</ptxt>
<figure>
<graphic graphicname="B161942" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020EL003X_02_0010" proc-id="RM0550J___000081U00000">
<ptxt>Remove Rear Seat Cushion Hinge Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the rear seat cushion hinge cover NO.2.</ptxt>
<figure>
<graphic graphicname="B162910" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020EL003X_02_0004" proc-id="RM0550J___0000AQU00000">
<ptxt>Disconnect Rear Seat Cushion Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts.</ptxt>
<figure>
<graphic graphicname="B156984" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Flip up the rear seat cushion assembly as shown in the illustration.</ptxt>
<figure>
<graphic graphicname="B156990" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020EL003X_02_0006" proc-id="RM0550J___0000AQV00000">
<ptxt>Remove Rear Seat Belt Assembly Inner (w/ Center) LH</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the bolt and remove the rear seat inner belt assembly (center) LH.</ptxt>
<figure>
<graphic graphicname="B156985" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>