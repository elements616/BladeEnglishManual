<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000MGV00OX_06_0010" fin="false">OK</down>
<right ref="RM000000MGV00OX_06_0012" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000MGV00OX_06_0010" proc-id="RM0550J___0000A4A00000">
<testtitle>Replace with Known Good Remote Start</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Replace the remote start with a normal one.</ptxt>
</test1>
<atten4>
<ptxt>After replacing the remote start, ID registration of the remote start is necessary.</ptxt>
</atten4>
<test1>
<ptxt>Check that the engine can be started with the remote start.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Engine can be started with remote start</ptxt>
</specitem>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000MGV00OX_06_0008" fin="true">OK</down>
<right ref="RM000000MGV00OX_06_0013" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000000MGV00OX_06_0008">
<testtitle>Complete</testtitle>
</testgrp>
<testgrp id="RM000000MGV00OX_06_0012">
<testtitle>Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM000000MGV00OX_06_0013">
<testtitle>Replace Smart Key Computer Assembly</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
