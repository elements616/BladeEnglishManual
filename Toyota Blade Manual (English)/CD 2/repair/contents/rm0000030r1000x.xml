<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002O_S0008" variety="S0008">
<name>Engine Immobiliser</name>
<ttl id="1002O_S0008_741KM_T000P" variety="T000P">
<name>Engine Immobiliser System</name>
<para id="RM0000030R1000X" category="J" type-id="303RQ" name-id="580MA-00" from="200612">
<dtccode/>
<dtcname>Security Indicator Does Not Blink</dtcname>
<subpara id="RM0000030R1000X_01" type-id="31" category="03" proc-id="RM0550J___0000BDD00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The certification ECU (smart computer assembly) blinks the security indicator when the immobiliser function is set.</ptxt>
</content5>
</subpara>
<subpara id="RM0000030R1000X_02" type-id="32" category="03" proc-id="RM0550J___0000BDE00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="B162453J02" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM0000030R1000X_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM0000030R1000X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000030R1000X_04_0001" proc-id="RM0550J___0000BDF00000">
<testtitle>Inspect Smart Key Computer Assembly</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="B162882J03" width="2.775699831in" height="1.771723296in"/>
</figure>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage of the terminal from the back side of the certification ECU (smart key computer assembly) connector.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.39in"/>
<colspec colname="COL2" colwidth="1.64in"/>
<colspec colname="COL3" colwidth="1.1in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>2 (IND) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG OFF</ptxt>
<ptxt>(Immobiliser Set)</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000030R1000X_04_0002" fin="false">OK</down>
<right ref="RM0000030R1000X_04_0004" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000030R1000X_04_0002" proc-id="RM0550J___0000BDG00000">
<testtitle>Inspect Wire Harness and Connector (Air Conditioner Control Assembly - Smart Key Computer Assembly)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="B162883J03" width="2.775699831in" height="4.7836529in"/>
</figure>
<test1>
<ptxt>Disconnect the air conditioner control assembly (security indicator) and certification ECU (smart key computer assembly) connectors.</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the vehicle side wire harness connectors.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.00in"/>
<colspec colname="COL2" colwidth="1.04in"/>
<colspec colname="COL3" colwidth="1.09in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>6(LP) - 2(IND)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<table>
<title>Resistance</title>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.00in"/>
<colspec colname="COL2" colwidth="1.01in"/>
<colspec colname="COL3" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>6 (LP) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>5 (GND) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000030R1000X_04_0003" fin="true">OK</down>
<right ref="RM0000030R1000X_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000030R1000X_04_0003">
<testtitle>Replace Air Conditioner Control Assembly<xref label="Seep01" href="RM000002143002X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000030R1000X_04_0004">
<testtitle>Replace Smart Key Computer Assembly</testtitle>
</testgrp>
<testgrp id="RM0000030R1000X_04_0005">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>