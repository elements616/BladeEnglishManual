<tmc-service-inc>
<pub id="RM0550J">
<servcat id="08">
<name>Heater &amp; Air Conditioner/Ventilation</name>
<section id="1002K_S000B" variety="S000B">
<name>Air Conditioner</name>
<ttl id="1002K_S000B_74X5R_T00G5" variety="T00G5">
<name>Cooler Condenser Assembly (Engine Model 2GR-FE)</name>
<para id="RM00000213U009X" category="A" type-id="8000E" name-id="522IU-00" from="200708">
<name>Reassembly</name>
<subpara id="RM00000213U009X_01" type-id="01" category="01">
<s-1 id="RM00000213U009X_01_0001" proc-id="RM0550J___0000DFY00000">
<ptxt>Install Cooler Dryer</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using needle-nose pliers, insert the cooler dryer into the modulator.</ptxt>
<figure>
<graphic graphicname="E145287" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Apply sufficient compressor oil (ND-OIL8) to the O-ring.</ptxt>
<figure>
<graphic graphicname="E148443" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a straight hexagon wrench 14mm, install the cap to the modulator.</ptxt>
<figure>
<graphic graphicname="E145288J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000213U009X_01_0002" proc-id="RM0550J___0000DFZ00000">
<ptxt>Install Cooler Condenser Cushion NO.1</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the 4 cooler condenser cushions NO.1.</ptxt>
<figure>
<graphic graphicname="E143925" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>