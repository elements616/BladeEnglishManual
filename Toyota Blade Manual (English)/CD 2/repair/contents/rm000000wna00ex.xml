<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1000O_S0019" variety="S0019">
<name>Parking Brake</name>
<ttl id="1000O_S0019_745H0_T00B3" variety="T00B3">
<name>Parking Brake</name>
<para id="RM000000WNA00EX" category="N" type-id="3000G" name-id="460IJ-00" from="200612" to="200912">
<name>Adjustment</name>
<subpara id="RM000000WNA00EX_03" type-id="11" category="10" proc-id="RM0550J___000064V00000">
<content3 releasenbr="1">
<atten3>
<ptxt>Before adjusting the parking brake, complete bleeding of the brake fluid.</ptxt>
</atten3>
</content3>
</subpara>
<subpara id="RM000000WNA00EX_04" type-id="01" category="01">
<s-1 id="RM000000WNA00EX_04_0051" proc-id="RM0550J___000064W00000">
<ptxt>Inspect Parking Brake Lever Travel</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Pull the parking brake lever all the way once with force.</ptxt>
</s2>
<s2>
<ptxt>Release the parking brake lever.</ptxt>
</s2>
<s2>
<ptxt>Slowly pull the parking brake lever and count the number of clicks.</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt>5-8 notches [Operating force 200N{20kgf}]</ptxt>
</specitem>
</spec>
</s2>
</content1>
</s-1>
<s-1 id="RM000000WNA00EX_04_0060" proc-id="RM0550J___0000ABV00000">
<ptxt>Remove Console Box Cover Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a thin flat-tip screwdriver wrapped with protective tape, disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B163189J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Place your hand at the position shown in the illustration and disengage the 2 clips.</ptxt>
<figure>
<graphic graphicname="B156562" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the connectors and remove the console box rear cover.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000000WNA00EX_04_0061" proc-id="RM0550J___0000ABX00000">
<ptxt>Remove Console Box Carpet
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the console box carpet.</ptxt>
<figure>
<graphic graphicname="B156554" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000000WNA00EX_04_0062" proc-id="RM0550J___0000ABZ00000">
<ptxt>Remove Console Box Assembly Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and 2 screws.</ptxt>
<figure>
<graphic graphicname="B167309" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Disengage the 4 claws and remove the console box assembly RR.</ptxt>
<figure>
<graphic graphicname="B167310" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000000WNA00EX_04_0052" proc-id="RM0550J___000064X00000">
<ptxt>Adjust Parking Brake Lever Travel</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Fully release the parking brake lever.</ptxt>
</s2>
<s2>
<ptxt>Loosen the lock nut and adjusting nut at the parking brake lever, and fully loosen the parking brake cable.</ptxt>
</s2>
<s2>
<ptxt>With the engine OFF, depress the brake pedal firmly 3-5 times.</ptxt>
</s2>
<s2>
<ptxt>Turn the adjusting nut to adjust the lever travel to the standard value.</ptxt>
<figure>
<graphic graphicname="C163101J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>Standard</title>
<specitem>
<ptxt>5-8 notches [Operating force 200N{20kgf}]</ptxt>
</specitem>
</spec>
</s2>
<s2>
<ptxt>Using a wrench, hold the adjusting nut and tighten the lock nut.</ptxt>
<torque>
<torqueitem>
<t-value1>6.0</t-value1>
<t-value2>61</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Operate the parking brake lever 3-4 times, then check the lever travel.</ptxt>
</s2>
<s2>
<ptxt>Check that the parking brake does not drag.</ptxt>
</s2>
<s2>
<ptxt>When the parking brake lever is released, check that the clearance between the operating lever and the stopper of the rear disc brake cylinder is within the standard range.</ptxt>
<figure>
<graphic graphicname="C155527J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>Standard</title>
<specitem>
<ptxt>0-0.5mm</ptxt>
</specitem>
</spec>
</s2>
<s2>
<ptxt>Check that the brake warning light comes on when the parking brake lever is operated.</ptxt>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>The light must come on reliably at the 1 notch from the start of pulling.</ptxt>
</specitem>
</spec>
</s2>
</content1>
</s-1>
<s-1 id="RM000000WNA00EX_04_0063" proc-id="RM0550J___0000ACF00000">
<ptxt>Install Console Box Assembly Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 4 claws.</ptxt>
<figure>
<graphic graphicname="B167310" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the console box assembly RR with the 4 bolts and 2 screws.</ptxt>
<figure>
<graphic graphicname="B167309" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000000WNA00EX_04_0064" proc-id="RM0550J___0000ACH00000">
<ptxt>Install Console Box Carpet
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the console box carpet.</ptxt>
<figure>
<graphic graphicname="B156554" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000000WNA00EX_04_0065" proc-id="RM0550J___0000ACI00000">
<ptxt>Install Console Box Cover Rear
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 4 clips to install the console box rear cover.</ptxt>
<figure>
<graphic graphicname="B162870" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>