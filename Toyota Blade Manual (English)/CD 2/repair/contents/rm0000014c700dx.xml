<entry colname="C02" valign="middle" align="left">
<list1 type="ordered">
<item>
<ptxt>Diagnosis is performed when all of the following conditions are met</ptxt>
</item>
<list2 type="ordered">
<item>
<ptxt>After engine warm-up (coolant temperature 95 °C or higher)</ptxt>
</item>
<item>
<ptxt>Oxygen sensor heater operating time 22 seconds or more</ptxt>
</item>
</list2>
<item>
<ptxt>Detected when either of the following conditions is met</ptxt>
</item>
<list2 type="ordered">
<item>
<ptxt>No rich signal is input even once during feedback (output voltage never reaches 0.6 V or higher)</ptxt>
</item>
<item>
<ptxt>No lean signal is input even once during feedback (output voltage never drops below 0.45 V)</ptxt>
</item>
</list2>
<item>
<ptxt>480 seconds</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
