<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM000003X5000EX" category="C" type-id="804LZ" name-id="NS4M0-02" from="200912">
<dtccode>B15BB</dtccode>
<dtcname>USB-BOX malfunction</dtcname>
<subpara id="RM000003X5000EX_01" type-id="33" category="03" proc-id="RM0550J___0000IJV00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when a malfunction occurs in the multimedia interface computer.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.42in"/>
<colspec colname="COL2" colwidth="2.83in"/>
<colspec colname="COL3" colwidth="2.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Diagnostic Trouble Code (DTC)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Point</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>B15BB</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>When a system microcomputer malfunction is detected</ptxt>
</item>
<item>
<ptxt>When a media I/F microcomputer malfunction is detected</ptxt>
</item>
<item>
<ptxt>When a CD-LSI malfunction is detected</ptxt>
</item>
<item>
<ptxt>Internal power source malfunction</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>A USB memory or "iPod"</ptxt>
</item>
<item>
<ptxt>Wire Harness or Connector</ptxt>
</item>
<item>
<ptxt>Stereo Jack Adapter Assembly NO.1</ptxt>
</item>
<item>
<ptxt>Multimedia Interface ECU</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000003X5000EX_04" type-id="32" category="03" proc-id="RM0550J___0000IK100000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E169906J09" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM000003X5000EX_02" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000003X5000EX_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000003X5000EX_03_0011" proc-id="RM0550J___0000IK000000">
<testtitle>Replace USB Memory or "iPod"</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Disconnect the USB memory or "iPod" from stereo jack adapter assembly NO.1.</ptxt>
</test1>
<test1>
<ptxt>Turn the ignition OFF → ACC ON.</ptxt>
<atten4>
<ptxt>When connecting a different USB memory or "iPod", the ignition must be turned OFF for the vehicle to recognize the connected device.</ptxt>
</atten4>
</test1>
<test1>
<ptxt>Connect a normal USB memory or "iPod" to stereo jack adapter assembly NO.1.</ptxt>
<atten4>
<list1 type="unordered">
<item>
<ptxt>If using a USB memory, check with a different USB memory.</ptxt>
</item>
<item>
<ptxt>If using an "iPod", check with a different "iPod".</ptxt>
</item>
<item>
<ptxt>For supported formats and versions, refer to <xref label="Seep01" href="RM00000014J044X"/></ptxt>
</item>
</list1>
</atten4>
</test1>
</content6>
<res>
<down ref="RM000003X5000EX_03_0001" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000003X5000EX_03_0001" proc-id="RM0550J___0000IJW00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM000003X5000EX_03_0002" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000003X5000EX_03_0002" proc-id="RM0550J___0000IJX00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.99in"/>
<colspec colname="COL2" colwidth="1.14in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>No code output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM000003X5000EX_03_0004" fin="false">A</down>
<right ref="RM000003X5000EX_03_0006" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000003X5000EX_03_0004" proc-id="RM0550J___0000IJY00000">
<testtitle>Inspect Multimedia Interface Computer (UPO, UESG)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation</ptxt>
<figure>
<graphic graphicname="E183264J02" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Disconnect the stereo jack adapter assembly NO.1 connector.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Inspect Resistance and Voltage</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), with the multimedia interface computer connector connected, measure the voltage between the terminals of the stereo jack adapter assembly NO.1 vehicle side wire harness connector.</ptxt>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1(UPI) - 4(UJSG)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ACC ON</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>5 V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry>
<ptxt>Front view of wire harness connector</ptxt>
<ptxt>(Stereo Jack Adapter Assembly NO.1)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM000003X5000EX_03_0010" fin="true">OK</down>
<right ref="RM000003X5000EX_03_0008" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000003X5000EX_03_0008" proc-id="RM0550J___0000IJZ00000">
<testtitle>Inspect Wire Harness and Connector (Multimedia Interface Computer - Stereo Jack Adapter Assembly NO.1)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation</ptxt>
<test2>
<ptxt>Disconnect connector C of the multimedia interface computer.</ptxt>
</test2>
<test2>
<ptxt>Disconnect the stereo jack adapter assembly NO.1 connector.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between each terminal of the vehicle wire harness connectors between the multimedia interface ECU and stereo jack adapter assembly NO.1.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C4(UPO) - 1(UPI)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>C1(UESG) - 4(UJSG)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between each terminal of the stereo jack adapter assembly NO.1 vehicle side wire harness connector and body ground.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1 (UPI) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>4 (UJSG) - Body ground</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000003X5000EX_03_0005" fin="true">OK</down>
<right ref="RM000003X5000EX_03_0009" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM000003X5000EX_03_0005">
<testtitle>Replace Multimedia Interface Computer<xref label="Seep01" href="RM000004AZJ000X"/>
</testtitle>
</testgrp>
<testgrp id="RM000003X5000EX_03_0006">
<testtitle>Defective USB memory or "iPod"</testtitle>
</testgrp>
<testgrp id="RM000003X5000EX_03_0010">
<testtitle>Replace Stereo Jack Adapter Assembly NO.1<xref label="Seep01" href="RM000004AZM000X"/>
</testtitle>
</testgrp>
<testgrp id="RM000003X5000EX_03_0009">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>