<ttl id="1002T_S000D_742AR_T0032" variety="T0032">
<name>Power Outlet Socket Assembly</name>
<para id="RM000000Q8Z008X" category="A" type-id="30014" name-id="7326W-01" from="200912">
<name>Installation</name>
<subpara id="RM000000Q8Z008X_01" type-id="01" category="01">
<s-1 id="RM000000Q8Z008X_01_0022" proc-id="RM0550J___00001EY00001">
<ptxt>Install Power Outlet Socket Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Align the guide of a new power outlet socket cover with the cutout of box panel No.2.</ptxt>
<figure>
<graphic graphicname="E207576J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 claws and install the power outlet socket cover.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000Q8Z008X_01_0079" proc-id="RM0550J___0000EX100001">
<ptxt>Install Power Point Socket Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Align the guide of the power point socket assembly with the cutout of the power outlet socket cover.</ptxt>
<figure>
<graphic graphicname="E207577J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 2 claws and install the power point socket assembly.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000Q8Z008X_01_0078" proc-id="RM0550J___0000IMB00000">
<ptxt>Install Box Panel NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connectors.</ptxt>
</s2>
<s2>
<ptxt>Engage the 2 claws and 4 clips to install box panel No.2.</ptxt>
<figure>
<graphic graphicname="B236932" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
