<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="03">
<name>Transmission/Transaxle</name>
<section id="1001Y_S000S" variety="S000S">
<name>CVT</name>
<ttl id="1001Y_S000S_744H1_T007M" variety="T007M">
<name>Shift Lock Control Unit Assembly</name>
<para id="RM0000020U8007X" category="A" type-id="80002" name-id="32251-00" from="200612" to="200912">
<name>Disassembly</name>
<subpara id="RM0000020U8007X_03" type-id="01" category="01">
<s-1 id="RM0000020U8007X_03_0014" proc-id="RM0550J___0000BLQ00000">
<ptxt>Remove Position Indicator Housing Upper</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disengage the 4 claws and remove the position indicator housing UPR from the shift lock control unit assembly.</ptxt>
<atten3>
<ptxt>Do not damage the position indicator housing UPR.</ptxt>
</atten3>
<figure>
<graphic graphicname="C157083" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020U8007X_03_0015" proc-id="RM0550J___0000BLR00000">
<ptxt>Remove Position Indicator Slide Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the position indicator slide cover together with position indicator slide cover No.2 from the shift lock control unit.</ptxt>
<figure>
<graphic graphicname="C156199" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove position indicator slide cover No.2 from the position indicator slide cover.</ptxt>
<figure>
<graphic graphicname="C156200" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020U8007X_03_0016" proc-id="RM0550J___0000BLS00000">
<ptxt>Remove Indicator Light Wire</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 5 clamps and remove the indicator light wire.</ptxt>
<figure>
<graphic graphicname="C156201" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020U8007X_03_0017" proc-id="RM0550J___0000BLT00000">
<ptxt>Remove Position Indicator Light Bulb</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the position indicator light bulb from the indicator light wire.</ptxt>
</s2>
<s2>
<ptxt>Remove the bulb cap from the position indicator light bulb.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>