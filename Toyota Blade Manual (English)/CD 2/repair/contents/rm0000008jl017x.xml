<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Noise occurs</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000008JL017X_05_0030" fin="true">A</down>
<right ref="RM0000008JL017X_05_0036" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000008JL017X_05_0030">
<testtitle>Replace Antenna Cord Sub-assembly<xref label="Seep01" href="RM000002C01001X"/>
</testtitle>
