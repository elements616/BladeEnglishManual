<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="10006_S000J" variety="S000J">
<name>Engine Control</name>
<ttl id="10006_S000J_74XTW_T00H6" variety="T00H6">
<name>Oxygen Sensor (2GR-FE)</name>
<para id="RM0000020VW00EX" category="A" type-id="30014" name-id="066QG-00" from="200708">
<name>Installation</name>
<subpara id="RM0000020VW00EX_01" type-id="01" category="01">
<s-1 id="RM0000020VW00EX_01_0008" proc-id="RM0550J___0000FNX00000">
<ptxt>Install Oxygen Sensor</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, install the oxygen sensor.</ptxt>
<figure>
<graphic graphicname="A178919J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<torque>
<torqueitem>
<t-value1>44</t-value1>
<t-value2>449</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Route the oxygen sensor connector into the cabin and connect it.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020VW00EX_01_0009" proc-id="RM0550J___0000HC000000">
<ptxt>Install Exhaust Pipe Assembly Center</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install with 2 new gaskets, 2 nuts and 2 bolts.</ptxt>
<figure>
<graphic graphicname="A135140J05" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>43</t-value1>
<t-value2>438</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the exhaust center pipe assembly with 2 bolts and 2 compression springs.</ptxt>
<figure>
<graphic graphicname="A135137J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>43</t-value1>
<t-value2>438</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the oxygen sensor No.2 connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020VW00EX_01_0001" proc-id="RM0550J___0000FNV00000">
<ptxt>Install Oxygen Sensor NO.2</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, install the oxygen sensor to the front exhaust pipe assembly.</ptxt>
<figure>
<graphic graphicname="A135144J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
<torque>
<torqueitem>
<t-value1>44</t-value1>
<t-value2>449</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Connect the oxygen sensor NO.2 connector.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020VW00EX_01_0010" proc-id="RM0550J___0000AJC00000">
<ptxt>Install Engine Under Cover NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine under cover No.1 with the 6 bolts and 7 clips.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020VW00EX_01_0011" proc-id="RM0550J___0000AJB00000">
<ptxt>Install Engine Under Cover
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine under cover with the 4 bolts and 4 screws.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020VW00EX_01_0014" proc-id="RM0550J___0000H6D00000">
<ptxt>Exhaust Gas Leak Inspection
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that there are no exhaust gas leaks from the locations shown in the illustration (exhaust pipe joints and each sensor installation area).</ptxt>
<figure>
<graphic graphicname="A176820" width="7.106578999in" height="5.787629434in"/>
</figure>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>