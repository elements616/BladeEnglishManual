<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="06">
<name>Brake</name>
<section id="1000O_S0019" variety="S0019">
<name>Parking Brake</name>
<ttl id="1000O_S0019_77UQH_T00JR" variety="T00JR">
<name>Parking Brake Control Pedal Assembly</name>
<para id="RM000003MKA00BX" category="A" type-id="80002" name-id="460PY-01" from="200912">
<name>Disassembly</name>
<subpara id="RM000003MKA00BX_01" type-id="01" category="01">
<s-1 id="RM000003MKA00BX_01_0005" proc-id="RM0550J___0000ISS00000">
<ptxt>Remove Parking Brake Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the screw and remove the parking brake switch assembly from the parking brake control pedal assembly.</ptxt>
<figure>
<graphic graphicname="C206666" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000003MKA00BX_01_0004" proc-id="RM0550J___000065200001">
<ptxt>Remove Parking Brake Cable Assembly NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove wire adjusting nut No.1 from parking brake cable assembly No.1.</ptxt>
<figure>
<graphic graphicname="C222595" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Raise the claw of the parking brake control pedal assembly.</ptxt>
<figure>
<graphic graphicname="C222596" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the clip from parking brake cable assembly No.1.</ptxt>
<figure>
<graphic graphicname="C222597" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove parking brake cable assembly No.1 from the parking brake control pedal assembly.</ptxt>
</s2>
</content1></s-1>
<s-1 id="RM000003MKA00BX_01_0002" proc-id="RM0550J___0000IR900000">
<ptxt>Remove Parking Pedal Pad</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the parking pedal pad from the parking brake pedal.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>