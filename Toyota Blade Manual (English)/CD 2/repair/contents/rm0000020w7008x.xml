<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000B_S000N" variety="S000N">
<name>Exhaust</name>
<ttl id="1000B_S000N_744FY_T006K" variety="T006K">
<name>Exhaust Pipe Assembly (2AZ-FE)</name>
<para id="RM0000020W7008X" category="A" type-id="80001" name-id="111FI-00" from="200612">
<name>Removal</name>
<subpara id="RM0000020W7008X_01" type-id="01" category="01">
<s-1 id="RM0000020W7008X_01_0003" proc-id="RM0550J___00003RS00000">
<ptxt>Remove Exhaust Tail Pipe Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts and 2 compression springs.</ptxt>
<figure>
<graphic graphicname="A159957J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the 2 exhaust pipe supports and remove the exhaust tail pipe assembly.</ptxt>
</s2>
<s2>
<ptxt>Remove the gasket.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W7008X_01_0006" proc-id="RM0550J___00004JU00000">
<ptxt>Remove Front Floor Brace Center (Drive Type FF)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 bolts and the front floor brace center.</ptxt>
<figure>
<graphic graphicname="A159958" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W7008X_01_0004" proc-id="RM0550J___00003RT00000">
<ptxt>Remove Exhaust Pipe Assembly Center</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 bolts. </ptxt>
<figure>
<graphic graphicname="A159959J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Disconnect the 3 exhaust pipe supports and remove the exhaust center pipe assembly.</ptxt>
</s2>
<s2>
<ptxt>Remove the gasket.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W7008X_01_0005" proc-id="RM0550J___00003RU00000">
<ptxt>Remove Exhaust Pipe Assembly Front</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the oxygen sensor connector.</ptxt>
<figure>
<graphic graphicname="A166429J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 bolts and 2 compression springs, and remove the exhaust pipe assembly FR.</ptxt>
<figure>
<graphic graphicname="A135090" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the gasket.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020W7008X_01_0002" proc-id="RM0550J___0000BY800000">
<ptxt>Remove Oxygen Sensor
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, remove the oxygen sensor from the front exhaust pipe assembly.</ptxt>
<figure>
<graphic graphicname="A128927J03" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09224-00010</s-number>
</sstitem>
</sst>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>