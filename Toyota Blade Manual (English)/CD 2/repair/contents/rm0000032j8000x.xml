<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="0.90in"/>
<colspec colname="COL2" colwidth="3.61in"/>
<colspec colname="COL3" colwidth="2.57in"/>
<thead>
<row>
<entry>
<ptxt>DTC No.</ptxt>
</entry>
<entry>
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry>
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B279C</ptxt>
</entry>
<entry align="left">
<ptxt>An engine ECU (engine control computer) that is not compatible with the engine immobiliser system is installed</ptxt>
</entry>
<entry align="left">
<ptxt>Engine ECU (Engine Control Computer)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
