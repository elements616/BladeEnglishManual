<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="1001O_S001F" variety="S001F">
<name>Cruise Control</name>
<ttl id="1001O_S001F_74QXD_T00FC" variety="T00FC">
<name>Radar Cruise Control System</name>
<para id="RM00000064K00DX" category="C" type-id="301CQ" name-id="59156-00" from="200708">
<dtccode>P1617/63</dtccode>
<dtcname>Distance Control ECU Malfunction</dtcname>
<subpara id="RM00000064K00DX_01" type-id="31" category="03" proc-id="RM0550J___0000CA300000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is also output when the vehicle information sent from the distance control computer assembly is abnormal. In that case, perform initialization so that the distance control computer assembly recognizes the vehicle information.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
<list1 type="ordered">
<item>
<ptxt>Diagnosis Condition</ptxt>
</item>
<item>
<ptxt>Abnormal Condition</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P1617/63</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>Control vehicle speed (40 - 100 km/h), cruise control main switch ON (vehicle-to-vehicle distance control mode)</ptxt>
</item>
<item>
<ptxt>Destination data of the distance control computer assembly is abnormal</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>Distance Control Computer Assembly</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000064K00DX_03" type-id="51" category="05" proc-id="RM0550J___0000CA400000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>When the distance control computer assembly is replaced with a new one, be sure to perform initialization. (see <xref label="Seep01" href="RM000002GO2003X"/>)</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM00000064K00DX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000064K00DX_04_0001" proc-id="RM0550J___0000CA500000">
<testtitle>Radar Cruise Initial Setting Procedure</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Perform initialization so that the distance control computer assembly recognizes the vehicle information. (see <xref label="Seep01" href="RM000002GO2003X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000064K00DX_04_0005" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000064K00DX_04_0005" proc-id="RM0550J___0000CHV00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), clear the DTCs. (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000064K00DX_04_0003" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000064K00DX_04_0003" proc-id="RM0550J___0000CA600000">
<testtitle>Check DTCs (Radar Cruise Control System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Put the vehicle in the conditions under which the DTC is detected.</ptxt>
<atten4>
<ptxt>The system cannot detect the malfunction unless the detection conditions are met.</ptxt>
</atten4>
<test2>
<ptxt>Drive within the cruise control set vehicle speed range.</ptxt>
</test2>
<test2>
<ptxt>Turn the cruise control main switch ON and put the system in vehicle-to-vehicle distance control mode standby.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs. (see <xref label="Seep01" href="RM00000064C00EX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.89in"/>
<colspec colname="COL2" colwidth="1.24in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P1617 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>P1617 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000064K00DX_04_0004" fin="true">A</down>
<right ref="RM00000064K00DX_04_0002" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000064K00DX_04_0004">
<testtitle>Complete</testtitle>
</testgrp>
<testgrp id="RM00000064K00DX_04_0002">
<testtitle>Replace Distance Control Computer Assembly<xref label="Seep01" href="RM0000028Z2003X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>