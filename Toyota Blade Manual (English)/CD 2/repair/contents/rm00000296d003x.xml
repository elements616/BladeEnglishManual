<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000D_S000P" variety="S000P">
<name>Lubrication</name>
<ttl id="1000D_S000P_744GO_T0079" variety="T0079">
<name>Lubrication System (2AZ-FE)</name>
<para id="RM00000296D003X" category="N" type-id="8009I" name-id="130RK-00" from="200612">
<name>Function Inspection</name>
<subpara id="RM00000296D003X_01" type-id="01" category="01">
<s-1 id="RM00000296D003X_01_0001" proc-id="RM0550J___000034O00000">
<ptxt>Inspect Engine Oil Level</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Warm up the engine, stop it, and after 5 minutes inspect that the oil level is between the L and F marks on the oil level gauge. If the oil level is low, inspect for leaks and add oil up to the F mark.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000296D003X_01_0002" proc-id="RM0550J___000036P00000">
<ptxt>Inspect Engine Oil Quality</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect the oil for deterioration, water entry, discoloration or thinning, and replace the oil if the quality is visibly poor.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000296D003X_01_0003" proc-id="RM0550J___00003X700000">
<ptxt>Inspect Oil Pressure</ptxt>
<content1 releasenbr="1">
<atten3>
<ptxt>Before and after measurement, clean the gauges and hoses with white gasoline or equivalent.</ptxt>
</atten3>
<s2>
<ptxt>Disconnect the oil pressure switch assembly connector.</ptxt>
</s2>
<s2>
<ptxt>Using a deep socket wrench (24mm), remove the oil pressure switch.</ptxt>
<figure>
<graphic graphicname="A112272" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the pressure gauge via an adapter.</ptxt>
<figure>
<graphic graphicname="A112273" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engine Warm-up</ptxt>
</s2>
<s2>
<ptxt>Measure Oil Pressure</ptxt>
<spec>
<title>Standard</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.64in"/>
<colspec colname="COL2" colwidth="2.49in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Engine Speed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Oil pressure</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>At idle</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>32kpa(0.3kgf/cm<sup>2</sup>) or more</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>3000r/min</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>170 to 300kpa(1.7 to 3.1kgf/cm<sup>2</sup>)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s2>
<s2>
<ptxt>Degrease the threads of the oil pressure switch.</ptxt>
</s2>
<s2>
<ptxt>Apply adhesive 1324 to the threads.</ptxt>
<figure>
<graphic graphicname="P012478J07" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using a deep socket wrench (24mm), install the oil pressure switch.</ptxt>
<torque>
<torqueitem>
<t-value1>15</t-value1>
<t-value2>153</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>After installation, do not start the engine for 1 hours.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Connect the oil pressure switch assembly connector.</ptxt>
</s2>
<s2>
<ptxt>Engine Oil Leak Inspection</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000296D003X_01_0004" proc-id="RM0550J___0000A3I00000">
<ptxt>Inspect Engine Oil Pressure Switch Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Disconnect the engine oil pressure switch connector.</ptxt>
</s2>
<s2>
<ptxt>Start the engine.</ptxt>
</s2>
<s2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminal and body ground.</ptxt>
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
</sst>
<figure>
<graphic graphicname="A162746J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.54in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<colspec colname="COL3" colwidth="1.17in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>1 - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>At idle</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1 - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>Engine stopped</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s2>
<s2>
<ptxt>Connect the engine oil pressure switch connector.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>