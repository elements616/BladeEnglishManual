<name>Body &amp; Electrical</name>
<section id="1001H_S0001" variety="S0001">
<name>Seat</name>
<ttl id="1001H_S0001_76ATZ_T00JG" variety="T00JG">
<name>Front Seat Heater System</name>
<para id="RM000001OPR00OX" category="N" type-id="8009I" name-id="791PH-02" from="200912">
<name>Function Inspection</name>
<subpara id="RM000001OPR00OX_01" type-id="01" category="01">
<s-1 id="RM000001OPR00OX_01_0001" proc-id="RM0550J___0000HTF00001">
<ptxt>Inspect Seat Heater Operation</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Turn IG ON.</ptxt>
</s2>
<s2>
<ptxt>Check that the indicator light comes on when the seat heater switch is set to HI or LO, and that the front seat surface becomes warm in approximately 5 minutes.</ptxt>
<atten4>
<list1 type="unordered">
<item>
<ptxt>When HI is ON, the seatback heater and seat cushion heater become warm.</ptxt>
</item>
</list1>
<list1 type="unordered">
<item>
<ptxt>When LO is ON, only the seatback heater becomes warm.</ptxt>
</item>
</list1>
</atten4>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
