<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002S_S000E" variety="S000E">
<name>Vehicle Surroundings Monitor</name>
<ttl id="1002S_S000E_742B9_T003J" variety="T003J">
<name>Intelligent Parking Assist System</name>
<para id="RM000000O1T009X" category="C" type-id="8039C" name-id="672FH-00" from="200612" to="200912">
<dtccode>C1643</dtccode>
<dtcname>Brake System Malfunction</dtcname>
<subpara id="RM000000O1T009X_05" type-id="33" category="03" proc-id="RM0550J___0000A5Y00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the television camera controller's self-diagnosis determines that the brake control system connected via CAN communication is malfunctioning.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="left">
<colspec colname="COL1" colwidth="1.00in"/>
<colspec colname="COL2" colwidth="3.00in"/>
<colspec colname="COL3" colwidth="3.08in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>C1643</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>Wheel Speed Sensor Malfunction</ptxt>
</item>
<item>
<ptxt>Stop SW Open Circuit</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>Brake Control System - ABS with EBD &amp; TRC &amp; VSC &amp; BA System</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000000O1T009X_06" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000000O1T009X_07" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000000O1T009X_07_0004" proc-id="RM0550J___0000A5Z00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Using SST (TaSCAN), read the DTCs by following the screen display. (see <xref label="Seep01" href="RM000000OCQ007X"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "Clear" on the screen to clear the data. </ptxt>
</test2>
<test2>
<ptxt>Turn IG OFF.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Recheck DTC</ptxt>
<test2>
<ptxt>Start the engine, check the DTCs again, and proceed to the following destination.</ptxt>
<spec>
<title>Result</title>
<specitem>
<ptxt/>
</specitem>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="3.30in"/>
<colspec colname="COL2" colwidth="0.83in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>No DTC Output (Normal)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"C1643" is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>"C1643", "C1647" and "C1696" are output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM000000O1T009X_07_0007" fin="true">A</down>
<right ref="RM000000O1T009X_07_0006" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000000O1T009X_07_0006">
<testtitle>Go to Brake Control System<xref label="Seep01" href="RM000000OUR00SX"/>
</testtitle>
</testgrp>
<testgrp id="RM000000O1T009X_07_0007">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY03DX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
