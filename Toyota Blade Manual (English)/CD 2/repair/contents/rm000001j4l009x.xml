<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1001I_S000I" variety="S000I">
<name>Door Lock</name>
<ttl id="1001I_S000I_746FZ_T00C0" variety="T00C0">
<name>Electrical Key Antenna</name>
<para id="RM000001J4L009X" category="A" type-id="30014" name-id="622P6-00" from="200612">
<name>Installation</name>
<subpara id="RM000001J4L009X_02" type-id="01" category="01">
<s-1 id="RM000001J4L009X_02_0027" proc-id="RM0550J___00008FB00000">
<ptxt>Install Rear Bumper Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
<s2>
<ptxt>Lift the rear bumper assembly from under the vehicle and pass the license plate through from the lower side of the rear bumper assembly.</ptxt>
<figure>
<graphic graphicname="B230794" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>As shown in the illustration, while pulling the lower side of the rear bumper assembly toward the rear of the vehicle, push it toward the front of the vehicle until the rear bumper assembly passes over the upper side of the license plate.</ptxt>
<figure>
<graphic graphicname="B230793" width="2.775699831in" height="2.775699831in"/>
</figure>
</s2>
<s2>
<ptxt>Install the 2 clips of the rear bumper assembly</ptxt>
<figure>
<graphic graphicname="B168877" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Engage the 12 claws (6 each on LH/RH).</ptxt>
<figure>
<graphic graphicname="B167161" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the rear bumper assembly with the 6 clips and 2 bolts.</ptxt>
<figure>
<graphic graphicname="B167160" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM000001J4L009X_02_0028" proc-id="RM0550J___0000AQ100000">
<ptxt>Install Rear Bumper Plate NO.1
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Engage the 2 claws and install the rear bumper plate No.1.</ptxt>
<figure>
<graphic graphicname="B167559" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Install the LH side using the same procedure.</ptxt>
</atten4>
</s2>
</content1></s-1>
<s-1 id="RM000001J4L009X_02_0018" proc-id="RM0550J___00008KA00000">
<ptxt>Install Electrical Key Antenna</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the electrical key antenna with the 2 nuts.</ptxt>
<figure>
<graphic graphicname="B167518" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Connect the connector.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>