</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM000003B8800DX_03" type-id="51" category="05">
<name>Inspection Procedure</name>
</subpara>
<subpara id="RM000003B8800DX_02" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000003B8800DX_02_0004" proc-id="RM0550J___0000I4N00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Connect SST (TaSCAN) to DLC3.</ptxt>
</test1>
<test1>
<ptxt>Turn the IG ON.</ptxt>
</test1>
<test1>
<ptxt>Following the SST (TaSCAN) screen display, clear the DTCs. (see <xref label="Seep01" href="RM000000CCX015X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM000003B8800DX_02_0001" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM000003B8800DX_02_0001" proc-id="RM0550J___0000I4M00000">
<testtitle>Read DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Perform a road test.</ptxt>
</test1>
<test1>
<ptxt>Turn the IG ON.</ptxt>
</test1>
<test1>
<ptxt>Following the SST (TaSCAN) screen display, check the DTCs. (see <xref label="Seep01" href="RM000000CCX015X"/>)</ptxt>
</test1>
<spec>
<title>Result</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U0129/A2 is displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>U0129/A2 is not displayed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM000003B8800DX_02_0002" fin="true">A</down>
<right ref="RM000003B8800DX_02_0003" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM000003B8800DX_02_0002">
<testtitle>Go to CAN communication system troubleshooting<xref label="Seep01" href="RM000001R4W019X"/>
</testtitle>
</testgrp>
<testgrp id="RM000003B8800DX_02_0003">
<testtitle>Inspection for Intermittent Problems<xref label="Seep01" href="RM000000CD101FX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>