<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000002BJJ007X" category="C" type-id="3031A" name-id="261IG-00" from="200708">
<dtccode>P2769/64</dtccode>
<dtcname>DSU/SL Solenoid Circuit (Low)</dtcname>
<dtccode>P2770/64</dtccode>
<dtcname>DSU/SL Solenoid Circuit (High)</dtcname>
<subpara id="RM000002BJJ007X_01" type-id="33" category="03" proc-id="RM0550J___0000FS100000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>The transmission control computer controls the hydraulic pressure to the lock-up relay valve by turning the automatic transmission 3 way solenoid assembly (SL) ON or OFF, turning lock-up ON or OFF.</ptxt>
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="0.93in"/>
<colspec colname="COL2" colwidth="3.39in"/>
<colspec colname="COL3" colwidth="2.76in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry align="center">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>P2769/64</ptxt>
<ptxt>P2770/64</ptxt>
</entry>
<entry valign="middle">
<list1 type="ordered">
<item>
<ptxt>Lock-up Operation Range</ptxt>
</item>
<item>
<ptxt>Open or short in solenoid SL circuit</ptxt>
</item>
<item>
<ptxt>-</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry>
<list1 type="unordered">
<item>
<ptxt>Transmission wire</ptxt>
</item>
<item>
<ptxt>Automatic transmission 3 way solenoid assembly (SL)</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
