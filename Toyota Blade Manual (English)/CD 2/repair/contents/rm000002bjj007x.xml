<subpara id="RM000002BJJ007X_05" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM000002BJJ007X_05_0008" proc-id="RM0550J___0000FS300000">
<testtitle>Inspect Transmission Wire (SL)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Remove the transmission control computer. (see <xref label="Seep01" href="RM0000024M9003X"/>)</ptxt>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<figure>
<graphic graphicname="C133212J19" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.01in"/>
<colspec colname="COL2" colwidth="1.09in"/>
<colspec colname="COL3" colwidth="1.03in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>6 (SL) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>20°C</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 15Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM000002BJJ007X_05_0011" fin="false">OK</down>
<right ref="RM000002BJJ007X_05_0009" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000002BJJ007X_05_0011" proc-id="RM0550J___0000HCN00000">
<testtitle>Replace Transmission Control Computer Assembly</testtitle>
<content6 releasenbr="2">
<test1>
<ptxt>Replace the transmission control computer assembly. (see <xref label="Seep01" href="RM0000024M8003X"/>)</ptxt>
</test1>
</content6>
