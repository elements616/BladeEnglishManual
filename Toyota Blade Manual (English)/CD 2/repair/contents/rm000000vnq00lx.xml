<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="05">
<name>Suspension</name>
<section id="1002I_S0016" variety="S0016">
<name>Suspension</name>
<ttl id="1002I_S0016_74505_T00AG" variety="T00AG">
<name>Front Wheel Alignment</name>
<para id="RM000000VNQ00LX" category="N" type-id="3000G" name-id="421FS-00" from="200612" to="200708">
<name>Adjustment</name>
<subpara id="RM000000VNQ00LX_02" type-id="11" category="10" proc-id="RM0550J___0000BJG00000">
<content3 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>If alignment adjustment or removal/installation or replacement of suspension or chassis parts has been performed, after the work, set the front tires in the straight-ahead position, disconnect the battery terminal for 2 seconds or more, and then perform the settings required after disconnecting and reconnecting the battery terminal.</ptxt>
</item>
<item>
<ptxt>For the VSC system to function normally, whenever alignment adjustment or removal/installation or replacement of suspension or chassis parts is performed, be sure to disconnect the battery terminal for 2 seconds or more to initialize the steering angle sensor, and after reconnecting, perform yaw rate sensor 0 point acquisition and test mode inspection.</ptxt>
</item>
</list1>
</atten3>
<atten4>
<list1 type="unordered">
<item>
<ptxt>For the initialization when disconnecting/reconnecting the battery terminal, refer to <xref label="Seep01" href="RM000001LYW00PX"/>.</ptxt>
</item>
<item>
<ptxt>For the yaw rate sensor 0-point acquisition procedure, refer to <xref label="Seep02" href="RM000001A8300PX"/>.</ptxt>
</item>
</list1>
</atten4>
</content3>
</subpara>
<subpara id="RM000000VNQ00LX_01" type-id="01" category="01">
<s-1 id="RM000000VNQ00LX_01_0009" proc-id="RM0550J___00005Q400000">
<ptxt>Inspect Tires</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Inspect the tire size and wear condition</ptxt>
</s2>
<s2>
<ptxt>Inspect the tire pressure</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Tire Size</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Tire Inflation Pressure (Front and Rear Wheels)</ptxt>
<ptxt>[{kgf/cm<sup>2</sup>} ]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>205/55R16</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>210(2.1)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s2>
<s2>
<ptxt>Inspect for suspension modifications and damage to chassis parts</ptxt>
</s2>
<s2>
<ptxt>Inspect the tire runout</ptxt>
<spec>
<title>Limit</title>
<specitem>
<ptxt>1.4mm (vertical, lateral)</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>Remove the wheel assembly from the vehicle and measure the wheel assembly by itself.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Inspect the tightening condition of the bolts of related parts</ptxt>
</s2>
<s2>
<ptxt>Inspect the related parts for looseness</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000VNQ00LX_01_0002" proc-id="RM0550J___00005PX00000">
<ptxt>Inspect Vehicle Height</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Bounce the corners of the vehicle up and down to stabilize the suspension before inspecting the vehicle height.</ptxt>
<spec>
<title>Standard</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tire Size</ptxt>
</entry>
<entry valign="middle">
<ptxt>Dimension B - Dimension A</ptxt>
<ptxt>[mm]</ptxt>
</entry>
<entry valign="middle">
<ptxt>Dimension D - Dimension C</ptxt>
<ptxt>[mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>205/55R16</ptxt>
</entry>
<entry valign="middle">
<ptxt>101 (FF drive type)</ptxt>
<ptxt>102 (4WD drive type)</ptxt>
</entry>
<entry valign="middle">
<ptxt>60</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>Perform with the vehicle unladen (without spare tire and tools).</ptxt>
</atten3>
<atten4>
<list1 type="unordered">
<item>
<ptxt>A measurement... Center of the head of the front suspension lower arm No.1 bushing set bolt</ptxt>
</item>
<item>
<ptxt>B measurement... Front wheel center</ptxt>
</item>
<item>
<ptxt>C measurement... Center of the head of the rear suspension arm assembly No.2 bushing set bolt</ptxt>
</item>
<item>
<ptxt>D measurement... Rear wheel center</ptxt>
</item>
</list1>
</atten4>
<figure>
<graphic graphicname="C160264J01" width="2.775699831in" height="3.779676365in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000000VNQ00LX_01_0007" proc-id="RM0550J___00005Q200000">
<ptxt>Inspect Camber, Caster and Steering Axis Inclination</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Lift up the vehicle on a level surface.</ptxt>
</s2>
<s2>
<ptxt>Install SST (tire clamp compensator).</ptxt>
<sst>
<sstitem>
<s-number>09722-30010</s-number>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Set the turning radius gauge and lower the vehicle.</ptxt>
</s2>
<s2>
<ptxt>Inspect the camber, caster and steering axis inclination.</ptxt>
<spec>
<title>Standard</title>
<table pgwide="1">
<tgroup cols="4" align="center">
<colspec colname="COL1" colwidth="1.77in"/>
<colspec colname="COL2" colwidth="1.77in"/>
<colspec colname="COL3" colwidth="1.77in"/>
<colspec colname="COL4" colwidth="1.77in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Drive Type</ptxt>
</entry>
<entry valign="middle">
<ptxt>Camber</ptxt>
</entry>
<entry valign="middle">
<ptxt>Caster</ptxt>
</entry>
<entry valign="middle">
<ptxt>Steering Axis Inclination</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>FF</ptxt>
</entry>
<entry valign="middle">
<ptxt>-0°10'±45'</ptxt>
</entry>
<entry valign="middle">
<ptxt>5°50'±45'</ptxt>
</entry>
<entry valign="middle">
<ptxt>12°10'</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>4WD</ptxt>
</entry>
<entry valign="middle">
<ptxt>-0°10'±45'</ptxt>
</entry>
<entry valign="middle">
<ptxt>5°50'±45'</ptxt>
</entry>
<entry valign="middle">
<ptxt>12°00'</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Perform with the vehicle unladen (without spare tire and tools).</ptxt>
</item>
<item>
<ptxt>The maximum difference between the left and right sides for camber and caster is within 45'.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Remove the camber-caster-kingpin gauge and tire clamp compensator.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000000VNQ00LX_01_0008" proc-id="RM0550J___00005Q300000">
<ptxt>Adjust Camber</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Jack up the vehicle and remove the front tire.</ptxt>
</s2>
<s2>
<ptxt>Remove the bolt and clamp, and disconnect the speed sensor FR LH.</ptxt>
<figure>
<graphic graphicname="C153575" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and disconnect front brake flexible hose No.1.</ptxt>
<figure>
<graphic graphicname="C153576" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Loosen the 2 lower side mounting nuts of the front shock absorber assembly LH.</ptxt>
<figure>
<graphic graphicname="C154929" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Move the lower side of the shock absorber and adjust the camber using the play between the bolts and the bolt holes of the steering knuckle.</ptxt>
<figure>
<graphic graphicname="C148065J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Tighten the 2 nuts.</ptxt>
<figure>
<graphic graphicname="C154929" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>240</t-value1>
<t-value2>2450</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the flexible hose and speed sensor with the bolts.</ptxt>
<figure>
<graphic graphicname="C153576" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>29</t-value1>
<t-value2>296</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>Do not twist the flexible hose and speed sensor when installing them.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the speed sensor FR LH with the bolt and clamp.</ptxt>
<figure>
<graphic graphicname="C153575" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>29</t-value1>
<t-value2>296</t-value2>
</torqueitem>
</torque>
<atten3>
<ptxt>Do not twist the flexible hose and speed sensor when installing them.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Install the front tire.</ptxt>
<torque>
<torqueitem>
<t-value1>103</t-value1>
<t-value2>1050</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Lower the vehicle and bounce it up and down several times to stabilize the suspension.</ptxt>
</s2>
<s2>
<ptxt>Inspect the camber.</ptxt>
<spec>
<title>Standard</title>
<specitem>
<ptxt>-0°10'±45'</ptxt>
</specitem>
</spec>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Perform with the vehicle unladen (without spare tire and tools).</ptxt>
</item>
<item>
<ptxt>The maximum difference between the left and right sides for camber and caster is within 45'.</ptxt>
</item>
</list1>
</atten3>
<atten4>
<ptxt>The adjustable range with the set bolts is ±45'.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>If the result is within the specified range, inspect the toe-in.</ptxt>
</s2>
<s2>
<ptxt>If the result is not within the specified range, jack up the vehicle, remove the front tire, disconnect the speed sensor and flexible hose, and perform the following procedure.</ptxt>
<s3>
<ptxt>Support the front axle with a jack and wooden block.</ptxt>
</s3>
<s3>
<ptxt>Remove the 2 lower side mounting nuts and 2 bolts of the shock absorber.</ptxt>
</s3>
<s3>
<ptxt>Select 2 adjusting bolts and insert them from the front of the vehicle.</ptxt>
<figure>
<graphic graphicname="C117429J02" width="2.775699831in" height="3.779676365in"/>
</figure>
<atten4>
<ptxt>Camber adjustment amount = (Standard camber) - (Camber after adjustment with set bolts)</ptxt>
</atten4>
<spec>
<title>Adjusting Bolt Types</title>
<table>
<tgroup cols="4" align="center">
<colspec colname="COL1" colwidth="1.45in"/>
<colspec colname="COL2" colwidth="1.45in"/>
<colspec colname="COL3" colwidth="0.62in"/>
<colspec colname="COL4" colwidth="0.61in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Adjusting Bolt</ptxt>
</entry>
<entry valign="middle">
<ptxt>Part No.</ptxt>
</entry>
<entry valign="middle">
<ptxt>Bolt Diameter</ptxt>
<ptxt>(mm)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Adjustment Amount</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
<entry valign="middle">
<ptxt>90105-17009</ptxt>
</entry>
<entry valign="middle">
<ptxt>15.9</ptxt>
</entry>
<entry valign="middle">
<ptxt>±15’</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
<entry valign="middle">
<ptxt>90105-17010</ptxt>
</entry>
<entry valign="middle">
<ptxt>15.0</ptxt>
</entry>
<entry valign="middle">
<ptxt>±30’</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>C</ptxt>
</entry>
<entry valign="middle">
<ptxt>90105-17011</ptxt>
</entry>
<entry valign="middle">
<ptxt>14.0</ptxt>
</entry>
<entry valign="middle">
<ptxt>±45’</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Camber Adjustment Amount</title>
<table pgwide="1">
<tgroup cols="5" align="center">
<colspec colname="COL1" colwidth="1.98in"/>
<colspec colname="COL2" colwidth="1.27in"/>
<colspec colname="COL3" colwidth="1.27in"/>
<colspec colname="COL4" colwidth="1.27in"/>
<colspec colname="COL5" colwidth="1.29in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Camber Adjustment Amount</ptxt>
</entry>
<entry valign="middle">
<ptxt>Set Bolt</ptxt>
</entry>
<entry valign="middle">
<ptxt>90105-17009</ptxt>
</entry>
<entry valign="middle">
<ptxt>90105-17010</ptxt>
</entry>
<entry valign="middle">
<ptxt>90105-17011</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
