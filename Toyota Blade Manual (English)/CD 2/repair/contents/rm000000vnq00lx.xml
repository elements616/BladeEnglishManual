<ptxt>2</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>-45'--30'</ptxt>
</entry>
<entry valign="middle">
<ptxt>1</ptxt>
</entry>
<entry valign="middle"/>
<entry valign="middle"/>
<entry valign="middle">
<ptxt>2</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>-30'--15'</ptxt>
</entry>
<entry valign="middle">
<ptxt>1</ptxt>
</entry>
<entry valign="middle"/>
<entry valign="middle">
<ptxt>2</ptxt>
</entry>
<entry valign="middle"/>
</row>
<row>
<entry valign="middle">
<ptxt>-15'-0'</ptxt>
</entry>
<entry valign="middle">
<ptxt>1</ptxt>
</entry>
<entry valign="middle">
<ptxt>2</ptxt>
</entry>
<entry valign="middle"/>
<entry valign="middle"/>
</row>
<row>
<entry valign="middle">
<ptxt>0'-15'</ptxt>
</entry>
<entry valign="middle">
<ptxt>1</ptxt>
</entry>
<entry valign="middle">
<ptxt>2</ptxt>
</entry>
<entry valign="middle"/>
<entry valign="middle"/>
</row>
<row>
<entry valign="middle">
<ptxt>15'-30'</ptxt>
</entry>
<entry valign="middle">
<ptxt>1</ptxt>
</entry>
<entry valign="middle"/>
<entry valign="middle">
<ptxt>2</ptxt>
</entry>
<entry valign="middle"/>
</row>
<row>
<entry valign="middle">
<ptxt>30'-45'</ptxt>
</entry>
<entry valign="middle">
<ptxt>1</ptxt>
</entry>
<entry valign="middle"/>
<entry valign="middle"/>
<entry valign="middle">
<ptxt>2</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>45'-1°00'</ptxt>
</entry>
<entry valign="middle"/>
<entry valign="middle">
<ptxt>1</ptxt>
</entry>
<entry valign="middle"/>
<entry valign="middle">
<ptxt>2</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>1°00'-1°15'</ptxt>
</entry>
<entry valign="middle"/>
<entry valign="middle"/>
