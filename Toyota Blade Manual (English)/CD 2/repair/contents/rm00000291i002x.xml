<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="11">
<name>Control System</name>
<section id="10033_S0007" variety="S0007">
<name>CAN Communication</name>
<ttl id="10033_S0007_741KB_T000K" variety="T000K">
<name>CAN Communication System</name>
<para id="RM00000291I002X" category="C" type-id="8026J" name-id="950UO-00" from="200612">
<dtccode>U0114</dtccode>
<dtcname>4WD ECU Communication Malfunction</dtcname>
<subpara id="RM00000291I002X_01" type-id="33" category="03" proc-id="RM0550J___00000FK00000">
<name>Function Description</name>
<content5 releasenbr="1">
<table pgwide="1">
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.06in"/>
<colspec colname="COL2" colwidth="2.83in"/>
<colspec colname="COL3" colwidth="3.19in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Detection Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>DTC Output Related Items</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>U0114</ptxt>
</entry>
<entry valign="middle">
<ptxt>With the IG ON, the CAN gateway ECU cannot receive data from the 4WD ECU</ptxt>
</entry>
<entry valign="middle">
<list1 type="unordered">
<item>
<ptxt>(1) open circuit, poor connector contact or poor contact pressure</ptxt>
</item>
<item>
<ptxt>4WD computer assembly (4WD ECU) power source system malfunction</ptxt>
</item>
<item>
<ptxt>4WD computer assembly (4WD ECU) internal malfunction</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000291I002X_02" type-id="32" category="03" proc-id="RM0550J___0000BGC00000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="B162455J01" width="7.106578999in" height="5.787629434in"/>
</figure>
</content5>
</subpara>
<subpara id="RM00000291I002X_03" type-id="51" category="05" proc-id="RM0550J___00000FM00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>When measuring the resistance of the CAN bus, turn the ignition switch off, check that warning functions such as the key reminder warning system are not operating, and leave the vehicle for at least 1 minutes without operating the key or switches or opening and closing the doors before starting the measurement. If it is necessary to open a door during inspection, open it beforehand.</ptxt>
</atten3>
<atten4>
<list1 type="unordered">
<item>
<ptxt>When inspecting each connector, before disconnecting it, push the connector case in the connecting direction and check that the connector is not loose or disconnected.</ptxt>
</item>
<item>
<ptxt>When disconnecting a connector, check that the connector terminals and connector case are free of damage, deformation, corrosion, etc.</ptxt>
</item>
</list1>
</atten4>
</content5>
</subpara>
<subpara id="RM00000291I002X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000291I002X_04_0006" proc-id="RM0550J___00000FP00000">
<testtitle>Check DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70200</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs.</ptxt>
<spec>
<title>Specified Condition</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry>
<ptxt>U1002 is not output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry>
<ptxt>U1002 is output</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000291I002X_04_0001" fin="false">A</down>
<right ref="RM00000291I002X_04_0007" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000291I002X_04_0001" proc-id="RM0550J___00000FN00000">
<testtitle>CAN Bus Open Circuit Inspection (4WD ECU Branch Line)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Turn the IG OFF and disconnect the vehicle wire harness connector of the 4WD computer assembly (4WD ECU).</ptxt>
<figure>
<graphic graphicname="C132078J14" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the vehicle wire harness connector of the 4WD computer assembly (4WD ECU).</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>14(CANH) - 16(CANL)</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG OFF</ptxt>
</entry>
<entry valign="middle">
<ptxt>54 to 69Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000291I002X_04_0002" fin="false">OK</down>
<right ref="RM00000291I002X_04_0003" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000291I002X_04_0002" proc-id="RM0550J___00000FO00000">
<testtitle>Inspect Wire Harness (ECU Power Source System)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the voltage and resistance between each terminal of the 4WD computer assembly (4WD ECU) vehicle wire harness connector and body ground.</ptxt>
<figure>
<graphic graphicname="C132078J15" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<title>Voltage</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>11 (IG1) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG ON</ptxt>
</entry>
<entry valign="middle">
<ptxt>11 to 14V</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<table>
<title>Resistance</title>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.38in"/>
<colspec colname="COL3" colwidth="1.37in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>23 (GND) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>IG OFF</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000291I002X_04_0004" fin="true">OK</down>
<right ref="RM00000291I002X_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM00000291I002X_04_0004">
<testtitle>Replace 4WD Computer Assembly<xref label="Seep01" href="RM000002WLD001X"/>
</testtitle>
</testgrp>
<testgrp id="RM00000291I002X_04_0003">
<testtitle>Repair or Replace Branch Wire or Connector</testtitle>
</testgrp>
