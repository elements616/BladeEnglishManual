<entry valign="middle">
<ptxt>No code, symptom cannot be confirmed and reproduced</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>D</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<results>
<result>B</result>
<action-ci-right>Go to Troubleshooting Flowchart AVC-LAN Malfunction (see <xref label="Seep06" href="RM0000007EM02GX"/>)</action-ci-right>
<result>C</result>
<action-ci-right>Go to step 11</action-ci-right>
<result>D</result>
