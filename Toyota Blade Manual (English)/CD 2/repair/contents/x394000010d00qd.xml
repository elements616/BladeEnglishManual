<ptxt>CAMERA-C</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test2>
</test1>
<test1>
<ptxt>Check DTC</ptxt>
<test2>
<ptxt>Record the DTCs.</ptxt>
</test2>
<test2>
<ptxt>Perform inspection and repair according to the instructions in the Diagnostic Trouble Code Chart.</ptxt>
<table>
<tgroup cols="2">
<colspec colname="COL2" colwidth="3.01in"/>
<colspec colname="COLSPEC0" align="center" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Device Name</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>AVN</ptxt>
</entry>
<entry valign="middle">
<ptxt>
<xref label="Seep07" href="RM0000002RS03EX"/>
</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>ETC</ptxt>
</entry>
<entry valign="middle">
<ptxt>
<xref label="Seep10" href="RM000001US9001X"/>
