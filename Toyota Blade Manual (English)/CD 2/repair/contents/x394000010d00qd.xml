<descript-testgroup>
<testtitle>Service Inspection</testtitle>
<atten4>
<ptxt>For details of the procedure, refer to <xref label="Seep11" href="RM0000006XI02BX"/></ptxt>
</atten4>
<test1>
<ptxt>AVC-LAN Connection Check</ptxt>
<test2>
<ptxt>Start diagnosis.</ptxt>
</test2>
<test2>
<ptxt>On the service inspection screen, check that all connected devices are displayed.</ptxt>
<table>
<tgroup cols="2">
<colspec colname="COL2" colwidth="3.01in"/>
<colspec colname="COLSPEC0" align="center" colwidth="1.12in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Part Name</ptxt>
</entry>
<entry valign="middle">
<ptxt>Device Name</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Navigation Receiver Assembly</ptxt>
</entry>
