<testtitle>Inspect Power Door Lock System</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check that the door locks operate lock &lt;-&gt; unlock when the door control switch of the power window regulator master switch assembly is operated.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.47in"/>
<colspec colname="COL2" colwidth="1.66in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Operates normally</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Does not operate normally</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000002QX5001X_03_0002" fin="false">A</down>
<right ref="RM000002QX5001X_03_0009" fin="true">B</right>
</res>
</testgrp>
