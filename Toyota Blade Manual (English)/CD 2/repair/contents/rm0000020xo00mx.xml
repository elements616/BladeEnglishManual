<name>Precautions</name>
<subpara id="RM0000020XO00MX_z0" proc-id="RM0550J___0000FJ100000">
<content5 releasenbr="1">
<step1>
<ptxt>Never disconnect the battery while the engine is running.</ptxt>
</step1>
<step1>
<ptxt>Check that the battery cables are correctly connected to the terminals.</ptxt>
</step1>
<step1>
<ptxt>Do not connect the battery cables while the battery is being quick-charged.</ptxt>
</step1>
