<ttl id="1002B_S001H_74Y0X_T00H8" variety="T00H8">
<name>Electronically Controlled Automatic Transaxle [ECT] (U660E)</name>
<para id="RM000001H8H00BX" category="C" type-id="305RG" name-id="261H4-00" from="200708">
<dtccode>P0705/C2</dtccode>
<dtcname>T/M Selection SW Malfunction</dtcname>
<subpara id="RM000001H8H00BX_05" type-id="31" category="03" proc-id="RM0550J___0000FTM00000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The transmission control computer detects the shift position using signals from the neutral start switch assembly. The engine can be started only when the shift lever is in the P or N position.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.06in"/>
<colspec colname="COL2" colwidth="3.54in"/>
<colspec colname="COL3" colwidth="2.48in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>DTC No.</ptxt>
<ptxt>SAE/TCCS</ptxt>
</entry>
<entry valign="middle">
<ptxt>DTC Detection Condition</ptxt>
<ptxt>1. Detection condition 2. Malfunction status 3. Malfunction duration 4. Other</ptxt>
</entry>
<entry valign="middle">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>P0705/C2*</ptxt>
</entry>
<entry valign="middle" align="left">
<list1 type="ordered">
<item>
<ptxt>IG ON, battery voltage 10.5 V or more</ptxt>
</item>
<item>
<ptxt>2 or more of the NSW, R and D signals are ON simultaneously</ptxt>
</item>
<item>
<ptxt>2 seconds or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Neutral Start Switch Assembly</ptxt>
</item>
<item>
<ptxt>Wire Harness and Connector</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>P0705/C2*</ptxt>
</entry>
<entry valign="middle" align="left">
<list1 type="ordered">
<item>
<ptxt>IG ON, battery voltage 10.5 V or more</ptxt>
</item>
<item>
<ptxt>All of the NSW, R and D signals are OFF</ptxt>
</item>
<item>
<ptxt>60 seconds or more</ptxt>
</item>
<item>
<ptxt>2 trip</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Neutral Start Switch Assembly</ptxt>
</item>
<item>
<ptxt>Wire Harness and Connector</ptxt>
</item>
<item>
<ptxt>Transmission Control Computer</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
<atten4>
<ptxt>*: C2 (lamp code) indicates that the tens digit of the conventional 2-digit code blinks 12 times and the ones digit blinks 2 times.</ptxt>
</atten4>
</content5>
</subpara>
