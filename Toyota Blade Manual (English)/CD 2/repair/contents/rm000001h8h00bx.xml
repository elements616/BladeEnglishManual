</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>1(RB) - 7(DL)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shift lever position D, S, + or -</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>4(B) - 9(L)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shift lever position other than P or N</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10 kΩ or higher</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>1(RB) - 2(RL)</ptxt>
</entry>
<entry valign="middle" align="center">
