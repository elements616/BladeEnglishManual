<row>
<entry valign="middle" align="center">
<ptxt>4(B) - 9(L)</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Shift lever position P or N</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Below 1 Ω</ptxt>
</entry>
