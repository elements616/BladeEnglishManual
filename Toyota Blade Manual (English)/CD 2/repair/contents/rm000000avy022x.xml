<ptxt>Display: ON/OFF</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>OFF→ON</ptxt>
<ptxt>Shift the shift lever to M "-"</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Transmission control switch (SFTD) signal</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
