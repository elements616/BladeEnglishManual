<testgrp id="RM000000AVY022X_04_0003" proc-id="RM0550J___0000FRW00001">
<testtitle>Inspect Shift Lock Control Unit Assembly (Transmission Control Switch)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Disconnect the transmission control switch connector.</ptxt>
<figure>
<graphic graphicname="C173980J01" width="2.775699831in" height="2.775699831in"/>
</figure>
</test1>
<test1>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.38in"/>
<colspec colname="COL2" colwidth="1.77in"/>
<colspec colname="COL3" colwidth="0.98in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry morerows="1" valign="middle">
<ptxt>5(SFTU) - 11(E)</ptxt>
</entry>
<entry valign="middle">
<ptxt>When shifted to "+"</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Neutral position (M position)</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry morerows="1" valign="middle">
<ptxt>4(SFTD) - 11(E)</ptxt>
</entry>
<entry valign="middle">
<ptxt>When shifted to "-"</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Neutral position (M position)</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000AVY022X_04_0004" fin="false">OK</down>
<right ref="RM000000AVY022X_04_0009" fin="true">NG</right>
</res>
</testgrp>
