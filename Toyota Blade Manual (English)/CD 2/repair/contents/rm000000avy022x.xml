<testtitle>Read TaSCAN Data (Sport Mode Select SW)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), display the [ECU Data Monitor] screen according to the screen display, and check the computer data.</ptxt>
<table pgwide="1">
<title>[Diagnosis menu screen: Powertrain → ECT → ECU Data Monitor]</title>
<tgroup cols="4">
<colspec colname="COL1" colwidth="1.77in"/>
<colspec colname="COL2" colwidth="1.77in"/>
<colspec colname="COL3" colwidth="1.77in"/>
<colspec colname="COL4" colwidth="1.77in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item Name</ptxt>
<ptxt>[Symbol]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Item Description/Display Range</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard Value</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Remarks</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Sport Mode Select SW</ptxt>
<ptxt>[SPRT]</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Indicates M position</ptxt>
<ptxt>Display: ON/OFF</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>OFF→ON:</ptxt>
<ptxt>Shift lever D → M</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Transmission control switch (S) signal</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</test1>
</content6>
<res>
<down ref="RM000000AVY022X_04_0002" fin="false">OK</down>
<right ref="RM000000AVY022X_04_0005" fin="false">NG</right>
</res>
</testgrp>
<testgrp id="RM000000AVY022X_04_0002" proc-id="RM0550J___0000FRV00001">
<scantool type="4"/>
<testtitle>Read TaSCAN Data (Sport Shift UP SW / Sport Shift DOWN SW)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), display the [ECU Data Monitor] screen according to the screen display, and check the computer data.</ptxt>
<table pgwide="1">
<title>[Diagnosis menu screen: Powertrain → ECT → ECU Data Monitor]</title>
<tgroup cols="4">
<colspec colname="COL1" colwidth="1.77in"/>
<colspec colname="COL2" colwidth="2.09in"/>
<colspec colname="COL3" colwidth="1.67in"/>
