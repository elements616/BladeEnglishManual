<tbody>
<row>
<entry morerows="1" valign="middle">
<ptxt>B16 (SFTU) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>When shifted to "+"</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Neutral position (M position)</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
<row>
<entry morerows="1" valign="middle">
<ptxt>B51 (SFTD) - Body ground</ptxt>
</entry>
<entry valign="middle">
<ptxt>When shifted to "-"</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Neutral position (M position)</ptxt>
</entry>
<entry valign="middle">
<ptxt>10k Ω or higher</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM000000AVY022X_04_0013" fin="true">OK</down>
<right ref="RM000000AVY022X_04_0010" fin="true">NG</right>
