<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002T_S000D" variety="S000D">
<name>Other Electrical</name>
<ttl id="1002T_S000D_742B1_T003C" variety="T003C">
<name>ETC System</name>
<para id="RM00000365A018X" category="C" type-id="803NL" name-id="CM0PL-01" from="200912">
<dtccode>B15A7</dtccode>
<dtcname>ETC malfunction</dtcname>
<subpara id="RM00000365A018X_01" type-id="33" category="03" proc-id="RM0550J___0000I9Y00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the toll collection (ETC) computer assembly detects a self-diagnosis malfunction.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.13in"/>
<colspec colname="COL2" colwidth="3.91in"/>
<colspec colname="COL3" colwidth="2.04in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>DTC.No.</ptxt>
</entry>
<entry valign="middle">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle">
<ptxt>Inspection Point</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B15A7</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>Internal malfunction of the toll collection (ETC) computer assembly, such as the security IC or memory</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>Toll Collection (ETC) Computer Assembly</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM00000365A018X_02" type-id="51" category="05" proc-id="RM0550J___0000I9Z00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten3>
<ptxt>If B15A7 is output, the toll collection (ETC) computer assembly must be replaced.</ptxt>
</atten3>
</content5>
</subpara>
<subpara id="RM00000365A018X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM00000365A018X_04_0016" proc-id="RM0550J___0000IA300000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05PX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000365A018X_04_0015" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000365A018X_04_0015" proc-id="RM0550J___0000IA200000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="3.00in"/>
<colspec colname="COL2" colwidth="1.13in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Code (B15A7) output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Code (B15A7) not output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM00000365A018X_04_0007" fin="false">A</down>
<right ref="RM00000365A018X_04_0012" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM00000365A018X_04_0007" proc-id="RM0550J___0000IA000000">
<testtitle>Replace Toll Collection (ETC) Computer Assembly</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Replace the toll collection (ETC) computer assembly with a new one. (see <xref label="Seep01" href="RM000002TPV001X"/>)</ptxt>
</test1>
</content6>
<res>
<down ref="RM00000365A018X_04_0010" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000365A018X_04_0010" proc-id="RM0550J___0000IA100000">
<testtitle>Operation Check</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Area Around Antenna</ptxt>
<test2>
<ptxt>Check for any obstructions around the navigation antenna assembly (top surface of the instrument panel), and remove them if present.</ptxt>
</test2>
<test2>
<ptxt>Check for any film, stickers, etc. affixed to the windshield glass, and remove them if present.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Inspect with ETC On-board Unit Tester</ptxt>
<figure>
<graphic graphicname="E195388J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<test2>
<ptxt>Using an ETC on-board unit tester, check that the toll collection (ETC) computer assembly is performing wireless communication normally.</ptxt>
<atten4>
<list1 type="unordered">
<item>
<ptxt>Operate the ETC on-board unit tester at a position approximately 1m from the windshield glass, on a line extending upward and forward of the vehicle from the navigation antenna assembly at an elevation angle of 67±15°. ((The distance between the ETC on-board unit tester and the antenna is only a guide)</ptxt>
</item>
<item>
<ptxt>Point the communication surface of the ETC on-board unit tester toward the navigation antenna assembly.</ptxt>
</item>
<item>
<ptxt>Do not bring the ETC on-board unit tester too close to the navigation antenna assembly, as communication with the tester may be established even if the antenna is disconnected.</ptxt>
</item>
</list1>
</atten4>
</test2>
</test1>
<test1>
<ptxt>Setup</ptxt>
<test2>
<ptxt>Perform setup.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Check Using ETC Card</ptxt>
<test2>
<ptxt>Insert an ETC card into the toll collection (ETC) computer assembly and check that the card is authenticated normally.</ptxt>
</test2>
</test1>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*1</ptxt>
</entry>
<entry valign="middle">
<ptxt>ETC On-board Unit Tester</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>*2</ptxt>
</entry>
<entry valign="middle">
<ptxt>Navigation Antenna Assembly</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM00000365A018X_04_0013" fin="true">NEXT</down>
</res>
</testgrp>
<testgrp id="RM00000365A018X_04_0013">
<testtitle>END</testtitle>
</testgrp>
<testgrp id="RM00000365A018X_04_0012">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY07EX"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
