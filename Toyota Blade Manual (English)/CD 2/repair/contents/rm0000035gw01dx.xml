<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM0000035GW01DX" category="C" type-id="803MB" name-id="653FS-01" from="200912">
<dtccode>B15C2</dtccode>
<dtcname>Vehicle speed signal malfunction</dtcname>
<subpara id="RM0000035GW01DX_01" type-id="31" category="03" proc-id="RM0550J___0000II000000">
<name>Circuit Description</name>
<content5 releasenbr="1">
<ptxt>The vehicle speed pulse signals output from the ABS speed sensors installed on each wheel are converted into a vehicle speed pulse signal by the skid control computer, output to the combination meter assembly as a vehicle speed signal, and input to the navigation receiver assembly.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.03in"/>
<colspec colname="COL2" colwidth="2.83in"/>
<colspec colname="COLSPEC0" colwidth="3.22in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>DTC No.</ptxt>
</entry>
<entry valign="middle">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle">
<ptxt>Inspection Point</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B15C2</ptxt>
</entry>
<entry valign="middle" align="left">
<ptxt>Difference between GPS speed and SPD pulse detected</ptxt>
</entry>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Combination Meter Assembly</ptxt>
</item>
<item>
<ptxt>Navigation Receiver Assembly</ptxt>
</item>
<item>
<ptxt>Vehicle wire harness or connector</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000035GW01DX_02" type-id="32" category="03" proc-id="RM0550J___0000II100000">
<name>Wiring Diagram</name>
<content5 releasenbr="1">
<figure>
<graphic graphicname="E122327J28" width="7.106578999in" height="2.775699831in"/>
</figure>
</content5>
</subpara>
<subpara id="RM0000035GW01DX_03" type-id="51" category="05" proc-id="RM0550J___0000II200000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM0000002RM03SX"/>)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000035GW01DX_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000035GW01DX_04_0006" proc-id="RM0550J___0000II500000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM0000035GW01DX_04_0007" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000035GW01DX_04_0007" proc-id="RM0550J___0000II600000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.71in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>No code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000035GW01DX_04_0002" fin="false">A</down>
<right ref="RM0000035GW01DX_04_0008" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035GW01DX_04_0002" proc-id="RM0550J___0000II300000">
<testtitle>Service Inspection (Sensor Inspection)</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Sensor Check</ptxt>
<test2>
<ptxt>Select "Sensor Check" from Service Inspection - Function Inspection/Adjustment - GPS/Sensor Check screen, actually drive the vehicle, and check that the vehicle speed changes.</ptxt>
<figure>
<graphic graphicname="E122551" width="2.775699831in" height="1.771723296in"/>
</figure>
</test2>
</test1>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.71in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Vehicle speed does not change</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Vehicle speed changes</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</content6>
<res>
<down ref="RM0000035GW01DX_04_0003" fin="false">A</down>
<right ref="RM0000035GW01DX_04_0010" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035GW01DX_04_0003" proc-id="RM0550J___0000II400000">
<testtitle>Inspect Wire Harness and Connector (Combination Meter Assembly - Navigation Receiver Assembly)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09082-00030</s-number>
</sstitem>
<sstitem>
<s-number>09083-00170</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Pre-inspection Preparation</ptxt>
<test2>
<ptxt>Disconnect the combination meter assembly connector.</ptxt>
</test2>
<test2>
<ptxt>Disconnect navigation receiver assembly connector F.</ptxt>
</test2>
</test1>
<test1>
<ptxt>Resistance Inspection</ptxt>
<test2>
<ptxt>Using SST (Toyota electrical tester), measure the resistance between the terminals of the vehicle side wire harness connector.</ptxt>
<spec>
<title>Resistance</title>
<table>
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="1.78in"/>
<colspec colname="COL2" colwidth="1.16in"/>
<colspec colname="COL3" colwidth="1.19in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Tester Connection (Terminal Symbol)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle">
<ptxt>Standard</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>36(+S) - F3(SPD)</ptxt>
</entry>
<entry valign="middle">
<ptxt>Always</ptxt>
</entry>
<entry valign="middle">
<ptxt>Below 1 Ω</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000035GW01DX_04_0009" fin="false">OK</down>
<right ref="RM0000035GW01DX_04_0005" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000035GW01DX_04_0009" proc-id="RM0550J___0000II700000">
<testtitle>Inspect Combination Meter Assembly (Output Waveform)</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Waveform Inspection</ptxt>
<figure>
<graphic graphicname="E195393J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<test2>
<ptxt>Using SST (TaSCAN), inspect the waveform between the connector terminals.</ptxt>
<atten3>
<ptxt>With the connector connected, inspect from the back side of the connector.</ptxt>
</atten3>
<atten4>
<ptxt>Set each range of SST (TaSCAN) as shown in the table.</ptxt>
</atten4>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="1.45in"/>
<colspec colname="COL2" colwidth="2.68in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Item</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Description</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Tester Connection</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>36 (+S) - Body ground</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Tool Setting</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>5 V/DIV、20 ms/DIV</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Condition</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Turn wheel by hand</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>The waveform shown in the illustration is output</ptxt>
</specitem>
</spec>
<atten4>
<ptxt>The cycle varies depending on the wheel rotation speed.</ptxt>
</atten4>
</test2>
</test1>
<table>
<title>Text in Illustrations</title>
<tgroup cols="2">
<colspec colname="COL1" colwidth="0.41in"/>
<colspec colname="COL2" colwidth="3.72in"/>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>*a</ptxt>
</entry>
<entry>
<ptxt>Connector connection condition</ptxt>
<ptxt>(Combination Meter Assembly)</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content6>
<res>
<down ref="RM0000035GW01DX_04_0004" fin="true">OK</down>
<right ref="RM0000035GW01DX_04_0001" fin="true">NG</right>
</res>
</testgrp>
<testgrp id="RM0000035GW01DX_04_0004">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035GW01DX_04_0008">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY07EX"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035GW01DX_04_0010">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035GW01DX_04_0005">
<testtitle>Repair or Replace Wire Harness or Connector</testtitle>
</testgrp>
<testgrp id="RM0000035GW01DX_04_0001">
<testtitle>Go to Meter &amp; Gauge System<xref label="Seep01" href="RM000002YMX000X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
