<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000C_S000O" variety="S000O">
<name>Cooling</name>
<ttl id="1000C_S000O_744GE_T0070" variety="T0070">
<name>Thermostat (2AZ-FE)</name>
<para id="RM0000020WI009X" category="A" type-id="80001" name-id="121DL-00" from="200612">
<name>Removal</name>
<subpara id="RM0000020WI009X_01" type-id="01" category="01">
<s-1 id="RM0000020WI009X_01_0007" proc-id="RM0550J___000030H00000">
<ptxt>Drain Coolant (Toyota Genuine Super Long Life Coolant)
</ptxt>
<content1 releasenbr="1">
<atten2>
<ptxt>To avoid the danger of being burned, do not remove the reservoir tank cap while the engine and radiator are still hot. Liquid and steam will spray out under pressure.</ptxt>
</atten2>
<s2>
<ptxt>Loosen the radiator drain cock plug.</ptxt>
</s2>
<s2>
<ptxt>Remove the radiator cap and drain the coolant.</ptxt>
</s2>
<s2>
<ptxt>Loosen the cylinder block drain cock plug and drain the coolant from the engine.</ptxt>
<figure>
<graphic graphicname="A160380J01" width="7.106578999in" height="4.7836529in"/>
</figure>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI009X_01_0011" proc-id="RM0550J___000033900000">
<ptxt>Remove Radiator Upper Air Deflector
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 clips and the radiator upper air deflector. </ptxt>
</s2>
</content1></s-1>
<s-1 id="RM0000020WI009X_01_0006" proc-id="RM0550J___00003VU00000">
<ptxt>Disconnect Radiator Outlet Hose</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Slide the clamp and disconnect the radiator outlet hose.</ptxt>
<figure>
<graphic graphicname="A129775" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020WI009X_01_0002" proc-id="RM0550J___000038P00000">
<ptxt>Remove Water Inlet</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 nuts and disconnect the water inlet from the cylinder block.</ptxt>
<figure>
<graphic graphicname="A112181" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM0000020WI009X_01_0003" proc-id="RM0550J___000038Q00000">
<ptxt>Remove Thermostat</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the thermostat and gasket.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>