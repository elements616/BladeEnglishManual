</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Set Temperature</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>MAX COLD</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Blower Speed</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>HI</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>A/C Switch</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>ON</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Air Inlet Damper Position</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Recirculation position</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Ambient Temperature</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>25° to 35°C or more</ptxt>
</entry>
</row>
<row>
