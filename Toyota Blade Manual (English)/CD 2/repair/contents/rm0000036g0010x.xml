<subpara id="RM0000036G0010X_04" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000036G0010X_04_0015" proc-id="RM0550J___0000I5800000">
<testtitle>Check Contract Flag</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check Contract Flag</ptxt>
<test2>
<ptxt>Start diagnosis and display the diagnosis inspection menu screen. (see <xref label="Seep01" href="RM0000002RV04DX"/>)</ptxt>
</test2>
<test2>
<ptxt>Select "G Terminal Association Information" on the diagnosis check menu screen to display the G terminal association information screen.</ptxt>
<figure>
<graphic graphicname="E153415" width="2.775699831in" height="1.771723296in"/>
</figure>
</test2>
<test2>
<ptxt>Check that the flag information shown in the illustration is "1".</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.71in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Not "1"</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Is "1"</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036G0010X_04_0016" fin="false">A</down>
<right ref="RM0000036G0010X_04_0019" fin="false">B</right>
</res>
</testgrp>
<testgrp id="RM0000036G0010X_04_0016" proc-id="RM0550J___0000I5900000">
<testtitle>Operate Again</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Perform Contract Processing Again</ptxt>
<test2>
<ptxt>Press G-BOOK.com and perform contract processing again.</ptxt>
</test2>
<test2>
<ptxt>Inspect the problem symptom.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.71in"/>
<colspec colname="COL2" colwidth="1.42in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Return to Normal</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Does not return to normal</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000036G0010X_04_0017" fin="true">A</down>
<right ref="RM0000036G0010X_04_0018" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000036G0010X_04_0017">
<testtitle>END</testtitle>
