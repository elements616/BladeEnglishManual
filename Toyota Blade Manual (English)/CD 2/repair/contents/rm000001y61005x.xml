<tmc-service-inc>
<pub id="RM0550J">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S000K" variety="S000K">
<name>Engine Mechanical</name>
<ttl id="1000A_S000K_74X9V_T00G9" variety="T00G9">
<name>Engine Mounting Insulator Rear (2GR-FE)</name>
<para id="RM000001Y61005X" category="A" type-id="30014" name-id="0725E-00" from="200708">
<name>Installation</name>
<subpara id="RM000001Y61005X_01" type-id="01" category="01">
<s-1 id="RM000001Y61005X_01_0001" proc-id="RM0550J___0000EPU00000">
<ptxt>Install Engine Mounting Insulator Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the engine mounting insulator rear to the front suspension crossmember with the 2 bolts and 2 nuts.</ptxt>
<figure>
<graphic graphicname="A124842" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y61005X_01_0005" proc-id="RM0550J___0000FQH00000">
<ptxt>Connect Engine Mounting Insulator Rear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Connect the engine mounting insulator rear to the engine mounting bracket rear with the bolt.</ptxt>
<figure>
<graphic graphicname="A136940" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>95</t-value1>
<t-value2>969</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000001Y61005X_01_0006" proc-id="RM0550J___0000FPX00000">
<ptxt>Connect Transmission Control Cable Assembly
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the transmission control cable support to the engine mounting insulator RR with the bolt.</ptxt>
<figure>
<graphic graphicname="A178720" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>12</t-value1>
<t-value2>122</t-value2>
</torqueitem>
</torque>
</s2>
</content1></s-1>
<s-1 id="RM000001Y61005X_01_0007" proc-id="RM0550J___0000FQ100000">
<ptxt>Install Engine Under Cover NO.2
</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install engine under cover NO.2 with the 5 clips.</ptxt>
</s2>
</content1></s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>