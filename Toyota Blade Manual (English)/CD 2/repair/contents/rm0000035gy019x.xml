<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="RM0550J">
<servcat id="10">
<name>Body &amp; Electrical</name>
<section id="1002Q_S000F" variety="S000F">
<name>Navigation</name>
<ttl id="1002Q_S000F_746OU_T00CJ" variety="T00CJ">
<name>HDD Navigation System</name>
<para id="RM0000035GY019X" category="C" type-id="803MG" name-id="NS49F-04" from="200912">
<dtccode>B15E1</dtccode>
<dtcname>Media malfunction</dtcname>
<subpara id="RM0000035GY019X_01" type-id="33" category="03" proc-id="RM0550J___0000III00000">
<name>Function Description</name>
<content5 releasenbr="1">
<ptxt>This DTC is output when the signal from the media inserted into the navigation receiver assembly cannot be read.</ptxt>
<table pgwide="1">
<tgroup cols="3" align="center">
<colspec colname="COL1" colwidth="2.36in"/>
<colspec colname="COL2" colwidth="2.36in"/>
<colspec colname="COL3" colwidth="2.36in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>DTC.No.</ptxt>
</entry>
<entry valign="middle">
<ptxt>Diagnosis Description</ptxt>
</entry>
<entry valign="middle">
<ptxt>Inspection Area</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>B15E1</ptxt>
</entry>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Media is not recognized</ptxt>
</item>
<item>
<ptxt>Cannot play</ptxt>
</item>
<item>
<ptxt>Sound skips or noise occurs</ptxt>
</item>
</list1>
</entry>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Media</ptxt>
</item>
<item>
<ptxt>Navigation Receiver Assembly</ptxt>
</item>
</list1>
</entry>
</row>
</tbody>
</tgroup>
</table>
</content5>
</subpara>
<subpara id="RM0000035GY019X_02" type-id="51" category="05" proc-id="RM0550J___0000IIJ00000">
<name>Inspection Procedure</name>
<content5 releasenbr="1">
<atten4>
<ptxt>Depending on the part replaced, setting work may be necessary. (see <xref label="Seep01" href="RM0000002RM03SX"/>)</ptxt>
</atten4>
</content5>
</subpara>
<subpara id="RM0000035GY019X_03" type-id="01" category="01">
<name>Procedure</name>
<testgrp id="RM0000035GY019X_03_0005" proc-id="RM0550J___0000IIM00000">
<testtitle>Clear DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), read the DTCs following the screen. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
</test1>
<test1>
<ptxt>Select "Clear" on the screen display and clear the DTCs following the screen.</ptxt>
</test1>
<test1>
<ptxt>Turn IG OFF.</ptxt>
</test1>
</content6>
<res>
<down ref="RM0000035GY019X_03_0006" fin="false">NEXT</down>
</res>
</testgrp>
<testgrp id="RM0000035GY019X_03_0006" proc-id="RM0550J___0000IIN00000">
<testtitle>Recheck DTC</testtitle>
<content6 releasenbr="1">
<sst>
<sstitem>
<s-number>09991-70201</s-number>
</sstitem>
</sst>
<test1>
<ptxt>Using SST (TaSCAN), check the DTCs again and proceed to the destination below. (see <xref label="Seep01" href="RM000000OCQ05TX"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.67in"/>
<colspec colname="COL2" colwidth="1.46in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>No code output</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000035GY019X_03_0001" fin="false">A</down>
<right ref="RM0000035GY019X_03_0007" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035GY019X_03_0001" proc-id="RM0550J___0000IIK00000">
<testtitle>Check Media for Dirt</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Clean Media</ptxt>
<test2>
<ptxt>Check the media for dirt, and clean it by wiping lightly in a radial direction from the center outward with a soft, dry cloth such as an eyeglass cloth for plastic lenses.</ptxt>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Pressing hard by hand or rubbing with a stiff cloth may scratch the surface.</ptxt>
</item>
<item>
<ptxt>Using solvents such as record spray, antistatic agents, alcohol, benzine or thinner, or chemically treated cloths, may damage the disc and make it unusable.</ptxt>
</item>
</list1>
</atten3>
</test2>
<test2>
<ptxt>Insert the cleaned media and check whether it can be played.</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.67in"/>
<colspec colname="COL2" colwidth="1.46in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<ptxt>Cannot be played normally</ptxt>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<ptxt>Can be played normally</ptxt>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test2>
</test1>
</content6>
<res>
<down ref="RM0000035GY019X_03_0002" fin="false">A</down>
<right ref="RM0000035GY019X_03_0008" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035GY019X_03_0002" proc-id="RM0550J___0000IIL00000">
<testtitle>Check with Other Media</testtitle>
<content6 releasenbr="1">
<test1>
<ptxt>Check whether it can be played on another vehicle of the same model.</ptxt>
</test1>
<test1>
<ptxt>Insert other normal media and check whether it can be played. (see <xref label="Seep01" href="RM00000014J044X"/>)</ptxt>
<spec>
<title>Result</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.67in"/>
<colspec colname="COL2" colwidth="1.46in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Result</ptxt>
</entry>
<entry valign="middle">
<ptxt>Proceed to</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Cannot be played on another vehicle of the same model</ptxt>
</item>
<item>
<ptxt>Other normal media can be played</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>A</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="left">
<list1 type="unordered">
<item>
<ptxt>Can be played on another vehicle of the same model</ptxt>
</item>
<item>
<ptxt>Other normal media cannot be played</ptxt>
</item>
</list1>
</entry>
<entry valign="middle">
<ptxt>B</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</test1>
</content6>
<res>
<down ref="RM0000035GY019X_03_0003" fin="true">A</down>
<right ref="RM0000035GY019X_03_0004" fin="true">B</right>
</res>
</testgrp>
<testgrp id="RM0000035GY019X_03_0003">
<testtitle>Returned to normal (defective media)</testtitle>
</testgrp>
<testgrp id="RM0000035GY019X_03_0007">
<testtitle>Perform Problem Reproduction Test<xref label="Seep01" href="RM000000ABY07EX"/>
</testtitle>
</testgrp>
<testgrp id="RM0000035GY019X_03_0008">
<testtitle>Return to Normal</testtitle>
</testgrp>
<testgrp id="RM0000035GY019X_03_0004">
<testtitle>Replace Navigation Receiver Assembly<xref label="Seep01" href="RM000001XG5006X"/>
</testtitle>
</testgrp>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>