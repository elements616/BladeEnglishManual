<!-- <?xml version="1.0" encoding="UTF-8"?> -->
<!-- XML DTD for TOYOTA EWD -->
<!ENTITY % Number	"NMTOKEN">
<!ENTITY % SCType "( jikou | TMC )">


<!ELEMENT	CategoryList (Category)+>
<!ATTLIST	CategoryList
	ver	CDATA	"1.0"
	type	%SCType;	#REQUIRED
>

<!ELEMENT	Category	(#PCDATA)>
<!ATTLIST	Category
	no		%Number;	#REQUIRED
	code	ID			#REQUIRED
>
