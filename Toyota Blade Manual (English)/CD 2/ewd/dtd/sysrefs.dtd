<!ENTITY % PartsType "(conn | w2w | jb | jbc | jc | gp | sp | fl | relay | name)">
    <!-- 
        conn: connector
        w2w: Wire and Wire
        jb: Junction Block
	jbc: Junction Block Connector
        jc: Junction Connector
        gp: Ground Point
        sp: Splice Point
	fl: Fusible Link
	relay: Relay
	name: Named Item
    -->

<!ENTITY % ID     "CDATA">
<!ENTITY % Sex    "(male | female)">
<!ENTITY % Spec   "CDATA">
<!ENTITY % Number "CDATA">

<!ELEMENT   SysRefs   (part+)>
<!ELEMENT   connector  (pin+)>
<!ELEMENT   pin     (system+)>
<!ELEMENT   system  (#PCDATA)>

<!ATTLIST SysRefs
	ver	CDATA	"1.0"
>

<!ATTLIST connector
	type  %PartsType; #REQUIRED
	id    %ID;	  #REQUIRED
	sex   %Sex;       #IMPLIED
	spec  %Spec;      #IMPLIED
>

<!ATTLIST pin
	no   %Number;    #REQUIRED
>

<!ATTLIST system
	id   %ID;        #REQUIRED
>