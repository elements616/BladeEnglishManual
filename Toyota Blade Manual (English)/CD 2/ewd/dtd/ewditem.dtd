<!-- <?xml version="1.0" encoding="UTF-8"?> -->					
<!-- XML DTD for TOYOTA EWD Item -->					
					
<!-- data entities -->					
<!ENTITY % Number "CDATA">					
<!ENTITY % Spec "CDATA">					
<!ENTITY % Code "NMTOKENS">					
<!ENTITY % FigType	"CDATA">				
					
<!-- Wire color code -->					
<!ENTITY % WireColorCode					
	"(B | BR | DG | G | GR | L | LG | O | P | R | SB | V | W | Y )"				
>					
	<!--				
		B	Black		
		BR	Brown		
		DG	Drak Gray		
		G	Green		
		GR	Gray		
		L	Blue		
		LG	Light Green		
		O	Orange		
		P	Pink		
		R	Red		
		SB	Sky Blue		
		V	Violet		
		W	White		
		Y	Yellow		
	-->				
					
<!ENTITY % ItemType "(conn | w2w | jb | jbc | rb  | relay | jc | gp | sp | fl)">					
	<!--				
		conn: connector			
		w2w: Wire and Wire			
		jb: Junction Block			
		jbc: Junction Block Connector			
		rb:	Relay Block		
		relay: Relay			
		jc: Junction Connector			
		gp: Ground Point			
		sp: Splice Point			
		fl: Fusible Link			
	-->				
<!ENTITY % Sex "(male | female)">					
					
<!-- Element group -->					
<!ENTITY % ItemInfo	"(name,fig?,partNo?,color?,spec?,repairWire?,connectors?)">				
					
<!ELEMENT	EWDItemList (CodedItem|NamedItem )+>				
<!ELEMENT	CodedItem	 %ItemInfo;>			
<!ELEMENT	NamedItem	 %ItemInfo;>			
<!ELEMENT	name	(#PCDATA)>			
<!ELEMENT	fig		(#PCDATA)>		
<!ELEMENT	partNo	(#PCDATA)>			
<!ELEMENT	color	(#PCDATA)>			
<!ELEMENT	spec	(#PCDATA)>			
<!ELEMENT	repairWire	(#PCDATA)>			
<!ELEMENT	connectors	(connector+)>			
<!ELEMENT	connector	(pin*)>			
<!ELEMENT	pin		EMPTY>		
					
					
					
<!ATTLIST EWDItemList					
	ver	CDATA	"1.0"		
>					
					
<!ATTLIST CodedItem					
	code		%Code;	#REQUIRED	
	type	%ItemType; #REQUIRED			
>					
					
<!ATTLIST NamedItem					
	type	%ItemType; #REQUIRED			
>					
					
<!ATTLIST	name				
	code	CDATA		#IMPLIED		
>					
					
<!ATTLIST	fig				
	type	%FigType;	"svgz"		
>					
					
<!ATTLIST	connectors				
	num	%Number;	#IMPLIED		
>					
					
<!ATTLIST	connector				
	sex		%Sex;	#IMPLIED	
	color	CDATA	#IMPLIED		
	partsNo	%Code;	#IMPLIED		
	pinNum	%Number;	#IMPLIED		
>					
					
<!ATTLIST	pin				
	no		%Number;		#REQUIRED
	color	%WireColorCode;	#IMPLIED		
>					
