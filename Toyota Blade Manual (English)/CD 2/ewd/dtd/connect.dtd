<!-- <?xml version="1.0" encoding="UTF-8"?> -->
<!-- XML DTD for TOYOTA EWD connector -->

<!ENTITY % Number "CDATA">
<!ENTITY % PinCode "CDATA">
<!ENTITY % WireColor "CDATA">
<!ENTITY % Spec "CDATA">
    <!-- Wire color code -->
<!ENTITY % PartsType "(conn | w2w | jb | jbc | rb  | relay | jc | gp | sp | fl)">
	<!--
		conn: connector
		w2w: Wire and Wire
		jb: Junction Block
		jbc: Junction Block Connector
		rb:	Relay Block
		relay: Relay
		jc: Junction Connector
		gp: Ground Point
		sp: Splice Point
		fl: Fusible Link
	-->
<!ENTITY % Sex "(male | female)">

<!ELEMENT   ConnectionList (connector)+>
<!ELEMENT   connector    (pin)+>
<!ELEMENT   pin    (junction?, (EMPTY|line?))>
<!ELEMENT   line   (connector)>

<!ELEMENT   junction    (point)+>
<!ELEMENT   point    (pin)+>

<!ATTLIST ConnectionList
	ver	CDATA	"1.0"
>

<!ATTLIST connector
	type			%PartsType; #REQUIRED
	code			%PinCode; #IMPLIED
	sex				%Sex; #IMPLIED
	spec			%Spec; #IMPLIED
>

<!ATTLIST pin
	no            %Number; #IMPLIED
>

<!ATTLIST line
	id			%Number; #REQUIRED
	color		   %WireColor; #REQUIRED
	groupID		%Number; #IMPLIED
	spec		%Spec; #IMPLIED
>

<!ATTLIST point
	 code %PinCode; #IMPLIED
>
