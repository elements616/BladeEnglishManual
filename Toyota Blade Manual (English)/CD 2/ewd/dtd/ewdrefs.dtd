<!-- <?xml version="1.0" encoding="UTF-8"?> -->
<!-- XML DTD for TOYOTA EWD -->

<!ENTITY % ID	"NMTOKEN">
<!ENTITY % Code	"NMTOKENS">
<!ENTITY % Number	"NMTOKEN">
<!ENTITY % Note	"CDATA">

<!ELEMENT	EWDRefs (pub)>

<!ELEMENT	pub	(info, section)>
<!ATTLIST	pub
	no		%Number;	#REQUIRED
>



<!ELEMENT	info	(publish+)>
<!ELEMENT	publish	(#PCDATA)>
<!ATTLIST	publish
	year	%Number;	#REQUIRED
	month	%Number;	#REQUIRED
	day		CDATA		#REQUIRED
>

<!ELEMENT	section	(system+)>
<!ATTLIST	section
	name	%Note;	#REQUIRED
>

<!ELEMENT	system	(title, term+, key*, partslist?)>
<!ATTLIST	system
	sc		%ID;	#REQUIRED
	code	%Code;	#REQUIRED
>

<!ELEMENT	title	(#PCDATA)>
<!ELEMENT	term	EMPTY>
<!ATTLIST	term
	from	%Number;	#REQUIRED
	to		%Note;		#IMPLIED
>

<!ELEMENT	key		(#PCDATA)>
<!ELEMENT	partslist	(parts+)>

<!ELEMENT	parts	(#PCDATA)>
<!ATTLIST	parts
	nameCode	%Code;	#REQUIRED
>


