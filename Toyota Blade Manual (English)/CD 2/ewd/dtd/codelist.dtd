<!ENTITY % Number "CDATA">
    <!-- one or more digits -->
<!ENTITY % InfoType "(system | routing | relay)">
<!ENTITY % PartsType "(conn | w2w | jb | jbc | jc | gp | sp | fl | relay | name)">
    <!-- 
        conn: connector
        w2w: Wire and Wire
        jb: Junction Block
		jbc: Junction Block Connector
        jc: Junction Connector
        gp: Ground Point
        sp: Splice Point
		fl: Fusible Link
		relay: Relay
		name: Named Item
    -->


<!ELEMENT   CodeList    (Code+)>
<!ELEMENT   Code    (#PCDATA)>

<!ATTLIST CodeList
	ver CDATA "1.0"
	type %InfoType;	#REQUIRED
>

<!ATTLIST Code
  type %PartsType; #REQUIRED
  pinNo %Number;	#IMPLIED
>
