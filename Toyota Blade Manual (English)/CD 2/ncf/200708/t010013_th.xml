<ENTRY COLNAME = "1"><PTXT>Fin Pitch [mm]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>2.5 / 2</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
