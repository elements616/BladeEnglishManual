<SECTION SCID = "T010041A146S"><SCTITLE/>

<PARA INFOID = "T010041A146" UPDATE = "ORIGINAL" LDUP = "20Sep2003"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Water Pump</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The water pump has been made more compact and lighter by forming the volute chamber in the cylinder block.</PTXT></ITEM>
<ITEM><PTXT>The water pump is driven by the back side of the V-ribbed belt. Also, by setting the belt center at the bearing center, compactness has been achieved and reliability ensured.</PTXT></ITEM>
<ITEM><PTXT>A stainless steel rotor has been adopted and the vane shape has been optimized, improving efficiency and ensuring reliability.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740049p" WIDTH = "6.917in" HEIGHT = "3.153in" />
</FIGURE>
<SPEC ID = "T010041A146X01" INDSW = "OFF">
