<SECTION SCID = "T010041A147S"><SCTITLE/>

<PARA INFOID = "T010041A147" UPDATE = "ORIGINAL" LDUP = "20Sep2003"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Thermostat</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The thermostat is installed in the water inlet.</PTXT></ITEM>
<ITEM><PTXT>The water outlet is provided at the rear of the cylinder head and is a press-fit pipe type.</PTXT></ITEM>
<ITEM><PTXT>The thermostat is a wax type with a bypass valve, and the flange diameter has been increased (56mm) to ensure sufficient coolant circulation.</PTXT></ITEM></LIST1>
