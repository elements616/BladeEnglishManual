</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Rotor Diameter [mm]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>φ56</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
