<?xml-stylesheet type="text/xsl" href="../xsl/ts_spec_style.xsl"?>
<SCT SCTNBR = "99" CHAPNBR = "9"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script>
<SECTION SCID = "SCID">
<SCTITLE>Specifications/Suspension</SCTITLE>
<PARA INFOID = "INFOID" UPDATE = "ORIGINAL" LDUP = "26Oct2009" INFOTYPE = "SYSTEM" INDSW = "ON" UNPRINT="OFF">
<TITLE>Specifications/Suspension</TITLE>
</PARA>
</SECTION>

<SECTION SCID = "T050004">
<SCTITLE>Front Suspension</SCTITLE>
<PARA INFOID = "T050004001" UPDATE = "ORIGINAL" LDUP = "26Oct2009" INFOTYPE = "PARTS" INDSW = "OFF">
<TITLE>Alignment Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "3" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_01">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "41%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "29%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "29%"/>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Drive Type</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>2WD</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>4WD</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Camber [Degrees]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>-0°10′</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Caster [Degrees]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>5°50′</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Steering Axis Inclination [Degrees]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>12°10′</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>12°00′</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Toe-in [mm]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>2</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE>
</PARA>
</SECTION>

<SECTION SCID = "T050005">
<SCTITLE>Rear suspension</SCTITLE>
<PARA INFOID = "T050005001" UPDATE = "ORIGINAL" LDUP = "26Oct2009" INFOTYPE = "PARTS" INDSW = "OFF">
<TITLE>Alignment Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "3" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "33%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "33%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "33%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" ALIGN = "CENTER"><PTXT>Drive Type</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>2WD Models</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>4WD Models</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" ALIGN = "LEFT"><PTXT>Camber [Degrees]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>-1°00'</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>-1°10'</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" ALIGN = "LEFT"><PTXT>Toe-in [mm]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>2</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE>
</PARA>
</SECTION>
</SCT>