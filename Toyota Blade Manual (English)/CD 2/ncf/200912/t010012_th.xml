<SECTION SCID = "T010256A146S"><SCTITLE/>

<PARA INFOID = "T010256A146" UPDATE = "ORIGINAL" LDUP = "8Dec2003"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Water Pump</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The water pump is driven by the V-ribbed belt and is located on the timing chain cover.</PTXT></ITEM>
<ITEM><PTXT>Small-diameter bearings have been adopted to make the pump more compact.</PTXT></ITEM>
<ITEM><PTXT>A stainless steel rotor has been adopted to improve corrosion resistance and ensure reliability.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740177p" WIDTH = "6.903in" HEIGHT = "2.667in" />
</FIGURE>
