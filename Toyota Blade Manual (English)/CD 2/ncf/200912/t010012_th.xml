</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Valve Opening Temperature [°C]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>82</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Full Open Lift [mm]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>10 or more</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC>
</PARA>
</SECTION>
<SECTION SCID = "T010256A074S"><SCTITLE/>

<PARA INFOID = "T010251A074" UPDATE = "ORIGINAL" LDUP = "8Dec2003"     INFOTYPE = "SYSTEM" INDSW = "ON">
<TITLE>Cooling Fan System</TITLE>
<LIST1><ITEM><PTXT>The engine control computer sends a signal to the cooling fan computer according to the driving conditions to control the fan to the optimum speed, balancing cooling performance and quietness.</PTXT></ITEM></LIST1>
<LIST1><ITEM><PTXT>The fan speed is determined by the engine coolant temperature, A/C operating condition, engine speed and vehicle speed.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740159p" WIDTH = "6.903in" HEIGHT = "5.153in" />
</FIGURE>
</PARA>
