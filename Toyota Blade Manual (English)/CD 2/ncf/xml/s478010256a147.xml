<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Type</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>Bottom Bypass Type</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Valve Opening Temperature [°C]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>82</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
