<?xml-stylesheet type="text/xsl" href="../xsl/toyota_ncf.xsl"?>
<SECTION SCID = "T110002K772S"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script><SCTITLE/>

<PARA INFOID = "T110002K772" UPDATE = "ORIGINAL" LDUP = "19Apr2004"     INFOTYPE = "SYSTEM" INDSW = "ON">
<TITLE>Radar Cruise Control Cancel Function</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>When any of the following operations is performed, controlled driving by the radar cruise control system is cancelled and, except when the main switch is pressed, the radar cruise control system is put in standby.</PTXT></ITEM></LIST1>
<INDICATE ID = "T110002K772I01" INDSW = "OFF">
<TITLE>List of Cancel Operations</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "1" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "99%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Cancel Operation</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Pull the cruise control main switch toward you. (CANCEL switch ON)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Press the main switch of the cruise control main switch. (Main switch OFF)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Depress the brake pedal. (Stop light switch assembly ON)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Shift the shift position to a position other than "D".</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>With the shift position in "D", shift to 3, 2 or 1 by operating the transmission shift switch.</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
</PARA>
</SECTION>