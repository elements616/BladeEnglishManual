<MECA ID = "T120018K549K390" UPDATE = "ORIGINAL" LDUP = "20Oct2009"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Modes and Selection Operations</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>A "Display Mode Select Switch" has been provided in the back guide monitor screen.</PTXT></ITEM>
<ITEM><PTXT>Touching the "display mode selector switch" switches between "course display mode<HINTREF     REFID = "H478120018K549K39001"/>", "parking guide line display mode" and "distance guide line display mode".</PTXT></ITEM></LIST1>
<INDICATE ID = "T120018K549K390I01" INDSW = "OFF">
<TITLE>List of Back Guide Monitor Modes</TITLE>
<TABLE FRAME = "ALL" COLSEP = "0" ROWSEP = "0">
<TGROUP COLS = "4" COLSEP = "0" ROWSEP = "0" TGROUPSTYLE = "Table_11">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "15%" COLSEP = "0"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "35%" COLSEP = "0"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "24%" COLSEP = "0"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "24%" COLSEP = "0"/>
<THEAD>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Mode</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Course Display Mode<HINTREF REFID = "H478120018K549K39001"/>/Parallel Parking Guide Mode<HINTREF     REFID = "H478120018K549K39002"/></PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Parking Guide Line Display Mode</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>Distance Guide Line Display Mode</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Display Content</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Predicted course linked to steering operation, etc.</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Steering turning point (parking guide line)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>Distance guide lines only</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Voice Guidance</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Without<HINTREF REFID = "H478120018K549K39001"/>/With<HINTREF REFID = "H478120018K549K39002"/></PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>No</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>No</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP>
