<ENTRY COLNAME = "3"><PTXT>Function</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>No.1 Clutch</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>C1</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Connects the intermediate shaft and the rear sun gear of the Ravigneaux type planetary gear unit.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>No.2 Clutch</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>C2</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Connects the intermediate shaft and the ring gear of the Ravigneaux type planetary gear unit.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>No.1 Brake</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>B1</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Locks the rotation of the front sun gear of the Ravigneaux type planetary gear unit and the carrier of the UD planetary gear unit.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>No.2 Brake</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>B2</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Locks the rotation of the ring gear of the Ravigneaux type planetary gear unit.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>No.3 Brake</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>B3</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Locks the rotation of the ring gear of the UD planetary gear unit.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>No.1 One-way Clutch</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>F1</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Locks the counterclockwise rotation of the ring gear of the Ravigneaux type planetary gear unit.</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
