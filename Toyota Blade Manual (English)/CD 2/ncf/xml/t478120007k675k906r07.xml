<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T120007K675K906R07" UPDATE = "ORIGINAL" LDUP = "12Apr2004"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>ETC System Status Display Function</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The operating status of the ETC system can be checked by the illumination/extinguishing or blinking of the indicator lights (green light and orange light) of the toll collection (ETC) computer assembly.</PTXT></ITEM>
<ITEM><PTXT>When the ETC menu is displayed on the navigation system display, the operating status of the ETC system is shown in the ETC card message display area.</PTXT></ITEM></LIST1>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TITLE>System Status Display List</TITLE>
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "21%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "12%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "12%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "53%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "1" CONSPIC = "0"><PTXT>ETC Card Message Display Area</PTXT></ENTRY>
<ENTRY NAMEST = "2" NAMEEND = "3" CONSPIC = "0"><PTXT>Toll Collection (ETC) Computer Assembly Indicator Lights</PTXT></ENTRY>
<ENTRY COLNAME = "4" MOREROWS = "1" CONSPIC = "0"><PTXT>ETC On-board Unit Operating Status</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Green Light</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Orange Light</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>No Display</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>ETC system OFF (when power is OFF)</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>No Display</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Illuminated</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Illuminated</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>During initial processing (power OFF → IG ON)</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>ETC Card Not Inserted</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>When the ETC card is not inserted (with IG ON)</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Not Set Up</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Illuminated</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>When the ETC on-board unit registration information is not registered (registration processing has not been performed)</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>System Malfunction</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Blinking</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>When a malfunction occurs in the toll collection (ETC) computer assembly</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>ETC Card Error</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Blinking</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>When a card other than an ETC card is inserted</PTXT></ITEM>
<ITEM><PTXT>When reading of the ETC card fails</PTXT></ITEM>
<ITEM><PTXT>When writing to the ETC card fails</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Checking ETC card</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Blinking</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>When an ETC card or setup card is inserted</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>ETC card inserted</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Illuminated</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>When the toll collection (ETC) computer assembly has confirmed that the ETC card is inserted</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Setup Completed</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>When registration processing is completed</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>