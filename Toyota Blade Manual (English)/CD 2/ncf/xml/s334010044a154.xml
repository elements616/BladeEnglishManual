<PARA INFOID = "T010044A154" UPDATE = "ORIGINAL" LDUP = "20Sep2003"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Starter</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>A compact, lightweight, high-output, high-efficiency PS (Planetary reduction-Segment conductor motor) starter has been adopted.</PTXT></ITEM>
<ITEM><PTXT>A rectangular conductor armature coil has been adopted to reduce size and weight.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740096p" WIDTH = "6.917in" HEIGHT = "2.875in" />
</FIGURE>
<SPEC ID = "T010044A154X01" INDSW = "OFF">
<TITLE>Starter Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_01">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "49%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "49%"/>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Type</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>PS Starter</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Rated Voltage [V]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>12</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Rated Output [kW]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>1.6</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC>

<MECA ID = "T010044A154A217" UPDATE = "ORIGINAL" LDUP = "29Sep2003"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Armature Coil</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>By using bare rectangular wire for the armature coil, the space factor has been improved, increasing starter torque.</PTXT></ITEM>
<ITEM><PTXT>The cylindrical commutator has been eliminated, shortening the armature shaft length.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740097p" WIDTH = "6.917in" HEIGHT = "2.681in" />
</FIGURE>
</MECA>

<MECA ID = "T010044A154A218" UPDATE = "ORIGINAL" LDUP = "29Sep2003"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Field Coil</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Interpolar magnets have been adopted between the field coils. This improves the magnetic circuit and increases the magnetic flux, allowing size reduction and shortening the yoke axial length.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740098p" WIDTH = "6.917in" HEIGHT = "2.917in" />
</FIGURE>
</MECA>
</PARA>
