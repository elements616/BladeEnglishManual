<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T060077A465A504R17" UPDATE = "ORIGINAL" LDUP = "22Apr2004"     MECATYPE = "ACTUATE" INDSW = "OFF">
<TITLE>Hill-start Assist Control Brake Control</TITLE>
<LIST1><ITEM><PTXT>While the brakes are held, the M/C cut solenoid valves (No.1 and No.2) are closed so that a certain portion of the hydraulic pressure generated by the master cylinder remains in the calipers, performing hill-start assist control.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740192c" WIDTH = "6.903in" HEIGHT = "6.333in" />
</FIGURE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TITLE>Hill-start Assist Control Brake Control</TITLE>
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "14%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "28%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "28%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "28%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2"><PTXT>Input Signal</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Not Under Control</PTXT></ENTRY>
<ENTRY COLNAME = "4"><PTXT>During Hill-start Assist Control</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2" VALIGN = "MIDDLE" ALIGN = "LEFT">
<PTXT>M/C Cut Solenoid Valve No.1</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>ON (Pressure Regulation)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2" VALIGN = "MIDDLE" ALIGN = "LEFT">
<PTXT>M/C Cut Solenoid Valve No.2</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>ON (Pressure Regulation)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "2" VALIGN = "MIDDLE" ALIGN = "LEFT">
<PTXT>Front Wheel</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"><PTXT>Holding Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"><PTXT>Pressure Reduction Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>OFF (Closed)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"><PTXT>Wheel Cylinder Hydraulic Pressure</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>-</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>Holds hydraulic pressure</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "2" VALIGN = "MIDDLE" ALIGN = "LEFT">
<PTXT>Rear Wheel</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"><PTXT>Holding Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>←<SUP></SUP></PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"><PTXT>Pressure Reduction Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>OFF (Closed)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"><PTXT>Wheel Cylinder Hydraulic Pressure</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>-</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>Holds hydraulic pressure</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>