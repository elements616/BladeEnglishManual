<PARA INFOID = "T130003K003" UPDATE = "ORIGINAL" LDUP = "28Aug2003" INFOTYPE = "PARTS" INDSW = "ON" SELECT = "Vehicle Outline: Design">
<TITLE>Exterior Colors</TITLE>
<LIST1><ITEM><PTXT>As exterior colors, "White Pearl Crystal Shine (070)" has been newly provided on all models and "Maroon Mica (3N0)" on "Version L", and "Cool White Pearl Crystal Shine (075)" has been discontinued.</PTXT></ITEM></LIST1>
<INDICATE ID = "T130003K003I01" INDSW = "OFF">
<TITLE>New Exterior Colors</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "49%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "49%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Color Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Color No.</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>White Pearl Crystal Shine</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>070</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Maroon Mica</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER" CONSPIC = "0"><PTXT>3N0</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
<INDICATE ID = "T130003K003I02" INDSW = "OFF">
<TITLE>Discontinued Exterior Colors</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "49%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "49%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Color Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Color No.</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Cool White Pearl Crystal Shine</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER" CONSPIC = "0"><PTXT>075</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>

<MECA ID = "T130003K003K701" UPDATE = "ORIGINAL" LDUP = "10Feb2004"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>White Pearl Crystal Shine</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>White Pearl Crystal Shine uses the same paint film structure as conventional pearl mica, but adopts "Crystal Shine" pigment, consisting of alumina flakes coated with titanium oxide, in place of the conventional mica pigment in the mica base.</PTXT></ITEM>
<ITEM><PTXT>Compared to conventional mica, the alumina flakes in the "Crystal Shine" pigment have a uniform particle size and are thin with a smooth surface, so there is less cloudiness and a strongly brilliant color is achieved.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4770324b" WIDTH = "6.903in" HEIGHT = "2.236in" />
</FIGURE>
</MECA>
</PARA>
