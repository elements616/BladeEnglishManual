<?xml-stylesheet type="text/xsl" href="../xsl/toyota_ncf.xsl"?>
<SECTION SCID = "T120016K407S"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script><SCTITLE/>

<PARA INFOID = "T120016K407" UPDATE = "ORIGINAL" LDUP = "16Apr2004"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Accessory Socket (DC12V)</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>An accessory socket that can supply power to DC12V electrical products is now standard on all models. It is installed in the rear console upper section.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740070e" WIDTH = "6.903in" HEIGHT = "2.375in" />
</FIGURE>
<SPEC ID = "T120016K407X01" INDSW = "OFF">
<TITLE>Accessory Socket Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_00">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "53%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "46%"/>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Rated Voltage [V]</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>12</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Maximum Electrical Capacity [W]</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>120 or less</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Maximum Current [A]</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>10 or less</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC>
<INDICATE ID = "T120016K407I02" INDSW = "OFF">
<TITLE>Precautions for Use</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "1" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Frame">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "99%"/>
<TBODY>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Use it with the engine running.</PTXT></ITEM>
<ITEM><PTXT>Use electrical products with a rated voltage of 12V, a maximum electrical capacity of 120W or less and a maximum current of 10A or less.</PTXT></ITEM>
<ITEM><PTXT>Keep the lid closed when not in use.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
</PARA>
</SECTION>