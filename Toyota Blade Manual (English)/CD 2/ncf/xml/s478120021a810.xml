<SECTION SCID = "T120021A810S"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script><SCTITLE/>

<PARA INFOID = "T120021A810" UPDATE = "ORIGINAL" LDUP = "20Jun2005"     INFOTYPE = "SYSTEM" INDSW = "ON">
<TITLE>HDD Navigation DVD Mode Functions</TITLE>
<LIST1><ITEM><PTXT>Marketability has been improved by supporting playback of DVD video (including DVD-R/RW recorded in video mode), DVD-VR (DVD-R/RW recorded in VR mode and CPRM compatible discs) and video CDs.</PTXT></ITEM>
<ITEM><PTXT>Convenience has been improved by allowing DVD chapter selection and subtitle/audio switching to be made by touching the screen directly.</PTXT></ITEM>
<ITEM><PTXT>The DVD screen can be displayed only when the power (ACC or IG) is ON, the parking brake is applied and the vehicle is stopped. In other cases, only the audio can be heard.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "c5930042e" WIDTH = "6.903in" HEIGHT = "2.764in" />
</FIGURE>

<MECA ID = "T120021A810T916" UPDATE = "ORIGINAL" LDUP = "16Feb2009"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Audio Switching</TITLE>
<LIST1><ITEM><PTXT>For discs with multiple audio tracks recorded, the audio can be switched.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a5060132e" WIDTH = "6.903in" HEIGHT = "2.764in" />
</FIGURE>
</MECA>

<MECA ID = "T120021A810T917" UPDATE = "ORIGINAL" LDUP = "16Feb2009"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Subtitle Switching</TITLE>
<LIST1><ITEM><PTXT>For discs with multiple subtitles recorded, the subtitles can be switched.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a5060133e" WIDTH = "6.903in" HEIGHT = "2.764in" />
</FIGURE>
</MECA>

<MECA ID = "T120021A810T918" UPDATE = "ORIGINAL" LDUP = "16Feb2009"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Angle Switching</TITLE>
<LIST1><ITEM><PTXT>For discs containing images shot simultaneously with multiple cameras, the camera angle can be switched. When multiple angles are recorded, the multi-angle mark is displayed.<HINTREF     REFID = "H478120021A810T91801"/></PTXT></ITEM></LIST1>
<HINT>
<LIST1><ITEM><PTXT ID = "H478120021A810T91801">For DVD Video</PTXT></ITEM></LIST1></HINT>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a5060134e" WIDTH = "6.903in" HEIGHT = "2.764in" />
</FIGURE>
</MECA>

<MECA ID = "T120021A810T919" UPDATE = "ORIGINAL" LDUP = "16Feb2009"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Audio Mode Switching</TITLE>
<LIST1><ITEM><PTXT>For discs recorded with multiplex audio, the main audio and sub audio can be switched.<HINTREF     REFID = "H478120021A810T91901"/></PTXT></ITEM></LIST1>
<HINT>
<LIST1><ITEM><PTXT ID = "H478120021A810T91901">For DVD-VR, for Video CD</PTXT></ITEM></LIST1></HINT></MECA>

<MECA ID = "T120021A810T920" UPDATE = "ORIGINAL" LDUP = "16Feb2009"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Playback Mode Switching</TITLE>
<LIST1><ITEM><PTXT>If a playlist has been created on the disc, the playlist can be played.<HINTREF     REFID = "H478120021A810T92001"/></PTXT></ITEM></LIST1>
<HINT>
<LIST1><ITEM><PTXT ID = "H478120021A810T92001">For DVD-VR</PTXT></ITEM></LIST1></HINT>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a5060135e" WIDTH = "6.903in" HEIGHT = "2.764in" />
</FIGURE>
</MECA>

<MECA ID = "T120021A810T921" UPDATE = "ORIGINAL" LDUP = "16Feb2009"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Screen Size Switching</TITLE>
<LIST1><ITEM><PTXT>The screen size can be switched to "Normal", "Wide1" or "Wide2".</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a5060136e" WIDTH = "6.903in" HEIGHT = "2.764in" />
</FIGURE>
</MECA>
</PARA>
