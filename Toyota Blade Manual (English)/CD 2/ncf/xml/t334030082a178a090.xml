<TITLE>Shift and Lock-up Control</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Performs shift point control (including AI-SHIFT control) and lock-up control (including flex lock-up control) according to the shift position, vehicle speed, throttle opening angle and driving conditions.</PTXT></ITEM></LIST1>
<INDICATE ID = "T030082A178A090I01" INDSW = "OFF">
<TITLE>Shift Positions and Shift Patterns</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "25%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "74%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Shift Position</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Shift Pattern</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>D</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd←→4th←→5th←→6th</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>S-6</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd←→4th←→5th←→6th</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>S-5</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd←→4th←→5th</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>S-4</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd←→4th</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>S-3</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>S-2</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>S-1</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
<INDICATE ID = "T030082A178A090I02" INDSW = "OFF">
<TITLE>Lock-up, Flex Lock-up and AI-SHIFT Control Operating Conditions</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "3" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "30%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "42%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "27%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT></PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Shift Range</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Engine Coolant Temperature</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Lock-up Control</PTXT></ENTRY>
