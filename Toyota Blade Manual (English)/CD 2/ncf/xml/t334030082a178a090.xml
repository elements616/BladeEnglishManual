</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Flex Lock-up Control</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>D position and S mode 4 range or higher<HINTREF     REFID = "H334030082A178A09001"/></PTXT></ENTRY>
