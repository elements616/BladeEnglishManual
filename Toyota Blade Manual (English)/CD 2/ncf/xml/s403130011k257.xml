<PARA INFOID = "T130011K257" UPDATE = "ORIGINAL" LDUP = "28Aug2003"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Power Window Motor Assembly</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>A power window ECU (computer) is built into the power window motor.</PTXT></ITEM>
<ITEM><PTXT>The power window motor assembly consists of the power window motor body, connector section, gear section and power window ECU (computer).</PTXT></ITEM>
<ITEM><PTXT>A pulse sensor for the jam protection function is integrated into the power window ECU (computer) and detects the rotation of the power window motor.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740037b" WIDTH = "6.903in" HEIGHT = "2.889in" />
</FIGURE>

<MECA ID = "T130011K257K371" UPDATE = "ORIGINAL" LDUP = "29Aug2003"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Hall IC</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The 2 Hall ICs output pulse signals synchronized with motor rotation to the power window ECU (computer) of their own seat, using a magnet provided on the armature shaft of the power window motor.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740038b" WIDTH = "6.903in" HEIGHT = "2.611in" />
</FIGURE>
</MECA>
</PARA>
