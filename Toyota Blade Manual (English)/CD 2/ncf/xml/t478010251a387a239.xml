<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "25%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2"><PTXT></PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>P, N Position</PTXT></ENTRY>
<ENTRY COLNAME = "4"><PTXT>D Position</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
