<SECTION SCID = "T130004K340S"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script><SCTITLE/>

<PARA INFOID = "T130004K340" UPDATE = "ORIGINAL" LDUP = "29Aug2003"     INFOTYPE = "SYSTEM" INDSW = "ON">
<TITLE>Rear Window Defogger System</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>A rear window defogger has been adopted on cold area specification models. In addition, a rear window defogger with a timer function (approximately 15 minutes) has been adopted.</PTXT></ITEM>
<ITEM><PTXT>The rear window defogger switch is located in the air conditioning control panel.</PTXT></ITEM></LIST1>
<SPEC ID = "T130004K340X01" INDSW = "OFF">
<TITLE>Rear Window Defogger Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "49%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "49%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Item</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Specifications</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Number of Heating Wires [pcs.]</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>12</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Power Consumption [W]</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>111(±10%)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Timer Time <HINTREF REFID = "H334130004K34001"/> [min]</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>15</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP>
<LEGEND><HINT>
<LIST1><ITEM><PTXT ID = "H334130004K34001">With timer function only</PTXT></ITEM></LIST1></HINT></LEGEND></TABLE></SPEC>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740322b" WIDTH = "6.903in" HEIGHT = "5.194in" />
</FIGURE>

<MECA ID = "T130004K340K403" UPDATE = "ORIGINAL" LDUP = "29Aug2003"     MECATYPE = "ACTUATE" INDSW = "OFF">
<TITLE>Rear Window Defogger Operation</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>When the rear window defogger switch is turned ON with IG ON, the operation request signal is sent to the air conditioning computer via LIN communication. When the air conditioning computer that receives this signal turns the rear window defogger relay ON, the rear window defogger heats up.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740303b" WIDTH = "6.903in" HEIGHT = "3.944in" />
</FIGURE>
</MECA>
</PARA>
