<SECTION SCID = "T080005K190S"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script><SCTITLE/>

<PARA INFOID = "T080005K190" UPDATE = "ORIGINAL" LDUP = "14Apr2004"     INFOTYPE = "SYSTEM" INDSW = "ON">
<TITLE>Diagnosis Control</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Panel diagnosis is used, which stores any malfunction that occurs in the display, sensors, actuators, etc., and informs the technician of diagnostic trouble codes through the air conditioning control section.</PTXT></ITEM>
<ITEM><PTXT>By connecting and operating a diagnostic tool (TaSCAN) to the vehicle external terminal (DLC3), diagnostic trouble code output, various data output, etc. can be performed.</PTXT></ITEM></LIST1>
<INDICATE ID = "T080005K190I01" INDSW = "OFF">
<TITLE>Panel Diagnosis Function</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "28%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "71%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Check Item</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Description </PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Indicator Check</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>The indicators of each mode switch and the temperature setting display blink, and the buzzer sounds. (The buzzer sounds on models with HDD navigation system only)</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Sensor Check</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Checks the malfunction status of sensors (past and present).</PTXT></ITEM>
<ITEM><PTXT>Clears past malfunction data.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Actuator Check</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Outputs the actuator check pattern.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
<INDICATE ID = "T080005K190I02" INDSW = "OFF">
<TITLE>TaSCAN Supported Functions</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "28%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "71%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Function Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Description </PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Diagnosis Output Function</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Outputs the display codes for normal and current malfunctions determined by the sensor check of the diagnosis control.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Diagnosis Information Clear Function</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Clears past malfunctions from the sensor check of the diagnosis control.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Data Output Function</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Input values from the outside air and coolant temperature sensors, and the outside temperature display value.</PTXT></ITEM>
<ITEM><PTXT>Blower level.</PTXT></ITEM>
<ITEM><PTXT>Outputs the set temperature (driver side and front passenger side) and the external variable output current.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Actuator Check Function</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Performs control output according to individual operation commands.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Customize Function</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>For details, refer to the customize function in the communication section.<XREF REFID = "S478150004T067"/>
</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
</PARA>
<BIND ID = "T080005K190B" INDSW = "OFF">
<TITLE>Related Parts</TITLE>

<PARA INFOID = "T080008A578" UPDATE = "ORIGINAL" LDUP = "4Apr2005"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Air Conditioner Control Panel</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Due to the discontinuation of Plasmacluster, the Plasmacluster switch has been removed from the control panel.</PTXT></ITEM>
<ITEM><PTXT>The temperature display of the dual mode automatic air conditioner has been changed.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "c5930058e" WIDTH = "6.903in" HEIGHT = "5.514in" />
</FIGURE>
</PARA>
</BIND>
