<TITLE>Exterior Colors</TITLE>
<LIST1><ITEM><PTXT>As exterior colors, "White Pearl Crystal Shine (070)" has been newly provided on all models and "Maroon Mica (3N0)" on "Version L", and "Cool White Pearl Crystal Shine (075)" has been discontinued.</PTXT></ITEM></LIST1>
<INDICATE ID = "T130003K003I01" INDSW = "OFF">
<TITLE>New Exterior Colors</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "49%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "49%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Color Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Color No.</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>White Pearl Crystal Shine</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>070</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Maroon Mica</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER" CONSPIC = "0"><PTXT>3N0</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
