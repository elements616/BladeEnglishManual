<TITLE>Multi-information Display Indications and Functions</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Taking advantage of the dot matrix characteristic of having no restrictions on display patterns, the multi-information display switches between and displays a wide variety of information according to various situations.</PTXT></ITEM></LIST1>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "3" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "24%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "12%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "63%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Display Function Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Power Source Mode</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Main Functions</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Warning Display Mode</PTXT></ENTRY>
<ENTRY COLNAME = "2" MOREROWS = "1" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>-</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1><ITEM><PTXT>Displays the name of the malfunctioning system when a malfunction signal is input from each system.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Diagnostic Trouble Code Display Mode</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Displays the diagnostic trouble code when a request to display a diagnostic trouble code occurs due to a malfunction in certain systems.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Cruise Information Mode</PTXT></ENTRY>
<ENTRY COLNAME = "2" MOREROWS = "6" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>ON</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1><ITEM><PTXT>Pressing the DISP switch switches between display of current fuel consumption / cumulative average fuel consumption / driving range / cumulative average vehicle speed / cumulative driving time.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Outside Temperature Display Mode</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Displays the current outside temperature.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Rheostat Display Mode</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Meter brightness can be adjusted.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Clock Setting Mode</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Hours and minutes can be adjusted.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Date Setting Mode</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Year, month and day can be adjusted.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Clock</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Displays the current time.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Odometer / Trip Meter</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Displays the distance driven.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>