<?xml version="1.0" encoding="UTF-8"?>
<PARA INFOID = "T120018A534" UPDATE = "ORIGINAL" LDUP = "14Apr2004"     INFOTYPE = "SYSTEM" INDSW = "ON">
<TITLE>Back Guide Monitor System Configuration</TITLE>
<LIST1><ITEM><PTXT>The "HDD navigation" with built-in back guide monitor computer has been changed to the 09 model year HDD navigation system.</PTXT></ITEM>
<ITEM><PTXT>With the adoption of the 09 model year HDD navigation system, service tools are supported and diagnostic codes are output, making it easier to inspect the system in the event of a malfunction.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "c5930003e" WIDTH = "6.903in" HEIGHT = "4.528in" />
</FIGURE>
<INDICATE ID = "T120018A534I01" INDSW = "OFF">
<TITLE>Back Guide Monitor System Components</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "3" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "6%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "28%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "64%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>No.</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Name</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Main Functions</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>①</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Rear View Monitor Camera</PTXT>
<PTXT>(Television Camera Assembly)</PTXT>
<PTXT>(Manufactured by Panasonic Corporation)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Installed on the back door outside garnish, it outputs the captured video signal of the area behind the vehicle to the HDD navigation.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>②</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>"HDD Navigation"</PTXT>
<PTXT>(Navigation Receiver Assembly)</PTXT>
<PTXT>(Manufactured by Panasonic Corporation)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Turns the back monitor camera ON/OFF based on signals input from the switches, sensors, etc.</PTXT></ITEM>
<ITEM><PTXT>Displays on the display screen the rear image from the back monitor camera and guide lines calculated and predicted based on vehicle status information such as the steering angle signal.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>③</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Neutral Start Switch</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><LIST1><ITEM><PTXT>Outputs the shift position "R" signal to the HDD navigation.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>④</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Combination Meter</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><LIST1><ITEM><PTXT>Outputs the vehicle speed signal to the "HDD navigation".</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>⑤</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Steering Sensor</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Outputs the shift position signal input from the gateway computer to the "HDD navigation".</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>⑥</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>DLC3</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Performs system diagnosis using the service tool.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>⑦</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Speakers/Tweeters</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Outputs guidance voice when the parallel parking guide mode is selected, using the voice signal from the back guide monitor computer.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
</PARA>