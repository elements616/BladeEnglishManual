<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T060077A465A114R13" UPDATE = "ORIGINAL" LDUP = "16Sep2003"     MECATYPE = "ACTUATE" INDSW = "OFF">
<TITLE>Brake Assist Operation</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Brake assist control directs hydraulic pressure generated by the pump in the brake actuator to each wheel cylinder, generating hydraulic pressure higher than that of the master cylinder.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "k4250216c" WIDTH = "6.917in" HEIGHT = "7.111in" />
</FIGURE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TITLE>Brake Assist Control Operation</TITLE>
<TGROUP COLS = "3" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "33%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "33%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "33%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Input Signal</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Not Under Control</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>During Brake Assist Control</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>M/C Cut Solenoid Valve No.1</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>ON (Pressure Regulation)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>M/C Cut Solenoid Valve No.2</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>ON (Pressure Regulation)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Holding Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Pressure Reduction Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Closed)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Wheel Cylinder Hydraulic Pressure</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Same as master cylinder hydraulic pressure</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Increased above master cylinder hydraulic pressure</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>