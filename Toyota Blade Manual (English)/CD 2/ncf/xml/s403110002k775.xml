<PARA INFOID = "T110002K775" UPDATE = "ORIGINAL" LDUP = "19Apr2004"     INFOTYPE = "SYSTEM" INDSW = "ON">
<TITLE>Radar Cruise Control System Control Status Display</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>In vehicle-to-vehicle distance control mode, the CRUISE operation/warning indicator light illuminates and the set vehicle speed, presence of a preceding vehicle and set vehicle-to-vehicle distance are displayed on the multi-information display.</PTXT></ITEM>
<ITEM><PTXT>In constant speed control mode, the CRUISE operation/warning indicator light illuminates and "Constant speed" and the set vehicle speed are displayed on the multi-information display.</PTXT></ITEM>
<ITEM><PTXT>When a malfunction occurs in the radar cruise control system, the driver is informed of the system malfunction by the CRUISE operation/warning indicator light blinking, the master warning indicator light illuminating, the single-tone buzzer sounding and a warning displayed on the multi-information display.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740369b" WIDTH = "6.903in" HEIGHT = "3.375in" />
</FIGURE>
<INDICATE ID = "T110002K775I01" INDSW = "OFF">
<TITLE>Radar Cruise Control System Control Status Display List</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "5" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "16%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "26%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "25%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "23%"/>
<COLSPEC COLNUM = "5" COLNAME = "5" COLWIDTH = "7%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2" CONSPIC = "0"><PTXT>Control Status</PTXT></ENTRY>
<ENTRY NAMEST = "3" NAMEEND = "4" MOREROWS = "1"><PTXT>Multi-information Display</PTXT></ENTRY>
<ENTRY COLNAME = "5" MOREROWS = "1" CONSPIC = "0"><PTXT><HINTREF     REFID = "H403110002K77501"/>
</PTXT>
<GRAPHIC GRAPHICNAME = "a4740250b" WIDTH = "0.417in" HEIGHT = "0.167in" />
</ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Control Mode</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Main Switch Status</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Non-control Mode</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>OFF / Not under control</PTXT></ENTRY>
<ENTRY NAMEST = "3" NAMEEND = "4"><PTXT>No Display</PTXT></ENTRY>
<ENTRY COLNAME = "5" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "4" CONSPIC = "0"><PTXT>Vehicle-to-vehicle Distance Control Mode</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>ON / Not under control</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Set vehicle-to-vehicle distance not input</PTXT></ITEM>
<ITEM><PTXT>Set vehicle speed not input</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740353b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
<ENTRY COLNAME = "5" MOREROWS = "6" VALIGN = "MIDDLE" CONSPIC = "0">
<PTXT>Illuminated</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>ON / Not under control</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Set vehicle-to-vehicle distance "Long"<HINTREF     REFID = "H403110002K77502"/></PTXT></ITEM>
<ITEM><PTXT>Set vehicle speed not input</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740354b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>ON / Under constant speed control</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>No preceding vehicle</PTXT></ITEM>
<ITEM><PTXT>Set vehicle-to-vehicle distance "Middle"<HINTREF REFID = "H403110002K77502"/></PTXT></ITEM>
<ITEM><PTXT>Set Vehicle Speed<HINTREF REFID = "H403110002K77503"/></PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740355b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>ON / Under follow-up control</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Preceding vehicle present</PTXT></ITEM>
<ITEM><PTXT>Set vehicle-to-vehicle distance "Short"<HINTREF REFID = "H403110002K77502"/></PTXT></ITEM>
<ITEM><PTXT>Set Vehicle Speed<HINTREF REFID = "H403110002K77503"/></PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740356b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>ON / Under follow-up control, approach warning<HINTREF     REFID = "H403110002K77504"/></PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Preceding vehicle present</PTXT></ITEM>
<ITEM><PTXT>Set vehicle-to-vehicle distance "Long"<HINTREF REFID = "H403110002K77502"/></PTXT></ITEM>
<ITEM><PTXT>Items other than the set vehicle speed are displayed in reverse every 0.5 seconds</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740357b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "1" CONSPIC = "0"><PTXT>Constant Speed Control Mode</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>ON / Not under control</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Set vehicle speed not input</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740358b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>ON / Under constant speed control</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Set Vehicle Speed<HINTREF REFID = "H403110002K77503"/></PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740359b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Non-control Mode</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>ON → OFF / Not under control</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Control cancel</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740360b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
<ENTRY COLNAME = "5" CONSPIC = "0"><PTXT>Illuminated → Off</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP>
<LEGEND><HINT>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT ID = "H403110002K77501">CRUISE Operation/Warning Indicator Light</PTXT></ITEM>
<ITEM><PTXT ID = "H403110002K77502">"Long", "Middle" or "Short" is displayed according to the set vehicle-to-vehicle distance.</PTXT></ITEM>
<ITEM><PTXT ID = "H403110002K77503">The set vehicle speed in the table is a display example for 100km/h.</PTXT></ITEM>
<ITEM><PTXT ID = "H403110002K77504">Sounds the skid control buzzer intermittently. (Sounds at 10Hz [ON 10 times in 1 seconds])</PTXT></ITEM></LIST1></HINT></LEGEND></TABLE></INDICATE>

<MECA ID = "T110002K775K066" UPDATE = "ORIGINAL" LDUP = "22Apr2004"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Warning Display (Vehicle-to-vehicle Distance Control Mode Unavailable)</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>When the self-check function of the millimeter wave radar sensor assembly detects dirt on the front of the sensor or on the radar-transmissive grille cover, the single-tone buzzer sounds, the CRUISE operation/warning indicator light blinks, the master warning indicator light illuminates, and "Radar dirty, cleaning required" is displayed on the multi-information display.</PTXT></ITEM>
<ITEM><PTXT>When there is a possibility that the detection performance of the millimeter wave radar sensor assembly may be reduced due to bad weather<HINTREF REFID = "H403110002K775K06601"/>, etc., a single buzzer sounds, the CRUISE operation/warning indicator light blinks, the master warning indicator light comes on, and "Bad weather, cruise unavailable" is shown on the multi-information display.</PTXT></ITEM></LIST1>
<HINT>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT ID = "H403110002K775K06601">When the wipers are operating at HI.</PTXT></ITEM></LIST1></HINT>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TITLE>Radar Cruise Control System Warning Display List</TITLE>
<TGROUP COLS = "5" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "29%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "17%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "21%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "22%"/>
<COLSPEC COLNUM = "5" COLNAME = "5" COLWIDTH = "8%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "1"><PTXT>Warning Item</PTXT></ENTRY>
<ENTRY NAMEST = "2" NAMEEND = "5"><PTXT>In Combination Meter Assembly</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Multi-information Display Indication</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>CRUISE Operation/Warning Indicator Light</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Master Warning</PTXT>
<PTXT>Indicator Light</PTXT></ENTRY>
<ENTRY COLNAME = "5" CONSPIC = "0"><PTXT>Single Tone</PTXT>
<PTXT>Buzzer</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>When dirt adheres to the front of the millimeter wave radar sensor assembly or the radar-transmissive grille cover</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740361b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
<ENTRY COLNAME = "3" MOREROWS = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"
    CONSPIC = "0"><PTXT>Blinking</PTXT></ENTRY>
<ENTRY COLNAME = "4" MOREROWS = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"
    CONSPIC = "0"><PTXT>Illuminated</PTXT></ENTRY>
<ENTRY COLNAME = "5" MOREROWS = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"
    CONSPIC = "0"><PTXT>Sounds 1 time</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>In bad weather (when the wipers are operating at HI)</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740362b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>

<MECA ID = "T110002K775K483" UPDATE = "ORIGINAL" LDUP = "22Apr2004"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Warning Display (Cruise Control Driving Unavailable)</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>When the system self-check function detects any malfunction in the system, the single-tone buzzer sounds, the CRUISE operation/warning indicator light blinks, the master warning indicator light illuminates, and "Check cruise system" is displayed on the multi-information display.</PTXT></ITEM></LIST1>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TITLE>Radar Cruise Control System Warning Display List</TITLE>
<TGROUP COLS = "5" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "29%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "17%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "21%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "22%"/>
<COLSPEC COLNUM = "5" COLNAME = "5" COLWIDTH = "8%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "1"><PTXT>Warning Item</PTXT></ENTRY>
<ENTRY NAMEST = "2" NAMEEND = "5"><PTXT>In Combination Meter Assembly</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Multi-information Display Indication</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>CRUISE Operation/Warning Indicator Light</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Master Warning Indicator Light</PTXT></ENTRY>
<ENTRY COLNAME = "5" CONSPIC = "0"><PTXT>Single Tone</PTXT>
<PTXT>Buzzer</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>When a system malfunction occurs</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0">
<GRAPHIC GRAPHICNAME = "a4740363b" WIDTH = "1.056in" HEIGHT = "0.569in" />
</ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Blinking</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Illuminated</PTXT></ENTRY>
<ENTRY COLNAME = "5" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Sounds 1 time</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>

<MECA ID = "T110002K775K067" UPDATE = "ORIGINAL" LDUP = "22Apr2004"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Return from Warning Display</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The multi-information display, master warning indicator light illumination and CRUISE operation/warning indicator light blinking return to the system control status display when the conditions in the table below are met according to the display content.</PTXT></ITEM></LIST1>
<INDICATE ID = "T110002K775K067I01" INDSW = "OFF">
<TITLE>Radar Cruise Control System Warning Display Return Conditions</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "26%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "73%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Multi-information</PTXT>
<PTXT>Display</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Return Conditions</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Radar Dirty Clean Radar</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When it is determined that there is no longer dirt on the front of the millimeter wave radar sensor assembly or the radar-transmissive grille cover</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Bad weather, cruise unavailable</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When the windshield wiper switch assembly is operated from HI to INT, LO or OFF after the weather improves</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Check Cruise System</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When no malfunction is detected after the engine switch (IG) is turned OFF, the engine is restarted and the set operation is performed again (radar cruise control system ON)</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE></MECA>
</PARA>
