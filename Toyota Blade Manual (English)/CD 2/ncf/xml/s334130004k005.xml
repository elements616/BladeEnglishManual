<PARA INFOID = "T130004K005" UPDATE = "ORIGINAL" LDUP = "29Mar2004"     INFOTYPE = "SYSTEM" INDSW = "ON">
<TITLE>Windshield Deicer System</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>A windshield deicer with a timer function (approximately 15 minutes) has been adopted on cold area specification models.</PTXT></ITEM>
<ITEM><PTXT>The heating elements of the windshield deicer are provided at the front wiper stop position (upper part of the cowl panel) and reversing position (right front pillar), to prevent the front wipers from locking or being damaged by snow and ice accumulated on the windshield glass.</PTXT></ITEM>
<ITEM><PTXT>The windshield deicer switch has a built-in operation indicator light and timer circuit, and is located on the right side of the instrument panel on the driver side.</PTXT></ITEM></LIST1>
<SPEC ID = "T130004K005X01" INDSW = "OFF">
<TITLE>Windshield Deicer Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "49%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "49%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Item</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Specifications</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Power Consumption (W)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>88.2±10</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Timer Time (min.)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>15±3</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC>
