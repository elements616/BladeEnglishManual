<MECA ID = "T130004K005K002" UPDATE = "ORIGINAL" LDUP = "29Mar2004"     MECATYPE = "ACTUATE" INDSW = "OFF">
<TITLE>Windshield Deicer Operation</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>When the windshield deicer switch is turned ON with IG ON, the windshield deicer relay turns ON and the windshield deicer heats up.</PTXT></ITEM></LIST1>
