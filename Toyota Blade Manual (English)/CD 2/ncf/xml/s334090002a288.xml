<PARA INFOID = "T090002A288" UPDATE = "ORIGINAL" LDUP = "16Sep2003"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Disposal Function</TITLE>
<LIST1><ITEM><PTXT>Communication with a disposal tool and a disposal function are provided for disposing of the airbags when the vehicle is scrapped.</PTXT></ITEM></LIST1>

<MECA ID = "T090002A288A127" UPDATE = "ORIGINAL" LDUP = "16Sep2003"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Batch Deployment Connector</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>A batch deployment connector is provided on the center airbag sensor (computer). </PTXT></ITEM>
<ITEM><PTXT>By connecting a special tool to this connector, batch deployment of the airbag system is possible.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740047c" WIDTH = "6.903in" HEIGHT = "4.917in" />
</FIGURE>
</MECA>

<MECA ID = "T090002A288A128" UPDATE = "ORIGINAL" LDUP = "16Sep2003"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Batch Deployment Indication Label</TITLE>
<LIST1><ITEM><PTXT>An information label indicating the mounting location of the center airbag sensor (computer) is affixed above the front passenger door lock striker. For this vehicle, it indicates that the center airbag sensor (computer) is mounted on the floor tunnel at the front of the center console.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740035c" WIDTH = "6.903in" HEIGHT = "4.708in" />
</FIGURE>
</MECA>
</PARA>
</SECTION>