<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T150004T094T096" UPDATE = "ORIGINAL" LDUP = "26May2005"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>List When Using Diagnostic Tool</TITLE>
<LIST1><ITEM><PTXT>Connect the diagnostic tool "TaSCAN" to the DLC3 connector and select "Customize" → "Warning" on the screen.</PTXT></ITEM></LIST1>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "19%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "18%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "48%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "13%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Diagnostic Tool Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Setting </PTXT>
<PTXT>(Initial setting value is listed first)</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Description</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Control ECU</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Taillight Reminder Warning Buzzer</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Sets whether the function that sounds the buzzer when the driver door is opened after turning the power ON (ACC/IG ON) → power OFF (ACC/IG OFF) with the taillights ON is enabled</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4"><PTXT>Meter ECU</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Door Ajar Warning</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Warning/No warning</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets whether the function that sounds the buzzer when locking with the electronic key or door outside handle lock switch/back door lock switch while any door is open is enabled</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4"><PTXT>Main Body ECU</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Key Battery Low Warning</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Sets whether the function that sounds the buzzer when the power source mode is turned OFF after 20 minutes or more have elapsed since the power source mode was turned ON with an electronic key whose battery is low is enabled</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4"><PTXT>Certification ECU</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>