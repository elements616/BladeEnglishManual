<TITLE>ABS with EBD Operation</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Hydraulic pressure control of the 4 wheels is performed by operating the holding and pressure reduction solenoid valves, pump and reservoirs.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "k4250215c" WIDTH = "6.917in" HEIGHT = "4.153in" />
</FIGURE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TITLE>Control Operation</TITLE>
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "25%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "25%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "25%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "25%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>When Not Operating</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Normal Braking</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>-</PTXT></ENTRY>
<ENTRY COLNAME = "4"><PTXT>-</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>When Operating</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Pressure Increase Mode</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Holding Mode</PTXT></ENTRY>
<ENTRY COLNAME = "4"><PTXT>Pressure Reduction Mode</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Holding Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>OFF</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>ON</PTXT></ENTRY>
<ENTRY COLNAME = "4" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Pressure Reduction Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>OFF</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
<ENTRY COLNAME = "4" ALIGN = "CENTER"><PTXT>ON</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Port 1</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>Open</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>Closed</PTXT></ENTRY>
<ENTRY COLNAME = "4" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Port 2</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>Closed</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
<ENTRY COLNAME = "4" ALIGN = "CENTER"><PTXT>Open</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Wheel Cylinder Hydraulic Pressure</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>Apply hydraulic pressure</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>Holds hydraulic pressure</PTXT></ENTRY>
<ENTRY COLNAME = "4" ALIGN = "CENTER"><PTXT>Release hydraulic pressure</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>