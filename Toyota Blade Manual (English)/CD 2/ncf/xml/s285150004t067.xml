<SECTION SCID = "T150004T067S"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script><SCTITLE/>

<PARA INFOID = "T150004T067" UPDATE = "ORIGINAL" LDUP = "25Apr2005"     INFOTYPE = "SYSTEM" INDSW = "ON" SELECT = "Customize">
<TITLE>Air Conditioning Customization</TITLE>
<LIST1><ITEM><PTXT>For air conditioning customization, set each function using the diagnostic tool "TaSCAN".</PTXT></ITEM></LIST1>

<MECA ID = "T150004T067T096" UPDATE = "ORIGINAL" LDUP = "26May2005"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>List When Using Diagnostic Tool</TITLE>
<LIST1><ITEM><PTXT>Connect the diagnostic tool "TaSCAN" to the DLC3 connector and select "Customize" → "Air Conditioning" on the screen.</PTXT></ITEM></LIST1>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "22%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "19%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "45%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "13%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Diagnostic Tool Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Setting</PTXT>
<PTXT>(Initial settings are listed first)</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Description</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Control ECU</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>FOOT/DEF Linkage</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Linked / Not linked</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Setting of the function that automatically switches the air outlet to FOOT/DEF when the outlet is FOOT in AUTO mode</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" MOREROWS = "5"><PTXT>Air Conditioning ECU</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Compressor DEF Linkage</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Linked / Not linked</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Setting of the function that automatically turns the A/C ON with the "FRONT DEF" switch</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Compressor Capacity Change</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets whether the evaporator automatic control function by the externally variable compressor is used</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Set Temperature Shift Value</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>0/+1/+2/-1/-2</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets the value by which the display is increased or decreased relative to the set temperature display</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Blower Level Up during DEF</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets whether the function that automatically increases the blower level when DEF is selected as the air outlet is used</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Plasmacluster Control</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1><ITEM><PTXT>Sets whether the function that periodically switches between clean mode and ion mode is used</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>
</PARA>
<BIND ID = "T150004T067B" INDSW = "OFF">
<TITLE>Related Parts</TITLE>

<PARA INFOID = "T150003K791" UPDATE = "ORIGINAL" LDUP = "21Apr2004"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>DLC3 (Data Link Connector No.3)</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>By connecting the diagnostic tool "TaSCAN" to the vehicle side connector (DLC3: Data Link Connector No.3), each ECU can be accessed via the gateway computer and the various multiplex communication lines. This allows output of DTCs, data monitoring (checking ECU data, etc.), Active Test (driving actuators as desired), customization (setting control programs), etc. For details, refer to the Repair Manual.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740048b" WIDTH = "6.903in" HEIGHT = "3.389in" />
</FIGURE>
</PARA>
</BIND>
</SECTION>