<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T120021A808K126" UPDATE = "ORIGINAL" LDUP = "27Aug2003"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Search</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The following methods are available for calling up maps when making various settings, such as setting a destination and registering memory points.</PTXT></ITEM></LIST1>
<INDICATE ID = "T120021A808K126I01" INDSW = "OFF">
<TITLE>List of Map Call-up Methods</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "18%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "81%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Item</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Method</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Name</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up a map by entering the facility name in kanji, 50-sound kana, alphanumeric characters or symbols.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Grouping List</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>During name search, searched facilities are displayed grouped, such as by chain store.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Facility</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up a map by selecting a facility genre such as station, hotel or dealer.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Address</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up a map by selecting the prefecture and city/ward/town/village name.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Telephone Number</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up a map by entering a telephone number.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Postal Code</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up a map by entering a 7-digit postal code.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Genre</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Subdivides genre items and calls up a map of the location of the facility.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Memory Point</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up a map of a memory point. (Only when memory points are registered)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>History</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up a map of a destination previously set. (Up to 100 entries)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Map Code</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up a map by entering coded position data.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Previous Map</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up the map displayed before the menu screen was displayed.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Around Current Position</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Calls up a map of the area around the current position.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Go Home</PTXT></ENTRY>
<ENTRY COLNAME = "2" MOREROWS = "4"><PTXT>Starts a route search with the registered point as the destination. (Only when memory points are registered)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Around Home</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Around Current Position</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Go to Special Memory</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Around Special Memory</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Set with G</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Displays a destination set using the G-BOOK online service. (Only when subscribed to the G-BOOK online service)</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE></MECA>