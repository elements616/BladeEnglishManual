<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T120025K663T028" UPDATE = "ORIGINAL" LDUP = "16Nov2005"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Average Vehicle Speed Display Mode</TITLE>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740193b" WIDTH = "6.903in" HEIGHT = "1.250in" />
</FIGURE>
<SPEC ID = "T120025K663T028X01" INDSW = "OFF">
<TITLE>Cumulative Average Vehicle Speed Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_01">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "16%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "83%"/>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Display Range</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1 TYPE = "UNORDERED"><ITEM><PTXT>0~300km/h</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Function</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The meter computer calculates and displays the cumulative average vehicle speed from the accumulated engine running time and accumulated driving distance since +B connection or reset.</PTXT></ITEM>
<ITEM><PTXT>With the power source mode ON, the previous data is displayed. (After +B reconnection, 0km/h is displayed.)</PTXT></ITEM>
<ITEM><PTXT>If a communication malfunction or input signal malfunction occurs, the display is blank (no display).</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Reset Operation</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1><ITEM><PTXT>Pressing the DISP switch for approximately 0.8 seconds or more resets the cumulative average vehicle speed data.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC></MECA>