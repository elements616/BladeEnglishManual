<MECA ID = "T080003K071K487" UPDATE = "ORIGINAL" LDUP = "14Apr2004"     MECATYPE = "ACTUATE" INDSW = "OFF">
<TITLE>Mode Position and Door Operation</TITLE>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740040e" WIDTH = "6.903in" HEIGHT = "3.722in" />
</FIGURE>
<INDICATE ID = "T080003K071K487I01" INDSW = "OFF">
<TITLE>Mode Positions and Door Operation List</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "18%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "18%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "16%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "45%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Switching Door</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Control Position</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Door Position</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Operation</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "1" CONSPIC = "0"><PTXT>Fresh/Recirculation Air Damper</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>FRESH</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>A</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Brings in fresh air. (Part of the cabin air is recirculated)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>RECIRC</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>B</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Recirculates cabin air.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Air Mix Damper</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>HOT~COOL</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>C~D</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Varies the mixing ratio of warm and cool air continuously from HOT to COOL.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "4"><PTXT>Mode Switching Damper</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>FACE</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>E/H/K/N/Q/T</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Air blows out from the center registers and side registers.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>BI-LEVEL</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>F/I/L/P/S/T</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Air is blown from the center registers, side registers, foot outlets and rear heater ducts<HINTREF     REFID = "H285080003K071K48701"/>.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>FOOT</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>G/J/M/P/S/U</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Air is blown from the side registers, foot outlets and rear heater ducts<HINTREF     REFID = "H285080003K071K48701"/>. Air also blows out slightly from the defroster.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>FOOT/DEF</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>F/I/M/O/R/V</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Air is blown from the front defroster, side defrosters, side registers, foot outlets and rear heater ducts<HINTREF     REFID = "H285080003K071K48701"/>.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>DEF</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>G/J/M/N/Q/W</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Air blows out from the front defroster, side defrosters and side registers.</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
<HINT>
<LIST1><ITEM><PTXT ID = "H285080003K071K48701">Rear heater ducts on cold area specification models only.</PTXT></ITEM></LIST1></HINT></MECA>

