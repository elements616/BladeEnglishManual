<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Light Name</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Bulb Specifications</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>No.</PTXT></ENTRY>
<ENTRY COLNAME = "5" CONSPIC = "0"><PTXT>Light Name</PTXT></ENTRY>
