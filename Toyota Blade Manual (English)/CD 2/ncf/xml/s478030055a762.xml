<PARA INFOID = "T030055A762" UPDATE = "ORIGINAL" LDUP = "18Feb2005"     INFOTYPE = "SYSTEM" INDSW = "ON">
<TITLE>Shift Lock System Outline</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>A shift lock system has been adopted to prevent incorrect operation of the shift lever.</PTXT></ITEM>
<ITEM><PTXT>The shift lock system is electric on all models, simplifying the construction.</PTXT></ITEM>
<ITEM><PTXT>A shift lock release button is provided on the shift lever housing so that the shift lock mechanism can be released manually when moving the vehicle by towing, etc., allowing for emergencies.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740113p" WIDTH = "6.903in" HEIGHT = "4.361in" />
</FIGURE>
<INDICATE ID = "T030055A762I01" INDSW = "OFF">
<TITLE>Main Components Table</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" ALIGN = "CENTER"
    TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "36%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "63%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Components </PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Function</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" ALIGN = "CENTER"><PTXT>Shift Lock Computer</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>Controls the operation of the shift lock solenoid based on various signals.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" ALIGN = "CENTER"><PTXT>Shift Lock Release Button</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>Manually releases the lock applied by the shift lock solenoid.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" ALIGN = "CENTER"><PTXT>Stop Light Switch  </PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>Outputs the brake signal to the shift lock computer.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" ALIGN = "CENTER"><PTXT>Reverse Position Warning Buzzer</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>Informs the driver by a buzzer that the vehicle is in reverse.</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
</PARA>
