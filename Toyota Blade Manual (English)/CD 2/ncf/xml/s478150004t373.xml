<SECTION SCID = "T150004T373S"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script><SCTITLE/>

<PARA INFOID = "T150004T373" UPDATE = "ORIGINAL" LDUP = "24Jun2008"     INFOTYPE = "SYSTEM" INDSW = "ON" SELECT = "Customize">
<TITLE>Meter Customization</TITLE>
<LIST1><ITEM><PTXT>As meter customization, items for function settings using the diagnostic tool "TaSCAN" have been added.</PTXT></ITEM></LIST1>

<MECA ID = "T150004T373T096" UPDATE = "ORIGINAL" LDUP = "24Jun2008"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>List When Using Diagnostic Tool</TITLE>
<LIST1><ITEM><PTXT>Connect the diagnostic tool "TaSCAN" to the DLC3 connector and select "Customize" → "Meter" on the screen.</PTXT></ITEM></LIST1>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "22%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "20%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "43%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "12%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Diagnostic Tool Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Setting</PTXT>
<PTXT>(Initial settings are listed first)</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Description</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Control ECU</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Eco Drive</PTXT>
<PTXT>Indicator Light</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Setting of the eco drive indicator light display function</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE"><PTXT>Meter</PTXT>
<PTXT>Computer</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>
</PARA>
<BIND ID = "T150004T373B" INDSW = "OFF">
<TITLE>Related Parts</TITLE>

<PARA INFOID = "T150003K791" UPDATE = "ORIGINAL" LDUP = "21Apr2004"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>DLC3 (Data Link Connector No.3)</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>By connecting the diagnostic tool "TaSCAN" to the vehicle side connector (DLC3: Data Link Connector No.3), each ECU can be accessed via the gateway computer and the various multiplex communication lines. This allows output of DTCs, data monitoring (checking ECU data, etc.), Active Test (driving actuators as desired), customization (setting control programs), etc. For details, refer to the Repair Manual.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740048b" WIDTH = "6.903in" HEIGHT = "3.389in" />
</FIGURE>
</PARA>
</BIND>
</SECTION>