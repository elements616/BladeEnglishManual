<SECTION SCID = "T150004T074S"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script><SCTITLE/>

<PARA INFOID = "T150004T074" UPDATE = "ORIGINAL" LDUP = "25Apr2005"     INFOTYPE = "SYSTEM" INDSW = "ON" SELECT = "Customize">
<TITLE>Wireless Door Lock Customization</TITLE>
<LIST1><ITEM><PTXT>For wireless door lock customization, set each function using the diagnostic tool.</PTXT></ITEM></LIST1>

<MECA ID = "T150004T074T096" UPDATE = "ORIGINAL" LDUP = "26May2005"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>List When Using Diagnostic Tool</TITLE>
<LIST1><ITEM><PTXT>Connect the diagnostic tool "TaSCAN" to the DLC3 connector and select "Customize" → "Wireless Door Lock" on the screen.</PTXT></ITEM></LIST1>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "22%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "19%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "44%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "13%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Diagnostic Tool Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Setting</PTXT>
<PTXT>(Initial settings are listed first)</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Description</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Control ECU</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Keyless Answer-back</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets whether the function that flashes the hazard warning lights when the electronic key is operated (lock/unlock) is used</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" MOREROWS = "3"><PTXT>Main Body ECU</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Wireless Main SW</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets whether the function that allows the door locks to be operated (lock/unlock) with the electronic key is used</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Operation Confirmation Buzzer</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1><ITEM><PTXT>Sets whether the function that sounds the buzzer when the electronic key is operated (lock/unlock) is used</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Auto Lock Time Variable</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>30 s / 60 s / 120 s</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets the operation time of the function that automatically locks the doors if no door is opened after unlocking with the electronic key</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>
</PARA>
<BIND ID = "T150004T074B" INDSW = "OFF">
<TITLE>Related Parts</TITLE>

<PARA INFOID = "T150003K791" UPDATE = "ORIGINAL" LDUP = "21Apr2004"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>DLC3 (Data Link Connector No.3)</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>By connecting the diagnostic tool "TaSCAN" to the vehicle side connector (DLC3: Data Link Connector No.3), each ECU can be accessed via the gateway computer and the various multiplex communication lines. This allows output of DTCs, data monitoring (checking ECU data, etc.), Active Test (driving actuators as desired), customization (setting control programs), etc. For details, refer to the Repair Manual.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740048b" WIDTH = "6.903in" HEIGHT = "3.389in" />
</FIGURE>
</PARA>
</BIND>
</SECTION>