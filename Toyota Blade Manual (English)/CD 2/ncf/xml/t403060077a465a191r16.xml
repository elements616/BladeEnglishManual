<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T060077A465A191R16" UPDATE = "ORIGINAL" LDUP = "16Sep2003"     MECATYPE = "ACTUATE" INDSW = "OFF">
<TITLE>Front Wheel Skid Control</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>VSC control directs hydraulic pressure generated by the pump in the brake actuator to each wheel cylinder and controls the brake hydraulic pressure to suppress rear wheel skid or front wheel skid.</PTXT></ITEM>
<ITEM><PTXT>In front wheel skid control, the front wheel brakes and the rear wheel brake on the inner side of the turn are applied.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "k4250173c" WIDTH = "6.917in" HEIGHT = "6.917in" />
</FIGURE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TITLE>VSC Control Operation (Front Wheel Skid Control)</TITLE>
<TGROUP COLS = "6" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "12%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "23%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "13%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "16%"/>
<COLSPEC COLNUM = "5" COLNAME = "5" COLWIDTH = "16%"/>
<COLSPEC COLNUM = "6" COLNAME = "6" COLWIDTH = "16%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2" MOREROWS = "1" CONSPIC = "0"><PTXT>Input Signal</PTXT></ENTRY>
<ENTRY COLNAME = "3" MOREROWS = "1" CONSPIC = "0"><PTXT>Not Under Control</PTXT></ENTRY>
<ENTRY NAMEST = "4" NAMEEND = "6" CONSPIC = "0"><PTXT>During VSC Control</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Pressure Increase Mode</PTXT></ENTRY>
<ENTRY COLNAME = "5" CONSPIC = "0"><PTXT>Holding Mode</PTXT></ENTRY>
<ENTRY COLNAME = "6" CONSPIC = "0"><PTXT>Pressure Reduction Mode</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"
    CONSPIC = "0"><PTXT>M/C Cut Solenoid Valve No.1</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>ON (Pressure Regulation)</PTXT></ENTRY>
<ENTRY COLNAME = "5" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
<ENTRY COLNAME = "6" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"
    CONSPIC = "0"><PTXT>M/C Cut Solenoid Valve No.2</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>ON (Pressure Regulation)</PTXT></ENTRY>
<ENTRY COLNAME = "5" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
<ENTRY COLNAME = "6" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"
    CONSPIC = "0"><PTXT>Front Wheel</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT" CONSPIC = "0">
<PTXT>Holding Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
<ENTRY COLNAME = "5" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>ON (Closed)</PTXT></ENTRY>
<ENTRY COLNAME = "6" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT" CONSPIC = "0">
<PTXT>Pressure Reduction Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Closed)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
<ENTRY COLNAME = "5" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
<ENTRY COLNAME = "6" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>ON (Open)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT" CONSPIC = "0">
<PTXT>Wheel Cylinder Hydraulic Pressure</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>-</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Apply hydraulic pressure</PTXT></ENTRY>
<ENTRY COLNAME = "5" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Holds hydraulic pressure</PTXT></ENTRY>
<ENTRY COLNAME = "6" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Release hydraulic pressure</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "2" VALIGN = "MIDDLE" ALIGN = "LEFT"
    CONSPIC = "0"><PTXT>Rear Wheel</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT" CONSPIC = "0">
<PTXT>Holding Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Open)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←<HINTREF REFID = "H403060077A465A191R1601"/></PTXT></ENTRY>
<ENTRY COLNAME = "5" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>ON (Closed)</PTXT></ENTRY>
<ENTRY COLNAME = "6" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT" CONSPIC = "0">
<PTXT>Pressure Reduction Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>OFF (Closed)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
<ENTRY COLNAME = "5" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>←</PTXT></ENTRY>
<ENTRY COLNAME = "6" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>ON (Open)<HINTREF REFID = "H403060077A465A191R1602"/></PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "LEFT" CONSPIC = "0">
<PTXT>Wheel Cylinder Hydraulic Pressure</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>-</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Apply hydraulic pressure<HINTREF REFID = "H403060077A465A191R1603"/></PTXT></ENTRY>
<ENTRY COLNAME = "5" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Holds hydraulic pressure</PTXT></ENTRY>
<ENTRY COLNAME = "6" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Release hydraulic pressure<HINTREF REFID = "H403060077A465A191R1603"/></PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE>
<HINT>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT ID = "H403060077A465A191R1601">For wheels not under control, the holding solenoid valve is turned ON (closed).</PTXT></ITEM>
<ITEM><PTXT ID = "H403060077A465A191R1602">For wheels not under control, the pressure reduction solenoid valve is turned OFF (closed).</PTXT></ITEM>
<ITEM><PTXT ID = "H403060077A465A191R1603">For wheels not under control, the hydraulic pressure is held.</PTXT></ITEM></LIST1></HINT></MECA>