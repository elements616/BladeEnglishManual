<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T120018K549K437" UPDATE = "ORIGINAL" LDUP = "14Apr2004"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Back Guide Monitor Display Contents</TITLE>
<FIGURE>
<GRAPHIC GRAPHICNAME = "c5930004e" WIDTH = "6.903in" HEIGHT = "3.153in" />
</FIGURE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1"><TITLE>List of Back Guide Monitor Screen Display Contents</TITLE>
<TGROUP COLS = "3" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "5%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "29%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "65%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>No.</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Display</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" ALIGN = "CENTER" CONSPIC = "0">
<PTXT>Description</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>①</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Image Behind Vehicle</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Image of the area behind the vehicle from the back monitor camera.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>②</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Distance Guide Lines (Linked to Steering: Yellow, Red with Black)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Guide lines indicating the distance from the rear end of the bumper. (Approx. 1m - yellow, approx. 50cm - red with black)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>③</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Distance Guide Line (Fixed: Green<HINTREF     REFID = "H478120018K549K43701"/>)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Guide lines indicating the distance from the rear end of the bumper. (Approx. 50cm)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>④</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Vehicle width extension line <HINTREF     REFID = "H478120018K549K43702"/> (green)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>The typical width of a parking space in Japan. (Approx. 2.2m)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>⑤</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Estimated course line <HINTREF     REFID = "H478120018K549K43703"/> (yellow)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>The predicted course of the vehicle calculated from the steering angle.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>⑥</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Parking guide line <HINTREF     REFID = "H478120018K549K43703"/> (green)</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>A line extending part of the outer side of the predicted course when the steering wheel is turned fully to the left or right.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>⑦</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Display Mode Select Switch</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><PTXT>Touching switches between "course display mode<HINTREF     REFID = "H478120018K549K43704"/>", "parking guide line display mode" and "distance guide line display mode".</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>⑧</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Parking Mode Select Switch</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Touching it switches between "Parallel Parking Mode (Parallel Guide Mode)" and "Perpendicular Parking Mode".</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>⑨</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Rear End of Bumper</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><PTXT>The rear end of the bumper that appears in the image when the back guide monitor is displayed.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>⑩</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Caution Message</PTXT></ENTRY>
<ENTRY COLNAME = "3" VALIGN = "MIDDLE"><PTXT>When the shift position is moved to "R" (reverse) and when the screen is switched to the course display mode<HINTREF     REFID = "H478120018K549K43705"/> screen, it blinks for several seconds to alert the driver.</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE>
<HINT>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT ID = "H478120018K549K43701">In the parking guide line display mode and distance guide line display mode, it is red with black.</PTXT></ITEM>
<ITEM><PTXT ID = "H478120018K549K43702">It does not indicate an extension of the width of each individual vehicle. Not displayed when the steering wheel is nearly straight.</PTXT></ITEM>
<ITEM><PTXT ID = "H478120018K549K43703">Estimated course lines and parking guide lines cannot be displayed at the same time.</PTXT></ITEM>
<ITEM><PTXT ID = "H478120018K549K43704">In Perpendicular Parking Mode</PTXT></ITEM>
<ITEM><PTXT ID = "H478120018K549K43705">For the course display mode, refer to "Course Display Mode" in "Back Guide Monitor Modes".<XREF     REFID = "T478120018K549K178"/>
</PTXT></ITEM></LIST1></HINT></MECA>