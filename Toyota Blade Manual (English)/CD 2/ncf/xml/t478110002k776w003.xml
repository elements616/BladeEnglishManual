<INDICATE ID = "T110002K776W003I03" INDSW = "OFF">
<TITLE>Manual Cancel Control</TITLE>
<LIST1><ITEM><PTXT>When any of the following conditions (No.1 to 5) occurs while driving in vehicle-to-vehicle distance control mode, control is cancelled while the set vehicle speed is retained in memory.</PTXT></ITEM></LIST1>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "6%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "93%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>No.</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Condition</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>1</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Stop light switch assembly ON (brake pedal depressed)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>2</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Shift the shift position to a position other than "D"</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>3</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>With the shift position in "D", shift to 3, 2 or 1 gear by operating the transmission shift switch</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>4</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Cruise control main switch CANCEL switch ON</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>5</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Cruise control main switch main switch OFF (the set vehicle speed is cleared)</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE></MECA>