<PARA INFOID = "T120025K191" UPDATE = "ORIGINAL" LDUP = "22Jan2004"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Tachometer</TITLE>
<SPEC ID = "T120025K191X01" INDSW = "OFF">
<TITLE>Tachometer Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_01">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "22%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "77%"/>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Indication Range</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>0 to 8000r/min (200r/min increments)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Red Zone Range</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>6400~8000r/min</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Movement</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Stepper Motor</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC>

<MECA ID = "T120025K191K226" UPDATE = "ORIGINAL" LDUP = "12Apr2004"     MECATYPE = "ACTUATE" INDSW = "OFF">
<TITLE>Tachometer Operation</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Based on the engine speed signal (CAN communication) input from the engine control computer, the meter computer controls the rotation angle, speed and direction of the pointer with the stepper motor driver circuit to indicate the engine speed.</PTXT></ITEM>
<ITEM><PTXT>The meter computer performs initialization control that returns the pointer to the zero position each time power is supplied to the combination meter.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740240b" WIDTH = "6.903in" HEIGHT = "3.222in" /><FIGCAPTION><L ja="コンビネーションメーター">Combination Meter</L><L ja="+IG">+IG</L><L ja="メーターコンピューター">Meter Computer</L><L ja="電源回路">Power Circuit</L><L ja="CAN通信">CAN communication</L><L ja="エンジン回転数信号">Engine speed signal</L><L ja="タコメーター駆動用ステッパーモーター">Tachometer Drive Stepper Motor</L></FIGCAPTION>
</FIGURE>
