<?xml-stylesheet type="text/xsl" href="../xsl/toyota_ncf.xsl"?>
<SECTION SCID = "T080005A794S"><script xmlns="http://www.w3.org/1999/xhtml" src="/_runtime/xslt-polyfill.min.js"></script><SCTITLE/>

<PARA INFOID = "T080005A794" UPDATE = "ORIGINAL" LDUP = "4Apr2005"     INFOTYPE = "SYSTEM" INDSW = "ON" SELECT = "ECU List">
<TITLE>Air Conditioner Control System</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The system wiring diagram and parts list have been changed due to the discontinuation of the Plasmacluster.</PTXT></ITEM></LIST1>
<INDICATE ID = "T080005A794I01" INDSW = "OFF">
<TITLE>Automatic Air Conditioner System Wiring Diagram</TITLE>
<FIGURE>
<GRAPHIC GRAPHICNAME = "c5930070e" WIDTH = "6.903in" HEIGHT = "9.000in" />
</FIGURE>
</INDICATE>
<INDICATE ID = "T080005A794I02" INDSW = "OFF">
<TITLE>Air Conditioner System Parts List</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "37%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "62%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Item</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Description</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Blower Motor</PTXT>
<PTXT>(Blower Assembly)</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Driven according to the target air flow volume calculated by the neural network, blowing air into the cabin.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE" CONSPIC = "0"><PTXT>Servo Motor</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Opens and closes the fresh/recirculation air damper, air mix damper and mode damper.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Flow Control Valve</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Controls the internal pressure of the compressor to provide the optimal discharge displacement.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Magnetic Clutch Relay<HINTREF REFID = "H478080005A79401"/></PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Controls the magnetic clutch to turn the compressor ON/OFF.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Rear Window Defogger Relay</PTXT>
<PTXT>(DEF Relay)</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Receives the rear window defogger switch ON/OFF signal and heats the windshield deicer.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Engine Control Computer</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sends and receives data to and from the air conditioner computer via CAN communication.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Meter Computer</PTXT>
<PTXT>(Combination Meter Assembly)</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sends and receives data to and from the air conditioner computer via CAN communication.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Air Conditioner Computer</PTXT>
<PTXT>(Air Conditioning Amplifier Assembly)</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Performs automatic air conditioning control based on signals from various switches, sensors, etc.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Air Conditioner Control Panel</PTXT>
<PTXT>(Air Conditioning Control Panel Assembly)</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sends switch signals to the air conditioner computer and receives indicator display signals.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Evaporator Fin Sensor</PTXT>
<PTXT>(Cooler Thermistor NO.1)</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Detects the evaporator surface temperature.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Ambient Temperature Sensor</PTXT>
<PTXT>(Cooler Thermistor [Ambient Temperature Sensor])</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Detects the outside air temperature and outputs it to the air conditioner computer via the meter computer.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Pressure Sensor</PTXT>
<PTXT>(Air Conditioning</PTXT>
<PTXT>Tube &amp; Accessory Assembly)</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Detects the refrigerant pressure.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Room Temperature Sensor</PTXT>
<PTXT>(Cooler Thermistor [Room Temperature Sensor])</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Detects the cabin temperature.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Solar Sensor</PTXT>
<PTXT>(Cooler Thermistor [Solar Sensor])</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Detects the amount of sunlight.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Lock Sensor<HINTREF REFID = "H478080005A79401"/></PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Detects the compressor pulley speed.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP>
<LEGEND><HINT>
<LIST1><ITEM><PTXT ID = "H478080005A79401">2GR-FE engine models only</PTXT></ITEM></LIST1></HINT></LEGEND></TABLE></INDICATE>
</PARA>
</SECTION>