<MECA ID = "T030082A178A090" UPDATE = "ORIGINAL" LDUP = "16Sep2003"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Shift and Lock-up Control</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Performs shift point control (including AI-SHIFT control) and lock-up control (including flex lock-up control) according to the shift position, vehicle speed, throttle opening angle and driving conditions.</PTXT></ITEM></LIST1>
<INDICATE ID = "T030082A178A090I01" INDSW = "OFF">
<TITLE>Shift Ranges and Shift Patterns</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "25%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "74%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Shift Range</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Shift Pattern</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>D</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd←→4th←→5th←→6th</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>D-6</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd←→4th←→5th←→6th</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>D-5</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd←→4th←→5th</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>D-4</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd←→4th</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>D-3</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd←→3rd</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>D-2</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st←→2nd</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>D-1</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1st</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
<INDICATE ID = "T030082A178A090I02" INDSW = "OFF">
<TITLE>Lock-up, Flex Lock-up and AI-SHIFT Control Operating Conditions</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "3" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "30%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "45%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "24%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Control</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Shift Range</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Engine Coolant Temperature</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Lock-up Control</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>D position 4 range or higher, M mode 2 or higher</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>60°C or higher<HINTREF     REFID = "H478030082A178A09001"/></PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Flex Lock-up Control</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>D position 4 range or higher<HINTREF     REFID = "H478030082A178A09002"/></PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>70°C or higher<HINTREF     REFID = "H478030082A178A09003"/></PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>AI-SHIFT Control</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>D Position</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>-</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
<HINT>
<LIST1><ITEM><PTXT ID = "H478030082A178A09001">Operating condition for D position only</PTXT></ITEM>
<ITEM><PTXT ID = "H478030082A178A09002">Flex lock-up control during acceleration operates in all gears in the D position and in 2 or higher during range selection control in the D position. In addition, flex lock-up control during deceleration operates in 4, 5 and 6.</PTXT></ITEM>
<ITEM><PTXT ID = "H478030082A178A09003">Operating conditions for flex lock-up control during deceleration only</PTXT></ITEM></LIST1></HINT></MECA>