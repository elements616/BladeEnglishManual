<TITLE>List When Using Diagnostic Tool</TITLE>
<LIST1><ITEM><PTXT>Connect the diagnostic tool "TaSCAN" to the DLC3 connector and select "Customize" → "Illumination" on the screen.</PTXT></ITEM></LIST1>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "23%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "19%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "43%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "13%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Diagnostic Tool Name</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Setting</PTXT>
<PTXT>(Initial settings are listed first)</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Description</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Control ECU</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Dome Light On at Unlock</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets whether the function that automatically turns on the interior light in conjunction with door unlocking by the electronic key is used when the interior light setting is DOOR</PTXT></ITEM></LIST1></ENTRY>
<ENTRY COLNAME = "4" MOREROWS = "4"><PTXT>Main Body ECU</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Dome Light On Time</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>15 s / 7.5 s / 30 s</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets the time until the interior light automatically turns off after all doors are closed when the interior light setting is DOOR</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Dome Light On at ACC OFF</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><LIST1 TYPE = "UNORDERED"><ITEM>
<PTXT>Sets whether the function that automatically turns on the interior light when the IG is turned from ACC to OFF is used when the interior light setting is DOOR</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Illumination On</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Sets whether the function that turns on the interior light is used</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Lounge Illumination Dimmed Lighting</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>With Function/Without Function</PTXT></ENTRY>
<ENTRY COLNAME = "3"><LIST1 TYPE = "UNORDERED"><ITEM><PTXT>Sets whether the function that lights the interior light dimmed when the power switch is ON and the shift position is other than "P" is used</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></MECA>