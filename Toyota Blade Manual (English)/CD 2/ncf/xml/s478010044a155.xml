<PARA INFOID = "T010044A155" UPDATE = "ORIGINAL" LDUP = "20Sep2003"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Alternator</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>A compact, lightweight, high-output, high-efficiency segment conductor type alternator has been adopted.</PTXT></ITEM>
<ITEM><PTXT>A segment joining method, in which segment conductors (rectangular copper wire) are inserted and welded, has been adopted for the stator winding method.</PTXT></ITEM>
<ITEM><PTXT>A clutch has been provided in the alternator pulley, reducing accessory belt friction to improve fuel economy.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740053p" WIDTH = "6.903in" HEIGHT = "3.361in" />
</FIGURE>
<SPEC ID = "T010044A155X01" INDSW = "OFF">
<TITLE>Alternator Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "49%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "49%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT></PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Segment Conductor (SE0)</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Rated Output [A]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>100</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Rated Voltage [V]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>12</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Regulator Adjusting Voltage [V] (5000r/min,10A,25°C)</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>12.2~15.3</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Output Start Speed [r/min]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>1500 or less</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Maximum Allowable Speed [r/min]</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>18000</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC>

<MECA ID = "T010044A155A302" UPDATE = "ORIGINAL" LDUP = "20Jul2004"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Alternator Pulley</TITLE>
<LIST1><ITEM><PTXT>A helical coil-shaped clutch located between the outer and inner races of the pulley transmits torque to the alternator only in the engine's forward rotation direction, reducing the load on the accessory belt.</PTXT></ITEM>
<ITEM><PTXT>Compactness has been achieved by integrating the inner race with the nut that fastens it to the alternator shaft.</PTXT></ITEM>
<ITEM><PTXT>A plastic cap is provided on the front of the pulley to cover the inside and prevent the entry of muddy water, etc., ensuring reliability in harsh environments.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740099p" WIDTH = "6.972in" HEIGHT = "4.333in" />
</FIGURE>
</MECA>

<MECA ID = "T010044A155A219" UPDATE = "ORIGINAL" LDUP = "8Dec2003"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Stator Coil</TITLE>
<LIST1><ITEM><PTXT>A segment joining method, in which segment conductors (rectangular copper wire) are inserted and welded, has been adopted for the stator winding method. This achieves compact size, high output and high efficiency. Also, mesh-like ventilation gaps have been provided between the coil ends, and the inner surface of the coil ends that receives the cooling air has been smoothed, creating a smooth, interference-free air flow that improves cooling and reduces wind noise.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740100p" WIDTH = "6.903in" HEIGHT = "2.347in" />
</FIGURE>
</MECA>
</PARA>
