<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "22%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "44%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2"><PTXT></PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>2AZ-FE</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2"><PTXT>No-load Speed [r/min]</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>650</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY NAMEST = "1" NAMEEND = "2"><PTXT>With Electrical Load [r/min]</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>740</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
