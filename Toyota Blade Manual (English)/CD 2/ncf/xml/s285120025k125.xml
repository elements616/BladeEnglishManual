<PARA INFOID = "T120025K125" UPDATE = "ORIGINAL" LDUP = "22Jun2006"     INFOTYPE = "SYSTEM" INDSW = "ON" SELECT = "Vehicle Outline: Design">
<TITLE>Combination Meter</TITLE>
<LIST1><ITEM><PTXT>A titanium-tone 4-dial analog meter has been adopted, expressing unique individuality and a refined feel.</PTXT></ITEM>
<ITEM><PTXT>A large multi-information display that shows various information using characters, numbers and graphics is located at the upper center of the combination meter.</PTXT></ITEM>
<ITEM><PTXT>An Eco Drive indicator has been adopted to support eco-friendly driving.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740154b" WIDTH = "6.903in" HEIGHT = "2.778in" /><FIGCAPTION><L ja="07年1月 12:34 012348km">2007/01 12:34 012348 km</L><L ja="160 180">160 180</L><L ja="注）イラストは、すべてのインジケーターランプを表現した代表例です。">Note) The illustration is a representative example showing all indicator lights.</L></FIGCAPTION>
</FIGURE>

<MECA ID = "T120025K125K144" UPDATE = "ORIGINAL" LDUP = "12Apr2004"     MECATYPE = "GENERAL" INDSW = "OFF">
