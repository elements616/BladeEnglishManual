<MECA ID = "T030082A102A355" UPDATE = "ORIGINAL" LDUP = "17May2005"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Linear Solenoid Valve</TITLE>
<LIST1><ITEM><PTXT>Linear solenoid valves have been provided for clutch engagement pressure control (SL1/SL2), lock-up clutch control (SLU), line pressure control (SLT) and brake engagement pressure control (SL3/SL4).</PTXT></ITEM>
<ITEM><PTXT>By directly controlling the hydraulic pressure of each clutch and brake with high-flow linear solenoid valves (SL1,SL2,SL3,SL4), improved shift response and reduced shift shock through shorter oil passages, as well as a simplified structure through fewer components, have been achieved.</PTXT></ITEM>
<ITEM><PTXT>A filter has been installed at the tip of the ON/OFF solenoid valve (SL) to achieve excellent reliability.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740247p" WIDTH = "6.917in" HEIGHT = "3.181in" />
</FIGURE>
<INDICATE ID = "T030082A102A355I01" INDSW = "OFF">
<TITLE>Linear Solenoid Valve Functions</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "27%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "72%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Solenoid Valve</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Function</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Linear Solenoid Valve (SL1)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1><ITEM><PTXT>Controls the C1 clutch hydraulic pressure.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Linear Solenoid Valve (SL2)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1><ITEM><PTXT>Controls the C2 clutch hydraulic pressure.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Linear Solenoid Valve (SL3)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1><ITEM><PTXT>Controls the B1 brake hydraulic pressure.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Linear Solenoid Valve (SL4)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1><ITEM><PTXT>Controls the B3 brake hydraulic pressure.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Linear Solenoid Valve (SLU)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1><ITEM><PTXT>Controls the lock-up clutch hydraulic pressure.</PTXT></ITEM>
<ITEM><PTXT>Controls the B2 brake hydraulic pressure. (S-1 range only)</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Linear Solenoid Valve (SLT)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1><ITEM><PTXT>Controls the line pressure.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>ON/OFF Solenoid Valve (SL)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><LIST1><ITEM><PTXT>Switches the lock-up relay valve.</PTXT></ITEM>
<ITEM><PTXT>Switches the B2 brake hydraulic pressure.</PTXT></ITEM></LIST1></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE>
