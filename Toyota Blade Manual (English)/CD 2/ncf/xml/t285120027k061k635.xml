<TITLE>Illuminated Entry Control Function</TITLE>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740037e" WIDTH = "6.903in" HEIGHT = "3.819in" />
</FIGURE>
<INDICATE ID = "T120027K061K635I01" INDSW = "OFF">
<TITLE>Illuminated Entry Control Function List</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "3" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "5%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "62%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "31%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>No.</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Vehicle Condition</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Condition of Each Light<HINTREF REFID = "H285120027K061K63501"/></PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>1</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When any door is unlocked with the power source mode (IG) OFF and all doors closed and locked.</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Illuminates for 15 seconds (including fade-in), then turns off (fade-out)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>2</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When any door is closed from the open state with the power source mode (IG) ON.</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Off (fade-out)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>3</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When the power source mode is changed from (IG) ON to (IG) OFF with all doors closed.</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Illuminates for 15 seconds (including fade-in), then turns off (fade-out)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>4</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When any door is closed from the open state with the power source mode (IG) OFF.</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Illuminates for 15 seconds (including fade-in), then turns off (fade-out)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>5</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When the electronic key is recognized outside the vehicle with the power source mode (IG) OFF and all doors closed and locked.</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Illuminates for 15 seconds (including fade-in), then turns off (fade-out)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>6</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When the power source mode is changed to (IG) ON while the lamps are illuminated by the timer with the power source mode (IG) OFF.</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Off (fade-out)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>7</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When all doors are closed and locked while the lamps are illuminated by the timer with the power source mode (IG) OFF.</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Off (fade-out)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>8</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When any door is opened while the lamps are off.</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>On (fade-in)</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP>
<LEGEND><HINT>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT ID = "H285120027K061K63501">The lights refer to the front personal light, room light and engine switch illumination.</PTXT></ITEM></LIST1></HINT></LEGEND></TABLE></INDICATE></MECA>