<PARA INFOID = "T120025K081" UPDATE = "ORIGINAL" LDUP = "29Jun2006"     INFOTYPE = "PARTS" INDSW = "ON">
<TITLE>Odometer/Trip Meter</TITLE>
<SPEC ID = "T120025K081X01" INDSW = "OFF">
<TITLE>Odometer Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_01">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "22%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "77%"/>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Display Range</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>0~999999km</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Minimum Unit</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>1km</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>When Display Overflows</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Holds at 999999</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Movement</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>LCD (Liquid Crystal Display)</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC>
<SPEC ID = "T120025K081X02" INDSW = "OFF">
<TITLE>Trip Meter A/B Specifications</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_01">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "22%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "77%"/>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Display Range</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>0.0~9999.9km</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Minimum Unit</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>0.1km</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>When Display Overflows</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Returns from 9999.9 to 0.0 and continues accumulating</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Display Reset Operation</PTXT>
<PTXT>("0.0km" displayed)</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Press the odo/trip select switch for approximately 0.8 seconds or more.</PTXT>
<PTXT>→ Measurement starts again from the time of reset.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Movement</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>LCD (Liquid Crystal Display)</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>The modes are switched by pressing the odo/trip select switch located in the combination meter, and are displayed in the order odometer → trip meter A → trip meter B.</PTXT></ITEM>
<ITEM><PTXT>When the taillights are illuminated, the display switches to rheostat display mode.<XREF     REFID = "S478120025Aa36"/>
</PTXT></ITEM></LIST1>
