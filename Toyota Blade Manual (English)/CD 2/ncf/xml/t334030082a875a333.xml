<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T030082A875A333" UPDATE = "ORIGINAL" LDUP = "9Aug2005"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>NAVI AI-SHIFT Fail-safe Function</TITLE>
<LIST1><ITEM><PTXT>A fail-safe function that stops control if any malfunction occurs in the navigation system or ECT system is provided. When a malfunction occurs, control is immediately prohibited or switched to control using only road gradient information.</PTXT></ITEM></LIST1>
<INDICATE ID = "T030082A875A333I01" INDSW = "OFF">
<TITLE>Fail-safe List</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "59%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "40%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Malfunction Item</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Action</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Transmission output speed sensor malfunction</PTXT></ENTRY>
<ENTRY COLNAME = "2" MOREROWS = "3" VALIGN = "MIDDLE"><PTXT>NAVI AI-SHIFT prohibited</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Accelerator opening signal malfunction</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Transmission solenoid malfunction</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Communication malfunction between transmission computer and engine control computer</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>GPS malfunction</PTXT></ENTRY>
<ENTRY COLNAME = "2" MOREROWS = "3" VALIGN = "MIDDLE"><PTXT>Switch to control using only road gradient information</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Navigation vehicle speed signal malfunction</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Gyro sensor malfunction</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Communication malfunction between engine control computer and navigation computer</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE></MECA>