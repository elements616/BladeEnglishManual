<INDICATE ID = "T010054A069I05" INDSW = "OFF">
<TITLE>Actuator List</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "2" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "28%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "71%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Device</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Function</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Main Relay</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Supplies power to the system.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Circuit Opening Relay</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Supplies power to the fuel pump system.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Fuel Injector</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Injects the optimum amount of fuel at the optimum timing.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>A/F Sensor Heater</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Heats the A/F sensor to promote feedback control.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>O<SUB>2</SUB>Sensor Heater</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>O<SUB>2</SUB>Heats the sensor to promote feedback control.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Electronic Throttle Motor</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Controls the throttle valve opening angle according to driving conditions.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>Ignition Coil with Igniter</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE"><PTXT>Turns the ignition coil current ON/OFF at the optimum timing.</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" VALIGN = "MIDDLE"><PTXT>OCV for VVT-i</PTXT></ENTRY>
