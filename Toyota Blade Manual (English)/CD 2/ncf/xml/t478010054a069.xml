<?xml version="1.0" encoding="UTF-8"?>
<PARA INFOID = "T010054A069" UPDATE = "ORIGINAL" LDUP = "25Sep2003"     INFOTYPE = "PARTS" INDSW = "ON" SELECT = "ECU List">
<TITLE>Engine Control System General</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>TCCS (TOYOTA Computer Controlled System), which comprehensively and highly accurately controls fuel injection control (EFI), ignition timing control (ESA), throttle control (ETCS-i), VVT-i control, etc., has been adopted to improve performance, output, fuel economy and emission performance.</PTXT></ITEM>
<ITEM><PTXT>CAN communication has been adopted as the method of communication with other computers.<XREF REFID = "S478150003K792"/>
</PTXT></ITEM>
<ITEM><PTXT>New diagnosis and fail-safe functions have been provided for serviceability and safety.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740004p" WIDTH = "6.903in" HEIGHT = "4.972in" />
</FIGURE>
<INDICATE ID = "T010054A069I01" INDSW = "OFF">
