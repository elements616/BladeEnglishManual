<ENTRY COLNAME = "1"><PTXT></PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Main Fan</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Sub Fan</PTXT></ENTRY>
