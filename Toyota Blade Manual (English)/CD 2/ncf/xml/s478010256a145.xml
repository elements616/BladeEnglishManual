<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>←</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1"><PTXT>Number of Blades</PTXT></ENTRY>
<ENTRY COLNAME = "2" ALIGN = "CENTER"><PTXT>7</PTXT></ENTRY>
<ENTRY COLNAME = "3" ALIGN = "CENTER"><PTXT>9</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></SPEC>
<SPEC ID = "T010256A145X02" INDSW = "OFF">
