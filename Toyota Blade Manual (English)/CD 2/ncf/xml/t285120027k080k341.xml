<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T120027K080K341" UPDATE = "ORIGINAL" LDUP = "22Jan2004"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Fail-safe Function of Auto Leveling System</TITLE>
<LIST1 TYPE = "UNORDERED"><ITEM><PTXT>When the headlight leveling computer detects a system malfunction, it performs fail-safe as shown in the table and illuminates the headlight leveling warning indicator light in the combination meter.</PTXT></ITEM></LIST1>
<FIGURE>
<GRAPHIC GRAPHICNAME = "a4740013e" WIDTH = "6.903in" HEIGHT = "2.931in" />
</FIGURE>
<INDICATE ID = "T120027K080K341I01" INDSW = "OFF">
<TITLE>Fail-safe Function List</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "25%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "25%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "34%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "14%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Malfunction Item</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Malfunction Detection Condition</PTXT></ENTRY>
<ENTRY COLNAME = "3" CONSPIC = "0"><PTXT>Control Content</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Warning Indicator Light</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Power Supply Overvoltage</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Input terminal voltage of headlight leveling computer is 18.5V or more</PTXT></ENTRY>
<ENTRY COLNAME = "3" MOREROWS = "5" CONSPIC = "0"><PTXT>Stops output of control signal to actuator</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Power Supply Low Voltage</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Input terminal voltage of headlight leveling computer is 9V or less</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Vehicle Speed Limit Exceeded</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Vehicle speed is 180km/h or more</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "1" CONSPIC = "0"><PTXT>Height Control Sensor Malfunction</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Signal Malfunction</PTXT></ENTRY>
<ENTRY COLNAME = "4" MOREROWS = "1" CONSPIC = "0"><PTXT>Illuminated</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>Open circuit, short circuit, voltage malfunction</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "1" CONSPIC = "0"><PTXT>Reset While Driving</PTXT></ENTRY>
<ENTRY COLNAME = "2" CONSPIC = "0"><PTXT>When the driving condition determined immediately after IG ON is driving</PTXT></ENTRY>
<ENTRY COLNAME = "4" CONSPIC = "0"><PTXT>Off</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE></MECA>