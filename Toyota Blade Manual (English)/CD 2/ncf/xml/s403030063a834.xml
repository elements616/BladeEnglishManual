<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "33%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Downshift</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Lower Vehicle Speed Limit [km/h]<HINTREF REFID = "H403030063A834A59501"/></PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Upper Vehicle Speed Limit [km/h]<HINTREF REFID = "H403030063A834A59501"/></PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
