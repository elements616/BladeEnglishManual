<?xml version="1.0" encoding="UTF-8"?>
<MECA ID = "T030082T358T436" UPDATE = "ORIGINAL" LDUP = "5Oct2009"     MECATYPE = "GENERAL" INDSW = "OFF">
<TITLE>Gears Available During Range Selection Control in D Position</TITLE>
<LIST1><ITEM><PTXT>As shown in the table below, shifting is performed automatically according to speed and driving conditions within the selected shift range.</PTXT></ITEM></LIST1>
<INDICATE ID = "T030082T358T436I01" INDSW = "OFF">
<TITLE>Shift Range Operation</TITLE>
<TABLE FRAME = "ALL" COLSEP = "1" ROWSEP = "1">
<TGROUP COLS = "4" COLSEP = "1" ROWSEP = "1" TGROUPSTYLE = "Table_10">
<COLSPEC COLNUM = "1" COLNAME = "1" COLWIDTH = "20%"/>
<COLSPEC COLNUM = "2" COLNAME = "2" COLWIDTH = "23%"/>
<COLSPEC COLNUM = "3" COLNAME = "3" COLWIDTH = "34%"/>
<COLSPEC COLNUM = "4" COLNAME = "4" COLWIDTH = "21%"/>
<THEAD>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1"><PTXT>Shift Lever Position</PTXT></ENTRY>
<ENTRY COLNAME = "2"><PTXT>Shift Position</PTXT>
<PTXT>Indicator Display</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>Available A/T Gears</PTXT></ENTRY>
<ENTRY COLNAME = "4"><PTXT>"D" Indicator</PTXT></ENTRY>
</ROW>
</THEAD>
<TBODY>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "1" MOREROWS = "6" VALIGN = "MIDDLE" ALIGN = "CENTER">
<PTXT>D</PTXT></ENTRY>
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>D</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>6,5,4,3,2,1 (Automatic Shift)</PTXT></ENTRY>
<ENTRY COLNAME = "4" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>OFF</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>6</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>6,5,4,3,2,1 (Automatic Shift)</PTXT></ENTRY>
<ENTRY COLNAME = "4" MOREROWS = "5" VALIGN = "MIDDLE" ALIGN = "CENTER">
<PTXT>ON</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>5</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>5,4,3,2,1 (Automatic Shift)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>4</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>4,3,2,1 (Automatic Shift)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>3</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>3,2,1 (Automatic Shift)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "1">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>2</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>2,1 (Automatic Shift)</PTXT></ENTRY>
</ROW>
<ROW ROWSEP = "0">
<ENTRY COLNAME = "2" VALIGN = "MIDDLE" ALIGN = "CENTER"><PTXT>1</PTXT></ENTRY>
<ENTRY COLNAME = "3"><PTXT>1</PTXT></ENTRY>
</ROW>
</TBODY>
</TGROUP></TABLE></INDICATE></MECA>