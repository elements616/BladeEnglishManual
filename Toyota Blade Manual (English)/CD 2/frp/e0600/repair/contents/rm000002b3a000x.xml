<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="E0600">
<servcat id="01">
<name>Engine</name>
<section id="1000D_S0004" variety="S0004">
<name>Lubrication</name>
<ttl id="1000D_S0004_733CD_T000A" variety="T000A">
<name>Oil Pump Assembly (2GR-FE)</name>
<para id="RM000002B3A000X" category="A" type-id="80002" name-id="130KV-00" from="200601">
<name>Disassembly</name>
<subpara id="RM000002B3A000X_01" type-id="01" category="01">
<s-1 id="RM000002B3A000X_01_0001" proc-id="E0600_____000005I00000">
<ptxt>Remove Oil Pump Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 8 bolts and remove the oil pump cover.</ptxt>
<figure>
<graphic graphicname="A094627J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3A000X_01_0002" proc-id="E0600_____000005J00000">
<ptxt>Remove Oil Pump Rotor Set</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the oil pump rotor set from the timing chain (belt) cover.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3A000X_01_0003" proc-id="E0600_____000005K00000">
<ptxt>Remove Oil Pump Relief Valve</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a socket wrench (27mm), remove the oil pump relief valve plug.</ptxt>
<figure>
<graphic graphicname="A094626J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the oil pump relief valve spring and oil pump relief valve.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>