<ttl id="1000D_S0004_733CD_T000A" variety="T000A">
<name>Oil Pump Assembly (2GR-FE)</name>
<para id="RM000002B3C000X" category="A" type-id="8000E" name-id="130KX-00" from="200601">
<name>Reassembly</name>
<subpara id="RM000002B3C000X_01" type-id="01" category="01">
<s-1 id="RM000002B3C000X_01_0001" proc-id="E0600_____000005N00000">
<ptxt>Install Oil Pump Relief Valve</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply engine oil to the oil pump relief valve.</ptxt>
</s2>
<s2>
<ptxt>Install the oil pump relief valve.</ptxt>
</s2>
<s2>
<ptxt>Install the oil pump relief valve spring.</ptxt>
</s2>
<s2>
<ptxt>Using a socket wrench (27mm), install the oil pump relief valve plug.</ptxt>
<figure>
<graphic graphicname="A094626J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>49</t-value1>
<t-value2>500</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3C000X_01_0002" proc-id="E0600_____000005O00000">
<ptxt>Install Oil Pump Rotor Set</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply engine oil to the oil pump rotor set.</ptxt>
</s2>
<s2>
<ptxt>Install the oil pump rotor set to the timing chain (belt) cover with the marks facing the oil pump cover side.</ptxt>
<figure>
<graphic graphicname="A094629J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3C000X_01_0003" proc-id="E0600_____000005P00000">
<ptxt>Install Oil Pump Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the oil pump cover to the timing chain (belt) cover with the 8 bolts.</ptxt>
<figure>
<graphic graphicname="A094627J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>9.1</t-value1>
<t-value2>93</t-value2>
</torqueitem>
</torque>
