<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="E0600">
<servcat id="01">
<name>Engine</name>
<section id="10024_S0005" variety="S0005">
<name>Starting</name>
<ttl id="10024_S0005_733CE_T000B" variety="T000B">
<name>Starter Assembly (2GR-FE)</name>
<para id="RM000002B3E000X" category="A" type-id="80002" name-id="161JA-00" from="200601">
<name>Disassembly</name>
<subpara id="RM000002B3E000X_01" type-id="01" category="01">
<s-1 id="RM000002B3E000X_01_0001" proc-id="E0600_____000005Q00000">
<ptxt>Remove Repair Service Starter Kit</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the nut and disconnect the harness from terminal C.</ptxt>
<figure>
<graphic graphicname="A079718" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 2 screws and the repair service starter kit from the starter motor terminal kit.</ptxt>
<figure>
<graphic graphicname="A079719" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the return spring.</ptxt>
</s2>
<s2>
<ptxt>Pull the plunger to disengage it from the lever, and remove the plunger from the drive lever pin.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3E000X_01_0002" proc-id="E0600_____000005R00000">
<ptxt>Remove Starter Yoke Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 through bolts and the starter yoke assembly w/ starter commutator end frame assembly from the starter motor terminal kit.</ptxt>
<figure>
<graphic graphicname="A079720" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the starter yoke assembly from the starter commutator end frame assembly.</ptxt>
<figure>
<graphic graphicname="A079721" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3E000X_01_0003" proc-id="E0600_____000005S00000">
<ptxt>Remove Starter Armature Plate</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the starter armature plate from the starter yoke assembly.</ptxt>
<figure>
<graphic graphicname="A079722J02" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3E000X_01_0004" proc-id="E0600_____000005T00000">
<ptxt>Remove Starter Commutator End Frame Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a screwdriver, remove the starter commutator end frame cover from the starter commutator end frame assembly.</ptxt>
<figure>
<graphic graphicname="A079723" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3E000X_01_0005" proc-id="E0600_____000005U00000">
<ptxt>Remove Starter Armature Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Secure the starter commutator end frame assembly with aluminum plates in between.</ptxt>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Do not overtighten the vise.</ptxt>
</item>
<item>
<ptxt>Do not damage the starter commutator end frame assembly.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Using SST, remove the snap ring, and remove the starter armature assembly and washer from the starter commutator end frame assembly.</ptxt>
<figure>
<graphic graphicname="A079724J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09904-00010</s-number>
<s-subnumber>09904-00050</s-subnumber>
</sstitem>
</sst>
<atten3>
<ptxt>Do not drop the starter armature assembly.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3E000X_01_0006" proc-id="E0600_____000005V00000">
<ptxt>Remove Starter Planetary Gear</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 3 starter planetary gears from the starter motor terminal kit.</ptxt>
<figure>
<graphic graphicname="A081167" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>