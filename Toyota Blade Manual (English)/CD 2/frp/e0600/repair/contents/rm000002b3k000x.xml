<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="E0600">
<servcat id="01">
<name>Engine</name>
<section id="10025_S0006" variety="S0006">
<name>Charging</name>
<ttl id="10025_S0006_733CB_T0008" variety="T0008">
<name>Alternator Assembly (2GR-FE)</name>
<para id="RM000002B3K000X" category="A" type-id="8000E" name-id="170VF-00" from="200601">
<name>Reassembly</name>
<subpara id="RM000002B3K000X_01" type-id="01" category="01">
<s-1 id="RM000002B3K000X_01_0001" proc-id="E0600_____000006I00000">
<ptxt>Install Alternator Drive End Frame Bearing</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST and a press, press a new alternator drive end frame bearing into the alternator drive end frame assembly until it is flush with the end surface.</ptxt>
<figure>
<graphic graphicname="A137710J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09950-60010</s-number>
<s-subnumber>09951-00470</s-subnumber>
</sstitem>
<sstitem>
<s-number>09950-70010</s-number>
<s-subnumber>09951-07100</s-subnumber>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Align the protrusion of the bearing retainer plate with the cutout of the drive end frame, and install the bearing retainer plate with the 4 screws.</ptxt>
<figure>
<graphic graphicname="A137712J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>2.3</t-value1>
<t-value2>23</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3K000X_01_0002" proc-id="E0600_____000006J00000">
<ptxt>Install Alternator Rotor Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Set the drive end frame on the alternator pulley.</ptxt>
</s2>
<s2>
<ptxt>Install the alternator rotor assembly.</ptxt>
<figure>
<graphic graphicname="A118367J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the alternator washer.</ptxt>
<figure>
<graphic graphicname="A118365J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3K000X_01_0003" proc-id="E0600_____000006K00000">
<ptxt>Install Alternator Coil</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST and a press, press the alternator coil onto the alternator drive end frame assembly.</ptxt>
<figure>
<graphic graphicname="A138443J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09612-70100</s-number>
<s-subnumber>09612-07240</s-subnumber>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Tighten the 4 through bolts.</ptxt>
<figure>
<graphic graphicname="A128074" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>5.8</t-value1>
<t-value2>59</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3K000X_01_0004" proc-id="E0600_____000006L00000">
<ptxt>Install Alternator Brush Holder Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert a pin (diameter 1.0mm) into the hole of the alternator brush holder to hold the 2 brushes.</ptxt>
<figure>
<graphic graphicname="A081162J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the alternator brush holder to the alternator coil with the 2 screws.</ptxt>
<figure>
<graphic graphicname="A079348J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>1.8</t-value1>
<t-value2>18</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Remove the pin (φ1.0mm).</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3K000X_01_0005" proc-id="E0600_____000006M00000">
<ptxt>Install Terminal Insulator</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the alternator terminal insulator to the alternator coil.</ptxt>
<figure>
<graphic graphicname="A128083J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3K000X_01_0006" proc-id="E0600_____000006N00000">
<ptxt>Install Alternator Rear End Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the alternator rear end cover to the alternator coil with the 3 nuts.</ptxt>
<figure>
<graphic graphicname="A128071" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>4.6</t-value1>
<t-value2>47</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3K000X_01_0007" proc-id="E0600_____000006O00000">
<ptxt>Install Alternator Pulley with Clutch</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Assemble the alternator pulley with clutch.</ptxt>
</s2>
<s2>
<ptxt>Install SST1 to SST2.</ptxt>
<figure>
<graphic graphicname="A094991J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09820-63020</s-number>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Secure the width across flats of SST1 in a vise.</ptxt>
</s2>
<s2>
<ptxt>Install SST1 to the end of the alternator rotor shaft.</ptxt>
<figure>
<graphic graphicname="A137706J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install SST2 to the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A137705J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Turn SST2 counterclockwise to tighten the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A137708J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<sst>
<sstitem>
<s-number>09820-63020</s-number>
</sstitem>
</sst>
<torque>
<torqueitem>
<t-value1>111</t-value1>
<t-value2>1127</t-value2>
</torqueitem>
</torque>
<atten3>
<list1 type="unordered">
<item>
<ptxt>The torque above is the value when SST is not used; when using SST, calculate the torque wrench reading using the formula according to the lengths of the SST and torque wrench. (see <xref label="Seep01" href="RM000002884002X"/>)</ptxt>
</item>
<item>
<ptxt>Check that the alternator pulley with clutch rotates smoothly and has no play.</ptxt>
</item>
</list1>
</atten3>
<atten4>
<ptxt>Extension length when using SST 100mm</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Install a new alternator pulley cap to the alternator pulley with clutch.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>