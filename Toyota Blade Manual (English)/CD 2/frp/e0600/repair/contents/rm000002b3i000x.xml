<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="E0600">
<servcat id="01">
<name>Engine</name>
<section id="10025_S0006" variety="S0006">
<name>Charging</name>
<ttl id="10025_S0006_733CB_T0008" variety="T0008">
<name>Alternator Assembly (2GR-FE)</name>
<para id="RM000002B3I000X" category="A" type-id="80002" name-id="170VD-00" from="200601">
<name>Disassembly</name>
<subpara id="RM000002B3I000X_01" type-id="01" category="01">
<s-1 id="RM000002B3I000X_01_0001" proc-id="E0600_____000006700000">
<ptxt>Remove Alternator Pulley with Clutch</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a small screwdriver, remove the alternator pulley cap from the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A128068J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install SST1 to SST2.</ptxt>
<figure>
<graphic graphicname="A094991J02" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09820-63020</s-number>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Secure the width across flats of SST1 in a vise.</ptxt>
</s2>
<s2>
<ptxt>Install SST1 to the end of the alternator rotor shaft.</ptxt>
<figure>
<graphic graphicname="A137706J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install SST2 to the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A137705J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Turn SST2 clockwise to loosen it, and remove the alternator pulley with clutch from the alternator assembly.</ptxt>
<figure>
<graphic graphicname="A137707J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3I000X_01_0002" proc-id="E0600_____000006800000">
<ptxt>Remove Alternator Rear End Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place the alternator assembly on the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A137709" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 nuts and the alternator rear end cover from the alternator coil.</ptxt>
<figure>
<graphic graphicname="A128071" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3I000X_01_0003" proc-id="E0600_____000006900000">
<ptxt>Remove Terminal Insulator</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the alternator terminal insulator from the alternator coil.</ptxt>
<figure>
<graphic graphicname="A128072" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3I000X_01_0004" proc-id="E0600_____000006A00000">
<ptxt>Remove Alternator Brush Holder Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws and the alternator brush holder from the alternator coil.</ptxt>
<figure>
<graphic graphicname="A128073" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3I000X_01_0005" proc-id="E0600_____000006B00000">
<ptxt>Remove Alternator Coil</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 through bolts.</ptxt>
<figure>
<graphic graphicname="A128074" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST, remove the alternator coil.</ptxt>
<figure>
<graphic graphicname="A137711J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09950-40011</s-number>
<s-subnumber>09951-04020</s-subnumber>
<s-subnumber>09952-04010</s-subnumber>
<s-subnumber>09953-04020</s-subnumber>
<s-subnumber>09954-04010</s-subnumber>
<s-subnumber>09955-04071</s-subnumber>
<s-subnumber>09957-04010</s-subnumber>
<s-subnumber>09958-04011</s-subnumber>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3I000X_01_0006" proc-id="E0600_____000006C00000">
<ptxt>Remove Alternator Rotor Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the alternator washer.</ptxt>
<figure>
<graphic graphicname="A118365J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the alternator rotor assembly from the alternator drive end frame.</ptxt>
<figure>
<graphic graphicname="A118367J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM000002B3I000X_01_0007" proc-id="E0600_____000006D00000">
<ptxt>Remove Alternator Drive End Frame Bearing</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 screws and the bearing retainer from the alternator drive end frame assembly.</ptxt>
<figure>
<graphic graphicname="A128076" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST and a hammer, remove the alternator drive end frame bearing from the alternator drive end frame assembly.</ptxt>
<figure>
<graphic graphicname="A128077J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09950-60010</s-number>
<s-subnumber>09951-00250</s-subnumber>
</sstitem>
<sstitem>
<s-number>09950-70010</s-number>
<s-subnumber>09951-07100</s-subnumber>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>