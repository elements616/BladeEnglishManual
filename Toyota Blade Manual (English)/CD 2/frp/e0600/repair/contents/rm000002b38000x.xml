<name>Engine</name>
<section id="1000C_S0001" variety="S0001">
<name>Cooling</name>
<ttl id="1000C_S0001_733CC_T0009" variety="T0009">
<name>Water Pump Assembly (2GR-FE)</name>
<para id="RM000002B38000X" category="A" type-id="8000D" name-id="12131-00" from="200601">
<name>Inspection</name>
<subpara id="RM000002B38000X_01" type-id="01" category="01">
<s-1 id="RM000002B38000X_01_0001" proc-id="E0600_____000005H00000">
<ptxt>Inspect Water Pump Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Check that coolant is not leaking from the drain hole.</ptxt>
<figure>
<graphic graphicname="A096655J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>If coolant is leaking, replace the water pump assembly.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Turn the pulley by hand and check that the bearing has no abnormal noise or binding.</ptxt>
<atten4>
<ptxt>If there is abnormal noise or binding, replace the water pump assembly.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
