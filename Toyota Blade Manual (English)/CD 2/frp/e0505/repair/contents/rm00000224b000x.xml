<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="E0505">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S0002" variety="S0002">
<name>Engine Mechanical</name>
<ttl id="1000A_S0002_72UWV_T0007" variety="T0007">
<name>Cylinder Head Assembly (2AZ-FE)</name>
<para id="RM00000224B000X" category="A" type-id="8000E" name-id="070YA-00" from="200511">
<name>Reassembly</name>
<subpara id="RM00000224B000X_01" type-id="01" category="01">
<s-1 id="RM00000224B000X_01_0001" proc-id="E0505_____000003Q00000">
<ptxt>Install Intake Valve Guide Bushing</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a caliper gauge, measure the bushing bore diameter of the cylinder head.</ptxt>
<figure>
<graphic graphicname="A131495" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<subtitle>Standard</subtitle>
<specitem>
<ptxt>10.285-10.306mm</ptxt>
</specitem>
</spec>
<s3>
<ptxt>If the diameter is within specification, install an STD bushing.</ptxt>
</s3>
<s3>
<ptxt>If the diameter is not within specification, use a hand reamer and T-type tap holder to ream the bore to 10.335-10.356mm, and install an O/S bushing.</ptxt>
<atten3>
<ptxt>Ream gradually, increasing the hand reamer diameter and applying even force, so that the diameter is within specification.</ptxt>
</atten3>
<atten4>
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="2" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="2.092901     in"/>
<colspec colnum="02" colname="C02" colwidth="2.0929     in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>Bushing Type</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>Outer Diameter [mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>STD</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10.333-10.344</ptxt>
</entry>
</row>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>O/S</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>10.383-10.394</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</atten4>
</s3>
</s2>
<s2>
<ptxt>Heat the cylinder head to 80-100°C.</ptxt>
</s2>
<s2>
<ptxt>Using SST, tap in the bushing to the specified protrusion height.</ptxt>
<figure>
<graphic graphicname="A036634J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09201-10000</s-number>
<s-subnumber>09201-01050</s-subnumber>
</sstitem>
<sstitem>
<s-number>09950-70010</s-number>
<s-subnumber>09951-07100</s-subnumber>
</sstitem>
</sst>
<spec>
<subtitle>Standard</subtitle>
<specitem>
<ptxt>9.6-10.0mm</ptxt>
</specitem>
</spec>
</s2>
<s2>
<ptxt>Using a hand reamer and a pin vise, ream the valve guide bushing to obtain the standard oil clearance.</ptxt>
<figure>
<graphic graphicname="A131496" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<subtitle>Standard</subtitle>
<specitem>
<ptxt>0.025-0.060mm</ptxt>
</specitem>
</spec>
<atten3>
<ptxt>Ream gradually, increasing the hand reamer diameter and applying even force, so that the diameter is within specification.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224B000X_01_0002" proc-id="E0505_____000003R00000">
<ptxt>Install Exhaust Valve Guide Bushing</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a caliper gauge, measure the bushing bore diameter of the cylinder head.</ptxt>
<figure>
<graphic graphicname="A124782" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<subtitle>Standard</subtitle>
<specitem>
<ptxt>10.285-10.306mm</ptxt>
</specitem>
</spec>
<s3>
<ptxt>If the diameter is within specification, install an STD bushing.</ptxt>
</s3>
<s3>
<ptxt>If the diameter is not within specification, use a hand reamer and T-type tap holder to ream the bore to 10.335-10.356mm, and install an O/S bushing.</ptxt>
<atten3>
<ptxt>Ream gradually, increasing the hand reamer diameter and applying even force, so that the diameter is within specification.</ptxt>
</atten3>
<atten4>
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="2" colsep="1" rowsep="1">
<colspec colnum="01" colname="C01" colwidth="2.092901     in"/>
<colspec colnum="02" colname="C02" colwidth="2.0929     in"/>
<thead>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>Bushing Type</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>Outer Diameter [mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>STD</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>10.333-10.344</ptxt>
</entry>
</row>
<row>
<entry colname="C01" valign="middle" align="center">
<ptxt>O/S</ptxt>
</entry>
<entry colname="C02" valign="middle" align="center">
<ptxt>10.383-10.394</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</atten4>
</s3>
</s2>
<s2>
<ptxt>Heat the cylinder head to 80-100°C.</ptxt>
</s2>
<s2>
<ptxt>Using SST, tap in the bushing to the specified protrusion height.</ptxt>
<figure>
<graphic graphicname="A036635J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09201-10000</s-number>
<s-subnumber>09201-01050</s-subnumber>
</sstitem>
<sstitem>
<s-number>09950-70010</s-number>
<s-subnumber>09951-07100</s-subnumber>
</sstitem>
</sst>
<spec>
<subtitle>Standard</subtitle>
<specitem>
<ptxt>9.6-10.0mm</ptxt>
</specitem>
</spec>
</s2>
<s2>
<ptxt>Using a hand reamer, ream the bushing to obtain the standard oil clearance.</ptxt>
<figure>
<graphic graphicname="A131497" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<subtitle>Standard</subtitle>
<specitem>
<ptxt>0.030-0.065mm</ptxt>
</specitem>
</spec>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224B000X_01_0003" proc-id="E0505_____000003S00000">
<ptxt>Install Ring Pin (w/ Head)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a plastic-faced hammer, tap in the ring pins to the specified protrusion height at the positions shown in the illustration. </ptxt>
<figure>
<graphic graphicname="A128230J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<spec>
<subtitle>Standard</subtitle>
<specitem>
<ptxt>3mm (Protrusion Height)</ptxt>
</specitem>
</spec>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224B000X_01_0004" proc-id="E0505_____000003T00000">
<ptxt>Install Stud Bolt</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using E5 and E7 torx socket wrenches, install the stud bolts at the positions shown in the illustration.</ptxt>
<figure>
<graphic graphicname="A128231J01" width="7.106578999in" height="7.795582503in"/>
</figure>
<torque>
<torqueitem>
<t-value1>5.0</t-value1>
<t-value2>51</t-value2>
<ptxt>(Stud Bolts A, B)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>9.5</t-value1>
<t-value2>97</t-value2>
<ptxt>(Stud Bolts C, D)</ptxt>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224B000X_01_0005" proc-id="E0505_____000003U00000">
<ptxt>Install Plug NO.1 (w/ Head Straight Screw)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a 14 straight hexagon wrench, install the 2 straight screw plugs No.1 with 2 new screw plug gaskets.</ptxt>
<figure>
<graphic graphicname="A062841J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>86</t-value1>
<t-value2>879</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224B000X_01_0006" proc-id="E0505_____000003V00000">
<ptxt>Install Valve Spring Seat</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the 16 valve spring seats to the cylinder head.</ptxt>
<figure>
<graphic graphicname="A062872J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224B000X_01_0007" proc-id="E0505_____000003W00000">
<ptxt>Install Valve Stem Oil Seal or O-ring</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply a light coat of engine oil to the lip of a new valve stem oil seal.</ptxt>
<figure>
<graphic graphicname="A032385J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Do not confuse the body identification colors of the valve stem oil seals.</ptxt>
</item>
<item>
<ptxt>Installing intake and exhaust side seals in the wrong positions will cause malfunctions.</ptxt>
</item>
</list1>
</atten3>
</s2>
<s2>
<ptxt>Using SST, push in the valve stem oil seal onto the valve guide bushing by hand as far as it will go.</ptxt>
<figure>
<graphic graphicname="A129854J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<sst>
<sstitem>
<s-number>09201-41020</s-number>
</sstitem>
</sst>
<atten3>
<ptxt>Do not install the oil seal at an angle.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224B000X_01_0008" proc-id="E0505_____000003X00000">
<ptxt>Install Intake Valve</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply sufficient engine oil to the locations shown in the illustration.</ptxt>
<figure>
<graphic graphicname="A094935J04" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Set the 8 intake valves, compression springs and retainers on the cylinder head.</ptxt>
<atten3>
<ptxt>Install the parts in their original positions.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Using SST, install the 16 valve spring retainer locks.</ptxt>
<figure>
<graphic graphicname="A128225J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09202-70020</s-number>
<s-subnumber>09202-00010</s-subnumber>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Using a pin punch (diameter 5mm), lightly tap the valve stem tip to settle the compression spring.</ptxt>
<figure>
<graphic graphicname="A036640J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Do not damage the valve stem tip.</ptxt>
</item>
<item>
<ptxt>Do not tap the retainer.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224B000X_01_0009" proc-id="E0505_____000003Y00000">
<ptxt>Install Exhaust Valve</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply sufficient engine oil to the locations shown in the illustration.</ptxt>
<figure>
<graphic graphicname="A094936J04" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Set the 8 exhaust valves, compression springs and retainers on the cylinder head.</ptxt>
<atten3>
<ptxt>Install the parts in their original positions.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Using SST, install the 16 valve spring retainer locks.</ptxt>
<figure>
<graphic graphicname="A128226J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09202-70020</s-number>
<s-subnumber>09202-00010</s-subnumber>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Using a pin punch (diameter 5mm), lightly tap the valve stem tip to settle the compression spring.</ptxt>
<figure>
<graphic graphicname="A036641J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<list1 type="unordered">
<item>
<ptxt>Do not damage the valve stem tip.</ptxt>
</item>
<item>
<ptxt>Do not tap the retainer.</ptxt>
</item>
</list1>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224B000X_01_0010" proc-id="E0505_____000003Z00000">
<ptxt>Install Valve Lifter</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply engine oil to the valve lifters and valve stem tips.</ptxt>
</s2>
<s2>
<ptxt>Install the 16 valve lifters to the cylinder head.</ptxt>
<figure>
<graphic graphicname="A062842J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Install the parts in their original positions.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>