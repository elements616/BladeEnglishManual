<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="E0505">
<servcat id="01">
<name>Engine</name>
<section id="10025_S0006" variety="S0006">
<name>Charging</name>
<ttl id="10025_S0006_72UX0_T000C" variety="T000C">
<name>Alternator Assembly (2AZ-FE)</name>
<para id="RM00000224P000X" category="A" type-id="80002" name-id="170TW-00" from="200511">
<name>Disassembly</name>
<subpara id="RM00000224P000X_01" type-id="01" category="01">
<s-1 id="RM00000224P000X_01_0001" proc-id="E0505_____000005M00000">
<ptxt>Remove Alternator Pulley (w/ Clutch)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a small screwdriver, remove the alternator pulley cap from the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A128604J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install SST1 to SST2.</ptxt>
<figure>
<graphic graphicname="A094991J04" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09820-63020</s-number>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Secure the width across flats of SST1 in a vise.</ptxt>
</s2>
<s2>
<ptxt>Install SST1 to the end of the alternator rotor shaft.</ptxt>
<figure>
<graphic graphicname="A128605J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install SST2 to the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A128606J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Turn SST2 clockwise to loosen it, and remove the alternator pulley with clutch from the alternator assembly.</ptxt>
<figure>
<graphic graphicname="A128607" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224P000X_01_0009" proc-id="E0505_____000006X00000">
<ptxt>Remove Alternator Rear End Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Place the alternator assembly on the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A128608" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the 3 nuts and remove the rear end cover from the alternator coil.</ptxt>
<figure>
<graphic graphicname="A128610" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224P000X_01_0010" proc-id="E0505_____000006Y00000">
<ptxt>Remove Terminal Insulator</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the terminal insulator.</ptxt>
<figure>
<graphic graphicname="A128609" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224P000X_01_0002" proc-id="E0505_____000005N00000">
<ptxt>Remove Alternator Brush Holder Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 2 screws and remove the brush holder from the alternator coil.</ptxt>
<figure>
<graphic graphicname="A128611" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224P000X_01_0003" proc-id="E0505_____000005O00000">
<ptxt>Remove Alternator Coil Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 through bolts.</ptxt>
<figure>
<graphic graphicname="A128612" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the bolt and remove the cord clip.</ptxt>
<figure>
<graphic graphicname="A128613" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST, remove the alternator coil.</ptxt>
<figure>
<graphic graphicname="A128614J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09950-40011</s-number>
<s-subnumber>09951-04020</s-subnumber>
<s-subnumber>09952-04010</s-subnumber>
<s-subnumber>09953-04020</s-subnumber>
<s-subnumber>09954-04010</s-subnumber>
<s-subnumber>09955-04071</s-subnumber>
<s-subnumber>09957-04010</s-subnumber>
<s-subnumber>09958-04011</s-subnumber>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224P000X_01_0004" proc-id="E0505_____000005P00000">
<ptxt>Remove Alternator Rotor Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the alternator washer.</ptxt>
<figure>
<graphic graphicname="A118365J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Remove the alternator rotor from the alternator drive end frame assembly.</ptxt>
<figure>
<graphic graphicname="A128615" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Do not drop the alternator rotor.</ptxt>
</atten3>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224P000X_01_0008" proc-id="E0505_____000005T00000">
<ptxt>Remove Alternator Drive End Frame Bearing</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 4 screws and remove the retainer plate from the alternator drive end frame assembly.</ptxt>
<figure>
<graphic graphicname="A128617" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using SST, remove the alternator drive end frame bearing from the alternator drive end frame assembly.</ptxt>
<figure>
<graphic graphicname="A128618J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten3>
<ptxt>Keep the alternator drive end frame assembly level.</ptxt>
</atten3>
<sst>
<sstitem>
<s-number>09950-60010</s-number>
<s-subnumber>09951-00250</s-subnumber>
</sstitem>
<sstitem>
<s-number>09950-70010</s-number>
<s-subnumber>09951-07100</s-subnumber>
</sstitem>
</sst>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>