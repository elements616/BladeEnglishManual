<s-1 id="RM00000224E000X_01_0004" proc-id="E0505_____000004R00000">
<ptxt>Install Stud Bolt</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using E5 and E7 torx socket wrenches, install the stud bolts at the positions shown in the illustration.</ptxt>
<figure>
<graphic graphicname="A131416J01" width="7.106578999in" height="5.787629434in"/>
</figure>
<spec>
<subtitle>Standard</subtitle>
<specitem>
<ptxt>T = 5.0N*m{51kgf*cm} (Bolts A, C)</ptxt>
</specitem>
<specitem>
<ptxt>T = 9.5N*m{97kgf*cm} (Bolt B)</ptxt>
</specitem>
</spec>
</s2>
</content1>
</s-1>
