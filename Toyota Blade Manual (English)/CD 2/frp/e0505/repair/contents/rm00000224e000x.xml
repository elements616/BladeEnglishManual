<s-1 id="RM00000224E000X_01_0001" proc-id="E0505_____000004O00000">
<ptxt>Install Ring Pin</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a plastic-faced hammer, tap in the ring pins at the positions shown in the illustration.</ptxt>
