<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="E0505">
<servcat id="01">
<name>Engine</name>
<section id="10025_S0006" variety="S0006">
<name>Charging</name>
<ttl id="10025_S0006_72UX0_T000C" variety="T000C">
<name>Alternator Assembly (2AZ-FE)</name>
<para id="RM00000224Q000X" category="A" type-id="8000E" name-id="170TY-00" from="200511">
<name>Reassembly</name>
<subpara id="RM00000224Q000X_01" type-id="01" category="01">
<s-1 id="RM00000224Q000X_01_0001" proc-id="E0505_____000005U00000">
<ptxt>Install Alternator Drive End Frame Bearing</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST and a press, press a new alternator drive end frame bearing into the alternator drive end frame assembly until it is flush with the end surface.</ptxt>
<figure>
<graphic graphicname="A128619J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09950-60010</s-number>
<s-subnumber>09951-00470</s-subnumber>
</sstitem>
<sstitem>
<s-number>09950-70010</s-number>
<s-subnumber>09951-07100</s-subnumber>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Align the protrusion of the retainer plate with the notch of the drive end frame, and install the retainer plate with the 4 screws.</ptxt>
<figure>
<graphic graphicname="A128620J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>2.3</t-value1>
<t-value2>23</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224Q000X_01_0002" proc-id="E0505_____000005V00000">
<ptxt>Install Alternator Rotor Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Set the drive end frame on the alternator pulley.</ptxt>
</s2>
<s2>
<ptxt>Install the alternator rotor.</ptxt>
<figure>
<graphic graphicname="A128615" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the alternator washer.</ptxt>
<figure>
<graphic graphicname="A118365J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224Q000X_01_0003" proc-id="E0505_____000005W00000">
<ptxt>Install Alternator Coil Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST and a press, press the alternator coil onto the alternator drive end frame assembly.</ptxt>
<sst>
<sstitem>
<s-number>09612-70100</s-number>
<s-subnumber>09612-07240</s-subnumber>
</sstitem>
</sst>
<figure>
<graphic graphicname="A128621J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Tighten the 4 through bolts.</ptxt>
<figure>
<graphic graphicname="A128612" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>5.8</t-value1>
<t-value2>59</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Install the cord clip with the bolt.</ptxt>
<figure>
<graphic graphicname="A128613" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>4.6</t-value1>
<t-value2>47</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224Q000X_01_0004" proc-id="E0505_____000005X00000">
<ptxt>Install Alternator Brush Holder Assembly</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Insert a pin (diameter 1.0mm) into the hole of the alternator brush holder to hold the 2 brushes.</ptxt>
<figure>
<graphic graphicname="A081162J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install the brush holder with the 2 screws.</ptxt>
<figure>
<graphic graphicname="A128622" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>1.8</t-value1>
<t-value2>18</t-value2>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Pull out the pin (diameter 1.0mm).</ptxt>
<figure>
<graphic graphicname="A130537J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224Q000X_01_0006" proc-id="E0505_____000007000000">
<ptxt>Install Terminal Insulator</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the terminal insulator to the alternator coil.</ptxt>
<figure>
<graphic graphicname="A128623" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224Q000X_01_0007" proc-id="E0505_____000007100000">
<ptxt>Install Alternator Rear End Cover</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the rear end cover to the alternator coil with the 3 nuts.</ptxt>
<figure>
<graphic graphicname="A128610" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>4.6</t-value1>
<t-value2>47</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224Q000X_01_0005" proc-id="E0505_____000005Y00000">
<ptxt>Install Alternator Pulley (w/ Clutch)</ptxt>
<content1 releasenbr="3">
<s2>
<ptxt>Assemble the alternator pulley with clutch.</ptxt>
</s2>
<s2>
<ptxt>Install SST1 to SST2.</ptxt>
<figure>
<graphic graphicname="A094991J04" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09820-63020</s-number>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Secure the width across flats of SST1 in a vise.</ptxt>
</s2>
<s2>
<ptxt>Install SST1 to the end of the alternator rotor shaft.</ptxt>
<figure>
<graphic graphicname="A128605J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Install SST2 to the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A128606J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Turn SST2 counterclockwise to tighten the alternator pulley with clutch.</ptxt>
<figure>
<graphic graphicname="A128624J01" width="2.775699831in" height="2.775699831in"/>
</figure>
<sst>
<sstitem>
<s-number>09820-63020</s-number>
</sstitem>
</sst>
<torque>
<torqueitem>
<t-value1>111</t-value1>
<t-value2>1127</t-value2>
</torqueitem>
</torque>
<atten3>
<list1 type="unordered">
<item>
<ptxt>The torque above is the value when SST is not used; when using SST, calculate the torque wrench reading using the formula according to the lengths of the SST and torque wrench. (see <xref label="Seep01" href="RM000002884000X"/>)</ptxt>
</item>
<item>
<ptxt>Check that the alternator pulley with clutch rotates smoothly and has no play.</ptxt>
</item>
</list1>
</atten3>
<atten4>
<ptxt>Extension length when using SST 100mm</ptxt>
</atten4>
</s2>
<s2>
<ptxt>Install a new alternator pulley cap to the alternator pulley with clutch.</ptxt>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>