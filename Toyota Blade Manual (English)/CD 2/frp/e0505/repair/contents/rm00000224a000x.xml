<?xml version="1.0" encoding="UTF-8"?>
<tmc-service-inc>
<pub id="E0505">
<servcat id="01">
<name>Engine</name>
<section id="1000A_S0002" variety="S0002">
<name>Engine Mechanical</name>
<ttl id="1000A_S0002_72UWV_T0007" variety="T0007">
<name>Cylinder Head Assembly (2AZ-FE)</name>
<para id="RM00000224A000X" category="A" type-id="80002" name-id="070Y8-00" from="200511">
<name>Disassembly</name>
<subpara id="RM00000224A000X_01" type-id="01" category="01">
<s-1 id="RM00000224A000X_01_0001" proc-id="E0505_____000003700000">
<ptxt>Remove Valve Lifter</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the 16 valve lifters from the cylinder head.</ptxt>
<figure>
<graphic graphicname="A062842J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>Arrange the removed parts in order according to their installation positions.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0002" proc-id="E0505_____000003800000">
<ptxt>Remove Intake Valve</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, remove the 16 valve spring retainer locks.</ptxt>
<figure>
<graphic graphicname="A128225J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09202-70020</s-number>
<s-subnumber>09202-00010</s-subnumber>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Remove the 8 valve spring retainers, compression springs and intake valves.</ptxt>
<atten4>
<ptxt>Arrange the removed parts in order according to their installation positions.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0003" proc-id="E0505_____000003900000">
<ptxt>Remove Exhaust Valve</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using SST, remove the 16 valve spring retainer locks.</ptxt>
<figure>
<graphic graphicname="A128226J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<sst>
<sstitem>
<s-number>09202-70020</s-number>
<s-subnumber>09202-00010</s-subnumber>
</sstitem>
</sst>
</s2>
<s2>
<ptxt>Remove the 8 valve spring retainers, compression springs and exhaust valves.</ptxt>
<atten4>
<ptxt>Arrange the removed parts in order according to their installation positions.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0004" proc-id="E0505_____000003A00000">
<ptxt>Remove Valve Stem Oil Seal or O-ring</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using needle-nose pliers, remove the 16 valve stem oil seals.</ptxt>
<figure>
<graphic graphicname="A013356J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0005" proc-id="E0505_____000003B00000">
<ptxt>Remove Valve Spring Seat</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a magnetic finger and an air gun, remove the 16 valve spring seats.</ptxt>
<figure>
<graphic graphicname="A062845J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0006" proc-id="E0505_____000003C00000">
<ptxt>Remove Plug NO.1 (w/ Head Straight Screw)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a 14 straight hexagon wrench, remove the 2 straight screw plugs No.1 and 2 screw plug gaskets.</ptxt>
<figure>
<graphic graphicname="A062841J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0007" proc-id="E0505_____000007N00000">
<ptxt>Remove Stud Bolt</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the stud bolts from the cylinder head.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0021" proc-id="E0505_____000007O00000">
<ptxt>Remove Ring Pin (w/ Head)</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Remove the head ring pins from the cylinder head.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0008" proc-id="E0505_____000003D00000">
<ptxt>Inspect Cylinder Head for Warpage</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a precision straightedge and feeler gauge, measure the warpage of the bottom surface and manifold contact surfaces of the cylinder head.</ptxt>
<figure>
<graphic graphicname="A036623J01" width="2.775699831in" height="4.7836529in"/>
</figure>
<spec>
<title>Limit</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Measurement Point</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Maximum [mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Bottom Surface</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.05</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Intake Manifold Contact Surface</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.08</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Exhaust Manifold Contact Surface</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.08</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>If the warpage is more than the maximum, replace the cylinder head.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0009" proc-id="E0505_____000003E00000">
<ptxt>Inspect Cylinder Head for Cracks</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Using a dye penetrant (red check), check that there are no cracks in the cylinder head.</ptxt>
<figure>
<graphic graphicname="A013365J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<atten4>
<ptxt>If there are cracks, replace the cylinder head.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0010" proc-id="E0505_____000003F00000">
<ptxt>Inspect Valve Seat</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply a light coat of Prussian blue to the valve face.</ptxt>
</s2>
<s2>
<ptxt>Lightly press the valve against the valve seat and, using vernier calipers, check the valve seat contact position and width.</ptxt>
<figure>
<graphic graphicname="A014600J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Specified Condition</title>
<specitem>
<ptxt>Center of the valve face around the entire circumference (contact width)</ptxt>
</specitem>
</spec>
<spec>
<title>Standard</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Measurement Point</ptxt>
</entry>
<entry valign="middle">
<ptxt>Contact Width [mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Intake Side</ptxt>
</entry>
<entry valign="middle">
<ptxt>1.0-1.4</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Exhaust Side</ptxt>
</entry>
<entry valign="middle">
<ptxt>1.2-1.6</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>Do not rotate the valve.</ptxt>
</atten3>
<atten4>
<list1 type="unordered">
<item>
<ptxt>If the valve does not contact around the entire circumference, replace the valve.</ptxt>
</item>
<item>
<ptxt>If the valve contacts around the entire circumference but the contact width is not as specified, reface the valve seat.</ptxt>
</item>
</list1>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0011" proc-id="E0505_____000003G00000">
<ptxt>Repair Valve Seat</ptxt>
<content1 releasenbr="1">
<atten3>
<list1 type="unordered">
<item>
<ptxt>When cutting, always check the valve contact position and width.</ptxt>
</item>
<item>
<ptxt>Cut so that no steps are formed on the cut surface, and gradually reduce the force at the end.</ptxt>
</item>
</list1>
</atten3>
<s2>
<ptxt>Using a 45° cutter head, cut the seat so that the contact width is wider than specified.</ptxt>
<figure>
<graphic graphicname="A128228" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Using 30° and 75° cutter heads, cut the seat so that the valve contacts at the center of the face around the entire circumference and the contact width is as specified.</ptxt>
<figure>
<graphic graphicname="A128227J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Standard</title>
<table>
<tgroup cols="2" align="center">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle">
<ptxt>Measurement Point</ptxt>
</entry>
<entry valign="middle">
<ptxt>Contact Width [mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle">
<ptxt>Intake Side</ptxt>
</entry>
<entry valign="middle">
<ptxt>1.0-1.4</ptxt>
</entry>
</row>
<row>
<entry valign="middle">
<ptxt>Exhaust Side</ptxt>
</entry>
<entry valign="middle">
<ptxt>1.2-1.6</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
</s2>
<s2>
<ptxt>Using compound, hand-lap the valve and valve seat.</ptxt>
</s2>
<s2>
<ptxt>After lapping, use Prussian blue to check that the valve contact is uniform around the entire circumference.</ptxt>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0012" proc-id="E0505_____000003H00000">
<ptxt>Inspect Camshaft Thrust Clearance</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the camshaft and camshaft No.2 to the cylinder head.</ptxt>
</s2>
<s2>
<ptxt>Check the front marks and numbers on the bearing caps, and tighten the 8 bearing caps No.1, No.2 and No.3 in the order shown in the illustration.</ptxt>
<figure>
<graphic graphicname="A131259J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<torque>
<torqueitem>
<t-value1>30</t-value1>
<t-value2>301</t-value2>
<ptxt>(Bearing Cap No.1, No.2)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>9.0</t-value1>
<t-value2>92</t-value2>
<ptxt>(Bearing Cap No.3)</ptxt>
</torqueitem>
</torque>
</s2>
<s2>
<ptxt>Using a dial indicator, measure the thrust clearance of each camshaft.</ptxt>
<figure>
<graphic graphicname="A036626J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Standard</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Measurement Point</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard [mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Intake Side</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.040-0.095</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Exhaust Side</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.080-0.135</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Limit</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Measurement Point</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Maximum [mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Intake Side</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.11</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Exhaust Side</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.15</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten4>
<ptxt>If the warpage is more than the maximum, replace the cylinder head. If the thrust surface of the camshaft is damaged, also replace the camshaft.</ptxt>
</atten4>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224A000X_01_0013" proc-id="E0505_____000003I00000">
<ptxt>Inspect Camshaft Oil Clearance</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Clean the camshafts and bearing caps.</ptxt>
</s2>
<s2>
<ptxt>Place the camshafts on the cylinder head.</ptxt>
</s2>
<s2>
<ptxt>Lay a strip of Plastigage across each camshaft journal.</ptxt>
<figure>
<graphic graphicname="A036627J01" width="2.775699831in" height="1.771723296in"/>
</figure>
</s2>
<s2>
<ptxt>Check the front marks and numbers on the bearing caps, and tighten the 8 bearing caps No.1, No.2 and No.3 in the order shown in the illustration.</ptxt>
<figure>
<graphic graphicname="A131259J01" width="2.775699831in" height="3.779676365in"/>
</figure>
<torque>
<torqueitem>
<t-value1>30</t-value1>
<t-value2>301</t-value2>
<ptxt>(Bearing Cap No.1, No.2)</ptxt>
</torqueitem>
<torqueitem>
<t-value1>9.0</t-value1>
<t-value2>92</t-value2>
<ptxt>(Bearing Cap No.3)</ptxt>
</torqueitem>
</torque>
<atten3>
<ptxt>Do not turn the camshaft during inspection.</ptxt>
</atten3>
</s2>
<s2>
<ptxt>Remove the bearing caps and measure the Plastigage at its widest point.</ptxt>
<figure>
<graphic graphicname="A036628J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<spec>
<title>Standard</title>
<table>
<tgroup cols="3">
<colspec colname="COL1" colwidth="1.03in"/>
<colspec colname="COL2" colwidth="1.86in"/>
<colspec colname="COLSPEC0" colwidth="1.24in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Selection Mark</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Measurement Point</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Standard [mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>1</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Intake Side No. No.1 Journal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.007-0.038</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>2</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Intake Side No. No.1 Journal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.008-0.038</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>3</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Intake Side No. No.1 Journal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.008-0.038</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>-</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Exhaust Side No. No.1 Journal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.015-0.054</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>-</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Other than No. No.1 Journal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.025-0.062</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<spec>
<title>Limit</title>
<table>
<tgroup cols="2">
<colspec colname="COL1" colwidth="2.07in"/>
<colspec colname="COL2" colwidth="2.06in"/>
<thead>
<row>
<entry valign="middle" align="center">
<ptxt>Measurement Point</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>Maximum [mm]</ptxt>
</entry>
</row>
</thead>
<tbody>
<row>
<entry valign="middle" align="center">
<ptxt>Intake Side No. No.1 Journal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.07</ptxt>
</entry>
</row>
<row>
<entry valign="middle" align="center">
<ptxt>Intake Side Other than No. No.1 Journal</ptxt>
</entry>
<entry valign="middle" align="center">
<ptxt>0.10</ptxt>
</entry>
</row>
</tbody>
</tgroup>
</table>
</spec>
<atten3>
<ptxt>After inspection, completely remove the Plastigage.</ptxt>
</atten3>
<atten4>
<ptxt>If the warpage is more than the maximum, replace the cylinder head.</ptxt>
</atten4>
</s2>
<s2>
<ptxt>If the No. No.1 journal clearance is more than the maximum, select and replace the bearing.</ptxt>
<atten4>
<table frame="all" colsep="1" rowsep="1">
<tgroup cols="4" colsep="1" rowsep="1">
