<tmc-service-inc>
<pub id="E0505">
<servcat id="01">
<name>Engine</name>
<section id="1000D_S0004" variety="S0004">
<name>Lubrication</name>
<ttl id="1000D_S0004_72UWY_T000A" variety="T000A">
<name>Oil Pump Assembly (2AZ-FE)</name>
<para id="RM00000224J000X" category="A" type-id="8000E" name-id="130IR-00" from="200511">
<name>Reassembly</name>
<subpara id="RM00000224J000X_01" type-id="01" category="01">
<s-1 id="RM00000224J000X_01_0002" proc-id="E0505_____000006A00000">
<ptxt>Install Oil Pump Relief Valve</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Apply engine oil to the oil pump relief valve.</ptxt>
</s2>
<s2>
<ptxt>Assemble the oil pump relief valve and spring.</ptxt>
</s2>
<s2>
<ptxt>Using a socket wrench (27mm), install the oil pump relief valve plug.</ptxt>
<figure>
<graphic graphicname="A052074J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>49</t-value1>
<t-value2>500</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
<s-1 id="RM00000224J000X_01_0003" proc-id="E0505_____000006B00000">
<ptxt>Install Oil Pump Strainer Set</ptxt>
<content1 releasenbr="1">
<s2>
<ptxt>Install the oil pump strainer set with a new gasket and the 2 nuts.</ptxt>
<figure>
<graphic graphicname="B011430J01" width="2.775699831in" height="1.771723296in"/>
</figure>
<torque>
<torqueitem>
<t-value1>8.8</t-value1>
<t-value2>90</t-value2>
</torqueitem>
</torque>
</s2>
</content1>
</s-1>
</subpara>
</para>
</ttl>
</section>
</servcat>
</pub>
</tmc-service-inc>